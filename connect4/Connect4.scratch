//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    IsClone = 0;
    State = 0;
    Looks.ClearGraphicEffects();
    Looks.SetSizeTo(100);
    Looks.Hide();
}


//----- Sprite clicked events -----------------------------------------------------------------------------------------

WhenThisSpriteClicked()
{
    If (IsClone == 1)
    {
        Event.Broadcast("Stg_PlayerPieceClicked");
    }
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived(Stg_DropEnginePiece)
{
    If (IsClone == 1)
    {
        If (State == 2)
        {
            State = 4;
            Motion.GlideTo((-200 + (Stg_DropEngineMoveColumn * 50)), 155, 0.25);
            Sound.Play(DropPiece);
            Motion.GlideTo(Motion.XPosition(), (155 - (Stg_DropEngineMoveColumnSlots * 50)), (0.4 / (7 - Stg_DropEngineMoveColumnSlots)));
            Event.Broadcast("Stg_DropEnginePieceDone");
        }
    }
}

WhenBroadcastReceived(Stg_DropPlayerPiece)
{
    If (IsClone == 1)
    {
        If (State == 1)
        {
            State = 3;
            Motion.GoToXY((-200 + (Stg_DropPlayerMoveColumn * 50)), 155);
            Sound.Play(DropPiece);
            Motion.GlideTo(Motion.XPosition(), (155 - (Stg_DropPlayerMoveColumnSlots * 50)), (0.4 / (7 - Stg_DropPlayerMoveColumnSlots)));
            Event.Broadcast("Stg_DropPlayerPieceDone");
        }
    }
}

WhenBroadcastReceived(StG_EngineMoveUI)
{
    If (IsClone == 0)
    {
        Motion.GoToXY(0, 155);
        IsClone = 1;
        State = 2;
        Looks.SwitchCostumeTo(Yellow);
        Control.CreateCloneOf(_myself_);
        IsClone = 0;
    }
}

WhenBroadcastReceived(Stg_PlayerMoveUI)
{
    If (IsClone == 0)
    {
        Motion.GoToXY(0, 155);
        IsClone = 1;
        State = 1;
        Looks.SwitchCostumeTo(Red);
        Control.CreateCloneOf(_myself_);
        IsClone = 0;
    }
}

WhenBroadcastReceived(Stg_SelectedColumnChanged)
{
    If (IsClone == 1)
    {
        If (State == 1)
        {
            Motion.GoToXY((-200 + (Stg_SelectedColumn * 50)), 155);
        }
    }
}

