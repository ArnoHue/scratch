//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Variable.Hide(SearchDepth);
    Variable.Hide(Nodes);
    Variable.Hide(NPS);
    Variable.Hide(Search.Eval);
}


//----- Key pressed events --------------------------------------------------------------------------------------------

WhenKeyPressed(d)
{
    If (Debug == 0)
    {
        Debug = 1;
        Variable.Show(SearchDepth);
        Variable.Show(Nodes);
        Variable.Show(NPS);
        Variable.Show(Search.Eval);
    }
    Else
    {
        Debug = 0;
        Variable.Hide(SearchDepth);
        Variable.Hide(Nodes);
        Variable.Hide(NPS);
        Variable.Hide(Search.Eval);
    }
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived(C4_EngineMove)
{
    If ((PieceCount - (floor((PieceCount / 2)) * 2)) == 0)
    {
        FirstMover = 1;
    }
    Else
    {
        FirstMover = 2;
    }
    If (PieceCount == 0)
    {
        FirstMover = 1;
    }
    Search.Gen += 1;
    Search.Eval = "";
    If ((Not ((PrevSearchDepth == ""))) And (PrevSearchDepth > 3))
    {
        SearchDepth = (PrevSearchDepth - 2);
    }
    Else
    {
        If is compiled?
        {
            SearchDepth = 4;
        }
        Else
        {
            SearchDepth = 8;
        }
    }
    If (SearchDepth > (42 - PieceCount))
    {
        SearchDepth = (42 - PieceCount);
    }
    Timer = (Sensing.DaysSince2000() * 86400);
    Search.Timeout = 0;
    Search.BestMoveDone = "";
    Book.Hit = 0;
    If (PieceCount < 17)
    {
        Book.Idx = 1;
        BK.Q = 0;
        BK.Base = 1;
        BK.C = 1;
        Repeat (7)
        {
            BK.Bit = BK.Base;
            BK.R = 0;
            BK.H = ColumnHeight[BK.C];
            Repeat (BK.H)
            {
                If (Board[(((5 - BK.R) * 7) + BK.C)] == 1)
                {
                    BK.Q += BK.Bit;
                }
                BK.Bit = (BK.Bit * 2);
                BK.R += 1;
            }
            BK.Q += BK.Bit;
            BK.Base = (BK.Base * 128);
            BK.C += 1;
        }
        Book.Idx = List.IndexOf(Book.Key, BK.Q);
        If (Book.Idx > 0)
        {
            Book.Hit = 1;
            Book.ColHit = Operator.LetterOf(Book.Col[Book.Idx], Operator.Random(1 , Variable.Length(Book.Col[Book.Idx])));
            Search.BestMove = (((5 - ColumnHeight[Book.ColHit]) * 7) + Book.ColHit);
            Search.Eval = 0;
            NodesCount = 0;
        }
    }
    If (Book.Hit == 0)
    {
        Repeat Until (((((Sensing.DaysSince2000() * 86400) - Timer) > ThinkTime) Or ((SearchDepth > (42 - PieceCount)) Or (abs(Search.Eval) > 900))) Or (Search.Timeout == 1))
        {
            Call Search(1)((SearchDepth + 1));
            If (Search.Timeout == 0)
            {
                Search.BestMoveDone = Search.BestMove;
                Search.EvalDone = Search.Eval;
            }
            PrevSearchDepth = SearchDepth;
            SearchDepth += 1;
        }
    }
    If (Not ((Search.BestMoveDone == "")))
    {
        Search.BestMove = Search.BestMoveDone;
        Search.Eval = Search.EvalDone;
    }
    SearchDepth += -1;
    NPS = Operator.Join(Operator.Round(((NodesCount / ((Sensing.DaysSince2000() * 86400) - Timer)) / 1000)), "k");
    Nodes = Operator.Join(Operator.Round((NodesCount / 1000)), "k");
    List.ReplaceItem(Board, Search.BestMove, 1);
    List.ReplaceItem(ColumnHeight, (((Search.BestMove - 1) - (floor(((Search.BestMove - 1) / 7)) * 7)) + 1), (ColumnHeight[(((Search.BestMove - 1) - (floor(((Search.BestMove - 1) / 7)) * 7)) + 1)] + 1));
    Board1 += IdxToExp[Search.BestMove];
    Call CellApply(Search.BestMove)(1);
    PieceCount += 1;
    C4_EngineMove.Column = (((Search.BestMove - 1) - (floor(((Search.BestMove - 1) / 7)) * 7)) + 1);
    C4_EngineMove.Result = 0;
    Call EvaluateWinImpl(Board1)(Search.BestMove);
    If (EvalRes == 1)
    {
        C4_EngineMove.Result = 1;
    }
    Else
    {
        If (PieceCount == 42)
        {
            C4_EngineMove.Result = 3;
        }
    }
    Event.Broadcast("C4_EngineMoveDone");
}

WhenBroadcastReceived(C4_InitEngine)
{
    Call Init;
}

WhenBroadcastReceived(C4_PlayerMove)
{
    If (ColumnHeight[C4_PlayerMove.Column] < 6)
    {
        If (PieceCount == 0)
        {
            FirstMover = 2;
        }
        Move = (((5 - ColumnHeight[C4_PlayerMove.Column]) * 7) + C4_PlayerMove.Column);
        List.ReplaceItem(Board, Move, 2);
        List.ReplaceItem(ColumnHeight, C4_PlayerMove.Column, (ColumnHeight[C4_PlayerMove.Column] + 1));
        Board2 += IdxToExp[Move];
        Call CellApply(Move)(2);
        PieceCount += 1;
        C4_PlayerMove.Result = 0;
        Call EvaluateWinImpl(Board2)(Move);
        If (EvalRes == 1)
        {
            C4_PlayerMove.Result = 2;
        }
        Else
        {
            If (PieceCount == 42)
            {
                C4_PlayerMove.Result = 3;
            }
        }
        Event.Broadcast("C4_PlayerMoveDone");
    }
    Else
    {
        C4_PlayerMove.Result = -1;
        Event.Broadcast("C4_PlayerMoveDone");
    }
}


//----- Custom blocks -------------------------------------------------------------------------------------------------

Define ApplyMove(string Depth) (warp=true)
{
    Move = Moves[(((Depth - 1) * 10) + MovesIdx[Depth])];
    Idx = (((Move - 1) - (floor(((Move - 1) / 7)) * 7)) + 1);
    List.ReplaceItem(ColumnHeight, Idx, (ColumnHeight[Idx] + 1));
    If ((Depth - (floor((Depth / 2)) * 2)) == 1)
    {
        Board1 += IdxToExp[Move];
    }
    Else
    {
        Board2 += IdxToExp[Move];
    }
    Call CellApply(Move)((1 + (1 - (Depth - (floor((Depth / 2)) * 2)))));
    PieceCount += 1;
    NodesCount += 1;
    If ((NodesCount - (floor((NodesCount / 1024)) * 1024)) == 0)
    {
        If (((Sensing.DaysSince2000() * 86400) - Timer) > ThinkTime)
        {
            Search.Timeout = 1;
        }
    }
}

Define CellApply(string Cell)(string Side) (warp=true)
{
    Search.MoveWon = 0;
    CA.Idx = CellLineStart[Cell];
    CA.End = (CellLineStart[Cell] + CellLineCount[Cell]);
    Repeat Until (CA.Idx == CA.End)
    {
        CA.Line = CellLines[CA.Idx];
        If (Side == 1)
        {
            List.ReplaceItem(LineCount1, CA.Line, (LineCount1[CA.Line] + 1));
        }
        Else
        {
            List.ReplaceItem(LineCount2, CA.Line, (LineCount2[CA.Line] + 1));
        }
        List.ReplaceItem(LineOccSum, CA.Line, (LineOccSum[CA.Line] + (1 * Cell)));
        If ((LineCount1[CA.Line] + LineCount2[CA.Line]) == 4)
        {
            If ((LineCount1[CA.Line] == 4) Or (LineCount2[CA.Line] == 4))
            {
                Search.MoveWon = 1;
            }
        }
        CA.Idx += 1;
    }
    If (Side == 1)
    {
        PSTsum1 += (1 * Operator.Round((PST[Cell] * 0.5)));
    }
    Else
    {
        PSTsum2 += (1 * Operator.Round(((0 - PST[Cell]) * 0.5)));
    }
    If (((((Cell - 1) - (floor(((Cell - 1) / 7)) * 7)) + 1) == 3) Or ((((Cell - 1) - (floor(((Cell - 1) / 7)) * 7)) + 1) == 5))
    {
        If (Side == 1)
        {
            CenterNet += 1;
        }
        Else
        {
            CenterNet += -1;
        }
    }
}

Define CellRevert(string Cell)(string Side) (warp=true)
{
    CA.Idx = CellLineStart[Cell];
    CA.End = (CellLineStart[Cell] + CellLineCount[Cell]);
    Repeat Until (CA.Idx == CA.End)
    {
        CA.Line = CellLines[CA.Idx];
        If (Side == 1)
        {
            List.ReplaceItem(LineCount1, CA.Line, (LineCount1[CA.Line] + -1));
        }
        Else
        {
            List.ReplaceItem(LineCount2, CA.Line, (LineCount2[CA.Line] + -1));
        }
        List.ReplaceItem(LineOccSum, CA.Line, (LineOccSum[CA.Line] + (-1 * Cell)));
        CA.Idx += 1;
    }
    If (Side == 1)
    {
        PSTsum1 += (-1 * Operator.Round((PST[Cell] * 0.5)));
    }
    Else
    {
        PSTsum2 += (-1 * Operator.Round(((0 - PST[Cell]) * 0.5)));
    }
    If (((((Cell - 1) - (floor(((Cell - 1) / 7)) * 7)) + 1) == 3) Or ((((Cell - 1) - (floor(((Cell - 1) / 7)) * 7)) + 1) == 5))
    {
        If (Side == 1)
        {
            CenterNet += -1;
        }
        Else
        {
            CenterNet += 1;
        }
    }
}

Define CellWins(string Cell)(string Side) (warp=true)
{
    Ret.CellWins = 0;
    CW.Idx = CellLineStart[Cell];
    CW.End = (CellLineStart[Cell] + CellLineCount[Cell]);
    Repeat Until ((CW.Idx == CW.End) Or (Ret.CellWins == 1))
    {
        CW.Line = CellLines[CW.Idx];
        If (((((2 - Side) * LineCount1[CW.Line]) + ((Side - 1) * LineCount2[CW.Line])) == 3) And ((((Side - 1) * LineCount1[CW.Line]) + ((2 - Side) * LineCount2[CW.Line])) == 0))
        {
            Ret.CellWins = 1;
        }
        CW.Idx += 1;
    }
}

Define EvalPositionPattern(string Idx)(string StepIdxDelta)(bool PostProcess) (warp=true)
{
    Exp = IdxToExp[(Idx + 0)];
    If ((Board1 - (floor((Board1 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
    {
        Count1 += 1;
    }
    Else
    {
        If ((Board2 - (floor((Board2 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
        {
            Count2 += 1;
        }
        Else
        {
            Count3 += 1;
            PrevEmptyIdx = EmptyIdx;
            EmptyIdx = Idx;
        }
    }
    If PostProcess
    {
        Flag = 0;
    }
}

Define EvaluateMove(string Player)(string Move) (warp=true)
{
    If (Player == 1)
    {
        TmpBoard1 = Board1;
        TmpBoard2 = Board2;
    }
    Else
    {
        TmpBoard1 = Board2;
        TmpBoard2 = Board1;
    }
    EvalRes = 0;
    dX = 1;
    Repeat (2)
    {
        dY = 1;
        Repeat (2)
        {
            If ((dX == 0) And (dY == 0))
            {
                dXLoc = 1;
                dYLoc = -1;
            }
            Else
            {
                dXLoc = dX;
                dYLoc = dY;
            }
            Count1 = 1;
            Count2 = 0;
            Count3 = 0;
            Repeat (2)
            {
                Done = 0;
                SlotCount = 1;
                Idx = Move;
                Repeat Until ((Done == 1) Or (SlotCount == 4))
                {
                    If ((((Not ((dXLoc == -1))) Or (Not (((Idx - (floor((Idx / 7)) * 7)) == 1)))) And ((Not ((dXLoc == 1))) Or (Not (((Idx - (floor((Idx / 7)) * 7)) == 0))))) And (((Not ((dYLoc == -1))) Or (Idx > 7)) And ((Not ((dYLoc == 1))) Or (Idx < 36))))
                    {
                        Idx += ((dYLoc * 7) + dXLoc);
                        Exp = IdxToExp[Idx];
                        If ((TmpBoard1 - (floor((TmpBoard1 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
                        {
                            Count1 += 1;
                        }
                        Else
                        {
                            If ((TmpBoard2 - (floor((TmpBoard2 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
                            {
                                Count2 += 1;
                            }
                            Else
                            {
                                Count3 += 1;
                            }
                        }
                        If ((Count1 + (Count2 + Count3)) == 4)
                        {
                            If ((Count1 == 3) And (Count2 == 0))
                            {
                                EvalRes += 15;
                            }
                            If ((Count1 == 1) And (Count2 == 3))
                            {
                                EvalRes += 20;
                            }
                            If ((Count1 == 1) And (Count2 == 2))
                            {
                                EvalRes += 10;
                            }
                            If ((Count1 == 2) And (Count2 == 0))
                            {
                                EvalRes += 5;
                            }
                            If (SlotCount == 4)
                            {
                                Exp = IdxToExp[Idx];
                            }
                            Else
                            {
                                Exp = IdxToExp[(Idx - (3 * ((dYLoc * 7) + dXLoc)))];
                            }
                            If ((TmpBoard1 - (floor((TmpBoard1 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
                            {
                                Count1 += -1;
                            }
                            Else
                            {
                                If ((TmpBoard2 - (floor((TmpBoard2 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
                                {
                                    Count2 += -1;
                                }
                                Else
                                {
                                    Count3 += -1;
                                }
                            }
                        }
                    }
                    Else
                    {
                        Done = 1;
                    }
                    SlotCount += 1;
                }
                dXLoc = (0 - dXLoc);
                dYLoc = (0 - dYLoc);
            }
            dY += -1;
        }
        dX += -1;
    }
}

Define EvaluatePosition(string Depth) (warp=true)
{
    Call TTProbe(Board1)(Board2);
    If (Not ((TT.Eval == "")))
    {
        EvalRes = TT.Eval;
        Stop(this script);
    }
    EvalRes = 0;
    EvalGen += 1;
    List.DeleteAll(WinPatternBestRank);
    Repeat (7)
    {
        List.Add(WinPatternBestRank, 0);
    }
    Count = 0;
    WinCount1 = 0;
    WinCount2 = 0;
    Idx = 1;
    EvalRes += (PSTsum1 + PSTsum2);
    If ((PieceCount - Depth) > 5)
    {
        EvalRes += (8 * CenterNet);
    }
    EL.Idx = 1;
    Repeat (69)
    {
        Count1 = LineCount1[EL.Idx];
        Count2 = LineCount2[EL.Idx];
        Count3 = (4 - (LineCount1[EL.Idx] + LineCount2[EL.Idx]));
        EmptyIdx = (LineCellSum[EL.Idx] - LineOccSum[EL.Idx]);
        StepIdxDelta = LineDir[EL.Idx];
        If (Count3 == 1)
        {
            WinPatternSide = 0;
            Flag = 0;
            If (Count3 == 1)
            {
                EmptyRank = (floor(((EmptyIdx - 1) / 7)) + 1);
                EmptyFile = (((EmptyIdx - 1) - (floor(((EmptyIdx - 1) / 7)) * 7)) + 1);
                VerticalSuppress = 0;
                If ((StepIdxDelta == 7) And ((ColumnHeight[(EmptyFile + 0)] - (floor((ColumnHeight[(EmptyFile + 0)] / 2)) * 2)) == 1))
                {
                    If (EmptyRank == (6 - ColumnHeight[(EmptyFile + 0)]))
                    {
                        VerticalSuppress = 1;
                    }
                }
                If (Count1 == 3)
                {
                    WinPatternSide = 1;
                    Refutable = 0;
                    If (((EmptyRank + FirstMover) - (floor(((EmptyRank + FirstMover) / 2)) * 2)) == 1)
                    {
                        Flag = 1;
                    }
                    If (ColumnHeight[(EmptyFile + 0)] == (6 - EmptyRank))
                    {
                        Refutable = 1;
                        If (WinCols1[(EmptyFile + 0)] < EvalGen)
                        {
                            WinCount1 += 1;
                            List.ReplaceItem(WinCols1, (EmptyFile + 0), EvalGen);
                        }
                    }
                    List.ReplaceItem(Threats1, EmptyIdx, EvalGen);
                    If ((((EmptyRank > 1) And (Threats1[(EmptyIdx - 7)] == EvalGen)) Or ((EmptyRank < 6) And (Threats1[(EmptyIdx + 7)] == EvalGen))) And (VerticalSuppress == 0))
                    {
                        EvalRes += 50;
                    }
                }
                Else
                {
                    If (Count2 == 3)
                    {
                        WinPatternSide = -1;
                        If (((EmptyRank + FirstMover) - (floor(((EmptyRank + FirstMover) / 2)) * 2)) == 0)
                        {
                            Flag = 1;
                        }
                        If (ColumnHeight[(EmptyFile + 0)] == (6 - EmptyRank))
                        {
                            Refutable = 1;
                            If (WinCols2[(EmptyFile + 0)] < EvalGen)
                            {
                                WinCount2 += 1;
                                List.ReplaceItem(WinCols2, (EmptyFile + 0), EvalGen);
                            }
                        }
                        List.ReplaceItem(Threats2, EmptyIdx, EvalGen);
                        If ((((EmptyRank > 1) And (Threats2[(EmptyIdx - 7)] == EvalGen)) Or ((EmptyRank < 6) And (Threats2[(EmptyIdx + 7)] == EvalGen))) And (VerticalSuppress == 0))
                        {
                            EvalRes += -50;
                        }
                    }
                }
                If (Not ((WinPatternSide == 0)))
                {
                    EvalRes += (((-40 * Flag) + (65 - (5 * Refutable))) * WinPatternSide);
                    If (1 == 1)
                    {
                        Rank = WinPatternBestRank[(EmptyFile + 0)];
                        If (((EmptyRank > abs(Rank)) And ((Flag == 1) And ((Refutable == 0) Or (((WinPatternSide == 1) And (WinCount1 > 1)) Or ((WinPatternSide == -1) And (WinCount2 > 1)))))) And (VerticalSuppress == 0))
                        {
                            List.ReplaceItem(WinPatternBestRank, (EmptyFile + 0), (EmptyRank * WinPatternSide));
                        }
                    }
                }
            }
            PrevWinPatternSide = WinPatternSide;
            If (1 == 0)
            {
                If (Count3 == 2)
                {
                    If ((Count1 == 2) Or (Count2 == 2))
                    {
                        If (ColumnHeight[(EmptyFile + 0)] < (6 - EmptyRank))
                        {
                            Rank = (floor(((PrevEmptyIdx - 1) / 7)) + 1);
                            File = (((PrevEmptyIdx - 1) - (floor(((PrevEmptyIdx - 1) / 7)) * 7)) + 1);
                            If (ColumnHeight[(File + 0)] < (6 - Rank))
                            {
                                If (Count1 == 2)
                                {
                                    EvalRes += 5;
                                }
                                Else
                                {
                                    If (Count2 == 2)
                                    {
                                        EvalRes += -5;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Exp = IdxToExp[(Idx - (3 * StepIdxDelta))];
            If ((Board1 - (floor((Board1 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
            {
                Count1 += -1;
            }
            Else
            {
                If ((Board2 - (floor((Board2 / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
                {
                    Count2 += -1;
                }
                Else
                {
                    Count3 += -1;
                }
            }
        }
        EL.Idx += 1;
    }
    ZZ.WLow = 0;
    ZZ.BLow = 0;
    ZZ.Idx = 1;
    Repeat (7)
    {
        ZZ.Rank = WinPatternBestRank[ZZ.Idx];
        If (Not ((ZZ.Rank == 0)))
        {
            If (ZZ.Rank > 0)
            {
                ZZ.Side = 1;
            }
            Else
            {
                ZZ.Side = 2;
            }
            If (ZZ.Side == FirstMover)
            {
                If (abs(ZZ.Rank) > ZZ.WLow)
                {
                    ZZ.WLow = abs(ZZ.Rank);
                }
            }
            Else
            {
                If (abs(ZZ.Rank) > ZZ.BLow)
                {
                    ZZ.BLow = abs(ZZ.Rank);
                }
            }
        }
        ZZ.Idx += 1;
    }
    ZZ.Ctl = 2;
    If (ZZ.WLow > ZZ.BLow)
    {
        ZZ.Ctl = 1;
    }
    ZZ.Idx = 1;
    Repeat (7)
    {
        ZZ.Rank = WinPatternBestRank[ZZ.Idx];
        If (Not ((ZZ.Rank == 0)))
        {
            If (ZZ.Rank > 0)
            {
                ZZ.Side = 1;
                ZZ.Sign = 1;
            }
            Else
            {
                ZZ.Side = 2;
                ZZ.Sign = -1;
            }
            If (ZZ.Side == FirstMover)
            {
                ZZ.IsW = 1;
            }
            Else
            {
                ZZ.IsW = 2;
            }
            If (ZZ.IsW == ZZ.Ctl)
            {
                EvalRes += (100 * ZZ.Sign);
            }
            Else
            {
                EvalRes += (20 * ZZ.Sign);
            }
        }
        ZZ.Idx += 1;
    }
    If ((ZZ.WLow + ZZ.BLow) > 0)
    {
        If (ZZ.Ctl == 1)
        {
            If (FirstMover == 1)
            {
                EvalRes += 90;
            }
            Else
            {
                EvalRes += -90;
            }
        }
        Else
        {
            If (FirstMover == 1)
            {
                EvalRes += -90;
            }
            Else
            {
                EvalRes += 90;
            }
        }
    }
    Else
    {
        If (FirstMover == 1)
        {
            EvalRes += -45;
        }
        Else
        {
            EvalRes += 45;
        }
    }
    If ((Depth - (floor((Depth / 2)) * 2)) == 1)
    {
        If (WinCount2 > 0)
        {
            EvalRes = (0 - (1000 - (PieceCount + 1)));
        }
        Else
        {
            If (WinCount1 > 1)
            {
                EvalRes = (1000 - (PieceCount + 2));
            }
        }
    }
    Else
    {
        If (WinCount1 > 0)
        {
            EvalRes = (1000 - (PieceCount + 1));
        }
        Else
        {
            If (WinCount2 > 1)
            {
                EvalRes = (0 - (1000 - (PieceCount + 2)));
            }
        }
    }
    Call TTStore(Board1)(Board2)(EvalRes)("")("")("")("")("");
}

Define EvaluateWin(string Depth) (warp=true)
{
    EvalRes = "";
    If (Search.MoveWon == 1)
    {
        If ((Depth - (floor((Depth / 2)) * 2)) == 1)
        {
            EvalRes = (1000 - PieceCount);
        }
        Else
        {
            EvalRes = (-1000 + PieceCount);
        }
    }
}

Define EvaluateWinImpl(string Board)(string Move) (warp=true)
{
    EvalRes = 0;
    dX = 1;
    Repeat (2)
    {
        dY = 1;
        Repeat (2)
        {
            If ((dX == 0) And (dY == 0))
            {
                dXLoc = 1;
                dYLoc = -1;
            }
            Else
            {
                dXLoc = dX;
                dYLoc = dY;
            }
            Count = 1;
            Repeat (2)
            {
                Done = 0;
                SlotCount = 1;
                Idx = Move;
                Repeat Until ((Done == 1) Or (SlotCount == 4))
                {
                    If ((((Not ((dXLoc == -1))) Or (Not (((Idx - (floor((Idx / 7)) * 7)) == 1)))) And ((Not ((dXLoc == 1))) Or (Not (((Idx - (floor((Idx / 7)) * 7)) == 0))))) And (((Not ((dYLoc == -1))) Or (Idx > 7)) And ((Not ((dYLoc == 1))) Or (Idx < 36))))
                    {
                        Idx += ((dYLoc * 7) + dXLoc);
                        Exp = IdxToExp[Idx];
                        If ((Board - (floor((Board / (Exp * 2))) * (Exp * 2))) > (Exp - 1))
                        {
                            Count += 1;
                            If (Count == 4)
                            {
                                EvalRes = 1;
                                Stop(this script);
                            }
                        }
                        Else
                        {
                            Done = 1;
                        }
                    }
                    Else
                    {
                        Done = 1;
                    }
                    SlotCount += 1;
                }
                dXLoc = (0 - dXLoc);
                dYLoc = (0 - dYLoc);
            }
            dY += -1;
        }
        dX += -1;
    }
}

Define GenerateMoves(string Depth)(string MaxDepth) (warp=true)
{
    List.DeleteAll(Tmp1);
    List.DeleteAll(Tmp2);
    List.DeleteAll(Tmp3);
    List.ReplaceItem(MovesCount, Depth, 0);
    List.ReplaceItem(HasTTMove, Depth, 0);
    List.Add(Tmp3, 4);
    List.Add(Tmp3, 3);
    List.Add(Tmp3, 5);
    List.Add(Tmp3, 2);
    List.Add(Tmp3, 6);
    List.Add(Tmp3, 1);
    List.Add(Tmp3, 7);
    If (Depth > 0)
    {
        Call TTProbe(Board1)(Board2);
        If (Not ((TT.Move == "")))
        {
            If ((6 - ColumnHeight[(((TT.Move - 1) - (floor(((TT.Move - 1) / 7)) * 7)) + 1)]) == (floor(((TT.Move - 1) / 7)) + 1))
            {
                List.Add(Tmp1, TT.Move);
                List.ReplaceItem(HasTTMove, Depth, 1);
            }
        }
    }
    Idx = 1;
    Repeat (7)
    {
        Col = Tmp3[Idx];
        If (ColumnHeight[Col] < 6)
        {
            Val = (((5 - ColumnHeight[Col]) * 7) + Col);
            If (Not (List.ContainsItem(Tmp1, Val)))
            {
                List.Add(Tmp1, Val);
            }
        }
        Idx += 1;
    }
    If ((Depth - (floor((Depth / 2)) * 2)) == 1)
    {
        GM.Ours = Board1;
        GM.Theirs = Board2;
    }
    Else
    {
        GM.Ours = Board2;
        GM.Theirs = Board1;
    }
    List.DeleteAll(GM.Wins);
    List.DeleteAll(GM.Blocks);
    List.DeleteAll(GM.Safe);
    GM.Idx = 1;
    Repeat (List.Length(Tmp1))
    {
        GM.Move = Tmp1[GM.Idx];
        Call CellWins(GM.Move)((1 + (1 - (Depth - (floor((Depth / 2)) * 2)))));
        If (Ret.CellWins == 1)
        {
            List.Add(GM.Wins, GM.Move);
        }
        Else
        {
            Call CellWins(GM.Move)((3 - (1 + (1 - (Depth - (floor((Depth / 2)) * 2))))));
            If (Ret.CellWins == 1)
            {
                List.Add(GM.Blocks, GM.Move);
            }
            Else
            {
                If (GM.Move > 7)
                {
                    Call CellWins((GM.Move - 7))((3 - (1 + (1 - (Depth - (floor((Depth / 2)) * 2))))));
                    If (Not ((Ret.CellWins == 1)))
                    {
                        List.Add(GM.Safe, GM.Move);
                    }
                }
                Else
                {
                    List.Add(GM.Safe, GM.Move);
                }
            }
        }
        GM.Idx += 1;
    }
    If (List.Length(GM.Wins) > 0)
    {
        List.DeleteAll(Tmp1);
        List.Add(Tmp1, GM.Wins[1]);
    }
    Else
    {
        If (List.Length(GM.Blocks) > 0)
        {
            List.DeleteAll(Tmp1);
            List.Add(Tmp1, GM.Blocks[1]);
        }
        Else
        {
            If (List.Length(GM.Safe) > 0)
            {
                List.DeleteAll(Tmp1);
                GM.Idx = 1;
                Repeat (List.Length(GM.Safe))
                {
                    List.Add(Tmp1, GM.Safe[GM.Idx]);
                    GM.Idx += 1;
                }
            }
        }
    }
    Idx = 1;
    Repeat (List.Length(Tmp1))
    {
        List.ReplaceItem(Moves, (((Depth - 1) * 10) + Idx), Tmp1[Idx]);
        Idx += 1;
    }
    List.ReplaceItem(MovesCount, Depth, List.Length(Tmp1));
}

Define Init (warp=true)
{
    List.Hide(Console);
    List.DeleteAll(Alphas);
    List.DeleteAll(Betas);
    List.DeleteAll(Moves);
    List.DeleteAll(MovesCount);
    List.DeleteAll(HasTTMove);
    List.DeleteAll(MovesIdx);
    List.DeleteAll(Eval);
    List.DeleteAll(SearchState);
    List.DeleteAll(Console);
    List.DeleteAll(IdxToExp);
    List.DeleteAll(Board);
    List.DeleteAll(ColumnHeight);
    List.DeleteAll(TT.Board1);
    List.DeleteAll(TT.Board2);
    List.DeleteAll(TT.Eval);
    List.DeleteAll(TT.Move);
    List.DeleteAll(TT.MoveHorizon);
    List.DeleteAll(TT.NodeEval);
    List.DeleteAll(TT.NodeHorizon);
    List.DeleteAll(TT.NodeType);
    Board1 = 0;
    PSTsum1 = 0;
    PSTsum2 = 0;
    CenterNet = 0;
    Search.MoveWon = 0;
    List.DeleteAll(LineCount1);
    List.DeleteAll(LineCount2);
    List.DeleteAll(LineOccSum);
    Repeat (69)
    {
        List.Add(LineCount1, 0);
        List.Add(LineCount2, 0);
        List.Add(LineOccSum, 0);
    }
    Board2 = 0;
    List.DeleteAll(PST);
    Rank = 1;
    Repeat (6)
    {
        File = 1;
        Repeat (7)
        {
            Val = (20 - (2 * ((4 - abs(floor((3.5 - Rank)))) + (5 - abs((4 - File))))));
            If (File == 4)
            {
                Val += (20 + ((10 * ((Rank == 3) Or (Rank == 4))) + (5 * ((Rank == 2) Or (Rank == 5)))));
            }
            List.Add(PST, Val);
            File += 1;
        }
        Rank += 1;
    }
    Repeat (1000000)
    {
        List.Add(TT.Board1, 0);
        List.Add(TT.Gen, 0);
        List.Add(TT.Board2, 0);
        List.Add(TT.Eval, "");
        List.Add(TT.Move, "");
        List.Add(TT.MoveHorizon, "");
        List.Add(TT.NodeEval, "");
        List.Add(TT.NodeHorizon, "");
        List.Add(TT.NodeType, "");
    }
    Repeat (7)
    {
        List.Add(ColumnHeight, 0);
    }
    Idx = 1;
    Repeat (42)
    {
        List.Add(Board, 0);
        List.Add(Alphas, 0);
        List.Add(Betas, 0);
        List.Add(Eval, 0);
        List.Add(SearchState, 0);
        List.Add(HasTTMove, 0);
        Repeat (10)
        {
            List.Add(Moves, 0);
        }
        List.Add(MovesCount, 0);
        List.Add(MovesIdx, 0);
        List.Add(IdxToExp, Operator.Round(e ^(((42 - Idx) * ln(2)))));
        Idx += 1;
    }
    PieceCount = 0;
    If (1 == 0)
    {
        Variable.Show(Depth);
        Variable.Show(Nodes);
        Variable.Show(NPS);
        Variable.Show(Search.Eval);
        List.Show(Console);
    }
    NPS = "";
    Nodes = "";
    Depth = "";
    Search.Eval = "";
    Debug = 0;
    Variable.Hide(Depth);
    Variable.Hide(Nodes);
    Variable.Hide(NPS);
    Variable.Hide(Search.Eval);
    PrevSearchDepth = "";
    List.DeleteAll(Book.Key);
    List.DeleteAll(Book.Col);
    BK.Pos = 1;
    Repeat ((Variable.Length(Const.BookHex) / 16))
    {
        BK.K = 0;
        Repeat (13)
        {
            BK.K = ((BK.K * 16) + (List.IndexOf(Book.HexDigits, Operator.LetterOf(Const.BookHex, BK.Pos)) - 1));
            BK.Pos += 1;
        }
        BK.M = 0;
        Repeat (2)
        {
            BK.M = ((BK.M * 16) + (List.IndexOf(Book.HexDigits, Operator.LetterOf(Const.BookHex, BK.Pos)) - 1));
            BK.Pos += 1;
        }
        BK.Pos += 1;
        List.Add(Book.Key, BK.K);
        BK.S = "";
        BK.C = 1;
        Repeat (7)
        {
            If ((BK.M - (floor((BK.M / 2)) * 2)) == 1)
            {
                BK.S = Operator.Join(BK.S, BK.C);
            }
            BK.M = floor((BK.M / 2));
            BK.C += 1;
        }
        List.Add(Book.Col, BK.S);
    }
}

Define RevertMove(string Depth) (warp=true)
{
    Move = Moves[(((Depth - 1) * 10) + MovesIdx[Depth])];
    Idx = (((Move - 1) - (floor(((Move - 1) / 7)) * 7)) + 1);
    List.ReplaceItem(ColumnHeight, Idx, (ColumnHeight[Idx] - 1));
    If ((Depth - (floor((Depth / 2)) * 2)) == 1)
    {
        Board1 += (0 - IdxToExp[Move]);
    }
    Else
    {
        Board2 += (0 - IdxToExp[Move]);
    }
    Call CellRevert(Move)((1 + (1 - (Depth - (floor((Depth / 2)) * 2)))));
    PieceCount += -1;
}

Define Search(string Depth)(string MaxDepth) (warp=true)
{
    If (Depth == 1)
    {
        Depth = (MaxDepth - 1);
        NodesCount = 0;
        NPS = "";
        Nodes = "";
        Search.BestMove = "";
        Search.Eval = "";
        List.ReplaceItem(Alphas, Depth, -100000);
        List.ReplaceItem(Betas, Depth, 100000);
    }
    If (Depth > 1)
    {
        Call TTProbe(Board1)(Board2);
        If ((Not ((TT.NodeEval == ""))) And (Not ((TT.NodeHorizon < (MaxDepth - Depth)))))
        {
            If ((TT.NodeType == "E") Or (((TT.NodeType == "A") And (Not ((TT.NodeEval > Alphas[Depth])))) Or ((TT.NodeType == "B") And (Not ((TT.NodeEval < Betas[Depth]))))))
            {
                List.ReplaceItem(Eval, Depth, TT.NodeEval);
                Stop(this script);
            }
        }
    }
    If (Depth > 1)
    {
        Call EvaluateWin((Depth - 1));
        If (abs(EvalRes) > 900)
        {
            List.ReplaceItem(Eval, Depth, EvalRes);
            Stop(this script);
        }
        Call EvaluatePosition((Depth - 1));
        If ((Depth == MaxDepth) Or (abs(EvalRes) > 900))
        {
            List.ReplaceItem(Eval, Depth, EvalRes);
            Stop(this script);
        }
        If ((Betas[Depth] - Alphas[Depth]) == 1)
        {
            If (((Depth > 1) And (Depth < MaxDepth)) And ((MaxDepth - Depth) < 3))
            {
                If ((Depth - (floor((Depth / 2)) * 2)) == 1)
                {
                    If (Not (((EvalRes + (40 + (40 * (MaxDepth - Depth)))) > Alphas[Depth])))
                    {
                        List.ReplaceItem(Eval, Depth, EvalRes);
                        Stop(this script);
                    }
                }
                Else
                {
                    If (Not (((EvalRes - (40 + (40 * (MaxDepth - Depth)))) < Betas[Depth])))
                    {
                        List.ReplaceItem(Eval, Depth, EvalRes);
                        Stop(this script);
                    }
                }
            }
        }
    }
    List.ReplaceItem(BestMoves, Depth, "");
    List.ReplaceItem(Eval, Depth, "");
    Call GenerateMoves(Depth)(MaxDepth);
    If (MovesCount[Depth] == 0)
    {
        List.ReplaceItem(Eval, Depth, 0);
        Stop(this script);
    }
    List.ReplaceItem(MovesIdx, Depth, 1);
    Repeat (MovesCount[Depth])
    {
        Call ApplyMove(Depth);
        List.ReplaceItem(SearchState, Depth, 0);
        If (1 == 1)
        {
            If ((HasTTMove[Depth] == 1) And (MovesIdx[Depth] > 1))
            {
                List.ReplaceItem(SearchState, Depth, 1);
                If ((Depth - (floor((Depth / 2)) * 2)) == 1)
                {
                    List.ReplaceItem(Alphas, (Depth + 1), Alphas[Depth]);
                    List.ReplaceItem(Betas, (Depth + 1), (Alphas[Depth] + 1));
                }
                Else
                {
                    List.ReplaceItem(Alphas, (Depth + 1), (Betas[Depth] - 1));
                    List.ReplaceItem(Betas, (Depth + 1), Betas[Depth]);
                }
                Call Search((Depth + 1))(MaxDepth);
                Score = Eval[(Depth + 1)];
                If (Search.Timeout == 1)
                {
                    Call RevertMove(Depth);
                    Stop(this script);
                }
                If ((Score > Alphas[Depth]) And (Score < Betas[Depth]))
                {
                    List.ReplaceItem(SearchState, Depth, 0);
                }
            }
        }
        If (SearchState[Depth] == 0)
        {
            List.ReplaceItem(Alphas, (Depth + 1), Alphas[Depth]);
            List.ReplaceItem(Betas, (Depth + 1), Betas[Depth]);
            Call Search((Depth + 1))(MaxDepth);
            Score = Eval[(Depth + 1)];
            If (Search.Timeout == 1)
            {
                Call RevertMove(Depth);
                Stop(this script);
            }
        }
        Call RevertMove(Depth);
        If ((Depth - (floor((Depth / 2)) * 2)) == 1)
        {
            If (Score > Alphas[Depth])
            {
                List.ReplaceItem(Alphas, Depth, Score);
                List.ReplaceItem(BestMoves, Depth, Moves[(((Depth - 1) * 10) + MovesIdx[Depth])]);
                If (Depth == 1)
                {
                    Search.BestMove = Moves[MovesIdx[1]];
                    Search.Eval = Score;
                }
                If (Not ((Score < Betas[Depth])))
                {
                    If (Not ((Depth == 1)))
                    {
                        List.ReplaceItem(Eval, Depth, Betas[Depth]);
                        Call TTStore(Board1)(Board2)("")(Moves[(((Depth - 1) * 10) + MovesIdx[Depth])])((MaxDepth - Depth))(Eval[Depth])((MaxDepth - Depth))("B");
                        Stop(this script);
                    }
                }
            }
        }
        Else
        {
            If (Score < Betas[Depth])
            {
                List.ReplaceItem(BestMoves, Depth, Moves[(((Depth - 1) * 10) + MovesIdx[Depth])]);
                List.ReplaceItem(Betas, Depth, Score);
                If (Not ((Score > Alphas[Depth])))
                {
                    List.ReplaceItem(Eval, Depth, Alphas[Depth]);
                    Call TTStore(Board1)(Board2)("")(Moves[(((Depth - 1) * 10) + MovesIdx[Depth])])((MaxDepth - Depth))(Eval[Depth])((MaxDepth - Depth))("A");
                    Stop(this script);
                }
            }
        }
        List.ReplaceItem(MovesIdx, Depth, (MovesIdx[Depth] + 1));
    }
    If ((Depth - (floor((Depth / 2)) * 2)) == 1)
    {
        List.ReplaceItem(Eval, Depth, Alphas[Depth]);
    }
    Else
    {
        List.ReplaceItem(Eval, Depth, Betas[Depth]);
    }
    Val = "E";
    If (((Betas[Depth] - Alphas[Depth]) == 1) Or (BestMoves[Depth] == ""))
    {
        If ((Depth - (floor((Depth / 2)) * 2)) == 1)
        {
            Val = "A";
        }
        Else
        {
            Val = "B";
        }
    }
    Call TTStore(Board1)(Board2)("")(BestMoves[Depth])((MaxDepth - Depth))(Eval[Depth])((MaxDepth - Depth))(Val);
}

Define TTProbe(string Board1)(string Board2) (warp=true)
{
    TT.Eval = "";
    TT.Move = "";
    TT.NodeEval = "";
    TT.NodeHorizon = "";
    TT.NodeType = "";
    Idx = ((((Board1 * 31) + (4398046511104 - Board2)) - (floor((((Board1 * 31) + (4398046511104 - Board2)) / List.Length(TT.Board1))) * List.Length(TT.Board1))) + 1);
    If ((TT.Board1[Idx] == Board1) And (TT.Board2[Idx] == Board2))
    {
        TT.Eval = TT.Eval[Idx];
        TT.Move = TT.Move[Idx];
        TT.NodeEval = TT.NodeEval[Idx];
        TT.NodeHorizon = TT.NodeHorizon[Idx];
        TT.NodeType = TT.NodeType[Idx];
    }
}

Define TTStore(string Board1)(string Board2)(string Eval)(string Move)(string MoveHorizon)(string NodeEval)(string NodeHorizon)(string NodeType) (warp=true)
{
    TT.StoreHorizon = NodeHorizon;
    If (abs(NodeEval) > 900)
    {
        TT.StoreHorizon = 99;
    }
    Idx = ((((Board1 * 31) + (4398046511104 - Board2)) - (floor((((Board1 * 31) + (4398046511104 - Board2)) / List.Length(TT.Board1))) * List.Length(TT.Board1))) + 1);
    If ((((TT.Board1[Idx] == Board1) And (TT.Board2[Idx] == Board2)) Or (Not ((TT.Gen[Idx] == Search.Gen)))) Or (Not ((TT.NodeHorizon[Idx] > TT.StoreHorizon))))
    {
        If ((Not ((TT.Board1[Idx] == Board1))) Or (Not ((TT.Board2[Idx] == Board2))))
        {
            List.ReplaceItem(TT.Board1, Idx, Board1);
            List.ReplaceItem(TT.Gen, Idx, Search.Gen);
            List.ReplaceItem(TT.Board2, Idx, Board2);
            List.ReplaceItem(TT.Eval, Idx, Eval);
            List.ReplaceItem(TT.Move, Idx, Move);
            List.ReplaceItem(TT.MoveHorizon, Idx, MoveHorizon);
            List.ReplaceItem(TT.NodeEval, Idx, NodeEval);
            List.ReplaceItem(TT.NodeHorizon, Idx, TT.StoreHorizon);
            List.ReplaceItem(TT.NodeType, Idx, NodeType);
        }
        Else
        {
            If (Not ((Eval == "")))
            {
                List.ReplaceItem(TT.Eval, Idx, Eval);
            }
            If (Not ((Move == "")))
            {
                If ((TT.Move[Idx] == "") Or (Not ((TT.MoveHorizon[Idx] > MoveHorizon))))
                {
                    List.ReplaceItem(TT.Move, Idx, Move);
                    List.ReplaceItem(TT.MoveHorizon, Idx, MoveHorizon);
                }
            }
            If (Not ((NodeEval == "")))
            {
                If ((TT.NodeEval[Idx] == "") Or (Not ((TT.NodeHorizon[Idx] > TT.StoreHorizon))))
                {
                    List.ReplaceItem(TT.NodeEval, Idx, NodeEval);
                    List.ReplaceItem(TT.NodeHorizon, Idx, TT.StoreHorizon);
                    List.ReplaceItem(TT.NodeType, Idx, NodeType);
                }
            }
        }
    }
}

Define _ClearLists (warp=true)
{
    List.DeleteAll(Alphas);
    List.DeleteAll(Betas);
    List.DeleteAll(Moves);
    List.DeleteAll(MovesCount);
    List.DeleteAll(MovesIdx);
    List.DeleteAll(Eval);
    List.DeleteAll(Console);
    List.DeleteAll(IdxToExp);
    List.DeleteAll(Board);
    List.DeleteAll(SearchState);
    List.DeleteAll(ColumnHeight);
    List.DeleteAll(TT.Board1);
    List.DeleteAll(TT.Gen);
    List.DeleteAll(TT.Board2);
    List.DeleteAll(TT.Eval);
    List.DeleteAll(TT.Move);
    List.DeleteAll(TT.NodeHorizon);
    List.DeleteAll(TT.NodeEval);
    List.DeleteAll(TT.NodeType);
    List.DeleteAll(TT.MoveHorizon);
}

Define _ForceEngineStartMoveStep1 (warp=false)
{
    FirstMover = 1;
    Search.BestMove = 39;
    List.ReplaceItem(Board, Search.BestMove, 1);
    List.ReplaceItem(ColumnHeight, (((Search.BestMove - 1) - (floor(((Search.BestMove - 1) / 7)) * 7)) + 1), (ColumnHeight[(((Search.BestMove - 1) - (floor(((Search.BestMove - 1) / 7)) * 7)) + 1)] + 1));
    Board1 += IdxToExp[Search.BestMove];
    Call CellApply(Search.BestMove)(1);
    PieceCount += 1;
    C4_EngineMove.Column = (((Search.BestMove - 1) - (floor(((Search.BestMove - 1) / 7)) * 7)) + 1);
    C4_EngineMove.Result = 0;
}

//===== Sprite: Stage =====
//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Stg_SelectedColumn = "";
    Stg_State = 0;
    Looks.SwitchBackdropTo(Intro);
    Wait Until Sensing.MouseDown();
    If (Sensing.MouseX() < 0)
    {
        Stg_IsPlayerFirst = 1;
    }
    Else
    {
        Stg_IsPlayerFirst = 0;
    }
    Wait Until (Not (Sensing.MouseDown()));
    Looks.SwitchBackdropTo(Sky);
    Event.BroadcastAndWait("Stg_ShowBoard");
    Event.BroadcastAndWait("C4_InitEngine");
    Event.BroadcastAndWait("Stg_StartGame");
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived(C4_EngineMoveDone)
{
    If (Stg_State == 3)
    {
        Stg_DropEngineMoveColumn = C4_EngineMove.Column;
        Stg_DropEngineMoveColumnSlots = Stg_Slots[Stg_DropEngineMoveColumn];
        Event.Broadcast("Stg_DropEnginePiece");
    }
}

WhenBroadcastReceived(C4_PlayerMoveDone)
{
    If (Stg_State == 2)
    {
        If (C4_PlayerMove.Result == 0)
        {
            Stg_State = 3;
            Event.BroadcastAndWait("StG_EngineMoveUI");
            Event.Broadcast("C4_EngineMove");
        }
        Else
        {
            Stg_State = 4;
        }
    }
}

WhenBroadcastReceived(Stg_DropEnginePieceDone)
{
    If (Stg_State == 3)
    {
        List.ReplaceItem(Stg_Slots, Stg_DropEngineMoveColumn, (Stg_Slots[Stg_DropEngineMoveColumn] - 1));
        Stg_SelectedColumnSlots = Stg_Slots[Stg_SelectedColumn];
        Event.Broadcast("Stg_SelectedColumnChanged");
        If (C4_EngineMove.Result == 0)
        {
            Stg_State = 1;
            Event.Broadcast("Stg_PlayerMoveUI");
        }
        Else
        {
            Stg_State = 4;
        }
    }
}

WhenBroadcastReceived(Stg_DropPlayerPieceDone)
{
    If (Stg_State == 2)
    {
        List.ReplaceItem(Stg_Slots, Stg_DropPlayerMoveColumn, (Stg_Slots[Stg_DropPlayerMoveColumn] - 1));
        Stg_SelectedColumnSlots = Stg_Slots[Stg_SelectedColumn];
        C4_PlayerMove.Column = Stg_DropPlayerMoveColumn;
        Event.Broadcast("C4_PlayerMove");
    }
}

WhenBroadcastReceived(Stg_PlayerPieceClicked)
{
    If (Stg_State == 1)
    {
        Call UpdateSelectedColumn;
        If (Stg_SelectedColumnSlots > 0)
        {
            Stg_DropPlayerMoveColumn = Stg_SelectedColumn;
            Stg_DropPlayerMoveColumnSlots = Stg_Slots[Stg_DropPlayerMoveColumn];
            Stg_State = 2;
            Event.Broadcast("Stg_DropPlayerPiece");
        }
    }
}

WhenBroadcastReceived(Stg_StartGame)
{
    List.DeleteAll(Stg_Slots);
    Repeat (7)
    {
        List.Add(Stg_Slots, 6);
    }
    Stg_SelectedColumn = 4;
    Stg_SelectedColumnSlots = Stg_Slots[Stg_SelectedColumn];
    If (Stg_IsPlayerFirst == 1)
    {
        Stg_State = 1;
        Event.Broadcast("Stg_PlayerMoveUI");
    }
    Else
    {
        Stg_State = 3;
        Event.BroadcastAndWait("StG_EngineMoveUI");
        Event.Broadcast("C4_EngineMove");
    }
}


//----- Custom blocks -------------------------------------------------------------------------------------------------

Define UpdateSelectedColumn (warp=false)
{
    If (Stg_State == 1)
    {
        Stg_Idx = (floor((((Sensing.MouseX() + 175) / 350) * 7)) + 1);
        If (Stg_Idx < 1)
        {
            Stg_Idx = 1;
        }
        Else
        {
            If (Stg_Idx > 7)
            {
                Stg_Idx = 7;
            }
        }
        If (Not ((Stg_SelectedColumn == Stg_Idx)))
        {
            Stg_SelectedColumn = Stg_Idx;
            Stg_SelectedColumnSlots = Stg_Slots[Stg_SelectedColumn];
            Event.BroadcastAndWait("Stg_SelectedColumnChanged");
        }
    }
}

Define _ForceEngineStartMoveStep2 (warp=false)
{
    Stg_State = 3;
    Event.BroadcastAndWait("StG_EngineMoveUI");
    Stg_DropEngineMoveColumn = C4_EngineMove.Column;
    Stg_DropEngineMoveColumnSlots = Stg_Slots[Stg_DropEngineMoveColumn];
    Event.Broadcast("Stg_DropEnginePiece");
}

//===== Sprite: Board =====
//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Looks.Hide();
}


//----- Sprite clicked events -----------------------------------------------------------------------------------------

WhenThisSpriteClicked()
{
    Event.Broadcast("Stg_PlayerPieceClicked");
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived(C4_EngineMoveDone)
{
    If (Costume.GetNumberName(name) == "Board")
    {
        If (C4_EngineMove.Result == 1)
        {
            Control.Wait(0.5);
            Looks.Say("Good game! Another round? Press green flag!");
            Sound.Play(Checkmate);
        }
        Else
        {
            If (C4_EngineMove.Result == 3)
            {
                Control.Wait(0.5);
                Looks.Say("Draw! Another round? Press green flag!");
                Sound.Play(Draw);
            }
        }
    }
}

WhenBroadcastReceived(C4_PlayerMoveDone)
{
    If (Costume.GetNumberName(name) == "Board")
    {
        If (C4_PlayerMove.Result == 2)
        {
            Looks.Say("Congrats! Another round? Press green flag!");
        }
        Else
        {
            If (C4_PlayerMove.Result == 3)
            {
                Looks.Say("Draw! Another round? Press green flag!");
            }
            Else
            {
                If (C4_PlayerMove.Result == -1)
                {
                    Looks.Say("Invalid state. The engine did not accept the move. Please post a bug report in a comment. Thank you!");
                }
            }
        }
    }
}

WhenBroadcastReceived(Stg_ShowBoard)
{
    Motion.GoToXY(0, -20);
    Looks.SwitchCostumeTo(Background);
    Control.CreateCloneOf(_myself_);
    Looks.SwitchCostumeTo(Board);
    Costume.GoToFrontBack(front);
    Looks.Show();
}

