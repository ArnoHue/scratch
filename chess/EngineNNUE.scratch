    List.Add(OpeningMovesNeutral, 53371127634602195236273646360722584313293626122059310917264110263122152243282230624403210067212837281913);
    List.Add(OpeningMovesNeutral, 5337111952361228584328374337033037473023564016246346021240322316624416446044132159520722006806135958);
    List.Add(OpeningMovesNeutral, 5337132152361228372821286346062051350722352720135945006562441018006718273627111949410925585225335759);
    List.Add(OpeningMovesNeutral, 5337132152361228372911275143021963460418494107245034273634261925592415244336031258520103413306346244);
    List.Add(OpeningMovesNeutral, 5337132963460219622609172633102633420722006706274933010233261726462919295236273660361220543829193644);
    List.Add(OpeningMovesNeutral, 533713215236122837291127514302196346041862532736433607135841133041510312006701035640061340320065);
    List.Add(OpeningMovesNeutral, 533713215236122858521127634627363728042862352820006707225242021942361936463609176261061351430065);
    List.Add(OpeningMovesNeutral, 533713215236122858521127634627364636072237282228554703126255021936191219006706136053006562600418);
