Define NNUE_HexToDec(string Hex) (warp=true)
{
    List.DeleteAll(TmpList1);
    List.Add(TmpList1, 0);
    List.Add(TmpList1, 1);
    List.Add(TmpList1, 2);
    List.Add(TmpList1, 3);
    List.Add(TmpList1, 4);
    List.Add(TmpList1, 5);
    List.Add(TmpList1, 6);
    List.Add(TmpList1, 7);
    List.Add(TmpList1, 8);
    List.Add(TmpList1, 9);
    List.Add(TmpList1, "a");
    List.Add(TmpList1, "b");
    List.Add(TmpList1, "c");
    List.Add(TmpList1, "d");
    List.Add(TmpList1, "e");
    List.Add(TmpList1, "f");
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
    NNUE_HexToDec.Idx = 1;
    Repeat ((Variable.Length(Hex) / 3))
    {
        NNUE_HexToDec.Word = ((((List.IndexOf(TmpList1, Operator.LetterOf(Hex, NNUE_HexToDec.Idx)) - 1) * 256) + ((List.IndexOf(TmpList1, Operator.LetterOf(Hex, (NNUE_HexToDec.Idx + 1))) - 1) * 16)) + (List.IndexOf(TmpList1, Operator.LetterOf(Hex, (NNUE_HexToDec.Idx + 2))) - 1));
        If (NNUE_HexToDec.Word > 2048)
        {
            NNUE_HexToDec.Word = (2048 - NNUE_HexToDec.Word);
        }
        If (List.Length(NNUE_ListRes_1) < (768 * 256))
        {
            List.Add(NNUE_ListRes_1, (NNUE_HexToDec.Word + 0));
        }
        Else
        {
            List.Add(NNUE_ListRes_2, (NNUE_HexToDec.Word + 0));
        }
        NNUE_HexToDec.Idx += 3;
    }
}

Define NNUE_ImportNetwork(string InputWeights)(string HiddenBias)(string HiddenWeights)(string OutputBias) (warp=true)
{
    List.DeleteAll(NNUE_InputWeights);
    List.DeleteAll(NNUE_InputWeights);
    List.DeleteAll(NNUE_HiddenBias);
    List.DeleteAll(NNUE_HiddenWeights);
    List.DeleteAll(NNUE_OutputBias);
    Call NNUE_DecToHex(InputWeights);
    Glob.NNUE.InputWeights_HEX = Ret.NNUE_DecToHex.Hex;
    Glob.NNUE.HiddenBias_CSV = HiddenBias;
    Glob.NNUE.HiddenWeights_CSV = HiddenWeights;
    Glob.NNUE.OutputBias_CSV = OutputBias;
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
}

Define NNUE_Init (warp=true)
{
    Call NNUE_DecodeNetwork;
    Const.NNUE_HiddenSize = 512;
    Const.NNUE_HiddenPackedSize = 128;
    List.DeleteAll(NNUE_Accumulator);
    Repeat (((Const.NNUE_HiddenPackedSize * 2) * Const.MaxPlyStackFrames))
    {
        List.Add(NNUE_Accumulator, 0);
    }
    List.DeleteAll(NNUE_Accumulator_MetaState);
    List.DeleteAll(NNUE_AccStackState);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(NNUE_Accumulator_MetaState, 0);
        List.Add(NNUE_AccStackState, 0);
    }
    NNUE_Init.SqIdx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        List.ReplaceItem(NNUE_Accumulator, NNUE_Init.SqIdx, NNUE_HiddenBias[NNUE_Init.SqIdx]);
        List.ReplaceItem(NNUE_Accumulator, (Const.NNUE_HiddenPackedSize + NNUE_Init.SqIdx), NNUE_HiddenBias[NNUE_Init.SqIdx]);
        NNUE_Init.SqIdx += 1;
    }
    List.DeleteAll(NNUE_GoKIdxToSquare);
    NNUE_Init.SqIdx = 1;
    Repeat (64)
    {
        List.Add(NNUE_GoKIdxToSquare, ((((8 - IdxToRank[NNUE_Init.SqIdx]) * 8) + IdxToFile[NNUE_Init.SqIdx]) - 1));
        NNUE_Init.SqIdx += 1;
    }
    List.DeleteAll(NNUE_InputIdxMap);
    Repeat (2000)
    {
        List.Add(NNUE_InputIdxMap, 0);
    }
    NNUE_Init.SqIdx = 0;
    Repeat (12)
    {
        NNUE_Init.SqBaseIdx = 0;
        Repeat (64)
        {
            List.ReplaceItem(NNUE_InputIdxMap, (((NNUE_Init.SqIdx * 64) + NNUE_Init.SqBaseIdx) + 1), ((NNUE_Init.SqIdx * 64) + NNUE_Init.SqBaseIdx));
            NNUE_Init.NNIdx = 0;
            NNUE_Init.Exp = 1;
            Repeat (8)
            {
                If (Not ((((NNUE_Init.SqBaseIdx % (NNUE_Init.Exp * 2)) > (NNUE_Init.Exp - 1)) == ((56 % (NNUE_Init.Exp * 2)) > (NNUE_Init.Exp - 1)))))
                {
                    NNUE_Init.NNIdx += NNUE_Init.Exp;
                }
                NNUE_Init.Exp = (NNUE_Init.Exp * 2);
            }
            If (NNUE_Init.SqIdx > 5)
            {
                NNUE_Init.NNIdx += ((NNUE_Init.SqIdx - 6) * 64);
            }
            Else
            {
                NNUE_Init.NNIdx += ((NNUE_Init.SqIdx + 6) * 64);
            }
            List.ReplaceItem(NNUE_InputIdxMap, ((1000 + ((NNUE_Init.SqIdx * 64) + NNUE_Init.SqBaseIdx)) + 1), NNUE_Init.NNIdx);
            NNUE_Init.SqBaseIdx += 1;
        }
        NNUE_Init.SqIdx += 1;
    }
    Call NNUE_Public_Evaluate(1);
}

Define NNUE_LoadList(string Data) (warp=true)
{
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
    NNUE_LoadList.CharIdx = 1;
    NNUE_LoadList.Token = "";
    Repeat Until (NNUE_LoadList.CharIdx > Variable.Length(Data))
    {
        If ((Not ((Operator.LetterOf(Data, NNUE_LoadList.CharIdx) == " "))) And (Not ((Operator.LetterOf(Data, NNUE_LoadList.CharIdx) == ","))))
        {
            NNUE_LoadList.Token = Operator.Join(NNUE_LoadList.Token, Operator.LetterOf(Data, NNUE_LoadList.CharIdx));
        }
        If ((Operator.LetterOf(Data, NNUE_LoadList.CharIdx) == ",") Or (NNUE_LoadList.CharIdx == Variable.Length(Data)))
        {
            If (List.Length(NNUE_ListRes_1) < (floor((200000 / 256)) * 256))
            {
                List.Add(NNUE_ListRes_1, (NNUE_LoadList.Token + 0));
            }
            Else
            {
                List.Add(NNUE_ListRes_2, (NNUE_LoadList.Token + 0));
            }
            NNUE_LoadList.Token = "";
        }
        NNUE_LoadList.CharIdx += 1;
    }
}

Define NNUE_OnApplyMove(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_AccStackState, Ply, 1);
}

Define NNUE_OnApplyMoveDone(string Ply)(string Move)(string SourcePiece)(string TargetPiece)(string PromotionPiece)(string TargetPieceIdx) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodEnter((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
    }
    If (Move == 0)
    {
        Call NNUE_UpdateAccStack((Ply - 1));
        NNUE_OnApplyMoveDone.PlyBaseIdx = ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1));
        NNUE_OnApplyMoveDone.TargetIdx = ((Const.NNUE_HiddenPackedSize * 2) * Ply);
        NNUE_OnApplyMoveDone.AccIdx = 1;
        Repeat ((Const.NNUE_HiddenPackedSize * 2))
        {
            List.ReplaceItem(NNUE_Accumulator, (NNUE_OnApplyMoveDone.TargetIdx + NNUE_OnApplyMoveDone.AccIdx), NNUE_Accumulator[(NNUE_OnApplyMoveDone.PlyBaseIdx + NNUE_OnApplyMoveDone.AccIdx)]);
            NNUE_OnApplyMoveDone.AccIdx += 1;
        }
        List.ReplaceItem(NNUE_AccStackState, Ply, 0);
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call ProfilerMethodExit((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
        }
        Stop(this script);
    }
    Call NNUE_StartBulkActivation(Ply);
    If (floor((Move / 100)) == 0)
    {
        NNUE_OnApplyMoveDone.KingMove = (CastlingKingMove[(Move + 0)] + 0);
        NNUE_OnApplyMoveDone.RookMove = (CastlingRookMove[(Move + 0)] + 0);
        If (SourcePiece > 0)
        {
            NNUE_OnApplyMoveDone.RookPiece = GoK_BlackRook;
        }
        Else
        {
            NNUE_OnApplyMoveDone.RookPiece = GoK_WhiteRook;
        }
        NNUE_OnApplyMoveDone.SourcePiece = (((6 * (NNUE_OnApplyMoveDone.RookPiece > 0)) + PieceIdxLookup[abs(NNUE_OnApplyMoveDone.RookPiece)]) - 1);
        Call NNUE_ActDeactBulkImpl(floor((NNUE_OnApplyMoveDone.RookMove / 100)))(floor((NNUE_OnApplyMoveDone.RookMove % 100)))(NNUE_OnApplyMoveDone.SourcePiece)(NNUE_OnApplyMoveDone.SourcePiece)(Const.Null)(0)(Ply);
        NNUE_OnApplyMoveDone.FromIdx = floor((NNUE_OnApplyMoveDone.KingMove / 100));
        NNUE_OnApplyMoveDone.ToIdx = floor((NNUE_OnApplyMoveDone.KingMove % 100));
    }
    Else
    {
        NNUE_OnApplyMoveDone.FromIdx = (NNUE_GoKIdxToSquare[floor((Move / 100))] + 0);
        NNUE_OnApplyMoveDone.ToIdx = (NNUE_GoKIdxToSquare[floor((Move % 100))] + 0);
    }
    NNUE_OnApplyMoveDone.SourcePiece = (((6 * (SourcePiece > 0)) + PieceIdxLookup[abs(SourcePiece)]) - 1);
    If (PromotionPiece == 0)
    {
        NNUE_OnApplyMoveDone.PlacedPiece = NNUE_OnApplyMoveDone.SourcePiece;
    }
    Else
    {
        NNUE_OnApplyMoveDone.PlacedPiece = (((6 * (PromotionPiece > 0)) + PieceIdxLookup[abs(PromotionPiece)]) - 1);
    }
    If (TargetPiece == 0)
    {
        NNUE_OnApplyMoveDone.CapturedPiece = Const.Null;
        NNUE_OnApplyMoveDone.CapSquare = 0;
    }
    Else
    {
        NNUE_OnApplyMoveDone.CapturedPiece = (((6 * (TargetPiece > 0)) + PieceIdxLookup[abs(TargetPiece)]) - 1);
        NNUE_OnApplyMoveDone.CapSquare = (NNUE_GoKIdxToSquare[(TargetPieceIdx + 0)] + 0);
    }
    Call NNUE_ActDeactBulkImpl(NNUE_OnApplyMoveDone.FromIdx)(NNUE_OnApplyMoveDone.ToIdx)(NNUE_OnApplyMoveDone.SourcePiece)(NNUE_OnApplyMoveDone.PlacedPiece)(NNUE_OnApplyMoveDone.CapturedPiece)(NNUE_OnApplyMoveDone.CapSquare)(Ply);
    Call NNUE_StopBulkActivation(Ply);
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodExit((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
    }
}

Define NNUE_OnInitStack(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_AccStackState, Ply, 1);
}

Define NNUE_Public_Evaluate(string Ply) (warp=true)
{
    Call NNUE_Evaluate(PlyIsOwn[Ply])((Ply - 1));
    Ret.NNUE_Public_Evaluate.Score = Ret.NNUE_Evaluate.Score;
    If (Ret.NNUE_Public_Evaluate.Score > Const.AbsMinCheckmateEval)
    {
        Ret.NNUE_Public_Evaluate.Score = Const.AbsMinCheckmateEval;
    }
    Else
    {
        If (Ret.NNUE_Public_Evaluate.Score < (0 - Const.AbsMinCheckmateEval))
        {
            Ret.NNUE_Public_Evaluate.Score = (0 - Const.AbsMinCheckmateEval);
        }
    }
    If (PlyIsOwn[Ply] == 0)
    {
        Ret.NNUE_Public_Evaluate.Score = (0 - Ret.NNUE_Public_Evaluate.Score);
    }
    If (abs(Ret.NNUE_Public_Evaluate.Score) < Const.AbsMinCheckmateEval)
    {
        Ret.NNUE_Public_Evaluate.Score = (Operator.Round((Ret.NNUE_Public_Evaluate.Score * 100)) / 100);
    }
}

Define NNUE_Public_OnMakeMoveStart(string Ply) (warp=true)
{
}

Define NNUE_Public_Refresh (warp=true)
{
    NNUE_Public_Refresh.HiddenBiaIdx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        List.ReplaceItem(NNUE_Accumulator, NNUE_Public_Refresh.HiddenBiaIdx, NNUE_HiddenBias[NNUE_Public_Refresh.HiddenBiaIdx]);
        List.ReplaceItem(NNUE_Accumulator, (NNUE_Public_Refresh.HiddenBiaIdx + Const.NNUE_HiddenPackedSize), NNUE_HiddenBias[NNUE_Public_Refresh.HiddenBiaIdx]);
        NNUE_Public_Refresh.HiddenBiaIdx += 1;
    }
    NNUE_Public_Refresh.AccIdx = 1;
    Repeat (64)
    {
        If (Not ((Board[NNUE_Public_Refresh.AccIdx] == 0)))
        {
            Call NNUE_Activate(NNUE_Public_Refresh.AccIdx)(Board[NNUE_Public_Refresh.AccIdx])(0);
        }
        NNUE_Public_Refresh.AccIdx += 1;
    }
}

Define NNUE_StartBulkActivation(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 1);
}

Define NNUE_StopBulkActivation(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 3);
}

Define NNUE_UpdateAccStack(string Ply) (warp=true)
{
    If (Ply > 0)
    {
        If (NNUE_AccStackState[Ply] == 1)
        {
            Call NNUE_UpdateAccStack((Ply - 1));
            Call UpdateNNUEPostApplyMove(Ply);
            List.ReplaceItem(NNUE_AccStackState, Ply, 0);
        }
    }
}

Define OnEvaluationChanged(string Eval) (warp=false)
{
    If (Glob.Config.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Eval == Const.Null)
    {
        Stop(this script);
    }
    OnEvaluationChanged.ClampedEval = Eval;
    If (OnEvaluationChanged.ClampedEval > 1000)
    {
        OnEvaluationChanged.ClampedEval = 100;
    }
    Else
    {
        If (OnEvaluationChanged.ClampedEval < -1000)
        {
            OnEvaluationChanged.ClampedEval = -100;
        }
        Else
        {
            OnEvaluationChanged.ClampedEval = (OnEvaluationChanged.ClampedEval / 10);
        }
    }
    If (Not ((GoK_EvaluationValue == OnEvaluationChanged.ClampedEval)))
    {
        GoK_EvaluationValue = OnEvaluationChanged.ClampedEval;
        Event.Broadcast("GoK_EvaluationValueChanged");
        Control.Wait(0);
    }
}

Define OnProgressChanged(string Progress) (warp=false)
{
    If (Glob.Config.IsDCI == 1)
    {
        Stop(this script);
    }
    OnProgressChanged.Percent = Operator.Round(Progress);
    If (OnProgressChanged.Percent > 100)
    {
        OnProgressChanged.Percent = 100;
    }
    If (OnProgressChanged.Percent < 0)
    {
        OnProgressChanged.Percent = 0;
    }
    If (Not ((OnProgressChanged.Percent == GoK_ProgressValue)))
    {
        GoK_ProgressValue = OnProgressChanged.Percent;
        Event.Broadcast("GoK_ProgressValueChanged");
        Control.Wait(0);
    }
}

Define OnRestart (warp=true)
{
    Const.ProfilerMode.Off = 0;
    Const.ProfilerMode.Std = 1;
    Const.ProfilerMode.Full = 2;
    Looks.Say("");
    List.DeleteAll(Logfile);
    List.Add(Logfile, Glob.Config.VersionString);
    List.Hide(BoardHistory);
    List.Hide(GameMovesAN);
    List.Hide(ExportData);
    List.Hide(CreditsData);
    List.Hide(ExportMoves);
    List.Hide(Logfile);
    List.Hide(ProfilingData);
    Variable.Hide(Glob.UI.Depth);
    Variable.Hide(Glob.UI.Eval);
    Variable.Hide(Glob.UI.Move);
    Variable.Hide(Glob.UI.NPS);
    Variable.Hide(Glob.UI.MPS);
    Variable.Hide(Glob.UI.PV);
    Variable.Hide(Glob.Config.CustomThinkTime);
    Glob.Profile.Mode = Const.ProfilerMode.Off;
    Glob.Config.DebugMode = 0;
    Glob.Clock.TimeControl = -1;
    Glob.Search.IterationIdx = Const.Null;
    If (Glob.Search.IterationIdx == Const.Null)
    {
        Glob.UI.Depth = "D: 0";
    }
    Else
    {
        Glob.UI.Depth = Operator.Join("D: ", Glob.Search.IterationIdx);
    }
    Ret.SearchWrp.BestMoveEval = Const.Null;
    If (Ret.SearchWrp.BestMoveEval == Const.Null)
    {
        Glob.UI.Eval = "EV: 0";
    }
    Else
    {
        Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
    }
    Ret.Search.NPS = Const.Null;
    If (Ret.Search.NPS == Const.Null)
    {
        Glob.UI.NPS = "kNPS: 0";
    }
    Else
    {
        Glob.UI.NPS = Operator.Join("kNPS: ", Operator.Round((Ret.Search.NPS / 1000)));
    }
    Ret.Search.MPS = Const.Null;
    If (Ret.Search.MPS == Const.Null)
    {
        Glob.UI.MPS = "kMPS: 0";
    }
    Else
    {
        Glob.UI.MPS = Operator.Join("kMPS: ", Operator.Round((Ret.Search.MPS / 1000)));
    }
    Ret.Search.PV = "";
    Call UI.FormatPV;
    Glob.Config.CustomThinkTime = 0;
    Glob.Config.CustomMaxDepth = 0;
    Glob.Clock.InitialTime = 0;
    Glob.Clock.TimeInc = 0;
    Glob.Clock.StageMoves = 0;
    Glob.Clock.StageTime = 0;
}

Define PadInto(string value)(string width)(bool rightJustify) (warp=true)
{
    Ret.PadInto.Padded = value;
    Repeat Until (Not ((Variable.Length(Ret.PadInto.Padded) < width)))
    {
        If rightJustify
        {
            Ret.PadInto.Padded = Operator.Join(" ", Ret.PadInto.Padded);
        }
        Else
        {
            Ret.PadInto.Padded = Operator.Join(Ret.PadInto.Padded, " ");
        }
    }
}

Define Perft(string PerftPly)(string PerftHorizon)(string PerftStaged) (warp=true)
{
    If (PerftHorizon == 0)
    {
        Glob.Stats.PerftNodes += 1;
        Stop(this script);
    }
    Call PerftPrepareNode(PerftPly)(PerftStaged);
    If (PerftStaged == 0)
    {
        List.ReplaceItem(MovesIdx, PerftPly, 1);
        Repeat (MovesCount[PerftPly])
        {
            Call ApplyMove(PerftPly)((1 == 0));
            Call IsCheckedFast((PerftPly + 1));
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Call PerftValidateCheck(PerftPly);
                Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
            }
            Call RevertMove(PerftPly);
            List.ReplaceItem(MovesIdx, PerftPly, (MovesIdx[PerftPly] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, PerftPly, Const.PickPhase1HashMove);
        List.ReplaceItem(PickMoveRes, PerftPly, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, PerftPly, 0);
        Repeat Until (PickMoveRes[PerftPly] == 0)
        {
            Call PickMove(PerftPly)((1 == 0))((1 == 0));
            If (PickMoveRes[PerftPly] == 1)
            {
                Call IsCheckedFast((PerftPly + 1));
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Call PerftValidateCheck(PerftPly);
                    Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
                }
                Call RevertMove(PerftPly);
            }
        }
    }
}

Define PerftDivide(string PerftDivHorizon)(string PerftDivStaged) (warp=true)
{
    List.DeleteAll(PerftDivideOut);
    Call PerftPrepareNode(1)(PerftDivStaged);
    If (PerftDivStaged == 0)
    {
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            Call ApplyMove(1)((1 == 0));
            Call IsCheckedFast(2);
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Glob.Stats.PerftNodes = 0;
                Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.Stats.PerftNodes));
            }
            Call RevertMove(1);
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, 1, Const.PickPhase1HashMove);
        List.ReplaceItem(PickMoveRes, 1, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, 1, 0);
        Repeat Until (PickMoveRes[1] == 0)
        {
            Call PickMove(1)((1 == 0))((1 == 0));
            If (PickMoveRes[1] == 1)
            {
                Call IsCheckedFast(2);
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Glob.Stats.PerftNodes = 0;
                    Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                    List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.Stats.PerftNodes));
                }
                Call RevertMove(1);
            }
        }
    }
}

Define PerftPrepareNode(string PerftPrepPly)(string PerftPrepStaged) (warp=true)
{
    If (PerftPrepPly == 1)
    {
        List.ReplaceItem(CastlingState, 1, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
        Call SetInitialEP(1);
    }
    Else
    {
        List.ReplaceItem(CastlingState, PerftPrepPly, CastlingState[(PerftPrepPly - 1)]);
        List.ReplaceItem(EnPassantTarget, PerftPrepPly, EnPassantTarget[(PerftPrepPly - 1)]);
    }
    Call IsCheckedFast((PerftPrepPly + 1));
    List.ReplaceItem(CheckedState, PerftPrepPly, Ret.IsCheckedFast.IsChecked);
    List.ReplaceItem(BoardAttackedCalculated, PerftPrepPly, 0);
    Call PrepareCheckInfo(PerftPrepPly);
    If (PerftPrepStaged == 0)
    {
        Call CalcBoardAttackedOnDemand(PerftPrepPly)((1 == 0))((1 == 1))(99);
        Call GenerateMovesImplWrapper(PerftPrepPly)((1 == 0))((1 == 0))((1 == 0));
    }
}

Define PerftValidateCheck(string ValPly) (warp=true)
{
    PerftValidateCheck.Source = floor((AppliedMove[ValPly] / 100));
    PerftValidateCheck.Target = floor((AppliedMove[ValPly] % 100));
    PerftValidateCheck.Fast = 0;
    If (Not ((PerftValidateCheck.Target > List.Length(Board))))
    {
        Call IsCheckingPiece(PerftValidateCheck.Target);
        If (Ret.IsCheckingPiece.IsChecking == 1)
        {
            PerftValidateCheck.Fast = 1;
        }
    }
    Call IsCheckingPieceDiscovery(PerftValidateCheck.Source)(PerftValidateCheck.Target)(ValPly);
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 1)
    {
        PerftValidateCheck.Fast = 1;
    }
    Call IsCheckedFast((ValPly + 2));
    PerftValidateCheck.Actual = Ret.IsCheckedFast.IsChecked;
    If (Not ((PerftValidateCheck.Fast == PerftValidateCheck.Actual)))
    {
        Glob.Stats.PerftCheckMismatches += 1;
        If (Glob.Stats.PerftCheckMismatches < 26)
        {
            PerftValidateCheck.Line = "";
            PerftValidateCheck.AppliedMoveIdx = 1;
            Repeat (ValPly)
            {
                PerftValidateCheck.Line = Operator.Join(PerftValidateCheck.Line, Operator.Join(AppliedMove[PerftValidateCheck.AppliedMoveIdx], " "));
                PerftValidateCheck.AppliedMoveIdx += 1;
            }
            Call TestLog("MISMATCH ply ")(ValPly)(" fast=")(PerftValidateCheck.Fast)(" actual=")(PerftValidateCheck.Actual)(" line: ")(PerftValidateCheck.Line);
        }
    }
}

Define PickMove(string Ply)(bool Quiescence)(bool UpdateNNUE) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodEnter((480 + Ply));
    }
    Call //("Staged move-generator implementation");
    If (PickPhase[Ply] == Const.PickPhase1HashMove)
    {
        List.ReplaceItem(PickCaptureStageDone, Ply, 0);
        List.ReplaceItem(PickBadCaptureCount, Ply, 0);
        Call //("Phase 1: Look up hash-move from transposition table");
        List.ReplaceItem(HashMove, Ply, Const.Null);
        List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
        List.ReplaceItem(MovesCount, Ply, 0);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(BestMoveListIdx, Ply, 0);
        Call ClearMoveList(Ply);
        If ((Ply > 1) Or (1 == 1))
        {
            PickMove.Move = Const.Null;
            PickMove.Found = 0;
            If (Not ((Ply > List.Length(PVStablePrev))))
            {
                PickMove.Found = 1;
                PickMove.CalcMovesScoreListIdx = 1;
                PickMove.PVStablePrevIdx = 1;
                Repeat Until ((PickMove.CalcMovesScoreListIdx == Ply) Or (PickMove.Found == 0))
                {
                    If (Not ((AppliedMove[PickMove.CalcMovesScoreListIdx] == PVStablePrev[PickMove.PVStablePrevIdx])))
                    {
                        PickMove.Found = 0;
                    }
                    PickMove.CalcMovesScoreListIdx += 1;
                    PickMove.PVStablePrevIdx += 1;
                }
                If (PickMove.Found == 1)
                {
                    Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence)((1 == 0));
                    If List.ContainsItem(CalcMovesMoveList, PVStablePrev[Ply])
                    {
                        PickMove.Move = PVStablePrev[Ply];
                    }
                    If (Ply == 1)
                    {
                        If (Not ((Glob.Search.IterationBestMove == Const.Null)))
                        {
                            If List.ContainsItem(CalcMovesMoveList, Glob.Search.IterationBestMove)
                            {
                                PickMove.Move = Glob.Search.IterationBestMove;
                            }
                        }
                        PickMove.LineIdx = 1;
                        PickMove.LineFound = 0;
                        Repeat Until ((PickMove.LineFound == 1) Or (PickMove.LineIdx > List.Length(RootLinePrevMoves)))
                        {
                            If (Not (List.ContainsItem(RootExcludedMoves, RootLinePrevMoves[PickMove.LineIdx])))
                            {
                                If List.ContainsItem(CalcMovesMoveList, RootLinePrevMoves[PickMove.LineIdx])
                                {
                                    PickMove.Move = RootLinePrevMoves[PickMove.LineIdx];
                                    PickMove.LineFound = 1;
                                }
                            }
                            PickMove.LineIdx += 1;
                        }
                    }
                }
            }
            PickMove.TTQSMeta = NodeTTQSMeta[Ply];
            PickMove.TTHorizon = NodeTTHorizon[Ply];
            PickMove.TTHit = NodeTTHit[Ply];
            PickMove.HashMove = NodeTTMove[Ply];
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.TTMoveProbe)(HorizonAtPly[Ply])(Ply);
            }
            If ((Not ((PickMove.TTHit == Const.Null))) And (PickMove.TTHit == 1))
            {
                If ((PickMove.Move == Const.Null) And (Not ((PickMove.HashMove == Const.Null))))
                {
                    Call IsQuiescentCheckCond(Ply);
                    PickMove.IsTTMoveUsable = 0;
                    If (Not (Quiescence))
                    {
                        PickMove.IsTTMoveUsable = 1;
                    }
                    Else
                    {
                        If (PickMove.TTHorizon == -1)
                        {
                            If (Not ((PickMove.TTQSMeta == Const.Null)))
                            {
                                If (Not ((PickMove.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue)))
                                {
                                    PickMove.IsTTMoveUsable = 1;
                                }
                            }
                        }
                    }
                    If (PickMove.IsTTMoveUsable == 1)
                    {
                        If (Not ((floor((PickMove.HashMove / 100)) == 0)))
                        {
                            PickMove.SourceIdx = floor((PickMove.HashMove / 100));
                            PickMove.Targetdx = floor((PickMove.HashMove % 100));
                            PickMove.SourcePiece = Board[PickMove.SourceIdx];
                            PickMove.TargetPiece = Board[PickMove.Targetdx];
                            If (PickMove.SourcePiece == 0)
                            {
                                PickMove.CalcMovesScoreListIdx = ((PickMove.SourceIdx * 100) + PickMove.Targetdx);
                            }
                            Else
                            {
                                PickMove.CalcMovesScoreListIdx = ((PieceIdxLookup[abs(PickMove.SourcePiece)] * 10000) + ((PickMove.SourceIdx * 100) + PickMove.Targetdx));
                            }
                            PickMove.HashMoveIsIllegalPawnCapture = 0;
                            If ((abs(PickMove.SourcePiece) == GoK_BlackPawn) And (PickMove.TargetPiece == 0))
                            {
                                If (Not ((IdxToFile[PickMove.SourceIdx] == IdxToFile[PickMove.Targetdx])))
                                {
                                    PickMove.HashMoveIsIllegalPawnCapture = 1;
                                    If (Not ((EnPassantTarget[Ply] == Const.Null)))
                                    {
                                        If (PickMove.Targetdx == (EnPassantTarget[Ply] + (8 * (((PickMove.SourcePiece > 0) * 2) - 1))))
                                        {
                                            PickMove.HashMoveIsIllegalPawnCapture = 0;
                                        }
                                    }
                                }
                            }
                            PickMove.HashMovePathClear = 1;
                            If (abs(PickMove.SourcePiece) == GoK_BlackPawn)
                            {
                                If (IdxToFile[PickMove.SourceIdx] == IdxToFile[PickMove.Targetdx])
                                {
                                    If (Not ((PickMove.TargetPiece == 0)))
                                    {
                                        PickMove.HashMovePathClear = 0;
                                    }
                                    If (abs((PickMove.Targetdx - PickMove.SourceIdx)) == 16)
                                    {
                                        If (Not ((Board[((PickMove.SourceIdx + PickMove.Targetdx) / 2)] == 0)))
                                        {
                                            PickMove.HashMovePathClear = 0;
                                        }
                                    }
                                }
                                If (((PickMove.Targetdx < 9) Or (PickMove.Targetdx > 56)) And (PickMove.HashMove == floor(PickMove.HashMove)))
                                {
                                    PickMove.HashMovePathClear = 0;
                                }
                            }
                            Else
                            {
                                Call IsReachableForAttack(PickMove.SourcePiece)(PickMove.SourceIdx)(PickMove.Targetdx);
                                PickMove.HashMovePathClear = Ret.IsReachableForAttack.IsReachable;
                            }
                            PickMove.IsHashMoveLegal = 0;
                            If ((PickMove.HashMovePathClear == 1) And (PickMove.HashMoveIsIllegalPawnCapture == 0))
                            {
                                If (PlyIsOwn[Ply] == 1)
                                {
                                    If ((Not ((MoveToHash[(60000 + PickMove.CalcMovesScoreListIdx)] == 0))) And ((PickMove.SourcePiece > 0) And (Not ((PickMove.TargetPiece > 0)))))
                                    {
                                        PickMove.IsHashMoveLegal = 1;
                                    }
                                }
                                Else
                                {
                                    If ((Not ((MoveToHash[PickMove.CalcMovesScoreListIdx] == 0))) And ((PickMove.SourcePiece < 0) And (Not ((PickMove.TargetPiece < 0)))))
                                    {
                                        PickMove.IsHashMoveLegal = 1;
                                    }
                                }
                            }
                            If (PickMove.IsHashMoveLegal == 1)
                            {
                                PickMove.Move = PickMove.HashMove;
                                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                }
                            }
                        }
                        Else
                        {
                            Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence)((1 == 0));
                            If List.ContainsItem(CalcMovesMoveList, PickMove.HashMove)
                            {
                                PickMove.Move = PickMove.HashMove;
                                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                }
                            }
                        }
                    }
                }
            }
            If (Not ((PickMove.Move == Const.Null)))
            {
                Call ClearMoveList(Ply);
                PickMove.MoveScore = 9100000;
                Call AddMoveToList(PickMove.Move)(Ply)(PickMove.MoveScore);
                List.ReplaceItem(MovesIdx, Ply, 0);
                List.ReplaceItem(PickPhase, Ply, Const.PickPhase2GenerateCaptures);
                List.ReplaceItem(PickMoveRes, Ply, 0);
                Call PickMove.Iterate(Ply)(Const.PickPhase2GenerateCaptures)(UpdateNNUE);
                If (PickMoveRes[Ply] == 1)
                {
                    List.ReplaceItem(HashMove, Ply, PickMove.Move);
                    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                    {
                        Call ProfilerMethodExit((480 + Ply));
                    }
                    Stop(this script);
                }
            }
        }
        List.ReplaceItem(PickPhase, Ply, Const.PickPhase2GenerateCaptures);
    }
    If (PickPhase[Ply] == Const.PickPhase2GenerateCaptures)
    {
        If (Quiescence Or ((Ply < Const.PickCaptureStageMinPly) Or (CheckedState[Ply] == 1)))
        {
            List.ReplaceItem(PickPhase, Ply, Const.PickPhase6GenerateRemaining);
        }
        Else
        {
            List.ReplaceItem(PickCaptureStageDone, Ply, 1);
            Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 1))((1 == 0));
            Call PickMove.StashBadCaptures(Ply);
            List.ReplaceItem(MovesIdx, Ply, 0);
            List.ReplaceItem(PickPhase, Ply, Const.PickPhase3PickCaptures);
        }
    }
    If (PickPhase[Ply] == Const.PickPhase3PickCaptures)
    {
        Call PickMove.Iterate(Ply)(Const.PickPhase4GenerateRefutations)(UpdateNNUE);
    }
    If (PickPhase[Ply] == Const.PickPhase4GenerateRefutations)
    {
        Call PrepareKillers(Ply);
        PickMove.CounterMove = Const.Null;
        If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
        {
            PickMove.CounterMove = HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))];
        }
        Call PickMove.TryKCMove(CurrentKillerMoves[1])(Ply)(6000000);
        Call PickMove.TryKCMove(CurrentKillerMoves[2])(Ply)(5000000);
        PickMove.KillerMove1 = CurrentKillerMoves[1];
        PickMove.KillerMove2 = CurrentKillerMoves[2];
        If ((Ply > 1) And (Not ((PickMove.CounterMove == Const.Null))))
        {
            If ((Not ((PickMove.CounterMove == PickMove.KillerMove1))) And (Not ((PickMove.CounterMove == PickMove.KillerMove2))))
            {
                Call PickMove.TryKCMove(HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))])(Ply)(4000000);
            }
        }
        List.ReplaceItem(PickPhase, Ply, Const.PickPhase5PickRefutations);
    }
    If (PickPhase[Ply] == Const.PickPhase5PickRefutations)
    {
        Call PickMove.Iterate(Ply)(Const.PickPhase6GenerateRemaining)(UpdateNNUE);
    }
    If (PickPhase[Ply] == Const.PickPhase6GenerateRemaining)
    {
        Call CalcBoardAttackedOnDemand(Ply)(Quiescence)((1 == 1))(99);
        Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence)((PickCaptureStageDone[Ply] == 1));
        If (PickCaptureStageDone[Ply] == 1)
        {
            Call PickMove.SortQuietsPartial(Ply)((Const.QuietMoveBaseScore - (Const.QuietSortDepthFactor * HorizonAtPly[Ply])));
            Call PickMove.AppendBadCaptures(Ply);
        }
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(PickPhase, Ply, Const.PickPhase7PickRemaining);
    }
    If (PickPhase[Ply] == Const.PickPhase7PickRemaining)
    {
        Call PickMove.Iterate(Ply)(Const.PickPhase8Done)(UpdateNNUE);
    }
    If (PickPhase[Ply] == Const.PickPhase8Done)
    {
        List.ReplaceItem(PickMoveRes, Ply, 0);
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodExit((480 + Ply));
    }
}

Define PickMove.AppendBadCaptures(string Ply) (warp=true)
{
    PickMove.AppendBadCaptures.BaseIdx = ((Ply - 1) * Const.MaxMovesPerGeneration);
    PickMove.AppendBadCaptures.MovesCount = MovesCount[Ply];
    PickMove.AppendBadCaptures.StashIdx = 1;
    Repeat (PickBadCaptureCount[Ply])
    {
        PickMove.AppendBadCaptures.MovesCount += 1;
        List.ReplaceItem(Moves, (PickMove.AppendBadCaptures.BaseIdx + PickMove.AppendBadCaptures.MovesCount), PickBadCaptureMoves[(PickMove.AppendBadCaptures.BaseIdx + PickMove.AppendBadCaptures.StashIdx)]);
        List.ReplaceItem(MovesScore, (PickMove.AppendBadCaptures.BaseIdx + PickMove.AppendBadCaptures.MovesCount), PickBadCaptureScores[(PickMove.AppendBadCaptures.BaseIdx + PickMove.AppendBadCaptures.StashIdx)]);
        PickMove.AppendBadCaptures.StashIdx += 1;
    }
    List.ReplaceItem(MovesCount, Ply, PickMove.AppendBadCaptures.MovesCount);
}

Define PickMove.Iterate(string Ply)(string NextPhase)(bool UpdateNNUE) (warp=true)
{
    PickMove.Iterate.Picked = 1;
    Repeat Until ((PickMove.Iterate.Picked == 0) Or (Not ((MovesIdx[Ply] < MovesCount[Ply]))))
    {
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
        Call GetCurrentMove(Ply);
        PickMove.Iterate.Move = Ret.GetCurrentMove.Move;
        Call IsMovePicked(Ply)(PickMove.Iterate.Move);
        PickMove.Iterate.Picked = Ret.IsMovePicked.Picked;
        If ((PickMove.Iterate.Picked == 0) And (PickPhase[Ply] == Const.PickPhase3PickCaptures))
        {
            If ((PickMove.Iterate.Move == floor(PickMove.Iterate.Move)) And (Not ((floor((PickMove.Iterate.Move / 100)) == 0))))
            {
                PickMove.Iterate.CaptureAttackerPiece = Board[floor((PickMove.Iterate.Move / 100))];
                PickMove.Iterate.CaptureVictimPiece = Board[(PickMove.Iterate.Move % 100)];
                If (Not ((PickMove.Iterate.CaptureVictimPiece == 0)))
                {
                    Call IsLosingCapture(Ply)(PickMove.Iterate.Move)(PickMove.Iterate.CaptureAttackerPiece)(PickMove.Iterate.CaptureVictimPiece);
                    If (Ret.IsLosingCapture.IsLosing == 1)
                    {
                        List.ReplaceItem(PickBadCaptureCount, Ply, (PickBadCaptureCount[Ply] + 1));
                        PickMove.Iterate.StashIdx = (((Ply - 1) * Const.MaxMovesPerGeneration) + PickBadCaptureCount[Ply]);
                        List.ReplaceItem(PickBadCaptureMoves, PickMove.Iterate.StashIdx, PickMove.Iterate.Move);
                        List.ReplaceItem(PickBadCaptureScores, PickMove.Iterate.StashIdx, (MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])] - (Const.CaptureGoodBaseScore - Const.CaptureBadBaseScore)));
                        PickMove.Iterate.Picked = 1;
                    }
                }
            }
        }
        If (PickMove.Iterate.Picked == 0)
        {
            Call IsCastlingPathSafe(PickMove.Iterate.Move)(Ply);
            If (Ret.IsCastlingPathSafe.IsSafe == 0)
            {
                PickMove.Iterate.Picked = 1;
            }
            Else
            {
                PickMove.Iterate.PreSkip = 0;
                If (((Quiescence[Ply] == 1) And (CheckedState[Ply] == 0)) And (floor((PickMove.Iterate.Move / 100)) > 0))
                {
                    PickMove.Iterate.PreFrom = floor((PickMove.Iterate.Move / 100));
                    PickMove.Iterate.PreTo = (PickMove.Iterate.Move - (PickMove.Iterate.PreFrom * 100));
                    PickMove.Iterate.PreSrc = Board[PickMove.Iterate.PreFrom];
                    PickMove.Iterate.PreTgt = Board[PickMove.Iterate.PreTo];
                    If ((((Not ((PickMove.Iterate.PreTgt == 0))) And (abs(PickMove.Iterate.PreTgt) < abs(PickMove.Iterate.PreSrc))) And ((Not ((StaticEval[Ply] == Const.Null))) And (((StaticEval[Ply] - abs(PickMove.Iterate.PreTgt)) + 175) > Alphas[Ply]))) And (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval)))
                    {
                        Call ClearMoveList((Ply + 2));
                        Call AddMoveToList(PickMove.Iterate.Move)((Ply + 2))(0);
                        List.ReplaceItem(MovesIdx, (Ply + 2), 1);
                        Call ApplyMoveLight((Ply + 2));
                        Call SEE((Ply + 2))((Glob.Config.IsScratch3 == 0));
                        Call RevertMoveLight((Ply + 2));
                        If (Ret.SEE.Gain < 0)
                        {
                            PickMove.Iterate.PreSkip = 1;
                        }
                    }
                }
                If (PickMove.Iterate.PreSkip == 1)
                {
                    PickMove.Iterate.Picked = 1;
                }
                Else
                {
                    List.ReplaceItem(PickedPseudoLegalMoves, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), PickMove.Iterate.Move);
                    List.ReplaceItem(PickedPseudoLegalMovesScore, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])]);
                    List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, (PickedPseudoLegalMovesCount[Ply] + 1));
                    PickMove.Iterate.LMPDo = 0;
                    If ((((Quiescence[Ply] == 0) And (Not ((PreLMPLimit[Ply] == Const.Null)))) And ((floor((PickMove.Iterate.Move / 100)) > 0) And (Not ((SearchEval[Ply] == Const.Null))))) And ((SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval)) And ((PickedLegalMovesCountQuiet[Ply] + 1) > PreLMPLimit[Ply])))
                    {
                        PickMove.Iterate.LMPFrom = floor((PickMove.Iterate.Move / 100));
                        PickMove.Iterate.LMPTo = (PickMove.Iterate.Move - (PickMove.Iterate.LMPFrom * 100));
                        If (((Board[PickMove.Iterate.LMPTo] == 0) And (Not ((abs(Board[PickMove.Iterate.LMPFrom]) == GoK_BlackPawn)))) And (Not ((abs(Board[PickMove.Iterate.LMPFrom]) == GoK_BlackKing))))
                        {
                            PickMove.Iterate.GC = 0;
                            If (PlyIsOwn[Ply] == 1)
                            {
                                PickMove.Iterate.GCIdx = Glob.Board.WhiteKingIdx;
                            }
                            Else
                            {
                                PickMove.Iterate.GCIdx = Glob.Board.BlackKingIdx;
                            }
                            Call IsReachableForAttack(Board[PickMove.Iterate.LMPFrom])(PickMove.Iterate.LMPTo)(PickMove.Iterate.GCIdx);
                            PickMove.Iterate.GC = Ret.IsReachableForAttack.IsReachable;
                            If (PickMove.Iterate.GC == 0)
                            {
                                PickMove.Iterate.GCIdx = 1;
                                Repeat (DiscoveryCount[Ply])
                                {
                                    If ((DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + PickMove.Iterate.GCIdx)] == PickMove.Iterate.LMPFrom) And (Not ((abs(MoveToPathStepInc[((PickMove.Iterate.LMPFrom * 100) + PickMove.Iterate.LMPTo)]) == DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + PickMove.Iterate.GCIdx)]))))
                                    {
                                        PickMove.Iterate.GC = 1;
                                    }
                                    PickMove.Iterate.GCIdx += 1;
                                }
                            }
                            If (PickMove.Iterate.GC == 0)
                            {
                                PickMove.Iterate.LMPDo = 1;
                                PickMove.Iterate.PinIdx = 1;
                                Repeat (PinCount[Ply])
                                {
                                    If ((PinSq[(((Ply - 1) * Const.CheckInfoPlyStride) + PickMove.Iterate.PinIdx)] == PickMove.Iterate.LMPFrom) And (Not ((abs(MoveToPathStepInc[((PickMove.Iterate.LMPFrom * 100) + PickMove.Iterate.LMPTo)]) == PinRay[(((Ply - 1) * Const.CheckInfoPlyStride) + PickMove.Iterate.PinIdx)]))))
                                    {
                                        PickMove.Iterate.LMPDo = 0;
                                    }
                                    PickMove.Iterate.PinIdx += 1;
                                }
                            }
                        }
                    }
                    If (PickMove.Iterate.LMPDo == 1)
                    {
                        List.ReplaceItem(PickedLegalMovesCount, Ply, (PickedLegalMovesCount[Ply] + 1));
                        List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, (PickedLegalMovesCountQuiet[Ply] + 1));
                        PickMove.Iterate.Picked = 1;
                    }
                    Else
                    {
                        Call ApplyMove(Ply)(UpdateNNUE);
                        Call IsMoveLegalFast(Ply);
                        If (Ret.IsMoveLegalFast.IsLegal == 1)
                        {
                            Call RevertMove(Ply);
                            PickMove.Iterate.Picked = 1;
                        }
                    }
                }
            }
        }
    }
    If (PickMove.Iterate.Picked == 0)
    {
        List.ReplaceItem(PickMoveRes, Ply, 1);
        Stop(this script);
    }
    List.ReplaceItem(PickPhase, Ply, NextPhase);
}

Define PickMove.SortQuietsPartial(string Ply)(string MinScore) (warp=true)
{
    PickMove.SortQuietsPartial.MoveCount = List.Length(CalcMovesMoveList);
    PickMove.SortQuietsPartial.SortedEndIdx = 1;
    PickMove.SortQuietsPartial.ScanIdx = 2;
    Repeat ((PickMove.SortQuietsPartial.MoveCount - 1))
    {
        If (Not ((CalcMovesScoreList[PickMove.SortQuietsPartial.ScanIdx] < MinScore)))
        {
            PickMove.SortQuietsPartial.HeldMove = CalcMovesMoveList[PickMove.SortQuietsPartial.ScanIdx];
            PickMove.SortQuietsPartial.HeldScore = CalcMovesScoreList[PickMove.SortQuietsPartial.ScanIdx];
            PickMove.SortQuietsPartial.SortedEndIdx += 1;
            List.ReplaceItem(CalcMovesMoveList, PickMove.SortQuietsPartial.ScanIdx, CalcMovesMoveList[PickMove.SortQuietsPartial.SortedEndIdx]);
            List.ReplaceItem(CalcMovesScoreList, PickMove.SortQuietsPartial.ScanIdx, CalcMovesScoreList[PickMove.SortQuietsPartial.SortedEndIdx]);
            PickMove.SortQuietsPartial.InsertIdx = PickMove.SortQuietsPartial.SortedEndIdx;
            Repeat Until ((PickMove.SortQuietsPartial.InsertIdx == 1) Or (Not ((CalcMovesScoreList[(PickMove.SortQuietsPartial.InsertIdx - 1)] < PickMove.SortQuietsPartial.HeldScore))))
            {
                List.ReplaceItem(CalcMovesMoveList, PickMove.SortQuietsPartial.InsertIdx, CalcMovesMoveList[(PickMove.SortQuietsPartial.InsertIdx - 1)]);
                List.ReplaceItem(CalcMovesScoreList, PickMove.SortQuietsPartial.InsertIdx, CalcMovesScoreList[(PickMove.SortQuietsPartial.InsertIdx - 1)]);
                PickMove.SortQuietsPartial.InsertIdx += -1;
            }
            List.ReplaceItem(CalcMovesMoveList, PickMove.SortQuietsPartial.InsertIdx, PickMove.SortQuietsPartial.HeldMove);
            List.ReplaceItem(CalcMovesScoreList, PickMove.SortQuietsPartial.InsertIdx, PickMove.SortQuietsPartial.HeldScore);
        }
        PickMove.SortQuietsPartial.ScanIdx += 1;
    }
    PickMove.SortQuietsPartial.BaseIdx = ((Ply - 1) * Const.MaxMovesPerGeneration);
    PickMove.SortQuietsPartial.CopyIdx = 1;
    Repeat (PickMove.SortQuietsPartial.MoveCount)
    {
        List.ReplaceItem(Moves, (PickMove.SortQuietsPartial.BaseIdx + PickMove.SortQuietsPartial.CopyIdx), CalcMovesMoveList[PickMove.SortQuietsPartial.CopyIdx]);
        List.ReplaceItem(MovesScore, (PickMove.SortQuietsPartial.BaseIdx + PickMove.SortQuietsPartial.CopyIdx), CalcMovesScoreList[PickMove.SortQuietsPartial.CopyIdx]);
        PickMove.SortQuietsPartial.CopyIdx += 1;
    }
    List.ReplaceItem(MovesCount, Ply, PickMove.SortQuietsPartial.MoveCount);
}

Define PickMove.StashBadCaptures(string Ply) (warp=true)
{
    PickMove.StashBadCaptures.BaseIdx = ((Ply - 1) * Const.MaxMovesPerGeneration);
    PickMove.StashBadCaptures.KeptCount = 0;
    PickMove.StashBadCaptures.StashCount = 0;
    PickMove.StashBadCaptures.ScanIdx = 1;
    Repeat (MovesCount[Ply])
    {
        PickMove.StashBadCaptures.Move = Moves[(PickMove.StashBadCaptures.BaseIdx + PickMove.StashBadCaptures.ScanIdx)];
        If (MovesScore[(PickMove.StashBadCaptures.BaseIdx + PickMove.StashBadCaptures.ScanIdx)] < Const.PickGoodCaptureMinScore)
        {
            PickMove.StashBadCaptures.TargetIdx = (floor(PickMove.StashBadCaptures.Move) % 100);
            If ((Not ((floor((PickMove.StashBadCaptures.Move / 100)) == 0))) And (Not ((Board[PickMove.StashBadCaptures.TargetIdx] == 0))))
            {
                PickMove.StashBadCaptures.StashCount += 1;
                List.ReplaceItem(PickBadCaptureMoves, (PickMove.StashBadCaptures.BaseIdx + PickMove.StashBadCaptures.StashCount), PickMove.StashBadCaptures.Move);
                List.ReplaceItem(PickBadCaptureScores, (PickMove.StashBadCaptures.BaseIdx + PickMove.StashBadCaptures.StashCount), MovesScore[(PickMove.StashBadCaptures.BaseIdx + PickMove.StashBadCaptures.ScanIdx)]);
            }
        }
        Else
        {
            PickMove.StashBadCaptures.KeptCount += 1;
        }
        PickMove.StashBadCaptures.ScanIdx += 1;
    }
    List.ReplaceItem(MovesCount, Ply, PickMove.StashBadCaptures.KeptCount);
    List.ReplaceItem(PickBadCaptureCount, Ply, PickMove.StashBadCaptures.StashCount);
}

Define PickMove.TryKCMove(string Move)(string Ply)(string Score) (warp=true)
{
    If (Move == Const.Null)
    {
        Stop(this script);
    }
    PickMove.TryKCMove.SourceIdx = floor((Move / 100));
    If (PickMove.TryKCMove.SourceIdx == 0)
    {
        Stop(this script);
    }
    If (((Board[PickMove.TryKCMove.SourceIdx] * ((PlyIsOwn[Ply] * 2) - 1)) > 0) And (Board[floor((Move % 100))] == 0))
    {
        PickMove.TryKCMove.IsLegal = MoveToHash[((60000 * PlyIsOwn[Ply]) + ((PieceIdxLookup[abs(Board[PickMove.TryKCMove.SourceIdx])] * 10000) + Move))];
        If (Not ((PickMove.TryKCMove.IsLegal == 0)))
        {
            Call IsMovePicked(Ply)(Move);
            If (Ret.IsMovePicked.Picked == 0)
            {
                List.DeleteAll(CalcMovesMoveList);
                List.DeleteAll(CalcMovesScoreList);
                Call GenerateMovesForSource(Ply)(PickMove.TryKCMove.SourceIdx)((1 == 0))((1 == 0))((1 == 0))((1 == 0));
                If List.ContainsItem(CalcMovesMoveList, Move)
                {
                    Call AddMoveToList(Move)(Ply)(Score);
                }
            }
        }
    }
}

Define PrepareCheckInfo(string Ply) (warp=true)
{
    List.ReplaceItem(PinCount, Ply, 0);
    List.ReplaceItem(DiscoveryCount, Ply, 0);
    PrepareCheckInfo.SideToMoveFactor = (((PlyIsOwn[Ply] == 1) * 2) - 1);
    If (PlyIsOwn[Ply] == 1)
    {
        PrepareCheckInfo.OurKingIdx = Glob.Board.BlackKingIdx;
        PrepareCheckInfo.TheirKingIdx = Glob.Board.WhiteKingIdx;
    }
    Else
    {
        PrepareCheckInfo.OurKingIdx = Glob.Board.WhiteKingIdx;
        PrepareCheckInfo.TheirKingIdx = Glob.Board.BlackKingIdx;
    }
    PrepareCheckInfo.IsPin = 1;
    Repeat (2)
    {
        If (PrepareCheckInfo.IsPin == 1)
        {
            PrepareCheckInfo.KingIdx = PrepareCheckInfo.OurKingIdx;
            PrepareCheckInfo.SliderFactor = -1;
        }
        Else
        {
            PrepareCheckInfo.KingIdx = PrepareCheckInfo.TheirKingIdx;
            PrepareCheckInfo.SliderFactor = 1;
        }
        PrepareCheckInfo.LineBaseIdx = (MoveSourceIdxToListOffsetSliding[PrepareCheckInfo.KingIdx] + 0);
        PrepareCheckInfo.IsStraight = 1;
        Repeat (2)
        {
            If (PrepareCheckInfo.IsStraight == 1)
            {
                PrepareCheckInfo.SliderPiece = GoK_BlackRook;
            }
            Else
            {
                PrepareCheckInfo.SliderPiece = GoK_BlackBishop;
            }
            PrepareCheckInfo.DirIdx = 0;
            Repeat (4)
            {
                PrepareCheckInfo.StepIdx = 1;
                PrepareCheckInfo.BlockerIdx = 0;
                PrepareCheckInfo.IsDone = 0;
                Repeat Until ((PrepareCheckInfo.StepIdx > 8) Or (PrepareCheckInfo.IsDone == 1))
                {
                    If (PrepareCheckInfo.IsStraight == 1)
                    {
                        PrepareCheckInfo.SqIdx = (MoveSlidingStraightListIdxToTargetIdx[((PrepareCheckInfo.LineBaseIdx + (PrepareCheckInfo.DirIdx * 8)) + PrepareCheckInfo.StepIdx)] + 0);
                    }
                    Else
                    {
                        PrepareCheckInfo.SqIdx = (MoveCrossListIdxToTargetIdx[((PrepareCheckInfo.LineBaseIdx + (PrepareCheckInfo.DirIdx * 8)) + PrepareCheckInfo.StepIdx)] + 0);
                    }
                    If (PrepareCheckInfo.SqIdx == -1)
                    {
                        PrepareCheckInfo.IsDone = 1;
                    }
                    Else
                    {
                        PrepareCheckInfo.Piece = (Board[PrepareCheckInfo.SqIdx] + 0);
                        If (Not ((PrepareCheckInfo.Piece == 0)))
                        {
                            If (PrepareCheckInfo.BlockerIdx == 0)
                            {
                                If ((PrepareCheckInfo.Piece * PrepareCheckInfo.SideToMoveFactor) > 0)
                                {
                                    PrepareCheckInfo.BlockerIdx = PrepareCheckInfo.SqIdx;
                                }
                                Else
                                {
                                    PrepareCheckInfo.IsDone = 1;
                                }
                            }
                            Else
                            {
                                If ((((PrepareCheckInfo.Piece * PrepareCheckInfo.SideToMoveFactor) * PrepareCheckInfo.SliderFactor) > 0) And ((abs(PrepareCheckInfo.Piece) == GoK_BlackQueen) Or (abs(PrepareCheckInfo.Piece) == PrepareCheckInfo.SliderPiece)))
                                {
                                    If (PrepareCheckInfo.IsPin == 1)
                                    {
                                        List.ReplaceItem(PinSq, (((Ply - 1) * Const.CheckInfoPlyStride) + (PinCount[Ply] + 1)), PrepareCheckInfo.BlockerIdx);
                                        List.ReplaceItem(PinRay, (((Ply - 1) * Const.CheckInfoPlyStride) + (PinCount[Ply] + 1)), abs(MoveToPathStepInc[((PrepareCheckInfo.KingIdx * 100) + PrepareCheckInfo.BlockerIdx)]));
                                        List.ReplaceItem(PinCount, Ply, (PinCount[Ply] + 1));
                                    }
                                    Else
                                    {
                                        List.ReplaceItem(DiscoverySq, (((Ply - 1) * Const.CheckInfoPlyStride) + (DiscoveryCount[Ply] + 1)), PrepareCheckInfo.BlockerIdx);
                                        List.ReplaceItem(DiscoveryRay, (((Ply - 1) * Const.CheckInfoPlyStride) + (DiscoveryCount[Ply] + 1)), abs(MoveToPathStepInc[((PrepareCheckInfo.KingIdx * 100) + PrepareCheckInfo.BlockerIdx)]));
                                        List.ReplaceItem(DiscoveryCount, Ply, (DiscoveryCount[Ply] + 1));
                                    }
                                }
                                PrepareCheckInfo.IsDone = 1;
                            }
                        }
                    }
                    PrepareCheckInfo.StepIdx += 1;
                }
                PrepareCheckInfo.DirIdx += 1;
            }
            PrepareCheckInfo.IsStraight = 0;
        }
        PrepareCheckInfo.IsPin = 0;
    }
}

Define PrepareEvasionMask(string Ply) (warp=true)
{
    PrepareEvasionMask.BoardAttackedEvasionTargetIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, PrepareEvasionMask.BoardAttackedEvasionTargetIdx, 0);
        PrepareEvasionMask.BoardAttackedEvasionTargetIdx += 1;
    }
    Call IsCheckedFast((Ply + 1));
    If (Ret.IsCheckedFast.IsChecked == 1)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, Ret.IsCheckedFast.CheckedByIdx, 1);
        If (PlyIsOwn[Ply] == 1)
        {
            PrepareEvasionMask.KingIdx = Glob.Board.BlackKingIdx;
        }
        Else
        {
            PrepareEvasionMask.KingIdx = Glob.Board.WhiteKingIdx;
        }
        PrepareEvasionMask.Move = ((Ret.IsCheckedFast.CheckedByIdx * 100) + PrepareEvasionMask.KingIdx);
        PrepareEvasionMask.BoardAttackedEvasionTargetIdx = Ret.IsCheckedFast.CheckedByIdx;
        Repeat ((MoveToPathDelta[PrepareEvasionMask.Move] - 1))
        {
            PrepareEvasionMask.BoardAttackedEvasionTargetIdx += MoveToPathStepInc[PrepareEvasionMask.Move];
            List.ReplaceItem(BoardAttackedEvasionTarget, PrepareEvasionMask.BoardAttackedEvasionTargetIdx, 1);
        }
    }
}

Define PrepareKillers(string Ply) (warp=true)
{
    If (Not ((List.Length(CurrentKillerMoves) == 2)))
    {
        List.DeleteAll(CurrentKillerMoves);
        List.Add(CurrentKillerMoves, Const.Null);
        List.Add(CurrentKillerMoves, Const.Null);
    }
    PrepareKillers.KillerMoveIdx = (((Ply - 1) * 2) + 1);
    List.ReplaceItem(CurrentKillerMoves, 1, KillerMoves[PrepareKillers.KillerMoveIdx]);
    List.ReplaceItem(CurrentKillerMoves, 2, KillerMoves[(PrepareKillers.KillerMoveIdx + 1)]);
}

Define PrepStats (warp=true)
{
    List.DeleteAll(ProfileByHorizon);
    Repeat (1728)
    {
        List.Add(ProfileByHorizon, 0);
    }
    List.DeleteAll(HorizonAtPly);
    Repeat (64)
    {
        List.Add(HorizonAtPly, 0);
    }
    List.DeleteAll(ProfileTimeByHorizon);
    Repeat (576)
    {
        List.Add(ProfileTimeByHorizon, 0);
    }
    List.DeleteAll(ProfileHorizonCols);
    List.Add(ProfileHorizonCols, Const.Profile.RazoringCalls);
    List.Add(ProfileHorizonCols, Const.Profile.RazoringHits);
    List.Add(ProfileHorizonCols, Const.Profile.RazoringTries);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.RFPCalls);
    List.Add(ProfileHorizonCols, Const.Profile.RFPHits);
    List.Add(ProfileHorizonCols, Const.Profile.RFPCalls);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.NMPCalls);
    List.Add(ProfileHorizonCols, Const.Profile.NMPHits);
    List.Add(ProfileHorizonCols, Const.Profile.NMPCalls);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.FutilityCalls);
    List.Add(ProfileHorizonCols, Const.Profile.FutilityHits);
    List.Add(ProfileHorizonCols, Const.Profile.FutilityCalls);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.DeltaCalls);
    List.Add(ProfileHorizonCols, Const.Profile.DeltaHits);
    List.Add(ProfileHorizonCols, Const.Profile.DeltaCalls);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.QSEECalls);
    List.Add(ProfileHorizonCols, Const.Profile.QSEEHits);
    List.Add(ProfileHorizonCols, Const.Profile.QSEECalls);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.LMRCalls);
    List.Add(ProfileHorizonCols, Const.Profile.LMRHits);
    List.Add(ProfileHorizonCols, Const.Profile.LMRCalls);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.PVSCalls);
    List.Add(ProfileHorizonCols, Const.Profile.PVSReSearches);
    List.Add(ProfileHorizonCols, Const.Profile.PVSCalls);
    List.Add(ProfileHorizonCols, 1);
    List.Add(ProfileHorizonCols, Const.Profile.TTNodeProbe);
    List.Add(ProfileHorizonCols, Const.Profile.TTNodeHit);
    List.Add(ProfileHorizonCols, Const.Profile.TTNodeProbe);
    List.Add(ProfileHorizonCols, 0);
    List.Add(ProfileHorizonCols, Const.Profile.TTMoveProbe);
    List.Add(ProfileHorizonCols, Const.Profile.TTMoveHit);
    List.Add(ProfileHorizonCols, Const.Profile.TTMoveProbe);
    List.Add(ProfileHorizonCols, 0);
}

Define PrintStats (warp=true)
{
    Call Log("============================================================")("")("")("")("")("")("")("");
    Glob.Profile.ReportLine = "";
    Call PS.Cell("Function")(20)((1 == 0));
    Call PS.Cell("Invoked")(14)((1 == 1));
    Call PS.Cell("Hits/Pruned")(16)((1 == 1));
    Call PS.Cell("Ratio")(10)((1 == 1));
    Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call PS.SummaryRow("TT-static-eval")(Const.Profile.TTStaticProbe)(Const.Profile.TTStaticHit)((1 == 0));
    Call PS.SummaryRow("TT-node-eval")(Const.Profile.TTNodeProbe)(Const.Profile.TTNodeHit)((1 == 0));
    Call PS.SummaryRow("TT-hashmove")(Const.Profile.TTMoveProbe)(Const.Profile.TTMoveHit)((1 == 0));
    Call PS.SummaryRow("Razoring")(Const.Profile.RazoringTries)(Const.Profile.RazoringHits)((1 == 0));
    Call PS.SummaryRow("NMP")(Const.Profile.NMPTries)(Const.Profile.NMPHits)((1 == 0));
    Call PS.SummaryRow("RFP")(Const.Profile.RFPCalls)(Const.Profile.RFPHits)((1 == 0));
    Call PS.SummaryRow("Futility")(Const.Profile.FutilityCalls)(Const.Profile.FutilityHits)((1 == 0));
    Call PS.SummaryRow("Delta")(Const.Profile.DeltaCalls)(Const.Profile.DeltaHits)((1 == 0));
    Call PS.SummaryRow("QS-SEE")(Const.Profile.QSEECalls)(Const.Profile.QSEEHits)((1 == 0));
    Call PS.SummaryRow("LMR")(Const.Profile.LMRCalls)(Const.Profile.LMRHits)((1 == 0));
    Call PS.SummaryRow("Non-PV search")(Const.Profile.PVSCalls)(Const.Profile.PVSReSearches)((1 == 1));
    Call PS.CountRow("Full Search")(Const.Profile.FullCalls);
    Call PS.CountRow("Extensions")(Const.Profile.Ext);
    Call Log("============================================================")("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon invocations and runtime, s (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 1));
    PrintStats.Horizon = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PrintStats.Horizon)((1 == 0));
        PrintStats.Horizon += 1;
    }
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon hit ratio (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 0));
    PrintStats.Horizon = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PrintStats.Horizon)((1 == 1));
        PrintStats.Horizon += 1;
    }
}

Define ProbePawnHist(string Piece)(string To)(string KPHash) (warp=true)
{
    ProbePawnHist.PawnHistKey = KPHash;
    Call GetPiecePosHash(Board[Glob.Board.WhiteKingIdx])(Glob.Board.WhiteKingIdx);
    ProbePawnHist.PawnHistKey += (-1 * Ret.GetPiecePosHash.Hash);
    Call GetPiecePosHash(Board[Glob.Board.BlackKingIdx])(Glob.Board.BlackKingIdx);
    ProbePawnHist.PawnHistKey += (-1 * Ret.GetPiecePosHash.Hash);
    ProbePawnHist.PawnHistPieceIdx = PieceIdxLookup[abs(GoK_WhiteKing)];
    If (abs(Piece) > 0)
    {
        ProbePawnHist.PawnHistPieceIdx = PieceIdxLookup[abs(Piece)];
    }
    Ret.ProbePawnHist.Idx = ((196608 * (Piece < 0)) + (((ProbePawnHist.PawnHistKey % 512) * 384) + (((ProbePawnHist.PawnHistPieceIdx - 1) * 64) + To)));
}

Define ProfilerMethodEnter(string Id) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Repeat Until (Not ((List.Length(ProfilingData) < Id)))
        {
            List.Add(ProfilingData, 0);
        }
        List.ReplaceItem(ProfilingData, Id, (ProfilingData[Id] - ((Sensing.DaysSince2000() * 24) * 3600)));
        ProfilerMethodEnter.CategoryIdx = floor(((Id - 1) / 60));
        ProfilerMethodEnter.Ply = (Id - (ProfilerMethodEnter.CategoryIdx * 60));
        Call Profile_TimeByHorizon((ProfilerMethodEnter.CategoryIdx * 64))(ProfilerMethodEnter.Ply)(-1);
    }
}

Define ProfilerMethodExit(string Id) (warp=false)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        List.ReplaceItem(ProfilingData, Id, (ProfilingData[Id] + ((Sensing.DaysSince2000() * 24) * 3600)));
        ProfilerMethodExit.CategoryIdx = floor(((Id - 1) / 60));
        ProfilerMethodExit.Ply = (Id - (ProfilerMethodExit.CategoryIdx * 60));
        Call Profile_TimeByHorizon((ProfilerMethodExit.CategoryIdx * 64))(ProfilerMethodExit.Ply)(1);
    }
}

Define ProfilerReset (warp=true)
{
    List.DeleteItem(ProfilingData, all);
}

Define Profile_CountByHorizon(string BaseIdx)(string Horizon)(string Ply) (warp=true)
{
    Profile_CountByHorizon.Slot = (Horizon + 1);
    If (Quiescence[Ply] == 1)
    {
        Profile_CountByHorizon.Slot = 64;
    }
    List.ReplaceItem(ProfileByHorizon, (BaseIdx + Profile_CountByHorizon.Slot), (ProfileByHorizon[(BaseIdx + Profile_CountByHorizon.Slot)] + 1));
}

Define Profile_TimeByHorizon(string BaseIdx)(string Ply)(string TimeSign) (warp=true)
{
    Profile_TimeByHorizon.Slot = (HorizonAtPly[Ply] + 1);
    If (Quiescence[Ply] == 1)
    {
        Profile_TimeByHorizon.Slot = 64;
    }
    List.ReplaceItem(ProfileTimeByHorizon, (BaseIdx + Profile_TimeByHorizon.Slot), (ProfileTimeByHorizon[(BaseIdx + Profile_TimeByHorizon.Slot)] + (TimeSign * ((Sensing.DaysSince2000() * 24) * 3600))));
}

Define PS.Cell(string Value)(string Width)(bool RightJustify) (warp=true)
{
    Call PadInto(Value)(Width)(RightJustify);
    Glob.Profile.ReportLine = Operator.Join(Glob.Profile.ReportLine, Ret.PadInto.Padded);
}

Define PS.CountRow(string Label)(string Slot) (warp=true)
{
    Call PS.Sum(Slot);
    Glob.Profile.ReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(Ret.PS.Sum.Total)(14)((1 == 1));
    Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonHeader(bool WithTimes) (warp=true)
{
    Glob.Profile.ReportLine = "";
    Call PS.Cell("Horizon")(9)((1 == 0));
    Call PS.Cell("Razor")(9)((1 == 1));
    Call PS.Cell("RFP")(9)((1 == 1));
    Call PS.Cell("NMP")(9)((1 == 1));
    Call PS.Cell("Futil")(9)((1 == 1));
    Call PS.Cell("Delta")(9)((1 == 1));
    Call PS.Cell("QSEE")(9)((1 == 1));
    Call PS.Cell("LMR")(9)((1 == 1));
    Call PS.Cell("PVS")(9)((1 == 1));
    Call PS.Cell("TTnode")(9)((1 == 1));
    Call PS.Cell("TThash")(9)((1 == 1));
    If WithTimes
    {
        Call PS.Cell("EvalS")(9)((1 == 1));
        Call PS.Cell("MgenS")(9)((1 == 1));
        Call PS.Cell("PickS")(9)((1 == 1));
    }
    Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonRow(string Horizon)(bool Ratios) (warp=true)
{
    If ((((((((((ProfileByHorizon[(Const.Profile.RazoringCalls + Horizon)] + ProfileByHorizon[(Const.Profile.RFPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.NMPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.FutilityCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.DeltaCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.QSEECalls + Horizon)]) + ProfileByHorizon[(Const.Profile.LMRCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.PVSCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.TTNodeProbe + Horizon)]) + ProfileByHorizon[(Const.Profile.TTMoveProbe + Horizon)]) > 0)
    {
        If (Horizon == 64)
        {
            PS.HorizonRow.Label = "Q";
        }
        Else
        {
            PS.HorizonRow.Label = (Horizon - 1);
        }
        Glob.Profile.ReportLine = "";
        Call PS.Cell(PS.HorizonRow.Label)(9)((1 == 0));
        PS.HorizonRow.Idx = 1;
        If Ratios
        {
            Repeat (10)
            {
                Call PS.RatioCell(ProfileHorizonCols[(PS.HorizonRow.Idx + 1)])(ProfileHorizonCols[(PS.HorizonRow.Idx + 2)])(Horizon)((ProfileHorizonCols[(PS.HorizonRow.Idx + 3)] == 1));
                PS.HorizonRow.Idx += 4;
            }
        }
        Else
        {
            Repeat (10)
            {
                Call PS.Cell(ProfileByHorizon[(ProfileHorizonCols[PS.HorizonRow.Idx] + Horizon)])(9)((1 == 1));
                PS.HorizonRow.Idx += 4;
            }
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.EvaluateBaseIdx + Horizon)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * (ProfileTimeByHorizon[(Const.ProfileTime.MoveGenImplBaseIdx + Horizon)] + ProfileTimeByHorizon[(Const.ProfileTime.MoveGenBaseIdx + Horizon)]))) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.PickMoveBaseIdx + Horizon)])) / 100))(9)((1 == 1));
        }
        Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
    }
}

Define PS.RatioCell(string HitSlot)(string InvSlot)(string Horizon)(bool HitSlotCountsMisses) (warp=true)
{
    PS.RatioCell.CallCount = ProfileByHorizon[(InvSlot + Horizon)];
    PS.RatioCell.HitCount = ProfileByHorizon[(HitSlot + Horizon)];
    If HitSlotCountsMisses
    {
        PS.RatioCell.HitCount = (PS.RatioCell.CallCount - PS.RatioCell.HitCount);
    }
    Call PS.Cell(Operator.Join((floor(((1000 * PS.RatioCell.HitCount) / (PS.RatioCell.CallCount + (PS.RatioCell.CallCount == 0)))) / 10), "%"))(9)((1 == 1));
}

Define PS.Sum(string Slot) (warp=true)
{
    PS.Sum.Idx = 1;
    Ret.PS.Sum.Total = 0;
    Repeat (64)
    {
        Ret.PS.Sum.Total += ProfileByHorizon[(Slot + PS.Sum.Idx)];
        PS.Sum.Idx += 1;
    }
}

Define PS.SummaryRow(string Label)(string InvSlot)(string HitSlot)(bool HitSlotCountsMisses) (warp=true)
{
    Call PS.Sum(InvSlot);
    PS.SummaryRow.CallCount = Ret.PS.Sum.Total;
    Call PS.Sum(HitSlot);
    PS.SummaryRow.HitCount = Ret.PS.Sum.Total;
    If HitSlotCountsMisses
    {
        PS.SummaryRow.HitCount = (PS.SummaryRow.CallCount - PS.SummaryRow.HitCount);
    }
    Glob.Profile.ReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(PS.SummaryRow.CallCount)(14)((1 == 1));
    Call PS.Cell(PS.SummaryRow.HitCount)(16)((1 == 1));
    Call PS.Cell(Operator.Join(floor(((100 * PS.SummaryRow.HitCount) / (PS.SummaryRow.CallCount + (PS.SummaryRow.CallCount == 0)))), "%"))(10)((1 == 1));
    Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
}

Define PublishTimers(string EngineElapsed) (warp=true)
{
    If (Glob.Config.IsDCI == 1)
    {
        Stop(this script);
    }
    If (((Glob.Clock.TimeControl == 1) And ((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0))) And (Glob.Config.CustomMaxDepth == 0))
    {
        Timers_EngineTime = (Glob.Clock.CurrentTime - EngineElapsed);
        If (Glob.Clock.PlayerRunning == 1)
        {
            Timers_PlayerTime = (Glob.Clock.PlayerTime - ((Sensing.DaysSince2000() * 86400) - Glob.Clock.PlayerMoveStart));
        }
        Else
        {
            Timers_PlayerTime = Glob.Clock.PlayerTime;
        }
    }
    Else
    {
        Timers_EngineTime = "";
        Timers_PlayerTime = "";
    }
    Event.Broadcast("Timers_Changed");
}

Define QuickSort (warp=true)
{
    List.DeleteAll(QSPartStack);
    Call QuickSortImpl(1)(List.Length(CalcMovesScoreList));
}

Define QuickSortImpl(string Lo)(string Hi) (warp=true)
{
    QuickSortImpl.PivotScore = CalcMovesScoreList[floor(((Lo + Hi) / 2))];
    QuickSortImpl.LowerIdx = Lo;
    QuickSortImpl.UpperIdx = Hi;
    Repeat Until (QuickSortImpl.LowerIdx > QuickSortImpl.UpperIdx)
    {
        Repeat Until (Not ((CalcMovesScoreList[QuickSortImpl.LowerIdx] > QuickSortImpl.PivotScore)))
        {
            QuickSortImpl.LowerIdx += 1;
        }
        Repeat Until (Not ((CalcMovesScoreList[QuickSortImpl.UpperIdx] < QuickSortImpl.PivotScore)))
        {
            QuickSortImpl.UpperIdx += -1;
        }
        If (Not ((QuickSortImpl.LowerIdx > QuickSortImpl.UpperIdx)))
        {
            QuickSortImpl.SwapScore = CalcMovesScoreList[QuickSortImpl.LowerIdx];
            List.ReplaceItem(CalcMovesScoreList, QuickSortImpl.LowerIdx, CalcMovesScoreList[QuickSortImpl.UpperIdx]);
            List.ReplaceItem(CalcMovesScoreList, QuickSortImpl.UpperIdx, QuickSortImpl.SwapScore);
            QuickSortImpl.SwapScore = CalcMovesMoveList[QuickSortImpl.LowerIdx];
            List.ReplaceItem(CalcMovesMoveList, QuickSortImpl.LowerIdx, CalcMovesMoveList[QuickSortImpl.UpperIdx]);
            List.ReplaceItem(CalcMovesMoveList, QuickSortImpl.UpperIdx, QuickSortImpl.SwapScore);
            QuickSortImpl.LowerIdx += 1;
            QuickSortImpl.UpperIdx += -1;
        }
    }
    If (Lo < QuickSortImpl.UpperIdx)
    {
        List.Add(QSPartStack, QuickSortImpl.LowerIdx);
        Call QuickSortImpl(Lo)(QuickSortImpl.UpperIdx);
        QuickSortImpl.LowerIdx = QSPartStack[List.Length(QSPartStack)];
        List.DeleteItem(QSPartStack, List.Length(QSPartStack));
    }
    If (QuickSortImpl.LowerIdx < Hi)
    {
        Call QuickSortImpl(QuickSortImpl.LowerIdx)(Hi);
    }
}

Define ResetSearchInfo (warp=true)
{
    Glob.Info.Nodes = 0;
    Glob.Info.NodesQ = 0;
    Glob.Info.Moves = 0;
    Glob.Info.MovesQ = 0;
    Glob.Info.Adopted = 0;
    Glob.Info.LastDepth = Const.Null;
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call PrepStats;
        Glob.Stats.BestMoveCount = 0;
        Glob.Stats.BestMoveIdxSum = 0;
        Glob.Stats.BestMoveCountQuiescence = 0;
        Glob.Stats.BestMoveIdxSumQuiescence = 0;
        Glob.Stats.BadOrderCount = 0;
    }
}

Define ResizeTT (warp=true)
{
    Call //("Doubles the TT and keeps all entries: needs a power-of-two cluster count; cluster c goes to c (key bit = 0) or c + clusters (bit = 1), compacted in order (TTFindSlot stops at the first empty entry)");
    ResizeTT.OldLen = List.Length(TTNodeEntry);
    ResizeTT.OldClusters = (ResizeTT.OldLen / (Const.TTNodeEntrySize * 4));
    Repeat (ResizeTT.OldLen)
    {
        List.Add(TTNodeEntry, Const.Null);
    }
    ResizeTT.C = 1;
    Repeat (ResizeTT.OldClusters)
    {
        ResizeTT.Lo = ResizeTT.C;
        ResizeTT.Hi = (ResizeTT.C + ResizeTT.OldLen);
        ResizeTT.Idx = ResizeTT.C;
        Repeat (4)
        {
            ResizeTT.Hash = TTNodeEntry[(ResizeTT.Idx + Const.TTNodeCol.HashIdx)];
            If (Not ((ResizeTT.Hash == Const.Null)))
            {
                If ((floor((ResizeTT.Hash / ResizeTT.OldClusters)) % 2) == 1)
                {
                    ResizeTT.Dst = ResizeTT.Hi;
                    ResizeTT.Hi += Const.TTNodeEntrySize;
                }
                Else
                {
                    ResizeTT.Dst = ResizeTT.Lo;
                    ResizeTT.Lo += Const.TTNodeEntrySize;
                }
                If (Not ((ResizeTT.Dst == ResizeTT.Idx)))
                {
                    ResizeTT.K = 0;
                    Repeat (Const.TTNodeEntrySize)
                    {
                        List.ReplaceItem(TTNodeEntry, (ResizeTT.Dst + ResizeTT.K), TTNodeEntry[(ResizeTT.Idx + ResizeTT.K)]);
                        List.ReplaceItem(TTNodeEntry, (ResizeTT.Idx + ResizeTT.K), Const.Null);
                        ResizeTT.K += 1;
                    }
                }
            }
            ResizeTT.Idx += Const.TTNodeEntrySize;
        }
        ResizeTT.C += (Const.TTNodeEntrySize * 4);
    }
    Call TTResetSlots;
    Call Log("info string tt resize ")((ResizeTT.OldLen / Const.TTNodeEntrySize))(" -> ")((List.Length(TTNodeEntry) / Const.TTNodeEntrySize))(" entries, last hashfull ")(Ret.GetHashfull.Permill)(Operator.Join(", time ", Operator.Round((1000 * ((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart)))))(Operator.Join(", nodes ", ((Glob.Info.Nodes + Glob.Info.NodesQ) + (Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence))));
}

Define RevertMove(num Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, 1, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
    }
    RevertMove.Move = AppliedMove[Ply];
    If (RevertMove.Move == Const.Null)
    {
        RevertMove.SourceIdx = 0;
    }
    Else
    {
        RevertMove.SourceIdx = floor((RevertMove.Move / 100));
    }
    If (RevertMove.SourceIdx > 0)
    {
        RevertMove.TargetIdx = floor((RevertMove.Move % 100));
        List.ReplaceItem(Board, RevertMove.SourceIdx, Board[RevertMove.TargetIdx]);
        List.ReplaceItem(Board, RevertMove.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (PromotionPieces[Ply] > 0)
        {
            RevertMove.PromotionCode = (Operator.LetterOf(RevertMove.Move, Variable.Length(RevertMove.Move)) + 0);
            If (RevertMove.PromotionCode == 1)
            {
                Glob.Board.BlackQueenCount += -1;
            }
            If (RevertMove.PromotionCode == 2)
            {
                Glob.Board.BlackRookCount += -1;
                Glob.Board.BlackNonQueenMajorMinorCount += -1;
            }
            If (RevertMove.PromotionCode == 3)
            {
                Glob.Board.BlackNonQueenMajorMinorCount += -1;
            }
            If (RevertMove.PromotionCode == 4)
            {
                Glob.Board.BlackNonQueenMajorMinorCount += -1;
            }
            List.ReplaceItem(Board, RevertMove.SourceIdx, GoK_BlackPawn);
            Glob.Board.BlackPawnCount += 1;
        }
        Else
        {
            If (PromotionPieces[Ply] < 0)
            {
                RevertMove.PromotionCode = (Operator.LetterOf(RevertMove.Move, Variable.Length(RevertMove.Move)) + 0);
                If (RevertMove.PromotionCode == 1)
                {
                    Glob.Board.WhiteQueenCount += -1;
                }
                If (RevertMove.PromotionCode == 2)
                {
                    Glob.Board.WhiteRookCount += -1;
                    Glob.Board.WhiteNonQueenMajorMinorCount += -1;
                }
                If (RevertMove.PromotionCode == 3)
                {
                    Glob.Board.WhiteNonQueenMajorMinorCount += -1;
                }
                If (RevertMove.PromotionCode == 4)
                {
                    Glob.Board.WhiteNonQueenMajorMinorCount += -1;
                }
                List.ReplaceItem(Board, RevertMove.SourceIdx, GoK_WhitePawn);
                Glob.Board.WhitePawnCount += 1;
            }
        }
        If (Board[RevertMove.SourceIdx] == GoK_BlackKing)
        {
            Glob.Board.BlackKingIdx = RevertMove.SourceIdx;
        }
        If (Board[RevertMove.SourceIdx] == GoK_WhiteKing)
        {
            Glob.Board.WhiteKingIdx = RevertMove.SourceIdx;
        }
        RevertMove.TargetPiece = TargetPieces[Ply];
        If (RevertMove.TargetPiece > 0)
        {
            If (RevertMove.TargetPiece == GoK_BlackPawn)
            {
                Glob.Board.BlackPawnCount += 1;
            }
            Else
            {
                If (RevertMove.TargetPiece < GoK_BlackQueen)
                {
                    Glob.Board.BlackNonQueenMajorMinorCount += 1;
                    If (RevertMove.TargetPiece == GoK_BlackRook)
                    {
                        Glob.Board.BlackRookCount += 1;
                    }
                }
                Else
                {
                    If (RevertMove.TargetPiece == GoK_BlackQueen)
                    {
                        Glob.Board.BlackQueenCount += 1;
                    }
                }
            }
        }
        If (RevertMove.TargetPiece < 0)
        {
            If (RevertMove.TargetPiece == GoK_WhitePawn)
            {
                Glob.Board.WhitePawnCount += 1;
            }
            Else
            {
                If (RevertMove.TargetPiece > GoK_WhiteQueen)
                {
                    Glob.Board.WhiteNonQueenMajorMinorCount += 1;
                    If (RevertMove.TargetPiece == GoK_WhiteRook)
                    {
                        Glob.Board.WhiteRookCount += 1;
                    }
                }
                Else
                {
                    If (RevertMove.TargetPiece == GoK_WhiteQueen)
                    {
                        Glob.Board.WhiteQueenCount += 1;
                    }
                }
            }
        }
    }
    Else
    {
        If ((Not ((RevertMove.Move == Const.Null))) And (RevertMove.Move == GoK_WhiteKingsideCastling))
        {
            List.ReplaceItem(Board, 61, GoK_WhiteKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_WhiteRook);
            Glob.Board.WhiteKingIdx = 61;
        }
        Else
        {
            If ((Not ((RevertMove.Move == Const.Null))) And (RevertMove.Move == GoK_WhiteQueensideCastling))
            {
                List.ReplaceItem(Board, 57, GoK_WhiteRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_WhiteKing);
                Glob.Board.WhiteKingIdx = 61;
            }
            Else
            {
                If ((Not ((RevertMove.Move == Const.Null))) And (RevertMove.Move == GoK_BlackKingsideCastling))
                {
                    List.ReplaceItem(Board, 5, GoK_BlackKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_BlackRook);
                    Glob.Board.BlackKingIdx = 5;
                }
                Else
                {
                    If ((Not ((RevertMove.Move == Const.Null))) And (RevertMove.Move == GoK_BlackQueensideCastling))
                    {
                        List.ReplaceItem(Board, 1, GoK_BlackRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_BlackKing);
                        Glob.Board.BlackKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.Board.CurrentHash = (PreviousBoardHash[Ply] + 0);
    Glob.Board.KPHash = (PreviousBoardHashKP[Ply] + 0);
    Glob.Board.NonPawnHashBlack = PreviousNonPawnHashBlack[Ply];
    Glob.Board.NonPawnHashWhite = PreviousNonPawnHashWhite[Ply];
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, Ply, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
    If (Ply == 1)
    {
        Call SetInitialEP(1);
    }
}

Define RevertMoveLight(string Ply) (warp=true)
{
    RevertMoveLight.Move = AppliedMove[Ply];
    RevertMoveLight.SourceIdx = floor((RevertMoveLight.Move / 100));
    If (RevertMoveLight.SourceIdx > 0)
    {
        RevertMoveLight.TargetIdx = floor((RevertMoveLight.Move % 100));
        List.ReplaceItem(Board, RevertMoveLight.SourceIdx, Board[RevertMoveLight.TargetIdx]);
        List.ReplaceItem(Board, RevertMoveLight.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (Board[RevertMoveLight.SourceIdx] == GoK_BlackKing)
        {
            Glob.Board.BlackKingIdx = RevertMoveLight.SourceIdx;
        }
        If (Board[RevertMoveLight.SourceIdx] == GoK_WhiteKing)
        {
            Glob.Board.WhiteKingIdx = RevertMoveLight.SourceIdx;
        }
    }
    Else
    {
        If (RevertMoveLight.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(Board, 61, GoK_WhiteKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_WhiteRook);
            Glob.Board.WhiteKingIdx = 61;
        }
        Else
        {
            If (RevertMoveLight.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(Board, 57, GoK_WhiteRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_WhiteKing);
                Glob.Board.WhiteKingIdx = 61;
            }
            Else
            {
                If (RevertMoveLight.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(Board, 5, GoK_BlackKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_BlackRook);
                    Glob.Board.BlackKingIdx = 5;
                }
                Else
                {
                    If (RevertMoveLight.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(Board, 1, GoK_BlackRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_BlackKing);
                        Glob.Board.BlackKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.Board.CurrentHash = (PreviousBoardHash[Ply] + 0);
}

Define SayAsync(string Text)(num Duration) (warp=false)
{
    Glob.UI.SayAsyncText = Text;
    Glob.UI.SayAsyncDuration = Duration;
    Event.Broadcast("sayasyncmsg");
}

Define Search(string Alpha)(string Beta)(string Horizon)(string Ply)(bool InitialDeepening) (warp=true)
{
    Glob.Search.IsInitialDeepening = (InitialDeepening + 0);
    Glob.Search.Alpha = Alpha;
    Glob.Search.Beta = Beta;
    Call InitSearch(Horizon);
    Call Evaluate(0)((1 == 1));
    Glob.Stats.MoveCount = 0;
    Glob.Stats.MoveCountQuiescence = 0;
    Glob.Stats.NodeCount = 0;
    Glob.Stats.NodeCountQuiescence = 0;
    Search.Timer = (Sensing.DaysSince2000() * 86400);
    Call SearchImpl(Alpha)(Beta)(Horizon)(Ply)((1 == 0))((1 == 0))(Const.Null);
    Ret.Search.Eval = Ret.SearchImpl.Eval;
    Ret.Search.Move = Ret.SearchImpl.Move;
    Ret.Search.LegalMoveCount = PickedLegalMovesCount[Ply];
    Search.Timer = ((Sensing.DaysSince2000() * 86400) - Search.Timer);
    Call ExportBoardFEN(1);
    Ret.Search.MPS = Operator.Round(((Glob.Stats.MoveCount + Glob.Stats.MoveCountQuiescence) / Search.Timer));
    If (Ret.Search.MPS == Const.Null)
    {
        Glob.UI.MPS = "kMPS: 0";
    }
    Else
    {
        Glob.UI.MPS = Operator.Join("kMPS: ", Operator.Round((Ret.Search.MPS / 1000)));
    }
    Ret.Search.NPS = Operator.Round(((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) / Search.Timer));
    If (Ret.Search.NPS == Const.Null)
    {
        Glob.UI.NPS = "kNPS: 0";
    }
    Else
    {
        Glob.UI.NPS = Operator.Join("kNPS: ", Operator.Round((Ret.Search.NPS / 1000)));
    }
    Glob.Info.Nodes += Glob.Stats.NodeCount;
    Glob.Info.NodesQ += Glob.Stats.NodeCountQuiescence;
    Glob.Info.Moves += Glob.Stats.MoveCount;
    Glob.Info.MovesQ += Glob.Stats.MoveCountQuiescence;
    If (Not ((Ret.Search.Move == Const.Null)))
    {
        If (((List.Length(RootExcludedMoves) == 0) And (Not ((Ret.Search.Eval == Const.Null)))) And (Ret.Search.Eval > Alpha))
        {
            List.DeleteAll(PVStablePrev);
            Search.PVStableIdx = 1;
            Repeat (List.Length(PVStable))
            {
                List.Add(PVStablePrev, PVStable[Search.PVStableIdx]);
                Search.PVStableIdx += 1;
            }
        }
        Call IsQuietMove(Ret.Search.Move);
        If (Ret.IsQuietMove.IsQuiet == 1)
        {
            If (Not ((Ret.Search.Eval < Beta)))
            {
                Call StoreKillerMove(1)(Ret.Search.Move)(Horizon)((1 == 0))((1 == 0))((1 == 1));
            }
        }
    }
}

Define SearchImpl(string Alpha)(string Beta)(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    List.ReplaceItem(Alphas, Ply, Alpha);
    List.ReplaceItem(Betas, Ply, Beta);
    If (Ply == 1)
    {
        Ret.SearchImpl.Eval = Const.Null;
        Ret.SearchImpl.Move = Const.Null;
    }
    List.ReplaceItem(HorizonAtPly, Ply, Horizon);
    Call //("Search function (minimax / alpha-beta pruning)");
    List.ReplaceItem(SearchEval, Ply, Const.Null);
    If (Glob.Search.IsTimeout == 1)
    {
        Stop(this script);
    }
    Call //("Required for TT access and draw detection");
    Call Search_InitStack(Ply)(Quiescence);
    Call Search_DetectCheckmate(Ply);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    Call Search_DetectDrawByRepetition(Ply)(Quiescence);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    If ((Not (Quiescence)) And (Ply > 1))
    {
        SearchImpl.GamePly = List.Length(BoardHistoryFiftyMoves);
        If (Not (((-100000 + SearchImpl.GamePly) < Betas[Ply])))
        {
            List.ReplaceItem(SearchEval, Ply, (-100000 + SearchImpl.GamePly));
            Stop(this script);
        }
        If (Not (((100000 - (SearchImpl.GamePly + 1)) > Alphas[Ply])))
        {
            List.ReplaceItem(SearchEval, Ply, Alphas[Ply]);
            Stop(this script);
        }
    }
    Call Search_DetectDraw(Horizon)(Ply);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    Call TTProbeNodeAtPly(Ply);
    If (Not ((ExcludedMove == Const.Null)))
    {
        List.ReplaceItem(NodeTTHit, Ply, 0);
        List.ReplaceItem(NodeTTScore, Ply, Const.Null);
        List.ReplaceItem(NodeTTMove, Ply, Const.Null);
    }
    Call Search_TTProbeEval(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    If (Ply > (Const.MaxPlyStackFrames - 10))
    {
        Call //("Search tree leaf reached => evaluate board and return result");
        Call //("This will seldomly be invoked, as the usual search termination is quiescence search having reached a quite position");
        Call Evaluate((Ply - 1))((1 == 1));
        Call AdjustEvalScore(Ply)(Ret.Evaluate.Score);
        List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
        Stop(this script);
    }
    If (CheckedState[Ply] == 0)
    {
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_CountByHorizon(Const.Profile.TTStaticProbe)(HorizonAtPly[Ply])(Ply);
        }
        If (Not ((NodeTTStaticEval[Ply] == Const.Null)))
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.TTStaticHit)(HorizonAtPly[Ply])(Ply);
            }
            Call AdjustEvalScore(Ply)(NodeTTStaticEval[Ply]);
        }
    }
    If (Not (Quiescence))
    {
        If (CheckedState[Ply] == 0)
        {
            Call GetStaticEval(Ply);
            If ((Ply > 1) And ((RazorState[Ply] == 0) And (IIDState[Ply] == 0)))
            {
                If ((AppliedMove[(Ply - 1)] > 100) And ((TargetPieces[(Ply - 1)] == 0) And (CheckedState[(Ply - 1)] == 0)))
                {
                    If ((Not ((StaticEval[(Ply - 1)] == Const.Null))) And (Not ((StaticEval[Ply] == Const.Null))))
                    {
                        SearchImpl.Bonus = (-32 * (StaticEval[(Ply - 1)] + StaticEval[Ply]));
                        If (SearchImpl.Bonus > 2000)
                        {
                            SearchImpl.Bonus = 2000;
                        }
                        If (SearchImpl.Bonus < -2000)
                        {
                            SearchImpl.Bonus = -2000;
                        }
                        SearchImpl.Idx = (PlyHistoryBaseIdx[(Ply - 1)] + ((floor((AppliedMove[(Ply - 1)] / 100)) * 64) + floor((AppliedMove[(Ply - 1)] % 100))));
                        List.ReplaceItem(HistoryMoveScores, SearchImpl.Idx, (HistoryMoveScores[SearchImpl.Idx] + (SearchImpl.Bonus - floor((HistoryMoveScores[SearchImpl.Idx] * (abs(SearchImpl.Bonus) / 7183))))));
                    }
                }
            }
        }
        If (Not ((SingularState[Ply] == 1)))
        {
            If ((Ply > 1) And ((CheckedState[Ply] == 0) And (IsPvNode[Ply] == 0)))
            {
                Call GetStaticEval(Ply);
                Call Search_Razoring(Horizon)(Ply)(Quiescence)(ExcludedMove);
                If (Not ((SearchEval[Ply] == Const.Null)))
                {
                    Stop(this script);
                }
                If (RazorState[Ply] == 1)
                {
                    List.ReplaceItem(RazorState, Ply, 2);
                    Call SearchImpl(Alphas[Ply])(Betas[Ply])(Horizon)(Ply)(Cutnode)((1 == 0))(ExcludedMove);
                    List.ReplaceItem(RazorState, Ply, 0);
                    Stop(this script);
                }
                If (Not ((RazorState[Ply] == 2)))
                {
                    Call Search_ReverseFutilityPruning(Horizon)(Ply);
                }
                If (Not ((SearchEval[Ply] == Const.Null)))
                {
                    Stop(this script);
                }
                If ((Not ((RazorState[Ply] == 2))) And (ExcludedMove == Const.Null))
                {
                    Call Search_NullMovePruning(Horizon)(Ply)(Cutnode)(Quiescence);
                }
                If (Not ((SearchEval[Ply] == Const.Null)))
                {
                    Stop(this script);
                }
                If ((Horizon > 4) And (abs(Betas[Ply]) < Const.AbsMinCheckmateEval))
                {
                    Call GetImproving(Ply);
                    List.ReplaceItem(ProbCutBeta, Ply, (Betas[Ply] + (90 - (23 * (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))))));
                    SearchImpl.IsProbCutExcludedByTT = 0;
                    If (NodeTTHit[Ply] == 1)
                    {
                        SearchImpl.TTScore = NodeTTScore[Ply];
                        SearchImpl.TTHorizon = NodeTTHorizon[Ply];
                        If ((Not ((SearchImpl.TTScore == Const.Null))) And (Not ((SearchImpl.TTHorizon == Const.Null))))
                        {
                            If ((Not ((SearchImpl.TTHorizon < (Horizon - 3)))) And (SearchImpl.TTScore < ProbCutBeta[Ply]))
                            {
                                SearchImpl.IsProbCutExcludedByTT = 1;
                            }
                        }
                    }
                    If (SearchImpl.IsProbCutExcludedByTT == 0)
                    {
                        Call PrepareCheckInfo(Ply);
                        List.ReplaceItem(PickPhase, Ply, Const.PickPhase1HashMove);
                        List.ReplaceItem(PickMoveRes, Ply, 1);
                        List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
                        Repeat Until (PickMoveRes[Ply] == 0)
                        {
                            Call PickMove(Ply)((1 == 1))((1 == 0));
                            If (PickMoveRes[Ply] == 1)
                            {
                                Call NNUE_OnApplyMove(Ply);
                                Call GivesCheckFast(Ply);
                                List.ReplaceItem(PutsInCheck, Ply, Ret.GivesCheckFast.GivesCheck);
                                Call SEE(Ply)((1 == 0));
                                If ((Not ((Ret.SEE.Gain < (ProbCutBeta[Ply] - StaticEval[Ply])))) And (Not ((AppliedMove[Ply] == ExcludedMove))))
                                {
                                    Call SearchImpl((0 - ProbCutBeta[Ply]))((0 - (ProbCutBeta[Ply] - 1)))(0)((Ply + 1))((1 == 1))((1 == 1))(Const.Null);
                                    SearchImpl.ProbCutScore = SearchEval[(Ply + 1)];
                                    If (Not ((SearchImpl.ProbCutScore == Const.Null)))
                                    {
                                        SearchImpl.ProbCutScore = (0 - SearchImpl.ProbCutScore);
                                    }
                                    If (Not ((SearchImpl.ProbCutScore == Const.Null)))
                                    {
                                        If (Not ((SearchImpl.ProbCutScore < ProbCutBeta[Ply])))
                                        {
                                            Call SearchNextPly((0 - ProbCutBeta[Ply]))((0 - (ProbCutBeta[Ply] - 1)))(Horizon)(3)(Ply)((Not (Cutnode)))((1 == 0))(Const.Null);
                                            SearchImpl.ProbCutScore = SearchEval[(Ply + 1)];
                                            If (Not ((SearchImpl.ProbCutScore == Const.Null)))
                                            {
                                                SearchImpl.ProbCutScore = (0 - SearchImpl.ProbCutScore);
                                            }
                                            If (Not ((SearchImpl.ProbCutScore == Const.Null)))
                                            {
                                                If (Not ((SearchImpl.ProbCutScore < ProbCutBeta[Ply])))
                                                {
                                                    SearchImpl.ProbCutMove = AppliedMove[Ply];
                                                    Call RevertMove(Ply);
                                                    List.ReplaceItem(SearchEval, Ply, SearchImpl.ProbCutScore);
                                                    If (ExcludedMove == Const.Null)
                                                    {
                                                        Call TTStoreNode(Glob.Board.CurrentHash)(Ply)(SearchImpl.ProbCutScore)(SearchImpl.ProbCutMove)(Const.TTType.LowBound)((Horizon - 3))(Const.Null)(NodeTTStaticEval[Ply]);
                                                    }
                                                    Stop(this script);
                                                }
                                            }
                                        }
                                    }
                                }
                                Call RevertMove(Ply);
                            }
                        }
                    }
                }
            }
        }
        Call Search_InternalIterativeDeepening(Horizon)(Ply)(Cutnode)(Quiescence);
        If (IIDState[Ply] == 1)
        {
            List.ReplaceItem(IIDState, Ply, 2);
            Call SearchImpl(Alphas[Ply])(Betas[Ply])((Horizon - 3))(Ply)(Cutnode)(Quiescence)(ExcludedMove);
            Call SearchImpl(AlphasOld[Ply])(Betas[Ply])(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
            List.ReplaceItem(IIDState, Ply, 0);
            Stop(this script);
        }
        If (((((Ply > 1) And (ExcludedMove == Const.Null)) And ((SingularState[Ply] == 0) And ((Horizon > (3 + (2 * (Not (((Betas[Ply] - Alphas[Ply]) == 1)))))) And (Not ((NodeTTMove[Ply] == Const.Null)))))) And ((Ply - 1) < (2 * Glob.Search.IterationIdx))) And (1 == 0))
        {
            If ((NodeTTHit[Ply] == 1) And ((Not ((NodeTTScore[Ply] == Const.Null))) And (Not ((NodeTTHorizon[Ply] == Const.Null)))))
            {
                If ((abs(NodeTTScore[Ply]) < 4087) And (((NodeTTType[Ply] == Const.TTType.LowBound) Or (NodeTTType[Ply] == Const.TTType.Exact)) And (Not ((NodeTTHorizon[Ply] < (Horizon - 3))))))
                {
                    List.ReplaceItem(SingularMove, Ply, NodeTTMove[Ply]);
                    List.ReplaceItem(SingularNodeAlpha, Ply, Alphas[Ply]);
                    List.ReplaceItem(SingularNodeBeta, Ply, Betas[Ply]);
                    List.ReplaceItem(SingularBeta, Ply, (NodeTTScore[Ply] - floor(((5 * Horizon) / 4))));
                    List.ReplaceItem(SingularExtension, Ply, 0);
                    List.ReplaceItem(SingularQuietLMR, Ply, 0);
                    Call SearchImpl((SingularBeta[Ply] - 1))(SingularBeta[Ply])(floor(((Horizon - 1) / 2)))(Ply)(Cutnode)((1 == 0))(SingularMove[Ply]);
                    If (Not ((SearchEval[Ply] == Const.Null)))
                    {
                        If (SearchEval[Ply] < SingularBeta[Ply])
                        {
                            List.ReplaceItem(SingularExtension, Ply, 1);
                            List.ReplaceItem(SingularQuietLMR, Ply, (1 * ((floor((SingularMove[Ply] / 100)) == 0) Or ((Board[floor((SingularMove[Ply] % 100))] == 0) And (SingularMove[Ply] == floor(SingularMove[Ply]))))));
                            If (1 == 0)
                            {
                                If (((SingularNodeBeta[Ply] - SingularNodeAlpha[Ply]) == 1) And ((SearchEval[Ply] < (SingularBeta[Ply] - 11)) And (DoubleExtensions[Ply] < 9)))
                                {
                                    List.ReplaceItem(SingularExtension, Ply, 2);
                                }
                            }
                        }
                        Else
                        {
                            If (Not ((SingularBeta[Ply] < SingularNodeBeta[Ply])))
                            {
                                List.ReplaceItem(SearchEval, Ply, SingularBeta[Ply]);
                                Stop(this script);
                            }
                            Else
                            {
                                If (1 == 0)
                                {
                                    If (Not (((SingularBeta[Ply] + floor(((5 * Horizon) / 4))) < SingularNodeBeta[Ply])))
                                    {
                                        List.ReplaceItem(SingularExtension, Ply, -2);
                                    }
                                    Else
                                    {
                                        If ((Not (((SingularBeta[Ply] + floor(((5 * Horizon) / 4))) > SingularNodeAlpha[Ply]))) And (Not (((SingularBeta[Ply] + floor(((5 * Horizon) / 4))) > SearchEval[Ply]))))
                                        {
                                            List.ReplaceItem(SingularExtension, Ply, -1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    List.ReplaceItem(SingularState, Ply, 1);
                    Call SearchImpl(SingularNodeAlpha[Ply])(SingularNodeBeta[Ply])(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
                    List.ReplaceItem(SingularState, Ply, 0);
                    Stop(this script);
                }
            }
        }
    }
    Else
    {
        Call //("Quiescence search => standing pat handling (unless in check and must evade)");
        Call //("Important to consider in subsequent code that node eval might be set from here on");
        If (CheckedState[Ply] == 1)
        {
            Call //("Put a checkmate baseline into node eval, which must be improved later by at east one move that gets us out of check");
            List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
        }
        Else
        {
            Call GetStaticEval(Ply);
            List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
            If (Not ((StaticEval[Ply] < Betas[Ply])))
            {
                Call //("Failing high => cutoff");
                If (Not ((NodeTTHit[Ply] == 1)))
                {
                    Call TTStoreNode(Glob.Board.CurrentHash)(Ply)(SearchEval[Ply])(Const.Null)(Const.TTType.LowBound)(-1)(0)(NodeTTStaticEval[Ply]);
                }
                Stop(this script);
            }
            If (StaticEval[Ply] > Alphas[Ply])
            {
                List.ReplaceItem(Alphas, Ply, StaticEval[Ply]);
            }
        }
    }
    List.ReplaceItem(PickPhase, Ply, Const.PickPhase1HashMove);
    List.ReplaceItem(PickMoveRes, Ply, 1);
    List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCount, Ply, 0);
    Call PrepareCheckInfo(Ply);
    If (PlyIsOwn[Ply] == 1)
    {
        SearchImpl.LMPPieces = (Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount);
    }
    Else
    {
        SearchImpl.LMPPieces = (Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount);
    }
    If (((Not (Quiescence)) And (IsPvNode[Ply] == 0)) And ((CheckedState[Ply] == 0) And (SearchImpl.LMPPieces > 0)))
    {
        Call GetImproving(Ply);
        SearchImpl.LMPImp = (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))));
        List.ReplaceItem(PreLMPLimit, Ply, (3 + ((Horizon * Horizon) / (2 - SearchImpl.LMPImp))));
    }
    Else
    {
        List.ReplaceItem(PreLMPLimit, Ply, Const.Null);
    }
    Call //("Move generation and move loop");
    Repeat Until (PickMoveRes[Ply] == 0)
    {
        If ((Not (Quiescence)) And ((Ply == 1) Or (Horizon > 1)))
        {
            If ((Glob.Search.IsTimeout == 0) And ((Not ((Glob.Search.IsInitialDeepening == 1))) Or (Not ((Ret.SearchImpl.Move == Const.Null)))))
            {
                If (((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart) > Glob.Search.ThinkTimeLimit)
                {
                    Glob.Search.IsTimeout = 1;
                }
            }
        }
        If (Glob.Search.IsTimeout == 1)
        {
            If (Quiescence[Ply] == 0)
            {
                Glob.Stats.MoveCount += MovesCount[Ply];
            }
            Else
            {
                Glob.Stats.MoveCountQuiescence += MovesCount[Ply];
            }
            Stop(this script);
        }
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call ProfilerMethodEnter(((5 * Const.MaxPlyStackFrames) + Ply));
        }
        Call //("Invoke staged move generator and apply next move from list");
        Call NNUE_Public_OnMakeMoveStart(Ply);
        Call PickMove(Ply)(Quiescence)((1 == 0));
        If (PickMoveRes[Ply] == 1)
        {
            If ((Not (Quiescence)) And (AppliedMove[Ply] == ExcludedMove))
            {
                Call RevertMove(Ply);
                Call PickMove(Ply)(Quiescence)((1 == 0));
            }
        }
        If (PickMoveRes[Ply] == 1)
        {
            List.ReplaceItem(PickedLegalMovesCount, Ply, (PickedLegalMovesCount[Ply] + 1));
            If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
            {
                List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, (PickedLegalMovesCountQuiet[Ply] + 1));
            }
        }
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call ProfilerMethodExit(((5 * Const.MaxPlyStackFrames) + Ply));
        }
        If (PickMoveRes[Ply] == 1)
        {
            Call //("Show progress and collect statistics");
            List.ReplaceItem(ReductionBase, Ply, Const.Null);
            List.ReplaceItem(SearchExtension, Ply, 0);
            Call //("Check detection for current move: does it put the opponent in check");
            Call GivesCheckFast(Ply);
            List.ReplaceItem(PutsInCheck, Ply, Ret.GivesCheckFast.GivesCheck);
            Call Search_FutilityPruning(Horizon)(Ply)(Quiescence);
            SearchImpl.IsRootExcluded = 0;
            If ((Ply == 1) And (List.Length(RootExcludedMoves) > 0))
            {
                Call GetCurrentMove(Ply);
                If List.ContainsItem(RootExcludedMoves, Ret.GetCurrentMove.Move)
                {
                    SearchImpl.IsRootExcluded = 1;
                    List.ReplaceItem(PickedLegalMovesCount, Ply, (PickedLegalMovesCount[Ply] - 1));
                    If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
                    {
                        List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, (PickedLegalMovesCountQuiet[Ply] - 1));
                    }
                }
            }
            If ((Ret.Search_FutilityPruning.IsFutile == 1) Or (SearchImpl.IsRootExcluded == 1))
            {
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Search_CollectStats(Horizon)(Ply)(Quiescence)(Const.Profile.DeltaHits)(Const.Profile.FutilityHits);
                }
                Call RevertMove(Ply);
