                            }
                            List.ReplaceItem(CorrHistNonPawnBlack, Ret.GetCorrHistIndices.NonPawnBlackIdx, ((CorrHistNonPawnBlack[Ret.GetCorrHistIndices.NonPawnBlackIdx] + SearchImpl.CorrBonus) - (floor(abs(((CorrHistNonPawnBlack[Ret.GetCorrHistIndices.NonPawnBlackIdx] * abs(SearchImpl.CorrBonus)) / 1024))) * ((((CorrHistNonPawnBlack[Ret.GetCorrHistIndices.NonPawnBlackIdx] * abs(SearchImpl.CorrBonus)) / 1024) > 0) - (((CorrHistNonPawnBlack[Ret.GetCorrHistIndices.NonPawnBlackIdx] * abs(SearchImpl.CorrBonus)) / 1024) < 0)))));
                            If (Not ((CorrHistNonPawnWhiteKey[Ret.GetCorrHistIndices.NonPawnWhiteIdx] == (floor((Ret.GetCorrHistIndices.NonPawnWhiteKey / 100000)) % 1073741824))))
                            {
