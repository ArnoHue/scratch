}


//----- Custom blocks -------------------------------------------------------------------------------------------------

Define $gok_prepare (warp=true)
{
    List.ReplaceItem(EnPassantTarget, 1, Const.Null);
    $gok_prepare.TargetIsPlayerBlack = 0;
    If Operator.Contains(_dci fen, " w")
    {
        $gok_prepare.TargetIsPlayerBlack = 1;
    }
    If (Not (($gok_prepare.TargetIsPlayerBlack == Glob.IsPlayerBlack)))
    {
        Glob.IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        GoK_IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        Glob.ExecutionPly = 0;
        Glob.IsExecutionRunning = 0;
        Glob.Level = 3;
        GoK_Level = 3;
        DCI.SavedClockTime = Glob.CurrentClockTime;
        DCI.SavedClockMoveCount = Glob.ClockMoveCount;
        DCI.SavedTimeModelLogged = Glob.IsTimeModelLogged;
        Call InitBoard;
        Glob.CurrentClockTime = DCI.SavedClockTime;
        Glob.ClockMoveCount = DCI.SavedClockMoveCount;
        Glob.IsTimeModelLogged = DCI.SavedTimeModelLogged;
        Call InitBoardPhase2;
        Call ​​warn​​("$gok_reinit");
    }
    Call ImportBoardFEN(_dci fen);
    $gok_prepare.CanOwnCastleKingside = 0;
    $gok_prepare.CanOwnCastleQueenside = 0;
    $gok_prepare.CanOppCastleKingside = 0;
    $gok_prepare.CanOppCastleQueenside = 0;
    $gok_prepare.CastlingCharIdx = 1;
    Repeat Until ((Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == " ") Or ($gok_prepare.CastlingCharIdx > Variable.Length(_dci fen)))
    {
        $gok_prepare.CastlingCharIdx += 1;
    }
    $gok_prepare.CastlingCharIdx += 3;
    Repeat Until (($gok_prepare.CastlingCharIdx > Variable.Length(_dci fen)) Or (Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == " "))
    {
        If (Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == "K")
        {
            Call IsLowerCase(Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx));
            If (Ret.IsLowerCase.IsLower == 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOwnCastleKingside = 1;
                }
                Else
                {
                    $gok_prepare.CanOppCastleKingside = 1;
                }
            }
            Else
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOppCastleKingside = 1;
                }
                Else
                {
                    $gok_prepare.CanOwnCastleKingside = 1;
                }
            }
        }
        If (Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == "Q")
        {
            Call IsLowerCase(Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx));
            If (Ret.IsLowerCase.IsLower == 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOwnCastleQueenside = 1;
                }
                Else
                {
                    $gok_prepare.CanOppCastleQueenside = 1;
                }
            }
            Else
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOppCastleQueenside = 1;
                }
                Else
                {
                    $gok_prepare.CanOwnCastleQueenside = 1;
                }
            }
        }
        $gok_prepare.CastlingCharIdx += 1;
    }
    List.ReplaceItem(EnPassantTarget, 1, Const.Null);
    If ($gok_prepare.CastlingCharIdx < Variable.Length(_dci fen))
    {
        $gok_prepare.EnPassantCharIdx = ($gok_prepare.CastlingCharIdx + 1);
        If ((Not ((Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "-"))) And (Not ((Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == ""))))
        {
            $gok_prepare.EnPassantFile = 0;
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "a")
            {
                $gok_prepare.EnPassantFile = 1;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "b")
            {
                $gok_prepare.EnPassantFile = 2;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "c")
            {
                $gok_prepare.EnPassantFile = 3;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "d")
            {
                $gok_prepare.EnPassantFile = 4;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "e")
            {
                $gok_prepare.EnPassantFile = 5;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "f")
            {
                $gok_prepare.EnPassantFile = 6;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "g")
            {
                $gok_prepare.EnPassantFile = 7;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "h")
            {
                $gok_prepare.EnPassantFile = 8;
            }
            If ($gok_prepare.EnPassantFile > 0)
            {
                List.ReplaceItem(EnPassantTarget, 1, (32 + $gok_prepare.EnPassantFile));
            }
        }
    }
    List.DeleteAll(GameMoves);
    If (Not ((EnPassantTarget[1] == Const.Null)))
    {
        $gok_prepare.SynthTargetIdx = EnPassantTarget[1];
        If (Board[$gok_prepare.SynthTargetIdx] > 0)
        {
            $gok_prepare.SynthSourceIdx = ($gok_prepare.SynthTargetIdx - 16);
        }
        Else
        {
            $gok_prepare.SynthSourceIdx = ($gok_prepare.SynthTargetIdx + 16);
        }
        List.DeleteAll(GameMoves);
        List.Add(GameMoves, (($gok_prepare.SynthSourceIdx * 100) + $gok_prepare.SynthTargetIdx));
    }
    $gok_prepare.FullMoveCharIdx = 0;
    $gok_prepare.FullMoveToken = 0;
    $gok_prepare.FullMoveText = "";
    Repeat (Variable.Length(_dci fen))
    {
        $gok_prepare.FullMoveCharIdx += 1;
        $gok_prepare.FullMoveChar = Operator.LetterOf(_dci fen, $gok_prepare.FullMoveCharIdx);
        If ($gok_prepare.FullMoveChar == " ")
        {
            $gok_prepare.FullMoveToken += 1;
        }
        Else
        {
            If ($gok_prepare.FullMoveToken == 4)
            {
                $gok_prepare.FullMoveText = Operator.Join($gok_prepare.FullMoveText, $gok_prepare.FullMoveChar);
            }
        }
    }
    List.DeleteAll(BoardHistoryFiftyMoves);
    $gok_prepare.FullMoveCount = 0;
    Repeat ($gok_prepare.FullMoveText)
    {
        $gok_prepare.FullMoveCount += 1;
        List.Add(BoardHistoryFiftyMoves, $gok_prepare.FullMoveCount);
    }
    Glob.HasWhiteRookKSMoved = 0;
    Glob.HasWhiteRookQSMoved = 0;
    Glob.HasWhiteKingMoved = 0;
    Glob.HasWhiteCastled = 0;
    Glob.HasBlackRookKSMoved = 0;
    Glob.HasBlackRookQSMoved = 0;
    Glob.HasBlackKingMoved = 0;
    Glob.HasBlackCastled = 0;
    If (Not (($gok_prepare.CanOwnCastleQueenside == 1)))
    {
        Glob.HasBlackRookQSMoved = 1;
    }
    If (Not ((($gok_prepare.CanOwnCastleQueenside == 1) Or ($gok_prepare.CanOwnCastleKingside == 1))))
    {
        Glob.HasBlackKingMoved = 1;
        Glob.HasBlackCastled = 1;
    }
    If (Not (($gok_prepare.CanOwnCastleKingside == 1)))
    {
        Glob.HasBlackRookKSMoved = 1;
    }
    If (Not (($gok_prepare.CanOppCastleQueenside == 1)))
    {
        Glob.HasWhiteRookQSMoved = 1;
    }
    If (Not ((($gok_prepare.CanOppCastleQueenside == 1) Or ($gok_prepare.CanOppCastleKingside == 1))))
    {
        Glob.HasWhiteKingMoved = 1;
        Glob.HasWhiteCastled = 1;
    }
    If (Not (($gok_prepare.CanOppCastleKingside == 1)))
    {
        Glob.HasWhiteRookKSMoved = 1;
    }
    Call CalcBoardStats;
    If (_dci think time == "Infinity")
    {
        Glob.CustomThinkTime = 100000;
        Glob.CustomMaxDepth = _dci max depth;
    }
    Else
    {
        If (_dci think time > 0)
        {
            Glob.CustomThinkTime = _dci think time;
        }
        Else
        {
            Glob.CustomThinkTime = 1;
        }
        Glob.CustomMaxDepth = 0;
    }
    Glob.InitialClockTime = 0;
    Glob.ClockTimeInc = 0;
    Glob.ClockStageMoves = 0;
    Glob.ClockStageTime = 0;
    If ((Glob.CustomMaxDepth == 0) And (Not ((_dci clock time == ""))))
    {
        DCI.ClockSlashIdx = 0;
        DCI.ClockPlusIdx = 0;
        DCI.ClockCharIdx = 1;
        Repeat (Variable.Length(_dci clock time))
        {
            If (Operator.LetterOf(_dci clock time, DCI.ClockCharIdx) == "/")
            {
                DCI.ClockSlashIdx = DCI.ClockCharIdx;
            }
            If (Operator.LetterOf(_dci clock time, DCI.ClockCharIdx) == "+")
            {
                DCI.ClockPlusIdx = DCI.ClockCharIdx;
            }
            DCI.ClockCharIdx += 1;
        }
        If (DCI.ClockSlashIdx > 0)
        {
            DCI.ClockPart = "";
            DCI.ClockCharIdx = 1;
            Repeat ((DCI.ClockSlashIdx - 1))
            {
                DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                DCI.ClockCharIdx += 1;
            }
            If (Not ((DCI.ClockPart == "")))
            {
                Glob.InitialClockTime = DCI.ClockPart;
            }
            If (DCI.ClockPlusIdx > DCI.ClockSlashIdx)
            {
                DCI.ClockPart = "";
                DCI.ClockCharIdx = (DCI.ClockSlashIdx + 1);
                Repeat (((DCI.ClockPlusIdx - DCI.ClockSlashIdx) - 1))
                {
                    DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                    DCI.ClockCharIdx += 1;
                }
                If (DCI.ClockPart == "")
                {
                    Glob.ClockStageMoves = 0;
                }
                Else
                {
                    Glob.ClockStageMoves = DCI.ClockPart;
                }
                DCI.ClockPart = "";
                DCI.ClockCharIdx = (DCI.ClockPlusIdx + 1);
                Repeat ((Variable.Length(_dci clock time) - DCI.ClockPlusIdx))
                {
                    DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                    DCI.ClockCharIdx += 1;
                }
                If (DCI.ClockPart == "")
                {
                    Glob.ClockStageTime = 0;
                }
                Else
                {
                    Glob.ClockStageTime = DCI.ClockPart;
                }
            }
            Else
            {
                DCI.ClockPart = "";
                DCI.ClockCharIdx = (DCI.ClockSlashIdx + 1);
                Repeat ((Variable.Length(_dci clock time) - DCI.ClockSlashIdx))
                {
                    DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                    DCI.ClockCharIdx += 1;
                }
                If (Not ((DCI.ClockPart == "")))
                {
                    Glob.ClockTimeInc = DCI.ClockPart;
                }
            }
        }
        DCI.ClockValid = 1;
        If (Not ((Glob.InitialClockTime == (Glob.InitialClockTime + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.InitialClockTime < 0)
        {
            DCI.ClockValid = 0;
        }
        If (Not ((Glob.ClockTimeInc == (Glob.ClockTimeInc + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.ClockTimeInc < 0)
        {
            DCI.ClockValid = 0;
        }
        If (Not ((Glob.ClockStageMoves == (Glob.ClockStageMoves + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.ClockStageMoves < 0)
        {
            DCI.ClockValid = 0;
        }
        If (Not ((Glob.ClockStageTime == (Glob.ClockStageTime + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.ClockStageTime < 0)
        {
            DCI.ClockValid = 0;
        }
        If (DCI.ClockValid == 0)
        {
            Glob.InitialClockTime = 0;
            Glob.ClockTimeInc = 0;
            Glob.ClockStageMoves = 0;
            Glob.ClockStageTime = 0;
            Call Log("DCI clock invalid, no clock set : ")(_dci clock time)("")("")("")("")("")("");
        }
    }
    If (Glob.CurrentClockTime == Const.Null)
    {
        Glob.CurrentClockTime = Glob.InitialClockTime;
        Glob.ClockMoveCount = 0;
    }
    List.DeleteAll(GameMoves);
    If ((Not ((EnPassantTarget[1] == Const.Null))) And (EnPassantTarget[1] > 0))
    {
        If (Board[EnPassantTarget[1]] > 0)
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] - 16) * 100) + EnPassantTarget[1]));
        }
        Else
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] + 16) * 100) + EnPassantTarget[1]));
        }
    }
}

Define //(string Comment) (warp=true)
{
}

Define AddBoardToHistory(string WasEngineMove) (warp=true)
{
    Call GetBoardString;
    List.Add(BoardHistory, Ret.GetBoardString.BoardString);
    Call CreateCurrentBoardHash;
    List.Add(BoardHistoryHash, Glob.CurrentBoardHash);
    List.Add(BoardHistoryMetaState, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    List.Add(BoardHistoryWasEngineMove, WasEngineMove);
}

Define AddLookupMove(string SourceIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool LookupMoveTypeKing) (warp=true)
{
    AddMove.KingKnight.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddMove.KingKnight.Idx = (MoveSourceIdxToListOffsetNonSliding[(SourceIdx + 0)] + 0);
    AddMove.KingKnight.Count = 1;
    Repeat (8)
    {
        If LookupMoveTypeKing
        {
            AddMove.KingKnight.TargetIdx = (MoveListOffsetToTargetIdxKing[(AddMove.KingKnight.Idx + AddMove.KingKnight.Count)] + 0);
        }
        Else
        {
            AddMove.KingKnight.TargetIdx = (MoveListOffsetToTargetIdxKnight[(AddMove.KingKnight.Idx + AddMove.KingKnight.Count)] + 0);
        }
        If (AddMove.KingKnight.TargetIdx == -1)
        {
            Stop(this script);
        }
        If CalcAttackState
        {
            Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
        }
        Else
        {
            If (Board[AddMove.KingKnight.TargetIdx] == 0)
            {
                If CapturesOnly
                {
                    If LookupMoveTypeKing
                    {
                        If (CheckedState[Ply] == 1)
                        {
                            Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                        }
                        Else
                        {
                            Call AddPotentialQuiescenceMove(SourceIdx)(AddMove.KingKnight.TargetIdx)(AddMove.KingKnight.SourcePiece)(Ply);
                        }
                    }
                    Else
                    {
                        Call AddPotentialQuiescenceMove(SourceIdx)(AddMove.KingKnight.TargetIdx)(AddMove.KingKnight.SourcePiece)(Ply);
                    }
                }
                Else
                {
                    Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                }
            }
            Else
            {
                If (AddMove.KingKnight.SourcePiece > 0)
                {
                    If (Board[AddMove.KingKnight.TargetIdx] < 0)
                    {
                        Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                    }
                }
                Else
                {
                    If (Board[AddMove.KingKnight.TargetIdx] > 0)
                    {
                        Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                    }
                }
            }
        }
        AddMove.KingKnight.Count += 1;
    }
}

Define AddMoveImpl(string SourceIdx)(string TargetIdx)(string Ply)(bool AttackTableOnly)(bool Quiescence) (warp=true)
{
    If AttackTableOnly
    {
        AddMove.Impl.SourcePiece = (Board[(SourceIdx + 0)] + 0);
        If (AddMove.Impl.SourcePiece > 0)
        {
            AddMove.Impl.AttackCount = (BoardAttackedByBlack[(TargetIdx + 0)] + 0);
            If (AddMove.Impl.AttackCount < 9)
            {
                List.ReplaceItem(BoardAttackedByBlack, (TargetIdx + 0), (AddMove.Impl.AttackCount + 1));
            }
            If ((BoardAttackedByBlackPiece[(TargetIdx + 0)] == 0) Or (Board[BoardAttackedByBlackPiece[(TargetIdx + 0)]] > AddMove.Impl.SourcePiece))
            {
                List.ReplaceItem(BoardAttackedByBlackPiece, (TargetIdx + 0), SourceIdx);
            }
            If (Board[(TargetIdx + 0)] == GoK_WhiteKing)
            {
                Glob.IsWhiteChecked = 1;
            }
        }
        Else
        {
            AddMove.Impl.AttackCount = (BoardAttackedByWhite[(TargetIdx + 0)] + 0);
            If (AddMove.Impl.AttackCount < 9)
            {
                List.ReplaceItem(BoardAttackedByWhite, (TargetIdx + 0), (AddMove.Impl.AttackCount + 1));
            }
            If ((BoardAttackedByWhitePiece[(TargetIdx + 0)] == 0) Or (Board[BoardAttackedByWhitePiece[(TargetIdx + 0)]] < AddMove.Impl.SourcePiece))
            {
                List.ReplaceItem(BoardAttackedByWhitePiece, (TargetIdx + 0), SourceIdx);
            }
            If (Board[(TargetIdx + 0)] == GoK_BlackKing)
            {
                Glob.IsBlackChecked = 1;
            }
        }
        Stop(this script);
    }
    If (CheckedState[Ply] == 1)
    {
        If (Not ((BoardAttackedEvasionTarget[(TargetIdx + 0)] == 1)))
        {
            If (Not ((abs(Board[(SourceIdx + 0)]) == GoK_BlackKing)))
            {
                If (EnPassantTarget[Ply] == Const.Null)
                {
                    Stop(this script);
                }
            }
        }
    }
    AddMove.Impl.Move = ((SourceIdx * 100) + TargetIdx);
    If (abs(Board[(SourceIdx + 0)]) == GoK_BlackPawn)
    {
        If ((IdxToRank[(TargetIdx + 0)] == 1) Or (IdxToRank[(TargetIdx + 0)] == 8))
        {
            Call AddSpecialMove((AddMove.Impl.Move + 0.1))(Ply);
            If (Not (Quiescence))
            {
                Call AddSpecialMove((AddMove.Impl.Move + 0.2))(Ply);
                Call AddSpecialMove((AddMove.Impl.Move + 0.3))(Ply);
                Call AddSpecialMove((AddMove.Impl.Move + 0.4))(Ply);
            }
            Stop(this script);
        }
    }
    Else
    {
        If (Glob.IsClassicEndgameEval == 1)
        {
            If (Not (Quiescence))
            {
                If (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + TargetIdx)] == 0)
                {
                    List.ReplaceItem(PieceMobility, (SourceIdx + 0), (PieceMobility[(SourceIdx + 0)] + 1));
                }
            }
        }
    }
    List.Add(CalcMovesMoveList, AddMove.Impl.Move);
    Call GetMoveScore(Board[(SourceIdx + 0)])(Board[(TargetIdx + 0)])(SourceIdx)(TargetIdx)(AddMove.Impl.Move)(Ply);
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddMoveImplLookup(string SourceIdx)(string TargetIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool IsKing) (warp=true)
{
    If IsKing
    {
        If (Not (CalcAttackState))
        {
            If ((BoardAttackedCalculated[Ply] == 1) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + TargetIdx)] > 0))
            {
                Stop(this script);
            }
            If (PlyIsOwn[Ply] == 1)
            {
                AddMove.ImplLookup.KingIdx = Glob.WhiteKingIdx;
            }
            Else
            {
                AddMove.ImplLookup.KingIdx = Glob.BlackKingIdx;
            }
            If (ChebyshevDistance[((AddMove.ImplLookup.KingIdx * 100) + TargetIdx)] < 2)
            {
                Stop(this script);
            }
        }
    }
    Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)(CalcAttackState)(CapturesOnly);
}

Define AddMoveToList(string Move)(string Ply)(string MoveScore) (warp=true)
{
    List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), Move);
    List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), MoveScore);
    List.ReplaceItem(MovesCount, Ply, (MovesCount[Ply] + 1));
    If (Ply < 3)
    {
        If (Ply == 1)
        {
            List.Add(Moves1, Move);
        }
        Else
        {
            If (Ply == 2)
            {
                List.Add(Moves2, Move);
            }
        }
    }
}

Define AddPotentialQuiescenceMove(string SourceIdx)(string TargetIdx)(string Piece)(string Ply) (warp=true)
{
    Call //("Allow check evasions and - up to a limit - also checks during quiescence search");
    If (CheckedState[Ply] == 1)
    {
        If (abs(Piece) == GoK_BlackKing)
        {
            If ((BoardAttackedCalculated[Ply] == 1) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + TargetIdx)] > 0))
            {
                Stop(this script);
            }
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        }
        Else
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        }
        Stop(this script);
    }
    If (Piece == GoK_BlackPawn)
    {
        If (IdxToRank[TargetIdx] == 8)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
            Stop(this script);
        }
    }
    If (Piece == GoK_WhitePawn)
    {
        If (IdxToRank[TargetIdx] == 1)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
            Stop(this script);
        }
    }
    If (Glob.IsPotentialNonCapQuiescMove == 0)
    {
        Stop(this script);
    }
    AddMove.PotQ.TargetPiece = Board[TargetIdx];
    List.ReplaceItem(Board, TargetIdx, Board[SourceIdx]);
    List.ReplaceItem(Board, SourceIdx, 0);
    Call IsCheckingPieceDiscovery(SourceIdx)(TargetIdx)(Ply);
    List.ReplaceItem(Board, SourceIdx, Board[TargetIdx]);
    List.ReplaceItem(Board, TargetIdx, AddMove.PotQ.TargetPiece);
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        Stop(this script);
    }
    If (abs(Piece) == GoK_BlackKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.WhiteKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.BlackKingIdx);
    }
    If (Ret.IsReachableForAttack.IsReachable == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
    }
}

Define AddSlidingMove(string SourceIdx)(string Ply)(bool Quiescence)(bool SlidingStraight) (warp=true)
{
    AddMove.Sliders.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddMove.Sliders.RaySlot = 1;
    AddMove.Sliders.RayOffset = (MoveSourceIdxToListOffsetSliding[(SourceIdx + 0)] + 0);
    AddMove.Sliders.RaySqLeft = 8;
    Repeat Until (AddMove.Sliders.RaySlot > 32)
    {
        If SlidingStraight
        {
            AddMove.Sliders.TargetIdx = (MoveSlidingStraightListIdxToTargetIdx[(AddMove.Sliders.RayOffset + AddMove.Sliders.RaySlot)] + 0);
        }
        Else
        {
            AddMove.Sliders.TargetIdx = (MoveCrossListIdxToTargetIdx[(AddMove.Sliders.RayOffset + AddMove.Sliders.RaySlot)] + 0);
        }
        If (AddMove.Sliders.TargetIdx == -1)
        {
            AddMove.Sliders.RaySlot += AddMove.Sliders.RaySqLeft;
            AddMove.Sliders.RaySqLeft = 8;
        }
        Else
        {
            AddMove.Sliders.TargetPiece = (Board[(AddMove.Sliders.TargetIdx + 0)] + 0);
            If (AddMove.Sliders.TargetPiece == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)(AddMove.Sliders.TargetIdx)(AddMove.Sliders.SourcePiece)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)(AddMove.Sliders.TargetIdx)(Ply)((1 == 0))(Quiescence);
                }
                AddMove.Sliders.RaySlot += 1;
                AddMove.Sliders.RaySqLeft += -1;
            }
            Else
            {
                If (AddMove.Sliders.SourcePiece > 0)
                {
                    If (AddMove.Sliders.TargetPiece < 0)
                    {
                        Call AddMoveImpl(SourceIdx)(AddMove.Sliders.TargetIdx)(Ply)((1 == 0))(Quiescence);
                    }
                }
                Else
                {
                    If (AddMove.Sliders.TargetPiece > 0)
                    {
                        Call AddMoveImpl(SourceIdx)(AddMove.Sliders.TargetIdx)(Ply)((1 == 0))(Quiescence);
                    }
                }
                AddMove.Sliders.RaySlot += AddMove.Sliders.RaySqLeft;
                AddMove.Sliders.RaySqLeft = 8;
            }
        }
    }
}

Define AddSlidingMove(string SourceIdx)(string Ply)(bool AttackTableOnly)(bool Quiescence)(bool SlidingStraight) (warp=true)
{
    If AttackTableOnly
    {
        Call AddSlidingMoveForAttackTable(SourceIdx)(Ply)(SlidingStraight);
    }
    Else
    {
        Call AddSlidingMove(SourceIdx)(Ply)(Quiescence)(SlidingStraight);
    }
}

Define AddSlidingMoveForAttackTable(string SourceIdx)(string Ply)(bool SlidingStraight) (warp=true)
{
    AddMove.SliderAT.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddMove.SliderAT.RaySlot = 1;
    AddMove.SliderAT.RayOffset = (MoveSourceIdxToListOffsetSliding[(SourceIdx + 0)] + 0);
    AddMove.SliderAT.RaySqLeft = 8;
    Repeat Until (AddMove.SliderAT.RaySlot > 32)
    {
        If SlidingStraight
        {
            AddMove.SliderAT.TargetIdx = (MoveSlidingStraightListIdxToTargetIdx[(AddMove.SliderAT.RayOffset + AddMove.SliderAT.RaySlot)] + 0);
        }
        Else
        {
            AddMove.SliderAT.TargetIdx = (MoveCrossListIdxToTargetIdx[(AddMove.SliderAT.RayOffset + AddMove.SliderAT.RaySlot)] + 0);
        }
        If (AddMove.SliderAT.TargetIdx == -1)
        {
            AddMove.SliderAT.RaySlot += AddMove.SliderAT.RaySqLeft;
            AddMove.SliderAT.RaySqLeft = 8;
        }
        Else
        {
            AddMove.SliderAT.TargetPiece = (Board[(AddMove.SliderAT.TargetIdx + 0)] + 0);
            If (AddMove.SliderAT.TargetPiece == 0)
            {
                Call AddMoveImpl(SourceIdx)(AddMove.SliderAT.TargetIdx)(Ply)((1 == 1))((1 == 0));
                AddMove.SliderAT.RaySlot += 1;
                AddMove.SliderAT.RaySqLeft += -1;
            }
            Else
            {
                Call AddMoveImpl(SourceIdx)(AddMove.SliderAT.TargetIdx)(Ply)((1 == 1))((1 == 0));
                AddMove.SliderAT.IsXRay = 0;
                If (AddMove.SliderAT.SourcePiece > 0)
                {
                    If (AddMove.SliderAT.TargetPiece > GoK_BlackKnight)
                    {
                        If SlidingStraight
                        {
                            If ((AddMove.SliderAT.TargetPiece == GoK_BlackQueen) Or (AddMove.SliderAT.TargetPiece == GoK_BlackRook))
                            {
                                AddMove.SliderAT.IsXRay = 0;
                            }
                        }
                        Else
                        {
                            If ((AddMove.SliderAT.TargetPiece == GoK_BlackQueen) Or (AddMove.SliderAT.TargetPiece == GoK_BlackBishop))
                            {
                                AddMove.SliderAT.IsXRay = 0;
                            }
                        }
                    }
                }
                Else
                {
                    If (AddMove.SliderAT.TargetPiece < GoK_WhiteKnight)
                    {
                        If SlidingStraight
                        {
                            If ((AddMove.SliderAT.TargetPiece == GoK_WhiteQueen) Or (AddMove.SliderAT.TargetPiece == GoK_WhiteRook))
                            {
                                AddMove.SliderAT.IsXRay = 0;
                            }
                        }
                        Else
                        {
                            If ((AddMove.SliderAT.TargetPiece == GoK_WhiteQueen) Or (AddMove.SliderAT.TargetPiece == GoK_WhiteBishop))
                            {
                                AddMove.SliderAT.IsXRay = 0;
                            }
                        }
                    }
                }
                If (AddMove.SliderAT.IsXRay == 1)
                {
                    AddMove.SliderAT.RaySlot += 1;
                    AddMove.SliderAT.RaySqLeft += -1;
                }
                Else
                {
                    AddMove.SliderAT.RaySlot += AddMove.SliderAT.RaySqLeft;
                    AddMove.SliderAT.RaySqLeft = 8;
                }
            }
        }
    }
}

Define AddSpecialMove(string Move)(string Ply) (warp=true)
{
    List.Add(CalcMovesMoveList, Move);
    AddMove.Special.SourcePiece = Const.Null;
    If (Not ((Move == floor(Move))))
    {
        AddMove.Special.SourcePiece = GoK_BlackPawn;
    }
    If (floor((Move / 100)) == 0)
    {
        AddMove.Special.SourcePiece = GoK_BlackKing;
    }
    AddMove.Special.CastleFrom = floor((Move / 100));
    AddMove.Special.CastleTo = floor((Move % 100));
    If (floor((Move / 100)) == 0)
    {
        If ((Move == 65) Or (Move == 66))
        {
            AddMove.Special.CastleFrom = 5;
        }
        Else
        {
            AddMove.Special.CastleFrom = 61;
        }
        If (Move == 65)
        {
            AddMove.Special.CastleTo = 8;
        }
        Else
        {
            If (Move == 66)
            {
                AddMove.Special.CastleTo = 1;
            }
            Else
            {
                If (Move == 67)
                {
                    AddMove.Special.CastleTo = 64;
                }
                Else
                {
                    AddMove.Special.CastleTo = 57;
                }
            }
        }
    }
    If (PlyIsOwn[Ply] == 1)
    {
        Call GetMoveScore(AddMove.Special.SourcePiece)(0)(AddMove.Special.CastleFrom)(AddMove.Special.CastleTo)(Move)(Ply);
    }
    Else
    {
        Call GetMoveScore((0 - AddMove.Special.SourcePiece))(0)(AddMove.Special.CastleFrom)(AddMove.Special.CastleTo)(Move)(Ply);
    }
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddToFiftyMoves(bool IsCaptureOrPawnMove) (warp=true)
{
    If IsCaptureOrPawnMove
    {
        List.Add(BoardHistoryFiftyMoves, 0);
    }
    Else
    {
        If (List.Length(BoardHistoryFiftyMoves) == 0)
        {
            List.Add(BoardHistoryFiftyMoves, 0);
        }
        List.Add(BoardHistoryFiftyMoves, (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] + 1));
    }
}

Define AdjustEvalScore(string Ply)(string RawEval) (warp=true)
{
    If (RawEval == Const.Null)
    {
        List.ReplaceItem(StaticEval, Ply, Const.Null);
    }
    Else
    {
        If (1 == 1)
        {
            List.ReplaceItem(StaticEval, Ply, (Operator.Round(((RawEval * (211 - BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)])) / 211)) * PlySign[Ply]));
        }
        Call GetCorrHistIndices(Ply);
        AES.CorrSum = 0;
        If (CorrHistKey[Ret.GetCorrHistIndices.CorrIdx] == Ret.GetCorrHistIndices.PawnKey)
        {
            AES.CorrSum += (53 * CorrHistVal[Ret.GetCorrHistIndices.CorrIdx]);
        }
        If (CorrHistNonPawnBlackKey[Ret.GetCorrHistIndices.NonPawnBlackIdx] == Ret.GetCorrHistIndices.NonPawnBlackKey)
        {
            AES.CorrSum += (65 * CorrHistNonPawnBlack[Ret.GetCorrHistIndices.NonPawnBlackIdx]);
        }
        If (CorrHistNonPawnWhiteKey[Ret.GetCorrHistIndices.NonPawnWhiteIdx] == Ret.GetCorrHistIndices.NonPawnWhiteKey)
        {
            AES.CorrSum += (65 * CorrHistNonPawnWhite[Ret.GetCorrHistIndices.NonPawnWhiteIdx]);
        }
        If (Not ((Ret.GetCorrHistIndices.ContIdx2 == Const.Null)))
        {
            AES.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx2]);
        }
        If (Not ((Ret.GetCorrHistIndices.ContIdx4 == Const.Null)))
        {
            AES.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx4]);
        }
        List.ReplaceItem(StaticEval, Ply, (StaticEval[Ply] + Operator.Round((AES.CorrSum / 512))));
    }
}

Define ApplyMove(string Ply)(bool UpdateNNUE) (warp=true)
{
    If UpdateNNUE
    {
        Call NNUE_Public_OnMakeMoveStart(Ply);
    }
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(PutsInCheck, Ply, 0);
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.CurrentBoardHash);
    List.ReplaceItem(PreviousBoardHashKP, Ply, Glob.KPHash);
    List.ReplaceItem(PreviousNonPawnHashBlack, Ply, Glob.NonPawnHashBlack);
    List.ReplaceItem(PreviousNonPawnHashWhite, Ply, Glob.NonPawnHashWhite);
    Call GetCurrentMove(Ply);
    AM.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, AM.Move);
    Call AddToFiftyMoves((((Not ((AM.Move == 0))) And (Not ((floor((AM.Move / 100)) == 0)))) And ((abs(Board[floor((AM.Move / 100))]) == GoK_BlackPawn) Or (Not ((Board[floor((AM.Move % 100))] == 0))))));
    AM.SourceIdx = floor((AM.Move / 100));
    If (AM.SourceIdx > 0)
    {
        AM.TargetIdx = floor((AM.Move % 100));
        AM.SourcePiece = (Board[AM.SourceIdx] + 0);
        AM.TargetPiece = (Board[AM.TargetIdx] + 0);
        Call //("Update search stack variables");
        List.ReplaceItem(SourcePieces, Ply, AM.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, AM.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, AM.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, AM.TargetIdx, AM.SourcePiece);
        List.ReplaceItem(Board, AM.SourceIdx, 0);
        AM.MoveKey = ((((PlySign[Ply] + 1) * 30000) + (PieceIdxLookup[abs(AM.SourcePiece)] * 10000)) + ((AM.SourceIdx * 100) + AM.TargetIdx));
        Call //("Incremental Zobrist hash update via move-to-hash lookup table");
        Glob.CurrentBoardHash += MoveToHash[AM.MoveKey];
        If (Not ((abs(AM.SourcePiece) == GoK_BlackPawn)))
        {
            If (AM.SourcePiece > 0)
            {
                Glob.NonPawnHashBlack += MoveToHash[AM.MoveKey];
            }
            Else
            {
                Glob.NonPawnHashWhite += MoveToHash[AM.MoveKey];
            }
        }
        If (abs(AM.SourcePiece) == GoK_BlackPawn)
        {
            Glob.KPHash += MoveToHash[AM.MoveKey];
            If (Not ((IdxToFile[AM.SourceIdx] == IdxToFile[AM.TargetIdx])))
            {
                If (TargetPieces[Ply] == 0)
                {
                    Call //("en-passant => stack vars and Zobrist hash update");
                    AM.SqIdx = (AM.TargetIdx + (8 * (0 - PlySign[Ply])));
                    List.ReplaceItem(TargetPiecesIdx, Ply, AM.SqIdx);
                    List.ReplaceItem(TargetPieces, Ply, Board[AM.SqIdx]);
                    AM.TargetPiece = (Board[AM.SqIdx] + 0);
                    List.ReplaceItem(Board, AM.SqIdx, 0);
                    If (1 == 0)
                    {
                        Call GetPiecePosHash(AM.TargetPiece)(AM.SqIdx);
                        Glob.CurrentBoardHash = (Glob.CurrentBoardHash - Ret.GetPiecePosHash.Hash);
                        If (Not ((abs(AM.TargetPiece) == GoK_BlackPawn)))
                        {
                            If (AM.TargetPiece > 0)
                            {
                                Glob.NonPawnHashBlack = (Glob.NonPawnHashBlack - Ret.GetPiecePosHash.Hash);
                            }
                            Else
                            {
                                Glob.NonPawnHashWhite = (Glob.NonPawnHashWhite - Ret.GetPiecePosHash.Hash);
                            }
                        }
                        Glob.KPHash = (Glob.KPHash - Ret.GetPiecePosHash.Hash);
                    }
                }
            }
            If (((AM.TargetIdx - AM.SourceIdx) == (16 * PlySign[Ply])) And (((IdxToFile[AM.TargetIdx] > 1) And (Board[(AM.TargetIdx - 1)] == (GoK_WhitePawn * PlySign[Ply]))) Or ((IdxToFile[AM.TargetIdx] < 8) And (Board[(AM.TargetIdx + 1)] == (GoK_WhitePawn * PlySign[Ply])))))
            {
                List.ReplaceItem(EnPassantTarget, Ply, AM.TargetIdx);
            }
            If (AM.TargetIdx < 9)
            {
                AM.PromotionCode = (Operator.LetterOf(AM.Move, Variable.Length(AM.Move)) + 0);
                If (AM.PromotionCode == 1)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteQueen);
                    Glob.WhiteQueenCount += 1;
                }
                If (AM.PromotionCode == 2)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteRook);
                    Glob.WhiteRookCount += 1;
                    Glob.WhiteNonQueenMajorMinorCount += 1;
                }
                If (AM.PromotionCode == 3)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteBishop);
                    Glob.WhiteNonQueenMajorMinorCount += 1;
                }
                If (AM.PromotionCode == 4)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteKnight);
                    Glob.WhiteNonQueenMajorMinorCount += 1;
                }
                Glob.WhitePawnCount += -1;
            }
            If (AM.TargetIdx > 56)
            {
                AM.PromotionCode = (Operator.LetterOf(AM.Move, Variable.Length(AM.Move)) + 0);
                If (AM.PromotionCode == 1)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackQueen);
                    Glob.BlackQueenCount += 1;
                }
                If (AM.PromotionCode == 2)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackRook);
                    Glob.BlackRookCount += 1;
                    Glob.BlackNonQueenMajorMinorCount += 1;
                }
                If (AM.PromotionCode == 3)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackBishop);
                    Glob.BlackNonQueenMajorMinorCount += 1;
                }
                If (AM.PromotionCode == 4)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackKnight);
                    Glob.BlackNonQueenMajorMinorCount += 1;
                }
                Glob.BlackPawnCount += -1;
            }
            If ((AM.TargetIdx < 9) Or (AM.TargetIdx > 56))
            {
                Call //("promotions => Zobrist hash update");
                Call GetPiecePosHash(AM.SourcePiece)(AM.TargetIdx);
                Glob.CurrentBoardHash = (Glob.CurrentBoardHash - Ret.GetPiecePosHash.Hash);
                If (Not ((abs(AM.SourcePiece) == GoK_BlackPawn)))
                {
                    If (AM.SourcePiece > 0)
                    {
                        Glob.NonPawnHashBlack = (Glob.NonPawnHashBlack - Ret.GetPiecePosHash.Hash);
                    }
                    Else
                    {
                        Glob.NonPawnHashWhite = (Glob.NonPawnHashWhite - Ret.GetPiecePosHash.Hash);
                    }
                }
                Glob.KPHash = (Glob.KPHash - Ret.GetPiecePosHash.Hash);
                List.ReplaceItem(Board, AM.TargetIdx, PromotionPieces[Ply]);
                Call GetPiecePosHash(PromotionPieces[Ply])(AM.TargetIdx);
                Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
                If (Not ((abs(PromotionPieces[Ply]) == GoK_BlackPawn)))
                {
                    If (PromotionPieces[Ply] > 0)
                    {
                        Glob.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
                    }
                    Else
                    {
                        Glob.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
                    }
                }
            }
        }
        Call //("King or rook move => update castling meta state");
        If (AM.SourcePiece == GoK_BlackKing)
        {
            Glob.BlackKingIdx = AM.TargetIdx;
            Glob.KPHash += MoveToHash[AM.MoveKey];
            Call SetCastlingStateFlag(Ply)(2)(1);
        }
        If (AM.SourcePiece == GoK_BlackRook)
        {
            If ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 3) == 0))
            {
                If (AM.SourceIdx == 8)
                {
                    Call SetCastlingStateFlag(Ply)(3)(1);
                }
            }
            If ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 4) == 0))
            {
                If (AM.SourceIdx == 1)
                {
                    Call SetCastlingStateFlag(Ply)(4)(1);
                }
            }
        }
        If (AM.SourcePiece == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = AM.TargetIdx;
            Glob.KPHash += MoveToHash[AM.MoveKey];
            Call SetCastlingStateFlag(Ply)(6)(1);
        }
        If (AM.SourcePiece == GoK_WhiteRook)
        {
            If ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 7) == 0))
            {
                If (AM.SourceIdx == 64)
                {
                    Call SetCastlingStateFlag(Ply)(7)(1);
                }
            }
            If ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 8) == 0))
            {
                If (AM.SourceIdx == 57)
                {
                    Call SetCastlingStateFlag(Ply)(8)(1);
                }
            }
        }
        If (Not ((AM.TargetPiece == 0)))
        {
            If (AM.TargetPiece == GoK_WhiteRook)
            {
                If (AM.TargetIdx == 64)
                {
                    Call SetCastlingStateFlag(Ply)(7)(1);
                }
                If (AM.TargetIdx == 57)
                {
                    Call SetCastlingStateFlag(Ply)(8)(1);
                }
            }
            If (AM.TargetPiece == GoK_BlackRook)
            {
                If (AM.TargetIdx == 8)
                {
                    Call SetCastlingStateFlag(Ply)(3)(1);
                }
                If (AM.TargetIdx == 1)
                {
                    Call SetCastlingStateFlag(Ply)(4)(1);
                }
            }
            Call //("Captures => incremental positional eval and Zobrist hash update");
            AM.MoveKey = ((((PlySign[(Ply + 1)] + 1) * 30000) + (PieceIdxLookup[abs(AM.TargetPiece)] * 10000)) + (TargetPiecesIdx[Ply] * 100));
            Glob.CurrentBoardHash += MoveToHash[AM.MoveKey];
            If (Not ((abs(AM.TargetPiece) == GoK_BlackPawn)))
            {
                If (AM.TargetPiece > 0)
                {
                    Glob.NonPawnHashBlack += MoveToHash[AM.MoveKey];
                }
                Else
                {
                    Glob.NonPawnHashWhite += MoveToHash[AM.MoveKey];
                }
            }
            If ((abs(AM.TargetPiece) == GoK_BlackPawn) Or (abs(AM.TargetPiece) == GoK_BlackKing))
            {
                Glob.KPHash += MoveToHash[AM.MoveKey];
            }
            If (AM.TargetPiece > 0)
            {
                If (AM.TargetPiece == GoK_BlackPawn)
                {
                    Glob.BlackPawnCount += -1;
                }
                Else
                {
                    If (AM.TargetPiece < GoK_BlackQueen)
                    {
                        Glob.BlackNonQueenMajorMinorCount += -1;
                        If (AM.TargetPiece == GoK_BlackRook)
                        {
                            Glob.BlackRookCount += -1;
                        }
                    }
                    Else
                    {
                        If (AM.TargetPiece == GoK_BlackQueen)
                        {
                            Glob.BlackQueenCount += -1;
                        }
                    }
                }
            }
            Else
            {
                If (AM.TargetPiece == GoK_WhitePawn)
                {
                    Glob.WhitePawnCount += -1;
                }
                Else
                {
                    If (AM.TargetPiece > GoK_WhiteQueen)
                    {
                        Glob.WhiteNonQueenMajorMinorCount += -1;
                        If (AM.TargetPiece == GoK_WhiteRook)
                        {
                            Glob.WhiteRookCount += -1;
                        }
                    }
                    Else
                    {
                        If (AM.TargetPiece == GoK_WhiteQueen)
                        {
                            Glob.WhiteQueenCount += -1;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        Call //("Castling => incremental positional eval and Zobrist hash update");
        If (AM.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_WhiteRook);
            List.ReplaceItem(Board, 63, GoK_WhiteKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.WhiteKingIdx = 63;
            Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(63)((1 == 0))(Ply);
            Call UpdateMoveHashPosEval(GoK_WhiteRook)(64)(62)((1 == 1))(Ply);
            Call SetCastlingStateFlag(Ply)(5)(1);
        }
        Else
        {
            If (AM.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_WhiteKing);
                List.ReplaceItem(Board, 60, GoK_WhiteRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.WhiteKingIdx = 59;
                Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(59)((1 == 0))(Ply);
                Call UpdateMoveHashPosEval(GoK_WhiteRook)(57)(60)((1 == 1))(Ply);
                Call SetCastlingStateFlag(Ply)(5)(1);
            }
            Else
            {
                If (AM.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_BlackRook);
                    List.ReplaceItem(Board, 7, GoK_BlackKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.BlackKingIdx = 7;
                    Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(7)((1 == 0))(Ply);
                    Call UpdateMoveHashPosEval(GoK_BlackRook)(8)(6)((1 == 1))(Ply);
                    Call SetCastlingStateFlag(Ply)(1)(1);
                }
                Else
                {
                    If (AM.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_BlackKing);
                        List.ReplaceItem(Board, 4, GoK_BlackRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.BlackKingIdx = 3;
                        Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(3)((1 == 0))(Ply);
                        Call UpdateMoveHashPosEval(GoK_BlackRook)(1)(4)((1 == 1))(Ply);
                        Call SetCastlingStateFlag(Ply)(1)(1);
                    }
                }
            }
        }
    }
    If UpdateNNUE
    {
        Call UpdateNNUEPostApplyMove(Ply);
    }
    If (Not ((AppliedMove[Ply] == 0)))
    {
        If ((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 0))
        {
            Glob.NodeCount += 1;
        }
        Else
        {
            Glob.NodeCountQuiescence += 1;
        }
    }
    If (Not ((CastlingState[Ply] == Const.Null)))
    {
        If ((Operator.LetterOf(CastlingState[Ply], 1) == 1) Or ((Operator.LetterOf(CastlingState[Ply], 2) == 1) Or ((Operator.LetterOf(CastlingState[Ply], 3) == 1) And (Operator.LetterOf(CastlingState[Ply], 4) == 1))))
        {
            Call SetCastlingStateFlag(Ply)(1)(1);
            Call SetCastlingStateFlag(Ply)(2)(1);
            Call SetCastlingStateFlag(Ply)(3)(1);
            Call SetCastlingStateFlag(Ply)(4)(1);
        }
        If ((Operator.LetterOf(CastlingState[Ply], 5) == 1) Or ((Operator.LetterOf(CastlingState[Ply], 6) == 1) Or ((Operator.LetterOf(CastlingState[Ply], 7) == 1) And (Operator.LetterOf(CastlingState[Ply], 8) == 1))))
        {
            Call SetCastlingStateFlag(Ply)(5)(1);
            Call SetCastlingStateFlag(Ply)(6)(1);
            Call SetCastlingStateFlag(Ply)(7)(1);
            Call SetCastlingStateFlag(Ply)(8)(1);
        }
    }
}

Define ApplyMoveLight(string Ply) (warp=true)
{
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.CurrentBoardHash);
    Call GetCurrentMove(Ply);
    AML.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, AML.Move);
    AML.SourceIdx = floor((AML.Move / 100));
    If (AML.SourceIdx > 0)
    {
        AML.TargetIdx = floor((AML.Move % 100));
        AML.SourcePiece = (Board[AML.SourceIdx] + 0);
        AML.TargetPiece = (Board[AML.TargetIdx] + 0);
        List.ReplaceItem(SourcePieces, Ply, AML.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, AML.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, AML.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, AML.TargetIdx, AML.SourcePiece);
        List.ReplaceItem(Board, AML.SourceIdx, 0);
        If (AML.SourcePiece == GoK_BlackKing)
        {
            Glob.BlackKingIdx = AML.TargetIdx;
        }
        If (AML.SourcePiece == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = AML.TargetIdx;
        }
        AML.MoveToHashIdx = ((PieceIdxLookup[abs(AML.SourcePiece)] * 10000) + ((AML.SourceIdx * 100) + AML.TargetIdx));
        If (AML.SourcePiece > 0)
        {
            AML.MoveToHashIdx += 60000;
        }
        Glob.CurrentBoardHash += MoveToHash[AML.MoveToHashIdx];
        If (Not ((AML.TargetPiece == 0)))
        {
            AML.MoveToHashIdx = ((PieceIdxLookup[abs(AML.TargetPiece)] * 10000) + (AML.TargetIdx * 100));
            If (AML.TargetPiece > 0)
            {
                AML.MoveToHashIdx += 60000;
            }
            Glob.CurrentBoardHash += MoveToHash[AML.MoveToHashIdx];
        }
        If (((abs(AML.SourcePiece) == GoK_BlackPawn) And (AML.TargetPiece == 0)) And (Not ((IdxToFile[AML.SourceIdx] == IdxToFile[AML.TargetIdx]))))
        {
            If (AML.SourcePiece > 0)
            {
                AML.EnPassantSquare = (AML.TargetIdx - 8);
            }
            Else
            {
                AML.EnPassantSquare = (AML.TargetIdx + 8);
            }
            AML.EnPassantCaptured = (Board[AML.EnPassantSquare] + 0);
            List.ReplaceItem(TargetPiecesIdx, Ply, AML.EnPassantSquare);
            List.ReplaceItem(TargetPieces, Ply, AML.EnPassantCaptured);
            List.ReplaceItem(Board, AML.EnPassantSquare, 0);
            AML.MoveToHashIdx = ((PieceIdxLookup[abs(AML.EnPassantCaptured)] * 10000) + (AML.EnPassantSquare * 100));
            If (AML.EnPassantCaptured > 0)
            {
                AML.MoveToHashIdx = (AML.MoveToHashIdx + 60000);
            }
            Glob.CurrentBoardHash = (Glob.CurrentBoardHash + MoveToHash[AML.MoveToHashIdx]);
        }
    }
    Else
    {
        List.ReplaceItem(SourcePieces, Ply, 0);
        List.ReplaceItem(TargetPiecesIdx, Ply, 0);
        List.ReplaceItem(TargetPieces, Ply, 0);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        Call //("Castling => incremental positional eval and Zobrist hash update");
        If (AML.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_WhiteRook);
            List.ReplaceItem(Board, 63, GoK_WhiteKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.WhiteKingIdx = 63;
            Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(63)((1 == 0))(Ply);
            Call UpdateMoveHashPosEval(GoK_WhiteRook)(64)(62)((1 == 1))(Ply);
            Call SetCastlingStateFlag(Ply)(5)(1);
        }
        Else
        {
            If (AML.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_WhiteKing);
                List.ReplaceItem(Board, 60, GoK_WhiteRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.WhiteKingIdx = 59;
                Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(59)((1 == 0))(Ply);
                Call UpdateMoveHashPosEval(GoK_WhiteRook)(57)(60)((1 == 1))(Ply);
                Call SetCastlingStateFlag(Ply)(5)(1);
            }
            Else
            {
                If (AML.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_BlackRook);
                    List.ReplaceItem(Board, 7, GoK_BlackKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.BlackKingIdx = 7;
                    Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(7)((1 == 0))(Ply);
                    Call UpdateMoveHashPosEval(GoK_BlackRook)(8)(6)((1 == 1))(Ply);
                    Call SetCastlingStateFlag(Ply)(1)(1);
                }
                Else
                {
                    If (AML.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_BlackKing);
                        List.ReplaceItem(Board, 4, GoK_BlackRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.BlackKingIdx = 3;
                        Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(3)((1 == 0))(Ply);
                        Call UpdateMoveHashPosEval(GoK_BlackRook)(1)(4)((1 == 1))(Ply);
                        Call SetCastlingStateFlag(Ply)(1)(1);
                    }
                }
            }
        }
    }
}

Define AskTimeControl (warp=false)
{
    Ret.AskTimeControl.IsSet = 0;
    Event.BroadcastAndWait("GoK_AskTime");
    TimeKey.Answer = Sensing.Answer();
    TimeKey.SlashIdx = 0;
    TimeKey.PlusIdx = 0;
    TimeKey.CharIdx = 1;
    Repeat (Variable.Length(TimeKey.Answer))
    {
        If (Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx) == "/")
        {
            TimeKey.SlashIdx = TimeKey.CharIdx;
        }
        If (Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx) == "+")
        {
            TimeKey.PlusIdx = TimeKey.CharIdx;
        }
        TimeKey.CharIdx += 1;
    }
    TimeKey.IsValid = 1;
    TimeKey.CharIdx = 1;
    Repeat (Variable.Length(TimeKey.Answer))
    {
        If (Not (Operator.Contains("0123456789./+", Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx))))
        {
            If (Not (((TimeKey.CharIdx == 1) And (Operator.LetterOf(TimeKey.Answer, 1) == "e"))))
            {
                TimeKey.IsValid = 0;
            }
        }
        TimeKey.CharIdx += 1;
    }
    If ((Operator.LetterOf(TimeKey.Answer, 1) == "e") And ((TimeKey.SlashIdx > 0) Or (TimeKey.PlusIdx > 0)))
    {
        TimeKey.IsValid = 0;
    }
    If ((TimeKey.PlusIdx > 0) And ((TimeKey.SlashIdx == 0) Or (TimeKey.PlusIdx < TimeKey.SlashIdx)))
    {
        TimeKey.IsValid = 0;
    }
    If (Variable.Length(TimeKey.Answer) == 0)
    {
        TimeKey.IsValid = 0;
    }
    If (TimeKey.IsValid == 1)
    {
        If (TimeKey.SlashIdx > 0)
        {
            TimeKey.Part = "";
            TimeKey.CharIdx = 1;
            Repeat ((TimeKey.SlashIdx - 1))
            {
                TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                TimeKey.CharIdx += 1;
            }
            If (TimeKey.Part == "")
            {
                Glob.InitialClockTime = 0;
            }
            Else
            {
                Glob.InitialClockTime = TimeKey.Part;
            }
            If (TimeKey.PlusIdx > TimeKey.SlashIdx)
            {
                TimeKey.Part = "";
                TimeKey.CharIdx = (TimeKey.SlashIdx + 1);
                Repeat (((TimeKey.PlusIdx - TimeKey.SlashIdx) - 1))
                {
                    TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                    TimeKey.CharIdx += 1;
                }
                If (TimeKey.Part == "")
                {
                    Glob.ClockStageMoves = 0;
                }
                Else
                {
                    Glob.ClockStageMoves = TimeKey.Part;
                }
                TimeKey.Part = "";
                TimeKey.CharIdx = (TimeKey.PlusIdx + 1);
                Repeat ((Variable.Length(TimeKey.Answer) - TimeKey.PlusIdx))
                {
                    TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                    TimeKey.CharIdx += 1;
                }
                If (TimeKey.Part == "")
                {
                    Glob.ClockStageTime = 0;
                }
                Else
                {
                    Glob.ClockStageTime = TimeKey.Part;
                }
                Glob.ClockTimeInc = 0;
            }
            Else
            {
                TimeKey.Part = "";
                TimeKey.CharIdx = (TimeKey.SlashIdx + 1);
                Repeat ((Variable.Length(TimeKey.Answer) - TimeKey.SlashIdx))
                {
                    TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                    TimeKey.CharIdx += 1;
                }
                If (TimeKey.Part == "")
                {
                    Glob.ClockTimeInc = 0;
                }
                Else
                {
                    Glob.ClockTimeInc = TimeKey.Part;
                }
                Glob.ClockStageMoves = 0;
                Glob.ClockStageTime = 0;
            }
            Glob.CurrentClockTime = Glob.InitialClockTime;
            Glob.CustomThinkTime = 0;
            Glob.CustomMaxDepth = 0;
            Glob.TimeControl = 1;
            Glob.PlayerClockTime = Glob.InitialClockTime;
            Glob.PlayerClockMoveCount = 0;
            Ret.AskTimeControl.IsSet = 1;
            Glob.ClockMoveCount = 0;
            If (Glob.InitialClockTime == 0)
            {
                Glob.CustomThinkTime = Glob.ClockTimeInc;
                Glob.ClockTimeInc = 0;
                Glob.TimeControl = 0;
            }
        }
        Else
        {
            If (Not ((TimeKey.Answer == "")))
            {
                If (Operator.LetterOf(TimeKey.Answer, 1) == "e")
                {
                    TimeKey.Part = "";
                    TimeKey.CharIdx = 2;
                    Repeat ((Variable.Length(TimeKey.Answer) - 1))
                    {
                        TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                        TimeKey.CharIdx += 1;
                    }
                    Glob.InitialClockTime = 0;
                    Glob.ClockTimeInc = 0;
                    Glob.ClockStageMoves = 0;
                    Glob.ClockStageTime = 0;
                    Glob.CustomThinkTime = TimeKey.Part;
                    Glob.CustomMaxDepth = 0;
                    Glob.TimeControl = 0;
                    Glob.CurrentClockTime = 0;
                    Glob.ClockMoveCount = 0;
                    Glob.PlayerClockTime = 0;
                    Glob.PlayerClockMoveCount = 0;
                    Ret.AskTimeControl.IsSet = 1;
                }
                Else
                {
                    Glob.InitialClockTime = TimeKey.Answer;
                    Glob.ClockTimeInc = 0;
                    Glob.ClockStageMoves = 0;
                    Glob.ClockStageTime = 0;
                    Glob.CustomThinkTime = 0;
                    Glob.CustomMaxDepth = 0;
                    Glob.TimeControl = 1;
                    Glob.CurrentClockTime = Glob.InitialClockTime;
                    Glob.ClockMoveCount = 0;
                    Glob.PlayerClockTime = Glob.InitialClockTime;
                    Glob.PlayerClockMoveCount = 0;
                    Ret.AskTimeControl.IsSet = 1;
                }
            }
        }
        TimeKey.IsValid = 1;
        If (Glob.TimeControl == 1)
        {
            If (Not ((Glob.InitialClockTime > 0)))
            {
                TimeKey.IsValid = 0;
            }
            If (Not ((Glob.InitialClockTime == (Glob.InitialClockTime + 0))))
            {
                TimeKey.IsValid = 0;
            }
            If (Not ((Glob.ClockTimeInc == (Glob.ClockTimeInc + 0))))
            {
                TimeKey.IsValid = 0;
            }
            If (Not ((Glob.ClockStageMoves == (Glob.ClockStageMoves + 0))))
            {
                TimeKey.IsValid = 0;
            }
            If (Not ((Glob.ClockStageTime == (Glob.ClockStageTime + 0))))
            {
                TimeKey.IsValid = 0;
            }
        }
        Else
        {
            If (Not ((Glob.CustomThinkTime > 0)))
            {
                TimeKey.IsValid = 0;
            }
            If (Not ((Glob.CustomThinkTime == (Glob.CustomThinkTime + 0))))
            {
                TimeKey.IsValid = 0;
            }
        }
        If (TimeKey.IsValid == 0)
        {
            Glob.InitialClockTime = 0;
            Glob.ClockTimeInc = 0;
            Glob.ClockStageMoves = 0;
            Glob.ClockStageTime = 0;
            Glob.CustomThinkTime = 0;
            Glob.CustomMaxDepth = 0;
            Glob.TimeControl = 0;
            Glob.CurrentClockTime = 0;
            Glob.ClockMoveCount = 0;
            Glob.PlayerClockTime = 0;
            Glob.PlayerClockMoveCount = 0;
            Ret.AskTimeControl.IsSet = 0;
            Call SayAsync("Invalid clock format")(6);
        }
    }
    Else
    {
        If (Not ((Variable.Length(TimeKey.Answer) == 0)))
        {
            Call SayAsync("Invalid clock format")(6);
        }
        Ret.AskTimeControl.IsSet = 0;
    }
}

Define CalcBoardAttackedByMove(string Ply) (warp=true)
{
    Call ClearBoardAttackedByMove(Ply);
    Call GenerateMovesImplWrapper(Ply)((1 == 1))((1 == 0));
}

Define CalcBoardAttackedByMoveChecked(string CheckingPly) (warp=true)
{
    CBABMC.IsChecked = 0;
    CBABMC.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    CBABMC.SqIdx = 1;
    Repeat (64)
    {
        If ((Board[CBABMC.SqIdx] * CBABMC.Factor) > 0)
        {
            Call IsCheckingPiece(CBABMC.SqIdx);
            If (Ret.IsCheckingPiece.IsChecking == 1)
            {
                CBABMC.IsChecked = 1;
            }
        }
        CBABMC.SqIdx += 1;
    }
    If (PlyIsOwn[CheckingPly] == 1)
    {
        Glob.IsWhiteChecked = CBABMC.IsChecked;
    }
    Else
    {
        Glob.IsBlackChecked = CBABMC.IsChecked;
    }
}

Define CalcBoardAttackedOnDemand(string Ply)(bool Quiescence)(bool ForceOnCheck)(string Horizon) (warp=true)
{
    If (BoardAttackedCalculated[Ply] == 0)
    {
        If ((ForceOnCheck And (CheckedState[Ply] == 1)) Or ((Not (Quiescence)) And (Not ((Ply > Horizon)))))
        {
            Call CalcBoardAttackedByMove((Ply + 1));
            Call StoreAttackInfo(Ply);
            List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
        }
    }
}

Define CalcBoardStats (warp=true)
{
    Glob.BlackKingIdx = Const.Null;
    Glob.WhiteKingIdx = Const.Null;
    Glob.CurrentBoardHash = 0;
    Glob.NonPawnHashBlack = 0;
    Glob.NonPawnHashWhite = 0;
    Glob.KPHash = 0;
    CBS.SqIdx = 1;
    Repeat (8)
    {
        List.ReplaceItem(PawnCount, (CBS.SqIdx + 8), 0);
        List.ReplaceItem(PawnCount, CBS.SqIdx, 0);
        CBS.SqIdx += 1;
    }
    CBS.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CBS.SqIdx] == GoK_WhitePawn)
        {
            List.ReplaceItem(PawnCount, IdxToFile[CBS.SqIdx], (PawnCount[IdxToFile[CBS.SqIdx]] + 1));
        }
        Else
        {
            If (Board[CBS.SqIdx] == GoK_BlackPawn)
            {
                List.ReplaceItem(PawnCount, (IdxToFile[CBS.SqIdx] + 8), (PawnCount[(IdxToFile[CBS.SqIdx] + 8)] + 1));
            }
            Else
            {
                If (Board[CBS.SqIdx] == GoK_WhiteKing)
                {
                    Glob.WhiteKingIdx = CBS.SqIdx;
                }
                Else
                {
                    If (Board[CBS.SqIdx] == GoK_BlackKing)
                    {
                        Glob.BlackKingIdx = CBS.SqIdx;
                    }
                }
            }
        }
        Call GetPiecePosHash(Board[CBS.SqIdx])(CBS.SqIdx);
        Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CBS.SqIdx]) == GoK_BlackPawn)))
        {
            If (Board[CBS.SqIdx] > 0)
            {
                Glob.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CBS.SqIdx]) == GoK_BlackPawn) Or (abs(Board[CBS.SqIdx]) == GoK_BlackKing))
        {
            Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CBS.SqIdx += 1;
    }
    Glob.RootBlackNonQueenMajorMinorCount = 0;
    Glob.RootBlackQueenCount = 0;
    Glob.RootBlackPawnCount = 0;
    CBS.BlackRookCount = 0;
    Glob.RootWhiteQueenCount = 0;
    Glob.RootWhiteNonQueenMajorMinorCount = 0;
    Glob.RootWhitePawnCount = 0;
    CBS.WhiteRookCount = 0;
    CBS.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CBS.SqIdx] == GoK_WhiteQueen)
        {
            Glob.RootWhiteQueenCount += 1;
        }
        If (Board[CBS.SqIdx] == GoK_BlackQueen)
        {
            Glob.RootBlackQueenCount += 1;
        }
        If ((Board[CBS.SqIdx] == GoK_WhiteKnight) Or ((Board[CBS.SqIdx] == GoK_WhiteBishop) Or (Board[CBS.SqIdx] == GoK_WhiteRook)))
        {
            Glob.RootWhiteNonQueenMajorMinorCount += 1;
            If (Board[CBS.SqIdx] == GoK_WhiteRook)
            {
                CBS.WhiteRookCount += 1;
            }
        }
        If ((Board[CBS.SqIdx] == GoK_BlackKnight) Or ((Board[CBS.SqIdx] == GoK_BlackBishop) Or (Board[CBS.SqIdx] == GoK_BlackRook)))
        {
            Glob.RootBlackNonQueenMajorMinorCount += 1;
            If (Board[CBS.SqIdx] == GoK_BlackRook)
            {
                CBS.BlackRookCount += 1;
            }
        }
        If (Board[CBS.SqIdx] == GoK_WhitePawn)
        {
            Glob.RootWhitePawnCount += 1;
        }
        If (Board[CBS.SqIdx] == GoK_BlackPawn)
        {
            Glob.RootBlackPawnCount += 1;
        }
        CBS.SqIdx += 1;
    }
    Glob.IsClassicEndgameEval = 0;
    If (((((Glob.RootBlackPawnCount + Glob.RootBlackQueenCount) + Glob.RootBlackNonQueenMajorMinorCount) + CBS.BlackRookCount) == 0) And ((Glob.RootWhiteQueenCount + Glob.RootWhiteNonQueenMajorMinorCount) > 0))
    {
        Glob.IsClassicEndgameEval = 1;
    }
    If (((((Glob.RootWhitePawnCount + Glob.RootWhiteQueenCount) + Glob.RootWhiteNonQueenMajorMinorCount) + CBS.WhiteRookCount) == 0) And ((Glob.RootBlackQueenCount + Glob.RootBlackNonQueenMajorMinorCount) > 0))
    {
        Glob.IsClassicEndgameEval = 1;
    }
    If ((((Glob.RootWhitePawnCount + Glob.RootBlackPawnCount) == 0) And ((Glob.RootWhiteQueenCount == 1) And (Glob.RootWhiteNonQueenMajorMinorCount == 0))) And ((Glob.RootBlackQueenCount == 0) And ((CBS.BlackRookCount == 1) And (Glob.RootBlackNonQueenMajorMinorCount == 1))))
    {
        Glob.IsClassicEndgameEval = 1;
    }
    If ((((Glob.RootWhitePawnCount + Glob.RootBlackPawnCount) == 0) And ((Glob.RootBlackQueenCount == 1) And (Glob.RootBlackNonQueenMajorMinorCount == 0))) And ((Glob.RootWhiteQueenCount == 0) And ((CBS.WhiteRookCount == 1) And (Glob.RootWhiteNonQueenMajorMinorCount == 1))))
    {
        Glob.IsClassicEndgameEval = 1;
    }
    If ((((Glob.RootWhiteQueenCount + Glob.RootWhiteNonQueenMajorMinorCount) + (Glob.RootBlackQueenCount + Glob.RootBlackNonQueenMajorMinorCount)) < 3) And ((Glob.RootWhiteQueenCount == 0) Or (Glob.RootBlackQueenCount == 0)))
    {
        Glob.IsLateEndgame = 1;
        Glob.IsEndgame = 1;
    }
    Else
    {
        If ((((Glob.RootWhiteQueenCount * 9) + (Glob.RootWhiteNonQueenMajorMinorCount * 4)) < 10) Or (((Glob.RootBlackQueenCount * 9) + (Glob.RootBlackNonQueenMajorMinorCount * 4)) < 10))
        {
            Glob.IsLateEndgame = 0;
            Glob.IsEndgame = 1;
        }
        Else
        {
            Glob.IsLateEndgame = 0;
            Glob.IsEndgame = 0;
        }
    }
    If ((Glob.HasBlackCastled == 0) And ((Glob.HasBlackKingMoved == 0) And ((Glob.HasBlackRookKSMoved == 0) Or (Glob.HasBlackRookQSMoved == 0))))
    {
        Glob.IsBlackCastlingPossible = 1;
    }
    Else
    {
        Glob.IsBlackCastlingPossible = 0;
    }
    If ((Glob.HasWhiteCastled == 0) And ((Glob.HasWhiteKingMoved == 0) And ((Glob.HasWhiteRookKSMoved == 0) Or (Glob.HasWhiteRookQSMoved == 0))))
    {
        Glob.IsWhiteCastlingPossible = 1;
    }
    Else
    {
        Glob.IsWhiteCastlingPossible = 0;
    }
    Glob.WhiteQueenCount = Glob.RootWhiteQueenCount;
    Glob.WhiteNonQueenMajorMinorCount = Glob.RootWhiteNonQueenMajorMinorCount;
    Glob.BlackQueenCount = Glob.RootBlackQueenCount;
    Glob.BlackNonQueenMajorMinorCount = Glob.RootBlackNonQueenMajorMinorCount;
    Glob.WhiteRookCount = CBS.WhiteRookCount;
    Glob.BlackRookCount = CBS.BlackRookCount;
    Glob.WhitePawnCount = Glob.RootWhitePawnCount;
    Glob.BlackPawnCount = Glob.RootBlackPawnCount;
    List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    List.ReplaceItem(CastlingState, 2, CastlingState[1]);
}

Define ClearBoardAttackedByMove(num Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 1)
    {
        List.DeleteAll(BoardAttackedByBlack);
        List.DeleteAll(BoardAttackedByBlackPiece);
        Repeat (64)
        {
            List.Add(BoardAttackedByBlack, 0);
            List.Add(BoardAttackedByBlackPiece, 0);
        }
        Glob.IsWhiteChecked = 0;
    }
    Else
    {
        List.DeleteAll(BoardAttackedByWhite);
        List.DeleteAll(BoardAttackedByWhitePiece);
        Repeat (64)
        {
            List.Add(BoardAttackedByWhite, 0);
            List.Add(BoardAttackedByWhitePiece, 0);
        }
        Glob.IsBlackChecked = 0;
    }
}

Define ClearMoveList(num Ply) (warp=true)
{
    List.ReplaceItem(MovesCount, Ply, 0);
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
    }
    Else
    {
        If (Ply == 2)
        {
            List.DeleteAll(Moves2);
        }
    }
}

Define ClearTT (warp=true)
{
    If (Glob.IsScratch3 == 1)
    {
        Call ClearTTImpl(65536);
    }
    Else
    {
        Call ClearTTImpl(1048576);
    }
}

Define ClearTTImpl(string Size) (warp=true)
{
    List.DeleteItem(TTNodeEntry, all);
    Repeat (Size)
    {
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
    }
}

Define CreateCurrentBoardHash (warp=true)
{
    Glob.CurrentBoardHash = 0;
    Glob.NonPawnHashBlack = 0;
    Glob.NonPawnHashWhite = 0;
    Glob.KPHash = 0;
    CCBH.SqIdx = 1;
    Repeat (64)
    {
        Call GetPiecePosHash(Board[CCBH.SqIdx])(CCBH.SqIdx);
        Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CCBH.SqIdx]) == GoK_BlackPawn)))
        {
            If (Board[CCBH.SqIdx] > 0)
            {
                Glob.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CCBH.SqIdx]) == GoK_BlackPawn) Or (abs(Board[CCBH.SqIdx]) == GoK_BlackKing))
        {
            Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CCBH.SqIdx += 1;
    }
}

Define DrawBoardAndWait (warp=false)
{
    Call StoreExternalBoard;
    List.DeleteAll(GoK_ScreenBoard);
    DBW.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_ScreenBoard, Board[GoK_ScreenIdx[DBW.SqIdx]]);
        DBW.SqIdx += 1;
    }
    If (Glob.IsDCI == 0)
    {
        GoK_ProgressValue = 0;
        Event.BroadcastAndWait("Pieces_DrawBoard");
        Event.BroadcastAndWait("GoK_ProgressValueChanged");
        Event.BroadcastAndWait("GoK_EvaluationValueChanged");
    }
}

Define EnterExecution (warp=false)
{
    Glob.ExecutionPly += 1;
    If (Glob.ExecutionPly == 1)
    {
        Glob.IsExecutionRunning = 1;
        Event.BroadcastAndWait("GoK_ModeBusy");
    }
}

Define Evaluate(string Ply)(bool ForceFullEval) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodEnter(Ply);
    }
    Ret.Evaluate.Score = Const.Null;
    If (Glob.IsClassicEndgameEval == 1)
    {
        If (Ply == 0)
        {
            Call EvaluateBoardBasic;
            Call CalcBoardAttackedByMove(2);
            Call StoreAttackInfo(1);
            If (Glob.ProfilerMode == Const.ProfilerMode.On)
            {
                Call ProfilerMethodExit(Ply);
            }
            Stop(this script);
        }
    }
    If ForceFullEval
    {
        Ret.Evaluate.Score = 0;
        If (1 == 1)
        {
            If (Glob.ProfilerMode == Const.ProfilerMode.On)
            {
                Call Profile_CountByHorizon(Const.Profile.TTStaticProbe)(HorizonAtPly[Ply])(Ply);
            }
        }
        If (Glob.IsClassicEndgameEval == 0)
        {
            Call NNUE_UpdateAccStack(Ply);
            Call NNUE_Public_Evaluate((Ply + 1));
            Ret.Evaluate.Score = Operator.Round(Ret.NNUE_Public_Evaluate.Score);
            Call EvaluatePostProcess(Ply)(Ret.Evaluate.Score);
            Ret.Evaluate.Score = Ret.EvaluatePostProcess.Score;
        }
        Else
        {
            Call EvaluateBoardBasic;
            Ret.Evaluate.Score = Ret.EvaluateBoardBasic.Score;
            Eval.Side = 0;
            If ((((Glob.BlackQueenCount + Glob.BlackNonQueenMajorMinorCount) + Glob.BlackPawnCount) == 0) And ((Glob.WhiteQueenCount + Glob.WhiteNonQueenMajorMinorCount) > 0))
            {
                Eval.Side = 2;
            }
            If ((((Glob.WhiteQueenCount + Glob.WhiteNonQueenMajorMinorCount) + Glob.WhitePawnCount) == 0) And ((Glob.BlackQueenCount + Glob.BlackNonQueenMajorMinorCount) > 0))
            {
                Eval.Side = 1;
            }
            If ((((Glob.WhitePawnCount + Glob.BlackPawnCount) == 0) And ((Glob.WhiteQueenCount == 1) And (Glob.WhiteNonQueenMajorMinorCount == 0))) And ((Glob.BlackQueenCount == 0) And ((Glob.BlackRookCount == 1) And (Glob.BlackNonQueenMajorMinorCount == 1))))
            {
                Eval.Side = 2;
            }
            If ((((Glob.WhitePawnCount + Glob.BlackPawnCount) == 0) And ((Glob.BlackQueenCount == 1) And (Glob.BlackNonQueenMajorMinorCount == 0))) And ((Glob.WhiteQueenCount == 0) And ((Glob.WhiteRookCount == 1) And (Glob.WhiteNonQueenMajorMinorCount == 1))))
            {
                Eval.Side = 1;
            }
            If (Not ((Eval.Side == 0)))
            {
                If (Eval.Side == 2)
                {
                    Eval.MateDriveBonus = (PushToEdges[Glob.BlackKingIdx] + PushClose[ChebyshevDistance[((Glob.WhiteKingIdx * 100) + Glob.BlackKingIdx)]]);
                    Eval.MateCornerBonus = 0;
                    If (((Glob.WhitePawnCount == 0) And (Glob.WhiteQueenCount == 0)) And ((Glob.WhiteRookCount == 0) And (Glob.WhiteNonQueenMajorMinorCount == 2)))
                    {
                        Eval.KBNScanIdx = 0;
                        Eval.KBNBishopCount = 0;
                        Eval.KBNBishopIdx = 0;
                        Repeat (64)
                        {
                            Eval.KBNScanIdx += 1;
                            If (Board[Eval.KBNScanIdx] == GoK_WhiteBishop)
                            {
                                Eval.KBNBishopCount += 1;
                                Eval.KBNBishopIdx = Eval.KBNScanIdx;
                            }
                        }
                        If (Eval.KBNBishopCount == 1)
                        {
                            If (((IdxToFile[Eval.KBNBishopIdx] + IdxToRank[Eval.KBNBishopIdx]) % 2) == 1)
                            {
                                Eval.MateCornerBonus = (abs((IdxToRank[Glob.BlackKingIdx] - IdxToFile[Glob.BlackKingIdx])) * 20);
                            }
                            Else
                            {
                                Eval.MateCornerBonus = (abs(((IdxToRank[Glob.BlackKingIdx] + IdxToFile[Glob.BlackKingIdx]) - 9)) * 20);
                            }
                        }
                    }
                    Eval.MateDriveBonus += Eval.MateCornerBonus;
                    Ret.Evaluate.Score += (0 - Eval.MateDriveBonus);
                }
                Else
                {
                    Eval.MateDriveBonus = (PushToEdges[Glob.WhiteKingIdx] + PushClose[ChebyshevDistance[((Glob.WhiteKingIdx * 100) + Glob.BlackKingIdx)]]);
                    Eval.MateCornerBonus = 0;
                    If (((Glob.BlackPawnCount == 0) And (Glob.BlackQueenCount == 0)) And ((Glob.BlackRookCount == 0) And (Glob.BlackNonQueenMajorMinorCount == 2)))
                    {
                        Eval.KBNScanIdx = 0;
                        Eval.KBNBishopCount = 0;
                        Eval.KBNBishopIdx = 0;
                        Repeat (64)
                        {
                            Eval.KBNScanIdx += 1;
                            If (Board[Eval.KBNScanIdx] == GoK_BlackBishop)
                            {
                                Eval.KBNBishopCount += 1;
                                Eval.KBNBishopIdx = Eval.KBNScanIdx;
                            }
                        }
                        If (Eval.KBNBishopCount == 1)
                        {
                            If (((IdxToFile[Eval.KBNBishopIdx] + IdxToRank[Eval.KBNBishopIdx]) % 2) == 1)
                            {
                                Eval.MateCornerBonus = (abs((IdxToRank[Glob.WhiteKingIdx] - IdxToFile[Glob.WhiteKingIdx])) * 20);
                            }
                            Else
                            {
                                Eval.MateCornerBonus = (abs(((IdxToRank[Glob.WhiteKingIdx] + IdxToFile[Glob.WhiteKingIdx]) - 9)) * 20);
                            }
                        }
                    }
                    Eval.MateDriveBonus += Eval.MateCornerBonus;
                    Ret.Evaluate.Score += Eval.MateDriveBonus;
                }
            }
            Call EvaluatePostProcess(Ply)(Ret.Evaluate.Score);
            Ret.Evaluate.Score = Ret.EvaluatePostProcess.Score;
        }
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodExit(Ply);
    }
}

Define EvaluateBoardBasic (warp=true)
{
    Eval.BB.SqIdx = 1;
    Ret.EvaluateBoardBasic.Score = 0;
    Repeat (64)
    {
        Eval.BB.Piece = (Board[Eval.BB.SqIdx] + 0);
        If (Not ((Eval.BB.Piece == 0)))
        {
            Ret.EvaluateBoardBasic.Score += Eval.BB.Piece;
            Call GetPiecePosEval(Eval.BB.Piece)(Eval.BB.SqIdx);
            Ret.EvaluateBoardBasic.Score += Ret.GetPiecePosEval.Score;
        }
        Eval.BB.SqIdx += 1;
    }
}

Define EvaluatePostProcess(string Ply)(string Score) (warp=true)
{
    Ret.EvaluatePostProcess.Score = Score;
    Call //("Early promotion detection via Rule-of-Squares / Chebyshev distance");
    If (((Glob.WhiteQueenCount + Glob.WhiteNonQueenMajorMinorCount) == 0) And ((Glob.BlackQueenCount + Glob.BlackNonQueenMajorMinorCount) == 0))
    {
        List.DeleteItem(PawnCount, all);
        Repeat (8)
        {
            List.Add(PawnCount, 0);
        }
        Repeat (8)
        {
            List.Add(PawnCount, 0);
        }
        List.DeleteItem(PawnAdvancePerFile, all);
        Repeat (32)
        {
            List.Add(PawnAdvancePerFile, 0);
        }
        Eval.PP.Idx = 1;
        Repeat (64)
        {
            Eval.PP.SourcePiece = (Board[Eval.PP.Idx] + 0);
            If (Eval.PP.SourcePiece == GoK_BlackPawn)
            {
                Eval.PP.File = (IdxToFile[Eval.PP.Idx] + 0);
                Eval.PP.Rank = (IdxToRank[Eval.PP.Idx] + 0);
                List.ReplaceItem(PawnCount, (Eval.PP.File + 8), (PawnCount[(Eval.PP.File + 8)] + 1));
                If ((PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.BlackRear)] == 0) Or (Eval.PP.Rank < PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.BlackRear)]))
                {
                    List.ReplaceItem(PawnAdvancePerFile, (Eval.PP.File + Const.PawnAdvance.BlackRear), Eval.PP.Rank);
                }
                If (Eval.PP.Rank > PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.BlackFront)])
                {
                    List.ReplaceItem(PawnAdvancePerFile, (Eval.PP.File + Const.PawnAdvance.BlackFront), Eval.PP.Rank);
                }
            }
            If (Eval.PP.SourcePiece == GoK_WhitePawn)
            {
                Eval.PP.File = (IdxToFile[Eval.PP.Idx] + 0);
                Eval.PP.Rank = (IdxToRank[Eval.PP.Idx] + 0);
                List.ReplaceItem(PawnCount, Eval.PP.File, (PawnCount[Eval.PP.File] + 1));
                If (Eval.PP.Rank > PawnAdvancePerFile[Eval.PP.File])
                {
                    List.ReplaceItem(PawnAdvancePerFile, Eval.PP.File, Eval.PP.Rank);
                }
                If ((PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.WhiteFront)] == 0) Or (Eval.PP.Rank < PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.WhiteFront)]))
                {
                    List.ReplaceItem(PawnAdvancePerFile, (Eval.PP.File + Const.PawnAdvance.WhiteFront), Eval.PP.Rank);
                }
            }
            Eval.PP.Idx += 1;
        }
        Eval.PP.WhiteQueener = 99;
        Eval.PP.BlackQueener = 99;
        Eval.PP.BlackFastest = 99;
        Eval.PP.WhiteFastest = 99;
        Eval.PP.Side = 1;
        Repeat (2)
        {
            If (Eval.PP.Side == 1)
            {
                Eval.PP.OurOffset = Const.PawnAdvance.BlackFront;
                Eval.PP.TheirOffset = Const.PawnAdvance.WhiteRear;
                Eval.PP.PromoBase = 56;
                Eval.PP.KingIdx = Glob.BlackKingIdx;
                Eval.PP.TheirKingIdx = Glob.WhiteKingIdx;
            }
            Else
            {
                Eval.PP.OurOffset = Const.PawnAdvance.WhiteFront;
                Eval.PP.TheirOffset = Const.PawnAdvance.BlackRear;
                Eval.PP.PromoBase = 0;
                Eval.PP.KingIdx = Glob.WhiteKingIdx;
                Eval.PP.TheirKingIdx = Glob.BlackKingIdx;
            }
            Eval.PP.Idx = 1;
            Repeat (8)
            {
                Eval.PP.OurForwardRank = PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.OurOffset)];
                If (Not ((Eval.PP.OurForwardRank == 0)))
                {
                    Eval.PP.NFwd = ((Not ((Eval.PP.OurForwardRank == 0))) * (Eval.PP.OurForwardRank + ((Eval.PP.Side == 2) * (9 - (2 * Eval.PP.OurForwardRank)))));
                    If (Eval.PP.NFwd > 1)
                    {
                        Eval.PP.NBack = ((Not ((PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.TheirOffset)] == 0))) * (PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.TheirOffset)] + ((Eval.PP.Side == 2) * (9 - (2 * PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.TheirOffset)])))));
                        If (Eval.PP.NFwd > Eval.PP.NBack)
                        {
                            Eval.PP.NAdj = ((Not ((PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) - 1)] == 0))) * (PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) - 1)] + ((Eval.PP.Side == 2) * (9 - (2 * PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) - 1)])))));
                            If ((Eval.PP.Idx == 1) Or (Not ((Eval.PP.NFwd < Eval.PP.NAdj))))
                            {
                                Eval.PP.NAdj = ((Not ((PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) + 1)] == 0))) * (PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) + 1)] + ((Eval.PP.Side == 2) * (9 - (2 * PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) + 1)])))));
                                If ((Eval.PP.Idx == 8) Or (Not ((Eval.PP.NFwd < Eval.PP.NAdj))))
                                {
                                    Eval.PP.TargetIdx = (Eval.PP.PromoBase + Eval.PP.Idx);
                                    Eval.PP.Delta = (8 - Eval.PP.NFwd);
                                    If (Eval.PP.Delta > 5)
                                    {
                                        Eval.PP.Delta = 5;
                                    }
                                    If (Eval.PP.Side == 1)
                                    {
                                        If (Eval.PP.Delta < Eval.PP.BlackFastest)
                                        {
                                            Eval.PP.BlackFastest = Eval.PP.Delta;
                                        }
                                    }
                                    Else
                                    {
                                        If (Eval.PP.Delta < Eval.PP.WhiteFastest)
                                        {
                                            Eval.PP.WhiteFastest = Eval.PP.Delta;
                                        }
                                    }
                                    If ((ChebyshevDistance[((Eval.PP.TheirKingIdx * 100) + Eval.PP.TargetIdx)] - (((Ply + Eval.PP.Side) + 1) % 2)) > Eval.PP.Delta)
                                    {
                                        Eval.PP.QueeningDelta = Eval.PP.Delta;
                                        If ((IdxToFile[Eval.PP.KingIdx] == Eval.PP.Idx) And (((Not ((IdxToRank[Eval.PP.KingIdx] == 0))) * (IdxToRank[Eval.PP.KingIdx] + ((Eval.PP.Side == 2) * (9 - (2 * IdxToRank[Eval.PP.KingIdx]))))) > Eval.PP.NFwd))
                                        {
                                            If ((Eval.PP.Idx == 1) Or (Eval.PP.Idx == 8))
                                            {
                                                Eval.PP.QueeningDelta = 99;
                                            }
                                            Else
                                            {
                                                Eval.PP.QueeningDelta += 1;
                                            }
                                        }
                                        If (Eval.PP.Side == 1)
                                        {
                                            If (Eval.PP.QueeningDelta < Eval.PP.BlackQueener)
                                            {
                                                Eval.PP.BlackQueener = Eval.PP.QueeningDelta;
                                            }
                                        }
                                        Else
                                        {
                                            If (Eval.PP.QueeningDelta < Eval.PP.WhiteQueener)
                                            {
                                                Eval.PP.WhiteQueener = Eval.PP.QueeningDelta;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Eval.PP.Idx += 1;
            }
            Eval.PP.Side += 1;
        }
        If ((Eval.PP.WhiteQueener < Eval.PP.BlackQueener) And (((2 * Eval.PP.BlackFastest) + ((Ply + 2) % 2)) > (((2 * Eval.PP.WhiteQueener) + ((Ply + 3) % 2)) + 1)))
        {
            Ret.EvaluatePostProcess.Score += ((GoK_WhiteQueen - GoK_WhitePawn) + 100);
        }
        Else
        {
            If ((Eval.PP.BlackQueener < Eval.PP.WhiteQueener) And (((2 * Eval.PP.WhiteFastest) + ((Ply + 3) % 2)) > (((2 * Eval.PP.BlackQueener) + ((Ply + 2) % 2)) + 1)))
            {
                Ret.EvaluatePostProcess.Score += ((GoK_BlackQueen - GoK_BlackPawn) - 100);
            }
        }
    }
}

Define ExecuteEngineMove (warp=false)
{
    Call EnterExecution;
    Call ExecuteEngineMoveImpl;
    Call ExitExecution;
}

Define ExecuteEngineMoveImpl (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Glob.PlayerClockRunning = 0;
    Event.Broadcast("UI_OpeningBookHide");
    EEMI.Move = Const.Null;
    If ((Glob.Level > 1) And (1 == 1))
    {
        Call GetOpeningMoves;
        If (List.Length(OpeningMovesRes) > 0)
        {
            Event.Broadcast("UI_OpeningBookShow");
            EEMI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
            If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
            {
                Glob.ClockMoveCount += 1;
                If ((Glob.ClockStageMoves > 0) And (Glob.ClockMoveCount == Glob.ClockStageMoves))
                {
                    Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockStageTime);
                }
            }
        }
    }
    Call IsEngineValidMove(EEMI.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Control.Wait(0);
        Call GetBestMove;
        EEMI.Move = Ret.GetBestMove.Move;
    }
    Event.BroadcastAndWait("UI_HideBestMove");
    Call OnProgressChanged(100);
    Control.Wait(0);
    Call IsEngineValidMove(EEMI.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Looks.Say(Operator.Join("Internal Error: No valid move found. Sorry, this should not happen. Maybe you cleared lookup lists in the editor? If you are running a normal game, please export board data and report bug via project comment", Operator.Join(" Move: ", EEMI.Move)), 10);
        GoK_IsGameSuspended = 1;
        Stop(this script);
    }
    Looks.Think("");
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((EEMI.Move / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((EEMI.Move % 100))];
    If (((EEMI.Move == GoK_BlackQueensideCastling) Or (EEMI.Move == GoK_BlackKingsideCastling)) Or ((EEMI.Move == GoK_WhiteQueensideCastling) Or (EEMI.Move == GoK_WhiteKingsideCastling)))
    {
        Pieces_MovePieceSpecial = EEMI.Move;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.BroadcastAndWait("Pieces_MovePiece");
    Event.Broadcast("SoundMove");
    List.Add(GameMoves, floor(EEMI.Move));
    Call GetMoveNotation(EEMI.Move);
    List.Add(GameMovesAN, Ret.GetMoveNotation.Notation);
    Call ClearMoveList(1);
    Call AddMoveToList(EEMI.Move)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1)((1 == 1));
    Call DrawBoardAndWait;
    If (Not ((floor((EEMI.Move / 100)) == 0)))
    {
        If (Board[(EEMI.Move % 100)] == GoK_BlackKing)
        {
            Glob.HasBlackKingMoved = 1;
        }
        If (Board[(EEMI.Move % 100)] == GoK_BlackRook)
        {
            If (floor((EEMI.Move / 100)) == 1)
            {
                Glob.HasBlackRookQSMoved = 1;
            }
            If (floor((EEMI.Move / 100)) == 8)
            {
                Glob.HasBlackRookKSMoved = 1;
            }
        }
    }
    If ((EEMI.Move == GoK_BlackQueensideCastling) Or (EEMI.Move == GoK_BlackKingsideCastling))
    {
        Glob.HasBlackKingMoved = 1;
        Glob.HasBlackCastled = 1;
    }
    Call AddBoardToHistory(1);
    Call GetRepetitionCount;
    If (Ret.GetRepetitionCount.Count > 2)
    {
        Looks.Say("Draw!");
        Event.Broadcast("SoundDraw");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByMaterial;
        If (Ret.IsDrawByMaterial.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call IsWhiteKingCheckMate;
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Looks.Say("Checkmate!");
                Event.Broadcast("SoundCheckmate");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(2);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call CalcBoardAttackedByMove(1);
                    If (Glob.IsWhiteChecked == 1)
                    {
                        Call SayAsync("Check!")(2);
                        Event.Broadcast("SoundCheck");
                    }
                }
            }
        }
    }
    Glob.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
    Glob.PlayerClockRunning = 1;
}

Define ExecuteInit (warp=false)
{
    Glob.ExecutionPly = 0;
    Glob.IsExecutionRunning = 0;
    If (Glob.IsPlayerBlack == 1)
    {
        Call ExecuteEngineMove;
    }
}

Define ExecuteUserMove(string UserMove) (warp=false)
{
    Call EnterExecution;
    Call ExecuteUserMoveImpl(UserMove);
    Call ExitExecution;
}

Define ExecuteUserMoveImpl(string UserMoveParam) (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    If (((Glob.TimeControl == 1) And ((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0))) And (Glob.CustomMaxDepth == 0))
    {
        Glob.PlayerClockTime = (Glob.PlayerClockTime + (Glob.ClockTimeInc - ((Sensing.DaysSince2000() * 86400) - Glob.PlayerMoveStart)));
        Glob.PlayerClockMoveCount += 1;
        If ((Glob.ClockStageMoves > 0) And (Glob.PlayerClockMoveCount == Glob.ClockStageMoves))
        {
            Glob.PlayerClockTime += Glob.ClockStageTime;
        }
        Glob.PlayerClockRunning = 0;
        Call PublishTimers(0);
    }
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((UserMoveParam / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((UserMoveParam % 100))];
    If (((UserMoveParam == GoK_BlackQueensideCastling) Or (UserMoveParam == GoK_BlackKingsideCastling)) Or ((UserMoveParam == GoK_WhiteQueensideCastling) Or (UserMoveParam == GoK_WhiteKingsideCastling)))
    {
        Pieces_MovePieceSpecial = UserMoveParam;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.Broadcast("SoundMove");
    Stg_FromSquareIdx = -1;
    Stg_ToSquareIdx = -1;
    Event.BroadcastAndWait("Stg_FromSquareSelected");
    Event.BroadcastAndWait("Stg_ToSquareSelected");
    Call GenerateMovesPublic(2);
    If (Not (List.ContainsItem(Moves2, UserMoveParam)))
    {
        Call SayAsync("Invalid move!")(2);
        Event.Broadcast("SoundInvalidMove");
        Call DrawBoardAndWait;
        Stop(this script);
    }
    Glob.UserMove = UserMoveParam;
    If (Operator.LetterOf(Glob.UserMove, (Variable.Length(Glob.UserMove) - 1)) == ".")
    {
        Looks.Say("Please select promotion piece");
        Event.BroadcastAndWait("Pieces_SelectPromotionPiece");
        Looks.Say("");
        If (Pieces_SelectedPromotionPiece == GoK_WhiteQueen)
        {
            Glob.UserMove = (floor(Glob.UserMove) + 0.1);
        }
        Else
        {
            If (Pieces_SelectedPromotionPiece == GoK_WhiteRook)
            {
                Glob.UserMove = (floor(Glob.UserMove) + 0.2);
            }
            Else
            {
                If (Pieces_SelectedPromotionPiece == GoK_WhiteBishop)
                {
                    Glob.UserMove = (floor(Glob.UserMove) + 0.3);
                }
                Else
                {
                    If (Pieces_SelectedPromotionPiece == GoK_WhiteKnight)
                    {
                        Glob.UserMove = (floor(Glob.UserMove) + 0.4);
                    }
                }
            }
        }
    }
    Call GetMoveNotation(Glob.UserMove);
    EUMI.Notation = Ret.GetMoveNotation.Notation;
    Call ClearMoveList(2);
    Call AddMoveToList(Glob.UserMove)(2)(0);
    List.ReplaceItem(MovesIdx, 2, 1);
    Call ApplyMove(2)((1 == 1));
    Call CalcBoardAttackedByMove(1);
    If (Glob.IsWhiteChecked == 1)
    {
        Call RevertMove(2);
        Call DrawBoardAndWait;
        Control.Wait(0);
        Call SayAsync("Invalid move - Check!")(2);
        Event.Broadcast("SoundInvalidMoveCheck");
        Stop(this script);
    }
    List.Add(GameMovesAN, EUMI.Notation);
    List.Add(GameMoves, floor(Glob.UserMove));
    Call DrawBoardAndWait;
    Control.Wait(0);
    EUMI.SourceIdx = floor((Glob.UserMove / 100));
    EUMI.TargetIdx = floor((Glob.UserMove % 100));
    If (Board[EUMI.TargetIdx] == GoK_WhiteKing)
    {
        Glob.HasWhiteKingMoved = 1;
    }
    If (Board[EUMI.TargetIdx] == GoK_WhiteRook)
    {
        If (EUMI.SourceIdx == 57)
        {
            Glob.HasWhiteRookQSMoved = 1;
        }
        If (EUMI.SourceIdx == 64)
        {
            Glob.HasWhiteRookKSMoved = 1;
        }
    }
    If ((Glob.UserMove == GoK_WhiteQueensideCastling) Or (Glob.UserMove == GoK_WhiteKingsideCastling))
    {
        Glob.HasWhiteCastled = 1;
        Glob.HasWhiteKingMoved = 1;
    }
    Call AddBoardToHistory(0);
    Call IsBlackKingCheckMate;
    If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
    {
        Looks.Say("Checkmate!");
        Event.Broadcast("SoundCheckmate");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByStalemate(1);
        If (Ret.IsDrawByStalemate.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call GetRepetitionCount;
            If (Ret.GetRepetitionCount.Count > 2)
            {
                Looks.Say("Draw!");
                Event.Broadcast("SoundDraw");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByMaterial;
                If (Ret.IsDrawByMaterial.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
    }
}

Define ExitExecution (warp=false)
{
    Glob.ExecutionPly += -1;
    If (Glob.ExecutionPly == 0)
    {
        Glob.IsExecutionRunning = 0;
        Event.BroadcastAndWait("GoK_ModeInput");
        If ((Glob.PlayerClockRunning == 0) And (GoK_IsGameSuspended == 0))
        {
            Glob.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
            Glob.PlayerClockRunning = 1;
        }
        Call PublishTimers(0);
    }
}

Define ExportBoardFEN(bool IsPlayerTurn) (warp=true)
{
    Call StoreExternalBoard;
    EBFEN.SqIdx = 1;
    Ret.ExportBoardFEN.FEN = "";
    Ret.ExportBoardFEN.FENLichess = "https://lichess.org/analysis/";
    Repeat Until (EBFEN.SqIdx > 64)
    {
        EBFEN.Piece = GoK_Board[EBFEN.SqIdx];
        If (EBFEN.Piece == GoK_BlackPawn)
        {
            EBFEN.PieceChar = "p";
        }
        If (EBFEN.Piece == GoK_BlackKnight)
        {
            EBFEN.PieceChar = "n";
        }
        If (EBFEN.Piece == GoK_BlackBishop)
        {
            EBFEN.PieceChar = "b";
        }
        If (EBFEN.Piece == GoK_BlackRook)
        {
            EBFEN.PieceChar = "r";
        }
        If (EBFEN.Piece == GoK_BlackQueen)
        {
            EBFEN.PieceChar = "q";
        }
        If (EBFEN.Piece == GoK_BlackKing)
        {
            EBFEN.PieceChar = "k";
        }
        If (EBFEN.Piece == GoK_WhitePawn)
        {
            EBFEN.PieceChar = "P";
        }
        If (EBFEN.Piece == GoK_WhiteKnight)
        {
            EBFEN.PieceChar = "N";
        }
        If (EBFEN.Piece == GoK_WhiteBishop)
        {
            EBFEN.PieceChar = "B";
        }
        If (EBFEN.Piece == GoK_WhiteRook)
        {
            EBFEN.PieceChar = "R";
        }
        If (EBFEN.Piece == GoK_WhiteQueen)
        {
            EBFEN.PieceChar = "Q";
        }
        If (EBFEN.Piece == GoK_WhiteKing)
        {
            EBFEN.PieceChar = "K";
        }
        If (EBFEN.Piece == 0)
        {
            EBFEN.ScanSqIdx = EBFEN.SqIdx;
            Repeat Until (((EBFEN.ScanSqIdx % 8) == 0) Or (Not ((GoK_Board[(EBFEN.ScanSqIdx + 1)] == 0))))
            {
                EBFEN.ScanSqIdx += 1;
            }
            EBFEN.PieceChar = ((EBFEN.ScanSqIdx - EBFEN.SqIdx) + 1);
            EBFEN.SqIdx += (EBFEN.ScanSqIdx - EBFEN.SqIdx);
        }
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, EBFEN.PieceChar);
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, EBFEN.PieceChar);
        If (((EBFEN.SqIdx % 8) == 0) And (EBFEN.SqIdx < 64))
        {
            Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, "/");
            Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "/");
        }
        EBFEN.SqIdx += 1;
    }
    If (((Glob.IsPlayerBlack == 1) And IsPlayerTurn) Or ((Not ((Glob.IsPlayerBlack == 1))) And (Not (IsPlayerTurn))))
    {
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, " b");
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "_b");
    }
    Else
    {
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, " w");
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "_w");
    }
}

Define ExportMovesPGN (warp=true)
{
    EMPGN.GameMovesANIdx = 1;
    Ret.ExportMovesPGN.PGN = "";
    Repeat (List.Length(GameMovesAN))
    {
        If ((EMPGN.GameMovesANIdx % 2) == 1)
        {
            Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join((((EMPGN.GameMovesANIdx - 1) / 2) + 1), ". "));
        }
        Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join(GameMovesAN[EMPGN.GameMovesANIdx], " "));
        EMPGN.GameMovesANIdx += 1;
    }
}

Define FillBoard (warp=true)
{
    List.DeleteAll(GoK_ScreenIdx);
    FB.ScreenSqIdx = 1;
    Repeat (64)
    {
        If (Glob.IsPlayerBlack == 1)
        {
            List.Add(GoK_ScreenIdx, (((IdxToRank[FB.ScreenSqIdx] - 1) * 8) + (9 - IdxToFile[FB.ScreenSqIdx])));
        }
        Else
        {
            List.Add(GoK_ScreenIdx, FB.ScreenSqIdx);
        }
        FB.ScreenSqIdx += 1;
    }
    List.DeleteItem(Board, all);
    Repeat (64)
    {
        List.Add(Board, 0);
    }
    List.ReplaceItem(Board, 1, GoK_BlackRook);
    List.ReplaceItem(Board, 2, GoK_BlackKnight);
    List.ReplaceItem(Board, 3, GoK_BlackBishop);
    List.ReplaceItem(Board, 4, GoK_BlackQueen);
    List.ReplaceItem(Board, 5, GoK_BlackKing);
    List.ReplaceItem(Board, 6, GoK_BlackBishop);
    List.ReplaceItem(Board, 7, GoK_BlackKnight);
    List.ReplaceItem(Board, 8, GoK_BlackRook);
    FB.SqIdx = 9;
    Repeat (8)
    {
        List.ReplaceItem(Board, FB.SqIdx, GoK_BlackPawn);
        FB.SqIdx += 1;
    }
    FB.SqIdx = 49;
    Repeat (8)
    {
        List.ReplaceItem(Board, FB.SqIdx, GoK_WhitePawn);
        FB.SqIdx += 1;
    }
    List.ReplaceItem(Board, 57, GoK_WhiteRook);
    List.ReplaceItem(Board, 58, GoK_WhiteKnight);
    List.ReplaceItem(Board, 59, GoK_WhiteBishop);
    List.ReplaceItem(Board, 60, GoK_WhiteQueen);
    List.ReplaceItem(Board, 61, GoK_WhiteKing);
    List.ReplaceItem(Board, 62, GoK_WhiteBishop);
    List.ReplaceItem(Board, 63, GoK_WhiteKnight);
    List.ReplaceItem(Board, 64, GoK_WhiteRook);
}

Define GenerateMovesForSource(string Ply)(string SourceIdx)(bool AttackTableOnly)(bool Quiescence) (warp=true)
{
    MoveGen.MFS.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    Call //("Pawn moves (generated via code logic)");
    If (MoveGen.MFS.SourcePiece == GoK_BlackPawn)
    {
        If (IdxToFile[(SourceIdx + 0)] > 1)
        {
            If (AttackTableOnly Or (Board[(SourceIdx + 7)] < 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx + 7))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (IdxToFile[(SourceIdx + 0)] < 8)
        {
            If (AttackTableOnly Or (Board[(SourceIdx + 9)] < 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx + 9))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (Not (AttackTableOnly))
        {
            If (Board[(SourceIdx + 8)] == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx + 8))(GoK_BlackPawn)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 8))(Ply)(AttackTableOnly)(Quiescence);
                }
                If ((IdxToRank[(SourceIdx + 0)] == 2) And (Board[(SourceIdx + 16)] == 0))
                {
                    If Quiescence
                    {
                        Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx + 16))(GoK_BlackPawn)(Ply);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx + 16))(Ply)(AttackTableOnly)(Quiescence);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            MoveGen.MFS.TargetIdx = EnPassantTarget[Ply];
            If ((Not (AttackTableOnly)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[MoveGen.MFS.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[MoveGen.MFS.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((MoveGen.MFS.TargetIdx + 8))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_WhitePawn)
    {
        If (IdxToFile[(SourceIdx + 0)] > 1)
        {
            If (AttackTableOnly Or (Board[(SourceIdx - 9)] > 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx - 9))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (IdxToFile[(SourceIdx + 0)] < 8)
        {
            If (AttackTableOnly Or (Board[(SourceIdx - 7)] > 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx - 7))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (Not (AttackTableOnly))
        {
            If (Board[(SourceIdx - 8)] == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx - 8))(GoK_WhitePawn)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 8))(Ply)(AttackTableOnly)(Quiescence);
                }
                If ((IdxToRank[(SourceIdx + 0)] == 7) And (Board[(SourceIdx - 16)] == 0))
                {
                    If Quiescence
                    {
                        Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx - 16))(GoK_WhitePawn)(Ply);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx - 16))(Ply)(AttackTableOnly)(Quiescence);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            MoveGen.MFS.TargetIdx = EnPassantTarget[Ply];
            If ((Not (AttackTableOnly)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[MoveGen.MFS.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[MoveGen.MFS.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((MoveGen.MFS.TargetIdx - 8))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        Stop(this script);
    }
    Call //("Non-pawn moves (generated via lookup tables)");
    MoveGen.MFS.SourcePiece = abs(MoveGen.MFS.SourcePiece);
    If (MoveGen.MFS.SourcePiece == GoK_BlackRook)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackBishop)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackKnight)
    {
        Call AddLookupMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackKing)
    {
        Call AddLookupMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackQueen)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1));
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0));
        Stop(this script);
    }
}

Define GenerateMovesImpl(string Ply)(bool AttackTableOnly)(bool Quiescence)(bool IsBlackMove) (warp=true)
{
    If ((CheckedState[Ply] == 1) And (Not (AttackTableOnly)))
    {
        Call PrepareEvasionMask(Ply);
    }
    MoveGen.MI.SkipIdx = -1;
    List.DeleteAll(CalcMovesScoreList);
    List.DeleteAll(CalcMovesMoveList);
    Call PrepareCurrentKillerMoves(Ply);
    Call ClearMoveList(Ply);
    MoveGen.MI.PieceMobilityIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(PieceMobility, MoveGen.MI.PieceMobilityIdx, 0);
        MoveGen.MI.PieceMobilityIdx += 1;
    }
    MoveGen.MI.SourceIdx = 1;
    Repeat (64)
    {
        If (Not ((MoveGen.MI.SourceIdx == MoveGen.MI.SkipIdx)))
        {
            If ((IsBlackMove And (Board[MoveGen.MI.SourceIdx] > 0)) Or ((Not (IsBlackMove)) And (Board[MoveGen.MI.SourceIdx] < 0)))
            {
                Call GenerateMovesForSource(Ply)(MoveGen.MI.SourceIdx)(AttackTableOnly)(Quiescence);
            }
        }
        MoveGen.MI.SourceIdx += 1;
    }
    Call //("Castling moves");
    If ((Not (AttackTableOnly)) And (Not (Quiescence)))
    {
        If IsBlackMove
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 1) == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 2) == 0)))
            {
                If (Operator.LetterOf(CastlingState[Ply], 4) == 0)
                {
                    If ((((Board[1] == GoK_BlackRook) And (Board[2] == 0)) And ((Board[3] == 0) And (Board[4] == 0))) And (Board[5] == GoK_BlackKing))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 3)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 4)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0))))
                        {
                            Call AddSpecialMove(GoK_BlackQueensideCastling)(Ply);
                        }
                    }
                }
                If (Operator.LetterOf(CastlingState[Ply], 3) == 0)
                {
                    If (((Board[5] == GoK_BlackKing) And (Board[6] == 0)) And ((Board[7] == 0) And (Board[8] == GoK_BlackRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 6)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 7)] == 0))))
                        {
                            Call AddSpecialMove(GoK_BlackKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
        Else
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 5) == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 6) == 0)))
            {
                If (Operator.LetterOf(CastlingState[Ply], 8) == 0)
                {
                    If (((Board[57] == GoK_WhiteRook) And (Board[58] == 0)) And ((Board[59] == 0) And ((Board[60] == 0) And (Board[61] == GoK_WhiteKing))))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 59)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 60)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0))))
                        {
                            Call AddSpecialMove(GoK_WhiteQueensideCastling)(Ply);
                        }
                    }
                }
                If (Operator.LetterOf(CastlingState[Ply], 7) == 0)
                {
                    If (((Board[62] == 0) And (Board[61] == GoK_WhiteKing)) And ((Board[63] == 0) And (Board[64] == GoK_WhiteRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 62)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 63)] == 0))))
                        {
                            Call AddSpecialMove(GoK_WhiteKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
    }
    Call //("Move ordering");
    If (Not (AttackTableOnly))
    {
        Call SortMoveList(Ply);
    }
}

Define GenerateMovesImplWrapper(string Ply)(bool AttackTableOnly)(bool Quiescence) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodEnter(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * Quiescence)) - ((2 * Const.MaxPlyStackFrames) * AttackTableOnly)) + Ply));
    }
    Glob.IsPotentialNonCapQuiescMove = 0;
    If Quiescence
    {
        Call IsQuiescentCheckCond(Ply);
        Glob.IsPotentialNonCapQuiescMove = Ret.IsQuiescentCheckCond.IsTrue;
    }
    Call GenerateMovesImpl(Ply)(AttackTableOnly)(Quiescence)((PlyIsOwn[Ply] == 1));
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodExit(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * Quiescence)) - ((2 * Const.MaxPlyStackFrames) * AttackTableOnly)) + Ply));
    }
}

Define GenerateMovesPublic(string Ply) (warp=true)
{
    MoveGen.MP.SqIdx = 1;
    Repeat (64)
    {
        If (Board[MoveGen.MP.SqIdx] == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = MoveGen.MP.SqIdx;
        }
        Else
        {
            If (Board[MoveGen.MP.SqIdx] == GoK_BlackKing)
            {
                Glob.BlackKingIdx = MoveGen.MP.SqIdx;
            }
        }
        MoveGen.MP.SqIdx += 1;
    }
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call SetInitialEnPassantTarget(Ply);
    List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0));
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    List.ReplaceItem(CastlingState, Ply, Const.Null);
}

Define GetBestMove (warp=false)
{
    If (Glob.Level == 1)
    {
        Glob.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
        Glob.ThinkTimeLimitSearch = 10;
        Ret.GetBestMove.Move = Const.Null;
        Get.BME.JuniorDistQuota = 40;
        Get.BME.JuniorSearchQuota = 20;
        Call Search(-100000)(100000)(1)(1)((1 == 0));
        Ret.GetBestMove.Move = Ret.Search.Move;
        If (Glob.IsSearchTimeout == 0)
        {
            Call OnEvaluationChanged(Ret.Search.Eval);
        }
        If (Not ((Glob.IsDCI == 1)))
        {
            If ((Not ((Ret.GetBestMove.Move == Const.Null))) And (Ret.GetBestMove.Move == GoK_BlackKingsideCastling))
            {
                Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                Stg_BestMoveToIdx = GoK_ScreenIdx[7];
            }
            Else
            {
                If ((Not ((Ret.GetBestMove.Move == Const.Null))) And (Ret.GetBestMove.Move == GoK_BlackQueensideCastling))
                {
                    Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                    Stg_BestMoveToIdx = GoK_ScreenIdx[3];
                }
                Else
                {
                    If (Not ((Ret.GetBestMove.Move == Const.Null)))
                    {
                        Stg_BestMoveFromIdx = GoK_ScreenIdx[floor((Ret.GetBestMove.Move / 100))];
                    }
                    If (Not ((Ret.GetBestMove.Move == Const.Null)))
                    {
                        Stg_BestMoveToIdx = GoK_ScreenIdx[floor((Ret.GetBestMove.Move % 100))];
                    }
                }
            }
            Event.Broadcast("UI_ShowBestMove");
        }
        Get.BME.Rnd = Operator.Random(1 , 100);
        If (Not ((Ret.GetBestMove.Move == Const.Null)))
        {
            If ((Get.BME.Rnd > ((Get.BME.JuniorSearchQuota + 100) / 2)) Or (((BoardAttackedByWhite[floor((Ret.GetBestMove.Move / 100))] == 0) And (Board[floor((Ret.GetBestMove.Move % 100))] == 0)) And (Get.BME.Rnd > Get.BME.JuniorSearchQuota)))
            {
                Call GenerateMovesPublic(1);
                List.ReplaceItem(MovesIdx, 1, Operator.Random(1 , ceiling((List.Length(Moves1) * (Get.BME.JuniorDistQuota / 100)))));
                Call ApplyMove(1)((1 == 1));
                Call CalcBoardAttackedByMove(2);
                Call RevertMove(1);
                Repeat Until (Glob.IsBlackChecked == 0)
                {
                    List.ReplaceItem(MovesIdx, 1, Operator.Random(1 , List.Length(Moves1)));
                    Call ApplyMove(1)((1 == 1));
                    Call CalcBoardAttackedByMove(2);
                    Call RevertMove(1);
                }
                Ret.GetBestMove.Move = Moves1[MovesIdx[1]];
            }
        }
    }
    Else
    {
        Call GetBestMoveMedDiff;
        Ret.GetBestMove.Move = Ret.GetBestMoveMedDiff.Move;
    }
}

Define GetBestMoveDCI (warp=true)
{
    Call GetBestMoveMedDiff.Prepare;
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveMedDiff.Iteration;
    }
    Ret.GetBestMoveDCI.Move = Glob.DeepeningBestMove;
}

Define GetBestMoveDCI.Slice (warp=true)
{
    Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Repeat Until ((Glob.IsDeepeningDone == 1) Or ((Sensing.DaysSince2000() * 86400) > (Glob.PrevProgressUpdate + 1)))
    {
        Call GetBestMoveMedDiff.Iteration;
    }
    Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Ret.GetBestMoveDCI.Move = Glob.DeepeningBestMove;
}

Define GetBestMoveMedDiff (warp=false)
{
    Call GetBestMoveMedDiff.Prepare;
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveMedDiff.Iteration;
        If (Not ((Glob.IsDCI == 1)))
        {
            If (Not ((Glob.BestMove == Const.Null)))
            {
                Call OnEvaluationChanged(Glob.BestMoveEval);
                If (Glob.BestMove == GoK_BlackKingsideCastling)
                {
                    Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                    Stg_BestMoveToIdx = GoK_ScreenIdx[7];
                }
                Else
                {
                    If (Glob.BestMove == GoK_BlackQueensideCastling)
                    {
                        Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                        Stg_BestMoveToIdx = GoK_ScreenIdx[3];
                    }
                    Else
                    {
                        Stg_BestMoveFromIdx = GoK_ScreenIdx[floor((Glob.BestMove / 100))];
                        Stg_BestMoveToIdx = GoK_ScreenIdx[floor((Glob.BestMove % 100))];
                    }
                }
                Event.Broadcast("UI_ShowBestMove");
            }
            Get.BMMD.Now = (Sensing.DaysSince2000() * 86400);
            If ((Get.BMMD.Now > (Glob.PrevProgressUpdate + 0.5)) Or (Glob.IsDeepeningDone == 1))
            {
                Call OnProgressChanged((((Get.BMMD.Now - Glob.ThinkTimeStart) / Glob.ProgressLimit) * 100));
            }
            If ((Get.BMMD.Now > (Glob.PrevProgressUpdate + 0.5)) And (Glob.IsDeepeningDone == 0))
            {
                Call PublishTimers((Get.BMMD.Now - Glob.ThinkTimeStart));
                Glob.PrevProgressUpdate = Get.BMMD.Now;
            }
            If (Glob.IsDeepeningDone == 1)
            {
                Call PublishTimers(0);
            }
        }
    }
    Ret.GetBestMoveMedDiff.Move = Glob.DeepeningBestMove;
}

Define GetBestMoveMedDiff.Iteration (warp=true)
{
    Glob.ThinkTimeLimitSearch = Glob.DeepeningThinkTimeLimit;
    If (((Glob.IdxDeepening > 4) And (1 == 1)) And ((Not ((Glob.BestMoveEval == Const.Null))) And (abs(Glob.BestMoveEval) < Const.AbsMinCheckmateEval)))
    {
        Get.BMMDI.AspirationDelta = Operator.Round((12 + ((abs(Glob.BestMoveEval) * abs(Glob.BestMoveEval)) / 6712)));
        Get.BMMDI.AspirationAlpha = Operator.Round((Glob.BestMoveEval - Get.BMMDI.AspirationDelta));
        Get.BMMDI.AspirationBeta = Operator.Round((Glob.BestMoveEval + Get.BMMDI.AspirationDelta));
    }
    Else
    {
        Get.BMMDI.AspirationAlpha = -100000;
        Get.BMMDI.AspirationBeta = 100000;
    }
    Get.BMMDI.IsAspirationDone = 0;
    Get.BMMDI.FailedHighCount = 0;
    Get.BMMDI.SavedLimit = Glob.DeepeningThinkTimeLimit;
    Repeat Until ((Get.BMMDI.IsAspirationDone == 1) Or (Glob.IsSearchTimeout == 1))
    {
        Get.BMMDI.SearchDepth = (Glob.IdxDeepening - Get.BMMDI.FailedHighCount);
        If (Get.BMMDI.SearchDepth < 1)
        {
            Get.BMMDI.SearchDepth = 1;
        }
        Call Search(Get.BMMDI.AspirationAlpha)(Get.BMMDI.AspirationBeta)(Get.BMMDI.SearchDepth)(1)((Glob.IdxDeepening == 1));
        Get.BMMDI.SearchEval = Ret.Search.Eval;
        If ((Not ((Ret.Search.Move == Const.Null))) And (Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha))
        {
            If ((Glob.DeepeningBestMove == Const.Null) Or List.ContainsItem(SearchRootMovesDone, Glob.DeepeningBestMove))
            {
                Glob.DeepeningBestMove = Ret.Search.Move;
                Glob.BestMove = Glob.DeepeningBestMove;
                Glob.BestMoveEval = Get.BMMDI.SearchEval;
            }
        }
        Get.BMMDI.IsAspirationFail = 0;
        If (Not ((Get.BMMDI.SearchEval == Const.Null)))
        {
            If ((Not ((Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha))) Or (Not ((Get.BMMDI.SearchEval < Get.BMMDI.AspirationBeta))))
            {
                Get.BMMDI.IsAspirationFail = 1;
            }
        }
        Call Log(Glob.IdxDeepening)(": AW : ")(Get.BMMDI.AspirationAlpha)(" : ")(Get.BMMDI.AspirationBeta)(" : ")(Get.BMMDI.SearchEval)(Operator.Join(" : ", Get.BMMDI.IsAspirationFail));
        If ((Glob.IsSearchTimeout == 0) And (Get.BMMDI.IsAspirationFail == 1))
        {
            Get.BMMD.Now = (Sensing.DaysSince2000() * 86400);
            If (Get.BMMD.Now > (Glob.PrevProgressUpdate + 0.5))
            {
                Call OnProgressChanged((((Get.BMMD.Now - Glob.ThinkTimeStart) / Glob.ProgressLimit) * 100));
            }
            If (Get.BMMD.Now > (Glob.PrevProgressUpdate + 0.5))
            {
                Call PublishTimers((Get.BMMD.Now - Glob.ThinkTimeStart));
                Glob.PrevProgressUpdate = Get.BMMD.Now;
            }
            If ((((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0)) And (Not ((Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha))))
            {
                Glob.DeepeningThinkTimeLimit = Glob.MaxThinkTime;
            }
            Get.BMMDI.AspirationDelta = Operator.Round((Get.BMMDI.AspirationDelta * 1.5));
            If (Not ((Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha)))
            {
                Get.BMMDI.FailedHighCount = 0;
            }
            Else
            {
                Get.BMMDI.FailedHighCount += 1;
            }
            If ((Get.BMMDI.AspirationDelta < 300) And (abs(Get.BMMDI.SearchEval) < Const.AbsMinCheckmateEval))
            {
                If (Not ((Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha)))
                {
                    If (1 == 1)
                    {
                        Get.BMMDI.AspirationBeta = Operator.Round(((Get.BMMDI.AspirationAlpha + Get.BMMDI.AspirationBeta) / 2));
                    }
                    Get.BMMDI.AspirationAlpha = Operator.Round((Get.BMMDI.SearchEval - Get.BMMDI.AspirationDelta));
                }
                Else
                {
                    Get.BMMDI.AspirationBeta = Operator.Round((Get.BMMDI.SearchEval + Get.BMMDI.AspirationDelta));
                }
            }
            Else
            {
                Get.BMMDI.AspirationAlpha = -100000;
                Get.BMMDI.AspirationBeta = 100000;
            }
        }
        Else
        {
            Get.BMMDI.IsAspirationDone = 1;
        }
    }
    Glob.DeepeningThinkTimeLimit = Get.BMMDI.SavedLimit;
    Get.BMMDI.IsDeepeningDone = 0;
    If (Glob.IsSearchTimeout == 1)
    {
        Get.BMMDI.IsDeepeningDone = 1;
    }
    Else
    {
        If (Glob.IdxDeepening == Glob.DeepeningMaxSearchPly)
        {
            Get.BMMDI.IsDeepeningDone = 1;
        }
        Else
        {
            If ((Glob.CustomMaxDepth > 0) And (Not ((Glob.IdxDeepening < Glob.CustomMaxDepth))))
            {
                Get.BMMDI.IsDeepeningDone = 1;
            }
            Else
            {
                If ((Glob.IdxDeepening == 1) And (Ret.Search.LegalMoveCount == 1))
                {
                    Get.BMMDI.IsDeepeningDone = 1;
                }
                Else
                {
                    If (Not ((Glob.BestMoveEval == Const.Null)))
                    {
                        If (abs(Glob.BestMoveEval) > (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + Glob.IdxDeepening)))
                        {
                            Get.BMMDI.IsDeepeningDone = 1;
                        }
                    }
                }
            }
        }
    }
    If (Get.BMMDI.IsDeepeningDone == 1)
    {
        Glob.IsDeepeningDone = 1;
    }
    Else
    {
        If ((((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0)) And (Glob.IdxDeepening > 4))
        {
            Glob.BestMoveChanges = (Glob.BestMoveChanges / 2);
            If (Glob.DeepeningBestMove == Glob.StableBestMove)
            {
                Glob.StableBestMoveCount += 1;
            }
            Else
            {
                Glob.StableBestMoveCount = 0;
                If (Not ((Glob.StableBestMove == Const.Null)))
                {
                    Glob.BestMoveChanges += 1;
                }
            }
            Glob.StableBestMove = Glob.DeepeningBestMove;
            If (Glob.StableBestMoveCount > 5)
            {
                Get.BMMDI.SoftThinkTime = (Glob.OptimumThinkTime * 0.6);
            }
            Else
            {
                Get.BMMDI.SoftThinkTime = (Glob.OptimumThinkTime * (1.3 - (0.14 * Glob.StableBestMoveCount)));
            }
            Get.BMMDI.BestMoveInstability = (1 + (1.88 * Glob.BestMoveChanges));
            Get.BMMDI.SoftThinkTime = (Get.BMMDI.SoftThinkTime * Get.BMMDI.BestMoveInstability);
            If ((Glob.PrevMoveEval == Const.Null) Or ((Glob.PrevIterEval == Const.Null) Or (Glob.BestMoveEval == Const.Null)))
            {
                Get.BMMDI.FallingEval = 1;
            }
            Else
            {
                Get.BMMDI.FallingEval = ((69 + ((24 * (Glob.PrevMoveEval - Glob.BestMoveEval)) + (12 * (Glob.PrevIterEval - Glob.BestMoveEval)))) / 781.4);
                If (Get.BMMDI.FallingEval < 0.5)
                {
                    Get.BMMDI.FallingEval = 0.5;
                }
                If (Get.BMMDI.FallingEval > 1.5)
                {
                    Get.BMMDI.FallingEval = 1.5;
                }
            }
            Get.BMMDI.SoftThinkTime = (Get.BMMDI.SoftThinkTime * (Get.BMMDI.FallingEval / 0.5));
            If (Get.BMMDI.SoftThinkTime > Glob.DeepeningThinkTimeLimit)
            {
                Get.BMMDI.SoftThinkTime = Glob.DeepeningThinkTimeLimit;
            }
            Get.BMMDI.DepthTimeGrowth = 1.4;
            If ((((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * Get.BMMDI.DepthTimeGrowth) > Get.BMMDI.SoftThinkTime) And (Not ((Glob.IdxDeepening < Glob.MinThinkDepth)))) Or ((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * 1.9) > Glob.DeepeningThinkTimeLimit))
            {
                Call Log("TM stop : ")(Glob.IdxDeepening)(" : ")(((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart))(" : ")(Get.BMMDI.SoftThinkTime)(" : ")(Operator.Join(Glob.StableBestMoveCount, Operator.Join(" : ", Glob.BestMoveChanges)));
                Glob.IsDeepeningDone = 1;
            }
            Glob.PrevIterEval = Glob.BestMoveEval;
        }
        If (Glob.IsDeepeningDone == 0)
        {
            Glob.IdxDeepening += 1;
        }
    }
    If ((Glob.IsDeepeningDone == 1) And (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0)))
    {
        Glob.PrevMoveEval = Glob.BestMoveEval;
        Glob.CurrentClockTime = (Glob.CurrentClockTime + (Glob.ClockTimeInc - ((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart)));
        Glob.ClockMoveCount += 1;
        If ((Glob.ClockStageMoves > 0) And (Glob.ClockMoveCount == Glob.ClockStageMoves))
        {
            Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockStageTime);
        }
        If (Glob.AvgCompletedDepth == Const.Null)
        {
            Glob.AvgCompletedDepth = (Glob.IdxDeepening - Glob.IsSearchTimeout);
        }
        Else
        {
            Glob.AvgCompletedDepth = ((0.8 * Glob.AvgCompletedDepth) + (0.2 * (Glob.IdxDeepening - Glob.IsSearchTimeout)));
        }
        If ((Glob.TimeControl == 1) And (Glob.CurrentClockTime < 0))
        {
            Looks.Say("Engine out of time");
            GoK_IsGameSuspended = 1;
        }
    }
}

Define GetBestMoveMedDiff.Prepare (warp=true)
{
    Glob.DeepeningMaxSearchPly = (Const.MaxPlyStackFrames - 30);
    If (Glob.Level == 2)
    {
        Glob.DeepeningThinkTimeLimit = 3;
    }
    Else
    {
        Glob.DeepeningThinkTimeLimit = 10;
    }
    If (Glob.CustomThinkTime > 0)
    {
        Glob.DeepeningThinkTimeLimit = Glob.CustomThinkTime;
    }
    If ((Glob.IsDCI == 0) And (Glob.TimeControl == 0))
    {
        Glob.InitialClockTime = 0;
        If (Glob.CustomThinkTime == 0)
        {
            Glob.ClockTimeInc = Glob.DeepeningThinkTimeLimit;
        }
        Else
        {
            Glob.ClockTimeInc = 0;
        }
        Glob.CurrentClockTime = 0;
    }
    If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
    {
        Get.BMMDP.RemainingTime = (Glob.CurrentClockTime + Glob.ClockTimeInc);
        If (Glob.ClockStageMoves > Glob.ClockMoveCount)
        {
            Get.BMMDP.MovesToGo = (Glob.ClockStageMoves - Glob.ClockMoveCount);
            If (Get.BMMDP.MovesToGo > 50)
            {
                Get.BMMDP.MovesToGo = 50;
            }
            Get.BMMDP.MaxScale = (1.5 + (0.11 * Get.BMMDP.MovesToGo));
            If (Get.BMMDP.MaxScale > 6.3)
            {
                Get.BMMDP.MaxScale = 6.3;
            }
        }
        Else
        {
            If (Glob.ClockTimeInc == 0)
            {
                Get.BMMDP.MovesToGo = 40;
            }
            Else
            {
                Get.BMMDP.MovesToGo = 19;
            }
            Get.BMMDP.MaxScale = 4.5;
        }
        Glob.OptimumThinkTime = ((Get.BMMDP.RemainingTime / Get.BMMDP.MovesToGo) + Glob.ClockTimeInc);
        Glob.MaxThinkTime = (0.8 * Get.BMMDP.RemainingTime);
        If (Glob.TimeControl == 1)
        {
            Glob.MaxThinkTime = (0.8 * Glob.CurrentClockTime);
        }
        If (Glob.ClockStageMoves > Glob.ClockMoveCount)
        {
            If (Glob.MaxThinkTime > (Get.BMMDP.RemainingTime - ((Get.BMMDP.MovesToGo - 1) * (0.75 * Glob.OptimumThinkTime))))
            {
                Glob.MaxThinkTime = (Get.BMMDP.RemainingTime - ((Get.BMMDP.MovesToGo - 1) * (0.75 * Glob.OptimumThinkTime)));
            }
        }
        Else
        {
            If (Glob.ClockTimeInc == 0)
            {
                If (Glob.MaxThinkTime > (Get.BMMDP.MaxScale * Glob.OptimumThinkTime))
                {
                    Glob.MaxThinkTime = (Get.BMMDP.MaxScale * Glob.OptimumThinkTime);
                }
            }
        }
        Glob.DeepeningThinkTimeLimit = (Get.BMMDP.MaxScale * Glob.OptimumThinkTime);
        If (Glob.DeepeningThinkTimeLimit > Glob.MaxThinkTime)
        {
            Glob.DeepeningThinkTimeLimit = Glob.MaxThinkTime;
        }
        If (Glob.TimeControl == 1)
        {
            If (Glob.MaxThinkTime < 0.05)
            {
                Glob.MaxThinkTime = 0.05;
            }
            If (Glob.DeepeningThinkTimeLimit < 0.05)
            {
                Glob.DeepeningThinkTimeLimit = 0.05;
            }
        }
        Glob.BestMoveChanges = 0;
        If (Glob.ClockTimeInc > 0)
        {
            Glob.MinThinkDepth = (floor((11.5 + (1.66 * ln(Glob.ClockTimeInc)))) - 1);
        }
        Else
        {
            Glob.MinThinkDepth = 0;
        }
        If ((Not ((Glob.AvgCompletedDepth == Const.Null))) And (Glob.AvgCompletedDepth < Glob.MinThinkDepth))
        {
            Glob.MinThinkDepth = floor(Glob.AvgCompletedDepth);
        }
        Glob.StableBestMoveCount = 0;
        Glob.StableBestMove = Const.Null;
        Glob.PrevIterEval = Glob.PrevMoveEval;
        Call Log("TM : ")(Glob.CurrentClockTime)(" : ")(Glob.OptimumThinkTime)(" : ")(Glob.DeepeningThinkTimeLimit)(" : ")(Glob.MinThinkDepth);
    }
    Glob.ProgressLimit = Glob.DeepeningThinkTimeLimit;
    If ((Glob.TimeControl == 1) And (Glob.OptimumThinkTime > 0.05))
    {
        Glob.ProgressLimit = Glob.OptimumThinkTime;
    }
    Glob.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    If (Glob.IsTimeModelLogged == 0)
    {
        Glob.IsTimeModelLogged = 1;
        If (Glob.CustomMaxDepth > 0)
        {
            Call Log("TM model : depth : ")(Glob.CustomMaxDepth)("")("")("")("")("")("");
        }
        Else
        {
            If ((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0))
            {
                If (Glob.ClockStageMoves > 0)
                {
                    Call Log("TM model : staged : ")(Glob.InitialClockTime)(" / ")(Glob.ClockStageMoves)(" + ")(Glob.ClockStageTime)(" : move ")(Glob.ClockMoveCount);
                }
                Else
                {
                    Call Log("TM model : clock : ")(Glob.InitialClockTime)(" / ")(Glob.ClockTimeInc)("")("")("")("");
                }
            }
            Else
            {
                Call Log("TM model : fixed : ")(Glob.DeepeningThinkTimeLimit)("")("")("")("")("")("");
            }
        }
    }
    Glob.IsSearchTimeout = 0;
    Glob.IsDeepeningDone = 0;
    Glob.IdxDeepening = 1;
    Glob.DeepeningBestMove = Const.Null;
    Glob.BestMove = Glob.DeepeningBestMove;
    Glob.BestMoveEval = Const.Null;
}

Define GetBoardString (warp=true)
{
    Get.BS.SqIdx = 1;
    Ret.GetBoardString.BoardString = "";
    Repeat (64)
    {
        Ret.GetBoardString.BoardString = Operator.Join(Ret.GetBoardString.BoardString, Operator.Join(Board[Get.BS.SqIdx], ","));
        Get.BS.SqIdx += 1;
    }
}

Define GetCalibratedEval(string Ply) (warp=true)
{
    Ret.GetCalibratedEval.Score = StaticEval[Ply];
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        If ((NodeTTHit[Ply] == 1) And (Not ((NodeTTScore[Ply] == Const.Null))))
        {
            GCE.TTType = NodeTTType[Ply];
            GCE.TTScore = NodeTTScore[Ply];
            GCE.StaticEval = StaticEval[Ply];
            GCE.IsTTScoreUsable = 0;
            If (GCE.TTType == Const.TTType.Exact)
            {
                GCE.IsTTScoreUsable = 1;
            }
            Else
            {
                If (GCE.TTType == Const.TTType.HighBound)
                {
                    If (GCE.TTScore < GCE.StaticEval)
                    {
                        GCE.IsTTScoreUsable = 1;
                    }
                }
                Else
                {
                    If (GCE.TTType == Const.TTType.LowBound)
                    {
                        If (GCE.TTScore > GCE.StaticEval)
                        {
                            GCE.IsTTScoreUsable = 1;
                        }
                    }
                }
            }
            If (GCE.IsTTScoreUsable == 1)
            {
                If (1 == 1)
                {
                    If (Not ((abs(NodeTTScore[Ply]) > Const.AbsMinCheckmateEval)))
                    {
                        Ret.GetCalibratedEval.Score = NodeTTScore[Ply];
                    }
                }
            }
        }
    }
}

Define GetCorrHistIndices(string Ply) (warp=true)
{
    Ret.GetCorrHistIndices.PawnKey = Glob.KPHash;
    Call GetPiecePosHash(Board[Glob.WhiteKingIdx])(Glob.WhiteKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Call GetPiecePosHash(Board[Glob.BlackKingIdx])(Glob.BlackKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Ret.GetCorrHistIndices.CorrIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.PawnKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnBlackKey = Glob.NonPawnHashBlack;
    Ret.GetCorrHistIndices.NonPawnBlackIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnBlackKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnWhiteKey = Glob.NonPawnHashWhite;
    Ret.GetCorrHistIndices.NonPawnWhiteIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnWhiteKey % 100000)) + 1);
    Ret.GetCorrHistIndices.ContIdx2 = Const.Null;
    Ret.GetCorrHistIndices.ContIdx4 = Const.Null;
    If (Ply > 2)
    {
        If ((Not ((AppliedMove[(Ply - 1)] == 0))) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            Get.CHI.PieceTo1 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] - 1) + (6 * (SourcePieces[(Ply - 1)] < 0))) * 64) + floor((AppliedMove[(Ply - 1)] % 100)));
            Get.CHI.PieceTo2 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] - 1) + (6 * (SourcePieces[(Ply - 2)] < 0))) * 64) + floor((AppliedMove[(Ply - 2)] % 100)));
            Ret.GetCorrHistIndices.ContIdx2 = ((((PlyIsOwn[Ply] * 646416) + (Get.CHI.PieceTo1 * 804)) + Get.CHI.PieceTo2) + 1);
            If (Ply > 4)
            {
                If (Not ((AppliedMove[(Ply - 4)] == 0)))
                {
                    Get.CHI.PieceTo4 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] - 1) + (6 * (SourcePieces[(Ply - 4)] < 0))) * 64) + floor((AppliedMove[(Ply - 4)] % 100)));
                    Ret.GetCorrHistIndices.ContIdx4 = ((((PlyIsOwn[Ply] * 646416) + (Get.CHI.PieceTo1 * 804)) + Get.CHI.PieceTo4) + 1);
                }
            }
        }
    }
}

Define GetCurrentMove(num Ply) (warp=true)
{
    Ret.GetCurrentMove.Move = Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])];
}

Define GetHistoryStatScore(string SourcePieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply) (warp=true)
{
    Get.HSS.PieceToKey = 0;
    Ret.GetHistoryStatScore.Score = 0;
    If (floor((Move / 100)) == 0)
    {
        Ret.GetHistoryStatScore.Score += (2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]);
        Get.HSS.PieceToKey = ((PieceIdxLookup[GoK_BlackKing] * 68) + ToIdx);
    }
    Else
    {
        If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
        {
            Ret.GetHistoryStatScore.Score += (2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]);
            Get.HSS.PieceToKey = ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx);
        }
    }
    Get.HSS.Idx = -1;
    If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
    {
        If (1 == 1)
        {
            Get.HSS.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + Get.HSS.PieceToKey);
        }
    }
    If (Not ((Get.HSS.Idx == -1)))
    {
        Ret.GetHistoryStatScore.Score += (HistoryContinuation[(PlyContinuationBaseIdx[Ply] + Get.HSS.Idx)] * 2);
    }
    If (1 == 1)
    {
        If ((Ply > 2) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            If (1 == 1)
            {
                Get.HSS.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                Ret.GetHistoryStatScore.Score += (HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + Get.HSS.Idx)] * 1);
            }
        }
    }
    If ((Ply > 4) And (Not ((AppliedMove[(Ply - 4)] == 0))))
    {
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))]));
    }
    If ((Ply > 6) And (Not ((AppliedMove[(Ply - 6)] == 0))))
    {
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))]));
    }
    Call ProbePawnHist(SourcePieceParam)(ToIdx);
    Ret.GetHistoryStatScore.Score += (HistoryPawnHist[Ret.ProbePawnHist.Idx] * 2);
}

Define GetImproving(string Ply) (warp=true)
{
    If (Improving[Ply] == Const.Null)
    {
        Call GetImprovingImpl(Ply);
        List.ReplaceItem(Improving, Ply, Ret.GetImprovingImpl.IsImproving);
    }
    Ret.GetImproving.IsImproving = Improving[Ply];
}

Define GetImprovingImpl(string Ply) (warp=true)
{
    If (CheckedState[Ply] == 1)
    {
        Ret.GetImprovingImpl.IsImproving = 0;
        Stop(this script);
    }
    If (Ply > 1)
    {
        If (AppliedMove[(Ply - 1)] == 0)
        {
            Ret.GetImprovingImpl.IsImproving = 0;
            Stop(this script);
        }
    }
    Ret.GetImprovingImpl.IsImproving = Const.Null;
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        Get.Improving.StaticEvalIdx = (Ply - 2);
        If (Get.Improving.StaticEvalIdx > 0)
        {
            If (StaticEval[Get.Improving.StaticEvalIdx] == Const.Null)
            {
                Get.Improving.StaticEvalIdx = (Get.Improving.StaticEvalIdx - 2);
            }
        }
        If ((Get.Improving.StaticEvalIdx > 0) And (Not ((StaticEval[Get.Improving.StaticEvalIdx] == Const.Null))))
        {
            If (StaticEval[Ply] > StaticEval[Get.Improving.StaticEvalIdx])
            {
                Ret.GetImprovingImpl.IsImproving = 1;
            }
            Else
            {
                Ret.GetImprovingImpl.IsImproving = 0;
            }
        }
    }
}

Define GetMoveNotation(num Move) (warp=true)
{
    Call GetPhysicalMove(Move);
    Ret.GetMoveNotation.VirtualMove = Ret.GetPhysicalMove.Move;
    Ret.GetMoveNotation.Notation = "";
    If ((Ret.GetPhysicalMove.Move == GoK_BlackKingsideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteKingsideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O";
        Stop(this script);
    }
    If ((Ret.GetPhysicalMove.Move == GoK_BlackQueensideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteQueensideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O-O";
        Stop(this script);
    }
    Get.MN.SourceIdx = floor((Ret.GetPhysicalMove.Move / 100));
    Get.MN.TargetIdx = floor((Ret.GetPhysicalMove.Move % 100));
    Get.MN.Piece = Board[floor((Move / 100))];
    If ((Get.MN.Piece == GoK_BlackBishop) Or (Get.MN.Piece == GoK_WhiteBishop))
    {
        Ret.GetMoveNotation.Notation = "B";
    }
    If ((Get.MN.Piece == GoK_BlackKing) Or (Get.MN.Piece == GoK_WhiteKing))
    {
        Ret.GetMoveNotation.Notation = "K";
    }
    If ((Get.MN.Piece == GoK_BlackRook) Or (Get.MN.Piece == GoK_WhiteRook))
    {
        Ret.GetMoveNotation.Notation = "R";
    }
    If ((Get.MN.Piece == GoK_BlackKnight) Or (Get.MN.Piece == GoK_WhiteKnight))
    {
        Ret.GetMoveNotation.Notation = "N";
    }
    If ((Get.MN.Piece == GoK_WhiteQueen) Or (Get.MN.Piece == GoK_BlackQueen))
    {
        Ret.GetMoveNotation.Notation = "Q";
    }
    Get.MN.File = IdxToFile[Get.MN.SourceIdx];
    Get.MN.NotationRank = (9 - IdxToRank[Get.MN.SourceIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", Get.MN.File), Get.MN.NotationRank));
    If (Not ((Board[floor((Move % 100))] == 0)))
    {
        Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "x");
    }
    Get.MN.File = IdxToFile[Get.MN.TargetIdx];
    Get.MN.NotationRank = (9 - IdxToRank[Get.MN.TargetIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", Get.MN.File), Get.MN.NotationRank));
    If (Operator.LetterOf(Ret.GetPhysicalMove.Move, (Variable.Length(Ret.GetPhysicalMove.Move) - 1)) == ".")
    {
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 1)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=Q");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 2)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=R");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 3)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=B");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 4)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=N");
        }
    }
}

Define GetMoveScore(string SourcePieceParam)(string TargetPieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply) (warp=true)
{
    Ret.GetMoveScore.Score = 0;
    Call IsMovePicked(Ply)(Move);
    If (Ret.IsMovePicked.Picked == 1)
    {
        Ret.GetMoveScore.Score = Ret.IsMovePicked.Score;
        Stop(this script);
    }
    Call //("1: Hash moves, handled by staged move generator / PickMove()");
    If (CheckedState[Ply] == 1)
    {
        If ((abs(SourcePieceParam) == GoK_BlackKing) Or (BoardAttackedEvasionTarget[ToIdx] == 1))
        {
            Ret.GetMoveScore.Score = 8000000;
            If ((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0))))
            {
                Ret.GetMoveScore.Score += (100000 + ((PieceIdxLookup[abs(TargetPieceParam)] * 100) + (7 - PieceIdxLookup[abs(SourcePieceParam)])));
            }
            Else
            {
                Get.MS.ContMoveScore = 0;
                If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
                {
                    Get.MS.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                    Get.MS.ContMoveScore = (2 * HistoryContinuation[(PlyContinuationBaseIdx[Ply] + Get.MS.Idx)]);
                }
                Ret.GetMoveScore.Score += ((2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]) + Get.MS.ContMoveScore);
            }
            Stop(this script);
        }
    }
    If (Not ((Move == floor(Move))))
    {
        Call //("Promotions");
        If (((Move * 10) % 10) == 1)
        {
            If (Board[floor((Move % 100))] == 0)
            {
                Ret.GetMoveScore.Score = 7000000;
            }
            Else
            {
                Get.MS.PieceIdx = PieceIdxLookup[abs(Board[floor((Move % 100))])];
                Get.MS.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((Get.MS.PieceIdx - 1) * 64) + floor((Move % 100)))) + (2304 * (SourcePieceParam < 0)));
                Ret.GetMoveScore.Score = ((7000000 + (100000 * Get.MS.PieceIdx)) + HistoryCaptureScores[Get.MS.BaseIdx]);
            }
            Stop(this script);
        }
        Else
        {
            Call GetHistoryStatScore(SourcePieceParam)(floor((floor(Move) / 100)))(floor((Move % 100)))(floor(Move))(Ply);
            Ret.GetMoveScore.Score = (2100000 + Ret.GetHistoryStatScore.Score);
            Stop(this script);
        }
    }
    If (((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0)))) Or (((abs(SourcePieceParam) == GoK_BlackPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx]))))))
    {
        Get.MS.TargetPiece = TargetPieceParam;
        If (((abs(SourcePieceParam) == GoK_BlackPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))))
        {
            Get.MS.TargetPiece = (0 - SourcePieceParam);
        }
        Get.MS.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((PieceIdxLookup[abs(Get.MS.TargetPiece)] - 1) * 64) + ToIdx)) + (2304 * (SourcePieceParam < 0)));
        Get.MS.BaseScore = 7100000;
        If (Not (((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 1))))
        {
            If (Not (((PieceIdxLookup[abs(Get.MS.TargetPiece)] + 1) > PieceIdxLookup[abs(SourcePieceParam)])))
            {
                If (Not ((Glob.IsScratch3 == 1)))
                {
                    Call ClearMoveList((Ply + 2));
                    Call AddMoveToList(Move)((Ply + 2))(0);
                    List.ReplaceItem(MovesIdx, (Ply + 2), 1);
                    Call ApplyMoveLight((Ply + 2));
                    Call SEE((Ply + 2))((1 == 0));
                    Get.MS.SEEGain = Ret.SEE.Gain;
                    Call RevertMoveLight((Ply + 2));
                    If (Not ((Not ((Get.MS.SEEGain < (-50 - (abs(Get.MS.TargetPiece) / 4)))))))
                    {
                        Get.MS.BaseScore = 1000000;
                    }
                }
            }
        }
        Ret.GetMoveScore.Score = ((Get.MS.BaseScore + (6 * abs(Get.MS.TargetPiece))) + HistoryCaptureScores[Get.MS.BaseIdx]);
        Stop(this script);
    }
    Call //("4: Killer moves");
    Call PrepareCurrentKillerMoves(Ply);
    If ((Not ((CurrentKillerMoves[1] == Const.Null))) And (CurrentKillerMoves[1] == Move))
    {
        Ret.GetMoveScore.Score = 6000000;
        Stop(this script);
    }
    Else
    {
        If ((Not ((CurrentKillerMoves[2] == Const.Null))) And (CurrentKillerMoves[2] == Move))
        {
            Ret.GetMoveScore.Score = 5000000;
            Stop(this script);
        }
    }
    Call //("5. Counter Moves");
    If (Ply > 1)
    {
        If ((Not ((AppliedMove[(Ply - 1)] == Const.Null))) And (HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))] == Move))
        {
            Ret.GetMoveScore.Score = 4000000;
            Stop(this script);
        }
    }
    Call //("6: Quiets with high history score");
    Ret.GetMoveScore.Score = 2100000;
    Call GetHistoryStatScore(SourcePieceParam)(FromIdx)(ToIdx)(Move)(Ply);
    Ret.GetMoveScore.Score += Ret.GetHistoryStatScore.Score;
    If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
    {
        If (BoardAttackedCalculated[Ply] == 1)
        {
            Get.MS.PieceAbs = abs(SourcePieceParam);
            If ((Get.MS.PieceAbs > GoK_BlackPawn) And (Get.MS.PieceAbs < GoK_BlackKing))
            {
                Get.MS.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + FromIdx);
                If (BoardAttackedByOpponentSnapshot[Get.MS.AttackIdx] > 0)
                {
                    Get.MS.ThreatenedByPieceAbs = abs(Board[BoardAttackedByOpponentPieceSnapshot[Get.MS.AttackIdx]]);
                    If (((Get.MS.PieceAbs == GoK_BlackQueen) And (Get.MS.ThreatenedByPieceAbs < GoK_BlackQueen)) Or (((Get.MS.PieceAbs == GoK_BlackRook) And (Get.MS.ThreatenedByPieceAbs < GoK_BlackRook)) Or (((Get.MS.PieceAbs == GoK_BlackKnight) Or (Get.MS.PieceAbs == GoK_BlackBishop)) And (Get.MS.ThreatenedByPieceAbs == GoK_BlackPawn))))
                    {
                        Get.MS.ThreatenedByPieceAbs = 0;
                        Get.MS.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + ToIdx);
                        If (BoardAttackedByOpponentSnapshot[Get.MS.AttackIdx] > 0)
                        {
                            Get.MS.ThreatenedByPieceAbs = abs(Board[BoardAttackedByOpponentPieceSnapshot[Get.MS.AttackIdx]]);
                        }
                        If (Get.MS.ThreatenedByPieceAbs < GoK_BlackKing)
                        {
                            If ((Get.MS.PieceAbs == GoK_BlackQueen) And ((Get.MS.ThreatenedByPieceAbs == 0) Or (Get.MS.ThreatenedByPieceAbs == GoK_BlackQueen)))
                            {
                                Ret.GetMoveScore.Score += 50000;
                            }
                            Else
                            {
                                If ((Get.MS.PieceAbs == GoK_BlackRook) And ((Get.MS.ThreatenedByPieceAbs == 0) Or (Get.MS.ThreatenedByPieceAbs > GoK_BlackBishop)))
                                {
                                    Ret.GetMoveScore.Score += 25000;
                                }
                                Else
                                {
                                    If ((Get.MS.ThreatenedByPieceAbs == 0) Or (Get.MS.ThreatenedByPieceAbs > GoK_BlackPawn))
                                    {
                                        Ret.GetMoveScore.Score += 15000;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define GetNormalizedMove(string Move) (warp=true)
{
    If (Move == floor(Move))
    {
        Ret.GetNormalizedMove.Move = MoveToZeroPaddedStr[(Move + 1)];
    }
    Else
    {
        Ret.GetNormalizedMove.Move = Operator.Join(MoveToZeroPaddedStr[(floor(Move) + 1)], Operator.Join(".", Operator.LetterOf(Move, Variable.Length(Move))));
    }
}

Define GetOpeningMoves (warp=true)
{
    List.DeleteItem(OpeningMovesRes, all);
    If (1 == 1)
    {
        Call GenerateMovesPublic(1);
        Call CreateCurrentBoardHash;
        Get.OM.OpeningMovesMapMoveIdx = 1;
        Repeat (List.Length(OpeningMovesMapHash))
        {
            If (OpeningMovesMapHash[Get.OM.OpeningMovesMapMoveIdx] == Glob.CurrentBoardHash)
            {
                If List.ContainsItem(Moves1, OpeningMovesMapMove[Get.OM.OpeningMovesMapMoveIdx])
                {
                    List.Add(OpeningMovesRes, OpeningMovesMapMove[Get.OM.OpeningMovesMapMoveIdx]);
                }
            }
            Get.OM.OpeningMovesMapMoveIdx += 1;
        }
    }
}

Define GetPawnHistHash(string From)(string To) (warp=true)
{
    Call GetPiecePosHash(Board[Glob.WhiteKingIdx])(Glob.WhiteKingIdx);
    Call GetPiecePosHash(Board[Glob.BlackKingIdx])(Glob.BlackKingIdx);
    Call GetPiecePosHash(GoK_WhitePawn)(From);
    Call GetPiecePosHash(GoK_WhitePawn)(To);
}

Define GetPhysicalMove(num Move) (warp=true)
{
    If (Glob.IsPlayerBlack == 0)
    {
        Ret.GetPhysicalMove.Move = Move;
    }
    Else
    {
        If (Not ((floor((Move / 100)) == 0)))
        {
            Ret.GetPhysicalMove.Move = ((RankFlipIdx[floor((Move / 100))] * 100) + RankFlipIdx[floor((Move % 100))]);
            If (Operator.LetterOf(Move, (Variable.Length(Move) - 1)) == ".")
            {
                Ret.GetPhysicalMove.Move = (Ret.GetPhysicalMove.Move + (0.1 * Operator.LetterOf(Move, Variable.Length(Move))));
            }
        }
        Else
        {
            If (Move == GoK_BlackKingsideCastling)
            {
                Ret.GetPhysicalMove.Move = GoK_WhiteKingsideCastling;
            }
            Else
            {
                If (Move == GoK_BlackQueensideCastling)
                {
                    Ret.GetPhysicalMove.Move = GoK_WhiteQueensideCastling;
                }
                Else
                {
                    If (Move == GoK_WhiteKingsideCastling)
                    {
                        Ret.GetPhysicalMove.Move = GoK_BlackKingsideCastling;
                    }
                    Else
                    {
                        If (Move == GoK_WhiteQueensideCastling)
                        {
                            Ret.GetPhysicalMove.Move = GoK_BlackQueensideCastling;
                        }
                    }
                }
            }
        }
    }
}

Define GetPiecePosEval(string Piece)(string Idx) (warp=true)
{
    Ret.GetPiecePosEval.Score = 0;
    If ((Idx == 0) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece == GoK_BlackPawn)
    {
        If (Glob.IsEndgame == 0)
        {
            Ret.GetPiecePosEval.Score = (PawnPieceSquare[Idx] + 0);
        }
        Else
        {
            Ret.GetPiecePosEval.Score = (PawnPieceSquareEndgame[Idx] + 0);
        }
        Stop(this script);
    }
    If (Piece == GoK_WhitePawn)
    {
        If (Glob.IsEndgame == 0)
        {
            Ret.GetPiecePosEval.Score = (0 - PawnPieceSquare[RankFlipIdx[(Idx + 0)]]);
        }
        Else
        {
            Ret.GetPiecePosEval.Score = (0 - PawnPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
        }
        Stop(this script);
    }
    If (Glob.IsEndgame == 1)
    {
        If (Piece > GoK_BlackBishop)
        {
            If (Piece == GoK_BlackKing)
            {
                If ((Glob.RootBlackPawnCount == 0) And ((Glob.RootBlackQueenCount + Glob.RootBlackNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((1.33 * KingPieceSquareEndgame[Idx]));
                    Stop(this script);
                }
                If ((Glob.RootWhitePawnCount == 0) And ((Glob.RootWhiteQueenCount + Glob.RootWhiteNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((0.67 * KingPieceSquareEndgame[Idx]));
                    Stop(this script);
                }
                Ret.GetPiecePosEval.Score = (KingPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_BlackRook)
            {
                Ret.GetPiecePosEval.Score = (RookPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Piece == GoK_BlackQueen)
            {
                Ret.GetPiecePosEval.Score = (QueenPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
        }
        If (Piece > 0)
        {
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_BlackKnight)
            {
                Ret.GetPiecePosEval.Score = (KnightPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Piece == GoK_BlackBishop)
            {
                Ret.GetPiecePosEval.Score = (BishopPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
        }
        If (Piece < GoK_WhiteBishop)
        {
            If (Piece == GoK_WhiteKing)
            {
                If ((Glob.RootWhitePawnCount == 0) And ((Glob.RootWhiteQueenCount + Glob.RootWhiteNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((1.33 * (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]])));
                    Stop(this script);
                }
                If ((Glob.RootBlackPawnCount == 0) And ((Glob.RootBlackQueenCount + Glob.RootBlackNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((0.67 * (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]])));
                    Stop(this script);
                }
                Ret.GetPiecePosEval.Score = (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_WhiteRook)
            {
                Ret.GetPiecePosEval.Score = (0 - RookPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Piece == GoK_WhiteQueen)
            {
                Ret.GetPiecePosEval.Score = (0 - QueenPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
        }
        If (Piece < 0)
        {
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_WhiteBishop)
            {
                Ret.GetPiecePosEval.Score = (0 - BishopPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Piece == GoK_WhiteKnight)
            {
                Ret.GetPiecePosEval.Score = (0 - KnightPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
        }
        Stop(this script);
    }
    If (Piece > GoK_BlackBishop)
    {
        If (Piece == GoK_BlackRook)
        {
            Ret.GetPiecePosEval.Score = (RookPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackQueen)
        {
            Ret.GetPiecePosEval.Score = (QueenPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackKing)
        {
            Ret.GetPiecePosEval.Score = (KingPieceSquare[Idx] + 0);
            Stop(this script);
        }
    }
    If (Piece > 0)
    {
        If (Piece == GoK_BlackKnight)
        {
            Ret.GetPiecePosEval.Score = (KnightPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackBishop)
        {
            Ret.GetPiecePosEval.Score = (BishopPieceSquare[Idx] + 0);
            Stop(this script);
        }
    }
    If (Piece < GoK_WhiteBishop)
    {
        If (Piece == GoK_WhiteRook)
        {
            Ret.GetPiecePosEval.Score = (0 - RookPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteQueen)
        {
            Ret.GetPiecePosEval.Score = (0 - QueenPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteKing)
        {
            Ret.GetPiecePosEval.Score = (0 - KingPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
    }
    If (Piece < 0)
    {
        If (Piece == GoK_WhiteBishop)
        {
            Ret.GetPiecePosEval.Score = (0 - BishopPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteKnight)
        {
            Ret.GetPiecePosEval.Score = (0 - KnightPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
    }
}

Define GetPiecePosHash(string Piece)(string Pos) (warp=true)
{
    Ret.GetPiecePosHash.Hash = 0;
    If ((Not ((Pos > 0))) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[((64 * (PieceIdxLookup[(Piece + 0)] - 1)) + Pos)] + 0);
    }
    Else
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[(384 + ((64 * (PieceIdxLookup[abs(Piece)] - 1)) + Pos))] + 0);
    }
}

Define GetRepetitionCount (warp=true)
{
    Get.RC.BoardHistoryIdx = (List.Length(BoardHistory) - 2);
    Ret.GetRepetitionCount.Count = 1;
    Repeat Until (Get.RC.BoardHistoryIdx < 1)
    {
        If (BoardHistory[Get.RC.BoardHistoryIdx] == BoardHistory[List.Length(BoardHistory)])
        {
            Ret.GetRepetitionCount.Count += 1;
        }
        Get.RC.BoardHistoryIdx += -2;
    }
}

Define GetStaticEval(string Ply) (warp=true)
{
    If (StaticEval[Ply] == Const.Null)
    {
        Call Evaluate((Ply - 1))((1 == 1));
        Call AdjustEvalScore(Ply)(Ret.Evaluate.Score);
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.Evaluate.Score);
        Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(Const.Null)(Const.Null)(Const.TTType.None)(Const.Null)(Const.Null)(Ret.Evaluate.Score);
    }
}

Define GetSubstring(string Text)(num FromIdx)(num ToIdx) (warp=true)
{
    Get.Substring.CharIdx = FromIdx;
    Ret.GetSubstring.Substring = "";
    Repeat (((ToIdx - FromIdx) + 1))
    {
        Ret.GetSubstring.Substring = Operator.Join(Ret.GetSubstring.Substring, Operator.LetterOf(Text, Get.Substring.CharIdx));
        Get.Substring.CharIdx += 1;
    }
}

Define GetSubstringLeft(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(1)(Count);
    Ret.GetSubstringLeft.Substring = Ret.GetSubstring.Substring;
}

Define GetSubstringRight(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(((Variable.Length(Text) - Count) + 1))(Variable.Length(Text));
    Ret.GetSubstringRight.Substring = Ret.GetSubstring.Substring;
}

Define GetTargetIdx(num SourceIdx)(num DeltaX)(num DeltaY) (warp=true)
{
    Get.TI.File = (IdxToFile[SourceIdx] + DeltaX);
    Ret.GetTargetIdx.SqIdx = -1;
    If ((Get.TI.File > 0) And (Get.TI.File < 9))
    {
        Get.TI.Rank = (IdxToRank[SourceIdx] + DeltaY);
        If ((Get.TI.Rank > 0) And (Get.TI.Rank < 9))
        {
            Ret.GetTargetIdx.SqIdx = (Get.TI.File + ((Get.TI.Rank - 1) * 8));
        }
    }
}

Define GetTTNodeHash(string BoardHash)(string Ply) (warp=true)
{
    Ret.GetTTNodeHash.Hash = (PlyIsOwn[Ply] + 1);
    If (EnPassantTarget[Ply] == Const.Null)
    {
        GTTN.EnPassantIdx = 0;
    }
    Else
    {
        GTTN.EnPassantIdx = EnPassantTarget[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 67) + (GTTN.EnPassantIdx + 1));
    If (CastlingState[Ply] == Const.Null)
    {
        GTTN.Castling = 0;
    }
    Else
    {
        GTTN.Castling = CastlingState[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 11111117) + (GTTN.Castling + 1));
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 97) + BoardHash);
}

Define GivesCheckFast(string Ply) (warp=true)
{
    If (floor((AppliedMove[Ply] / 100)) == 0)
    {
        Call IsCheckedFast((Ply + 2));
        Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        GCF.FromIdx = floor((AppliedMove[Ply] / 100));
        GCF.ToIdx = floor((AppliedMove[Ply] % 100));
        If (Not ((TargetPiecesIdx[Ply] == GCF.ToIdx)))
        {
            Call IsCheckedFast((Ply + 2));
            Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            If (PlyIsOwn[Ply] == 1)
            {
                GCF.TheirKingIdx = Glob.WhiteKingIdx;
            }
            Else
            {
                GCF.TheirKingIdx = Glob.BlackKingIdx;
            }
            Ret.GivesCheckFast.GivesCheck = 0;
            If (Not ((abs(Board[GCF.ToIdx]) == GoK_BlackKing)))
            {
                Call IsReachableForAttack(Board[GCF.ToIdx])(GCF.ToIdx)(GCF.TheirKingIdx);
                GCF.IsReachable = Ret.IsReachableForAttack.IsReachable;
                Ret.GivesCheckFast.GivesCheck = GCF.IsReachable;
            }
            If (Ret.GivesCheckFast.GivesCheck == 0)
            {
                GCF.DiscoveryIdx = 1;
                Repeat (DiscoveryCount[Ply])
                {
                    If (DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + GCF.DiscoveryIdx)] == GCF.FromIdx)
                    {
                        If (Not ((abs(MoveToPathStepInc[((GCF.FromIdx * 100) + GCF.ToIdx)]) == DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + GCF.DiscoveryIdx)])))
                        {
                            Ret.GivesCheckFast.GivesCheck = 1;
                        }
                    }
                    GCF.DiscoveryIdx += 1;
                }
            }
            If (Glob.ProfilerMode == Const.ProfilerMode.On)
            {
                GCF.IsChecked = Ret.GivesCheckFast.GivesCheck;
                Call IsCheckedFast((Ply + 2));
                Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
                If (Not ((GCF.IsChecked == Ret.GivesCheckFast.GivesCheck)))
                {
                    Call Log("CheckInfoMismatch check depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(GCF.IsChecked)(" old=")(Ret.GivesCheckFast.GivesCheck);
                    Call Log("  detail pieceAtTo=")(Board[GCF.ToIdx])(" enemyK=")(GCF.TheirKingIdx)(" ira=")(GCF.IsReachable)(" discCount=")(DiscoveryCount[Ply]);
                    Call Log("  disc1=")(DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])(" ray1=")(DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])("")("")("")("");
                    Call Log("  board=")(Board)("")("")("")("")("")("");
                }
            }
        }
    }
}

Define ImportBoard(string ImpBoard) (warp=false)
{
    Call EnterExecution;
    Call ExportBoardFEN((1 == 1));
    IB.FEN = Ret.ExportBoardFEN.FEN;
    Call ImportBoardFEN(ImpBoard);
    IB.CharIdx = Ret.ImportBoardFEN.CharIdx;
    Call CalcBoardStats;
    If ((Glob.BlackKingIdx == Const.Null) Or (Glob.WhiteKingIdx == Const.Null))
    {
        Call SayAsync("Invalid FEN data")(5);
        Call ImportBoardFEN(IB.FEN);
        IB.CharIdx = Ret.ImportBoardFEN.CharIdx;
        Call CalcBoardStats;
    }
    Else
    {
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("Stg_FromSquareSelected");
        Event.BroadcastAndWait("Stg_ToSquareSelected");
        Glob.HasWhiteKingMoved = 0;
        Glob.HasBlackKingMoved = 0;
        Glob.HasWhiteCastled = 0;
        Glob.HasBlackCastled = 0;
        Glob.HasWhiteRookKSMoved = 0;
        Glob.HasWhiteRookQSMoved = 0;
        Glob.HasBlackRookKSMoved = 0;
        Glob.HasBlackRookQSMoved = 0;
        List.DeleteAll(GameMoves);
        List.DeleteItem(BoardHistory, all);
        List.DeleteItem(BoardHistoryFiftyMoves, all);
        List.DeleteItem(BoardHistoryHash, all);
        List.DeleteItem(BoardHistoryMetaState, all);
        List.DeleteItem(BoardHistoryWasEngineMove, all);
        List.DeleteItem(GameMovesAN, all);
        If (Not ((Board[1] == GoK_BlackRook)))
        {
            Glob.HasBlackRookQSMoved = 1;
        }
        If (Not ((Board[5] == GoK_BlackKing)))
        {
            Glob.HasBlackKingMoved = 1;
        }
        If (Not ((Board[8] == GoK_BlackRook)))
        {
            Glob.HasBlackRookKSMoved = 1;
        }
        If (Not ((Board[57] == GoK_WhiteRook)))
        {
            Glob.HasWhiteRookQSMoved = 1;
        }
        If (Not ((Board[61] == GoK_WhiteKing)))
        {
            Glob.HasWhiteKingMoved = 1;
        }
        If (Not ((Board[64] == GoK_WhiteRook)))
        {
            Glob.HasWhiteRookKSMoved = 1;
        }
        Call AddBoardToHistory("");
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        List.ReplaceItem(EnPassantTarget, 1, Const.Null);
        Call CalcBoardAttackedByMoveChecked(1);
        Call CalcBoardAttackedByMoveChecked(2);
        IB.CharIdx += 1;
        IB.Char = Operator.LetterOf(ImpBoard, IB.CharIdx);
        If (((IB.Char == "B") And (Glob.IsPlayerBlack == 0)) Or ((IB.Char == "W") And (Glob.IsPlayerBlack == 1)))
        {
            Call IsWhiteKingCheckMate;
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Call SayAsync("Checkmate!")(5);
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Call SayAsync("Draw!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
        Else
        {
            If (((IB.Char == "W") And (Glob.IsPlayerBlack == 0)) Or ((IB.Char == "B") And (Glob.IsPlayerBlack == 1)))
            {
                Call IsBlackKingCheckMate;
                If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
                {
                    Call SayAsync("Checkmate!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call IsDrawByStalemate(2);
                    If (Ret.IsDrawByStalemate.IsDraw == 1)
                    {
                        Call SayAsync("Draw!")(5);
                        GoK_IsGameSuspended = 1;
                    }
                }
            }
        }
    }
    Call ExitExecution;
}

Define ImportBoardFEN(string ImpBoard) (warp=false)
{
    List.DeleteAll(GoK_Board);
    IBFEN.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_Board, 0);
        IBFEN.SqIdx += 1;
    }
    IBFEN.SqIdx = 1;
    Ret.ImportBoardFEN.CharIdx = 1;
    Repeat Until (((IBFEN.SqIdx > 64) Or (IBFEN.SqIdx < 1)) Or (Ret.ImportBoardFEN.CharIdx > Variable.Length(ImpBoard)))
    {
        IBFEN.Char = Operator.LetterOf(ImpBoard, Ret.ImportBoardFEN.CharIdx);
        If ((Not ((IBFEN.Char < "A"))) And (Not ((IBFEN.Char > "Z"))))
        {
            IBFEN.Piece = 0;
            If (IBFEN.Char == "P")
            {
                IBFEN.Piece = GoK_BlackPawn;
            }
            If (IBFEN.Char == "N")
            {
                IBFEN.Piece = GoK_BlackKnight;
            }
            If (IBFEN.Char == "B")
            {
                IBFEN.Piece = GoK_BlackBishop;
            }
            If (IBFEN.Char == "R")
            {
                IBFEN.Piece = GoK_BlackRook;
            }
            If (IBFEN.Char == "Q")
            {
                IBFEN.Piece = GoK_BlackQueen;
            }
            If (IBFEN.Char == "K")
            {
                IBFEN.Piece = GoK_BlackKing;
            }
            Call IsLowerCase(IBFEN.Char);
            If (Ret.IsLowerCase.IsLower == 0)
            {
                IBFEN.Piece = (IBFEN.Piece * -1);
            }
            List.ReplaceItem(GoK_Board, IBFEN.SqIdx, IBFEN.Piece);
            IBFEN.SqIdx += 1;
        }
        Else
        {
            If ((Not ((IBFEN.Char < 0))) And (Not ((IBFEN.Char > 9))))
            {
                Repeat (IBFEN.Char)
                {
                    List.ReplaceItem(GoK_Board, IBFEN.SqIdx, 0);
                    IBFEN.SqIdx += 1;
                }
            }
            Else
            {
                If (IBFEN.Char == "/")
                {
                    Repeat Until ((IBFEN.SqIdx % 8) == 1)
                    {
                        List.ReplaceItem(GoK_Board, IBFEN.SqIdx, 0);
                        IBFEN.SqIdx += 1;
                    }
                }
            }
        }
        Ret.ImportBoardFEN.CharIdx += 1;
    }
    Call LoadInternalBoard;
}

Define ImportBoardImpl(string ImpBoard) (warp=true)
{
    IBI.SqIdx = 1;
    IBI.CharIdx = 1;
    IBI.Piece = "";
    Repeat Until (IBI.CharIdx > Variable.Length(ImpBoard))
    {
        If (Operator.LetterOf(ImpBoard, IBI.CharIdx) == ",")
        {
            List.ReplaceItem(Board, IBI.SqIdx, IBI.Piece);
            IBI.SqIdx += 1;
            IBI.Piece = "";
        }
        Else
        {
            IBI.Piece = Operator.Join(IBI.Piece, Operator.LetterOf(ImpBoard, IBI.CharIdx));
        }
        IBI.CharIdx += 1;
    }
}

