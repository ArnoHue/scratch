            {
                NNUE_Evaluate.WordHigh = 181;
            }
            Ret.NNUE_Evaluate.Score += ((NNUE_Evaluate.WordHigh * NNUE_Evaluate.WordHigh) * floor(NNUE_HiddenWeights[((4 * NNUE_Evaluate.Idx) - 1)]));
        }
        NNUE_Evaluate.WordTop += -5600;
