//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Glob.VersionString = "Game of Kings Chess NNUE Version 7.3383.2641 (24.10.2026) by ArnoHu";
    Glob.IsTestRunning = 0;
    Glob.IsDCI = 0;
    Glob.IsNetworkDecoded = 0;
    Glob.Level = 3;
    GoK_Level = 3;
    GoK_ClockActive = 0;
    If is compiled?
    {
        Glob.IsScratch3 = 0;
    }
    Else
    {
        Glob.IsScratch3 = 1;
    }
    Call OnRestart;
}


//----- Key pressed events --------------------------------------------------------------------------------------------

WhenKeyPressed(l)
{
    List.Show(Logfile);
}

WhenKeyPressed(p)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.Off)
    {
        Glob.ProfilerMode = Const.ProfilerMode.Std;
        Call SayAsync("Profiling Standard")(2);
        Call PrepStats;
        Call ProfilerReset;
    }
    Else
    {
        If (Glob.ProfilerMode == Const.ProfilerMode.Std)
        {
            Glob.ProfilerMode = Const.ProfilerMode.Full;
            Call SayAsync("Profiling Full")(2);
        }
        Else
        {
            If (Glob.ProfilerMode == Const.ProfilerMode.Full)
            {
                Glob.ProfilerMode = Const.ProfilerMode.Off;
                Call SayAsync("Profiling Off")(2);
            }
        }
    }
}

WhenKeyPressed(d)
{
    If (Glob.DebugMode == 0)
    {
        Glob.DebugMode = 1;
        Variable.Show(Glob.IdxDeepening);
        Variable.Show(Glob.BestMoveEval);
        Variable.Show(Glob.BestMove);
        Variable.Show(Glob.NPS);
        Variable.Show(Glob.MPS);
        Variable.Show(Glob.PV);
    }
    Else
    {
        Glob.DebugMode = 0;
        Variable.Hide(Glob.IdxDeepening);
        Variable.Hide(Glob.BestMoveEval);
        Variable.Hide(Glob.BestMove);
        Variable.Hide(Glob.NPS);
        Variable.Hide(Glob.MPS);
        Variable.Hide(Glob.PV);
    }
}

WhenKeyPressed(v)
{
    Call SayAsync(Glob.VersionString)(5);
}

WhenKeyPressed(r)
{
    List.Show(ProfilingData);
}

WhenKeyPressed(u)
{
    List.DeleteAll(Logfile);
    Sensing.Ask("Perft depth? (1 - 4, blank to skip)");
    TST.Ask.PerftPly = Sensing.Answer();
    Sensing.Ask("How many search tests? (1 - 218, blank to skip)");
    TST.Ask.PositionCount = Sensing.Answer();
    Sensing.Ask("Think time per test, in seconds?");
    TST.Ask.ThinkTime = Sensing.Answer();
    List.Show(Logfile);
    Call EnterExecution;
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call TestPerft(TST.Ask.PerftPly);
    Call TestSuite(TST.Ask.PositionCount)(TST.Ask.ThinkTime);
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call DrawBoardAndWait;
    Call ExitExecution;
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived($gok_nnue)
{
    Glob.IsDCI = 1;
    Call ​​log​​("$gok1");
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Call IsOwnKingCheckMate;
    If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
    {
        If (_dci turn == 1)
        {
            _dci evaluation = "-M0";
        }
        Else
        {
            _dci evaluation = "M0";
        }
        Event.BroadcastAndWait("gui refresh stats");
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: invoked on opp mate");
        Stop(this script);
    }
    Else
    {
        DCI.IsClaimAllowed = 1;
        If (Not ((Glob.PrevMoveEval == Const.Null)))
        {
            If (Glob.PrevMoveEval > Const.DrawByRepetitionEval)
            {
                DCI.IsClaimAllowed = 0;
            }
        }
        Call GetRepetitionCount;
        If ((Ret.GetRepetitionCount.Count > 2) And (DCI.IsClaimAllowed == 1))
        {
            List.Add(_dci, "draw?");
            Event.Broadcast("dci message");
            Call ​​warn​​("$gok: invoked on draw-by-rep");
            Stop(this script);
        }
        Else
        {
            Call IsDrawByMaterial;
            If (Ret.IsDrawByMaterial.IsDraw == 1)
            {
                List.Add(_dci, "draw?");
                Event.Broadcast("dci message");
                Call ​​warn​​("$gok: invoked on draw-by-material");
                Stop(this script);
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    List.Add(_dci, "draw?");
                    Event.Broadcast("dci message");
                    Call ​​warn​​("$gok: invoked on draw-by-stalemate");
                    Stop(this script);
                }
            }
        }
    }
    Call ​​log​​("$gok2");
    DCI.Move = Const.Null;
    Call GetOpeningMoves;
    If (List.Length(OpeningMovesRes) > 0)
    {
        DCI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
        Glob.BestMoveEval = 0;
        Glob.PV = "book";
        If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
        {
            Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockTimeInc);
            Glob.ClockMoveCount += 1;
            If ((Glob.ClockStageMoves > 0) And (Glob.ClockMoveCount == Glob.ClockStageMoves))
            {
                Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockStageTime);
            }
        }
    }
    Else
    {
        Call GetBestMoveDeepening.Prepare;
        Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
        Repeat Until (Glob.IsDeepeningDone == 1)
        {
            Call GetBestMoveDCI.Slice;
            If ((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0))
            {
                Event.Broadcast("gui clock refresh");
            }
        }
        DCI.Move = Ret.GetBestMoveDCI.Move;
    }
    Call ​​log​​("$gok3");
    If (DCI.Move == Const.Null)
    {
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: search system error => resigning");
        Stop(this script);
    }
    Call ​​log​​("$gok4");
    Call ClearMoveList(1);
    Call AddMoveToList(DCI.Move)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1)((1 == 0));
    Call AddBoardToHistory(1);
    List.ReplaceItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState), CastlingState[1]);
    Call RevertMove(1);
    Call GetMoveNotation(DCI.Move);
    If (Ret.GetMoveNotation.Notation == "O-O")
    {
        If (Glob.IsPlayerBlack == 0)
        {
            List.Add(_dci, "me8g8");
        }
        Else
        {
            List.Add(_dci, "me1g1");
        }
    }
    Else
    {
        If (Ret.GetMoveNotation.Notation == "O-O-O")
        {
            If (Glob.IsPlayerBlack == 0)
            {
                List.Add(_dci, "me8c8");
            }
            Else
            {
                List.Add(_dci, "me1c1");
            }
        }
        Else
        {
            DCI.PromotionCode = Operator.Round(((Ret.GetMoveNotation.VirtualMove * 10) % 10));
            DCI.PromotionLetter = "";
            If (DCI.PromotionCode == 1)
            {
                DCI.PromotionLetter = "q";
            }
            If (DCI.PromotionCode == 2)
            {
                DCI.PromotionLetter = "r";
            }
            If (DCI.PromotionCode == 3)
            {
                DCI.PromotionLetter = "b";
            }
            If (DCI.PromotionCode == 4)
            {
                DCI.PromotionLetter = "n";
            }
            List.Add(_dci, Operator.Join(Operator.Join("m", Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join((9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove % 100))]), (9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove % 100))]))))), DCI.PromotionLetter));
        }
    }
    Call ​​log​​("$gok5");
    If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
    {
        _dci clock = (Operator.Round(((Glob.CurrentClockTime + Glob.ClockTimeInc) * 10)) / 10);
    }
    Else
    {
        _dci clock = "";
    }
    _dci pv = Glob.PV;
    If (Glob.PV == "book")
    {
        _dci search depth = "";
    }
    Else
    {
        _dci search depth = (Glob.IdxDeepening - Glob.IsSearchTimeout);
    }
    If (Not ((Glob.BestMoveEval == Const.Null)))
    {
        DCI.WhiteEval = (Glob.BestMoveEval * _dci turn);
        If (abs(Glob.BestMoveEval) > Const.AbsMinCheckmateEval)
        {
            _dci evaluation = Operator.Join("M", ceiling((((100000 - abs(Glob.BestMoveEval)) - List.Length(BoardHistoryFiftyMoves)) / 2)));
            If (DCI.WhiteEval < 0)
            {
                _dci evaluation = Operator.Join("-", _dci evaluation);
            }
        }
        Else
        {
            _dci evaluation = (DCI.WhiteEval / 100);
        }
    }
    Event.BroadcastAndWait("gui refresh stats");
    Event.Broadcast("dci message");
    Call ​​log​​("$gok6");
}

WhenBroadcastReceived($gok_nnue draw?)
{
    Glob.IsDCI = 1;
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Glob.BestMoveEval = 0;
    DCI.SavedClockTime = Glob.CurrentClockTime;
    DCI.SavedClockMoveCount = Glob.ClockMoveCount;
    DCI.SavedPrevMoveEval = Glob.PrevMoveEval;
    DCI.SavedAvgCompletedDepth = Glob.AvgCompletedDepth;
    Call GetBestMoveDeepening.Prepare;
    Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveDCI.Slice;
    }
    List.DeleteItem(BoardHistory, List.Length(BoardHistory));
    List.DeleteItem(BoardHistoryHash, List.Length(BoardHistoryHash));
    List.DeleteItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState));
    List.DeleteItem(BoardHistoryWasEngineMove, List.Length(BoardHistoryWasEngineMove));
    Glob.CurrentClockTime = DCI.SavedClockTime;
    Glob.ClockMoveCount = DCI.SavedClockMoveCount;
    Glob.PrevMoveEval = DCI.SavedPrevMoveEval;
    Glob.AvgCompletedDepth = DCI.SavedAvgCompletedDepth;
    If (Glob.BestMoveEval == Const.Null)
    {
        List.Add(_dci, "decline");
    }
    Else
    {
        If (Glob.BestMoveEval < 0)
        {
            List.Add(_dci, "accept");
        }
        Else
        {
            List.Add(_dci, "decline");
        }
    }
    Event.Broadcast("dci message");
}

WhenBroadcastReceived($gok_nnue stop)
{
    Glob.IsDCI = 1;
    Glob.IsSearchTimeout = 1;
}

WhenBroadcastReceived(dci new game)
{
    Glob.IsPlayerBlack = Const.Null;
    GoK_IsGameSuspended = 0;
    List.DeleteAll(BoardHistory);
    List.DeleteAll(BoardHistoryFiftyMoves);
    List.DeleteAll(BoardHistoryHash);
    List.DeleteAll(BoardHistoryMetaState);
    List.DeleteAll(BoardHistoryWasEngineMove);
    List.DeleteAll(GameMovesAN);
    List.DeleteAll(GameMoves);
    Glob.CurrentClockTime = Const.Null;
    Glob.ClockMoveCount = 0;
    Glob.IsTimeModelLogged = 0;
    Glob.PrevMoveEval = Const.Null;
    Glob.AvgCompletedDepth = Const.Null;
}

WhenBroadcastReceived(dci register)
{
    List.Add(_dci engines, "gok_nnue");
}

WhenBroadcastReceived(GoK_ClockClicked)
{
    Call AskTimeControl;
    If (Ret.AskTimeControl.IsSet == 1)
    {
        GoK_ClockActive = 1;
        Glob.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
        Glob.PlayerClockRunning = 1;
    }
    Else
    {
        Glob.TimeControl = 0;
        Glob.CustomThinkTime = 0;
        Glob.CustomMaxDepth = 0;
        Glob.InitialClockTime = 0;
        Glob.ClockTimeInc = 0;
        Glob.ClockStageMoves = 0;
        Glob.ClockStageTime = 0;
        Glob.CurrentClockTime = 0;
        Glob.ClockMoveCount = 0;
        Glob.PlayerClockTime = 0;
        Glob.PlayerClockMoveCount = 0;
        Glob.PlayerClockRunning = 0;
        GoK_ClockActive = 0;
    }
    Event.Broadcast("GoK_LevelChanged");
}

WhenBroadcastReceived(GoK_LevelChanged)
{
    Glob.Level = GoK_Level;
    Call PublishTimers(0);
    Call DrawBoardAndWait;
}

WhenBroadcastReceived(GoK_StartGame)
{
    Motion.GoToXY(120, 120);
    Glob.ExecutionPly = 0;
    Glob.IsExecutionRunning = 0;
    Glob.IsPlayerBlack = GoK_IsPlayerBlack;
    Call EnterExecution;
    Call InitBoard;
    Call DrawBoardAndWait;
    Looks.Say("Initializing engine, please wait...");
    Control.Wait(0.1);
    Call InitBoardPhase2;
    Control.Wait(0.1);
    Call ExitExecution;
    Call ExecuteInit;
    Looks.Say("");
}

WhenBroadcastReceived(sayasyncmsg)
{
    Looks.Say(Glob.SayAsyncText, Glob.SayAsyncDuration);
}

WhenBroadcastReceived(showmoves)
{
    Call ExportMovesPGN;
    List.DeleteItem(ExportMoves, all);
    List.Add(ExportMoves, Ret.ExportMovesPGN.PGN);
    List.Show(ExportMoves);
    Call SayAsync("You can copy PGN data to the clipboard via Ctrl-C")(5);
}

WhenBroadcastReceived(Stg_FromSquareSelected)
{
    If ((Glob.IsAdvisorEnabled == 1) And (Not ((Stg_FromSquareIdx == -1))))
    {
        Stg_BestMoveFromIdx = Stg_FromSquareIdx;
        List.DeleteAll(Selection_UserMoveTargets);
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            Call GetCurrentMove(2);
            FSS.Move = Ret.GetCurrentMove.Move;
            If (floor((FSS.Move / 100)) == GoK_ScreenIdx[Stg_FromSquareIdx])
            {
                Call ApplyMove(2)((1 == 1));
                Call CalcBoardAttackedByMove(3);
                Call RevertMove(2);
                If (Glob.IsWhiteChecked == 0)
                {
                    List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[floor((FSS.Move % 100))]);
                }
            }
            Else
            {
                If (Board[GoK_ScreenIdx[Stg_FromSquareIdx]] == GoK_WhiteKing)
                {
                    If (FSS.Move == GoK_WhiteKingsideCastling)
                    {
                        List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[63]);
                    }
                    Else
                    {
                        If (FSS.Move == GoK_WhiteQueensideCastling)
                        {
                            List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[59]);
                        }
                    }
                }
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
        Event.BroadcastAndWait("UI_StampUserMoveTargets");
    }
}

WhenBroadcastReceived(Stg_SquareClicked)
{
    If ((Glob.IsExecutionRunning == 0) And (GoK_IsGameSuspended == 0))
    {
        Call EnterExecution;
        If (Board[GoK_ScreenIdx[Stg_SquareClickedIdx]] < 0)
        {
            Glob.MoveFromIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
            Stg_FromSquareIdx = Stg_SquareClickedIdx;
            Event.BroadcastAndWait("Stg_FromSquareSelected");
        }
        Else
        {
            If ((Not ((Glob.MoveFromIdx == -1))) And (Not ((Stg_FromSquareIdx == -1))))
            {
                Glob.MoveToIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
                Stg_ToSquareIdx = Stg_SquareClickedIdx;
                If ((Board[Glob.MoveFromIdx] < 0) And (Not ((Glob.MoveFromIdx == Glob.MoveToIdx))))
                {
                    Stg_BestMoveFromIdx = Stg_FromSquareIdx;
                    Stg_BestMoveToIdx = Stg_ToSquareIdx;
                    Event.BroadcastAndWait("UI_ShowBestMove");
                }
                Event.BroadcastAndWait("Stg_ToSquareSelected");
                If ((Board[Glob.MoveFromIdx] < 0) And (Not ((Glob.MoveFromIdx == Glob.MoveToIdx))))
                {
                    Glob.UserMove = "";
                    If ((Board[Glob.MoveFromIdx] == GoK_WhiteKing) And (Glob.MoveFromIdx == 61))
                    {
                        If ((Glob.MoveToIdx == 59) And (Board[57] == GoK_WhiteRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_WhiteQueensideCastling)
                            {
                                Glob.UserMove = GoK_WhiteQueensideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(61, 59);
                            }
                        }
                        If ((Glob.MoveToIdx == 63) And (Board[64] == GoK_WhiteRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_WhiteKingsideCastling)
                            {
                                Glob.UserMove = GoK_WhiteKingsideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(61, 63);
                            }
                        }
                    }
                    If (Glob.UserMove == "")
                    {
                        Glob.UserMove = ((Glob.MoveFromIdx * 100) + Glob.MoveToIdx);
                        If ((Board[Glob.MoveFromIdx] == GoK_WhitePawn) And (Glob.MoveToIdx < 9))
                        {
                            Glob.UserMove = (Glob.UserMove + 0.1);
                        }
                    }
                    Call ExecuteUserMove(Glob.UserMove);
                }
            }
        }
        Call ExitExecution;
    }
}

WhenBroadcastReceived(Stg_StageClicked)
{
    List.Hide(ExportMoves);
    List.Hide(ExportData);
    List.Hide(CreditsData);
    List.Hide(Logfile);
    List.Hide(ProfilingData);
    If (Glob.IsExecutionRunning == 0)
    {
        Looks.Say("");
    }
}

WhenBroadcastReceived(Stg_TriggerRestart)
{
    Call OnRestart;
}

WhenBroadcastReceived(Timers_PlayerTimeout)
{
    If (((Glob.IsExecutionRunning == 0) And (GoK_IsGameSuspended == 0)) And (((Glob.TimeControl == 1) And ((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0))) And (Glob.CustomMaxDepth == 0)))
    {
        Looks.Say("Player out of time");
        GoK_IsGameSuspended = 1;
    }
}

WhenBroadcastReceived(UI_AdvisorClicked)
{
    If (Glob.IsExecutionRunning == 0)
    {
        If (Glob.IsAdvisorEnabled == 1)
        {
            Glob.IsAdvisorEnabled = 0;
            Call DrawBoardAndWait;
        }
        Else
        {
            Glob.IsAdvisorEnabled = 1;
            If (Not ((Stg_FromSquareIdx == -1)))
            {
                Event.BroadcastAndWait("Stg_FromSquareSelected");
            }
        }
    }
}

