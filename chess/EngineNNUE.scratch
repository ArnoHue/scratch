Define InitMoveLookup (warp=true)
{
    List.DeleteItem(KnightMoveOffsets, all);
    List.DeleteItem(KingMoveOffsets, all);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 1);
    List.DeleteItem(MoveSlidingStraightListIdxToTargetIdx, all);
    List.DeleteItem(MoveCrossListIdxToTargetIdx, all);
    List.DeleteItem(MoveSlidingStraighOffsetIdxToDelta, all);
    List.DeleteItem(MoveCrossOffsetIdxToDelta, all);
    List.DeleteItem(MoveListOffsetToTargetIdxKnight, all);
    List.DeleteItem(MoveListOffsetToTargetIdxKing, all);
    List.DeleteItem(MoveSourceIdxToListOffsetNonSliding, all);
    List.DeleteItem(MoveSourceIdxToListOffsetSliding, all);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 1);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 1);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, -1);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        Init.ML.ToSqIdx = 1;
        Repeat (4)
        {
            Init.ML.File = IdxToFile[Init.ML.FromSqIdx];
            Init.ML.Rank = IdxToRank[Init.ML.FromSqIdx];
            Repeat (8)
            {
                Init.ML.File += MoveSlidingStraighOffsetIdxToDelta[Init.ML.ToSqIdx];
                Init.ML.Rank += MoveSlidingStraighOffsetIdxToDelta[(Init.ML.ToSqIdx + 1)];
                List.Add(MoveSlidingStraightListIdxToTargetIdx, -1);
                If ((Init.ML.Rank > 0) And (Init.ML.Rank < 9))
                {
                    If ((Init.ML.File > 0) And (Init.ML.File < 9))
                    {
                        Init.ML.TargetIdx = (Init.ML.File + ((Init.ML.Rank - 1) * 8));
                        List.ReplaceItem(MoveSlidingStraightListIdxToTargetIdx, List.Length(MoveSlidingStraightListIdxToTargetIdx), Init.ML.TargetIdx);
                    }
                }
            }
            Init.ML.ToSqIdx += 2;
        }
        Init.ML.ToSqIdx = 1;
        Repeat (4)
        {
            Init.ML.File = IdxToFile[Init.ML.FromSqIdx];
            Init.ML.Rank = IdxToRank[Init.ML.FromSqIdx];
            Repeat (8)
            {
                Init.ML.File += MoveCrossOffsetIdxToDelta[Init.ML.ToSqIdx];
                Init.ML.Rank += MoveCrossOffsetIdxToDelta[(Init.ML.ToSqIdx + 1)];
                List.Add(MoveCrossListIdxToTargetIdx, -1);
                If ((Init.ML.Rank > 0) And (Init.ML.Rank < 9))
                {
                    If ((Init.ML.File > 0) And (Init.ML.File < 9))
                    {
                        Init.ML.TargetIdx = (Init.ML.File + ((Init.ML.Rank - 1) * 8));
                        List.ReplaceItem(MoveCrossListIdxToTargetIdx, List.Length(MoveCrossListIdxToTargetIdx), Init.ML.TargetIdx);
                    }
                }
            }
            Init.ML.ToSqIdx += 2;
        }
        Init.ML.FromSqIdx += 1;
    }
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        List.Add(MoveSourceIdxToListOffsetNonSliding, ((Init.ML.FromSqIdx - 1) * 8));
        List.Add(MoveSourceIdxToListOffsetSliding, ((Init.ML.FromSqIdx - 1) * 32));
        Init.ML.FromSqIdx += 1;
    }
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        Init.ML.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(Init.ML.FromSqIdx)(KingMoveOffsets[Init.ML.ToSqIdx])(KingMoveOffsets[(Init.ML.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveListOffsetToTargetIdxKing, Ret.GetTargetIdx.SqIdx);
            }
            Init.ML.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveListOffsetToTargetIdxKing) == (Init.ML.FromSqIdx * 8))
        {
            List.Add(MoveListOffsetToTargetIdxKing, -1);
        }
        Init.ML.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(Init.ML.FromSqIdx)(KnightMoveOffsets[Init.ML.ToSqIdx])(KnightMoveOffsets[(Init.ML.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveListOffsetToTargetIdxKnight, Ret.GetTargetIdx.SqIdx);
            }
            Init.ML.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveListOffsetToTargetIdxKnight) == (Init.ML.FromSqIdx * 8))
        {
            List.Add(MoveListOffsetToTargetIdxKnight, -1);
        }
        Init.ML.FromSqIdx += 1;
    }
    List.DeleteItem(MoveToPathDelta, all);
    List.DeleteItem(MoveToPathStepInc, all);
    List.DeleteItem(MoveToZeroPaddedStr, all);
    Init.ML.FromSqIdx = 0;
    Repeat (10000)
    {
        If (Init.ML.FromSqIdx < 10)
        {
            List.Add(MoveToZeroPaddedStr, Operator.Join(000, Init.ML.FromSqIdx));
        }
        Else
        {
            If (Init.ML.FromSqIdx < 100)
            {
                List.Add(MoveToZeroPaddedStr, Operator.Join(00, Init.ML.FromSqIdx));
            }
            Else
            {
                If (Init.ML.FromSqIdx < 1000)
                {
                    List.Add(MoveToZeroPaddedStr, Operator.Join(0, Init.ML.FromSqIdx));
                }
                Else
                {
                    List.Add(MoveToZeroPaddedStr, Init.ML.FromSqIdx);
                }
            }
        }
        Init.ML.FromSqIdx += 1;
    }
    Repeat (10000)
    {
        List.Add(MoveToPathDelta, 0);
        List.Add(MoveToPathStepInc, 0);
    }
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        Init.ML.ToSqIdx = 1;
        Repeat (64)
        {
            Init.ML.FileDelta = (IdxToFile[Init.ML.ToSqIdx] - IdxToFile[Init.ML.FromSqIdx]);
            Init.ML.RankDelta = (IdxToRank[Init.ML.ToSqIdx] - IdxToRank[Init.ML.FromSqIdx]);
            If ((Not ((Init.ML.FromSqIdx == Init.ML.ToSqIdx))) And (((Init.ML.FileDelta == 0) Or (Init.ML.RankDelta == 0)) Or (abs(Init.ML.FileDelta) == abs(Init.ML.RankDelta))))
            {
                If (abs(Init.ML.FileDelta) > abs(Init.ML.RankDelta))
                {
                    Init.ML.Delta = abs(Init.ML.FileDelta);
                }
                Else
                {
                    Init.ML.Delta = abs(Init.ML.RankDelta);
                }
                List.ReplaceItem(MoveToPathDelta, ((Init.ML.FromSqIdx * 100) + Init.ML.ToSqIdx), Init.ML.Delta);
                List.ReplaceItem(MoveToPathStepInc, ((Init.ML.FromSqIdx * 100) + Init.ML.ToSqIdx), ((8 * (Init.ML.RankDelta / Init.ML.Delta)) + (Init.ML.FileDelta / Init.ML.Delta)));
            }
            Init.ML.ToSqIdx += 1;
        }
        Init.ML.FromSqIdx += 1;
    }
}

Define InitMovePosLookup(bool Init) (warp=true)
{
    If (Glob.IsClassicEndgameEval == 0)
    {
        Init.MPL.MetaState = "AI";
    }
    Else
    {
        Init.MPL.MetaState = "HCE";
    }
    If (Init Or (Not ((Init.MPL.MetaState == Init.MPL.PrevMetaState))))
    {
        Init.MPL.PrevMetaState = Init.MPL.MetaState;
        If (Not (Init))
        {
            If (Glob.IsClassicEndgameEval == 1)
            {
                Init.MPL.MoveIdx = 1;
                Repeat (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)))
                {
                    List.ReplaceItem(TTNodeEntry, (Init.MPL.MoveIdx + Const.TTNodeCol.StaticEvalIdx), Const.Null);
                    List.ReplaceItem(TTNodeEntry, (Init.MPL.MoveIdx + Const.TTNodeCol.ScoreIdx), Const.Null);
                    List.ReplaceItem(TTNodeEntry, (Init.MPL.MoveIdx + Const.TTNodeCol.TypeIdx), Const.TTType.None);
                    Init.MPL.MoveIdx += Const.TTNodeEntrySize;
                }
            }
        }
        If (Not ((List.Length(MoveToHash) == 140000)))
        {
            List.DeleteAll(MoveToHash);
            Repeat (140000)
            {
                List.Add(MoveToHash, 0);
            }
        }
        List.DeleteAll(Pieces);
        List.Add(Pieces, GoK_BlackKing);
        List.Add(Pieces, GoK_BlackQueen);
        List.Add(Pieces, GoK_BlackRook);
        List.Add(Pieces, GoK_BlackBishop);
        List.Add(Pieces, GoK_BlackKnight);
        List.Add(Pieces, GoK_BlackPawn);
        List.Add(Pieces, GoK_WhiteKing);
        List.Add(Pieces, GoK_WhiteQueen);
        List.Add(Pieces, GoK_WhiteRook);
        List.Add(Pieces, GoK_WhiteBishop);
        List.Add(Pieces, GoK_WhiteKnight);
        List.Add(Pieces, GoK_WhitePawn);
        Init.MPL.PieceListIdx = 1;
        Repeat (List.Length(Pieces))
        {
            Init.MPL.SourcePiece = Pieces[Init.MPL.PieceListIdx];
            Init.MPL.SlidingKind = 0;
            If (abs(Init.MPL.SourcePiece) == GoK_BlackBishop)
            {
                Init.MPL.SlidingKind = 1;
            }
            If (abs(Init.MPL.SourcePiece) == GoK_BlackRook)
            {
                Init.MPL.SlidingKind = 2;
            }
            If (abs(Init.MPL.SourcePiece) == GoK_BlackQueen)
            {
                Init.MPL.SlidingKind = 3;
            }
            Init.MPL.SourceIdx = 0;
            Repeat (65)
            {
                If (Init.MPL.SourceIdx > 0)
                {
                    Init.MPL.File = IdxToFile[Init.MPL.SourceIdx];
                    Init.MPL.Rank = IdxToRank[Init.MPL.SourceIdx];
                }
                Else
                {
                    Init.MPL.File = 0;
                    Init.MPL.Rank = 0;
                }
                Call GetPiecePosHash(Init.MPL.SourcePiece)(Init.MPL.SourceIdx);
                Init.MPL.SavedPiecePosHash = Ret.GetPiecePosHash.Hash;
                Init.MPL.TargetIdx = 0;
                Repeat (65)
                {
                    Init.MPL.IsLegalMove = 0;
                    If (((Not ((Init.MPL.SourceIdx == 0))) And (Not ((Init.MPL.TargetIdx == 0)))) And (Not ((Init.MPL.SourceIdx == Init.MPL.TargetIdx))))
                    {
                        Init.MPL.FileDeltaAbs = abs((IdxToFile[Init.MPL.TargetIdx] - Init.MPL.File));
                        Init.MPL.RankDeltaAbs = abs((IdxToRank[Init.MPL.TargetIdx] - Init.MPL.Rank));
                        If (Init.MPL.SlidingKind == 0)
                        {
                            If (((Init.MPL.FileDeltaAbs < 2) And (Init.MPL.RankDeltaAbs < 3)) Or ((Init.MPL.FileDeltaAbs < 3) And (Init.MPL.RankDeltaAbs < 2)))
                            {
                                If (Init.MPL.SourcePiece == GoK_BlackPawn)
                                {
                                    If (((IdxToRank[Init.MPL.TargetIdx] - Init.MPL.Rank) == 1) And (Init.MPL.FileDeltaAbs < 2))
                                    {
                                        Init.MPL.IsLegalMove = 1;
                                    }
                                    Else
                                    {
                                        If ((Init.MPL.Rank == 2) And ((Init.MPL.TargetIdx - Init.MPL.SourceIdx) == 16))
                                        {
                                            Init.MPL.IsLegalMove = 1;
                                        }
                                    }
                                }
                                Else
                                {
                                    If (Init.MPL.SourcePiece == GoK_WhitePawn)
                                    {
                                        If (((IdxToRank[Init.MPL.TargetIdx] - Init.MPL.Rank) == -1) And (Init.MPL.FileDeltaAbs < 2))
                                        {
                                            Init.MPL.IsLegalMove = 1;
                                        }
                                        Else
                                        {
                                            If ((Init.MPL.Rank == 7) And ((Init.MPL.TargetIdx - Init.MPL.SourceIdx) == -16))
                                            {
                                                Init.MPL.IsLegalMove = 1;
                                            }
                                        }
                                    }
                                    Else
                                    {
                                        If (abs(Init.MPL.SourcePiece) == GoK_BlackKing)
                                        {
                                            If (((Init.MPL.FileDeltaAbs == 1) And (Init.MPL.RankDeltaAbs < 2)) Or ((Init.MPL.RankDeltaAbs == 1) And (Init.MPL.FileDeltaAbs < 2)))
                                            {
                                                Init.MPL.IsLegalMove = 1;
                                            }
                                        }
                                        Else
                                        {
                                            If (abs(Init.MPL.SourcePiece) == GoK_BlackKnight)
                                            {
                                                If (((Init.MPL.FileDeltaAbs == 1) And (Init.MPL.RankDeltaAbs == 2)) Or ((Init.MPL.FileDeltaAbs == 2) And (Init.MPL.RankDeltaAbs == 1)))
                                                {
                                                    Init.MPL.IsLegalMove = 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Else
                        {
                            If ((Init.MPL.FileDeltaAbs == 0) Or (Init.MPL.RankDeltaAbs == 0))
                            {
                                If (Init.MPL.SlidingKind > 1)
                                {
                                    Init.MPL.IsLegalMove = 1;
                                }
                            }
                            Else
                            {
                                If (Init.MPL.FileDeltaAbs == Init.MPL.RankDeltaAbs)
                                {
                                    If (Not ((Init.MPL.SlidingKind == 2)))
                                    {
                                        Init.MPL.IsLegalMove = 1;
                                    }
                                }
                            }
                        }
                    }
                    If ((Init.MPL.IsLegalMove == 1) Or ((Init.MPL.SourceIdx == 0) Or (Init.MPL.TargetIdx == 0)))
                    {
                        Call GetPiecePosHash(Init.MPL.SourcePiece)(Init.MPL.TargetIdx);
                        Init.MPL.MoveIdx = ((PieceIdxLookup[abs(Init.MPL.SourcePiece)] * 10000) + ((Init.MPL.SourceIdx * 100) + Init.MPL.TargetIdx));
                        If (Init.MPL.SourcePiece > 0)
                        {
                            Init.MPL.MoveIdx += 60000;
                        }
                        List.ReplaceItem(MoveToHash, Init.MPL.MoveIdx, (Ret.GetPiecePosHash.Hash - Init.MPL.SavedPiecePosHash));
                    }
                    Init.MPL.TargetIdx += 1;
                }
                Init.MPL.SourceIdx += 1;
            }
            Init.MPL.PieceListIdx += 1;
        }
    }
}

Define InitOpeningBook (warp=true)
{
    List.DeleteItem(OpeningMovesNeutral, all);
    List.Add(OpeningMovesNeutral, 533713215236122837291127514302196346041849410724503427365924152443360312574908075547073949523937625309253426182600672618534437364636183662610615);
    List.Add(OpeningMovesNeutral, 533713296346021962260917263310263342072200670627493301025143122052362718332518095648006559450605362909452922453860280521221504135547);
    List.Add(OpeningMovesNeutral, 533713215236122858521127634627364636072237292212524602196226062736191019261904181912031260520065006728364631162431370604);
    List.Add(OpeningMovesNeutral, 5337132963460219622609172619121900670339564816325244042258520713626113234436233848393239554739466046382136292229);
    List.Add(OpeningMovesNeutral, 5337132963460219622609172633102633420722006703105244061358430065595212204328222842280403626113225143191328100310);
    List.Add(OpeningMovesNeutral, 53371329634602196226091726331026334207220067062749330102514312205236271833251809564800655945060546310506);
