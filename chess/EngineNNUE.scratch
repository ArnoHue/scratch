                                List.ReplaceItem(CorrHistNonPawnWhiteKey, Ret.GetCorrHistIndices.NonPawnWhiteIdx, (floor((Ret.GetCorrHistIndices.NonPawnWhiteKey / 100000)) % 1073741824));
                            }
                            List.ReplaceItem(CorrHistNonPawnWhite, Ret.GetCorrHistIndices.NonPawnWhiteIdx, ((CorrHistNonPawnWhite[Ret.GetCorrHistIndices.NonPawnWhiteIdx] + SearchImpl.CorrBonus) - (floor(abs(((CorrHistNonPawnWhite[Ret.GetCorrHistIndices.NonPawnWhiteIdx] * abs(SearchImpl.CorrBonus)) / 1024))) * ((((CorrHistNonPawnWhite[Ret.GetCorrHistIndices.NonPawnWhiteIdx] * abs(SearchImpl.CorrBonus)) / 1024) > 0) - (((CorrHistNonPawnWhite[Ret.GetCorrHistIndices.NonPawnWhiteIdx] * abs(SearchImpl.CorrBonus)) / 1024) < 0)))));
                            If (Not ((Ret.GetCorrHistIndices.ContIdx2 == Const.Null)))
