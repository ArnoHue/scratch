Define InitSearch(string Horizon) (warp=true)
{
    Glob.IsInNullMove = 0;
    If (List.Length(BoardHistoryFiftyMoves) == 0)
    {
        List.Add(BoardHistoryFiftyMoves, 0);
    }
    Glob.IsSearchTimeout = 0;
    If (Glob.IsInitialDeepening == 1)
    {
        Glob.PV = "";
        List.DeleteAll(PVStable);
        List.DeleteAll(PVStablePrev);
        Glob.TTCurrentAge = ((floor((Glob.TTCurrentAge / 100)) + 1) * 100);
        Init.Search.KillerMoveIdx = 1;
        Repeat (List.Length(KillerMoves))
        {
            List.ReplaceItem(KillerMoves, Init.Search.KillerMoveIdx, Const.Null);
            Init.Search.KillerMoveIdx += 1;
        }
    }
    Call SetInitialEnPassantTarget(1);
    List.DeleteItem(SearchRootMovesDone, all);
    Glob.TTCurrentAge += 1;
    Call CalcBoardStats;
    Call InitMovePosLookup((1 == 0));
    Call NNUE_Public_Refresh;
    Call CreateCurrentBoardHash;
    Call Log(Horizon)(" : ")("Search start, depth = ")(Horizon)("")("")("")("");
}

Define IsBlackKingCheckMate (warp=true)
{
    Ret.IsBlackKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(2);
    If (Glob.IsBlackChecked == 1)
    {
        Ret.IsBlackKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(1);
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(1)((1 == 1));
                Call CalcBoardAttackedByMove(2);
                If (Glob.IsBlackChecked == 0)
                {
                    Ret.IsBlackKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(1);
            }
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
}

Define IsCastlingPathSafe(string Move)(string Ply) (warp=true)
{
    Ret.IsCastlingPathSafe.IsSafe = 1;
    If (floor((Move / 100)) == 0)
    {
        ICPS.FirstIdx = 0;
        If (Move == GoK_BlackQueensideCastling)
        {
            ICPS.FirstIdx = 3;
        }
        If (Move == GoK_BlackKingsideCastling)
        {
            ICPS.FirstIdx = 5;
        }
        If (Move == GoK_WhiteQueensideCastling)
        {
            ICPS.FirstIdx = 59;
        }
        If (Move == GoK_WhiteKingsideCastling)
        {
            ICPS.FirstIdx = 61;
        }
        If (ICPS.FirstIdx > 0)
        {
            Call CalcBoardAttackedOnDemand(Ply)((1 == 0))((1 == 1))(99);
            ICPS.BaseIdx = ((Ply - 1) * Const.SnapshotPlyStride);
            If (Not (((BoardAttackedByOpponentSnapshot[(ICPS.BaseIdx + ICPS.FirstIdx)] == 0) And ((BoardAttackedByOpponentSnapshot[(ICPS.BaseIdx + (ICPS.FirstIdx + 1))] == 0) And (BoardAttackedByOpponentSnapshot[(ICPS.BaseIdx + (ICPS.FirstIdx + 2))] == 0)))))
            {
                Ret.IsCastlingPathSafe.IsSafe = 0;
            }
        }
    }
}

Define IsCheckedFast(string CheckingPly) (warp=true)
{
    ICF.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    ICF.SideOffset = ((ICF.Factor > 0) * 60000);
    Ret.IsCheckedFast.IsChecked = 0;
    If (ICF.Factor > 0)
    {
        ICF.KingIdx = Glob.WhiteKingIdx;
    }
    Else
    {
        ICF.KingIdx = Glob.BlackKingIdx;
    }
    ICF.SqIdx = 1;
    Repeat (64)
    {
        If ((Board[ICF.SqIdx] * ICF.Factor) > 0)
        {
            If (Not ((MoveToHash[((ICF.SideOffset + (PieceIdxLookup[abs(Board[ICF.SqIdx])] * 10000)) + ((ICF.SqIdx * 100) + ICF.KingIdx))] == 0)))
            {
                Call IsCheckingPiece(ICF.SqIdx);
                If (Ret.IsCheckingPiece.IsChecking == 1)
                {
                    Ret.IsCheckedFast.IsChecked = 1;
                    Ret.IsCheckedFast.CheckedByIdx = ICF.SqIdx;
                    Stop(this script);
                }
            }
        }
        ICF.SqIdx += 1;
    }
}

Define IsCheckingPiece(string Idx) (warp=true)
{
    Call IsCheckingPieceImpl(Idx)(Board[(Idx + 0)]);
    Ret.IsCheckingPiece.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
}

Define IsCheckingPieceDiscovery(string SourceIdx)(string TargetIdx)(string Ply) (warp=true)
{
    Call IsCheckingPieceImpl(SourceIdx)((GoK_BlackQueen * ((2 * PlyIsOwn[Ply]) - 1)));
    Ret.IsCheckingPieceDiscovery.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 0)
    {
        Stop(this script);
    }
    Call CalcBoardAttackedByMoveChecked((Ply + 2));
    If (((PlyIsOwn[Ply] == 1) And (Glob.IsWhiteChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsBlackChecked == 1)))
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 1;
    }
    Else
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 0;
    }
}

Define IsCheckingPieceImpl(string Idx)(string Piece) (warp=true)
{
    Ret.IsCheckingPieceImpl.IsChecking = 0;
    If (abs(Piece) == GoK_BlackKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.WhiteKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.BlackKingIdx);
    }
    Ret.IsCheckingPieceImpl.IsChecking = Ret.IsReachableForAttack.IsReachable;
}

Define IsDrawByMaterial (warp=true)
{
    IDBM.BlackMinorCnt = 0;
    IDBM.WhiteMinorCnt = 0;
    IDBM.SqIdx = 1;
    Ret.IsDrawByMaterial.IsDraw = 0;
    Repeat (64)
    {
        IDBM.Piece = Board[IDBM.SqIdx];
        If (Not ((IDBM.Piece == 0)))
        {
            If ((IDBM.Piece == GoK_BlackBishop) Or (IDBM.Piece == GoK_BlackKnight))
            {
                IDBM.BlackMinorCnt += 1;
            }
            Else
            {
                If ((IDBM.Piece == GoK_WhiteBishop) Or (IDBM.Piece == GoK_WhiteKnight))
                {
                    IDBM.WhiteMinorCnt += 1;
                }
                Else
                {
                    If (Not ((abs(IDBM.Piece) == GoK_BlackKing)))
                    {
                        Stop(this script);
                    }
                }
            }
        }
        IDBM.SqIdx += 1;
    }
    If ((IDBM.BlackMinorCnt + IDBM.WhiteMinorCnt) < 2)
    {
        Ret.IsDrawByMaterial.IsDraw = 1;
    }
}

Define IsDrawByStalemate(string Ply) (warp=true)
{
    Call CalcBoardAttackedByMoveChecked((Ply + 1));
    If (((PlyIsOwn[Ply] == 1) And (Glob.IsBlackChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsWhiteChecked == 1)))
    {
        Ret.IsDrawByStalemate.IsDraw = 0;
        Stop(this script);
    }
    List.ReplaceItem(Quiescence, Ply, 0);
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0));
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    If (Quiescence[Ply] == 1)
    {
        Glob.MoveCount += MovesCount[Ply];
    }
    Else
    {
        Glob.MoveCountQuiescence += MovesCount[Ply];
    }
    Ret.IsDrawByStalemate.IsDraw = 1;
    List.ReplaceItem(MovesIdx, Ply, 1);
    Repeat (MovesCount[Ply])
    {
        Call ApplyMoveLight(Ply);
        Call CalcBoardAttackedByMoveChecked((Ply + 1));
        If (((PlyIsOwn[Ply] == 1) And (Glob.IsBlackChecked == 0)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsWhiteChecked == 0)))
        {
            Ret.IsDrawByStalemate.IsDraw = 0;
            Call RevertMoveLight(Ply);
            Stop(this script);
        }
        Call RevertMoveLight(Ply);
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
    }
}

Define IsEngineValidMove(string Move) (warp=true)
{
    Call GenerateMovesPublic(1);
    If (Move == Const.Null)
    {
        Ret.IsEngineValidMove.IsValid = 0;
    }
    Else
    {
        If List.ContainsItem(Moves1, Move)
        {
            Ret.IsEngineValidMove.IsValid = 1;
        }
        Else
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
    }
    If (Ret.IsEngineValidMove.IsValid == 1)
    {
        Call ClearMoveList(1);
        Call AddMoveToList(Move)(1)(0);
        List.ReplaceItem(MovesIdx, 1, 1);
        Glob.IsWhiteChecked = 0;
        Glob.IsBlackChecked = 0;
        Call ApplyMove(1)((1 == 0));
        Call CalcBoardAttackedByMove(2);
        If (((Glob.IsPlayerBlack == 1) And (Glob.IsWhiteChecked == 1)) Or ((Glob.IsPlayerBlack == 0) And (Glob.IsBlackChecked == 1)))
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
        Call RevertMove(1);
    }
}

Define IsLowerCase(string Char) (warp=true)
{
    ILC.Chars = "";
    ILC.CharsIdx = 1;
    Repeat (Variable.Length(Const.CharsUpperCase))
    {
        If (Operator.LetterOf(Const.CharsUpperCase, ILC.CharsIdx) == Char)
        {
            ILC.Chars = Operator.Join(ILC.Chars, Char);
        }
        Else
        {
            ILC.Chars = Operator.Join(ILC.Chars, Operator.LetterOf(Const.CharsUpperCase, ILC.CharsIdx));
        }
        ILC.CharsIdx += 1;
    }
    Looks.SwitchCostumeTo(_ABCDEFGHIJKLMNOPQRSTUVWXYZ);
    Looks.SwitchCostumeTo(ILC.Chars);
    If (Costume.GetNumberName(number) == 1)
    {
        Ret.IsLowerCase.IsLower = 0;
    }
    Else
    {
        Ret.IsLowerCase.IsLower = 1;
    }
}

Define IsMoveLegalFast(string Ply) (warp=true)
{
    If ((CheckedState[Ply] == 1) Or (floor((AppliedMove[Ply] / 100)) == 0))
    {
        Call IsCheckedFast((Ply + 1));
        Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        IMLF.FromIdx = floor((AppliedMove[Ply] / 100));
        IMLF.ToIdx = floor((AppliedMove[Ply] % 100));
        If ((abs(SourcePieces[Ply]) == GoK_BlackKing) Or (Not ((TargetPiecesIdx[Ply] == IMLF.ToIdx))))
        {
            Call IsCheckedFast((Ply + 1));
            Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            Ret.IsMoveLegalFast.IsLegal = 0;
            IMLF.PinIdx = 1;
            Repeat (PinCount[Ply])
            {
                If (PinSq[(((Ply - 1) * Const.CheckInfoPlyStride) + IMLF.PinIdx)] == IMLF.FromIdx)
                {
                    If (Not ((abs(MoveToPathStepInc[((IMLF.FromIdx * 100) + IMLF.ToIdx)]) == PinRay[(((Ply - 1) * Const.CheckInfoPlyStride) + IMLF.PinIdx)])))
                    {
                        Ret.IsMoveLegalFast.IsLegal = 1;
                    }
                }
                IMLF.PinIdx += 1;
            }
            If (Glob.ProfilerMode == Const.ProfilerMode.On)
            {
                IMLF.IsChecked = Ret.IsMoveLegalFast.IsLegal;
                Call IsCheckedFast((Ply + 1));
                Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
                If (Not ((IMLF.IsChecked == Ret.IsMoveLegalFast.IsLegal)))
                {
                    Call Log("CheckInfoMismatch legal depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(IMLF.IsChecked)(" old=")(Ret.IsMoveLegalFast.IsLegal);
                }
            }
        }
    }
}

Define IsMovePicked(string Ply)(string Move) (warp=true)
{
    IMP.PickedScanIdx = 1;
    Ret.IsMovePicked.Picked = 0;
    Repeat Until (IMP.PickedScanIdx > PickedPseudoLegalMovesCount[Ply])
    {
        If (PickedPseudoLegalMoves[(((Ply - 1) * Const.MaxMovesPerGeneration) + IMP.PickedScanIdx)] == Move)
        {
            Ret.IsMovePicked.Picked = 1;
            Ret.IsMovePicked.Score = PickedPseudoLegalMovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + IMP.PickedScanIdx)];
            Stop(this script);
        }
        IMP.PickedScanIdx += 1;
    }
}

Define IsOwnKingCheckMate (warp=true)
{
    If (Glob.IsPlayerBlack == 1)
    {
        Call IsWhiteKingCheckMate;
        Ret.IsOwnKingCheckMate.IsCheckMate = Ret.IsWhiteKingCheckMate.IsCheckMate;
    }
    Else
    {
        Call IsBlackKingCheckMate;
        Ret.IsOwnKingCheckMate.IsCheckMate = Ret.IsBlackKingCheckMate.IsCheckMate;
    }
}

Define IsQuiescentCheckCond(string Ply) (warp=true)
{
    Call //("Quiescence search extension for checking moves, esp. check sequences. Return value defined whether check sequences should pursued at this point");
    Ret.IsQuiescentCheckCond.IsTrue = 0;
    If (1 == 0)
    {
        If (Glob.IsScratch3 == 0)
        {
            If ((Quiescence[Ply] == 1) And (Quiescence[(Ply - 1)] == 0))
            {
                Ret.IsQuiescentCheckCond.IsTrue = 1;
            }
        }
    }
}

Define IsQuietMove(string Move) (warp=true)
{
    Ret.IsQuietMove.IsQuiet = 0;
    IQM.FromIdx = floor((Move / 100));
    IQM.ToIdx = floor((Move % 100));
    If (IQM.FromIdx == 0)
    {
        Ret.IsQuietMove.IsQuiet = 1;
        Stop(this script);
    }
    If (Not ((Board[IQM.ToIdx] == 0)))
    {
        Stop(this script);
    }
    If (Not ((Move == floor(Move))))
    {
        Stop(this script);
    }
    If (abs(Board[IQM.FromIdx]) == GoK_BlackPawn)
    {
        If (Not ((IdxToFile[IQM.FromIdx] == IdxToFile[IQM.ToIdx])))
        {
            Stop(this script);
        }
    }
    Ret.IsQuietMove.IsQuiet = 1;
}

Define IsReachableForAttack(string Piece)(string FromIdx)(string ToIdx) (warp=true)
{
    Ret.IsReachableForAttack.IsReachable = 0;
    IRFA.PieceAbs = abs(Piece);
    IRFA.LegalMoveKey = ((PieceIdxLookup[IRFA.PieceAbs] * 10000) + ((FromIdx * 100) + ToIdx));
    If (Piece > 0)
    {
        IRFA.LegalMoveKey += 60000;
    }
    If (MoveToHash[IRFA.LegalMoveKey] == 0)
    {
        Stop(this script);
    }
    If (IRFA.PieceAbs == GoK_BlackPawn)
    {
        If (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))
        {
            Ret.IsReachableForAttack.IsReachable = 1;
        }
        Stop(this script);
    }
    If ((IRFA.PieceAbs == GoK_BlackKnight) Or (IRFA.PieceAbs == GoK_BlackKing))
    {
        Ret.IsReachableForAttack.IsReachable = 1;
        Stop(this script);
    }
    IRFA.Idx = ((FromIdx * 100) + ToIdx);
    IRFA.SourceIdx = FromIdx;
    Repeat ((MoveToPathDelta[IRFA.Idx] - 1))
    {
        IRFA.SourceIdx += MoveToPathStepInc[IRFA.Idx];
        If (Not ((Board[IRFA.SourceIdx] == 0)))
        {
            Stop(this script);
        }
    }
    Ret.IsReachableForAttack.IsReachable = 1;
}

Define IsWhiteKingCheckMate (warp=true)
{
    Ret.IsWhiteKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(1);
    If (Glob.IsWhiteChecked == 1)
    {
        Ret.IsWhiteKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(2)((1 == 1));
                Call CalcBoardAttackedByMove(1);
                If (Glob.IsWhiteChecked == 0)
                {
                    Ret.IsWhiteKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(2);
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
    }
}

Define LoadInternalBoard (warp=true)
{
    LoadInternalBoard.SqIdx = 1;
    Repeat (64)
    {
        If (Glob.IsPlayerBlack == 1)
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, (0 - GoK_Board[RankFlipIdx[LoadInternalBoard.SqIdx]]));
        }
        Else
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, GoK_Board[LoadInternalBoard.SqIdx]);
        }
        LoadInternalBoard.SqIdx += 1;
    }
}

Define LoadList(string Data)(string ListName) (warp=true)
{
    LL.CharIdx = 1;
    LL.Token = "";
    Repeat Until (LL.CharIdx > Variable.Length(Data))
    {
        If ((Not ((Operator.LetterOf(Data, LL.CharIdx) == " "))) And (Not ((Operator.LetterOf(Data, LL.CharIdx) == ","))))
        {
            LL.Token = Operator.Join(LL.Token, Operator.LetterOf(Data, LL.CharIdx));
        }
        If ((Operator.LetterOf(Data, LL.CharIdx) == ",") Or (LL.CharIdx == Variable.Length(Data)))
        {
            If (ListName == "PawnPieceSquare")
            {
                List.Add(PawnPieceSquare, (LL.Token + 0));
            }
            If (ListName == "PawnPieceSquareEndgame")
            {
                List.Add(PawnPieceSquareEndgame, (LL.Token + 0));
            }
            If (ListName == "KingPieceSquare")
            {
                List.Add(KingPieceSquare, (LL.Token + 0));
            }
            If (ListName == "KingPieceSquareEndgame")
            {
                List.Add(KingPieceSquareEndgame, (LL.Token + 0));
            }
            If (ListName == "QueenPieceSquare")
            {
                List.Add(QueenPieceSquare, (LL.Token + 0));
            }
            If (ListName == "QueenPieceSquareEndgame")
            {
                List.Add(QueenPieceSquareEndgame, (LL.Token + 0));
            }
            If (ListName == "RookPieceSquare")
            {
                List.Add(RookPieceSquare, (LL.Token + 0));
            }
            If (ListName == "RookPieceSquareEndgame")
            {
                List.Add(RookPieceSquareEndgame, (LL.Token + 0));
            }
            If (ListName == "BishopPieceSquare")
            {
                List.Add(BishopPieceSquare, (LL.Token + 0));
            }
            If (ListName == "BishopPieceSquareEndgame")
            {
                List.Add(BishopPieceSquareEndgame, (LL.Token + 0));
            }
            If (ListName == "KnightPieceSquare")
            {
                List.Add(KnightPieceSquare, (LL.Token + 0));
            }
            If (ListName == "KnightPieceSquareEndgame")
            {
                List.Add(KnightPieceSquareEndgame, (LL.Token + 0));
            }
            If (ListName == "PushToEdges")
            {
                List.Add(PushToEdges, (LL.Token + 0));
            }
            If (ListName == "PushClose")
            {
                List.Add(PushClose, (LL.Token + 0));
            }
            LL.Token = "";
        }
        LL.CharIdx += 1;
    }
}

Define Log(string Txt1)(string Txt2)(string Txt3)(string Txt4)(string Txt5)(string Txt6)(string Txt7)(string Txt8) (warp=true)
{
    If (Glob.IsTestRunning == 1)
    {
        Stop(this script);
    }
    If (List.Length(Logfile) > 1000000)
    {
        Stop(this script);
    }
    Log.ElapsedSec = (floor((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * 1000)) / 1000);
    If Operator.Contains(Log.ElapsedSec, ".")
    {
        If ((Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 1)) == ".") Or (Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 2)) == "."))
        {
            Log.ElapsedSec = Operator.Join(Log.ElapsedSec, 0);
        }
    }
    Else
    {
        Log.ElapsedSec = Operator.Join(Log.ElapsedSec, .000);
    }
    List.Add(Logfile, Operator.Join(Operator.Join(Log.ElapsedSec, ": "), Operator.Join(Txt1, Operator.Join(Txt2, Operator.Join(Txt3, Operator.Join(Txt4, Operator.Join(Txt5, Operator.Join(Txt6, Operator.Join(Txt7, Txt8)))))))));
}

Define NNUE_ActDeactBulkImpl(string FromSquare)(string ToSquare)(string SourcePiece)(string PlacedPiece)(string TargetPiece)(string CapSquare)(string Ply) (warp=true)
{
    NNUE.ADBI.Side = 0;
    Repeat (2)
    {
        NNUE.ADBI.Chunk = 0;
        Repeat (1)
        {
            NNUE.ADBI.ChunkBaseIdx = (NNUE.ADBI.Chunk * (Const.NNUE_HiddenPackedSize / 2));
            NNUE.ADBI.AccumulatorBaseIdx = (((NNUE.ADBI.Side * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.ChunkBaseIdx) + 1);
            NNUE.ADBI.FeatureFrom = (NNUE_InputIdxMap[(((NNUE.ADBI.Side * 1000) + ((64 * SourcePiece) + FromSquare)) + 1)] + 0);
            NNUE.ADBI.FeatureTo = (NNUE_InputIdxMap[(((NNUE.ADBI.Side * 1000) + ((64 * PlacedPiece) + ToSquare)) + 1)] + 0);
            If (TargetPiece == Const.Null)
            {
                NNUE.ADBI.FeatureCap = 0;
            }
            Else
            {
                NNUE.ADBI.FeatureCap = (NNUE_InputIdxMap[(((NNUE.ADBI.Side * 1000) + ((64 * TargetPiece) + CapSquare)) + 1)] + 0);
            }
            NNUE.ADBI.FromBaseIdx = (((NNUE.ADBI.FeatureFrom * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.ChunkBaseIdx) + 1);
            NNUE.ADBI.ToBaseIdx = (((NNUE.ADBI.FeatureTo * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.ChunkBaseIdx) + 1);
            If (NNUE.ADBI.FeatureCap == 0)
            {
                NNUE.ADBI.CaptureBaseIdx = 0;
            }
            Else
            {
                NNUE.ADBI.CaptureBaseIdx = (((NNUE.ADBI.FeatureCap * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.ChunkBaseIdx) + 1);
            }
            If (Ply == 0)
            {
                NNUE.ADBI.SourceIdx = NNUE.ADBI.AccumulatorBaseIdx;
                NNUE.ADBI.TargetIdx = NNUE.ADBI.AccumulatorBaseIdx;
            }
            Else
            {
                NNUE.ADBI.TargetIdx = (NNUE.ADBI.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                If (NNUE_Accumulator_MetaState[Ply] == 1)
                {
                    NNUE.ADBI.SourceIdx = (NNUE.ADBI.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1)));
                }
                Else
                {
                    If (NNUE_Accumulator_MetaState[Ply] == 2)
                    {
                        NNUE.ADBI.SourceIdx = (NNUE.ADBI.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                    }
                    Else
                    {
                        Stop(this script);
                    }
                }
            }
            If (NNUE.ADBI.CaptureBaseIdx > 0)
            {
                NNUE.ADBI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADBI.TargetIdx + NNUE.ADBI.Idx), ((((NNUE_Accumulator[(NNUE.ADBI.SourceIdx + NNUE.ADBI.Idx)] - NNUE_InputWeights[(NNUE.ADBI.FromBaseIdx + NNUE.ADBI.Idx)]) + NNUE_InputWeights[(NNUE.ADBI.ToBaseIdx + NNUE.ADBI.Idx)]) - NNUE_InputWeights[(NNUE.ADBI.CaptureBaseIdx + NNUE.ADBI.Idx)]) + 1688862745264128));
                    NNUE.ADBI.Idx += 1;
                }
            }
            Else
            {
                NNUE.ADBI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADBI.TargetIdx + NNUE.ADBI.Idx), ((NNUE_Accumulator[(NNUE.ADBI.SourceIdx + NNUE.ADBI.Idx)] - NNUE_InputWeights[(NNUE.ADBI.FromBaseIdx + NNUE.ADBI.Idx)]) + NNUE_InputWeights[(NNUE.ADBI.ToBaseIdx + NNUE.ADBI.Idx)]));
                    NNUE.ADBI.Idx += 1;
                }
            }
            NNUE.ADBI.Chunk += 1;
        }
        NNUE.ADBI.Side += 1;
    }
    If (Ply > 0)
    {
        List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 2);
    }
}

Define NNUE_ActDeactImpl(string Square)(string Piece)(bool Activate)(string Ply) (warp=true)
{
    NNUE.ADI.Side = 0;
    Repeat (2)
    {
        NNUE.ADI.Chunk = 0;
        Repeat (1)
        {
            NNUE.ADI.ChunkBaseIdx = (NNUE.ADI.Chunk * (Const.NNUE_HiddenPackedSize / 2));
            NNUE.ADI.AccumulatorBaseIdx = (((NNUE.ADI.Side * Const.NNUE_HiddenPackedSize) + NNUE.ADI.ChunkBaseIdx) + 1);
            NNUE.ADI.Feature = (NNUE_InputIdxMap[(((NNUE.ADI.Side * 1000) + ((64 * Piece) + Square)) + 1)] + 0);
            NNUE.ADI.FeatureBaseIdx = (((NNUE.ADI.Feature * Const.NNUE_HiddenPackedSize) + NNUE.ADI.ChunkBaseIdx) + 1);
            If (Ply == 0)
            {
                NNUE.ADI.SourceIdx = NNUE.ADI.AccumulatorBaseIdx;
                NNUE.ADI.TargetIdx = NNUE.ADI.AccumulatorBaseIdx;
            }
            Else
            {
                NNUE.ADI.TargetIdx = (NNUE.ADI.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                If (NNUE_Accumulator_MetaState[Ply] == 1)
                {
                    NNUE.ADI.SourceIdx = (NNUE.ADI.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1)));
                }
                Else
                {
                    If (NNUE_Accumulator_MetaState[Ply] == 2)
                    {
                        NNUE.ADI.SourceIdx = (NNUE.ADI.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                    }
                    Else
                    {
                        Stop(this script);
                    }
                }
            }
            If Activate
            {
                NNUE.ADI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADI.TargetIdx + NNUE.ADI.Idx), ((NNUE_Accumulator[(NNUE.ADI.SourceIdx + NNUE.ADI.Idx)] + NNUE_InputWeights[(NNUE.ADI.FeatureBaseIdx + NNUE.ADI.Idx)]) - 1688862745264128));
                    NNUE.ADI.Idx += 1;
                }
            }
            Else
            {
                NNUE.ADI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADI.TargetIdx + NNUE.ADI.Idx), ((NNUE_Accumulator[(NNUE.ADI.SourceIdx + NNUE.ADI.Idx)] - NNUE_InputWeights[(NNUE.ADI.FeatureBaseIdx + NNUE.ADI.Idx)]) + 1688862745264128));
                    NNUE.ADI.Idx += 1;
                }
            }
            NNUE.ADI.Chunk += 1;
        }
        NNUE.ADI.Side += 1;
    }
    If (Ply > 0)
    {
        List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 2);
    }
}

Define NNUE_Activate(string GoKIdx)(string GoKPiece)(string Ply) (warp=true)
{
    Call NNUE_ActDeactImpl(NNUE_GoKIdxToSquare[GoKIdx])((((6 * (GoKPiece > 0)) + PieceIdxLookup[abs(GoKPiece)]) - 1))((1 == 1))(Ply);
}

Define NNUE_Deactivate(string GoKIdx)(string GoKPiece)(string Ply) (warp=true)
{
    Call NNUE_ActDeactImpl(NNUE_GoKIdxToSquare[GoKIdx])((((6 * (GoKPiece > 0)) + PieceIdxLookup[abs(GoKPiece)]) - 1))((1 == 0))(Ply);
}

Define NNUE_DecodeNetwork (warp=true)
{
    If (Glob.IsNetworkDecoded == 1)
    {
        Stop(this script);
    }
    Call NNUE_HexToDec(Glob.NNUE_InputWeights_HEX);
    List.DeleteAll(NNUE_InputWeights);
    NNUE.DN.RowIdx = 0;
    Repeat (384)
    {
        NNUE.DN.WeightIdx = 0;
        Repeat (170)
        {
            List.Add(NNUE_InputWeights, (((NNUE_ListRes_1[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 1)] + 98304) + ((NNUE_ListRes_1[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 2)] + 98304) * 131072)) + ((NNUE_ListRes_1[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 3)] + 98304) * 17179869184)));
            NNUE.DN.WeightIdx += 1;
        }
        List.Add(NNUE_InputWeights, (((NNUE_ListRes_1[((NNUE.DN.RowIdx * 512) + 511)] + 98304) + ((NNUE_ListRes_1[((NNUE.DN.RowIdx * 512) + 512)] + 98304) * 131072)) + 1688849860263936));
        NNUE.DN.RowIdx += 1;
    }
    NNUE.DN.RowIdx = 0;
    Repeat (384)
    {
        NNUE.DN.WeightIdx = 0;
        Repeat (170)
        {
            List.Add(NNUE_InputWeights, (((NNUE_ListRes_2[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 1)] + 98304) + ((NNUE_ListRes_2[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 2)] + 98304) * 131072)) + ((NNUE_ListRes_2[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 3)] + 98304) * 17179869184)));
            NNUE.DN.WeightIdx += 1;
        }
        List.Add(NNUE_InputWeights, (((NNUE_ListRes_2[((NNUE.DN.RowIdx * 512) + 511)] + 98304) + ((NNUE_ListRes_2[((NNUE.DN.RowIdx * 512) + 512)] + 98304) * 131072)) + 1688849860263936));
        NNUE.DN.RowIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE_HiddenBias_CSV);
    List.DeleteAll(NNUE_HiddenBias);
    NNUE.DN.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenBias, (NNUE_ListRes_1[NNUE.DN.CharIdx] + 0));
        NNUE.DN.CharIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE_HIddenWeights_CSV);
    List.DeleteAll(NNUE_HiddenWeights);
    NNUE.DN.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenWeights, (NNUE_ListRes_1[NNUE.DN.CharIdx] + 0));
        NNUE.DN.CharIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE_OutputBias_CSV);
    List.DeleteAll(NNUE_OutputBias);
    NNUE.DN.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_OutputBias, (NNUE_ListRes_1[NNUE.DN.CharIdx] + 0));
        NNUE.DN.CharIdx += 1;
    }
    Glob.IsNetworkDecoded = 1;
    List.DeleteAll(NNUE_ListRes_1);
    NNUE.DN.RowIdx = 0;
    Repeat (1)
    {
        NNUE.DN.WeightIdx = 0;
        Repeat (170)
        {
            List.Add(NNUE_ListRes_1, (((NNUE_HiddenBias[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 1)] + 98304) + ((NNUE_HiddenBias[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 2)] + 98304) * 131072)) + ((NNUE_HiddenBias[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 3)] + 98304) * 17179869184)));
            NNUE.DN.WeightIdx += 1;
        }
        List.Add(NNUE_ListRes_1, (((NNUE_HiddenBias[((NNUE.DN.RowIdx * 512) + 511)] + 98304) + ((NNUE_HiddenBias[((NNUE.DN.RowIdx * 512) + 512)] + 98304) * 131072)) + 1688849860263936));
        NNUE.DN.RowIdx += 1;
    }
    List.DeleteAll(NNUE_HiddenBias);
    NNUE.DN.RowIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenBias, NNUE_ListRes_1[NNUE.DN.RowIdx]);
        NNUE.DN.RowIdx += 1;
    }
    List.DeleteAll(NNUE_ListRes_1);
}

Define NNUE_DecToHex(string CSV) (warp=true)
{
    List.DeleteAll(TmpList1);
    List.Add(TmpList1, 0);
    List.Add(TmpList1, 1);
    List.Add(TmpList1, 2);
    List.Add(TmpList1, 3);
    List.Add(TmpList1, 4);
    List.Add(TmpList1, 5);
    List.Add(TmpList1, 6);
    List.Add(TmpList1, 7);
    List.Add(TmpList1, 8);
    List.Add(TmpList1, 9);
    List.Add(TmpList1, "a");
    List.Add(TmpList1, "b");
    List.Add(TmpList1, "c");
    List.Add(TmpList1, "d");
    List.Add(TmpList1, "e");
    List.Add(TmpList1, "f");
    Call NNUE_LoadList(CSV);
    Ret.NNUE_DecToHex.Hex = "";
    NNUE.DTH.Idx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        NNUE.DTH.Word = NNUE_ListRes_1[NNUE.DTH.Idx];
        If (NNUE.DTH.Word < 0)
        {
            NNUE.DTH.Word = (2048 - NNUE.DTH.Word);
        }
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 256)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 16)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((NNUE.DTH.Word % 16) + 1)]);
        NNUE.DTH.Idx += 1;
    }
    NNUE.DTH.Idx = 1;
    Repeat (List.Length(NNUE_ListRes_2))
    {
        NNUE.DTH.Word = NNUE_ListRes_2[NNUE.DTH.Idx];
        If (NNUE.DTH.Word < 0)
        {
            NNUE.DTH.Word = (2048 - NNUE.DTH.Word);
        }
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 256)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 16)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((NNUE.DTH.Word % 16) + 1)]);
        NNUE.DTH.Idx += 1;
    }
}

Define NNUE_Evaluate(string Side)(string Ply) (warp=true)
{
    Ret.NNUE_Evaluate.Score = (NNUE_OutputBias[1] + 0);
    NNUE.Eval.OurBaseIdx = ((Side * Const.NNUE_HiddenPackedSize) + (Ply * (Const.NNUE_HiddenPackedSize * 2)));
    NNUE.Eval.TheirBaseIdx = (((1 - Side) * Const.NNUE_HiddenPackedSize) + (Ply * (Const.NNUE_HiddenPackedSize * 2)));
    NNUE.Eval.Idx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        NNUE.Eval.OurPacked = floor(NNUE_Accumulator[(NNUE.Eval.OurBaseIdx + NNUE.Eval.Idx)]);
        NNUE.Eval.TheirPacked = floor(NNUE_Accumulator[(NNUE.Eval.TheirBaseIdx + NNUE.Eval.Idx)]);
        NNUE.Eval.WordHigh = floor((NNUE.Eval.OurPacked / 17179869184));
        NNUE.Eval.OurPacked = (NNUE.Eval.OurPacked - (17179869184 * NNUE.Eval.WordHigh));
        NNUE.Eval.WordHigh = (NNUE.Eval.WordHigh - 98304);
        NNUE.Eval.WordMid = floor((NNUE.Eval.OurPacked / 131072));
        NNUE.Eval.WordLow = ((NNUE.Eval.OurPacked - (131072 * NNUE.Eval.WordMid)) - 98304);
        NNUE.Eval.WordMid = (NNUE.Eval.WordMid - 98304);
        If (NNUE.Eval.WordLow > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordLow * floor(NNUE_HiddenWeights[((3 * NNUE.Eval.Idx) - 2)]));
        }
        If (NNUE.Eval.WordMid > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordMid * floor(NNUE_HiddenWeights[((3 * NNUE.Eval.Idx) - 1)]));
        }
        If (NNUE.Eval.WordHigh > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordHigh * floor(NNUE_HiddenWeights[(3 * NNUE.Eval.Idx)]));
        }
        NNUE.Eval.WordHigh = floor((NNUE.Eval.TheirPacked / 17179869184));
        NNUE.Eval.TheirPacked = (NNUE.Eval.TheirPacked - (17179869184 * NNUE.Eval.WordHigh));
        NNUE.Eval.WordHigh = (NNUE.Eval.WordHigh - 98304);
        NNUE.Eval.WordMid = floor((NNUE.Eval.TheirPacked / 131072));
        NNUE.Eval.WordLow = ((NNUE.Eval.TheirPacked - (131072 * NNUE.Eval.WordMid)) - 98304);
        NNUE.Eval.WordMid = (NNUE.Eval.WordMid - 98304);
        If (NNUE.Eval.WordLow > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordLow * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + ((3 * NNUE.Eval.Idx) - 2))]));
        }
        If (NNUE.Eval.WordMid > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordMid * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + ((3 * NNUE.Eval.Idx) - 1))]));
        }
        If (NNUE.Eval.WordHigh > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordHigh * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + (3 * NNUE.Eval.Idx))]));
        }
        NNUE.Eval.Idx += 1;
    }
    Ret.NNUE_Evaluate.Score = (Ret.NNUE_Evaluate.Score / (16 * Const.NNUE_HiddenSize));
}

Define NNUE_HexToDec(string Hex) (warp=true)
{
    List.DeleteAll(TmpList1);
    List.Add(TmpList1, 0);
    List.Add(TmpList1, 1);
    List.Add(TmpList1, 2);
    List.Add(TmpList1, 3);
    List.Add(TmpList1, 4);
    List.Add(TmpList1, 5);
    List.Add(TmpList1, 6);
    List.Add(TmpList1, 7);
    List.Add(TmpList1, 8);
    List.Add(TmpList1, 9);
    List.Add(TmpList1, "a");
    List.Add(TmpList1, "b");
    List.Add(TmpList1, "c");
    List.Add(TmpList1, "d");
    List.Add(TmpList1, "e");
    List.Add(TmpList1, "f");
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
    NNUE.HTD.Idx = 1;
    Repeat ((Variable.Length(Hex) / 3))
    {
        NNUE.HTD.Word = ((((List.IndexOf(TmpList1, Operator.LetterOf(Hex, NNUE.HTD.Idx)) - 1) * 256) + ((List.IndexOf(TmpList1, Operator.LetterOf(Hex, (NNUE.HTD.Idx + 1))) - 1) * 16)) + (List.IndexOf(TmpList1, Operator.LetterOf(Hex, (NNUE.HTD.Idx + 2))) - 1));
        If (NNUE.HTD.Word > 2048)
        {
            NNUE.HTD.Word = (2048 - NNUE.HTD.Word);
        }
        If (List.Length(NNUE_ListRes_1) < (768 * 256))
        {
            List.Add(NNUE_ListRes_1, (NNUE.HTD.Word + 0));
        }
        Else
        {
            List.Add(NNUE_ListRes_2, (NNUE.HTD.Word + 0));
        }
        NNUE.HTD.Idx += 3;
    }
}

Define NNUE_ImportNetwork(string InputWeights)(string HiddenBias)(string HiddenWeights)(string OutputBias) (warp=true)
{
    List.DeleteAll(NNUE_InputWeights);
    List.DeleteAll(NNUE_InputWeights);
    List.DeleteAll(NNUE_HiddenBias);
    List.DeleteAll(NNUE_HiddenWeights);
    List.DeleteAll(NNUE_OutputBias);
    Call NNUE_DecToHex(InputWeights);
    Glob.NNUE_InputWeights_HEX = Ret.NNUE_DecToHex.Hex;
    Glob.NNUE_HiddenBias_CSV = HiddenBias;
    Glob.NNUE_HIddenWeights_CSV = HiddenWeights;
    Glob.NNUE_OutputBias_CSV = OutputBias;
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
}

Define NNUE_Init (warp=true)
{
    Call NNUE_DecodeNetwork;
    Const.NNUE_HiddenSize = 512;
    Const.NNUE_HiddenPackedSize = 171;
    List.DeleteAll(NNUE_Accumulator);
    Repeat (((Const.NNUE_HiddenPackedSize * 2) * Const.MaxPlyStackFrames))
    {
        List.Add(NNUE_Accumulator, 0);
    }
    List.DeleteAll(NNUE_Accumulator_MetaState);
    List.DeleteAll(NNUE_AccStackState);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(NNUE_Accumulator_MetaState, 0);
        List.Add(NNUE_AccStackState, 0);
    }
    NNUE.Init.SqIdx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        List.ReplaceItem(NNUE_Accumulator, NNUE.Init.SqIdx, NNUE_HiddenBias[NNUE.Init.SqIdx]);
        List.ReplaceItem(NNUE_Accumulator, (Const.NNUE_HiddenPackedSize + NNUE.Init.SqIdx), NNUE_HiddenBias[NNUE.Init.SqIdx]);
        NNUE.Init.SqIdx += 1;
    }
    List.DeleteAll(NNUE_GoKIdxToSquare);
    NNUE.Init.SqIdx = 1;
    Repeat (64)
    {
        List.Add(NNUE_GoKIdxToSquare, ((((8 - IdxToRank[NNUE.Init.SqIdx]) * 8) + IdxToFile[NNUE.Init.SqIdx]) - 1));
        NNUE.Init.SqIdx += 1;
    }
    List.DeleteAll(NNUE_InputIdxMap);
    Repeat (2000)
    {
        List.Add(NNUE_InputIdxMap, 0);
    }
    NNUE.Init.SqIdx = 0;
    Repeat (12)
    {
        NNUE.Init.SqBaseIdx = 0;
        Repeat (64)
        {
            List.ReplaceItem(NNUE_InputIdxMap, (((NNUE.Init.SqIdx * 64) + NNUE.Init.SqBaseIdx) + 1), ((NNUE.Init.SqIdx * 64) + NNUE.Init.SqBaseIdx));
            NNUE.Init.NNIdx = 0;
            NNUE.Init.Exp = 1;
            Repeat (8)
            {
                If (Not ((((NNUE.Init.SqBaseIdx % (NNUE.Init.Exp * 2)) > (NNUE.Init.Exp - 1)) == ((56 % (NNUE.Init.Exp * 2)) > (NNUE.Init.Exp - 1)))))
                {
                    NNUE.Init.NNIdx += NNUE.Init.Exp;
                }
                NNUE.Init.Exp = (NNUE.Init.Exp * 2);
            }
            If (NNUE.Init.SqIdx > 5)
            {
                NNUE.Init.NNIdx += ((NNUE.Init.SqIdx - 6) * 64);
            }
            Else
            {
                NNUE.Init.NNIdx += ((NNUE.Init.SqIdx + 6) * 64);
            }
            List.ReplaceItem(NNUE_InputIdxMap, ((1000 + ((NNUE.Init.SqIdx * 64) + NNUE.Init.SqBaseIdx)) + 1), NNUE.Init.NNIdx);
            NNUE.Init.SqBaseIdx += 1;
        }
        NNUE.Init.SqIdx += 1;
    }
    Call NNUE_Public_Evaluate(1);
}

Define NNUE_LoadList(string Data) (warp=true)
{
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
    NNUE.LL.CharIdx = 1;
    NNUE.LL.Token = "";
    Repeat Until (NNUE.LL.CharIdx > Variable.Length(Data))
    {
        If ((Not ((Operator.LetterOf(Data, NNUE.LL.CharIdx) == " "))) And (Not ((Operator.LetterOf(Data, NNUE.LL.CharIdx) == ","))))
        {
            NNUE.LL.Token = Operator.Join(NNUE.LL.Token, Operator.LetterOf(Data, NNUE.LL.CharIdx));
        }
        If ((Operator.LetterOf(Data, NNUE.LL.CharIdx) == ",") Or (NNUE.LL.CharIdx == Variable.Length(Data)))
        {
            If (List.Length(NNUE_ListRes_1) < (floor((200000 / 256)) * 256))
            {
                List.Add(NNUE_ListRes_1, NNUE.LL.Token);
            }
            Else
            {
                List.Add(NNUE_ListRes_2, NNUE.LL.Token);
            }
            NNUE.LL.Token = "";
        }
        NNUE.LL.CharIdx += 1;
    }
}

Define NNUE_OnApplyMove(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_AccStackState, Ply, 1);
}

Define NNUE_OnInitStack(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_AccStackState, Ply, 1);
}

Define NNUE_Public_Evaluate(string Ply) (warp=true)
{
    Call NNUE_Evaluate(PlyIsOwn[Ply])((Ply - 1));
    Ret.NNUE_Public_Evaluate.Score = Ret.NNUE_Evaluate.Score;
    If (Ret.NNUE_Public_Evaluate.Score > Const.AbsMinCheckmateEval)
    {
        Ret.NNUE_Public_Evaluate.Score = Const.AbsMinCheckmateEval;
    }
    Else
    {
        If (Ret.NNUE_Public_Evaluate.Score < (0 - Const.AbsMinCheckmateEval))
        {
            Ret.NNUE_Public_Evaluate.Score = (0 - Const.AbsMinCheckmateEval);
        }
    }
    If (PlyIsOwn[Ply] == 0)
    {
        Ret.NNUE_Public_Evaluate.Score = (0 - Ret.NNUE_Public_Evaluate.Score);
    }
    If (abs(Ret.NNUE_Public_Evaluate.Score) < Const.AbsMinCheckmateEval)
    {
        Ret.NNUE_Public_Evaluate.Score = (Operator.Round((Ret.NNUE_Public_Evaluate.Score * 100)) / 100);
    }
}

Define NNUE_Public_OnApplyMoveDone(string Ply)(string Move)(string SourcePiece)(string TargetPiece)(string PromotionPiece)(string TargetPieceIdx) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodEnter((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
    }
    If (Move == 0)
    {
        Call NNUE_UpdateAccStack((Ply - 1));
        NNUE.POAMD.PlyBaseIdx = ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1));
        NNUE.POAMD.TargetIdx = ((Const.NNUE_HiddenPackedSize * 2) * Ply);
        NNUE.POAMD.AccIdx = 1;
        Repeat ((Const.NNUE_HiddenPackedSize * 2))
        {
            List.ReplaceItem(NNUE_Accumulator, (NNUE.POAMD.TargetIdx + NNUE.POAMD.AccIdx), NNUE_Accumulator[(NNUE.POAMD.PlyBaseIdx + NNUE.POAMD.AccIdx)]);
            NNUE.POAMD.AccIdx += 1;
        }
        List.ReplaceItem(NNUE_AccStackState, Ply, 0);
        If (Glob.ProfilerMode == Const.ProfilerMode.On)
        {
            Call ProfilerMethodExit((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
        }
        Stop(this script);
    }
    Call NNUE_StartBulkActivation(Ply);
    If (floor((Move / 100)) == 0)
    {
        NNUE.POAMD.KingMove = (CastlingKingMove[(Move + 0)] + 0);
        NNUE.POAMD.RookMove = (CastlingRookMove[(Move + 0)] + 0);
        If (SourcePiece > 0)
        {
            NNUE.POAMD.RookPiece = GoK_BlackRook;
        }
        Else
        {
            NNUE.POAMD.RookPiece = GoK_WhiteRook;
        }
        NNUE.POAMD.SourcePiece = (((6 * (NNUE.POAMD.RookPiece > 0)) + PieceIdxLookup[abs(NNUE.POAMD.RookPiece)]) - 1);
        Call NNUE_ActDeactBulkImpl(floor((NNUE.POAMD.RookMove / 100)))(floor((NNUE.POAMD.RookMove % 100)))(NNUE.POAMD.SourcePiece)(NNUE.POAMD.SourcePiece)(Const.Null)(0)(Ply);
        NNUE.POAMD.FromIdx = floor((NNUE.POAMD.KingMove / 100));
        NNUE.POAMD.ToIdx = floor((NNUE.POAMD.KingMove % 100));
    }
    Else
    {
        NNUE.POAMD.FromIdx = (NNUE_GoKIdxToSquare[floor((Move / 100))] + 0);
        NNUE.POAMD.ToIdx = (NNUE_GoKIdxToSquare[floor((Move % 100))] + 0);
    }
    NNUE.POAMD.SourcePiece = (((6 * (SourcePiece > 0)) + PieceIdxLookup[abs(SourcePiece)]) - 1);
    If (PromotionPiece == 0)
    {
        NNUE.POAMD.PlacedPiece = NNUE.POAMD.SourcePiece;
    }
    Else
    {
        NNUE.POAMD.PlacedPiece = (((6 * (PromotionPiece > 0)) + PieceIdxLookup[abs(PromotionPiece)]) - 1);
    }
    If (TargetPiece == 0)
    {
        NNUE.POAMD.CapturedPiece = Const.Null;
        NNUE.POAMD.CapSquare = 0;
    }
    Else
    {
        NNUE.POAMD.CapturedPiece = (((6 * (TargetPiece > 0)) + PieceIdxLookup[abs(TargetPiece)]) - 1);
        NNUE.POAMD.CapSquare = (NNUE_GoKIdxToSquare[(TargetPieceIdx + 0)] + 0);
    }
    Call NNUE_ActDeactBulkImpl(NNUE.POAMD.FromIdx)(NNUE.POAMD.ToIdx)(NNUE.POAMD.SourcePiece)(NNUE.POAMD.PlacedPiece)(NNUE.POAMD.CapturedPiece)(NNUE.POAMD.CapSquare)(Ply);
    Call NNUE_StopBulkActivation(Ply);
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodExit((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
    }
}

Define NNUE_Public_OnMakeMoveStart(string Ply) (warp=true)
{
}

Define NNUE_Public_Refresh (warp=true)
{
    NNUE.PR.HiddenBiaIdx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        List.ReplaceItem(NNUE_Accumulator, NNUE.PR.HiddenBiaIdx, NNUE_HiddenBias[NNUE.PR.HiddenBiaIdx]);
        List.ReplaceItem(NNUE_Accumulator, (NNUE.PR.HiddenBiaIdx + Const.NNUE_HiddenPackedSize), NNUE_HiddenBias[NNUE.PR.HiddenBiaIdx]);
        NNUE.PR.HiddenBiaIdx += 1;
    }
    NNUE.PR.AccIdx = 1;
    Repeat (64)
    {
        If (Not ((Board[NNUE.PR.AccIdx] == 0)))
        {
            Call NNUE_Activate(NNUE.PR.AccIdx)(Board[NNUE.PR.AccIdx])(0);
        }
        NNUE.PR.AccIdx += 1;
    }
}

Define NNUE_StartBulkActivation(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 1);
}

Define NNUE_StopBulkActivation(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 3);
}

Define NNUE_UpdateAccStack(string Ply) (warp=true)
{
    If (Ply > 0)
    {
        If (NNUE_AccStackState[Ply] == 1)
        {
            Call NNUE_UpdateAccStack((Ply - 1));
            Call UpdateNNUEPostApplyMove(Ply);
            List.ReplaceItem(NNUE_AccStackState, Ply, 0);
        }
    }
}

Define OnEvaluationChanged(string Eval) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Eval == Const.Null)
    {
        Stop(this script);
    }
    If (Glob.Level > 1)
    {
        OEC.ClampedEval = Eval;
        If (OEC.ClampedEval > 1000)
        {
            OEC.ClampedEval = 100;
        }
        Else
        {
            If (OEC.ClampedEval < -1000)
            {
                OEC.ClampedEval = -100;
            }
            Else
            {
                OEC.ClampedEval = (OEC.ClampedEval / 10);
            }
        }
    }
    Else
    {
        OEC.ClampedEval = 0;
    }
    If (Not ((GoK_EvaluationValue == OEC.ClampedEval)))
    {
        GoK_EvaluationValue = OEC.ClampedEval;
        Event.Broadcast("GoK_EvaluationValueChanged");
        Control.Wait(0);
    }
}

Define OnProgressChanged(string Progress) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    OPC.Percent = Operator.Round(Progress);
    If (OPC.Percent > 100)
    {
        OPC.Percent = 100;
    }
    If (OPC.Percent < 0)
    {
        OPC.Percent = 0;
    }
    If (Not ((OPC.Percent == GoK_ProgressValue)))
    {
        GoK_ProgressValue = OPC.Percent;
        Event.Broadcast("GoK_ProgressValueChanged");
        Control.Wait(0);
    }
}

Define OnRestart (warp=true)
{
    Const.ProfilerMode.Off = 0;
    Const.ProfilerMode.On = 1;
    Looks.Say("");
    List.DeleteAll(Logfile);
    List.Add(Logfile, Operator.Join("0.000: ", Glob.VersionString));
    List.Hide(BoardHistory);
    List.Hide(GameMovesAN);
    List.Hide(ExportData);
    List.Hide(CreditsData);
    List.Hide(ExportMoves);
    List.Hide(Logfile);
    List.Hide(ProfilingData);
    Variable.Hide(Glob.IdxDeepening);
    Variable.Hide(Glob.BestMoveEval);
    Variable.Hide(Glob.BestMove);
    Variable.Hide(Glob.NPS);
    Variable.Hide(Glob.MPS);
    Variable.Hide(Glob.PV);
    Variable.Hide(Glob.CustomThinkTime);
    Glob.ProfilerMode = Const.ProfilerMode.Off;
    Glob.DebugMode = 0;
    Glob.TimeControl = -1;
    Glob.IdxDeepening = Const.Null;
    Glob.BestMoveEval = Const.Null;
    Glob.NPS = Const.Null;
    Glob.MPS = Const.Null;
    Glob.PV = "";
    Glob.CustomThinkTime = 0;
    Glob.CustomMaxDepth = 0;
    Glob.InitialClockTime = 0;
    Glob.ClockTimeInc = 0;
    Glob.ClockStageMoves = 0;
    Glob.ClockStageTime = 0;
}

Define PadInto(string value)(string width)(bool rightJustify) (warp=true)
{
    Ret.PadInto.Padded = value;
    Repeat Until (Not ((Variable.Length(Ret.PadInto.Padded) < width)))
    {
        If rightJustify
        {
            Ret.PadInto.Padded = Operator.Join(" ", Ret.PadInto.Padded);
        }
        Else
        {
            Ret.PadInto.Padded = Operator.Join(Ret.PadInto.Padded, " ");
        }
    }
}

Define PickMove(string Ply)(bool Quiescence)(bool UpdateNNUE) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodEnter((480 + Ply));
    }
    Call //("Staged move-generator implementation");
    If (PickPhase[Ply] == 1)
    {
        Call //("Phase 1: Look up hash-move from transposition table");
        List.ReplaceItem(HashMove, Ply, Const.Null);
        List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
        List.ReplaceItem(MovesCount, Ply, 0);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(BestMoveListIdx, Ply, 0);
        Call ClearMoveList(Ply);
        If ((Ply > 1) Or (1 == 1))
        {
            PM.Move = Const.Null;
            PM.Found = 0;
            If (Not ((Ply > List.Length(PVStablePrev))))
            {
                PM.Found = 1;
                PM.CalcMovesScoreListIdx = 1;
                PM.PVStablePrevIdx = 1;
                Repeat Until ((PM.CalcMovesScoreListIdx == Ply) Or (PM.Found == 0))
                {
                    If (Not ((AppliedMove[PM.CalcMovesScoreListIdx] == PVStablePrev[PM.PVStablePrevIdx])))
                    {
                        PM.Found = 0;
                    }
                    PM.CalcMovesScoreListIdx += 1;
                    PM.PVStablePrevIdx += 1;
                }
                If (PM.Found == 1)
                {
                    Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                    If List.ContainsItem(CalcMovesMoveList, PVStablePrev[Ply])
                    {
                        PM.Move = PVStablePrev[Ply];
                    }
                }
            }
            PM.TTQSMeta = NodeTTQSMeta[Ply];
            PM.TTHorizon = NodeTTHorizon[Ply];
            PM.TTHit = NodeTTHit[Ply];
            PM.HashMove = NodeTTMove[Ply];
            If (Glob.ProfilerMode == Const.ProfilerMode.On)
            {
                Call Profile_CountByHorizon(Const.Profile.TTMoveProbe)(HorizonAtPly[Ply])(Ply);
            }
            If ((Not ((PM.TTHit == Const.Null))) And (PM.TTHit == 1))
            {
                If ((PM.Move == Const.Null) And (Not ((PM.HashMove == Const.Null))))
                {
                    Call IsQuiescentCheckCond(Ply);
                    PM.IsTTMoveUsable = 0;
                    If (Not (Quiescence))
                    {
                        PM.IsTTMoveUsable = 1;
                    }
                    Else
                    {
                        If (PM.TTHorizon == -1)
                        {
                            If (Not ((PM.TTQSMeta == Const.Null)))
                            {
                                If (Not ((PM.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue)))
                                {
                                    PM.IsTTMoveUsable = 1;
                                }
                            }
                        }
                    }
                    If (PM.IsTTMoveUsable == 1)
                    {
                        If (Not ((floor((PM.HashMove / 100)) == 0)))
                        {
                            PM.SourceIdx = floor((PM.HashMove / 100));
                            PM.Targetdx = floor((PM.HashMove % 100));
                            PM.SourcePiece = Board[PM.SourceIdx];
                            PM.TargetPiece = Board[PM.Targetdx];
                            PM.CalcMovesScoreListIdx = ((PieceIdxLookup[abs(PM.SourcePiece)] * 10000) + ((PM.SourceIdx * 100) + PM.Targetdx));
                            PM.HashMoveIsIllegalPawnCapture = 0;
                            If ((abs(PM.SourcePiece) == GoK_BlackPawn) And (PM.TargetPiece == 0))
                            {
                                If (Not ((IdxToFile[PM.SourceIdx] == IdxToFile[PM.Targetdx])))
                                {
                                    PM.HashMoveIsIllegalPawnCapture = 1;
                                    If (Not ((EnPassantTarget[Ply] == Const.Null)))
                                    {
                                        If (PM.Targetdx == (EnPassantTarget[Ply] + (8 * (((PM.SourcePiece > 0) * 2) - 1))))
                                        {
                                            PM.HashMoveIsIllegalPawnCapture = 0;
                                        }
                                    }
                                }
                            }
                            PM.HashMovePathClear = 1;
                            If (abs(PM.SourcePiece) == GoK_BlackPawn)
                            {
                                If (IdxToFile[PM.SourceIdx] == IdxToFile[PM.Targetdx])
                                {
                                    If (Not ((PM.TargetPiece == 0)))
                                    {
                                        PM.HashMovePathClear = 0;
                                    }
                                    If (abs((PM.Targetdx - PM.SourceIdx)) == 16)
                                    {
                                        If (Not ((Board[((PM.SourceIdx + PM.Targetdx) / 2)] == 0)))
                                        {
                                            PM.HashMovePathClear = 0;
                                        }
                                    }
                                }
                            }
                            Else
                            {
                                Call IsReachableForAttack(PM.SourcePiece)(PM.SourceIdx)(PM.Targetdx);
                                PM.HashMovePathClear = Ret.IsReachableForAttack.IsReachable;
                            }
                            PM.IsHashMoveLegal = 0;
                            If ((PM.HashMovePathClear == 1) And (PM.HashMoveIsIllegalPawnCapture == 0))
                            {
                                If (PlyIsOwn[Ply] == 1)
                                {
                                    If ((Not ((MoveToHash[(60000 + PM.CalcMovesScoreListIdx)] == 0))) And ((PM.SourcePiece > 0) And (Not ((PM.TargetPiece > 0)))))
                                    {
                                        PM.IsHashMoveLegal = 1;
                                    }
                                }
                                Else
                                {
                                    If ((Not ((MoveToHash[PM.CalcMovesScoreListIdx] == 0))) And ((PM.SourcePiece < 0) And (Not ((PM.TargetPiece < 0)))))
                                    {
                                        PM.IsHashMoveLegal = 1;
                                    }
                                }
                            }
                            If (PM.IsHashMoveLegal == 1)
                            {
                                PM.Move = PM.HashMove;
                                If (Glob.ProfilerMode == Const.ProfilerMode.On)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                }
                            }
                        }
                        Else
                        {
                            Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                            If List.ContainsItem(CalcMovesMoveList, PM.HashMove)
                            {
                                PM.Move = PM.HashMove;
                                If (Glob.ProfilerMode == Const.ProfilerMode.On)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                }
                            }
                        }
                    }
                }
            }
            If (Not ((PM.Move == Const.Null)))
            {
                Call ClearMoveList(Ply);
                PM.MoveScore = 9100000;
                Call AddMoveToList(PM.Move)(Ply)(PM.MoveScore);
                List.ReplaceItem(MovesIdx, Ply, 0);
                List.ReplaceItem(PickPhase, Ply, 2);
                List.ReplaceItem(PickMoveRes, Ply, 0);
                Call PickMove.Iterate(Ply)(2)(UpdateNNUE);
                If (PickMoveRes[Ply] == 1)
                {
                    List.ReplaceItem(HashMove, Ply, PM.Move);
                    If (Glob.ProfilerMode == Const.ProfilerMode.On)
                    {
                        Call ProfilerMethodExit((480 + Ply));
                    }
                    Stop(this script);
                }
            }
        }
        List.ReplaceItem(PickPhase, Ply, 2);
    }
    If (PickPhase[Ply] == 2)
    {
        If (Quiescence Or ((Ply < 4) Or (CheckedState[Ply] == 1)))
        {
            List.ReplaceItem(PickPhase, Ply, 6);
        }
        Else
        {
            Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 1));
            If (Not ((HashMove[Ply] == Const.Null)))
            {
                If (Not (List.ContainsItem(CalcMovesMoveList, HashMove[Ply])))
                {
                    List.Add(CalcMovesMoveList, HashMove[Ply]);
                    List.Add(CalcMovesScoreList, 9100000);
                }
            }
            PM.CalcMovesScoreListIdx = 1;
            Repeat (List.Length(CalcMovesScoreList))
            {
                If (CalcMovesScoreList[PM.CalcMovesScoreListIdx] < 7000000)
                {
                    List.DeleteItem(CalcMovesMoveList, PM.CalcMovesScoreListIdx);
                    List.DeleteItem(CalcMovesScoreList, PM.CalcMovesScoreListIdx);
                }
                Else
                {
                    PM.CalcMovesScoreListIdx += 1;
                }
            }
            Call SortMoveList(Ply);
            List.ReplaceItem(MovesIdx, Ply, 0);
            List.ReplaceItem(PickPhase, Ply, 3);
        }
    }
    If (PickPhase[Ply] == 3)
    {
        Call PickMove.Iterate(Ply)(4)(UpdateNNUE);
    }
    If (PickPhase[Ply] == 4)
    {
        Call PrepareCurrentKillerMoves(Ply);
        PM.CounterMove = Const.Null;
        If (Ply > 1)
        {
            PM.CounterMove = HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))];
        }
        Call PickMove.TryKCMove(CurrentKillerMoves[1])(Ply)(6000000);
        Call PickMove.TryKCMove(CurrentKillerMoves[2])(Ply)(5000000);
        PM.KillerMove1 = CurrentKillerMoves[1];
        PM.KillerMove2 = CurrentKillerMoves[2];
        If ((Ply > 1) And (Not ((PM.CounterMove == Const.Null))))
        {
            If ((Not ((PM.CounterMove == PM.KillerMove1))) And (Not ((PM.CounterMove == PM.KillerMove2))))
            {
                Call PickMove.TryKCMove(HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))])(Ply)(4000000);
            }
        }
        List.ReplaceItem(PickPhase, Ply, 5);
    }
    If (PickPhase[Ply] == 5)
    {
        Call PickMove.Iterate(Ply)(6)(UpdateNNUE);
    }
    If (PickPhase[Ply] == 6)
    {
        Call CalcBoardAttackedOnDemand(Ply)(Quiescence)((1 == 1))(99);
        Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(PickPhase, Ply, 7);
    }
    If (PickPhase[Ply] == 7)
    {
        Call PickMove.Iterate(Ply)(Const.PickPhase.Done)(UpdateNNUE);
    }
    If (PickPhase[Ply] == Const.PickPhase.Done)
    {
        List.ReplaceItem(PickMoveRes, Ply, 0);
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call ProfilerMethodExit((480 + Ply));
    }
}

Define PickMove.Iterate(string Ply)(string NextPhase)(bool UpdateNNUE) (warp=true)
{
    PMI.Picked = 1;
    Repeat Until ((PMI.Picked == 0) Or (Not ((MovesIdx[Ply] < MovesCount[Ply]))))
    {
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
        Call GetCurrentMove(Ply);
        PMI.Move = Ret.GetCurrentMove.Move;
        Call IsMovePicked(Ply)(PMI.Move);
        PMI.Picked = Ret.IsMovePicked.Picked;
        If (PMI.Picked == 0)
        {
            Call IsCastlingPathSafe(PMI.Move)(Ply);
            If (Ret.IsCastlingPathSafe.IsSafe == 0)
            {
                PMI.Picked = 1;
            }
            Else
            {
                List.ReplaceItem(PickedPseudoLegalMoves, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), PMI.Move);
                List.ReplaceItem(PickedPseudoLegalMovesScore, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])]);
                List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, (PickedPseudoLegalMovesCount[Ply] + 1));
                Call ApplyMove(Ply)(UpdateNNUE);
                Call IsMoveLegalFast(Ply);
                If (Ret.IsMoveLegalFast.IsLegal == 1)
                {
                    Call RevertMove(Ply);
                    PMI.Picked = 1;
                }
            }
        }
    }
    If (PMI.Picked == 0)
    {
        List.ReplaceItem(PickMoveRes, Ply, 1);
        Stop(this script);
    }
    List.ReplaceItem(PickPhase, Ply, NextPhase);
}

Define PickMove.TryKCMove(string Move)(string Ply)(string Score) (warp=true)
{
    If (Move == Const.Null)
    {
        Stop(this script);
    }
    PMTKCM.SourceIdx = floor((Move / 100));
    If (PMTKCM.SourceIdx == 0)
    {
        Stop(this script);
    }
    If (((Board[PMTKCM.SourceIdx] * ((PlyIsOwn[Ply] * 2) - 1)) > 0) And (Board[floor((Move % 100))] == 0))
    {
        PMTKCM.IsLegal = MoveToHash[((60000 * PlyIsOwn[Ply]) + ((PieceIdxLookup[abs(Board[PMTKCM.SourceIdx])] * 10000) + Move))];
        If (Not ((PMTKCM.IsLegal == 0)))
        {
            Call IsMovePicked(Ply)(Move);
            If (Ret.IsMovePicked.Picked == 0)
            {
                List.DeleteAll(CalcMovesMoveList);
                List.DeleteAll(CalcMovesScoreList);
                Call GenerateMovesForSource(Ply)(PMTKCM.SourceIdx)((1 == 0))((1 == 0));
                If List.ContainsItem(CalcMovesMoveList, Move)
                {
                    Call AddMoveToList(Move)(Ply)(Score);
                }
            }
        }
    }
}

Define PrepareCheckInfo(string Ply) (warp=true)
{
    List.ReplaceItem(PinCount, Ply, 0);
    List.ReplaceItem(DiscoveryCount, Ply, 0);
    PCI.SideToMoveFactor = (((PlyIsOwn[Ply] == 1) * 2) - 1);
    If (PlyIsOwn[Ply] == 1)
    {
        PCI.OurKingIdx = Glob.BlackKingIdx;
        PCI.TheirKingIdx = Glob.WhiteKingIdx;
    }
    Else
    {
        PCI.OurKingIdx = Glob.WhiteKingIdx;
        PCI.TheirKingIdx = Glob.BlackKingIdx;
    }
    PCI.IsPin = 1;
    Repeat (2)
    {
        If (PCI.IsPin == 1)
        {
            PCI.KingIdx = PCI.OurKingIdx;
            PCI.SliderFactor = -1;
        }
        Else
        {
            PCI.KingIdx = PCI.TheirKingIdx;
            PCI.SliderFactor = 1;
        }
        PCI.LineBaseIdx = (MoveSourceIdxToListOffsetSliding[PCI.KingIdx] + 0);
        PCI.IsStraight = 1;
        Repeat (2)
        {
            If (PCI.IsStraight == 1)
            {
                PCI.SliderPiece = GoK_BlackRook;
            }
            Else
            {
                PCI.SliderPiece = GoK_BlackBishop;
            }
            PCI.DirIdx = 0;
            Repeat (4)
            {
                PCI.StepIdx = 1;
                PCI.BlockerIdx = 0;
                PCI.IsDone = 0;
                Repeat Until ((PCI.StepIdx > 8) Or (PCI.IsDone == 1))
                {
                    If (PCI.IsStraight == 1)
                    {
                        PCI.SqIdx = (MoveSlidingStraightListIdxToTargetIdx[((PCI.LineBaseIdx + (PCI.DirIdx * 8)) + PCI.StepIdx)] + 0);
                    }
                    Else
                    {
                        PCI.SqIdx = (MoveCrossListIdxToTargetIdx[((PCI.LineBaseIdx + (PCI.DirIdx * 8)) + PCI.StepIdx)] + 0);
                    }
                    If (PCI.SqIdx == -1)
                    {
                        PCI.IsDone = 1;
                    }
                    Else
                    {
                        PCI.Piece = (Board[PCI.SqIdx] + 0);
                        If (Not ((PCI.Piece == 0)))
                        {
                            If (PCI.BlockerIdx == 0)
                            {
                                If ((PCI.Piece * PCI.SideToMoveFactor) > 0)
                                {
                                    PCI.BlockerIdx = PCI.SqIdx;
                                }
                                Else
                                {
                                    PCI.IsDone = 1;
                                }
                            }
                            Else
                            {
                                If ((((PCI.Piece * PCI.SideToMoveFactor) * PCI.SliderFactor) > 0) And ((abs(PCI.Piece) == GoK_BlackQueen) Or (abs(PCI.Piece) == PCI.SliderPiece)))
                                {
                                    If (PCI.IsPin == 1)
                                    {
                                        List.ReplaceItem(PinSq, (((Ply - 1) * Const.CheckInfoPlyStride) + (PinCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(PinRay, (((Ply - 1) * Const.CheckInfoPlyStride) + (PinCount[Ply] + 1)), abs(MoveToPathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(PinCount, Ply, (PinCount[Ply] + 1));
                                    }
                                    Else
                                    {
                                        List.ReplaceItem(DiscoverySq, (((Ply - 1) * Const.CheckInfoPlyStride) + (DiscoveryCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(DiscoveryRay, (((Ply - 1) * Const.CheckInfoPlyStride) + (DiscoveryCount[Ply] + 1)), abs(MoveToPathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(DiscoveryCount, Ply, (DiscoveryCount[Ply] + 1));
                                    }
                                }
                                PCI.IsDone = 1;
                            }
                        }
                    }
                    PCI.StepIdx += 1;
                }
                PCI.DirIdx += 1;
            }
            PCI.IsStraight = 0;
        }
        PCI.IsPin = 0;
    }
}

Define PrepareCurrentKillerMoves(string Ply) (warp=true)
{
    If (Not ((List.Length(CurrentKillerMoves) == 2)))
    {
        List.DeleteAll(CurrentKillerMoves);
        List.Add(CurrentKillerMoves, Const.Null);
        List.Add(CurrentKillerMoves, Const.Null);
    }
    PCKM.KillerMoveIdx = (((Ply - 1) * 2) + 1);
    List.ReplaceItem(CurrentKillerMoves, 1, KillerMoves[PCKM.KillerMoveIdx]);
    List.ReplaceItem(CurrentKillerMoves, 2, KillerMoves[(PCKM.KillerMoveIdx + 1)]);
}

Define PrepareEvasionMask(string Ply) (warp=true)
{
    PEM.BoardAttackedEvasionTargetIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 0);
        PEM.BoardAttackedEvasionTargetIdx += 1;
    }
    Call IsCheckedFast((Ply + 1));
    If (Ret.IsCheckedFast.IsChecked == 1)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, Ret.IsCheckedFast.CheckedByIdx, 1);
        If (PlyIsOwn[Ply] == 1)
        {
            PEM.KingIdx = Glob.BlackKingIdx;
        }
        Else
        {
            PEM.KingIdx = Glob.WhiteKingIdx;
        }
        PEM.Move = ((Ret.IsCheckedFast.CheckedByIdx * 100) + PEM.KingIdx);
        PEM.BoardAttackedEvasionTargetIdx = Ret.IsCheckedFast.CheckedByIdx;
        Repeat ((MoveToPathDelta[PEM.Move] - 1))
        {
            PEM.BoardAttackedEvasionTargetIdx += MoveToPathStepInc[PEM.Move];
            List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 1);
        }
    }
}

Define PrepStats (warp=true)
{
    List.DeleteAll(ProfileByHorizon);
    Repeat (1728)
    {
        List.Add(ProfileByHorizon, 0);
    }
    List.DeleteAll(HorizonAtPly);
    Repeat (64)
    {
        List.Add(HorizonAtPly, 0);
    }
    List.DeleteAll(ProfileTimeByHorizon);
    Repeat (576)
    {
        List.Add(ProfileTimeByHorizon, 0);
    }
}

Define PrintStats (warp=true)
{
    Call Log("============================================================")("")("")("")("")("")("")("");
    Glob.ProfileReportLine = "";
    Call PS.Cell("Function")(20)((1 == 0));
    Call PS.Cell("Invoked")(14)((1 == 1));
    Call PS.Cell("Hits/Pruned")(16)((1 == 1));
    Call PS.Cell("Ratio")(10)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call PS.SummaryRow("TT-static-eval")(Const.Profile.TTStaticProbe)(Const.Profile.TTStaticHit)((1 == 0));
    Call PS.SummaryRow("TT-node-eval")(Const.Profile.TTNodeProbe)(Const.Profile.TTNodeHit)((1 == 0));
    Call PS.SummaryRow("TT-hashmove")(Const.Profile.TTMoveProbe)(Const.Profile.TTMoveHit)((1 == 0));
    Call PS.SummaryRow("Razoring")(Const.Profile.RazoringTries)(Const.Profile.RazoringHits)((1 == 0));
    Call PS.SummaryRow("NMP")(Const.Profile.NMPTries)(Const.Profile.NMPHits)((1 == 0));
    Call PS.SummaryRow("RFP")(Const.Profile.RFPCalls)(Const.Profile.RFPHits)((1 == 0));
    Call PS.SummaryRow("Futility")(Const.Profile.FutilityCalls)(Const.Profile.FutilityHits)((1 == 0));
    Call PS.SummaryRow("Delta")(Const.Profile.DeltaCalls)(Const.Profile.DeltaHits)((1 == 0));
    Call PS.SummaryRow("QS-SEE")(Const.Profile.QSEECalls)(Const.Profile.QSEEHits)((1 == 0));
    Call PS.SummaryRow("LMR")(Const.Profile.LMRCalls)(Const.Profile.LMRHits)((1 == 0));
    Call PS.SummaryRow("Non-PV search")(Const.Profile.PVSCalls)(Const.Profile.PVSReSearches)((1 == 1));
    Call PS.CountRow("Full Search")(Const.Profile.FullCalls);
    Call PS.CountRow("Extensions")(Const.Profile.Ext);
    Call Log("============================================================")("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon invocations and runtime, s (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 1));
    PS.Horizon = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.Horizon)((1 == 0));
        PS.Horizon += 1;
    }
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon hit ratio (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 0));
    PS.Horizon = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.Horizon)((1 == 1));
        PS.Horizon += 1;
    }
}

Define ProbePawnHist(string Piece)(string To) (warp=true)
{
    PPH.PawnHistKey = Glob.KPHash;
    Call GetPiecePosHash(Board[Glob.WhiteKingIdx])(Glob.WhiteKingIdx);
    PPH.PawnHistKey += (-1 * Ret.GetPiecePosHash.Hash);
    Call GetPiecePosHash(Board[Glob.BlackKingIdx])(Glob.BlackKingIdx);
    PPH.PawnHistKey += (-1 * Ret.GetPiecePosHash.Hash);
    PPH.PawnHistPieceIdx = PieceIdxLookup[abs(GoK_WhiteKing)];
    If (abs(Piece) > 0)
    {
        PPH.PawnHistPieceIdx = PieceIdxLookup[abs(Piece)];
    }
    Ret.ProbePawnHist.Idx = (((PPH.PawnHistKey % 512) * 384) + (((PPH.PawnHistPieceIdx - 1) * 64) + To));
}

Define ProfilerMethodEnter(string Id) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Repeat Until (Not ((List.Length(ProfilingData) < Id)))
        {
            List.Add(ProfilingData, 0);
        }
        List.ReplaceItem(ProfilingData, Id, (ProfilingData[Id] - ((Sensing.DaysSince2000() * 24) * 3600)));
        ProfMEn.CategoryIdx = floor(((Id - 1) / 60));
        ProfMEn.Ply = (Id - (ProfMEn.CategoryIdx * 60));
        Call Profile_TimeByHorizon((ProfMEn.CategoryIdx * 64))(ProfMEn.Ply)(-1);
    }
}

Define ProfilerMethodExit(string Id) (warp=false)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        List.ReplaceItem(ProfilingData, Id, (ProfilingData[Id] + ((Sensing.DaysSince2000() * 24) * 3600)));
        ProfMEx.CategoryIdx = floor(((Id - 1) / 60));
        ProfMEx.Ply = (Id - (ProfMEx.CategoryIdx * 60));
        Call Profile_TimeByHorizon((ProfMEx.CategoryIdx * 64))(ProfMEx.Ply)(1);
    }
}

Define ProfilerReset (warp=true)
{
    List.DeleteItem(ProfilingData, all);
}

Define Profile_CountByHorizon(string BaseIdx)(string Horizon)(string Ply) (warp=true)
{
    ProfCBH.Slot = (Horizon + 1);
    If (Quiescence[Ply] == 1)
    {
        ProfCBH.Slot = 64;
    }
    List.ReplaceItem(ProfileByHorizon, (BaseIdx + ProfCBH.Slot), (ProfileByHorizon[(BaseIdx + ProfCBH.Slot)] + 1));
}

Define Profile_TimeByHorizon(string BaseIdx)(string Ply)(string TimeSign) (warp=true)
{
    ProfTBH.Slot = (HorizonAtPly[Ply] + 1);
    If (Quiescence[Ply] == 1)
    {
        ProfTBH.Slot = 64;
    }
    List.ReplaceItem(ProfileTimeByHorizon, (BaseIdx + ProfTBH.Slot), (ProfileTimeByHorizon[(BaseIdx + ProfTBH.Slot)] + (TimeSign * ((Sensing.DaysSince2000() * 24) * 3600))));
}

Define PS.Cell(string Value)(string Width)(bool RightJustify) (warp=true)
{
    Call PadInto(Value)(Width)(RightJustify);
    Glob.ProfileReportLine = Operator.Join(Glob.ProfileReportLine, Ret.PadInto.Padded);
}

Define PS.CountRow(string Label)(string Slot) (warp=true)
{
    Call PS.Sum(Slot);
    Glob.ProfileReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(Ret.PS.Sum.Total)(14)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonHeader(bool WithTimes) (warp=true)
{
    Glob.ProfileReportLine = "";
    Call PS.Cell("Horizon")(9)((1 == 0));
    Call PS.Cell("Razor")(9)((1 == 1));
    Call PS.Cell("RFP")(9)((1 == 1));
    Call PS.Cell("NMP")(9)((1 == 1));
    Call PS.Cell("Futil")(9)((1 == 1));
    Call PS.Cell("Delta")(9)((1 == 1));
    Call PS.Cell("QSEE")(9)((1 == 1));
    Call PS.Cell("LMR")(9)((1 == 1));
    Call PS.Cell("PVS")(9)((1 == 1));
    Call PS.Cell("TTnode")(9)((1 == 1));
    Call PS.Cell("TThash")(9)((1 == 1));
    If WithTimes
    {
        Call PS.Cell("EvalS")(9)((1 == 1));
        Call PS.Cell("MgenS")(9)((1 == 1));
        Call PS.Cell("PickS")(9)((1 == 1));
    }
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonRow(string Horizon)(bool Ratios) (warp=true)
{
    If ((((((((((ProfileByHorizon[(Const.Profile.RazoringCalls + Horizon)] + ProfileByHorizon[(Const.Profile.RFPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.NMPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.FutilityCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.DeltaCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.QSEECalls + Horizon)]) + ProfileByHorizon[(Const.Profile.LMRCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.PVSCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.TTNodeProbe + Horizon)]) + ProfileByHorizon[(Const.Profile.TTMoveProbe + Horizon)]) > 0)
    {
        If (Horizon == 64)
        {
            PS.HorizonRow.Label = "Q";
        }
        Else
        {
            PS.HorizonRow.Label = (Horizon - 1);
        }
        Glob.ProfileReportLine = "";
        Call PS.Cell(PS.HorizonRow.Label)(9)((1 == 0));
        If Ratios
        {
            Call PS.RatioCell(Const.Profile.RazoringHits)(Const.Profile.RazoringCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.RFPHits)(Const.Profile.RFPCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.NMPHits)(Const.Profile.NMPCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.FutilityHits)(Const.Profile.FutilityCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.DeltaHits)(Const.Profile.DeltaCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.QSEEHits)(Const.Profile.QSEECalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.LMRHits)(Const.Profile.LMRCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.PVSReSearches)(Const.Profile.PVSCalls)(Horizon)((1 == 1));
            Call PS.RatioCell(Const.Profile.TTNodeHit)(Const.Profile.TTNodeProbe)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.TTMoveHit)(Const.Profile.TTMoveProbe)(Horizon)((1 == 0));
        }
        Else
        {
            Call PS.Cell(ProfileByHorizon[(Const.Profile.RazoringCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.RFPCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.NMPCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.FutilityCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.DeltaCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.QSEECalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.LMRCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.PVSCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTNodeProbe + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTMoveProbe + Horizon)])(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.EvaluateBaseIdx + Horizon)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * (ProfileTimeByHorizon[(Const.ProfileTime.MoveGenImplBaseIdx + Horizon)] + ProfileTimeByHorizon[(Const.ProfileTime.MoveGenBaseIdx + Horizon)]))) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.PickMoveBaseIdx + Horizon)])) / 100))(9)((1 == 1));
        }
        Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
    }
}

Define PS.RatioCell(string HitSlot)(string InvSlot)(string Horizon)(bool HitSlotCountsMisses) (warp=true)
{
    PS.RatioCell.CallCount = ProfileByHorizon[(InvSlot + Horizon)];
    PS.RatioCell.HitCount = ProfileByHorizon[(HitSlot + Horizon)];
    If HitSlotCountsMisses
    {
        PS.RatioCell.HitCount = (PS.RatioCell.CallCount - PS.RatioCell.HitCount);
    }
    Call PS.Cell(Operator.Join((floor(((1000 * PS.RatioCell.HitCount) / (PS.RatioCell.CallCount + (PS.RatioCell.CallCount == 0)))) / 10), "%"))(9)((1 == 1));
}

Define PS.Sum(string Slot) (warp=true)
{
    PS.Sum.Idx = 1;
    Ret.PS.Sum.Total = 0;
    Repeat (64)
    {
        Ret.PS.Sum.Total += ProfileByHorizon[(Slot + PS.Sum.Idx)];
        PS.Sum.Idx += 1;
    }
}

Define PS.SummaryRow(string Label)(string InvSlot)(string HitSlot)(bool HitSlotCountsMisses) (warp=true)
{
    Call PS.Sum(InvSlot);
    PS.SummaryRow.CallCount = Ret.PS.Sum.Total;
    Call PS.Sum(HitSlot);
    PS.SummaryRow.HitCount = Ret.PS.Sum.Total;
    If HitSlotCountsMisses
    {
        PS.SummaryRow.HitCount = (PS.SummaryRow.CallCount - PS.SummaryRow.HitCount);
    }
    Glob.ProfileReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(PS.SummaryRow.CallCount)(14)((1 == 1));
    Call PS.Cell(PS.SummaryRow.HitCount)(16)((1 == 1));
    Call PS.Cell(Operator.Join(floor(((100 * PS.SummaryRow.HitCount) / (PS.SummaryRow.CallCount + (PS.SummaryRow.CallCount == 0)))), "%"))(10)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define PublishTimers(string EngineElapsed) (warp=true)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (((Glob.TimeControl == 1) And ((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0))) And (Glob.CustomMaxDepth == 0))
    {
        Timers_EngineTime = (Glob.CurrentClockTime - EngineElapsed);
        If (Glob.PlayerClockRunning == 1)
        {
            Timers_PlayerTime = (Glob.PlayerClockTime - ((Sensing.DaysSince2000() * 86400) - Glob.PlayerMoveStart));
        }
        Else
        {
            Timers_PlayerTime = Glob.PlayerClockTime;
        }
    }
    Else
    {
        Timers_EngineTime = "";
        Timers_PlayerTime = "";
    }
    Event.Broadcast("Timers_Changed");
}

Define QuickSort (warp=true)
{
    List.DeleteAll(QSPartStack);
    Call QuickSortImpl(1)(List.Length(CalcMovesScoreList));
}

Define QuickSortImpl(string Lo)(string Hi) (warp=true)
{
    QSI.PivotScore = CalcMovesScoreList[floor(((Lo + Hi) / 2))];
    QSI.LowerIdx = Lo;
    QSI.UpperIdx = Hi;
    Repeat Until (QSI.LowerIdx > QSI.UpperIdx)
    {
        Repeat Until (Not ((CalcMovesScoreList[QSI.LowerIdx] > QSI.PivotScore)))
        {
            QSI.LowerIdx += 1;
        }
        Repeat Until (Not ((CalcMovesScoreList[QSI.UpperIdx] < QSI.PivotScore)))
        {
            QSI.UpperIdx += -1;
        }
        If (Not ((QSI.LowerIdx > QSI.UpperIdx)))
        {
            QSI.SwapScore = CalcMovesScoreList[QSI.LowerIdx];
            List.ReplaceItem(CalcMovesScoreList, QSI.LowerIdx, CalcMovesScoreList[QSI.UpperIdx]);
            List.ReplaceItem(CalcMovesScoreList, QSI.UpperIdx, QSI.SwapScore);
            QSI.SwapScore = CalcMovesMoveList[QSI.LowerIdx];
            List.ReplaceItem(CalcMovesMoveList, QSI.LowerIdx, CalcMovesMoveList[QSI.UpperIdx]);
            List.ReplaceItem(CalcMovesMoveList, QSI.UpperIdx, QSI.SwapScore);
            QSI.LowerIdx += 1;
            QSI.UpperIdx += -1;
        }
    }
    If (Lo < QSI.UpperIdx)
    {
        List.Add(QSPartStack, QSI.LowerIdx);
        Call QuickSortImpl(Lo)(QSI.UpperIdx);
        QSI.LowerIdx = QSPartStack[List.Length(QSPartStack)];
        List.DeleteItem(QSPartStack, List.Length(QSPartStack));
    }
    If (QSI.LowerIdx < Hi)
    {
        Call QuickSortImpl(QSI.LowerIdx)(Hi);
    }
}

Define RevertMove(num Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
    }
    RM.Move = AppliedMove[Ply];
    If (RM.Move == Const.Null)
    {
        RM.SourceIdx = 0;
    }
    Else
    {
        RM.SourceIdx = floor((RM.Move / 100));
    }
    If (RM.SourceIdx > 0)
    {
        RM.TargetIdx = floor((RM.Move % 100));
        List.ReplaceItem(Board, RM.SourceIdx, Board[RM.TargetIdx]);
        List.ReplaceItem(Board, RM.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (PromotionPieces[Ply] > 0)
        {
            RM.PromotionCode = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
            If (RM.PromotionCode == 1)
            {
                Glob.BlackQueenCount += -1;
            }
            If (RM.PromotionCode == 2)
            {
                Glob.BlackRookCount += -1;
                Glob.BlackNonQueenMajorMinorCount += -1;
            }
            If (RM.PromotionCode == 3)
            {
                Glob.BlackNonQueenMajorMinorCount += -1;
            }
            If (RM.PromotionCode == 4)
            {
                Glob.BlackNonQueenMajorMinorCount += -1;
            }
            List.ReplaceItem(Board, RM.SourceIdx, GoK_BlackPawn);
            Glob.BlackPawnCount += 1;
        }
        Else
        {
            If (PromotionPieces[Ply] < 0)
            {
                RM.PromotionCode = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
                If (RM.PromotionCode == 1)
                {
                    Glob.WhiteQueenCount += -1;
                }
                If (RM.PromotionCode == 2)
                {
                    Glob.WhiteRookCount += -1;
                    Glob.WhiteNonQueenMajorMinorCount += -1;
                }
                If (RM.PromotionCode == 3)
                {
                    Glob.WhiteNonQueenMajorMinorCount += -1;
                }
                If (RM.PromotionCode == 4)
                {
                    Glob.WhiteNonQueenMajorMinorCount += -1;
                }
                List.ReplaceItem(Board, RM.SourceIdx, GoK_WhitePawn);
                Glob.WhitePawnCount += 1;
            }
        }
        If (Board[RM.SourceIdx] == GoK_BlackKing)
        {
            Glob.BlackKingIdx = RM.SourceIdx;
        }
        If (Board[RM.SourceIdx] == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = RM.SourceIdx;
        }
        RM.TargetPiece = TargetPieces[Ply];
        If (RM.TargetPiece > 0)
        {
            If (RM.TargetPiece == GoK_BlackPawn)
            {
                Glob.BlackPawnCount += 1;
            }
            Else
            {
                If (RM.TargetPiece < GoK_BlackQueen)
                {
                    Glob.BlackNonQueenMajorMinorCount += 1;
                    If (RM.TargetPiece == GoK_BlackRook)
                    {
                        Glob.BlackRookCount += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_BlackQueen)
                    {
                        Glob.BlackQueenCount += 1;
                    }
                }
            }
        }
        If (RM.TargetPiece < 0)
        {
            If (RM.TargetPiece == GoK_WhitePawn)
            {
                Glob.WhitePawnCount += 1;
            }
            Else
            {
                If (RM.TargetPiece > GoK_WhiteQueen)
                {
                    Glob.WhiteNonQueenMajorMinorCount += 1;
                    If (RM.TargetPiece == GoK_WhiteRook)
                    {
                        Glob.WhiteRookCount += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_WhiteQueen)
                    {
                        Glob.WhiteQueenCount += 1;
                    }
                }
            }
        }
    }
    Else
    {
        If ((Not ((RM.Move == Const.Null))) And (RM.Move == GoK_WhiteKingsideCastling))
        {
            List.ReplaceItem(Board, 61, GoK_WhiteKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_WhiteRook);
            Glob.WhiteKingIdx = 61;
        }
        Else
        {
            If ((Not ((RM.Move == Const.Null))) And (RM.Move == GoK_WhiteQueensideCastling))
            {
                List.ReplaceItem(Board, 57, GoK_WhiteRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_WhiteKing);
                Glob.WhiteKingIdx = 61;
            }
            Else
            {
                If ((Not ((RM.Move == Const.Null))) And (RM.Move == GoK_BlackKingsideCastling))
                {
                    List.ReplaceItem(Board, 5, GoK_BlackKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_BlackRook);
                    Glob.BlackKingIdx = 5;
                }
                Else
                {
                    If ((Not ((RM.Move == Const.Null))) And (RM.Move == GoK_BlackQueensideCastling))
                    {
                        List.ReplaceItem(Board, 1, GoK_BlackRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_BlackKing);
                        Glob.BlackKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
    Glob.KPHash = (PreviousBoardHashKP[Ply] + 0);
    Glob.NonPawnHashBlack = PreviousNonPawnHashBlack[Ply];
    Glob.NonPawnHashWhite = PreviousNonPawnHashWhite[Ply];
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
    If (Ply == 1)
    {
        Call SetInitialEnPassantTarget(1);
    }
}

Define RevertMoveLight(string Ply) (warp=true)
{
    RML.Move = AppliedMove[Ply];
    RML.SourceIdx = floor((RML.Move / 100));
    If (RML.SourceIdx > 0)
    {
        RML.TargetIdx = floor((RML.Move % 100));
        List.ReplaceItem(Board, RML.SourceIdx, Board[RML.TargetIdx]);
        List.ReplaceItem(Board, RML.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (Board[RML.SourceIdx] == GoK_BlackKing)
        {
            Glob.BlackKingIdx = RML.SourceIdx;
        }
        If (Board[RML.SourceIdx] == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = RML.SourceIdx;
        }
    }
    Else
    {
        If (RML.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(Board, 61, GoK_WhiteKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_WhiteRook);
            Glob.WhiteKingIdx = 61;
        }
        Else
        {
            If (RML.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(Board, 57, GoK_WhiteRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_WhiteKing);
                Glob.WhiteKingIdx = 61;
            }
            Else
            {
                If (RML.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(Board, 5, GoK_BlackKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_BlackRook);
                    Glob.BlackKingIdx = 5;
                }
                Else
                {
                    If (RML.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(Board, 1, GoK_BlackRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_BlackKing);
                        Glob.BlackKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
}

Define SayAsync(string Text)(num Duration) (warp=false)
{
    Glob.SayAsyncText = Text;
    Glob.SayAsyncDuration = Duration;
    Event.Broadcast("sayasyncmsg");
}

Define Search(string Alpha)(string Beta)(string Horizon)(string Ply)(bool InitialDeepening) (warp=true)
{
    Glob.IsInitialDeepening = (InitialDeepening + 0);
    Glob.SearchAlpha = Alpha;
    Glob.SearchBeta = Beta;
    Call InitSearch(Horizon);
    Call Evaluate(0)((1 == 1));
    Glob.MoveCount = 0;
    Glob.MoveCountQuiescence = 0;
    Glob.NodeCount = 0;
    Glob.NodeCountQuiescence = 0;
    Glob.ProfBestMoveCount = 0;
    Glob.ProfBestMoveIdxSum = 0;
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call PrepStats;
    }
    Glob.ProfBestMoveCountQuiescence = 0;
    Glob.ProfBestMoveIdxSumQuiescence = 0;
    Search.Timer = (Sensing.DaysSince2000() * 86400);
    Call SearchImpl(Alpha)(Beta)(Horizon)(Ply)((1 == 0))((1 == 0));
    Ret.Search.Eval = Ret.SearchImpl.Eval;
    Ret.Search.Move = Ret.SearchImpl.Move;
    Ret.Search.LegalMoveCount = PickedLegalMovesCount[Ply];
    Search.Timer = ((Sensing.DaysSince2000() * 86400) - Search.Timer);
    Call ExportBoardFEN((1 == 0));
    Call Log("PV: ")("[FEN "")(Ret.ExportBoardFEN.FEN)(""] ")(Glob.PV)("")("")("");
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log("SEARCH STATS")("")("")("")("")("")("")("");
        Call Log("Depth = ")(Horizon)(", Time = ")((Operator.Round((Search.Timer * 100)) / 100))("")("")("")("");
        Call Log((Glob.MoveCount + Glob.MoveCountQuiescence))(" moves (all), ")((Operator.Round((((Glob.MoveCount + Glob.MoveCountQuiescence) / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log((Glob.NodeCount + Glob.NodeCountQuiescence))(" nodes (all), ")((Operator.Round((((Glob.NodeCount + Glob.NodeCountQuiescence) / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call Log("Avg. best move idx (full) = ")((Operator.Round(((Glob.ProfBestMoveIdxSum / Glob.ProfBestMoveCount) * 100)) / 100))("")("")("")("")("")("");
        Call Log("Avg. best move idx (q) = ")((Operator.Round(((Glob.ProfBestMoveIdxSumQuiescence / Glob.ProfBestMoveCountQuiescence) * 100)) / 100))("")("")("")("")("")("");
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log(Glob.MoveCount)(" moves (full), ")((Operator.Round(((Glob.MoveCount / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log(Glob.NodeCount)(" nodes (full), ")((Operator.Round(((Glob.NodeCount / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call Log(Glob.MoveCountQuiescence)(" moves (q), ")((Operator.Round(((Glob.MoveCountQuiescence / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log(Glob.NodeCountQuiescence)(" nodes (q), ")((Operator.Round(((Glob.NodeCountQuiescence / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call PrintStats;
    }
    Glob.MPS = Operator.Round(((Glob.MoveCount + Glob.MoveCountQuiescence) / Search.Timer));
    Glob.NPS = Operator.Round(((Glob.NodeCount + Glob.NodeCountQuiescence) / Search.Timer));
    If (Not ((Ret.Search.Move == Const.Null)))
    {
        List.DeleteAll(PVStablePrev);
        Search.PVStableIdx = 1;
        Repeat (List.Length(PVStable))
        {
            List.Add(PVStablePrev, PVStable[Search.PVStableIdx]);
            Search.PVStableIdx += 1;
        }
        Call IsQuietMove(Ret.Search.Move);
        If (Ret.IsQuietMove.IsQuiet == 1)
        {
            If (Not ((Ret.Search.Eval < Beta)))
            {
                Call StoreKillerMove(1)(Ret.Search.Move)(Horizon)((1 == 0))((1 == 0))((1 == 1));
            }
        }
    }
}

Define SearchImpl(string Alpha)(string Beta)(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    List.ReplaceItem(Alphas, Ply, Alpha);
    List.ReplaceItem(Betas, Ply, Beta);
    If (Ply == 1)
    {
        Ret.SearchImpl.Eval = Const.Null;
        Ret.SearchImpl.Move = Const.Null;
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        List.ReplaceItem(HorizonAtPly, Ply, Horizon);
    }
    Call //("Search function (minimax / alpha-beta pruning)");
    List.ReplaceItem(SearchEval, Ply, Const.Null);
    If (Glob.IsSearchTimeout == 1)
    {
        Stop(this script);
    }
    Call //("Required for TT access and draw detection");
    Call Search_InitStack(Ply)(Quiescence);
    Call Search_DetectCheckmate(Ply);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    Call Search_DetectDrawByRepetition(Ply)(Quiescence);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    If ((Not (Quiescence)) And (Ply > 1))
    {
        SI.GamePly = List.Length(BoardHistoryFiftyMoves);
        If (Not (((-100000 + SI.GamePly) < Betas[Ply])))
        {
            List.ReplaceItem(SearchEval, Ply, (-100000 + SI.GamePly));
            Stop(this script);
        }
        If (Not (((100000 - (SI.GamePly + 1)) > Alphas[Ply])))
        {
            List.ReplaceItem(SearchEval, Ply, Alphas[Ply]);
            Stop(this script);
        }
    }
    Call TTProbeNodeAtPly(Ply);
    Call Search_TTProbeEval(Horizon)(Ply)(Cutnode)(Quiescence);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    Call Search_DetectDraw(Horizon)(Ply);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    If (Ply > (Const.MaxPlyStackFrames - 10))
    {
        Call //("Search tree leaf reached => evaluate board and return result");
        Call //("This will seldomly be invoked, as the usual search termination is quiescence search having reached a quite position");
        Call Evaluate((Ply - 1))((1 == 1));
