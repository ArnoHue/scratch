    Glob.GameMoves = "";
    GoK_IsGameSuspended = 0;
    Glob.PrevProgressUpdate = 0;
    GoK_Empty = 0;
    GoK_WhiteKing = -50000;
    GoK_WhiteQueen = -936;
    GoK_WhiteRook = -512;
    GoK_WhiteBishop = -297;
    GoK_WhiteKnight = -281;
    GoK_WhitePawn = -114;
    GoK_BlackKing = 50000;
    GoK_BlackQueen = 936;
    GoK_BlackRook = 512;
    GoK_BlackBishop = 297;
    GoK_BlackKnight = 281;
    GoK_BlackPawn = 114;
    Const.AbsMinCheckmateEval = (GoK_BlackKing - 10000);
    Const.AbsMaxCheckmateEval = 100000;
    Const.DrawByRepetitionEval = -19.9;
    Const.EmptyVal = -999999999;
    Const.PawnAdvance.WhiteRear = 0;
    Const.PawnAdvance.WhiteFront = 8;
    Const.PawnAdvance.BlackRear = 16;
    Const.PawnAdvance.BlackFront = 24;
    TTNodeColIdx.Hash = 0;
    TTNodeColIdx.Age = 1;
    TTNodeColIdx.QSMeta = 2;
    TTNodeColIdx.BestMove = 3;
    TTNodeColIdx.Score = 4;
    TTNodeColIdx.Type = 5;
    TTNodeColIdx.Checked = 6;
    TTNodeColIdx.Horizon = 7;
    TTNodeColIdx.StaticEval = 8;
    Const.TTNodeEntrySize = 9;
    List.DeleteItem(NodeTypeLookup, all);
    List.Add(NodeTypeLookup, "");
    List.Add(NodeTypeLookup, "A");
    List.Add(NodeTypeLookup, "B");
    List.Add(NodeTypeLookup, "E");
    Const.MaxPlyStackFrames = 60;
    Const.Profile.TTNodeProbe = 0;
    Const.Profile.TTNodeHit = 64;
    Const.Profile.Razoring_Inv = 128;
    Const.Profile.Razoring_Try = 192;
    Const.Profile.Razoring_Hit = 256;
    Const.Profile.RFP_Inv = 320;
    Const.Profile.RFP_Hit = 384;
    Const.Profile.NMP_Inv = 448;
    Const.Profile.NMP_Try = 512;
    Const.Profile.NMP_Hit = 576;
    Const.Profile.Futility_Inv = 640;
    Const.Profile.Futility_Hit = 704;
    Const.Profile.Delta_Inv = 768;
    Const.Profile.Delta_Hit = 832;
    Const.Profile.QSEE_Inv = 896;
    Const.Profile.QSEE_Hit = 960;
    Const.Profile.LMR_Inv = 1024;
    Const.Profile.LMR_Hit = 1088;
    Const.Profile.PVS_Inv = 1152;
    Const.Profile.PVS_ReSearch = 1216;
    Const.Profile.Full_Inv = 1280;
    Const.Profile.Ext = 1344;
    Const.Profile.ExtSingular = 1408;
    Const.Profile.TTStaticProbe = 1472;
    Const.Profile.TTStaticHit = 1536;
    Const.Profile.TTMoveProbe = 1600;
    Const.Profile.TTMoveHit = 1664;
    Const.MaxMovesPerGeneration = 300;
    Call InitCoordLookup;
    Call FillBoard;
    List.DeleteAll(PieceIdxLookup);
    Init.Board.Idx = 1;
    Repeat (GoK_BlackKing)
    {
        List.Add(PieceIdxLookup, 0);
        Init.Board.Idx += 1;
    }
    List.ReplaceItem(PieceIdxLookup, GoK_BlackPawn, 1);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackKnight, 2);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackBishop, 3);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackRook, 4);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackQueen, 5);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackKing, 6);
    Const.CharsUpperCase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    List.DeleteItem(CharsUpperCaseList, all);
    Init.Board.Idx = 1;
    Repeat (List.Length(CharsUpperCaseList))
    {
        List.Add(CharsUpperCaseList, Operator.LetterOf(Const.CharsUpperCase, Init.Board.Idx));
        Init.Board.Idx += 1;
    }
    List.DeleteItem(KillerMoves, all);
    Repeat ((2 * Const.MaxPlyStackFrames))
    {
        List.Add(KillerMoves, "");
    }
    List.DeleteAll(PinSq);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(PinSq, 0);
    }
    List.DeleteAll(PinRay);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(PinRay, 0);
    }
    List.DeleteAll(PinCount);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(PinCount, 0);
    }
    List.DeleteAll(DiscoverySq);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(DiscoverySq, 0);
    }
    List.DeleteAll(DiscoveryRay);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(DiscoveryRay, 0);
    }
    List.DeleteAll(DiscoveryCount);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(DiscoveryCount, 0);
    }
    List.DeleteItem(HistoryMoveScores, all);
    Repeat (8400)
    {
        List.Add(HistoryMoveScores, 0);
    }
    List.DeleteItem(HistoryPawnHist, all);
    Repeat (196608)
    {
        List.Add(HistoryPawnHist, -1188);
    }
    List.DeleteAll(HistoryCaptureScores);
    Repeat (2500)
    {
        List.Add(HistoryCaptureScores, 0);
    }
    List.DeleteAll(CorrHistVal);
    Repeat (200000)
    {
        List.Add(CorrHistVal, 0);
    }
    List.DeleteAll(CorrHistKey);
    Repeat (200000)
    {
        List.Add(CorrHistKey, 0);
    }
    List.DeleteAll(CorrHistNP);
    Repeat (200000)
    {
        List.Add(CorrHistNP, 0);
    }
    List.DeleteAll(CorrHistNPKey);
    Repeat (200000)
    {
        List.Add(CorrHistNPKey, 0);
    }
    List.DeleteItem(HistoryCounterMoves, all);
    Repeat (10000)
    {
        List.Add(HistoryCounterMoves, 0);
    }
    List.DeleteItem(HistoryContinuation, all);
    List.DeleteItem(HistoryContinuation2, all);
    List.DeleteItem(HistoryContinuation3, all);
    List.DeleteItem(HistoryContinuation4, all);
    If (Glob.IsScratch3 == 0)
    {
        Repeat (400000)
        {
            List.Add(HistoryContinuation, 0);
            List.Add(HistoryContinuation2, 0);
            List.Add(HistoryContinuation3, 0);
            List.Add(HistoryContinuation4, 0);
        }
    }
    List.DeleteItem(BoardHistory, all);
    List.DeleteItem(BoardHistoryFiftyMoves, all);
    List.DeleteItem(BoardHistoryHash, all);
    List.DeleteItem(BoardHistoryMetaState, all);
    List.DeleteItem(BoardHistoryWasEngineMove, all);
    List.DeleteItem(GameMovesAN, all);
    List.DeleteItem(BoardAttackedByWhite, all);
    List.DeleteItem(BoardAttackedByBlack, all);
    List.DeleteItem(PieceMobility, all);
    List.DeleteItem(BoardAttackedEvasionTarget, all);
    List.DeleteItem(BoardAttackedByWhitePiece, all);
    List.DeleteItem(BoardAttackedByBlackPiece, all);
    List.DeleteItem(BoardAttackedByOpponentSnapshot, all);
    List.DeleteItem(BoardAttackedByOpponentPieceSnapshot, all);
    Repeat (64)
    {
        List.Add(BoardAttackedByWhite, 0);
        List.Add(BoardAttackedByBlack, 0);
        List.Add(PieceMobility, 0);
        List.Add(BoardAttackedEvasionTarget, 0);
        List.Add(BoardAttackedByWhitePiece, 0);
        List.Add(BoardAttackedByBlackPiece, 0);
    }
    Repeat ((100 * Const.MaxPlyStackFrames))
    {
        List.Add(BoardAttackedByOpponentSnapshot, 0);
        List.Add(BoardAttackedByOpponentPieceSnapshot, 0);
    }
    Call Comment("Due to the lack of local variables in Scratch, we emulate a method stack for recursive Minimax using lists");
    List.DeleteItem(Alphas, all);
    List.DeleteItem(PlyHistOffset, all);
    List.DeleteItem(PlyIsOwn, all);
    List.DeleteItem(PlySign, all);
    List.DeleteItem(PlyContOffset, all);
    List.DeleteItem(PlyCMOffset, all);
    List.DeleteItem(PlyCorrOffset, all);
    List.DeleteItem(Betas, all);
    List.DeleteItem(AlphasOld, all);
    List.DeleteItem(SearchEval, all);
    List.DeleteItem(MovesCount, all);
    List.DeleteItem(MovesIdx, all);
    List.DeleteItem(BestMoveListIdx, all);
    List.DeleteItem(TargetPieces, all);
    List.DeleteItem(PreviousBoardHash, all);
    List.DeleteItem(PreviousBoardHashKP, all);
    List.DeleteItem(NodeTypes, all);
    List.DeleteItem(PickMoveRes, all);
    List.DeleteItem(PickPhase, all);
    List.DeleteItem(PickedPseudoLegalMovesCount, all);
    List.DeleteItem(BestMoves, all);
    List.DeleteItem(CheckedState, all);
    List.DeleteItem(PromotionPieces, all);
    List.DeleteItem(TargetPiecesIdx, all);
    List.DeleteItem(BoardAttackedCalculated, all);
    List.DeleteItem(PutsInCheck, all);
    List.DeleteItem(SearchExtension, all);
    List.DeleteItem(SourcePieces, all);
    List.DeleteItem(AppliedMove, all);
    List.DeleteItem(Quiescence, all);
    List.DeleteItem(EnPassantTarget, all);
    List.DeleteItem(CastlingState, all);
    List.DeleteItem(StaticEval, all);
    List.DeleteItem(SingularAlphaBeta, all);
    List.DeleteItem(TTEval, all);
    List.DeleteItem(StaticEval, all);
    List.DeleteItem(SingularAlphaBeta, all);
    List.DeleteItem(TTEval, all);
    List.DeleteItem(HashMove, all);
    List.DeleteItem(LMRState, all);
    List.DeleteAll(NodeTTStaticEval);
    List.DeleteAll(NodeTTChecked);
    List.DeleteAll(NodeTTMove);
    List.DeleteAll(NodeTTQSMeta);
    List.DeleteAll(NodeTTHorizon);
    List.DeleteAll(NodeTTType);
    List.DeleteAll(NodeTTScore);
    List.DeleteAll(NodeTTHit);
    List.DeleteAll(ReductionBase);
    List.DeleteAll(Improving);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(Alphas, 0);
        List.Add(Betas, 0);
        List.Add(AlphasOld, "");
        List.Add(SearchEval, Const.EmptyVal);
        List.Add(MovesCount, 0);
        List.Add(MovesIdx, 0);
        List.Add(BestMoveListIdx, "");
        List.Add(TargetPieces, "");
        List.Add(PreviousBoardHash, 0);
        List.Add(PreviousBoardHashKP, 0);
        List.Add(NodeTypes, "");
        List.Add(PickMoveRes, "");
        List.Add(PickPhase, "");
        List.Add(PickedPseudoLegalMovesCount, 0);
        List.Add(BestMoves, Const.EmptyVal);
        List.Add(CheckedState, Const.EmptyVal);
        List.Add(PromotionPieces, "");
        List.Add(TargetPiecesIdx, 0);
        List.Add(BoardAttackedCalculated, "");
        List.Add(PutsInCheck, "");
        List.Add(SearchExtension, "");
        List.Add(SourcePieces, 0);
        List.Add(AppliedMove, "");
        List.Add(Quiescence, "");
        List.Add(EnPassantTarget, "");
        List.Add(CastlingState, 0);
        List.Add(StaticEval, Const.EmptyVal);
        List.Add(SingularAlphaBeta, "");
        List.Add(TTEval, "");
        List.Add(HashMove, Const.EmptyVal);
        List.Add(LMRState, "");
        List.Add(NodeTTStaticEval, Const.EmptyVal);
        List.Add(NodeTTChecked, Const.EmptyVal);
        List.Add(NodeTTMove, Const.EmptyVal);
        List.Add(NodeTTQSMeta, Const.EmptyVal);
        List.Add(NodeTTHorizon, Const.EmptyVal);
        List.Add(NodeTTType, Const.EmptyVal);
        List.Add(NodeTTScore, Const.EmptyVal);
        List.Add(NodeTTHit, Const.EmptyVal);
        List.Add(ReductionBase, Const.EmptyVal);
        List.Add(Improving, Const.EmptyVal);
    }
    Init.PO.Idx = 1;
    Repeat ((Const.MaxPlyStackFrames + 2))
    {
        List.Add(PlyHistOffset, ((Init.PO.Idx % 2) * 4200));
        List.Add(PlyIsOwn, (Init.PO.Idx % 2));
        List.Add(PlySign, (((Init.PO.Idx % 2) * 2) - 1));
        List.Add(PlyContOffset, (((Init.PO.Idx + 1) % 2) * 200000));
        List.Add(PlyCMOffset, ((Init.PO.Idx % 2) * 1000));
        List.Add(PlyCorrOffset, ((Init.PO.Idx % 2) * 100000));
        Init.PO.Idx += 1;
    }
    List.DeleteItem(PV, all);
    List.DeleteItem(PVRaw, all);
    List.DeleteItem(PVStable, all);
    List.DeleteItem(PVStablePrev, all);
    Repeat ((Const.MaxPlyStackFrames * Const.MaxPlyStackFrames))
    {
        List.Add(PV, 0);
        List.Add(PVRaw, 0);
    }
    List.DeleteItem(CastlingStateLookup, all);
    Init.Board.Idx = 0;
    Repeat (256)
    {
        List.Add(CastlingStateLookup, Operator.Join(Operator.Join(Operator.Join((floor((Init.Board.Idx / 128)) % 2), (floor((Init.Board.Idx / 64)) % 2)), Operator.Join((floor((Init.Board.Idx / 32)) % 2), (floor((Init.Board.Idx / 16)) % 2))), Operator.Join(Operator.Join((floor((Init.Board.Idx / 8)) % 2), (floor((Init.Board.Idx / 4)) % 2)), Operator.Join((floor((Init.Board.Idx / 2)) % 2), (Init.Board.Idx % 2)))));
        Init.Board.Idx += 1;
    }
    List.DeleteItem(CastlingStatePow2, all);
    Init.Board.Idx = 128;
    Repeat (8)
    {
        List.Add(CastlingStatePow2, Init.Board.Idx);
        Init.Board.Idx = (Init.Board.Idx / 2);
    }
    List.DeleteItem(PawnCount, all);
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    Call Comment("Generated moves are stores in per-ply segments within Moves list");
    List.DeleteAll(Moves);
    List.DeleteAll(MovesScore);
    Repeat ((Const.MaxMovesPerGeneration * Const.MaxPlyStackFrames))
    {
        List.Add(Moves, 0);
        List.Add(MovesScore, 0);
    }
    List.DeleteAll(PickedPseudoLegalMoves);
    List.DeleteAll(PickedPseudoLegalMovesScore);
    Repeat ((Const.MaxMovesPerGeneration * Const.MaxPlyStackFrames))
    {
        List.Add(PickedPseudoLegalMoves, 0);
        List.Add(PickedPseudoLegalMovesScore, 0);
    }
    List.DeleteAll(PickedLegalMovesCount);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(PickedLegalMovesCount, 0);
    }
    List.DeleteAll(PickedLegalMovesCountQuiet);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(PickedLegalMovesCountQuiet, 0);
    }
}

Define InitBoardPhase2 (warp=true)
{
    Call InitHashLookup;
    Call InitMoveLookup;
    Call InitMobilityBonusLookup;
    Call InitKingSafety;
    Call InitPieceSquareTables;
    Call CalcBoardStats;
    Call InitMovePosLookup((1 == 1));
    Call InitOpeningBook;
    Call InitOpeningMovesMap;
    Call InitChebyshev;
    Call NNUE_Init;
    List.DeleteAll(CastlingKingMove);
    List.DeleteAll(CastlingRookMove);
    Repeat (68)
    {
        List.Add(CastlingKingMove, 0);
        List.Add(CastlingRookMove, 0);
    }
    List.ReplaceItem(CastlingKingMove, GoK_WhiteKingsideCastling, ((NNUE_GoKIdxToSquare[61] * 100) + NNUE_GoKIdxToSquare[63]));
    List.ReplaceItem(CastlingRookMove, GoK_WhiteKingsideCastling, ((NNUE_GoKIdxToSquare[64] * 100) + NNUE_GoKIdxToSquare[62]));
    List.ReplaceItem(CastlingKingMove, GoK_WhiteQueensideCastling, ((NNUE_GoKIdxToSquare[61] * 100) + NNUE_GoKIdxToSquare[59]));
    List.ReplaceItem(CastlingRookMove, GoK_WhiteQueensideCastling, ((NNUE_GoKIdxToSquare[57] * 100) + NNUE_GoKIdxToSquare[60]));
    List.ReplaceItem(CastlingKingMove, GoK_BlackKingsideCastling, ((NNUE_GoKIdxToSquare[5] * 100) + NNUE_GoKIdxToSquare[7]));
    List.ReplaceItem(CastlingRookMove, GoK_BlackKingsideCastling, ((NNUE_GoKIdxToSquare[8] * 100) + NNUE_GoKIdxToSquare[6]));
    List.ReplaceItem(CastlingKingMove, GoK_BlackQueensideCastling, ((NNUE_GoKIdxToSquare[5] * 100) + NNUE_GoKIdxToSquare[3]));
    List.ReplaceItem(CastlingRookMove, GoK_BlackQueensideCastling, ((NNUE_GoKIdxToSquare[1] * 100) + NNUE_GoKIdxToSquare[4]));
    Call AddBoardToHistory("");
}

Define InitChebyshev (warp=true)
{
    List.DeleteAll(ChebyshevDistance);
    Repeat (6500)
    {
        List.Add(ChebyshevDistance, 0);
    }
    Init.Chebyshev.FromSqIdx = 1;
    Repeat (64)
    {
        Init.Chebyshev.ToSqIdx = 1;
        Repeat (64)
        {
            Init.Chebyshev.RankDist = abs((IdxToRank[Init.Chebyshev.FromSqIdx] - IdxToRank[Init.Chebyshev.ToSqIdx]));
            Init.Chebyshev.FileDist = abs((IdxToFile[Init.Chebyshev.FromSqIdx] - IdxToFile[Init.Chebyshev.ToSqIdx]));
            If (Init.Chebyshev.RankDist > Init.Chebyshev.FileDist)
            {
                List.ReplaceItem(ChebyshevDistance, ((Init.Chebyshev.FromSqIdx * 100) + Init.Chebyshev.ToSqIdx), Init.Chebyshev.RankDist);
            }
            Else
            {
                List.ReplaceItem(ChebyshevDistance, ((Init.Chebyshev.FromSqIdx * 100) + Init.Chebyshev.ToSqIdx), Init.Chebyshev.FileDist);
            }
            Init.Chebyshev.ToSqIdx += 1;
        }
        Init.Chebyshev.FromSqIdx += 1;
    }
}

Define InitCoordLookup (warp=true)
{
    List.DeleteItem(IdxToFile, all);
    List.DeleteItem(IdxToRank, all);
    Init.CL.Idx = 1;
    Repeat (64)
    {
        List.Add(IdxToFile, (((Init.CL.Idx - 1) % 8) + 1));
        List.Add(IdxToRank, ceiling((Init.CL.Idx / 8)));
        Init.CL.Idx += 1;
    }
}

Define InitHashLookup (warp=true)
{
    TT.CurrentAge = 0;
    List.DeleteItem(PosPieceHashLookup, all);
    Repeat (1024)
    {
        List.Add(PosPieceHashLookup, Operator.Random(1 , ((65536 * 65536) * 16384)));
    }
    Call ClearTT;
}

