Define SearchNextPly(string Alpha)(string Beta)(string Horizon)(string Reduction)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    SearchNextPly.NextHorizon = (((Horizon + SearchExtension[Ply]) - Reduction) - 1);
    If (SearchNextPly.NextHorizon < 0)
    {
        SearchNextPly.NextHorizon = 0;
    }
    Call SearchImpl(Alpha)(Beta)(SearchNextPly.NextHorizon)((Ply + 1))(Cutnode)((Quiescence Or (SearchNextPly.NextHorizon < 1)))(ExcludedMove);
}

Define SearchWrp (warp=false)
{
    Call SearchWrp.Prepare;
    Repeat Until (Ret.SearchWrp.IsDone == 1)
    {
        Call SearchWrp.Iteration;
        If (Not ((Glob.Config.IsDCI == 1)))
        {
            If (((Sensing.DaysSince2000() * 86400) > SearchWrp.NextUIUpdate) Or (Ret.SearchWrp.IsDone == 1))
            {
                If (Not ((Icons_SearchDepth == Glob.Search.IterationIdx)))
                {
                    Icons_SearchDepth = Glob.Search.IterationIdx;
                    Event.Broadcast("Icons_SearchDepthChanged");
                }
                If (Not ((Ret.SearchWrp.BestMove == Const.Null)))
                {
                    Call OnEvaluationChanged(Ret.SearchWrp.BestMoveEval);
                    If (Ret.SearchWrp.BestMove == GoK_BlackKingsideCastling)
                    {
                        Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                        Stg_BestMoveToIdx = GoK_ScreenIdx[7];
                    }
                    Else
                    {
                        If (Ret.SearchWrp.BestMove == GoK_BlackQueensideCastling)
                        {
                            Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                            Stg_BestMoveToIdx = GoK_ScreenIdx[3];
                        }
                        Else
                        {
                            Stg_BestMoveFromIdx = GoK_ScreenIdx[floor((Ret.SearchWrp.BestMove / 100))];
                            Stg_BestMoveToIdx = GoK_ScreenIdx[floor((Ret.SearchWrp.BestMove % 100))];
                        }
                    }
                    Event.Broadcast("UI_ShowBestMove");
                }
                SearchWrp.Now = (Sensing.DaysSince2000() * 86400);
                Call OnProgressChanged((((SearchWrp.Now - Glob.Search.ThinkTimeStart) / SearchWrp.ProgressLimit) * 100));
                If (Ret.SearchWrp.IsDone == 0)
                {
                    Call PublishTimers((SearchWrp.Now - Glob.Search.ThinkTimeStart));
                    SearchWrp.NextUIUpdate = (SearchWrp.Now + SearchWrp.UIUpdateStep);
                    SearchWrp.UIUpdateStep = ((SearchWrp.UIUpdateStep * 2) + ((1 - (SearchWrp.UIUpdateStep * 2)) * (SearchWrp.UIUpdateStep > 0.5)));
                }
                If (Ret.SearchWrp.IsDone == 1)
                {
                    Call PublishTimers(0);
                }
            }
        }
    }
    Ret.SearchWrp.Move = Glob.Search.IterationBestMove;
}

Define SearchWrp.DCI (warp=true)
{
    Call SearchWrp.Prepare;
    Repeat Until (Ret.SearchWrp.IsDone == 1)
    {
        Call SearchWrp.Iteration;
    }
    Ret.SearchWrp.DCI.Move = Glob.Search.IterationBestMove;
    Call LogSearchEnd(Glob.Search.IterationBestMove);
}

Define SearchWrp.DCISlice (warp=true)
{
    Glob.UI.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Repeat Until ((Ret.SearchWrp.IsDone == 1) Or ((Sensing.DaysSince2000() * 86400) > (Glob.UI.PrevProgressUpdate + 1)))
    {
        Call SearchWrp.Iteration;
    }
    Glob.UI.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Ret.SearchWrp.DCI.Move = Glob.Search.IterationBestMove;
    If (Ret.SearchWrp.IsDone == 1)
    {
        Call LogSearchEnd(Glob.Search.IterationBestMove);
    }
}

Define SearchWrp.Iteration (warp=true)
{
    Glob.Search.ThinkTimeLimit = SearchWrp.ThinkTimeLimit;
    If (((Glob.Search.IterationIdx > 4) And (1 == 1)) And ((Not ((Ret.SearchWrp.BestMoveEval == Const.Null))) And (abs(Ret.SearchWrp.BestMoveEval) < Const.AbsMinCheckmateEval)))
    {
        SearchWrp.Iteration.AspirationDelta = Operator.Round((40 + ((abs(Ret.SearchWrp.BestMoveEval) * abs(Ret.SearchWrp.BestMoveEval)) / 2400)));
        SearchWrp.Iteration.AspirationAlpha = Operator.Round((Ret.SearchWrp.BestMoveEval - SearchWrp.Iteration.AspirationDelta));
        SearchWrp.Iteration.AspirationBeta = Operator.Round((Ret.SearchWrp.BestMoveEval + SearchWrp.Iteration.AspirationDelta));
    }
    Else
    {
        SearchWrp.Iteration.AspirationAlpha = -100000;
        SearchWrp.Iteration.AspirationBeta = 100000;
    }
    Glob.Search.SelDepth = 0;
    SearchWrp.Iteration.IsAspirationDone = 0;
    SearchWrp.Iteration.FailedHighCount = 0;
    SearchWrp.Iteration.SavedLimit = SearchWrp.ThinkTimeLimit;
    Repeat Until ((SearchWrp.Iteration.IsAspirationDone == 1) Or (Glob.Search.IsTimeout == 1))
    {
        Glob.Search.ThinkTimeLimit = SearchWrp.ThinkTimeLimit;
        SearchWrp.Iteration.SearchDepth = Glob.Search.IterationIdx;
        If (SearchWrp.Iteration.SearchDepth < 1)
        {
            SearchWrp.Iteration.SearchDepth = 1;
        }
        Call Search(SearchWrp.Iteration.AspirationAlpha)(SearchWrp.Iteration.AspirationBeta)(SearchWrp.Iteration.SearchDepth)(1)((Glob.Search.IterationIdx == 1));
        SearchWrp.Iteration.SearchEval = Ret.Search.Eval;
        If ((Not ((Ret.Search.Move == Const.Null))) And (SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha))
        {
            If ((Glob.Search.IterationBestMove == Const.Null) Or List.ContainsItem(SearchRootMovesDone, Glob.Search.IterationBestMove))
            {
                Glob.Search.IterationBestMove = Ret.Search.Move;
                Ret.SearchWrp.BestMove = Glob.Search.IterationBestMove;
                Ret.SearchWrp.BestMoveEval = SearchWrp.Iteration.SearchEval;
                If (Ret.SearchWrp.BestMoveEval == Const.Null)
                {
                    Glob.UI.Eval = "EV: 0";
                }
                Else
                {
                    Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
                }
                If (Glob.Search.IsTimeout == 1)
                {
                    Glob.Info.Adopted = 1;
                }
            }
        }
        SearchWrp.Iteration.IsAspirationFail = 0;
        If (Not ((SearchWrp.Iteration.SearchEval == Const.Null)))
        {
            If ((Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha))) Or (Not ((SearchWrp.Iteration.SearchEval < SearchWrp.Iteration.AspirationBeta))))
            {
                SearchWrp.Iteration.IsAspirationFail = 1;
            }
        }
        SearchWrp.Iteration.InfoMove = Glob.Search.IterationBestMove;
        If (Not ((Ret.Search.Move == Const.Null)))
        {
            SearchWrp.Iteration.InfoMove = Ret.Search.Move;
        }
        If (Glob.Search.IsTimeout == 0)
        {
            Call LogSearchInfo(Glob.Search.IterationIdx)(1)(SearchWrp.Iteration.SearchEval)(SearchWrp.Iteration.AspirationAlpha)(SearchWrp.Iteration.AspirationBeta)(SearchWrp.Iteration.InfoMove)(1);
        }
        If ((Glob.Search.IsTimeout == 1) And (Glob.Info.Adopted == 1))
        {
            Call LogSearchInfo(Glob.Search.IterationIdx)(1)(SearchWrp.Iteration.SearchEval)(SearchWrp.Iteration.AspirationAlpha)(SearchWrp.Iteration.AspirationBeta)(SearchWrp.Iteration.InfoMove)(0);
        }
        If ((Glob.Search.IsTimeout == 0) And (SearchWrp.Iteration.IsAspirationFail == 1))
        {
            If (Glob.Config.IsDCI == 0)
            {
                SearchWrp.Iteration.Now = (Sensing.DaysSince2000() * 86400);
                If (SearchWrp.Iteration.Now > SearchWrp.NextUIUpdate)
                {
                    Call OnProgressChanged((((SearchWrp.Iteration.Now - Glob.Search.ThinkTimeStart) / SearchWrp.ProgressLimit) * 100));
                }
                If (SearchWrp.Iteration.Now > SearchWrp.NextUIUpdate)
                {
                    Call PublishTimers((SearchWrp.Iteration.Now - Glob.Search.ThinkTimeStart));
                }
            }
            If ((((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0)) And (Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha))))
            {
                SearchWrp.ThinkTimeLimit = SearchWrp.MaxThinkTime;
            }
            SearchWrp.Iteration.AspirationDelta = Operator.Round((SearchWrp.Iteration.AspirationDelta * 1.5));
            If (Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha)))
            {
                SearchWrp.Iteration.FailedHighCount = 0;
            }
            Else
            {
                SearchWrp.Iteration.FailedHighCount += 1;
            }
            If ((SearchWrp.Iteration.AspirationDelta < 300) And (abs(SearchWrp.Iteration.SearchEval) < Const.AbsMinCheckmateEval))
            {
                If (Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha)))
                {
                    If (1 == 1)
                    {
                        SearchWrp.Iteration.AspirationBeta = Operator.Round(((SearchWrp.Iteration.AspirationAlpha + SearchWrp.Iteration.AspirationBeta) / 2));
                    }
                    SearchWrp.Iteration.AspirationAlpha = Operator.Round((SearchWrp.Iteration.SearchEval - SearchWrp.Iteration.AspirationDelta));
                }
                Else
                {
                    SearchWrp.Iteration.AspirationBeta = Operator.Round((SearchWrp.Iteration.SearchEval + SearchWrp.Iteration.AspirationDelta));
                }
            }
            Else
            {
                SearchWrp.Iteration.AspirationAlpha = -100000;
                SearchWrp.Iteration.AspirationBeta = 100000;
            }
        }
        Else
        {
            SearchWrp.Iteration.IsAspirationDone = 1;
        }
    }
    If (((Glob.Config.Level < 6) And (Glob.Search.IsTimeout == 0)) And (Not ((Glob.Search.IterationBestMove == Const.Null))))
    {
        List.DeleteAll(RootLineMoves);
        List.DeleteAll(RootLineEvals);
        List.Add(RootLineMoves, Glob.Search.IterationBestMove);
        List.Add(RootLineEvals, Ret.SearchWrp.BestMoveEval);
        SearchWrp.Iteration.LineDone = 0;
        List.DeleteAll(RootExcludedMoves);
        List.Add(RootExcludedMoves, Glob.Search.IterationBestMove);
        Repeat Until ((List.Length(RootLineMoves) > 3) Or (SearchWrp.Iteration.LineDone == 1))
        {
            Glob.Search.SelDepth = 0;
            Call Search(-100000)(100000)(Glob.Search.IterationIdx)(1)((1 == 0));
            If (((Glob.Search.IsTimeout == 0) And (Not ((Ret.Search.Move == Const.Null)))) And (Not ((Ret.Search.Eval == Const.Null))))
            {
                List.Add(RootLineMoves, Ret.Search.Move);
                List.Add(RootExcludedMoves, Ret.Search.Move);
                List.Add(RootLineEvals, Ret.Search.Eval);
                Call LogSearchInfo(Glob.Search.IterationIdx)(List.Length(RootLineMoves))(Ret.Search.Eval)(-100000)(100000)(Ret.Search.Move)(1);
            }
            Else
            {
                SearchWrp.Iteration.LineDone = 1;
            }
        }
        List.DeleteAll(RootExcludedMoves);
        SearchWrp.Iteration.SortIdx = 2;
        Repeat ((List.Length(RootLineEvals) - 1))
        {
            SearchWrp.Iteration.SortPos = SearchWrp.Iteration.SortIdx;
            Repeat Until ((SearchWrp.Iteration.SortPos < 2) Or (Not ((RootLineEvals[SearchWrp.Iteration.SortPos] > RootLineEvals[(SearchWrp.Iteration.SortPos - 1)]))))
            {
                SearchWrp.Iteration.SwapEval = RootLineEvals[SearchWrp.Iteration.SortPos];
                SearchWrp.Iteration.SwapMove = RootLineMoves[SearchWrp.Iteration.SortPos];
                List.ReplaceItem(RootLineEvals, SearchWrp.Iteration.SortPos, RootLineEvals[(SearchWrp.Iteration.SortPos - 1)]);
                List.ReplaceItem(RootLineMoves, SearchWrp.Iteration.SortPos, RootLineMoves[(SearchWrp.Iteration.SortPos - 1)]);
                List.ReplaceItem(RootLineEvals, (SearchWrp.Iteration.SortPos - 1), SearchWrp.Iteration.SwapEval);
                List.ReplaceItem(RootLineMoves, (SearchWrp.Iteration.SortPos - 1), SearchWrp.Iteration.SwapMove);
                SearchWrp.Iteration.SortPos += -1;
            }
            SearchWrp.Iteration.SortIdx += 1;
        }
        Glob.Search.IterationBestMove = RootLineMoves[1];
        Ret.SearchWrp.BestMove = Glob.Search.IterationBestMove;
        Ret.SearchWrp.BestMoveEval = RootLineEvals[1];
        If (Ret.SearchWrp.BestMoveEval == Const.Null)
        {
            Glob.UI.Eval = "EV: 0";
        }
        Else
        {
            Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
        }
        List.DeleteAll(RootLinePrevMoves);
        SearchWrp.Iteration.SortIdx = 1;
        Repeat (List.Length(RootLineMoves))
        {
            List.Add(RootLinePrevMoves, RootLineMoves[SearchWrp.Iteration.SortIdx]);
            SearchWrp.Iteration.SortIdx += 1;
        }
    }
    SearchWrp.ThinkTimeLimit = SearchWrp.Iteration.SavedLimit;
    SearchWrp.Iteration.IsDeepeningDone = 0;
    If (Glob.Search.IsTimeout == 1)
    {
        SearchWrp.Iteration.IsDeepeningDone = 1;
    }
    Else
    {
        If (Glob.Search.IterationIdx == SearchWrp.MaxSearchPly)
        {
            SearchWrp.Iteration.IsDeepeningDone = 1;
        }
        Else
        {
            If ((Glob.Config.CustomMaxDepth > 0) And (Not ((Glob.Search.IterationIdx < Glob.Config.CustomMaxDepth))))
            {
                SearchWrp.Iteration.IsDeepeningDone = 1;
            }
            Else
            {
                If (Not ((Ret.SearchWrp.BestMoveEval == Const.Null)))
                {
                    If (abs(Ret.SearchWrp.BestMoveEval) > (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + Glob.Search.IterationIdx)))
                    {
                        SearchWrp.Iteration.IsDeepeningDone = 1;
                    }
                }
            }
        }
    }
    If ((Glob.Config.Level < 6) And (Not ((Glob.Search.IterationIdx < ((2 * Glob.Config.Level) - 2)))))
    {
        SearchWrp.Iteration.IsDeepeningDone = 1;
    }
    If (((Glob.Search.IterationIdx == 1) And (Ret.Search.LegalMoveCount == 1)) And (1 == 0))
    {
        SearchWrp.Iteration.IsDeepeningDone = 1;
    }
    If (SearchWrp.Iteration.IsDeepeningDone == 1)
    {
        Ret.SearchWrp.IsDone = 1;
    }
    Else
    {
        If ((((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0)) And (Glob.Search.IterationIdx > 4))
        {
            SearchWrp.BestMoveChanges = (SearchWrp.BestMoveChanges / 2);
            If (Glob.Search.IterationBestMove == SearchWrp.StableBestMove)
            {
                SearchWrp.StableBestMoveCount += 1;
            }
            Else
            {
                SearchWrp.StableBestMoveCount = 0;
                If (Not ((SearchWrp.StableBestMove == Const.Null)))
                {
                    SearchWrp.BestMoveChanges += 1;
                }
            }
            SearchWrp.StableBestMove = Glob.Search.IterationBestMove;
            If (SearchWrp.StableBestMoveCount > 5)
            {
                SearchWrp.Iteration.SoftThinkTime = (SearchWrp.OptimumThinkTime * 0.6);
            }
            Else
            {
                SearchWrp.Iteration.SoftThinkTime = (SearchWrp.OptimumThinkTime * (1.3 - (0.14 * SearchWrp.StableBestMoveCount)));
            }
            SearchWrp.Iteration.BestMoveInstability = (1 + (1.88 * SearchWrp.BestMoveChanges));
            SearchWrp.Iteration.SoftThinkTime = (SearchWrp.Iteration.SoftThinkTime * SearchWrp.Iteration.BestMoveInstability);
            If ((SearchWrp.PrevMoveEval == Const.Null) Or ((SearchWrp.PrevIterEval == Const.Null) Or (Ret.SearchWrp.BestMoveEval == Const.Null)))
            {
                SearchWrp.Iteration.FallingEval = 1;
            }
            Else
            {
                SearchWrp.Iteration.FallingEval = ((69 + ((24 * (SearchWrp.PrevMoveEval - Ret.SearchWrp.BestMoveEval)) + (12 * (SearchWrp.PrevIterEval - Ret.SearchWrp.BestMoveEval)))) / 781.4);
                If (SearchWrp.Iteration.FallingEval < 0.5)
                {
                    SearchWrp.Iteration.FallingEval = 0.5;
                }
                If (SearchWrp.Iteration.FallingEval > 1.5)
                {
                    SearchWrp.Iteration.FallingEval = 1.5;
                }
            }
            SearchWrp.Iteration.SoftThinkTime = (SearchWrp.Iteration.SoftThinkTime * (SearchWrp.Iteration.FallingEval / 0.5));
            If (SearchWrp.Iteration.SoftThinkTime > SearchWrp.ThinkTimeLimit)
            {
                SearchWrp.Iteration.SoftThinkTime = SearchWrp.ThinkTimeLimit;
            }
            SearchWrp.Iteration.DepthTimeGrowth = 1.4;
            If ((((((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart) * SearchWrp.Iteration.DepthTimeGrowth) > SearchWrp.Iteration.SoftThinkTime) And (Not ((Glob.Search.IterationIdx < SearchWrp.MinThinkDepth)))) Or ((((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart) * 1.9) > SearchWrp.ThinkTimeLimit))
            {
                Ret.SearchWrp.IsDone = 1;
            }
            SearchWrp.PrevIterEval = Ret.SearchWrp.BestMoveEval;
        }
        If (Ret.SearchWrp.IsDone == 0)
        {
            Glob.Search.IterationIdx += 1;
            If (Glob.Search.IterationIdx == Const.Null)
            {
                Glob.UI.Depth = "D: 0";
            }
            Else
            {
                Glob.UI.Depth = Operator.Join("D: ", Glob.Search.IterationIdx);
            }
        }
    }
    If ((Ret.SearchWrp.IsDone == 1) And (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0)))
    {
        SearchWrp.PrevMoveEval = Ret.SearchWrp.BestMoveEval;
        Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + (Glob.Clock.TimeInc - ((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart)));
        Glob.Clock.MoveCount += 1;
        If ((Glob.Clock.StageMoves > 0) And (Glob.Clock.MoveCount == Glob.Clock.StageMoves))
        {
            Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.StageTime);
        }
        If (SearchWrp.AvgCompletedDepth == Const.Null)
        {
            SearchWrp.AvgCompletedDepth = (Glob.Search.IterationIdx - Glob.Search.IsTimeout);
        }
        Else
        {
            SearchWrp.AvgCompletedDepth = ((0.8 * SearchWrp.AvgCompletedDepth) + (0.2 * (Glob.Search.IterationIdx - Glob.Search.IsTimeout)));
        }
        If ((Glob.Clock.TimeControl == 1) And (Glob.Clock.CurrentTime < 0))
        {
            Looks.Say("Engine out of time");
            GoK_IsGameSuspended = 1;
        }
    }
}

Define SearchWrp.Main (warp=false)
{
    Call SearchWrp;
    Ret.SearchWrp.Main.Move = Ret.SearchWrp.Move;
    If (List.Length(RootLineMoves) > 0)
    {
        SearchWrp.Main.TopScore = RootLineEvals[1];
        SearchWrp.Main.Delta = (SearchWrp.Main.TopScore - RootLineEvals[List.Length(RootLineEvals)]);
        If (SearchWrp.Main.Delta > 100)
        {
            SearchWrp.Main.Delta = 100;
        }
        SearchWrp.Main.Weakness = (147 - (9 * Glob.Config.Level));
        SearchWrp.Main.MaxScore = -1000000;
        SearchWrp.Main.LineIdx = 1;
        Repeat (List.Length(RootLineMoves))
        {
            SearchWrp.Main.Push = floor((((SearchWrp.Main.Weakness * (SearchWrp.Main.TopScore - RootLineEvals[SearchWrp.Main.LineIdx])) + (SearchWrp.Main.Delta * Operator.Random(0 , (SearchWrp.Main.Weakness - 1)))) / 128));
            If (Not (((RootLineEvals[SearchWrp.Main.LineIdx] + SearchWrp.Main.Push) < SearchWrp.Main.MaxScore)))
            {
                SearchWrp.Main.MaxScore = (RootLineEvals[SearchWrp.Main.LineIdx] + SearchWrp.Main.Push);
                Ret.SearchWrp.Main.Move = RootLineMoves[SearchWrp.Main.LineIdx];
            }
            SearchWrp.Main.LineIdx += 1;
        }
    }
    Call LogSearchEnd(Ret.SearchWrp.Main.Move);
}

Define SearchWrp.Prepare (warp=true)
{
    SearchWrp.Prepare.HistIdx = 1;
    Repeat (List.Length(HistoryMoveScores))
    {
        List.ReplaceItem(HistoryMoveScores, SearchWrp.Prepare.HistIdx, (HistoryMoveScores[SearchWrp.Prepare.HistIdx] / 2));
        SearchWrp.Prepare.HistIdx += 1;
    }
    SearchWrp.Prepare.HistIdx = 1;
    Repeat (List.Length(HistoryCaptureScores))
    {
        List.ReplaceItem(HistoryCaptureScores, SearchWrp.Prepare.HistIdx, (HistoryCaptureScores[SearchWrp.Prepare.HistIdx] / 2));
        SearchWrp.Prepare.HistIdx += 1;
    }
    If (Glob.Config.IsScratch3 == 0)
    {
        SearchWrp.Prepare.HistIdx = 1;
        Repeat (List.Length(HistoryContinuation))
        {
            List.ReplaceItem(HistoryContinuation, SearchWrp.Prepare.HistIdx, (HistoryContinuation[SearchWrp.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation2, SearchWrp.Prepare.HistIdx, (HistoryContinuation2[SearchWrp.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation3, SearchWrp.Prepare.HistIdx, (HistoryContinuation3[SearchWrp.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation4, SearchWrp.Prepare.HistIdx, (HistoryContinuation4[SearchWrp.Prepare.HistIdx] / 2));
            SearchWrp.Prepare.HistIdx += 1;
        }
    }
    If (List.Length(TTNodeEntry) == 0)
    {
        Call ClearTT;
    }
    List.DeleteAll(RootLineMoves);
    List.DeleteAll(RootLineEvals);
    SearchWrp.MaxSearchPly = (Const.MaxPlyStackFrames - 30);
    SearchWrp.ThinkTimeLimit = 20;
    If ((Glob.Config.IsDCI == 0) And (Glob.Config.IsScratch3 == 1))
    {
        If (Not ((Glob.Config.Level < 6)))
        {
            SearchWrp.ThinkTimeLimit = 30;
        }
    }
    If (Glob.Config.CustomThinkTime > 0)
    {
        SearchWrp.ThinkTimeLimit = Glob.Config.CustomThinkTime;
    }
    If ((Glob.Config.IsDCI == 0) And (Glob.Clock.TimeControl == 0))
    {
        Glob.Clock.InitialTime = 0;
        If (Glob.Config.CustomThinkTime == 0)
        {
            Glob.Clock.TimeInc = SearchWrp.ThinkTimeLimit;
        }
        Else
        {
            Glob.Clock.TimeInc = 0;
        }
        Glob.Clock.CurrentTime = 0;
    }
    If (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0))
    {
        SearchWrp.Prepare.RemainingTime = (Glob.Clock.CurrentTime + Glob.Clock.TimeInc);
        If (Glob.Clock.StageMoves > Glob.Clock.MoveCount)
        {
            SearchWrp.Prepare.MovesToGo = (Glob.Clock.StageMoves - Glob.Clock.MoveCount);
            If (SearchWrp.Prepare.MovesToGo > 50)
            {
                SearchWrp.Prepare.MovesToGo = 50;
            }
            SearchWrp.Prepare.MaxScale = (1.5 + (0.11 * SearchWrp.Prepare.MovesToGo));
            If (SearchWrp.Prepare.MaxScale > 6.3)
            {
                SearchWrp.Prepare.MaxScale = 6.3;
            }
        }
        Else
        {
            If (Glob.Clock.TimeInc == 0)
            {
                SearchWrp.Prepare.MovesToGo = 40;
            }
            Else
            {
                SearchWrp.Prepare.MovesToGo = 19;
            }
            SearchWrp.Prepare.MaxScale = 4.5;
        }
        SearchWrp.OptimumThinkTime = ((SearchWrp.Prepare.RemainingTime / SearchWrp.Prepare.MovesToGo) + Glob.Clock.TimeInc);
        SearchWrp.MaxThinkTime = (0.8 * SearchWrp.Prepare.RemainingTime);
        If (Glob.Clock.TimeControl == 1)
        {
            SearchWrp.MaxThinkTime = (0.8 * Glob.Clock.CurrentTime);
        }
        If (Glob.Clock.StageMoves > Glob.Clock.MoveCount)
        {
            If (SearchWrp.MaxThinkTime > (SearchWrp.Prepare.RemainingTime - ((SearchWrp.Prepare.MovesToGo - 1) * (0.75 * SearchWrp.OptimumThinkTime))))
            {
                SearchWrp.MaxThinkTime = (SearchWrp.Prepare.RemainingTime - ((SearchWrp.Prepare.MovesToGo - 1) * (0.75 * SearchWrp.OptimumThinkTime)));
            }
        }
        Else
        {
            If (Glob.Clock.TimeInc == 0)
            {
                If (SearchWrp.MaxThinkTime > (SearchWrp.Prepare.MaxScale * SearchWrp.OptimumThinkTime))
                {
                    SearchWrp.MaxThinkTime = (SearchWrp.Prepare.MaxScale * SearchWrp.OptimumThinkTime);
                }
            }
        }
        SearchWrp.ThinkTimeLimit = (SearchWrp.Prepare.MaxScale * SearchWrp.OptimumThinkTime);
        If (SearchWrp.ThinkTimeLimit > SearchWrp.MaxThinkTime)
        {
            SearchWrp.ThinkTimeLimit = SearchWrp.MaxThinkTime;
        }
        If (Glob.Clock.TimeControl == 1)
        {
            If (SearchWrp.MaxThinkTime < 0.05)
            {
                SearchWrp.MaxThinkTime = 0.05;
            }
            If (SearchWrp.ThinkTimeLimit < 0.05)
            {
                SearchWrp.ThinkTimeLimit = 0.05;
            }
        }
        SearchWrp.BestMoveChanges = 0;
        If (Glob.Clock.TimeInc > 0)
        {
            SearchWrp.MinThinkDepth = (floor((11.5 + (1.66 * ln(Glob.Clock.TimeInc)))) - 1);
        }
        Else
        {
            SearchWrp.MinThinkDepth = 0;
        }
        If ((Not ((SearchWrp.AvgCompletedDepth == Const.Null))) And (SearchWrp.AvgCompletedDepth < SearchWrp.MinThinkDepth))
        {
            SearchWrp.MinThinkDepth = floor(SearchWrp.AvgCompletedDepth);
        }
        SearchWrp.StableBestMoveCount = 0;
        SearchWrp.StableBestMove = Const.Null;
        SearchWrp.PrevIterEval = SearchWrp.PrevMoveEval;
    }
    If (((Glob.Config.IsDCI == 0) And (Glob.Config.CustomThinkTime == 0)) And (Glob.Clock.TimeControl == 0))
    {
        If (SearchWrp.ThinkTimeLimit > (2 * Glob.Config.Level))
        {
            SearchWrp.ThinkTimeLimit = (2 * Glob.Config.Level);
        }
        If (SearchWrp.MaxThinkTime > (2 * Glob.Config.Level))
        {
            SearchWrp.MaxThinkTime = (2 * Glob.Config.Level);
        }
    }
    SearchWrp.ProgressLimit = SearchWrp.ThinkTimeLimit;
    If ((Glob.Clock.TimeControl == 1) And (SearchWrp.OptimumThinkTime > 0.05))
    {
        SearchWrp.ProgressLimit = SearchWrp.OptimumThinkTime;
    }
    Glob.Search.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Call ResetSearchInfo;
    SearchWrp.NextUIUpdate = (Glob.Search.ThinkTimeStart + 0.1);
    SearchWrp.UIUpdateStep = 0;
    If (Glob.Config.IsTimeModelLogged == 0)
    {
        Glob.Config.IsTimeModelLogged = 1;
    }
    Glob.Search.IsTimeout = 0;
    Ret.SearchWrp.IsDone = 0;
    Glob.Search.IterationIdx = 1;
    If (Glob.Search.IterationIdx == Const.Null)
    {
        Glob.UI.Depth = "D: 0";
    }
    Else
    {
        Glob.UI.Depth = Operator.Join("D: ", Glob.Search.IterationIdx);
    }
    List.DeleteAll(RootLinePrevMoves);
    Glob.Search.IterationBestMove = Const.Null;
    Ret.SearchWrp.BestMove = Glob.Search.IterationBestMove;
    Ret.SearchWrp.BestMoveEval = Const.Null;
    If (Ret.SearchWrp.BestMoveEval == Const.Null)
    {
        Glob.UI.Eval = "EV: 0";
    }
    Else
    {
        Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
    }
}

Define Search_CollectStats(string Horizon)(string Ply)(bool Quiescence)(string QSCode)(string FullCode) (warp=true)
{
    If Quiescence
    {
        Call Profile_CountByHorizon(QSCode)(Horizon)(Ply);
    }
    Else
    {
        Call Profile_CountByHorizon(FullCode)(Horizon)(Ply);
    }
}

Define Search_ComputeReduction(string Horizon)(string Ply)(bool Cutnode) (warp=true)
{
    If (ReductionBase[Ply] == Const.Null)
    {
        Call Search_ComputeReductionBase(Horizon)(Ply);
        If (Ret.Search_ComputeReductionBase.IsApplicable == 1)
        {
            List.ReplaceItem(ReductionBase, Ply, Ret.Search_ComputeReductionBase.Reduction);
        }
        Else
        {
            List.ReplaceItem(ReductionBase, Ply, Const.Null);
        }
    }
    Ret.Search_ComputeReduction.Reduction = 0;
    If (Not ((ReductionBase[Ply] == Const.Null)))
    {
        Ret.Search_ComputeReduction.Reduction = ((floor((ReductionBase[Ply] / 128)) + Cutnode) - (SingularQuietLMR[Ply] * (SingularState[Ply] == 1)));
        Call //("agreed gok engines twins diff: lmr clamp on in nnue, off in classic");
        If ((1 == 1) And (Ret.Search_ComputeReduction.Reduction > ((Horizon + SearchExtension[Ply]) - 2)))
        {
            Ret.Search_ComputeReduction.Reduction = ((Horizon + SearchExtension[Ply]) - 2);
        }
        If (Ret.Search_ComputeReduction.Reduction < 0)
        {
            Ret.Search_ComputeReduction.Reduction = 0;
        }
    }
}

Define Search_ComputeReductionBase(string Horizon)(string Ply) (warp=true)
{
    Search_ComputeReductionBase.DangerousPush = 0;
    Ret.Search_ComputeReductionBase.IsApplicable = 0;
    Ret.Search_ComputeReductionBase.Reduction = 0;
    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
    {
        Search_ComputeReductionBase.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search_ComputeReductionBase.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search_ComputeReductionBase.PushRank < 4)))
        {
            Search_ComputeReductionBase.DangerousPush = 1;
        }
    }
    If (Search_ComputeReductionBase.DangerousPush == 1)
    {
        Stop(this script);
    }
    If ((Horizon + SearchExtension[Ply]) > 2)
    {
        If ((CheckedState[Ply] == 0) And ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0)))
        {
            Call //("LMR search");
            Search_ComputeReductionBase.MinMoveCount = (2 + (2 * (IsPvNode[Ply] == 1)));
            If (Search_ComputeReductionBase.MinMoveCount == 0)
            {
                Search_ComputeReductionBase.MinMoveCount = 1;
            }
            If (PickedLegalMovesCount[Ply] > Search_ComputeReductionBase.MinMoveCount)
            {
                Ret.Search_ComputeReductionBase.IsApplicable = 1;
                Ret.Search_ComputeReductionBase.Reduction = floor(((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + SearchExtension[Ply]))) / 2.25)) * 128));
                If (1 == 1)
                {
                    If (IsPvNode[Ply] == 1)
                    {
                        Ret.Search_ComputeReductionBase.Reduction += -128;
                    }
                }
                If (1 == 1)
                {
                    If (PutsInCheck[Ply] == 1)
                    {
                        Ret.Search_ComputeReductionBase.Reduction += -64;
                    }
                }
                If (1 == 1)
                {
                    Search_ComputeReductionBase.HistFrom = floor((AppliedMove[Ply] / 100));
                    Search_ComputeReductionBase.HistTo = floor((AppliedMove[Ply] % 100));
                    If (Search_ComputeReductionBase.HistFrom == 0)
                    {
                        If ((AppliedMove[Ply] == 65) Or (AppliedMove[Ply] == 66))
                        {
                            Search_ComputeReductionBase.HistFrom = 5;
                        }
                        Else
                        {
                            Search_ComputeReductionBase.HistFrom = 61;
                        }
                        If (AppliedMove[Ply] == 65)
                        {
                            Search_ComputeReductionBase.HistTo = 8;
                        }
                        Else
                        {
                            If (AppliedMove[Ply] == 66)
                            {
                                Search_ComputeReductionBase.HistTo = 1;
                            }
                            Else
                            {
                                If (AppliedMove[Ply] == 67)
                                {
                                    Search_ComputeReductionBase.HistTo = 64;
                                }
                                Else
                                {
                                    Search_ComputeReductionBase.HistTo = 57;
                                }
                            }
                        }
                    }
                    Search_ComputeReductionBase.KPHash = Glob.Board.KPHash;
                    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
                    {
                        Search_ComputeReductionBase.KPHash = PreviousBoardHashKP[Ply];
                    }
                    Call GetHistoryStatScore(SourcePieces[Ply])(Search_ComputeReductionBase.HistFrom)(Search_ComputeReductionBase.HistTo)(AppliedMove[Ply])(Ply)(Search_ComputeReductionBase.KPHash);
                    If (1 == 1)
                    {
                        Search_ComputeReductionBase.StatScore = (((((2 * Ret.GetHistoryStatScore.MainScore) + Ret.GetHistoryStatScore.Cont1Score) + Ret.GetHistoryStatScore.Cont2Score) + Ret.GetHistoryStatScore.Cont4Score) - Const.LmrStatScoreOffset);
                        Ret.Search_ComputeReductionBase.Reduction += (0 - Operator.Round(((Search_ComputeReductionBase.StatScore / Const.LmrStatScoreDivisor) * 128)));
                    }
                }
                If (1 == 1)
                {
                    Call GetImproving(Ply);
                    If (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))
                    {
                        Ret.Search_ComputeReductionBase.Reduction += -128;
                    }
                }
            }
        }
    }
}

Define Search_Core(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    Ret.Search_Core.NodeEval = Const.Null;
    List.ReplaceItem(LMRState, Ply, 0);
    Search_Core.LmrNonPV.IsReSearchRequired = 1;
    If ((Not (Quiescence)) And (Glob.Search.IsTimeout == 0))
    {
        Call Search_ComputeReduction(Horizon)(Ply)(Cutnode);
        Search_Core.Reduction = Ret.Search_ComputeReduction.Reduction;
        If (Search_Core.Reduction > 0)
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.LMRCalls)(Horizon)(Ply);
            }
            Call SearchNextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(Search_Core.Reduction)(Ply)((1 == 1))(Quiescence)(Const.Null);
            Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
            {
                Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
            }
            Search_Core.LmrNonPV.IsReSearchRequired = 0;
            List.ReplaceItem(LMRState, Ply, 1);
            If (Not (((Not ((Ret.Search_Core.NodeEval == Const.Null))) And (Ret.Search_Core.NodeEval > Alphas[Ply]))))
            {
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.LMRHits)(Horizon)(Ply);
                }
            }
        }
        Call //("Non-PV search");
        Search_Core.IsFullDepthResearch = 0;
        If (Glob.Search.IsTimeout == 0)
        {
            If (Search_Core.LmrNonPV.IsReSearchRequired == 0)
            {
                If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
                {
                    If (Ret.Search_Core.NodeEval > Alphas[Ply])
                    {
                        Search_Core.IsFullDepthResearch = 1;
                    }
                }
            }
            Else
            {
                If ((PickedLegalMovesCount[Ply] > 1) Or (IsPvNode[Ply] == 0))
                {
                    Search_Core.IsFullDepthResearch = 1;
                }
            }
        }
        If (Search_Core.IsFullDepthResearch == 1)
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                If (IsPvNode[Ply] == 1)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVSCalls)(Horizon)(Ply);
                }
            }
            Call SearchNextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((Not (Cutnode)))(Quiescence)(Const.Null);
            Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
            {
                Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
            }
            If (LMRState[Ply] == 1)
            {
                If ((Not ((Ret.Search_Core.NodeEval == Const.Null))) And (Ret.Search_Core.NodeEval > Alphas[Ply]))
                {
                    List.ReplaceItem(LMRState, Ply, 2);
                }
                Else
                {
                    List.ReplaceItem(LMRState, Ply, 3);
                }
            }
            Search_Core.IsPVReSearch = 0;
            If (IsPvNode[Ply] == 1)
            {
                If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
                {
                    If (Ret.Search_Core.NodeEval > Alphas[Ply])
                    {
                        If ((Ret.Search_Core.NodeEval < Betas[Ply]) Or (Ply == 1))
                        {
                            Search_Core.IsPVReSearch = 1;
                        }
                    }
                }
            }
            If (Search_Core.IsPVReSearch == 1)
            {
                Search_Core.LmrNonPV.IsReSearchRequired = 1;
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVSReSearches)(Horizon)(Ply);
                }
            }
            Else
            {
                Search_Core.LmrNonPV.IsReSearchRequired = 0;
            }
        }
    }
    If ((Search_Core.LmrNonPV.IsReSearchRequired == 1) And (Glob.Search.IsTimeout == 0))
    {
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_CountByHorizon(Const.Profile.FullCalls)(Horizon)(Ply);
        }
        Call //("Move was not pruned upfront, enter full depth + current window search");
        Call SearchNextPly((0 - Betas[Ply]))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((1 == 0))(Quiescence)(Const.Null);
        Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
        If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
        {
            Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
        }
    }
}

Define Search_DetectCheckmate(string Ply) (warp=true)
{
    If (Ply > 1)
    {
        Call //("Virtual king captures on previous ply => depth-corrected checkmate evaluation");
        If (abs(TargetPieces[(Ply - 1)]) == GoK_BlackKing)
        {
            List.ReplaceItem(SearchEval, Ply, (0 - (100000 - (List.Length(BoardHistoryFiftyMoves) - 1))));
            Stop(this script);
        }
        If (1 == 0)
        {
            If ((Ply == 2) Or (CheckedState[(Ply - 1)] == 1))
            {
                Call //("Early checkmate evaluation on previous checks when not evaded. As we now have special check evasion search, this is mainly for safety");
                Call CalcBoardAttacked(Ply);
                If (((PlyIsOwn[Ply] == 1) And (Glob.Board.IsWhiteChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.Board.IsBlackChecked == 1)))
                {
                    List.ReplaceItem(SearchEval, Ply, (100000 - List.Length(BoardHistoryFiftyMoves)));
                    Stop(this script);
                }
            }
        }
    }
    If (ChebyshevDistance[((Glob.Board.BlackKingIdx * 100) + Glob.Board.WhiteKingIdx)] < 2)
    {
        List.ReplaceItem(SearchEval, Ply, (100000 - List.Length(BoardHistoryFiftyMoves)));
        List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
        Stop(this script);
    }
}

Define Search_DetectDraw(string Horizon)(string Ply) (warp=true)
{
    Search_DetectDraw.IsDraw = 0;
    If (Ply > 1)
    {
        Call //("Draw-by-stalemate detection. This is expensive, and is only applied at low search depth or during late endgame stage (no minor pieces left)");
        If (Ply < 9)
        {
            If (Not ((CheckedState[Ply] == 1)))
            {
                If (PlyIsOwn[Ply] == 1)
                {
                    Search_DetectDraw.QueenCount = Glob.Board.BlackQueenCount;
                    Search_DetectDraw.MinorMajorCount = Glob.Board.BlackNonQueenMajorMinorCount;
                }
                Else
                {
                    Search_DetectDraw.QueenCount = Glob.Board.WhiteQueenCount;
                    Search_DetectDraw.MinorMajorCount = Glob.Board.WhiteNonQueenMajorMinorCount;
                }
                If ((Search_DetectDraw.QueenCount == 0) And (Search_DetectDraw.MinorMajorCount < 2))
                {
                    If (1 == 0)
                    {
                        Call IsDrawByStalemate((Ply + 2));
                        If (Ret.IsDrawByStalemate.IsDraw == 1)
                        {
                            Search_DetectDraw.IsDraw = 1;
                        }
                    }
                }
            }
        }
        Call //("Fast draw-by-material verification");
        If (((Glob.Board.BlackQueenCount == 0) And (Glob.Board.WhiteQueenCount == 0)) And ((Glob.Board.BlackPawnCount == 0) And (Glob.Board.WhitePawnCount == 0)))
        {
            If (((Glob.Board.BlackRookCount == 0) And (Glob.Board.BlackNonQueenMajorMinorCount < 2)) And ((Glob.Board.WhiteRookCount == 0) And (Glob.Board.WhiteNonQueenMajorMinorCount < 2)))
            {
                Search_DetectDraw.IsDraw = 1;
            }
        }
        If (Search_DetectDraw.IsDraw == 0)
        {
            Call //("Special K-KP endgame draw detection, according to pawn and king position. Finds draws otherwise not visible within search horizon");
            If ((Ply > 1) And (Quiescence[(Ply - 1)] == 0))
            {
                If (((Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount) == 0) And ((Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount) == 0))
                {
                    If ((Glob.Board.BlackPawnCount + Glob.Board.WhitePawnCount) == 1)
                    {
                        Search_DetectDraw.SqIdx = 1;
                        Repeat (64)
                        {
                            If ((Board[Search_DetectDraw.SqIdx] == GoK_WhitePawn) And (PlyIsOwn[Ply] == 0))
                            {
                                If ((IdxToFile[Search_DetectDraw.SqIdx] == 1) Or (IdxToFile[Search_DetectDraw.SqIdx] == 8))
                                {
                                    If ((IdxToFile[Search_DetectDraw.SqIdx] == IdxToFile[Glob.Board.BlackKingIdx]) And (IdxToRank[Glob.Board.BlackKingIdx] < IdxToRank[Search_DetectDraw.SqIdx]))
                                    {
                                        Search_DetectDraw.IsDraw = 1;
                                    }
                                }
                                Else
                                {
                                    If (((Search_DetectDraw.SqIdx - 8) == Glob.Board.BlackKingIdx) Or ((Search_DetectDraw.SqIdx - 16) == Glob.Board.BlackKingIdx))
                                    {
                                        If (Not ((((Search_DetectDraw.SqIdx - 1) == Glob.Board.WhiteKingIdx) Or ((Search_DetectDraw.SqIdx + 1) == Glob.Board.WhiteKingIdx))))
                                        {
                                            Search_DetectDraw.IsDraw = 1;
                                        }
                                    }
                                    If ((Search_DetectDraw.SqIdx - 24) == Glob.Board.BlackKingIdx)
                                    {
                                        If ((IdxToRank[Search_DetectDraw.SqIdx] > 4) And ((Search_DetectDraw.SqIdx - 8) == Glob.Board.WhiteKingIdx))
                                        {
                                            Search_DetectDraw.IsDraw = 1;
                                        }
                                    }
                                }
                            }
                            Else
                            {
                                If ((Board[Search_DetectDraw.SqIdx] == GoK_BlackPawn) And (PlyIsOwn[Ply] == 1))
                                {
                                    If ((IdxToFile[Search_DetectDraw.SqIdx] == 1) Or (IdxToFile[Search_DetectDraw.SqIdx] == 8))
                                    {
                                        If ((IdxToFile[Search_DetectDraw.SqIdx] == IdxToFile[Glob.Board.WhiteKingIdx]) And (IdxToRank[Glob.Board.WhiteKingIdx] > IdxToRank[Search_DetectDraw.SqIdx]))
                                        {
                                            Search_DetectDraw.IsDraw = 1;
                                        }
                                    }
                                    Else
                                    {
                                        If (((Search_DetectDraw.SqIdx + 8) == Glob.Board.WhiteKingIdx) Or ((Search_DetectDraw.SqIdx + 16) == Glob.Board.WhiteKingIdx))
                                        {
                                            If (Not ((((Search_DetectDraw.SqIdx - 1) == Glob.Board.BlackKingIdx) Or ((Search_DetectDraw.SqIdx + 1) == Glob.Board.BlackKingIdx))))
                                            {
                                                Search_DetectDraw.IsDraw = 1;
                                            }
                                        }
                                        If ((Search_DetectDraw.SqIdx + 24) == Glob.Board.WhiteKingIdx)
                                        {
                                            If ((IdxToRank[Search_DetectDraw.SqIdx] < 5) And ((Search_DetectDraw.SqIdx + 8) == Glob.Board.BlackKingIdx))
                                            {
                                                Search_DetectDraw.IsDraw = 1;
                                            }
                                        }
                                    }
                                }
                            }
                            Search_DetectDraw.SqIdx += 1;
                        }
                    }
                }
            }
        }
    }
    If (Search_DetectDraw.IsDraw == 1)
    {
        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
    }
}

Define Search_DetectDrawByRepetition(string Ply)(bool Quiescence) (warp=true)
{
    If (Ply > 1)
    {
        If ((BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 99) And (CheckedState[Ply] == 0))
        {
            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
            Stop(this script);
        }
        Call //("Draw-by-repetition detection. This happens on every ply and could be costly, so we check previous plies for pawn moves and captures. When repetition is possible, history tables are searched for same board hash, when found we verify if the occurred for the same side.");
        If (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 3)
        {
            Search_DetectDrawByRepetition.Count = 1;
            Search_DetectDrawByRepetition.RepHistCount = 0;
            If List.ContainsItem(PreviousBoardHash, (Glob.Board.CurrentHash + 0))
            {
                Search_DetectDrawByRepetition.Idx = (Ply - 2);
                Repeat Until ((Search_DetectDrawByRepetition.Idx < 2) Or (Search_DetectDrawByRepetition.Count > 2))
                {
                    If ((AppliedMove[Search_DetectDrawByRepetition.Idx] == 0) Or (AppliedMove[(Search_DetectDrawByRepetition.Idx + 1)] == 0))
                    {
                        Search_DetectDrawByRepetition.Idx = 0;
                    }
                    Else
                    {
                        If ((((Glob.Board.CurrentHash + 0) == PreviousBoardHash[Search_DetectDrawByRepetition.Idx]) And (CastlingState[Ply] == CastlingState[(Search_DetectDrawByRepetition.Idx - 1)])) And (EnPassantTarget[Ply] == EnPassantTarget[(Search_DetectDrawByRepetition.Idx - 1)]))
                        {
                            Search_DetectDrawByRepetition.Count += 1;
                        }
                    }
                    Search_DetectDrawByRepetition.Idx += -2;
                }
            }
            If (Glob.Search.IsInNullMove == 0)
            {
                If List.ContainsItem(BoardHistoryHash, (Glob.Board.CurrentHash + 0))
                {
                    Search_DetectDrawByRepetition.Idx = ((List.Length(BoardHistoryHash) - 1) + PlyIsOwn[Ply]);
                    Repeat Until ((Search_DetectDrawByRepetition.Idx < 1) Or (Search_DetectDrawByRepetition.RepHistCount > 2))
                    {
                        If (((Glob.Board.CurrentHash + 0) == BoardHistoryHash[Search_DetectDrawByRepetition.Idx]) And (CastlingState[Ply] == BoardHistoryMetaState[Search_DetectDrawByRepetition.Idx]))
                        {
                            Search_DetectDrawByRepetition.RepHistCount += 1;
                        }
                        Search_DetectDrawByRepetition.Idx += -2;
                    }
                }
            }
            If ((Search_DetectDrawByRepetition.Count > 1) Or (Search_DetectDrawByRepetition.RepHistCount > 1))
            {
                List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
                Stop(this script);
            }
        }
    }
}

Define Search_DetectExtensions(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Not (Quiescence))
    {
        If ((SingularState[Ply] == 1) And (AppliedMove[Ply] == SingularMove[Ply]))
        {
            List.ReplaceItem(SearchExtension, Ply, SingularExtension[Ply]);
            Stop(this script);
        }
        If (SearchExtension[Ply] == 0)
        {
            Call //("agreed gok engines twins diff: nnue check extension gate > -1, classic > 35.5");
            If (PutsInCheck[Ply] == 1)
            {
                List.ReplaceItem(SearchExtension, Ply, 1);
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_FutilityPruning(string Horizon)(string Ply)(bool Quiescence) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call Search_CollectStats(Horizon)(Ply)(Quiescence)(Const.Profile.DeltaCalls)(Const.Profile.FutilityCalls);
    }
    Ret.Search_FutilityPruning.IsFutile = 0;
    Search_FutilityPruning.DangerousPush = 0;
    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
    {
        Search_FutilityPruning.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search_FutilityPruning.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search_FutilityPruning.PushRank < 4)))
        {
            Search_FutilityPruning.DangerousPush = 1;
        }
    }
    If ((Search_FutilityPruning.DangerousPush == 1) And (Not (Quiescence)))
    {
        Stop(this script);
    }
    If (((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0)) And (PromotionPieces[Ply] == 0))
    {
        If (1 == 1)
        {
            Search_FutilityPruning.CanPrune = 0;
            If (PlyIsOwn[Ply] == 1)
            {
                Search_FutilityPruning.PieceCount = (Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount);
            }
            Else
            {
                Search_FutilityPruning.PieceCount = (Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount);
            }
            If (Not (Quiescence))
            {
                If (Not ((SearchEval[Ply] == Const.Null)))
                {
                    If (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval))
                    {
                        If (Search_FutilityPruning.PieceCount > 0)
                        {
                            Search_FutilityPruning.CanPrune = 1;
                        }
                    }
                }
            }
            If (Search_FutilityPruning.CanPrune == 1)
            {
                If ((Not (Quiescence)) And ((IsPvNode[Ply] == 0) And (TargetPieces[Ply] == 0)))
                {
                    Call GetImproving(Ply);
                    Search_FutilityPruning.IsImproving = Ret.GetImproving.IsImproving;
                    If (Search_FutilityPruning.IsImproving == Const.Null)
                    {
                        Search_FutilityPruning.IsImproving = 1;
                    }
                    If (PickedLegalMovesCountQuiet[Ply] > (3 + ((Horizon * Horizon) / (2 - (Search_FutilityPruning.IsImproving == 1)))))
                    {
                        Ret.Search_FutilityPruning.IsFutile = 1;
                        Stop(this script);
                    }
                }
            }
        }
        Search_FutilityPruning.SEEGain = Const.Null;
        Search_FutilityPruning.FutilityMargin = Const.Null;
        If Quiescence
        {
            If ((Not ((TargetPieces[Ply] == 0))) And (Search_FutilityPruning.PieceCount > 0))
            {
                Search_FutilityPruning.FutilityMargin = 175;
            }
        }
        Else
        {
            If (Search_FutilityPruning.CanPrune == 1)
            {
                If ((Ply > 1) And (Horizon < 6))
                {
                    If ((TargetPieces[Ply] == 0) And ((PickedLegalMovesCount[Ply] > 1) And (IsPvNode[Ply] == 0)))
                    {
                        If (1 == 1)
                        {
                            Search_FutilityPruning.Reduction = 0;
                            If (((Horizon + SearchExtension[Ply]) > 2) And (PickedLegalMovesCount[Ply] > 2))
                            {
                                Search_FutilityPruning.Reduction = floor((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + SearchExtension[Ply]))) / 2.25)));
                                Call GetImproving(Ply);
                                If (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))
                                {
                                    Search_FutilityPruning.Reduction += -1;
                                }
                            }
                            If (Search_FutilityPruning.Reduction > (Horizon - 1))
                            {
                                Search_FutilityPruning.Reduction = (Horizon - 1);
                            }
                            Search_FutilityPruning.FutilityMargin = (103 + ((Horizon - Search_FutilityPruning.Reduction) * 127));
                            If (Not ((floor((AppliedMove[Ply] / 100)) == 0)))
                            {
                                Search_FutilityPruning.KPHash = Glob.Board.KPHash;
                                If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
                                {
                                    Search_FutilityPruning.KPHash = PreviousBoardHashKP[Ply];
                                }
                                Call GetHistoryStatScore(SourcePieces[Ply])(floor((AppliedMove[Ply] / 100)))(floor((AppliedMove[Ply] % 100)))(AppliedMove[Ply])(Ply)(Search_FutilityPruning.KPHash);
                                Search_FutilityPruning.FutilityMargin += floor((Ret.GetHistoryStatScore.Score / 120));
                            }
                        }
                    }
                }
            }
        }
        If (Not ((Search_FutilityPruning.FutilityMargin == Const.Null)))
        {
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Search_FutilityPruning.Eval = ((StaticEval[Ply] - (TargetPieces[Ply] * PlySign[Ply])) + Search_FutilityPruning.FutilityMargin);
                If (Not ((Search_FutilityPruning.Eval > Alphas[Ply])))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                }
                Else
                {
                    If Quiescence
                    {
                        Search_FutilityPruning.Eval = (StaticEval[Ply] + Search_FutilityPruning.FutilityMargin);
                        If ((Not ((Search_FutilityPruning.Eval > Alphas[Ply]))) And (Not (((abs(TargetPieces[Ply]) > abs(SourcePieces[Ply])) And (PromotionPieces[Ply] == 0)))))
                        {
                            Call SEE(Ply)((Glob.Config.IsScratch3 == 0));
                            Search_FutilityPruning.SEEGain = Ret.SEE.Gain;
                            If (Not ((Search_FutilityPruning.SEEGain > 0)))
                            {
                                Ret.Search_FutilityPruning.IsFutile = 1;
                            }
                        }
                    }
                }
                If (Ret.Search_FutilityPruning.IsFutile == 1)
                {
                    If Quiescence
                    {
                        If (Search_FutilityPruning.Eval > SearchEval[Ply])
                        {
                            List.ReplaceItem(SearchEval, Ply, Search_FutilityPruning.Eval);
                        }
                    }
                }
            }
        }
        If (1 == 0)
        {
            If (Ret.Search_FutilityPruning.IsFutile == 0)
            {
                If ((Not (Quiescence)) And ((Ply > 1) And (Horizon < 6)))
                {
                    If ((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0))
                    {
                        If (Search_FutilityPruning.SEEGain == Const.Null)
                        {
                            Call SEE(Ply)((Glob.Config.IsScratch3 == 0));
                            Search_FutilityPruning.SEEGain = Ret.SEE.Gain;
                        }
                        If (Search_FutilityPruning.SEEGain < (-125 * Horizon))
                        {
                            Ret.Search_FutilityPruning.IsFutile = 1;
                        }
                    }
                }
            }
        }
        If (((((Quiescence And (Ret.Search_FutilityPruning.IsFutile == 0)) And (Not ((TargetPieces[Ply] == 0)))) And (abs(TargetPieces[Ply]) < abs(SourcePieces[Ply]))) And (Not (((CheckedState[Ply] == 0) And (((StaticEval[Ply] - abs(TargetPieces[Ply])) + 175) > Alphas[Ply]))))) And (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval)))
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.QSEECalls)(Horizon)(Ply);
            }
            If (Search_FutilityPruning.SEEGain == Const.Null)
            {
                Call SEE(Ply)((Glob.Config.IsScratch3 == 0));
                Search_FutilityPruning.SEEGain = Ret.SEE.Gain;
            }
            If (Search_FutilityPruning.SEEGain < 0)
            {
                Ret.Search_FutilityPruning.IsFutile = 1;
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.QSEEHits)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_InitStack(string Ply)(bool Quiescence) (warp=true)
{
    If (Not (Quiescence))
    {
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 1), Const.Null);
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 2), Const.Null);
    }
    Call NNUE_OnInitStack(Ply);
    Call //("Initialize local variables or forward state from previous ply");
    If (Ply == 1)
    {
        Call CalcBoardAttackedByMove(2);
        Call StoreAttackInfo(1);
        List.ReplaceItem(BoardAttackedCalculated, 1, 1);
        List.ReplaceItem(CastlingState, 1, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
        If (Not ((CastlingState[1] == Const.Null)))
        {
            If ((CastlingBit[((8 * CastlingState[1]) + 1)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 2)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 3)] == 1) And (CastlingBit[((8 * CastlingState[1]) + 4)] == 1))))
            {
                Call SetCastlingStateFlag(1)(1)(1);
                Call SetCastlingStateFlag(1)(2)(1);
                Call SetCastlingStateFlag(1)(3)(1);
                Call SetCastlingStateFlag(1)(4)(1);
            }
            If ((CastlingBit[((8 * CastlingState[1]) + 5)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 6)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 7)] == 1) And (CastlingBit[((8 * CastlingState[1]) + 8)] == 1))))
            {
                Call SetCastlingStateFlag(1)(5)(1);
                Call SetCastlingStateFlag(1)(6)(1);
                Call SetCastlingStateFlag(1)(7)(1);
                Call SetCastlingStateFlag(1)(8)(1);
            }
        }
        Call SetInitialEP(1);
    }
    Else
    {
        List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
        List.ReplaceItem(CheckedState, Ply, PutsInCheck[(Ply - 1)]);
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
    }
    List.ReplaceItem(AlphasOld, Ply, Alphas[Ply]);
    If ((Betas[Ply] - Alphas[Ply]) > 1)
    {
        List.ReplaceItem(IsPvNode, Ply, 1);
        If ((Not (Quiescence)) And (Ply > Glob.Search.SelDepth))
        {
            Glob.Search.SelDepth = Ply;
        }
    }
    Else
    {
        List.ReplaceItem(IsPvNode, Ply, 0);
    }
    List.ReplaceItem(SearchExtension, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(DoubleExtensions, Ply, 0);
    }
    Else
    {
        List.ReplaceItem(DoubleExtensions, Ply, (DoubleExtensions[(Ply - 1)] + (SearchExtension[(Ply - 1)] == 2)));
    }
    List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
    List.ReplaceItem(BestMoves, Ply, Const.Null);
    List.ReplaceItem(IsBestMoveQuiet, Ply, 0);
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(StaticEval, Ply, Const.Null);
    List.ReplaceItem(Improving, Ply, Const.Null);
    List.ReplaceItem(LMRState, Ply, 0);
    List.ReplaceItem(QuietsSearchedCount, Ply, 0);
    List.ReplaceItem(CapturesSearchedCount, Ply, 0);
    List.ReplaceItem(PV, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    List.ReplaceItem(PVRaw, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    If Quiescence
    {
        List.ReplaceItem(Quiescence, Ply, 1);
    }
    Else
    {
        List.ReplaceItem(Quiescence, Ply, 0);
    }
    Call Evaluate((Ply - 1))((1 == 0));
    List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCount, Ply, 0);
}

Define Search_InternalIterativeDeepening(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    If ((IIDState[Ply] == 0) And (Not (Quiescence)))
    {
        If (Horizon > 5)
        {
            If ((CheckedState[Ply] == 0) And (IsPvNode[Ply] == 1))
            {
                If (1 == 0)
                {
                    If (NodeTTMove[Ply] == Const.Null)
                    {
                        List.ReplaceItem(IIDState, Ply, 1);
                    }
                }
            }
        }
    }
}

Define Search_NullMovePruning(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    Call //("Null move pruning");
    If (1 == 1)
    {
        If (Not ((AppliedMove[(Ply - 1)] == 0)))
        {
            Glob.Search.IsInNullMove += 1;
            If (Not (Quiescence))
            {
                If ((Horizon > 2) And ((IsPvNode[Ply] == 0) And (CheckedState[Ply] == 0)))
                {
                    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                    {
                        Call Profile_CountByHorizon(Const.Profile.NMPCalls)(Horizon)(Ply);
                    }
                    If (((PlyIsOwn[Ply] == 1) And ((Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount) > 0)) Or ((PlyIsOwn[Ply] == 0) And ((Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount) > 0)))
                    {
                        If (Not ((StaticEval[Ply] == Const.Null)))
                        {
                            Call GetCalibratedEval(Ply);
                            Search_NullMovePruning.EvalSurplus = (Ret.GetCalibratedEval.Score - Betas[Ply]);
                            If (Search_NullMovePruning.EvalSurplus > 535)
                            {
                                Search_NullMovePruning.EvalSurplus = 535;
                            }
                            Search_NullMovePruning.Reduction = ((3 + floor((Horizon / 3))) + floor((Search_NullMovePruning.EvalSurplus / 107)));
                            If (Search_NullMovePruning.Reduction < 0)
                            {
                                Search_NullMovePruning.Reduction = 0;
                            }
                            If ((Search_NullMovePruning.Reduction > 0) And (Search_NullMovePruning.EvalSurplus > 0))
                            {
                                Call GetImproving(Ply);
                                Search_NullMovePruning.IsImproving = Ret.GetImproving.IsImproving;
                                If (Search_NullMovePruning.IsImproving == Const.Null)
                                {
                                    Search_NullMovePruning.IsImproving = 1;
                                }
                                Search_NullMovePruning.Margin = 0;
                                Search_NullMovePruning.Eval = Ret.GetCalibratedEval.Score;
                                If (Not ((Search_NullMovePruning.Eval == Const.Null)))
                                {
                                    If ((Not ((Search_NullMovePruning.Eval < (Betas[Ply] + Search_NullMovePruning.Margin)))) And (Not ((Search_NullMovePruning.Eval < StaticEval[Ply]))))
                                    {
                                        Call ClearMoveList(Ply);
                                        Call AddMoveToList(0)(Ply)(0);
                                        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                                        {
                                            Call Profile_CountByHorizon(Const.Profile.NMPTries)(Horizon)(Ply);
                                        }
                                        List.ReplaceItem(MovesIdx, Ply, 1);
                                        Call ApplyMove(Ply)((1 == 0));
                                        Call NNUE_OnApplyMove(Ply);
                                        Call SearchNextPly((0 - Betas[Ply]))((0 - (Betas[Ply] - 1)))(Horizon)(Search_NullMovePruning.Reduction)(Ply)((Not (Cutnode)))(Quiescence)(Const.Null);
                                        Search_NullMovePruning.NodeEval = SearchEval[(Ply + 1)];
                                        If (Not ((Search_NullMovePruning.NodeEval == Const.Null)))
                                        {
                                            Search_NullMovePruning.NodeEval = (0 - Search_NullMovePruning.NodeEval);
                                        }
                                        Call RevertMove(Ply);
                                        If (Not ((Search_NullMovePruning.NodeEval == Const.Null)))
                                        {
                                            Search_NullMovePruning.NodeEvalAbs = abs(Search_NullMovePruning.NodeEval);
                                            If (Not ((Search_NullMovePruning.NodeEvalAbs > Const.AbsMinCheckmateEval)))
                                            {
                                                If ((Not ((Search_NullMovePruning.NodeEval < Betas[Ply]))) And (Not ((abs(Search_NullMovePruning.NodeEval) > Const.AbsMinCheckmateEval))))
                                                {
                                                    List.ReplaceItem(SearchEval, Ply, Search_NullMovePruning.NodeEval);
                                                    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                                                    {
                                                        Call Profile_CountByHorizon(Const.Profile.NMPHits)(Horizon)(Ply);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Glob.Search.IsInNullMove += -1;
        }
    }
}

Define Search_OnBestRootMoveFound(string Move)(string Eval) (warp=true)
{
    If (Glob.Config.IsDCI == 1)
    {
        Stop(this script);
    }
}

Define Search_Razoring(string Horizon)(string Ply)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (1 == 1)
    {
        If (((Not (Quiescence)) And ((CheckedState[Ply] == 0) And (Horizon < 5))) And (IsPvNode[Ply] == 0))
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.RazoringCalls)(Horizon)(Ply);
            }
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Search_Razoring.Margin = (174 + (129 * (Horizon * Horizon)));
                Call GetCalibratedEval(Ply);
                If (Not ((Ret.GetCalibratedEval.Score == Const.Null)))
                {
                    If (((Ret.GetCalibratedEval.Score + Search_Razoring.Margin) < Alphas[Ply]) And (RazorState[Ply] == 0))
                    {
                        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                        {
                            Call Profile_CountByHorizon(Const.Profile.RazoringTries)(Horizon)(Ply);
                        }
                        Call SearchImpl(Alphas[Ply])(Betas[Ply])(0)(Ply)((1 == 1))((1 == 1))(Const.Null);
                        If (Not ((SearchEval[Ply] == Const.Null)))
                        {
                            If (1 == 1)
                            {
                                If (SearchEval[Ply] < AlphasOld[Ply])
                                {
                                    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                                    {
                                        List.ReplaceItem(ProfileByHorizon, (Const.Profile.RazoringHits + (Horizon + 1)), (ProfileByHorizon[(Const.Profile.RazoringHits + (Horizon + 1))] + 1));
                                    }
                                    Stop(this script);
                                }
                            }
                        }
                        List.ReplaceItem(Alphas, Ply, AlphasOld[Ply]);
                        List.ReplaceItem(SearchEval, Ply, Const.Null);
                        List.ReplaceItem(RazorState, Ply, 1);
                        Stop(this script);
                    }
                }
            }
        }
    }
}

Define Search_ReverseFutilityPruning(string Horizon)(string Ply) (warp=true)
{
    If (1 == 1)
    {
        If (((Ply > 1) And (Horizon < 8)) And ((CheckedState[Ply] == 0) And (IsTTPv[Ply] == 0)))
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.RFPCalls)(Horizon)(Ply);
            }
            If (abs(Betas[Ply]) > Const.AbsMinCheckmateEval)
            {
                Stop(this script);
            }
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Call GetImproving(Ply);
                Search_ReverseFutilityPruning.Margin = (117 * (Horizon - (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))));
                If (Search_ReverseFutilityPruning.Margin < 15)
                {
                    Search_ReverseFutilityPruning.Margin = 15;
                }
                Call GetCalibratedEval(Ply);
                If (Not ((Ret.GetCalibratedEval.Score == Const.Null)))
                {
                    If ((Not (((Ret.GetCalibratedEval.Score - Search_ReverseFutilityPruning.Margin) < Betas[Ply]))) And (Ret.GetCalibratedEval.Score < 13152))
                    {
                        List.ReplaceItem(SearchEval, Ply, Ret.GetCalibratedEval.Score);
                        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                        {
                            Call Profile_CountByHorizon(Const.Profile.RFPHits)(Horizon)(Ply);
                        }
                    }
                }
            }
        }
    }
}

Define Search_TTProbeEval(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    Search_TTProbeEval.Rule50 = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
    If ((Ply > 1) And (ExcludedMove == Const.Null))
    {
        If (IsPvNode[Ply] == 0)
        {
            Call //("Probe transposition table for cached node evaluations");
            Search_TTProbeEval.TTType = NodeTTType[Ply];
            Search_TTProbeEval.TTScore = NodeTTScore[Ply];
            Search_TTProbeEval.TTQSMeta = NodeTTQSMeta[Ply];
            Search_TTProbeEval.TTHorizon = NodeTTHorizon[Ply];
            Search_TTProbeEval.TTHit = NodeTTHit[Ply];
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.TTNodeProbe)(Horizon)(Ply);
            }
            If (Search_TTProbeEval.TTHit == 1)
            {
                If ((Not ((Search_TTProbeEval.TTScore == Const.Null))) And (Not ((Search_TTProbeEval.TTHorizon == Const.Null))))
                {
                    Call IsQuiescentCheckCond(Ply);
                    Search_TTProbeEval.IsTTCutoffAllowed = 0;
                    If Quiescence
                    {
                        If (Search_TTProbeEval.TTHorizon > -1)
                        {
                            Search_TTProbeEval.IsTTCutoffAllowed = 1;
                        }
                        Else
                        {
                            If ((Search_TTProbeEval.TTHorizon > -2) And ((Not ((Search_TTProbeEval.TTQSMeta == Const.Null))) And (Not ((Search_TTProbeEval.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue)))))
                            {
                                Search_TTProbeEval.IsTTCutoffAllowed = 1;
                            }
                        }
                    }
                    Else
                    {
                        If ((Not ((Search_TTProbeEval.TTHorizon < Horizon))) And (Search_TTProbeEval.Rule50 < 90))
                        {
                            If ((Not ((Search_TTProbeEval.TTScore > Alphas[Ply]))) Or Cutnode)
                            {
                                Search_TTProbeEval.IsTTCutoffAllowed = 1;
                            }
                        }
                    }
                    If (Search_TTProbeEval.IsTTCutoffAllowed == 1)
                    {
                        Search_TTProbeEval.IsTTCutoff = 0;
                        If (Search_TTProbeEval.TTType == Const.TTType.Exact)
                        {
                            Search_TTProbeEval.IsTTCutoff = 1;
                        }
                        Else
                        {
                            If (IsPvNode[Ply] == 0)
                            {
                                If (Search_TTProbeEval.TTType == Const.TTType.HighBound)
                                {
                                    If (Not ((Search_TTProbeEval.TTScore > Alphas[Ply])))
                                    {
                                        Search_TTProbeEval.IsTTCutoff = 1;
                                    }
                                }
                                Else
                                {
                                    If (Search_TTProbeEval.TTType == Const.TTType.LowBound)
                                    {
                                        If (Not ((Search_TTProbeEval.TTScore < Betas[Ply])))
                                        {
                                            Search_TTProbeEval.IsTTCutoff = 1;
                                        }
                                    }
                                }
                            }
                        }
                        If (Search_TTProbeEval.IsTTCutoff == 1)
                        {
                            If (1 == 1)
                            {
                                If ((Not ((NodeTTMove[Ply] == Const.Null))) And (Not ((Search_TTProbeEval.TTScore < Betas[Ply]))))
                                {
                                    Call IsQuietMove(NodeTTMove[Ply]);
                                    If (Ret.IsQuietMove.IsQuiet == 1)
                                    {
                                        If (Not (Quiescence))
                                        {
                                            Call StoreKillerMove(Ply)(NodeTTMove[Ply])(Horizon)((1 == 0))((1 == 0))((1 == 1));
                                        }
                                    }
                                }
                                If ((Not (Quiescence)) And (Not ((NodeTTMove[Ply] == Const.Null))))
                                {
                                    If (Search_TTProbeEval.TTScore < Betas[Ply])
                                    {
                                        Call IsQuietMove(NodeTTMove[Ply]);
                                        If (Ret.IsQuietMove.IsQuiet == 1)
                                        {
                                            Call StoreKillerMove(Ply)(NodeTTMove[Ply])(Horizon)((1 == 1))((1 == 0))((1 == 1));
                                        }
                                    }
                                }
                                List.ReplaceItem(SearchEval, Ply, Search_TTProbeEval.TTScore);
                                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.TTNodeHit)(Horizon)(Ply);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define SEE(string MovePly)(bool WithPinFilter) (warp=true)
{
    Ret.SEE.Gain = 0;
    If (floor((AppliedMove[MovePly] / 100)) == 0)
    {
        Stop(this script);
    }
    SEE.Ply = MovePly;
    SEE.TargetIdx = floor((AppliedMove[SEE.Ply] % 100));
    If ((abs(SourcePieces[SEE.Ply]) == GoK_BlackPawn) And ((IdxToRank[SEE.TargetIdx] == 1) Or (IdxToRank[SEE.TargetIdx] == 8)))
    {
        Ret.SEE.Gain = 0;
        Stop(this script);
    }
    List.DeleteAll(SEE.TmpList4);
    List.DeleteAll(SEE.TmpList5);
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesMoveList))
    {
        List.Add(SEE.TmpList4, CalcMovesMoveList[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesScoreList))
    {
        List.Add(SEE.TmpList5, CalcMovesScoreList[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Side = 1;
    If (PlyIsOwn[MovePly] == 1)
    {
        SEE.Side = 2;
    }
    Else
    {
        SEE.Side = 1;
    }
    SEE.IsDone = 0;
    Repeat Until (SEE.IsDone == 1)
    {
        List.DeleteAll(CalcMovesMoveList);
        List.DeleteAll(CalcMovesScoreList);
        SEE.SourceIdx = 1;
        If WithPinFilter
        {
            SEE.Pin.QIdx = PieceIdxLookup[GoK_BlackQueen];
        }
        Repeat (64)
        {
            SEE.SourcePiece = Board[(SEE.SourceIdx + 0)];
            If (((SEE.Side == 1) And (SEE.SourcePiece > 0)) Or ((SEE.Side == 2) And (SEE.SourcePiece < 0)))
            {
                Call IsReachableForAttack(Board[(SEE.SourceIdx + 0)])(SEE.SourceIdx)(SEE.TargetIdx);
                If (Ret.IsReachableForAttack.IsReachable == 1)
                {
                    SEE.Pin.IsPinned = 0;
                    If (WithPinFilter And (Not ((abs(Board[SEE.TargetIdx]) == GoK_BlackKing))))
                    {
                        SEE.Pin.AttackerPiece = Board[SEE.SourceIdx];
                        If (SEE.Pin.AttackerPiece > 0)
                        {
                            SEE.Pin.King = Glob.Board.BlackKingIdx;
                        }
                        Else
                        {
                            SEE.Pin.King = Glob.Board.WhiteKingIdx;
                        }
                        SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.SourceIdx * 100)) + SEE.Pin.King);
                        If (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0)))))
                        {
                            SEE.Pin.Move = ((SEE.Pin.King * 100) + SEE.SourceIdx);
                            SEE.Pin.RayStep = MoveToPathStepInc[SEE.Pin.Move];
                            SEE.Pin.Walk = SEE.Pin.King;
                            SEE.Pin.PathClear = 1;
                            Repeat ((MoveToPathDelta[SEE.Pin.Move] - 1))
                            {
                                SEE.Pin.Walk += SEE.Pin.RayStep;
                                SEE.Pin.PathClear = (SEE.Pin.PathClear * (Board[SEE.Pin.Walk] == 0));
                            }
                            If (SEE.Pin.PathClear == 1)
                            {
                                List.ReplaceItem(Board, SEE.SourceIdx, 0);
                                SEE.Pin.Walk = (SEE.SourceIdx + SEE.Pin.RayStep);
                                SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                SEE.Pin.OnLine = (0 + ((SEE.Pin.Walk > 0) And ((SEE.Pin.Walk < 65) And (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0))))))));
                                If (SEE.Pin.OnLine == 1)
                                {
                                    SEE.Pin.BlockerPiece = Board[SEE.Pin.Walk];
                                }
                                Else
                                {
                                    SEE.Pin.BlockerPiece = 0;
                                }
                                Repeat Until ((Not ((SEE.Pin.OnLine == 1))) Or (Not ((SEE.Pin.BlockerPiece == 0))))
                                {
                                    SEE.Pin.Walk += SEE.Pin.RayStep;
                                    SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                    SEE.Pin.OnLine = (0 + ((SEE.Pin.Walk > 0) And ((SEE.Pin.Walk < 65) And (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0))))))));
                                    If (SEE.Pin.OnLine == 1)
                                    {
                                        SEE.Pin.BlockerPiece = Board[SEE.Pin.Walk];
                                    }
                                    Else
                                    {
                                        SEE.Pin.BlockerPiece = 0;
                                    }
                                }
                                If (((SEE.Pin.OnLine == 1) And ((SEE.Pin.AttackerPiece * SEE.Pin.BlockerPiece) < 0)) And (Not ((SEE.Pin.Walk == SEE.TargetIdx))))
                                {
                                    Call IsCheckingPiece(SEE.Pin.Walk);
                                    If (Ret.IsCheckingPiece.IsChecking == 1)
                                    {
                                        SEE.Pin.IsPinned = 1;
                                    }
                                }
                                List.ReplaceItem(Board, SEE.SourceIdx, SEE.Pin.AttackerPiece);
                            }
                        }
                    }
                    If (SEE.Pin.IsPinned == 0)
                    {
                        List.Add(CalcMovesMoveList, SEE.SourceIdx);
                        List.Add(CalcMovesScoreList, (0 - abs(SEE.SourcePiece)));
                    }
                }
            }
            SEE.SourceIdx += 1;
        }
        If (List.Length(CalcMovesMoveList) == 0)
        {
            SEE.IsDone = 1;
        }
        Else
        {
            If ((Const.MaxPlyStackFrames % 2) == 1)
            {
                Call SortMoveList(((Const.MaxPlyStackFrames + 1) - SEE.Side));
            }
            Else
            {
                Call SortMoveList((Const.MaxPlyStackFrames - SEE.Side));
            }
            SEE.SourceIdx = CalcMovesMoveList[1];
            SEE.Move = ((SEE.SourceIdx * 100) + SEE.TargetIdx);
            SEE.Ply += 1;
            Call ClearMoveList(SEE.Ply);
            Call AddMoveToList(SEE.Move)(SEE.Ply)(0);
            List.ReplaceItem(MovesIdx, SEE.Ply, 1);
            Call ApplyMoveLight(SEE.Ply);
            If (abs(TargetPieces[SEE.Ply]) == GoK_BlackKing)
            {
                SEE.IsDone = 1;
            }
            Else
            {
                Glob.Stats.MoveCountQuiescence += 1;
                If (SEE.Side == 1)
                {
                    SEE.Side = 2;
                }
                Else
                {
                    SEE.Side = 1;
                }
            }
        }
    }
    SEE.RunningGain = 0;
    Repeat Until (SEE.Ply == MovePly)
    {
        SEE.GainIfCapture = (abs(TargetPieces[SEE.Ply]) - SEE.RunningGain);
        If (SEE.GainIfCapture > 0)
        {
            SEE.RunningGain = SEE.GainIfCapture;
        }
        Else
        {
            SEE.RunningGain = 0;
        }
        Call RevertMoveLight(SEE.Ply);
        SEE.Ply += -1;
    }
    SEE.SwapValue = (abs(TargetPieces[MovePly]) - SEE.RunningGain);
    Ret.SEE.Gain = SEE.SwapValue;
    List.DeleteAll(CalcMovesMoveList);
    List.DeleteAll(CalcMovesScoreList);
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList4))
    {
        List.Add(CalcMovesMoveList, SEE.TmpList4[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList5))
    {
        List.Add(CalcMovesScoreList, SEE.TmpList5[SEE.Idx]);
        SEE.Idx += 1;
    }
}

Define SetCastlingStateFlag(string Ply)(string Offset)(string Val) (warp=true)
{
    If (CastlingState[Ply] == Const.Null)
    {
        Stop(this script);
    }
    SetCastlingStateFlag.CastlingState = CastlingState[Ply];
    If (Not ((CastlingBit[((8 * SetCastlingStateFlag.CastlingState) + Offset)] == Val)))
    {
        If (Val == 1)
        {
            List.ReplaceItem(CastlingState, Ply, (SetCastlingStateFlag.CastlingState + CastlingStatePow2[(Offset + 0)]));
        }
        Else
        {
            List.ReplaceItem(CastlingState, Ply, (SetCastlingStateFlag.CastlingState - CastlingStatePow2[(Offset + 0)]));
        }
    }
}

Define SetInitialEP(string Ply) (warp=true)
{
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    If (List.Length(GameMoves) > 0)
    {
        SetInitialEP.SourceIdx = floor((GameMoves[List.Length(GameMoves)] / 100));
        SetInitialEP.TargetIdx = floor((GameMoves[List.Length(GameMoves)] % 100));
        If (SetInitialEP.SourceIdx > 0)
        {
            If ((abs(Board[SetInitialEP.TargetIdx]) == GoK_BlackPawn) And (abs((SetInitialEP.TargetIdx - SetInitialEP.SourceIdx)) == 16))
            {
                SetInitialEP.IsEnemyPawnAdjacent = 0;
                If ((IdxToFile[SetInitialEP.TargetIdx] > 1) And (Board[(SetInitialEP.TargetIdx - 1)] == (0 - Board[SetInitialEP.TargetIdx])))
                {
                    SetInitialEP.IsEnemyPawnAdjacent = 1;
                }
                If ((IdxToFile[SetInitialEP.TargetIdx] < 8) And (Board[(SetInitialEP.TargetIdx + 1)] == (0 - Board[SetInitialEP.TargetIdx])))
                {
                    SetInitialEP.IsEnemyPawnAdjacent = 1;
                }
                If (SetInitialEP.IsEnemyPawnAdjacent == 1)
                {
                    List.ReplaceItem(EnPassantTarget, Ply, SetInitialEP.TargetIdx);
                }
            }
        }
    }
}

Define SortList (warp=true)
{
    If (List.Length(CalcMovesScoreList) > 1)
    {
        Call QuickSort;
    }
}

Define SortMoveList(string Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
        SortMoveList.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.Add(Moves1, CalcMovesMoveList[SortMoveList.Idx]);
            SortMoveList.Idx += 1;
        }
        Call SortList;
        SortMoveList.Idx = 1;
        SortMoveList.MoveCount = List.Length(CalcMovesMoveList);
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, SortMoveList.Idx, CalcMovesMoveList[SortMoveList.Idx]);
            List.ReplaceItem(MovesScore, SortMoveList.Idx, CalcMovesScoreList[SortMoveList.Idx]);
            List.ReplaceItem(Moves1, SortMoveList.Idx, CalcMovesMoveList[SortMoveList.Idx]);
            SortMoveList.Idx += 1;
            SortMoveList.MoveCount += -1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        SortMoveList.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(CalcMovesMoveList, SortMoveList.Idx, Moves[SortMoveList.Idx]);
            List.ReplaceItem(CalcMovesScoreList, SortMoveList.Idx, MovesScore[SortMoveList.Idx]);
            SortMoveList.Idx += 1;
        }
        Stop(this script);
    }
    If (Ply == 2)
    {
        Call SortList;
        SortMoveList.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SortMoveList.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SortMoveList.MoveCount + SortMoveList.Idx), CalcMovesMoveList[SortMoveList.Idx]);
            List.ReplaceItem(MovesScore, (SortMoveList.MoveCount + SortMoveList.Idx), CalcMovesScoreList[SortMoveList.Idx]);
            List.Add(Moves2, CalcMovesMoveList[SortMoveList.Idx]);
            SortMoveList.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        Stop(this script);
    }
    If (PlyIsOwn[Ply] == 1)
    {
        Call SortList;
        SortMoveList.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SortMoveList.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SortMoveList.MoveCount + SortMoveList.Idx), CalcMovesMoveList[SortMoveList.Idx]);
            List.ReplaceItem(MovesScore, (SortMoveList.MoveCount + SortMoveList.Idx), CalcMovesScoreList[SortMoveList.Idx]);
            SortMoveList.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        SortMoveList.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SortMoveList.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(CalcMovesMoveList, SortMoveList.Idx, Moves[(SortMoveList.MoveCount + SortMoveList.Idx)]);
            List.ReplaceItem(CalcMovesScoreList, SortMoveList.Idx, MovesScore[(SortMoveList.MoveCount + SortMoveList.Idx)]);
            SortMoveList.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
    }
    Else
    {
        Call SortList;
        SortMoveList.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SortMoveList.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SortMoveList.MoveCount + SortMoveList.Idx), CalcMovesMoveList[SortMoveList.Idx]);
            List.ReplaceItem(MovesScore, (SortMoveList.MoveCount + SortMoveList.Idx), CalcMovesScoreList[SortMoveList.Idx]);
            SortMoveList.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
    }
}

Define StoreAttackInfo(string Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 0)
    {
        If (1 == 0)
        {
            StoreAttackInfo.Packed = "";
            StoreAttackInfo.PackedPieces = "";
            StoreAttackInfo.SqIdx = 1;
            Repeat (16)
            {
                StoreAttackInfo.Packed = Operator.Join(StoreAttackInfo.Packed, MoveToZeroPaddedStr[((((BoardAttackedByBlack[StoreAttackInfo.SqIdx] * 1000) + (BoardAttackedByBlack[(StoreAttackInfo.SqIdx + 1)] * 100)) + ((BoardAttackedByBlack[(StoreAttackInfo.SqIdx + 2)] * 10) + BoardAttackedByBlack[(StoreAttackInfo.SqIdx + 3)])) + 1)]);
                StoreAttackInfo.PackedPieces = Operator.Join(StoreAttackInfo.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByBlackPiece[StoreAttackInfo.SqIdx] * 100) + BoardAttackedByBlackPiece[(StoreAttackInfo.SqIdx + 1)]) + 1)]);
                StoreAttackInfo.PackedPieces = Operator.Join(StoreAttackInfo.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByBlackPiece[(StoreAttackInfo.SqIdx + 2)] * 100) + BoardAttackedByBlackPiece[(StoreAttackInfo.SqIdx + 3)]) + 1)]);
                StoreAttackInfo.SqIdx += 4;
            }
        }
        StoreAttackInfo.SqIdx = 1;
        StoreAttackInfo.SliceStart = (((Ply - 1) * Const.SnapshotPlyStride) + 1);
        Repeat (64)
        {
            List.ReplaceItem(BoardAttackedByOpponentSnapshot, StoreAttackInfo.SliceStart, BoardAttackedByBlack[StoreAttackInfo.SqIdx]);
            List.ReplaceItem(BoardAttackedByOpponentPieceSnapshot, StoreAttackInfo.SliceStart, BoardAttackedByBlackPiece[StoreAttackInfo.SqIdx]);
            StoreAttackInfo.SqIdx += 1;
            StoreAttackInfo.SliceStart += 1;
        }
        StoreAttackInfo.IsChecked = Glob.Board.IsWhiteChecked;
    }
    Else
    {
        If (1 == 0)
        {
            StoreAttackInfo.Packed = "";
            StoreAttackInfo.PackedPieces = "";
            StoreAttackInfo.SqIdx = 1;
            Repeat (16)
            {
                StoreAttackInfo.Packed = Operator.Join(StoreAttackInfo.Packed, MoveToZeroPaddedStr[((((BoardAttackedByWhite[StoreAttackInfo.SqIdx] * 1000) + (BoardAttackedByWhite[(StoreAttackInfo.SqIdx + 1)] * 100)) + ((BoardAttackedByWhite[(StoreAttackInfo.SqIdx + 2)] * 10) + BoardAttackedByWhite[(StoreAttackInfo.SqIdx + 3)])) + 1)]);
                StoreAttackInfo.PackedPieces = Operator.Join(StoreAttackInfo.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByWhitePiece[StoreAttackInfo.SqIdx] * 100) + BoardAttackedByWhitePiece[(StoreAttackInfo.SqIdx + 1)]) + 1)]);
                StoreAttackInfo.PackedPieces = Operator.Join(StoreAttackInfo.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByWhitePiece[(StoreAttackInfo.SqIdx + 2)] * 100) + BoardAttackedByWhitePiece[(StoreAttackInfo.SqIdx + 3)]) + 1)]);
                StoreAttackInfo.SqIdx += 4;
            }
        }
        StoreAttackInfo.SqIdx = 1;
        StoreAttackInfo.SliceStart = (((Ply - 1) * Const.SnapshotPlyStride) + 1);
        Repeat (64)
        {
            List.ReplaceItem(BoardAttackedByOpponentSnapshot, StoreAttackInfo.SliceStart, BoardAttackedByWhite[StoreAttackInfo.SqIdx]);
            List.ReplaceItem(BoardAttackedByOpponentPieceSnapshot, StoreAttackInfo.SliceStart, BoardAttackedByWhitePiece[StoreAttackInfo.SqIdx]);
            StoreAttackInfo.SqIdx += 1;
            StoreAttackInfo.SliceStart += 1;
        }
        StoreAttackInfo.IsChecked = Glob.Board.IsBlackChecked;
    }
    List.ReplaceItem(CheckedState, Ply, StoreAttackInfo.IsChecked);
    Call TTStoreNode(Glob.Board.CurrentHash)(Ply)(Const.Null)(Const.Null)(Const.TTType.None)(Const.Null)(Const.Null)(Const.Null);
}

Define StoreExternalBoard (warp=true)
{
    List.DeleteAll(GoK_Board);
    StoreExternalBoard.SqIdx = 1;
    Repeat (64)
    {
        If (Glob.Game.IsPlayerBlack == 1)
        {
            List.Add(GoK_Board, (0 - Board[RankFlipIdx[StoreExternalBoard.SqIdx]]));
        }
        Else
        {
            List.Add(GoK_Board, Board[StoreExternalBoard.SqIdx]);
        }
        StoreExternalBoard.SqIdx += 1;
    }
}

Define StoreKillerMove(string Ply)(string Move)(string Horizon)(bool Malus)(bool ContinuationOnly)(bool QuietOk) (warp=true)
{
    StoreKillerMove.FromIdx = floor((Move / 100));
    StoreKillerMove.ToIdx = floor((Move % 100));
    StoreKillerMove.UnclampedHistoryBonus = ((190 * Horizon) - 108);
    StoreKillerMove.HistoryBonus = ((((StoreKillerMove.UnclampedHistoryBonus + 1596) - abs((StoreKillerMove.UnclampedHistoryBonus - 1596))) / 2) * (1 - (2 * Malus)));
    If ((StoreKillerMove.FromIdx == 0) And QuietOk)
    {
        If ((((Move == GoK_BlackKingsideCastling) Or (Move == GoK_BlackQueensideCastling)) Or (Move == GoK_WhiteKingsideCastling)) Or (Move == GoK_WhiteQueensideCastling))
        {
            If ((Move == 65) Or (Move == 66))
            {
                StoreKillerMove.CastleFrom = 5;
            }
            Else
            {
                StoreKillerMove.CastleFrom = 61;
            }
            If (Move == 65)
            {
                StoreKillerMove.CastleTo = 8;
            }
            Else
            {
                If (Move == 66)
                {
                    StoreKillerMove.CastleTo = 1;
                }
                Else
                {
                    If (Move == 67)
                    {
                        StoreKillerMove.CastleTo = 64;
                    }
                    Else
                    {
                        StoreKillerMove.CastleTo = 57;
                    }
                }
            }
            If (Not (ContinuationOnly))
            {
                StoreKillerMove.HistoryMoveScoreIdx = (PlyHistoryBaseIdx[Ply] + ((StoreKillerMove.CastleFrom * 64) + StoreKillerMove.CastleTo));
                List.ReplaceItem(HistoryMoveScores, StoreKillerMove.HistoryMoveScoreIdx, (HistoryMoveScores[StoreKillerMove.HistoryMoveScoreIdx] + (StoreKillerMove.HistoryBonus - floor((HistoryMoveScores[StoreKillerMove.HistoryMoveScoreIdx] * (abs(StoreKillerMove.HistoryBonus) / 7183))))));
            }
            If ((Not (ContinuationOnly)) And (Not (Malus)))
            {
                StoreKillerMove.KillerSlot = (((Ply - 1) * 2) + 1);
                If (Not (((Not ((KillerMoves[StoreKillerMove.KillerSlot] == Const.Null))) And (KillerMoves[StoreKillerMove.KillerSlot] == Move))))
                {
                    List.ReplaceItem(KillerMoves, (StoreKillerMove.KillerSlot + 1), KillerMoves[StoreKillerMove.KillerSlot]);
                    List.ReplaceItem(KillerMoves, StoreKillerMove.KillerSlot, Move);
                }
                If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
    }
    If QuietOk
    {
        If (Not (ContinuationOnly))
        {
            StoreKillerMove.KillerSlot = (((Ply - 1) * 2) + 1);
            If ((Not (Malus)) And (Not (((Not ((KillerMoves[StoreKillerMove.KillerSlot] == Const.Null))) And (KillerMoves[StoreKillerMove.KillerSlot] == Move)))))
            {
                List.ReplaceItem(KillerMoves, (StoreKillerMove.KillerSlot + 1), KillerMoves[StoreKillerMove.KillerSlot]);
                List.ReplaceItem(KillerMoves, StoreKillerMove.KillerSlot, Move);
            }
            If (Not ((StoreKillerMove.FromIdx == 0)))
            {
                StoreKillerMove.HistoryMoveScoreIdx = (PlyHistoryBaseIdx[Ply] + ((StoreKillerMove.FromIdx * 64) + StoreKillerMove.ToIdx));
                List.ReplaceItem(HistoryMoveScores, StoreKillerMove.HistoryMoveScoreIdx, (HistoryMoveScores[StoreKillerMove.HistoryMoveScoreIdx] + (StoreKillerMove.HistoryBonus - floor((HistoryMoveScores[StoreKillerMove.HistoryMoveScoreIdx] * (abs(StoreKillerMove.HistoryBonus) / 7183))))));
                Call ProbePawnHist(Board[StoreKillerMove.FromIdx])(StoreKillerMove.ToIdx)(Glob.Board.KPHash);
                List.ReplaceItem(HistoryPawnHist, Ret.ProbePawnHist.Idx, (HistoryPawnHist[Ret.ProbePawnHist.Idx] + ((StoreKillerMove.HistoryBonus / 2) - floor((HistoryPawnHist[Ret.ProbePawnHist.Idx] * (abs((StoreKillerMove.HistoryBonus / 2)) / 8192))))));
            }
            If (Not (Malus))
            {
                If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
        If (StoreKillerMove.FromIdx == 0)
        {
            StoreKillerMove.KillerSlot = ((PieceIdxLookup[GoK_BlackKing] * 68) + StoreKillerMove.CastleTo);
        }
        Else
        {
            StoreKillerMove.KillerSlot = ((PieceIdxLookup[abs(Board[StoreKillerMove.FromIdx])] * 68) + StoreKillerMove.ToIdx);
        }
        StoreKillerMove.HistoryMoveScoreIdx = -1;
        If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
        {
            StoreKillerMove.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + StoreKillerMove.KillerSlot);
        }
        If (Not ((StoreKillerMove.HistoryMoveScoreIdx == -1)))
        {
            List.ReplaceItem(HistoryContinuation, (PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx), (HistoryContinuation[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] + (StoreKillerMove.HistoryBonus - floor((HistoryContinuation[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] * (abs(StoreKillerMove.HistoryBonus) / 29952))))));
        }
        If (Ply > 2)
        {
            If (Not ((AppliedMove[(Ply - 2)] == 0)))
            {
                StoreKillerMove.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + StoreKillerMove.KillerSlot);
                List.ReplaceItem(HistoryContinuation2, (PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx), (HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] + (StoreKillerMove.HistoryBonus - floor((HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] * (abs(StoreKillerMove.HistoryBonus) / 29952))))));
            }
            If (((Ply > 4) And (CheckedState[Ply] == 0)) And (Not ((AppliedMove[(Ply - 4)] == 0))))
            {
                StoreKillerMove.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + StoreKillerMove.KillerSlot);
                List.ReplaceItem(HistoryContinuation3, (PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx), (HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] + ((StoreKillerMove.HistoryBonus / 1) - floor((HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] * (abs((StoreKillerMove.HistoryBonus / 1)) / 29952))))));
            }
            If (((Ply > 6) And (CheckedState[Ply] == 0)) And (Not ((AppliedMove[(Ply - 6)] == 0))))
            {
                StoreKillerMove.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + StoreKillerMove.KillerSlot);
                List.ReplaceItem(HistoryContinuation4, (PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx), (HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] + (StoreKillerMove.HistoryBonus - floor((HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + StoreKillerMove.HistoryMoveScoreIdx)] * (abs(StoreKillerMove.HistoryBonus) / 29952))))));
            }
        }
    }
    If (Not ((StoreKillerMove.FromIdx == 0)))
    {
        StoreKillerMove.CapturedPiece = Board[StoreKillerMove.ToIdx];
        If ((StoreKillerMove.CapturedPiece == 0) And ((abs(Board[StoreKillerMove.FromIdx]) == GoK_BlackPawn) And (Not ((IdxToFile[StoreKillerMove.FromIdx] == IdxToFile[StoreKillerMove.ToIdx])))))
        {
            StoreKillerMove.CapturedPiece = (0 - Board[StoreKillerMove.FromIdx]);
        }
        If ((Not ((StoreKillerMove.FromIdx == 0))) And (Not ((StoreKillerMove.CapturedPiece == 0))))
        {
            StoreKillerMove.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(Board[StoreKillerMove.FromIdx])] - 1) * 384) + (((PieceIdxLookup[abs(StoreKillerMove.CapturedPiece)] - 1) * 64) + StoreKillerMove.ToIdx)) + (2304 * (Board[StoreKillerMove.FromIdx] < 0)));
            List.ReplaceItem(HistoryCaptureScores, StoreKillerMove.HistoryMoveScoreIdx, (HistoryCaptureScores[StoreKillerMove.HistoryMoveScoreIdx] + (StoreKillerMove.HistoryBonus - floor(((HistoryCaptureScores[StoreKillerMove.HistoryMoveScoreIdx] * abs(StoreKillerMove.HistoryBonus)) / 10692)))));
        }
    }
}

Define TestLog(string TestLogTxt0)(string TestLogTxt1)(string TestLogTxt2)(string TestLogTxt3)(string TestLogTxt4)(string TestLogTxt5)(string TestLogTxt6)(string TestLogTxt7) (warp=true)
{
    List.Add(Logfile, Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join("", TestLogTxt0), TestLogTxt1), TestLogTxt2), TestLogTxt3), TestLogTxt4), TestLogTxt5), TestLogTxt6), TestLogTxt7));
}

Define TestPad(string TestPadText)(string TestPadWidth) (warp=true)
{
    Ret.TestPad.PaddedText = TestPadText;
    Repeat Until (Not ((Variable.Length(Ret.TestPad.PaddedText) < TestPadWidth)))
    {
        Ret.TestPad.PaddedText = Operator.Join(Ret.TestPad.PaddedText, " ");
    }
}

Define TestPerft(string TestPerftPly) (warp=false)
{
    If (Not ((TestPerftPly > 0)))
    {
        Stop(this script);
    }
    Glob.Config.IsTestRunning = 1;
    Glob.Config.IsDCI = 1;
    Call InitTestSuite;
    TestPerft.PassedCount = 0;
    Glob.Stats.PerftCheckMismatches = 0;
    TestPerft.SearchCount = (List.Length(PerftSuiteFens) * TestPerftPly);
    Call TestLog("=== perft core vs staged movegen, depth 1 to ")(TestPerftPly)("")("")("")("")("")("");
    TestPerft.Row = "";
    Call TestPad("Perft")(10);
    TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Core")(10);
    TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Staged")(10);
    TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
    TestPerft.Row = Operator.Join(TestPerft.Row, "FEN");
    Call TestLog(TestPerft.Row)("")("")("")("")("")("")("");
    TestPerft.PosIdx = 1;
    Repeat (List.Length(PerftSuiteFens))
    {
        _dci fen = PerftSuiteFens[TestPerft.PosIdx];
        _dci think time = 1;
        Call $gok_prepare;
        Call SearchWrp;
        TestPerft.HorizonIdx = 1;
        Repeat (TestPerftPly)
        {
            Glob.Stats.PerftNodes = 0;
            Call Perft(1)(TestPerft.HorizonIdx)(0);
            TestPerft.CoreNodes = Glob.Stats.PerftNodes;
            Glob.Stats.PerftNodes = 0;
            Call Perft(1)(TestPerft.HorizonIdx)(1);
            If ((TestPerft.CoreNodes == PerftSuiteCounts[(((TestPerft.PosIdx - 1) * 4) + TestPerft.HorizonIdx)]) And (Glob.Stats.PerftNodes == PerftSuiteCounts[(((TestPerft.PosIdx - 1) * 4) + TestPerft.HorizonIdx)]))
            {
                TestPerft.PassedCount += 1;
                TestPerft.ResultTxt = "ok";
            }
            Else
            {
                TestPerft.ResultTxt = "failed";
            }
            TestPerft.Row = "";
            Call TestPad(Operator.Join(Operator.Join(TestPerft.PosIdx, " / d="), TestPerft.HorizonIdx))(10);
            TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestPerft.ResultTxt)(9);
            TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
            Call TestPad(PerftSuiteCounts[(((TestPerft.PosIdx - 1) * 4) + TestPerft.HorizonIdx)])(10);
            TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestPerft.CoreNodes)(10);
            TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
            Call TestPad(Glob.Stats.PerftNodes)(10);
            TestPerft.Row = Operator.Join(TestPerft.Row, Ret.TestPad.PaddedText);
            TestPerft.Row = Operator.Join(TestPerft.Row, PerftSuiteFens[TestPerft.PosIdx]);
            Call TestLog(TestPerft.Row)("")("")("")("")("")("")("");
            TestPerft.HorizonIdx += 1;
        }
        TestPerft.PosIdx += 1;
    }
    Call TestLog("=== ")(TestPerft.PassedCount)(" / ")(TestPerft.SearchCount)(" successful perft runs")("")("")("");
    Call TestLog("check-detection mismatches: ")(Glob.Stats.PerftCheckMismatches)("")("")("")("")("")("");
    Glob.Config.IsDCI = 0;
    Glob.Config.IsTestRunning = 0;
}

Define TestSearch(string SearchFen)(string SearchThinkTime) (warp=false)
{
    _dci fen = SearchFen;
    _dci think time = SearchThinkTime;
    Call $gok_prepare;
    Call SearchWrp;
    Ret.TestSearch.Move = Ret.SearchWrp.Move;
}

Define TestSuite(string TestCount)(string TestThinkTime) (warp=false)
{
    If (Not ((TestCount > 0)))
    {
        Stop(this script);
    }
    Glob.Config.IsTestRunning = 1;
    Glob.Config.IsDCI = 1;
    Call InitTestSuite;
    TestSuite.PassedCount = 0;
    TestSuite.SearchCount = TestCount;
    Call TestLog("=== search, ")(TestSuite.SearchCount)(" positions at ")(TestThinkTime)("s each")("")("")("");
    TestSuite.Row = "";
    Call TestPad("Test#")(10);
    TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
    Call TestPad("Return")(9);
    TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
    TestSuite.Row = Operator.Join(TestSuite.Row, "FEN");
    Call TestLog(TestSuite.Row)("")("")("")("")("")("")("");
    TestSuite.PosIdx = 1;
    Repeat (TestSuite.SearchCount)
    {
        Call TestSearch(TestSuiteFEN[TestSuite.PosIdx])(TestThinkTime);
        Call GetMoveNotation(Ret.TestSearch.Move);
        TestSuite.ReturnedNotation = Ret.GetMoveNotation.Notation;
        TestSuite.SlotHit = 0;
        TestSuite.SlotIdx = 1;
        Repeat (5)
        {
            If (TestSuite.ReturnedNotation == TestSuiteAN[(((TestSuite.PosIdx - 1) * 5) + TestSuite.SlotIdx)])
            {
                TestSuite.SlotHit = 1;
            }
            TestSuite.SlotIdx += 1;
        }
        If (TestSuite.SlotHit == 1)
        {
            TestSuite.PassedCount += 1;
            TestSuite.Row = "";
            Call TestPad(TestSuite.PosIdx)(10);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            Call TestPad("ok")(9);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteAN[(((TestSuite.PosIdx - 1) * 5) + 1)])(10);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuite.ReturnedNotation)(9);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            TestSuite.Row = Operator.Join(TestSuite.Row, TestSuiteFEN[TestSuite.PosIdx]);
            Call TestLog(TestSuite.Row)("")("")("")("")("")("")("");
        }
        Else
        {
            TestSuite.Row = "";
            Call TestPad(TestSuite.PosIdx)(10);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            Call TestPad("failed")(9);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteAN[(((TestSuite.PosIdx - 1) * 5) + 1)])(10);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuite.ReturnedNotation)(9);
            TestSuite.Row = Operator.Join(TestSuite.Row, Ret.TestPad.PaddedText);
            TestSuite.Row = Operator.Join(TestSuite.Row, TestSuiteFEN[TestSuite.PosIdx]);
            Call TestLog(TestSuite.Row)("")("")("")("")("")("")("");
        }
        TestSuite.PosIdx += 1;
    }
    Call TestLog("=== ")(TestSuite.PassedCount)(" / ")(TestSuite.SearchCount)(" successful tests")("")("")("");
    Glob.Config.IsDCI = 0;
    Glob.Config.IsTestRunning = 0;
}

Define TTCheckResize (warp=true)
{
    Call //("Double the TT (TurboWarp only, up to 4M entries, 2M in DCI with two engines per page) when the current search reached hashfull 400; called from TTStoreNode every 50000 stores, before the store picks its slot");
    If (Glob.Config.IsScratch3 == 0)
    {
        If (List.Length(TTNodeEntry) < ((4194304 / (1 + Glob.Config.IsDCI)) * Const.TTNodeEntrySize))
        {
            Call GetHashfull(Glob.TT.CurrentAge);
            If (Ret.GetHashfull.Permill > 399)
            {
                Call ResizeTT;
            }
        }
    }
}

Define TTFindSlot(string NodeHash) (warp=true)
{
    TTFindSlot.Bucket = (((NodeHash % floor((List.Length(TTNodeEntry) / (Const.TTNodeEntrySize * 4)))) * (Const.TTNodeEntrySize * 4)) + 1);
    TTFindSlot.Key = (NodeHash % 1073741824);
    Ret.TTFindSlot.Found = 0;
    Ret.TTFindSlot.Slot = Const.Null;
    TTFindSlot.EvictionSlot = Const.Null;
    TTFindSlot.Idx = 0;
    Repeat Until ((Not ((Ret.TTFindSlot.Slot == Const.Null))) Or (TTFindSlot.Idx == 4))
    {
        TTFindSlot.Hash = TTNodeEntry[(TTFindSlot.Bucket + Const.TTNodeCol.HashIdx)];
        If (TTFindSlot.Hash == Const.Null)
        {
            Ret.TTFindSlot.Slot = TTFindSlot.Bucket;
        }
        Else
        {
            If (TTFindSlot.Hash == TTFindSlot.Key)
            {
                Ret.TTFindSlot.Slot = TTFindSlot.Bucket;
                Ret.TTFindSlot.Found = 1;
            }
            Else
            {
                TTFindSlot.Meta = TTNodeEntry[(TTFindSlot.Bucket + Const.TTNodeCol.MetaIdx)];
                If ((TTFindSlot.Meta % 256) == 0)
                {
                    TTFindSlot.EntryValue = Const.Null;
                }
                Else
                {
                    TTFindSlot.EntryValue = (((TTFindSlot.Meta % 256) - 8) - ((Glob.TT.CurrentAge - floor((TTFindSlot.Meta / 16384))) % 131072));
                }
                If ((TTFindSlot.EvictionSlot == Const.Null) Or ((Not ((TTFindSlot.EvictionSlotValue == Const.Null))) And ((TTFindSlot.EntryValue == Const.Null) Or (TTFindSlot.EntryValue < TTFindSlot.EvictionSlotValue))))
                {
                    TTFindSlot.EvictionSlotValue = TTFindSlot.EntryValue;
                    TTFindSlot.EvictionSlot = TTFindSlot.Bucket;
                }
                TTFindSlot.Bucket += Const.TTNodeEntrySize;
            }
        }
        TTFindSlot.Idx += 1;
    }
    If (Ret.TTFindSlot.Slot == Const.Null)
    {
        Ret.TTFindSlot.Slot = TTFindSlot.EvictionSlot;
    }
}

Define TTProbeNode(string BoardHash)(string Ply) (warp=true)
{
    Call GetTTNodeHash(BoardHash)(Ply);
    TTProbeNode.NodeHash = Ret.GetTTNodeHash.Hash;
    Call TTFindSlot(TTProbeNode.NodeHash);
    TTProbeNode.HashBucket = Ret.TTFindSlot.Slot;
    TTProbeNode.ProbeFound = Ret.TTFindSlot.Found;
    List.ReplaceItem(TTSlot, Ply, TTProbeNode.HashBucket);
    List.ReplaceItem(TTSlotHash, Ply, TTProbeNode.NodeHash);
    If (TTProbeNode.ProbeFound == 0)
    {
        Ret.TTProbeNode.Hit = 0;
        Ret.TTProbeNode.IsPv = 0;
        Stop(this script);
    }
    Ret.TTProbeNode.Hit = 1;
    Ret.TTProbeNode.BestMove = TTNodeEntry[(TTProbeNode.HashBucket + Const.TTNodeCol.BestMoveIdx)];
    If (Not ((Ret.TTProbeNode.BestMove == Const.Null)))
    {
        Ret.TTProbeNode.BestMove = (Ret.TTProbeNode.BestMove / 10);
    }
    Ret.TTProbeNode.Score = TTNodeEntry[(TTProbeNode.HashBucket + Const.TTNodeCol.ScoreIdx)];
    If (Not ((Ret.TTProbeNode.Score == Const.Null)))
    {
        TTProbeNode.GamePly = List.Length(BoardHistoryFiftyMoves);
        If (Ret.TTProbeNode.Score > Const.AbsMinCheckmateEval)
        {
            Ret.TTProbeNode.Score = (Ret.TTProbeNode.Score - TTProbeNode.GamePly);
        }
        If (Ret.TTProbeNode.Score < (0 - Const.AbsMinCheckmateEval))
        {
            Ret.TTProbeNode.Score = (Ret.TTProbeNode.Score + TTProbeNode.GamePly);
        }
        TTProbeNode.Rule50 = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
        If (abs(Ret.TTProbeNode.Score) > Const.AbsMinCheckmateEval)
        {
            If (((100000 - abs(Ret.TTProbeNode.Score)) - TTProbeNode.GamePly) > (99 - TTProbeNode.Rule50))
            {
                Ret.TTProbeNode.Score = ((Const.AbsMinCheckmateEval - 1) * ((Ret.TTProbeNode.Score > 0) - (Ret.TTProbeNode.Score < 0)));
            }
        }
    }
    TTProbeNode.Meta = TTNodeEntry[(TTProbeNode.HashBucket + Const.TTNodeCol.MetaIdx)];
    Ret.TTProbeNode.IsPv = (floor((TTProbeNode.Meta / 8192)) % 2);
    Ret.TTProbeNode.Type = (floor((TTProbeNode.Meta / 256)) % 8);
    If (Ret.TTProbeNode.Type == 0)
    {
        Ret.TTProbeNode.Type = Const.Null;
    }
    Ret.TTProbeNode.Horizon = ((TTProbeNode.Meta % 256) - 8);
    If (Ret.TTProbeNode.Horizon == -8)
    {
        Ret.TTProbeNode.Horizon = Const.Null;
    }
    Ret.TTProbeNode.QSMeta = ((floor((TTProbeNode.Meta / 2048)) % 4) - 1);
    If (Ret.TTProbeNode.QSMeta == -1)
    {
        Ret.TTProbeNode.QSMeta = Const.Null;
    }
    Ret.TTProbeNode.StaticEval = TTNodeEntry[(TTProbeNode.HashBucket + Const.TTNodeCol.StaticEvalIdx)];
    List.ReplaceItem(TTNodeEntry, (TTProbeNode.HashBucket + Const.TTNodeCol.MetaIdx), ((TTProbeNode.Meta % 16384) + (16384 * (Glob.TT.CurrentAge % 131072))));
}

Define TTProbeNodeAtPly(string Ply) (warp=true)
{
    List.ReplaceItem(NodeTTScore, Ply, Const.Null);
    List.ReplaceItem(NodeTTType, Ply, Const.Null);
    List.ReplaceItem(NodeTTHorizon, Ply, Const.Null);
    List.ReplaceItem(NodeTTQSMeta, Ply, Const.Null);
    List.ReplaceItem(NodeTTMove, Ply, Const.Null);
    List.ReplaceItem(NodeTTStaticEval, Ply, Const.Null);
    Call TTProbeNode(Glob.Board.CurrentHash)(Ply);
    List.ReplaceItem(NodeTTHit, Ply, Ret.TTProbeNode.Hit);
    List.ReplaceItem(IsTTPv, Ply, IsPvNode[Ply]);
    If ((Ret.TTProbeNode.Hit == 1) And (Ret.TTProbeNode.IsPv == 1))
    {
        List.ReplaceItem(IsTTPv, Ply, 1);
    }
    If (Ret.TTProbeNode.Hit == 1)
    {
        List.ReplaceItem(NodeTTScore, Ply, Ret.TTProbeNode.Score);
        List.ReplaceItem(NodeTTType, Ply, Ret.TTProbeNode.Type);
        List.ReplaceItem(NodeTTHorizon, Ply, Ret.TTProbeNode.Horizon);
        List.ReplaceItem(NodeTTQSMeta, Ply, Ret.TTProbeNode.QSMeta);
        List.ReplaceItem(NodeTTMove, Ply, Ret.TTProbeNode.BestMove);
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.TTProbeNode.StaticEval);
    }
}

Define TTResetSlots (warp=true)
{
    TTResetSlots.Idx = 1;
    Repeat (List.Length(TTSlotHash))
    {
        List.ReplaceItem(TTSlotHash, TTResetSlots.Idx, Const.Null);
        TTResetSlots.Idx += 1;
    }
}

Define TTStoreNode(string BoardHash)(string Ply)(string Score)(string BestMove)(string Type)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    If (Glob.Search.IsTimeout == 1)
    {
        Stop(this script);
    }
    If (1 == 0)
    {
        Stop(this script);
    }
    Glob.Stats.TTStoreCount += 1;
    If (Glob.Stats.TTStoreCount > Glob.Search.TTCheckNext)
    {
        Glob.Search.TTCheckNext = (Glob.Stats.TTStoreCount + 50000);
        Call TTCheckResize;
    }
    Call GetTTNodeHash(BoardHash)(Ply);
    TTStoreNode.Score = Score;
    If (Not ((Score == Const.Null)))
    {
        TTStoreNode.GamePly = List.Length(BoardHistoryFiftyMoves);
        If (Score > Const.AbsMinCheckmateEval)
        {
            TTStoreNode.Score = (Score + TTStoreNode.GamePly);
        }
        If (Score < (0 - Const.AbsMinCheckmateEval))
        {
            TTStoreNode.Score = (Score - TTStoreNode.GamePly);
        }
    }
    Call TTStoreNodeImpl(Ret.GetTTNodeHash.Hash)(Ply)(TTStoreNode.Score)(BestMove)(Type)(Horizon)(QSMeta)(StaticEval);
}

Define TTStoreNodeImpl(string NodeHash)(string Ply)(string Score)(string BestMove)(string Type)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    If (TTSlotHash[Ply] == NodeHash)
    {
        TTStoreNodeImpl.HashBucket = TTSlot[Ply];
    }
    Else
    {
        Call TTFindSlot(NodeHash);
        TTStoreNodeImpl.HashBucket = Ret.TTFindSlot.Slot;
    }
    TTStoreNodeImpl.UpdateIdx = Const.Null;
    If (TTNodeEntry[(TTStoreNodeImpl.HashBucket + Const.TTNodeCol.HashIdx)] == (NodeHash % 1073741824))
    {
        TTStoreNodeImpl.UpdateIdx = TTStoreNodeImpl.HashBucket;
    }
    If (Not ((TTStoreNodeImpl.UpdateIdx == Const.Null)))
    {
        If (Not ((StaticEval == Const.Null)))
        {
            List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.StaticEvalIdx), StaticEval);
        }
        TTStoreNodeImpl.Meta = TTNodeEntry[(TTStoreNodeImpl.HashBucket + Const.TTNodeCol.MetaIdx)];
        TTStoreNodeImpl.StoredHorizon = ((TTStoreNodeImpl.Meta % 256) - 8);
        If (TTStoreNodeImpl.StoredHorizon == -8)
        {
            TTStoreNodeImpl.StoredHorizon = Const.Null;
        }
        TTStoreNodeImpl.PV = 0;
        If (IsTTPv[Ply] == 1)
        {
            TTStoreNodeImpl.PV = 1;
        }
        TTStoreNodeImpl.IsReplace = 0;
        If (Type == Const.TTType.Exact)
        {
            TTStoreNodeImpl.IsReplace = 1;
        }
        Else
        {
            If (TTStoreNodeImpl.StoredHorizon == -1)
            {
                TTStoreNodeImpl.IsReplace = 1;
            }
            Else
            {
                If (TTStoreNodeImpl.StoredHorizon == Const.Null)
                {
                    TTStoreNodeImpl.IsReplace = 1;
                }
                Else
                {
                    If (Not ((((Horizon + 3) + (2 * TTStoreNodeImpl.PV)) < TTStoreNodeImpl.StoredHorizon)))
                    {
                        TTStoreNodeImpl.IsReplace = 1;
                    }
                }
            }
        }
        If ((Not ((Score == Const.Null))) And (Not ((Horizon == Const.Null))))
        {
            If (TTStoreNodeImpl.IsReplace == 1)
            {
                TTStoreNodeImpl.HC = 0;
                If (Not ((Horizon == Const.Null)))
                {
                    TTStoreNodeImpl.HC = (Horizon + 8);
                }
                TTStoreNodeImpl.TC = 0;
                If (Not ((Type == Const.Null)))
                {
                    TTStoreNodeImpl.TC = Type;
                }
                TTStoreNodeImpl.QC = 0;
                If (Not ((QSMeta == Const.Null)))
                {
                    TTStoreNodeImpl.QC = (QSMeta + 1);
                }
                List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.MetaIdx), (TTStoreNodeImpl.HC + (256 * (TTStoreNodeImpl.TC + (8 * (TTStoreNodeImpl.QC + (4 * (TTStoreNodeImpl.PV + (2 * (Glob.TT.CurrentAge % 131072))))))))));
                List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.ScoreIdx), Score);
            }
        }
        If (Not ((BestMove == Const.Null)))
        {
            List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.BestMoveIdx), Operator.Round((BestMove * 10)));
        }
    }
    Else
    {
        If (BestMove == Const.Null)
        {
            List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.BestMoveIdx), BestMove);
        }
        Else
        {
            List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.BestMoveIdx), Operator.Round((BestMove * 10)));
        }
        List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.StaticEvalIdx), StaticEval);
        List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.HashIdx), (NodeHash % 1073741824));
        TTStoreNodeImpl.HC = 0;
        If (Not ((Horizon == Const.Null)))
        {
            TTStoreNodeImpl.HC = (Horizon + 8);
        }
        TTStoreNodeImpl.TC = 0;
        If (Not ((Type == Const.Null)))
        {
            TTStoreNodeImpl.TC = Type;
        }
        TTStoreNodeImpl.QC = 0;
        If (Not ((QSMeta == Const.Null)))
        {
            TTStoreNodeImpl.QC = (QSMeta + 1);
        }
        TTStoreNodeImpl.PV = 0;
        If (IsTTPv[Ply] == 1)
        {
            TTStoreNodeImpl.PV = 1;
        }
        List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.MetaIdx), (TTStoreNodeImpl.HC + (256 * (TTStoreNodeImpl.TC + (8 * (TTStoreNodeImpl.QC + (4 * (TTStoreNodeImpl.PV + (2 * (Glob.TT.CurrentAge % 131072))))))))));
        List.ReplaceItem(TTNodeEntry, (TTStoreNodeImpl.HashBucket + Const.TTNodeCol.ScoreIdx), Score);
    }
}

Define UI.FormatPV (warp=true)
{
    UI.FormatPV.Len = Variable.Length(Ret.Search.PV);
    UI.FormatPV.Cut = UI.FormatPV.Len;
    If (UI.FormatPV.Len > 104)
    {
        UI.FormatPV.Cut = 0;
        UI.FormatPV.Idx = 1;
        Repeat (105)
        {
            If (Operator.LetterOf(Ret.Search.PV, UI.FormatPV.Idx) == " ")
            {
                UI.FormatPV.Cut = (UI.FormatPV.Idx - 1);
            }
            UI.FormatPV.Idx += 1;
        }
    }
    Glob.UI.PV = "";
    UI.FormatPV.Idx = 1;
    Repeat (UI.FormatPV.Cut)
    {
        Glob.UI.PV = Operator.Join(Glob.UI.PV, Operator.LetterOf(Ret.Search.PV, UI.FormatPV.Idx));
        UI.FormatPV.Idx += 1;
    }
}

Define UndoMove (warp=false)
{
    Call EnterExecution;
    If ((Glob.Game.IsInUndo == 0) And (List.Length(GameMovesAN) > 1))
    {
        Glob.Game.IsInUndo = 1;
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("Stg_FromSquareSelected");
        Event.BroadcastAndWait("Stg_ToSquareSelected");
        Call UndoPrevMove;
        If (BoardHistoryWasEngineMove[List.Length(BoardHistoryWasEngineMove)] == 0)
        {
            Call UndoPrevMove;
        }
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        Glob.Game.IsInUndo = 0;
    }
    Call ExitExecution;
}

Define UndoPrevMove (warp=false)
{
    If (List.Length(GameMovesAN) > 0)
    {
        List.DeleteItem(BoardHistory, List.Length(BoardHistory));
        List.DeleteItem(BoardHistoryHash, List.Length(BoardHistoryHash));
        List.DeleteItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState));
        List.DeleteItem(BoardHistoryWasEngineMove, List.Length(BoardHistoryWasEngineMove));
        List.DeleteItem(GameMovesAN, List.Length(GameMovesAN));
        Call ImportBoardImpl(BoardHistory[List.Length(BoardHistory)]);
        List.DeleteItem(GameMoves, List.Length(GameMoves));
        Glob.Board.HasBlackCastled = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 1)];
        Glob.Board.HasBlackKingMoved = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 2)];
        Glob.Board.HasBlackRookKSMoved = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 3)];
        Glob.Board.HasBlackRookQSMoved = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 4)];
        Glob.Board.HasWhiteCastled = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 5)];
        Glob.Board.HasWhiteKingMoved = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 6)];
        Glob.Board.HasWhiteRookKSMoved = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 7)];
        Glob.Board.HasWhiteRookQSMoved = CastlingBit[((8 * BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]) + 8)];
        Call CalcBoardStats;
    }
}

Define UpdateMoveHashPosEval(string Piece)(string SourceIdx)(string TargetIdx)(bool PosScoreUpdate)(string Ply) (warp=true)
{
    Call GetPiecePosHash(Piece)(SourceIdx);
    Glob.Board.CurrentHash = (Glob.Board.CurrentHash - Ret.GetPiecePosHash.Hash);
    If (Not ((abs(Piece) == GoK_BlackPawn)))
    {
        If (Piece > 0)
        {
            Glob.Board.NonPawnHashBlack = (Glob.Board.NonPawnHashBlack - Ret.GetPiecePosHash.Hash);
        }
        Else
        {
            Glob.Board.NonPawnHashWhite = (Glob.Board.NonPawnHashWhite - Ret.GetPiecePosHash.Hash);
        }
    }
    If ((abs(Piece) == GoK_BlackPawn) Or (abs(Piece) == GoK_BlackKing))
    {
        Glob.Board.KPHash = (Glob.Board.KPHash - Ret.GetPiecePosHash.Hash);
    }
    Call GetPiecePosHash(Piece)(TargetIdx);
    Glob.Board.CurrentHash = (Glob.Board.CurrentHash + Ret.GetPiecePosHash.Hash);
    If (Not ((abs(Piece) == GoK_BlackPawn)))
    {
        If (Piece > 0)
        {
            Glob.Board.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
        }
        Else
        {
            Glob.Board.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
        }
    }
    If ((abs(Piece) == GoK_BlackPawn) Or (abs(Piece) == GoK_BlackKing))
    {
        Glob.Board.KPHash = (Glob.Board.KPHash + Ret.GetPiecePosHash.Hash);
    }
}

Define UpdateMoveNotationPV (warp=true)
{
    Ret.Search.PV = "";
    UpdateMoveNotationPV.PVIdx = 2;
    Repeat (PV[1])
    {
        Ret.Search.PV = Operator.Join(Operator.Join(Ret.Search.PV, PV[UpdateMoveNotationPV.PVIdx]), " ");
        UpdateMoveNotationPV.PVIdx += 1;
    }
    If (PV[1] > 0)
    {
        Glob.UI.Move = Operator.Join("", PV[2]);
    }
    Else
    {
        Glob.UI.Move = 0;
    }
    Call UI.FormatPV;
}

Define UpdateNNUEPostApplyMove(string Ply) (warp=true)
{
    Call NNUE_OnApplyMoveDone(Ply)(AppliedMove[Ply])(SourcePieces[Ply])(TargetPieces[Ply])(PromotionPieces[Ply])(TargetPiecesIdx[Ply]);
}

Define UpdatePV(string Ply)(string BestMove) (warp=true)
{
    If (IsPvNode[Ply] == 0)
    {
        Stop(this script);
    }
    If (Glob.Search.IsInNullMove > 0)
    {
        Stop(this script);
    }
    UpdatePV.Idx = (((Ply - 1) * Const.MaxPlyStackFrames) + 1);
    UpdatePV.PVSliceStart = ((Ply * Const.MaxPlyStackFrames) + 1);
    UpdatePV.PVLength = PV[UpdatePV.PVSliceStart];
    List.ReplaceItem(PV, UpdatePV.Idx, (UpdatePV.PVLength + 1));
    List.ReplaceItem(PVRaw, UpdatePV.Idx, (UpdatePV.PVLength + 1));
    Call GetMoveNotation(BestMove);
    List.ReplaceItem(PV, (UpdatePV.Idx + 1), Ret.GetMoveNotation.Notation);
    List.ReplaceItem(PVRaw, (UpdatePV.Idx + 1), BestMove);
    UpdatePV.Idx += 2;
    UpdatePV.PVSliceStart += 1;
    Repeat (UpdatePV.PVLength)
    {
        List.ReplaceItem(PV, UpdatePV.Idx, PV[UpdatePV.PVSliceStart]);
        List.ReplaceItem(PVRaw, UpdatePV.Idx, PVRaw[UpdatePV.PVSliceStart]);
        UpdatePV.Idx += 1;
        UpdatePV.PVSliceStart += 1;
    }
    If (Ply == 1)
    {
        If ((PV[1] > 1) Or (1 == 1))
        {
            Call UpdateMoveNotationPV;
            List.DeleteAll(PVStable);
            UpdatePV.Idx = 2;
            Repeat (PVRaw[1])
            {
                List.Add(PVStable, PVRaw[UpdatePV.Idx]);
                UpdatePV.Idx += 1;
            }
        }
    }
}

