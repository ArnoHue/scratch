Define InitMoveLookup (warp=true)
{
    List.DeleteItem(KnightMoveOffsets, all);
    List.DeleteItem(KingMoveOffsets, all);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 1);
    List.DeleteItem(MoveSlidingStraightListIdxToTargetIdx, all);
    List.DeleteItem(MoveCrossListIdxToTargetIdx, all);
    List.DeleteItem(MoveSlidingStraighOffsetIdxToDelta, all);
    List.DeleteItem(MoveCrossOffsetIdxToDelta, all);
    List.DeleteItem(MoveListOffsetToTargetIdxKnight, all);
    List.DeleteItem(MoveListOffsetToTargetIdxKing, all);
    List.DeleteItem(MoveSourceIdxToListOffsetNonSliding, all);
    List.DeleteItem(MoveSourceIdxToListOffsetSliding, all);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 1);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 1);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, -1);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, 0);
    List.Add(MoveSlidingStraighOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, 1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    List.Add(MoveCrossOffsetIdxToDelta, -1);
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        InitMoveLookup.ToSqIdx = 1;
        Repeat (4)
        {
            InitMoveLookup.File = IdxToFile[InitMoveLookup.FromSqIdx];
            InitMoveLookup.Rank = IdxToRank[InitMoveLookup.FromSqIdx];
            Repeat (8)
            {
                InitMoveLookup.File += MoveSlidingStraighOffsetIdxToDelta[InitMoveLookup.ToSqIdx];
                InitMoveLookup.Rank += MoveSlidingStraighOffsetIdxToDelta[(InitMoveLookup.ToSqIdx + 1)];
                List.Add(MoveSlidingStraightListIdxToTargetIdx, -1);
                If ((InitMoveLookup.Rank > 0) And (InitMoveLookup.Rank < 9))
                {
                    If ((InitMoveLookup.File > 0) And (InitMoveLookup.File < 9))
                    {
                        InitMoveLookup.TargetIdx = (InitMoveLookup.File + ((InitMoveLookup.Rank - 1) * 8));
                        List.ReplaceItem(MoveSlidingStraightListIdxToTargetIdx, List.Length(MoveSlidingStraightListIdxToTargetIdx), InitMoveLookup.TargetIdx);
                    }
                }
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        InitMoveLookup.ToSqIdx = 1;
        Repeat (4)
        {
            InitMoveLookup.File = IdxToFile[InitMoveLookup.FromSqIdx];
            InitMoveLookup.Rank = IdxToRank[InitMoveLookup.FromSqIdx];
            Repeat (8)
            {
                InitMoveLookup.File += MoveCrossOffsetIdxToDelta[InitMoveLookup.ToSqIdx];
                InitMoveLookup.Rank += MoveCrossOffsetIdxToDelta[(InitMoveLookup.ToSqIdx + 1)];
                List.Add(MoveCrossListIdxToTargetIdx, -1);
                If ((InitMoveLookup.Rank > 0) And (InitMoveLookup.Rank < 9))
                {
                    If ((InitMoveLookup.File > 0) And (InitMoveLookup.File < 9))
                    {
                        InitMoveLookup.TargetIdx = (InitMoveLookup.File + ((InitMoveLookup.Rank - 1) * 8));
                        List.ReplaceItem(MoveCrossListIdxToTargetIdx, List.Length(MoveCrossListIdxToTargetIdx), InitMoveLookup.TargetIdx);
                    }
                }
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        InitMoveLookup.FromSqIdx += 1;
    }
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        List.Add(MoveSourceIdxToListOffsetNonSliding, ((InitMoveLookup.FromSqIdx - 1) * 8));
        List.Add(MoveSourceIdxToListOffsetSliding, ((InitMoveLookup.FromSqIdx - 1) * 32));
        InitMoveLookup.FromSqIdx += 1;
    }
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        InitMoveLookup.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(InitMoveLookup.FromSqIdx)(KingMoveOffsets[InitMoveLookup.ToSqIdx])(KingMoveOffsets[(InitMoveLookup.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveListOffsetToTargetIdxKing, Ret.GetTargetIdx.SqIdx);
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveListOffsetToTargetIdxKing) == (InitMoveLookup.FromSqIdx * 8))
        {
            List.Add(MoveListOffsetToTargetIdxKing, -1);
        }
        InitMoveLookup.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(InitMoveLookup.FromSqIdx)(KnightMoveOffsets[InitMoveLookup.ToSqIdx])(KnightMoveOffsets[(InitMoveLookup.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveListOffsetToTargetIdxKnight, Ret.GetTargetIdx.SqIdx);
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveListOffsetToTargetIdxKnight) == (InitMoveLookup.FromSqIdx * 8))
        {
            List.Add(MoveListOffsetToTargetIdxKnight, -1);
        }
        InitMoveLookup.FromSqIdx += 1;
    }
    List.DeleteItem(MoveToPathDelta, all);
    List.DeleteItem(MoveToPathStepInc, all);
    List.DeleteItem(MoveToZeroPaddedStr, all);
    InitMoveLookup.FromSqIdx = 0;
    Repeat (10000)
    {
        If (InitMoveLookup.FromSqIdx < 10)
        {
            List.Add(MoveToZeroPaddedStr, Operator.Join(000, InitMoveLookup.FromSqIdx));
        }
        Else
        {
            If (InitMoveLookup.FromSqIdx < 100)
            {
                List.Add(MoveToZeroPaddedStr, Operator.Join(00, InitMoveLookup.FromSqIdx));
            }
            Else
            {
                If (InitMoveLookup.FromSqIdx < 1000)
                {
                    List.Add(MoveToZeroPaddedStr, Operator.Join(0, InitMoveLookup.FromSqIdx));
                }
                Else
                {
                    List.Add(MoveToZeroPaddedStr, InitMoveLookup.FromSqIdx);
                }
            }
        }
        InitMoveLookup.FromSqIdx += 1;
    }
    Repeat (10000)
    {
        List.Add(MoveToPathDelta, 0);
        List.Add(MoveToPathStepInc, 0);
    }
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        InitMoveLookup.ToSqIdx = 1;
        Repeat (64)
        {
            InitMoveLookup.FileDelta = (IdxToFile[InitMoveLookup.ToSqIdx] - IdxToFile[InitMoveLookup.FromSqIdx]);
            InitMoveLookup.RankDelta = (IdxToRank[InitMoveLookup.ToSqIdx] - IdxToRank[InitMoveLookup.FromSqIdx]);
            If ((Not ((InitMoveLookup.FromSqIdx == InitMoveLookup.ToSqIdx))) And (((InitMoveLookup.FileDelta == 0) Or (InitMoveLookup.RankDelta == 0)) Or (abs(InitMoveLookup.FileDelta) == abs(InitMoveLookup.RankDelta))))
            {
                If (abs(InitMoveLookup.FileDelta) > abs(InitMoveLookup.RankDelta))
                {
                    InitMoveLookup.Delta = abs(InitMoveLookup.FileDelta);
                }
                Else
                {
                    InitMoveLookup.Delta = abs(InitMoveLookup.RankDelta);
                }
                List.ReplaceItem(MoveToPathDelta, ((InitMoveLookup.FromSqIdx * 100) + InitMoveLookup.ToSqIdx), InitMoveLookup.Delta);
                List.ReplaceItem(MoveToPathStepInc, ((InitMoveLookup.FromSqIdx * 100) + InitMoveLookup.ToSqIdx), ((8 * (InitMoveLookup.RankDelta / InitMoveLookup.Delta)) + (InitMoveLookup.FileDelta / InitMoveLookup.Delta)));
            }
            InitMoveLookup.ToSqIdx += 1;
        }
        InitMoveLookup.FromSqIdx += 1;
    }
}

Define InitMovePosLookup(bool Init) (warp=true)
{
    If (Glob.Eval.IsClassicEndgame == 0)
    {
        InitMovePosLookup.MetaState = "AI";
    }
    Else
    {
        InitMovePosLookup.MetaState = "HCE";
    }
    If (Init Or (Not ((InitMovePosLookup.MetaState == InitMovePosLookup.PrevMetaState))))
    {
        InitMovePosLookup.PrevMetaState = InitMovePosLookup.MetaState;
        If (Not (Init))
        {
            If (1 == 1)
            {
                InitMovePosLookup.MoveIdx = 1;
                Repeat (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)))
                {
                    List.ReplaceItem(TTNodeEntry, (InitMovePosLookup.MoveIdx + Const.TTNodeCol.StaticEvalIdx), Const.Null);
                    List.ReplaceItem(TTNodeEntry, (InitMovePosLookup.MoveIdx + Const.TTNodeCol.ScoreIdx), Const.Null);
                    If (Not ((TTNodeEntry[(InitMovePosLookup.MoveIdx + Const.TTNodeCol.MetaIdx)] == Const.Null)))
                    {
                        List.ReplaceItem(TTNodeEntry, (InitMovePosLookup.MoveIdx + Const.TTNodeCol.MetaIdx), ((TTNodeEntry[(InitMovePosLookup.MoveIdx + Const.TTNodeCol.MetaIdx)] - (256 * (floor((TTNodeEntry[(InitMovePosLookup.MoveIdx + Const.TTNodeCol.MetaIdx)] / 256)) % 8))) + (256 * Const.TTType.None)));
                    }
                    InitMovePosLookup.MoveIdx += Const.TTNodeEntrySize;
                }
            }
        }
        If (Not ((List.Length(MoveToHash) == 140000)))
        {
            List.DeleteAll(MoveToHash);
            Repeat (140000)
            {
                List.Add(MoveToHash, 0);
            }
        }
        List.DeleteAll(Pieces);
        List.Add(Pieces, GoK_BlackKing);
        List.Add(Pieces, GoK_BlackQueen);
        List.Add(Pieces, GoK_BlackRook);
        List.Add(Pieces, GoK_BlackBishop);
        List.Add(Pieces, GoK_BlackKnight);
        List.Add(Pieces, GoK_BlackPawn);
        List.Add(Pieces, GoK_WhiteKing);
        List.Add(Pieces, GoK_WhiteQueen);
        List.Add(Pieces, GoK_WhiteRook);
        List.Add(Pieces, GoK_WhiteBishop);
        List.Add(Pieces, GoK_WhiteKnight);
        List.Add(Pieces, GoK_WhitePawn);
        InitMovePosLookup.PieceListIdx = 1;
        Repeat (List.Length(Pieces))
        {
            InitMovePosLookup.SourcePiece = Pieces[InitMovePosLookup.PieceListIdx];
            InitMovePosLookup.SlidingKind = 0;
            If (abs(InitMovePosLookup.SourcePiece) == GoK_BlackBishop)
            {
                InitMovePosLookup.SlidingKind = 1;
            }
            If (abs(InitMovePosLookup.SourcePiece) == GoK_BlackRook)
            {
                InitMovePosLookup.SlidingKind = 2;
            }
            If (abs(InitMovePosLookup.SourcePiece) == GoK_BlackQueen)
            {
                InitMovePosLookup.SlidingKind = 3;
            }
            InitMovePosLookup.SourceIdx = 0;
            Repeat (65)
            {
                If (InitMovePosLookup.SourceIdx > 0)
                {
                    InitMovePosLookup.File = IdxToFile[InitMovePosLookup.SourceIdx];
                    InitMovePosLookup.Rank = IdxToRank[InitMovePosLookup.SourceIdx];
                }
                Else
                {
                    InitMovePosLookup.File = 0;
                    InitMovePosLookup.Rank = 0;
                }
                Call GetPiecePosHash(InitMovePosLookup.SourcePiece)(InitMovePosLookup.SourceIdx);
                InitMovePosLookup.SavedPiecePosHash = Ret.GetPiecePosHash.Hash;
                InitMovePosLookup.TargetIdx = 0;
                Repeat (65)
                {
                    InitMovePosLookup.IsLegalMove = 0;
                    If (((Not ((InitMovePosLookup.SourceIdx == 0))) And (Not ((InitMovePosLookup.TargetIdx == 0)))) And (Not ((InitMovePosLookup.SourceIdx == InitMovePosLookup.TargetIdx))))
                    {
                        InitMovePosLookup.FileDeltaAbs = abs((IdxToFile[InitMovePosLookup.TargetIdx] - InitMovePosLookup.File));
                        InitMovePosLookup.RankDeltaAbs = abs((IdxToRank[InitMovePosLookup.TargetIdx] - InitMovePosLookup.Rank));
                        If (InitMovePosLookup.SlidingKind == 0)
                        {
                            If (((InitMovePosLookup.FileDeltaAbs < 2) And (InitMovePosLookup.RankDeltaAbs < 3)) Or ((InitMovePosLookup.FileDeltaAbs < 3) And (InitMovePosLookup.RankDeltaAbs < 2)))
                            {
                                If (InitMovePosLookup.SourcePiece == GoK_BlackPawn)
                                {
                                    If (((IdxToRank[InitMovePosLookup.TargetIdx] - InitMovePosLookup.Rank) == 1) And (InitMovePosLookup.FileDeltaAbs < 2))
                                    {
                                        InitMovePosLookup.IsLegalMove = 1;
                                    }
                                    Else
                                    {
                                        If ((InitMovePosLookup.Rank == 2) And ((InitMovePosLookup.TargetIdx - InitMovePosLookup.SourceIdx) == 16))
                                        {
                                            InitMovePosLookup.IsLegalMove = 1;
                                        }
                                    }
                                }
                                Else
                                {
                                    If (InitMovePosLookup.SourcePiece == GoK_WhitePawn)
                                    {
                                        If (((IdxToRank[InitMovePosLookup.TargetIdx] - InitMovePosLookup.Rank) == -1) And (InitMovePosLookup.FileDeltaAbs < 2))
                                        {
                                            InitMovePosLookup.IsLegalMove = 1;
                                        }
                                        Else
                                        {
                                            If ((InitMovePosLookup.Rank == 7) And ((InitMovePosLookup.TargetIdx - InitMovePosLookup.SourceIdx) == -16))
                                            {
                                                InitMovePosLookup.IsLegalMove = 1;
                                            }
                                        }
                                    }
                                    Else
                                    {
                                        If (abs(InitMovePosLookup.SourcePiece) == GoK_BlackKing)
                                        {
                                            If (((InitMovePosLookup.FileDeltaAbs == 1) And (InitMovePosLookup.RankDeltaAbs < 2)) Or ((InitMovePosLookup.RankDeltaAbs == 1) And (InitMovePosLookup.FileDeltaAbs < 2)))
                                            {
                                                InitMovePosLookup.IsLegalMove = 1;
                                            }
                                        }
                                        Else
                                        {
                                            If (abs(InitMovePosLookup.SourcePiece) == GoK_BlackKnight)
                                            {
                                                If (((InitMovePosLookup.FileDeltaAbs == 1) And (InitMovePosLookup.RankDeltaAbs == 2)) Or ((InitMovePosLookup.FileDeltaAbs == 2) And (InitMovePosLookup.RankDeltaAbs == 1)))
                                                {
                                                    InitMovePosLookup.IsLegalMove = 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Else
                        {
                            If ((InitMovePosLookup.FileDeltaAbs == 0) Or (InitMovePosLookup.RankDeltaAbs == 0))
                            {
                                If (InitMovePosLookup.SlidingKind > 1)
                                {
                                    InitMovePosLookup.IsLegalMove = 1;
                                }
                            }
                            Else
                            {
                                If (InitMovePosLookup.FileDeltaAbs == InitMovePosLookup.RankDeltaAbs)
                                {
                                    If (Not ((InitMovePosLookup.SlidingKind == 2)))
                                    {
                                        InitMovePosLookup.IsLegalMove = 1;
                                    }
                                }
                            }
                        }
                    }
                    If ((InitMovePosLookup.IsLegalMove == 1) Or ((InitMovePosLookup.SourceIdx == 0) Or (InitMovePosLookup.TargetIdx == 0)))
                    {
                        Call GetPiecePosHash(InitMovePosLookup.SourcePiece)(InitMovePosLookup.TargetIdx);
                        InitMovePosLookup.MoveIdx = ((PieceIdxLookup[abs(InitMovePosLookup.SourcePiece)] * 10000) + ((InitMovePosLookup.SourceIdx * 100) + InitMovePosLookup.TargetIdx));
                        If (InitMovePosLookup.SourcePiece > 0)
                        {
                            InitMovePosLookup.MoveIdx += 60000;
                        }
                        List.ReplaceItem(MoveToHash, InitMovePosLookup.MoveIdx, (Ret.GetPiecePosHash.Hash - InitMovePosLookup.SavedPiecePosHash));
                    }
                    InitMovePosLookup.TargetIdx += 1;
                }
                InitMovePosLookup.SourceIdx += 1;
            }
            InitMovePosLookup.PieceListIdx += 1;
        }
    }
}

