//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Glob.Game.IsStarted = 0;
    Glob.Config.VersionString = "Game of Kings Chess NNUE Version 7.3383.2861 (07.11.2026) by ArnoHu";
    Glob.Config.IsTestRunning = 0;
    Glob.Config.IsDCI = 0;
    Glob.NNUE.IsNetworkDecoded = 0;
    Glob.Config.Level = 3;
    GoK_Level = 3;
    GoK_ClockActive = 0;
    If is compiled?
    {
        Glob.Config.IsScratch3 = 0;
    }
    Else
    {
        Glob.Config.IsScratch3 = 1;
    }
    Call OnRestart;
}


//----- Key pressed events --------------------------------------------------------------------------------------------

WhenKeyPressed(l)
{
    If (Glob.Game.IsStarted == 0)
    {
        Stop(this script);
    }
    List.Show(Logfile);
}

WhenKeyPressed(p)
{
    If (Glob.Game.IsStarted == 0)
    {
        Stop(this script);
    }
    If (Glob.Profile.Mode == Const.ProfilerMode.Off)
    {
        Glob.Profile.Mode = Const.ProfilerMode.Std;
        Call SayAsync("Profiling Standard")(2);
        Call PrepStats;
        Call ProfilerReset;
    }
    Else
    {
        If (Glob.Profile.Mode == Const.ProfilerMode.Std)
        {
            Glob.Profile.Mode = Const.ProfilerMode.Full;
            Call SayAsync("Profiling Full")(2);
        }
        Else
        {
            If (Glob.Profile.Mode == Const.ProfilerMode.Full)
            {
                Glob.Profile.Mode = Const.ProfilerMode.Off;
                Call SayAsync("Profiling Off")(2);
            }
        }
    }
}

WhenKeyPressed(d)
{
    If (Glob.Game.IsStarted == 0)
    {
        Stop(this script);
    }
    If (Glob.Config.DebugMode == 0)
    {
        Glob.Config.DebugMode = 1;
        Variable.Show(Glob.UI.Depth);
        Variable.Show(Glob.UI.Eval);
        Variable.Show(Glob.UI.Move);
        Variable.Show(Glob.UI.NPS);
        Variable.Show(Glob.UI.MPS);
        Variable.Show(Glob.UI.PV);
    }
    Else
    {
        Glob.Config.DebugMode = 0;
        Variable.Hide(Glob.UI.Depth);
        Variable.Hide(Glob.UI.Eval);
        Variable.Hide(Glob.UI.Move);
        Variable.Hide(Glob.UI.NPS);
        Variable.Hide(Glob.UI.MPS);
        Variable.Hide(Glob.UI.PV);
    }
}

WhenKeyPressed(v)
{
    Call SayAsync(Glob.Config.VersionString)(5);
}

WhenKeyPressed(r)
{
    If (Glob.Game.IsStarted == 0)
    {
        Stop(this script);
    }
    List.Show(ProfilingData);
}

WhenKeyPressed(u)
{
    If (Glob.Game.IsStarted == 0)
    {
        Stop(this script);
    }
    List.DeleteAll(Logfile);
    Sensing.Ask("Perft depth? (1 - 4, blank to skip)");
    TST.Ask.PerftPly = Sensing.Answer();
    Sensing.Ask("How many search tests? (1 - 218, blank to skip)");
    TST.Ask.PositionCount = Sensing.Answer();
    Sensing.Ask("Think time per test, in seconds?");
    TST.Ask.ThinkTime = Sensing.Answer();
    List.Show(Logfile);
    Call EnterExecution;
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call TestPerft(TST.Ask.PerftPly);
    Call TestSuite(TST.Ask.PositionCount)(TST.Ask.ThinkTime);
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call DrawBoardAndWait;
    Call ExitExecution;
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived($gok_nnue)
{
    Glob.Config.IsDCI = 1;
    Call ​​log​​("$gok1");
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Call IsOwnKingCheckMate;
    If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
    {
        If (_dci turn == 1)
        {
            _dci evaluation = "-M0";
        }
        Else
        {
            _dci evaluation = "M0";
        }
        Event.BroadcastAndWait("gui refresh stats");
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: invoked on opp mate");
        Stop(this script);
    }
    Else
    {
        DCI.IsClaimAllowed = 1;
        If (Not ((SearchWrp.PrevMoveEval == Const.Null)))
        {
            If (SearchWrp.PrevMoveEval > Const.DrawByRepetitionEval)
            {
                DCI.IsClaimAllowed = 0;
            }
        }
        Call GetRepetitionCount;
        If ((Ret.GetRepetitionCount.Count > 2) And (DCI.IsClaimAllowed == 1))
        {
            List.Add(_dci, "draw?");
            Event.Broadcast("dci message");
            Call ​​warn​​("$gok: invoked on draw-by-rep");
            Stop(this script);
        }
        Else
        {
            Call IsDrawByMaterial;
            If (Ret.IsDrawByMaterial.IsDraw == 1)
            {
                List.Add(_dci, "draw?");
                Event.Broadcast("dci message");
                Call ​​warn​​("$gok: invoked on draw-by-material");
                Stop(this script);
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    List.Add(_dci, "draw?");
                    Event.Broadcast("dci message");
                    Call ​​warn​​("$gok: invoked on draw-by-stalemate");
                    Stop(this script);
                }
            }
        }
    }
    Call ​​log​​("$gok2");
    DCI.Move = Const.Null;
    Call GetOpeningMoves;
    If (List.Length(OpeningMovesRes) > 0)
    {
        DCI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
        Ret.SearchWrp.BestMoveEval = 0;
        If (Ret.SearchWrp.BestMoveEval == Const.Null)
        {
            Glob.UI.Eval = "EV: 0";
        }
        Else
        {
            Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
        }
        Ret.Search.PV = "book";
        Call UI.FormatPV;
        If (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0))
        {
            Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.TimeInc);
            Glob.Clock.MoveCount += 1;
            If ((Glob.Clock.StageMoves > 0) And (Glob.Clock.MoveCount == Glob.Clock.StageMoves))
            {
                Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.StageTime);
            }
        }
    }
    Else
    {
        Call SearchWrp.Prepare;
        Glob.UI.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
        Repeat Until (Ret.SearchWrp.IsDone == 1)
        {
            Call SearchWrp.DCISlice;
            If ((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0))
            {
                Event.Broadcast("gui clock refresh");
            }
        }
        DCI.Move = Ret.SearchWrp.DCI.Move;
    }
    Call ​​log​​("$gok3");
    If (DCI.Move == Const.Null)
    {
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: search system error => resigning");
        Stop(this script);
    }
    Call ​​log​​("$gok4");
    Call ClearMoveList(1);
    Call AddMoveToList((DCI.Move + 0))(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1)((1 == 0));
    Call AddBoardToHistory(1);
    List.ReplaceItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState), CastlingState[1]);
    Call RevertMove(1);
    Call GetMoveNotation(DCI.Move);
    If (Ret.GetMoveNotation.Notation == "O-O")
    {
        If (Glob.Game.IsPlayerBlack == 0)
        {
            List.Add(_dci, "me8g8");
        }
        Else
        {
            List.Add(_dci, "me1g1");
        }
    }
    Else
    {
        If (Ret.GetMoveNotation.Notation == "O-O-O")
        {
            If (Glob.Game.IsPlayerBlack == 0)
            {
                List.Add(_dci, "me8c8");
            }
            Else
            {
                List.Add(_dci, "me1c1");
            }
        }
        Else
        {
            DCI.PromotionCode = Operator.Round(((Ret.GetMoveNotation.VirtualMove * 10) % 10));
            DCI.PromotionLetter = "";
            If (DCI.PromotionCode == 1)
            {
                DCI.PromotionLetter = "q";
            }
            If (DCI.PromotionCode == 2)
            {
                DCI.PromotionLetter = "r";
            }
            If (DCI.PromotionCode == 3)
            {
                DCI.PromotionLetter = "b";
            }
            If (DCI.PromotionCode == 4)
            {
                DCI.PromotionLetter = "n";
            }
            List.Add(_dci, Operator.Join(Operator.Join("m", Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join((9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove % 100))]), (9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove % 100))]))))), DCI.PromotionLetter));
        }
    }
    Call ​​log​​("$gok5");
    If (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0))
    {
        _dci clock = (Operator.Round(((Glob.Clock.CurrentTime + Glob.Clock.TimeInc) * 10)) / 10);
    }
    Else
    {
        _dci clock = "";
    }
    _dci pv = Ret.Search.PV;
    If (Ret.Search.PV == "book")
    {
        _dci search depth = "";
    }
    Else
    {
        _dci search depth = (Glob.Search.IterationIdx - Glob.Search.IsTimeout);
    }
    If (Not ((Ret.SearchWrp.BestMoveEval == Const.Null)))
    {
        DCI.WhiteEval = (Ret.SearchWrp.BestMoveEval * _dci turn);
        If (abs(Ret.SearchWrp.BestMoveEval) > Const.AbsMinCheckmateEval)
        {
            _dci evaluation = Operator.Join("M", ceiling((((100000 - abs(Ret.SearchWrp.BestMoveEval)) - List.Length(BoardHistoryFiftyMoves)) / 2)));
            If (DCI.WhiteEval < 0)
            {
                _dci evaluation = Operator.Join("-", _dci evaluation);
            }
        }
        Else
        {
            _dci evaluation = (DCI.WhiteEval / 100);
        }
    }
    Event.BroadcastAndWait("gui refresh stats");
    Event.Broadcast("dci message");
    Call ​​log​​("$gok6");
}

WhenBroadcastReceived($gok_nnue draw?)
{
    Glob.Config.IsDCI = 1;
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Ret.SearchWrp.BestMoveEval = 0;
    If (Ret.SearchWrp.BestMoveEval == Const.Null)
    {
        Glob.UI.Eval = "EV: 0";
    }
    Else
    {
        Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
    }
    DCI.SavedClockTime = Glob.Clock.CurrentTime;
    DCI.SavedClockMoveCount = Glob.Clock.MoveCount;
    DCI.SavedPrevMoveEval = SearchWrp.PrevMoveEval;
    DCI.SavedAvgCompletedDepth = SearchWrp.AvgCompletedDepth;
    Call SearchWrp.Prepare;
    Glob.UI.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Repeat Until (Ret.SearchWrp.IsDone == 1)
    {
        Call SearchWrp.DCISlice;
    }
    List.DeleteItem(BoardHistory, List.Length(BoardHistory));
    List.DeleteItem(BoardHistoryHash, List.Length(BoardHistoryHash));
    List.DeleteItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState));
    List.DeleteItem(BoardHistoryWasEngineMove, List.Length(BoardHistoryWasEngineMove));
    Glob.Clock.CurrentTime = DCI.SavedClockTime;
    Glob.Clock.MoveCount = DCI.SavedClockMoveCount;
    SearchWrp.PrevMoveEval = DCI.SavedPrevMoveEval;
    SearchWrp.AvgCompletedDepth = DCI.SavedAvgCompletedDepth;
    If (Ret.SearchWrp.BestMoveEval == Const.Null)
    {
        List.Add(_dci, "decline");
    }
    Else
    {
        If (Ret.SearchWrp.BestMoveEval < 0)
        {
            List.Add(_dci, "accept");
        }
        Else
        {
            List.Add(_dci, "decline");
        }
    }
    Event.Broadcast("dci message");
}

WhenBroadcastReceived($gok_nnue stop)
{
    Glob.Config.IsDCI = 1;
    Glob.Search.IsTimeout = 1;
}

WhenBroadcastReceived(dci new game)
{
    Glob.Game.IsPlayerBlack = Const.Null;
    GoK_IsGameSuspended = 0;
    List.DeleteAll(BoardHistory);
    List.DeleteAll(BoardHistoryFiftyMoves);
    List.DeleteAll(BoardHistoryHash);
    List.DeleteAll(BoardHistoryMetaState);
    List.DeleteAll(BoardHistoryWasEngineMove);
    List.DeleteAll(GameMovesAN);
    List.DeleteAll(GameMoves);
    Glob.Clock.CurrentTime = Const.Null;
    Glob.Clock.MoveCount = 0;
    Glob.Config.IsTimeModelLogged = 0;
    SearchWrp.PrevMoveEval = Const.Null;
    SearchWrp.AvgCompletedDepth = Const.Null;
}

WhenBroadcastReceived(dci register)
{
    Glob.Game.IsStarted = 1;
    List.Add(_dci engines, "gok_nnue");
}

WhenBroadcastReceived(GoK_ClockClicked)
{
    Call AskTimeControl;
    If (Ret.AskTimeControl.IsSet == 1)
    {
        GoK_ClockActive = 1;
        Glob.Clock.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
        Glob.Clock.PlayerRunning = 1;
    }
    Else
    {
        Glob.Clock.TimeControl = 0;
        Glob.Config.CustomThinkTime = 0;
        Glob.Config.CustomMaxDepth = 0;
        Glob.Clock.InitialTime = 0;
        Glob.Clock.TimeInc = 0;
        Glob.Clock.StageMoves = 0;
        Glob.Clock.StageTime = 0;
        Glob.Clock.CurrentTime = 0;
        Glob.Clock.MoveCount = 0;
        Glob.Clock.PlayerTime = 0;
        Glob.Clock.PlayerMoveCount = 0;
        Glob.Clock.PlayerRunning = 0;
        GoK_ClockActive = 0;
    }
    Event.Broadcast("GoK_LevelChanged");
}

WhenBroadcastReceived(GoK_LevelChanged)
{
    Glob.Config.Level = GoK_Level;
    Call PublishTimers(0);
    Call DrawBoardAndWait;
}

WhenBroadcastReceived(GoK_StartGame)
{
    Motion.GoToXY(120, 120);
    Glob.Game.ExecutionPly = 0;
    Glob.Game.IsExecutionRunning = 0;
    Glob.Game.IsPlayerBlack = GoK_IsPlayerBlack;
    Call EnterExecution;
    Call InitBoard;
    Call DrawBoardAndWait;
    Looks.Say("Initializing engine, please wait...");
    Control.Wait(0.1);
    Call InitBoardPhase2;
    Control.Wait(0.1);
    Call ExitExecution;
    Call ExecuteInit;
    Looks.Say("");
    Glob.Game.IsStarted = 1;
}

WhenBroadcastReceived(sayasyncmsg)
{
    Looks.Say(Glob.UI.SayAsyncText, Glob.UI.SayAsyncDuration);
}

WhenBroadcastReceived(showmoves)
{
    Call ExportMovesPGN;
    List.DeleteItem(ExportMoves, all);
    List.Add(ExportMoves, Ret.ExportMovesPGN.PGN);
    List.Show(ExportMoves);
    Call SayAsync("You can copy PGN data to the clipboard via Ctrl-C")(5);
}

WhenBroadcastReceived(Stg_FromSquareSelected)
{
    If ((Glob.Config.IsAdvisorEnabled == 1) And (Not ((Stg_FromSquareIdx == -1))))
    {
        Stg_BestMoveFromIdx = Stg_FromSquareIdx;
        List.DeleteAll(Selection_UserMoveTargets);
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            Call GetCurrentMove(2);
            FSS.Move = Ret.GetCurrentMove.Move;
            If (floor((FSS.Move / 100)) == GoK_ScreenIdx[Stg_FromSquareIdx])
            {
                Call ApplyMove(2)((1 == 1));
                Call CalcBoardAttackedByMove(3);
                Call RevertMove(2);
                If (Glob.Board.IsWhiteChecked == 0)
                {
                    List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[floor((FSS.Move % 100))]);
                }
            }
            Else
            {
                If (Board[GoK_ScreenIdx[Stg_FromSquareIdx]] == GoK_WhiteKing)
                {
                    If (FSS.Move == GoK_WhiteKingsideCastling)
                    {
                        List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[63]);
                    }
                    Else
                    {
                        If (FSS.Move == GoK_WhiteQueensideCastling)
                        {
                            List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[59]);
                        }
                    }
                }
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
        Event.BroadcastAndWait("UI_StampUserMoveTargets");
    }
}

WhenBroadcastReceived(Stg_SquareClicked)
{
    If ((Glob.Game.IsExecutionRunning == 0) And (GoK_IsGameSuspended == 0))
    {
        Call EnterExecution;
        If (Board[GoK_ScreenIdx[Stg_SquareClickedIdx]] < 0)
        {
            Glob.Game.MoveFromIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
            Stg_FromSquareIdx = Stg_SquareClickedIdx;
            Event.BroadcastAndWait("Stg_FromSquareSelected");
        }
        Else
        {
            If ((Not ((Glob.Game.MoveFromIdx == -1))) And (Not ((Stg_FromSquareIdx == -1))))
            {
                Glob.Clock.PlayerMoveEnd = (Sensing.DaysSince2000() * 86400);
                Glob.Game.MoveToIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
                Stg_ToSquareIdx = Stg_SquareClickedIdx;
                If ((Board[Glob.Game.MoveFromIdx] < 0) And (Not ((Glob.Game.MoveFromIdx == Glob.Game.MoveToIdx))))
                {
                    Stg_BestMoveFromIdx = Stg_FromSquareIdx;
                    Stg_BestMoveToIdx = Stg_ToSquareIdx;
                    Event.BroadcastAndWait("UI_ShowBestMove");
                }
                Event.BroadcastAndWait("Stg_ToSquareSelected");
                If ((Board[Glob.Game.MoveFromIdx] < 0) And (Not ((Glob.Game.MoveFromIdx == Glob.Game.MoveToIdx))))
                {
                    Glob.Game.UserMove = "";
                    If ((Board[Glob.Game.MoveFromIdx] == GoK_WhiteKing) And (Glob.Game.MoveFromIdx == 61))
                    {
                        If ((Glob.Game.MoveToIdx == 59) And (Board[57] == GoK_WhiteRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_WhiteQueensideCastling)
                            {
                                Glob.Game.UserMove = GoK_WhiteQueensideCastling;
                            }
                            Else
                            {
                                Glob.Game.UserMove = Operator.Join(61, 59);
                            }
                        }
                        If ((Glob.Game.MoveToIdx == 63) And (Board[64] == GoK_WhiteRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_WhiteKingsideCastling)
                            {
                                Glob.Game.UserMove = GoK_WhiteKingsideCastling;
                            }
                            Else
                            {
                                Glob.Game.UserMove = Operator.Join(61, 63);
                            }
                        }
                    }
                    If (Glob.Game.UserMove == "")
                    {
                        Glob.Game.UserMove = ((Glob.Game.MoveFromIdx * 100) + Glob.Game.MoveToIdx);
                        If ((Board[Glob.Game.MoveFromIdx] == GoK_WhitePawn) And (Glob.Game.MoveToIdx < 9))
                        {
                            Glob.Game.UserMove = (Glob.Game.UserMove + 0.1);
                        }
                    }
                    Call ExecuteUserMove(Glob.Game.UserMove);
                }
            }
        }
        Call ExitExecution;
    }
}

WhenBroadcastReceived(Stg_StageClicked)
{
    List.Hide(ExportMoves);
    List.Hide(ExportData);
    List.Hide(CreditsData);
    List.Hide(Logfile);
    List.Hide(ProfilingData);
    If (Glob.Game.IsExecutionRunning == 0)
    {
        Looks.Say("");
    }
}

WhenBroadcastReceived(Stg_TriggerRestart)
{
    Glob.Game.IsStarted = 0;
    Call OnRestart;
}

WhenBroadcastReceived(Timers_PlayerTimeout)
{
    If (((Glob.Game.IsExecutionRunning == 0) And (GoK_IsGameSuspended == 0)) And (((Glob.Clock.TimeControl == 1) And ((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0))) And (Glob.Config.CustomMaxDepth == 0)))
    {
        Looks.Say("Player out of time");
        GoK_IsGameSuspended = 1;
    }
}

WhenBroadcastReceived(UI_AdvisorClicked)
{
    If (Glob.Game.IsExecutionRunning == 0)
    {
        If (Glob.Config.IsAdvisorEnabled == 1)
        {
            Glob.Config.IsAdvisorEnabled = 0;
            Call DrawBoardAndWait;
        }
        Else
        {
            Glob.Config.IsAdvisorEnabled = 1;
            If (Not ((Stg_FromSquareIdx == -1)))
            {
                Event.BroadcastAndWait("Stg_FromSquareSelected");
            }
        }
    }
}

