        NNUE_Evaluate.WordHigh = floor((NNUE_Evaluate.TheirPacked / 67108864));
        NNUE_Evaluate.TheirPacked = (NNUE_Evaluate.TheirPacked - (67108864 * NNUE_Evaluate.WordHigh));
        NNUE_Evaluate.WordMid = floor((NNUE_Evaluate.TheirPacked / 8192));
        NNUE_Evaluate.TheirPacked = (NNUE_Evaluate.TheirPacked - (8192 * NNUE_Evaluate.WordMid));
        NNUE_Evaluate.WordLow = NNUE_Evaluate.TheirPacked;
        NNUE_Evaluate.WordLow += -5600;
        If (NNUE_Evaluate.WordLow > 0)
        {
            If (NNUE_Evaluate.WordLow > 181)
            {
                NNUE_Evaluate.WordLow = 181;
            }
            Ret.NNUE_Evaluate.Score += ((NNUE_Evaluate.WordLow * NNUE_Evaluate.WordLow) * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + ((4 * NNUE_Evaluate.Idx) - 3))]));
        }
        NNUE_Evaluate.WordMid += -5600;
        If (NNUE_Evaluate.WordMid > 0)
        {
            If (NNUE_Evaluate.WordMid > 181)
            {
                NNUE_Evaluate.WordMid = 181;
            }
            Ret.NNUE_Evaluate.Score += ((NNUE_Evaluate.WordMid * NNUE_Evaluate.WordMid) * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + ((4 * NNUE_Evaluate.Idx) - 2))]));
        }
        NNUE_Evaluate.WordHigh += -5600;
        If (NNUE_Evaluate.WordHigh > 0)
        {
            If (NNUE_Evaluate.WordHigh > 181)
            {
                NNUE_Evaluate.WordHigh = 181;
            }
            Ret.NNUE_Evaluate.Score += ((NNUE_Evaluate.WordHigh * NNUE_Evaluate.WordHigh) * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + ((4 * NNUE_Evaluate.Idx) - 1))]));
