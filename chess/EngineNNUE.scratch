//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Glob.IsTestRunning = 0;
    Glob.IsDCI = 0;
    NNUE.DN.IsDecoded = 0;
    Glob.Level = 4;
    GoK_Level = 4;
    If is compiled?
    {
        Glob.IsScratch3 = 0;
    }
    Else
    {
        Glob.IsScratch3 = 1;
    }
    Call OnRestart;
}


//----- Key pressed events --------------------------------------------------------------------------------------------

WhenKeyPressed(l)
{
    If (Glob.DebugMode == -1)
    {
        Stop(this script);
    }
    List.Show(Logfile);
}

WhenKeyPressed(p)
{
    If (Glob.ProfilerMode == -1)
    {
        Stop(this script);
    }
    If (Glob.ProfilerMode == 1)
    {
        Glob.ProfilerMode = 2;
        Call SayAsync("Profiling On")(2);
        Call PrepStats;
        Call ProfilerReset;
    }
    Else
    {
        Call PrintStats;
        Glob.ProfilerMode = 1;
        Call SayAsync("Profiling Off")(2);
    }
}

WhenKeyPressed(d)
{
    If (Glob.DebugMode == -1)
    {
        Stop(this script);
    }
    If (Glob.DebugMode == 0)
    {
        Glob.DebugMode = 1;
        Variable.Show(Glob.IdxDeepening);
        Variable.Show(GBM.Evaluation);
        Variable.Show(GBM.Move);
        Variable.Show(Glob.NPS);
        Variable.Show(Glob.MPS);
        Variable.Show(Glob.PV);
    }
    Else
    {
        Glob.DebugMode = 0;
        Variable.Hide(Glob.IdxDeepening);
        Variable.Hide(GBM.Evaluation);
        Variable.Hide(GBM.Move);
        Variable.Hide(Glob.NPS);
        Variable.Hide(Glob.MPS);
        Variable.Hide(Glob.PV);
    }
}

WhenKeyPressed(v)
{
    Call SayAsync("Game of Kings Chess NNUE Version 7.3383.1750 (21.09.2026) by ArnoHu")(5);
}

WhenKeyPressed(r)
{
    If (Glob.ProfilerMode == -1)
    {
        Stop(this script);
    }
    List.Show(ProfilingData);
}

WhenKeyPressed(t)
{
    If (Glob.TimeControl == -1)
    {
        Stop(this script);
    }
    If (Glob.TimeControl == 0)
    {
        Glob.TimeControl = 1;
        Variable.Show(Glob.CustomThinkTime);
    }
    Else
    {
        Glob.TimeControl = 0;
        Variable.Hide(Glob.CustomThinkTime);
    }
}

WhenKeyPressed(u)
{
    List.DeleteAll(Logfile);
    Sensing.Ask("Perft depth? (1 - 4, blank to skip)");
    TST.AskPerftPly = Sensing.Answer();
    Sensing.Ask("How many search tests? (1 - 218, blank to skip)");
    TST.AskCount = Sensing.Answer();
    Sensing.Ask("Think time per test, in seconds?");
    TST.AskThinkTime = Sensing.Answer();
    List.Show(Logfile);
    Call EnterExecution;
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call TestPerft(TST.AskPerftPly);
    Call TestSuite(TST.AskCount)(TST.AskThinkTime);
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call DrawBoardAndWait;
    Call ExitExecution;
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived($gok_nnue)
{
    Glob.IsDCI = 1;
    Call ​​log​​("$gok1");
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Call IsOwnKingCheckMate;
    If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
    {
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: invoked on opp mate");
        Stop(this script);
    }
    Else
    {
        Call GetRepetitionCount;
        If (Ret.GetRepetitionCount.Count > 2)
        {
            List.Add(_dci, "draw?");
            Event.Broadcast("dci message");
            Call ​​warn​​("$gok: invoked on draw-by-rep");
            Stop(this script);
        }
        Else
        {
            Call IsDrawByMaterial;
            If (Ret.IsDrawByMaterial.IsDraw == 1)
            {
                List.Add(_dci, "draw?");
                Event.Broadcast("dci message");
                Call ​​warn​​("$gok: invoked on draw-by-material");
                Stop(this script);
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    List.Add(_dci, "draw?");
                    Event.Broadcast("dci message");
                    Call ​​warn​​("$gok: invoked on draw-by-stalemate");
                    Stop(this script);
                }
            }
        }
    }
    Call ​​log​​("$gok2");
    DCI.Move = "";
    Call GetOpeningMoves;
    If (List.Length(OpeningMovesRes) > 0)
    {
        DCI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
        GBM.Evaluation = 0;
        Glob.PV = "book";
    }
    Else
    {
        Call GetBestMoveMedDiff;
        DCI.Move = Ret.GetBestMoveMedDiff.Move;
    }
    Call ​​log​​("$gok3");
    If (DCI.Move == "")
    {
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: search system error => resigning");
        Stop(this script);
    }
    Call ​​log​​("$gok4");
    Call ClearMoveList(1);
    Call AddMoveToList(DCI.Move)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1)((1 == 0));
    Call AddBoardToHistory(1);
    List.ReplaceItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState), CastlingState[1]);
    Call RevertMove(1);
    Call GetMoveNotation(DCI.Move);
    If (Ret.GetMoveNotation.Notation == "O-O")
    {
        If (Glob.IsPlayerBlack == 0)
        {
            List.Add(_dci, "me8g8");
        }
        Else
        {
            List.Add(_dci, "me1g1");
        }
    }
    Else
    {
        If (Ret.GetMoveNotation.Notation == "O-O-O")
        {
            If (Glob.IsPlayerBlack == 0)
            {
                List.Add(_dci, "me8c8");
            }
            Else
            {
                List.Add(_dci, "me1c1");
            }
        }
        Else
        {
            DCI.promo = Operator.Round(((Ret.GetMoveNotation.VirtualMove * 10) % 10));
            DCI.promoLetter = "";
            If (DCI.promo == 1)
            {
                DCI.promoLetter = "q";
            }
            If (DCI.promo == 2)
            {
                DCI.promoLetter = "r";
            }
            If (DCI.promo == 3)
            {
                DCI.promoLetter = "b";
            }
            If (DCI.promo == 4)
            {
                DCI.promoLetter = "n";
            }
            List.Add(_dci, Operator.Join(Operator.Join("m", Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join((9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove % 100))]), (9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove % 100))]))))), DCI.promoLetter));
        }
    }
    Call ​​log​​("$gok5");
    _dci pv = Glob.PV;
    If (Glob.PV == "book")
    {
        _dci search depth = "";
    }
    Else
    {
        _dci search depth = (Glob.IdxDeepening - Glob.IsSearchTimeout);
    }
    DCI.evalw = (GBM.Evaluation * _dci turn);
    If (abs(GBM.Evaluation) > Const.AbsMinCheckmateEval)
    {
        _dci evaluation = Operator.Join("M", ceiling((((100000 - abs(GBM.Evaluation)) - List.Length(BoardHistoryFiftyMoves)) / 2)));
        If (DCI.evalw < 0)
        {
            _dci evaluation = Operator.Join("-", _dci evaluation);
        }
    }
    Else
    {
        _dci evaluation = (DCI.evalw / 100);
    }
    Event.BroadcastAndWait("gui refresh stats");
    Event.Broadcast("dci message");
    Call ​​log​​("$gok6");
}

WhenBroadcastReceived($gok_nnue draw?)
{
    Glob.IsDCI = 1;
    Call $gok_prepare;
    GBM.Evaluation = 0;
    Call GetBestMoveMedDiff;
    If (GBM.Evaluation < 0)
    {
        List.Add(_dci, "accept");
    }
    Else
    {
        List.Add(_dci, "decline");
    }
    Event.Broadcast("dci message");
}

WhenBroadcastReceived($gok_nnue stop)
{
    Glob.IsDCI = 1;
    Glob.IsSearchTimeout = 1;
}

WhenBroadcastReceived(dci new game)
{
    Glob.IsPlayerBlack = "";
    GoK_IsGameSuspended = 0;
    List.DeleteAll(BoardHistory);
    List.DeleteAll(BoardHistoryFiftyMoves);
    List.DeleteAll(BoardHistoryHash);
    List.DeleteAll(BoardHistoryMetaState);
    List.DeleteAll(BoardHistoryWasEngineMove);
    List.DeleteAll(GameMovesAN);
    Glob.GameMoves = "";
}

WhenBroadcastReceived(dci register)
{
    List.Add(_dci engines, "gok_nnue");
}

WhenBroadcastReceived(GoK_LevelChanged)
{
    Glob.Level = GoK_Level;
    Call DrawBoardAndWait;
}

WhenBroadcastReceived(GoK_StartGame)
{
    Motion.GoToXY(120, 120);
    Glob.ExecutionPly = 0;
    Glob.IsExecutionRunning = 0;
    Glob.IsPlayerBlack = GoK_IsPlayerBlack;
    Call EnterExecution;
    Call InitBoard;
    Call DrawBoardAndWait;
    Looks.Say("Initializing engine, please wait...");
    Control.Wait(0.1);
    Call InitBoardPhase2;
    Control.Wait(0.1);
    Call ExitExecution;
    Call ExecuteInit;
    Looks.Say("");
}

WhenBroadcastReceived(sayasyncmsg)
{
    Looks.Say(Glob.SayAsyncText, Glob.SayAsyncDuration);
}

WhenBroadcastReceived(showmoves)
{
    Call ExportMovesPGN;
    List.DeleteItem(ExportMoves, all);
    List.Add(ExportMoves, Ret.ExportMovesPGN.PGN);
    List.Show(ExportMoves);
    Call SayAsync("You can copy PGN data to the clipboard via Ctrl-C")(5);
}

WhenBroadcastReceived(Stg_FromSquareSelected)
{
    If ((Glob.IsAdvisorEnabled == 1) And (Not ((Stg_FromSquareIdx == -1))))
    {
        Stg_BestMoveFromIdx = Stg_FromSquareIdx;
        List.DeleteAll(Selection_UserMoveTargets);
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            Call GetCurrentMove(2);
            FSS.Move = Ret.GetCurrentMove.Move;
            If (floor((FSS.Move / 100)) == Stg_FromSquareIdx)
            {
                Call ApplyMove(2)((1 == 1));
                Call CalcBoardAttackedByMove(3);
                Call RevertMove(2);
                If (Glob.IsWhiteChecked == 0)
                {
                    List.Add(Selection_UserMoveTargets, floor((FSS.Move % 100)));
                }
            }
            Else
            {
                If (Board[Stg_FromSquareIdx] == GoK_WhiteKing)
                {
                    If (FSS.Move == GoK_WhiteKingsideCastling)
                    {
                        List.Add(Selection_UserMoveTargets, VirtualBoard[63]);
                    }
                    Else
                    {
                        If (FSS.Move == GoK_WhiteQueensideCastling)
                        {
                            List.Add(Selection_UserMoveTargets, VirtualBoard[59]);
                        }
                    }
                }
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
        Event.BroadcastAndWait("UI_StampUserMoveTargets");
    }
}

WhenBroadcastReceived(Stg_SquareClicked)
{
    If ((Glob.IsExecutionRunning == 0) And (GoK_IsGameSuspended == 0))
    {
        Call EnterExecution;
        If (Board[Stg_SquareClickedIdx] < 0)
        {
            Glob.MoveFromIdx = Stg_SquareClickedIdx;
            Stg_FromSquareIdx = Stg_SquareClickedIdx;
            Event.BroadcastAndWait("Stg_FromSquareSelected");
        }
        Else
        {
            If ((Not ((Glob.MoveFromIdx == -1))) And (Not ((Stg_FromSquareIdx == -1))))
            {
                Glob.MoveToIdx = Stg_SquareClickedIdx;
                Stg_ToSquareIdx = Stg_SquareClickedIdx;
                Event.BroadcastAndWait("Stg_ToSquareSelected");
                If ((Board[Glob.MoveFromIdx] < 0) And (Not ((Glob.MoveFromIdx == Glob.MoveToIdx))))
                {
                    Glob.UserMove = "";
                    If ((Board[Glob.MoveFromIdx] == GoK_WhiteKing) And (Glob.MoveFromIdx == VirtualBoard[61]))
                    {
                        If ((Glob.MoveToIdx == VirtualBoard[59]) And (Board[VirtualBoard[57]] == GoK_WhiteRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_WhiteQueensideCastling)
                            {
                                Glob.UserMove = GoK_WhiteQueensideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(VirtualBoard[61], VirtualBoard[59]);
                            }
                        }
                        If ((Glob.MoveToIdx == VirtualBoard[63]) And (Board[VirtualBoard[64]] == GoK_WhiteRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_WhiteKingsideCastling)
                            {
                                Glob.UserMove = GoK_WhiteKingsideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(VirtualBoard[61], VirtualBoard[63]);
                            }
                        }
                    }
                    If (Glob.UserMove == "")
                    {
                        Glob.UserMove = ((Glob.MoveFromIdx * 100) + Glob.MoveToIdx);
                        If ((Board[Glob.MoveFromIdx] == GoK_WhitePawn) And (Glob.MoveToIdx < 9))
                        {
                            Glob.UserMove = (Glob.UserMove + 0.1);
                        }
                    }
                    Call ExecuteUserMove(Glob.UserMove);
                }
            }
        }
        Call ExitExecution;
    }
}

WhenBroadcastReceived(Stg_StageClicked)
{
    List.Hide(ExportMoves);
    List.Hide(ExportData);
    List.Hide(CreditsData);
    List.Hide(Logfile);
    List.Hide(ProfilingData);
    If (Glob.IsExecutionRunning == 0)
    {
        Looks.Say("");
    }
}

WhenBroadcastReceived(Stg_TriggerRestart)
{
    Call OnRestart;
}

WhenBroadcastReceived(UI_AdvisorClicked)
{
    If (Glob.IsExecutionRunning == 0)
    {
        If (Glob.IsAdvisorEnabled == 1)
        {
            Glob.IsAdvisorEnabled = 0;
            Call DrawBoardAndWait;
        }
        Else
        {
            Glob.IsAdvisorEnabled = 1;
            If (Not ((Stg_FromSquareIdx == -1)))
            {
                Event.BroadcastAndWait("Stg_FromSquareSelected");
            }
        }
    }
}

