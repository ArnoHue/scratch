    List.Add(TestSuiteSan, "Qc1c5");
    List.Add(TestSuiteSan, "Qc1d2");
    List.Add(TestSuiteSan, "");
    List.Add(TestSuiteSan, "");
    List.Add(TestSuiteFens, "r1bq1rk1/pp2ppbp/2n3p1/2p5/2BPP3/2P1B3/P3NPPP/R2QK2R w KQ - 0 1");
    List.Add(TestSuiteSan, "O-O");
    List.Add(TestSuiteSan, "Ra1c1");
    List.Add(TestSuiteSan, "Ra1b1");
    List.Add(TestSuiteSan, "");
    List.Add(TestSuiteSan, "");
}

Define IsBlackKingCheckMate (warp=true)
{
    Ret.IsBlackKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(2);
    If (Glob.IsBlackChecked == 1)
    {
        Ret.IsBlackKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(1);
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(1)((1 == 1));
                Call CalcBoardAttackedByMove(2);
                If (Glob.IsBlackChecked == 0)
                {
                    Ret.IsBlackKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(1);
            }
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
}

Define IsCastlingPathSafe(string Move)(string Ply) (warp=true)
{
    Ret.IsCastlingPathSafe.IsSafe = 1;
    If (floor((Move / 100)) == 0)
    {
        ICPS.FirstIdx = 0;
        If (Move == GoK_BlackQueensideCastling)
        {
            ICPS.FirstIdx = 3;
        }
        If (Move == GoK_BlackKingsideCastling)
        {
            ICPS.FirstIdx = 5;
        }
        If (Move == GoK_WhiteQueensideCastling)
        {
            ICPS.FirstIdx = 59;
        }
        If (Move == GoK_WhiteKingsideCastling)
        {
            ICPS.FirstIdx = 61;
        }
        If (ICPS.FirstIdx > 0)
        {
            Call CalcBoardAttackedOnDemand(Ply)((1 == 0))((1 == 1))(99);
            ICPS.Base = ((Ply - 1) * 100);
            If (Not (((BoardAttackedByOpponentSnapshot[(ICPS.Base + VirtualBoard[ICPS.FirstIdx])] == 0) And ((BoardAttackedByOpponentSnapshot[(ICPS.Base + VirtualBoard[(ICPS.FirstIdx + 1)])] == 0) And (BoardAttackedByOpponentSnapshot[(ICPS.Base + VirtualBoard[(ICPS.FirstIdx + 2)])] == 0)))))
            {
                Ret.IsCastlingPathSafe.IsSafe = 0;
            }
        }
    }
}

Define IsCheckedFast(string CheckingPly) (warp=true)
{
    Ret.IsCheckedFast.IsChecked = 0;
    ICF.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    ICF.SideOffset = ((ICF.Factor > 0) * 60000);
    If (ICF.Factor > 0)
    {
        ICF.KingIdx = Glob.WhiteKingIdx;
    }
    Else
    {
        ICF.KingIdx = Glob.BlackKingIdx;
    }
    ICF.SqIdx = 1;
    Repeat (64)
    {
        If ((Board[ICF.SqIdx] * ICF.Factor) > 0)
        {
            If (Not ((MoveToHash[((ICF.SideOffset + (PieceIdxLookup[abs(Board[ICF.SqIdx])] * 10000)) + ((ICF.SqIdx * 100) + ICF.KingIdx))] == 0)))
            {
                Call IsCheckingPiece(ICF.SqIdx);
                If (Ret.IsCheckingPiece.IsChecking == 1)
                {
                    Ret.IsCheckedFast.IsChecked = 1;
                    Ret.IsCheckedFast.CheckedByIdx = ICF.SqIdx;
                    Stop(this script);
                }
            }
        }
        ICF.SqIdx += 1;
    }
}

Define IsCheckingPiece(string Idx) (warp=true)
{
    Call IsCheckingPieceImpl(Idx)(Board[(Idx + 0)]);
    Ret.IsCheckingPiece.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
}

Define IsCheckingPieceDiscovery(string SourceIdx)(string TargetIdx)(string Ply) (warp=true)
{
    Call IsCheckingPieceImpl(SourceIdx)((GoK_BlackQueen * ((2 * PlyIsOwn[Ply]) - 1)));
    Ret.IsCheckingPieceDiscovery.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 0)
    {
        Stop(this script);
    }
    Call CalcBoardAttackedByMoveChecked((Ply + 2));
    If (((PlyIsOwn[Ply] == 1) And (Glob.IsWhiteChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsBlackChecked == 1)))
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 1;
    }
    Else
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 0;
    }
}

Define IsCheckingPieceImpl(string Idx)(string Piece) (warp=true)
{
    Ret.IsCheckingPieceImpl.IsChecking = 0;
    If (abs(Piece) == GoK_BlackKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.WhiteKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.BlackKingIdx);
    }
    Ret.IsCheckingPieceImpl.IsChecking = Ret.IsReachableForAttack.IsReachable;
}

Define IsDrawByMaterial (warp=true)
{
    Ret.IsDrawByMaterial.IsDraw = 0;
    IDBM.BlackMinorCnt = 0;
    IDBM.WhiteMinorCnt = 0;
    IDBM.SqIdx = 1;
    Repeat (64)
    {
        IDBM.Piece = Board[IDBM.SqIdx];
        If (Not ((IDBM.Piece == 0)))
        {
            If ((IDBM.Piece == GoK_BlackBishop) Or (IDBM.Piece == GoK_BlackKnight))
            {
                IDBM.BlackMinorCnt += 1;
            }
            Else
            {
                If ((IDBM.Piece == GoK_WhiteBishop) Or (IDBM.Piece == GoK_WhiteKnight))
                {
                    IDBM.WhiteMinorCnt += 1;
                }
                Else
                {
                    If (Not ((abs(IDBM.Piece) == GoK_BlackKing)))
                    {
                        Stop(this script);
                    }
                }
            }
        }
        IDBM.SqIdx += 1;
    }
    If ((IDBM.BlackMinorCnt + IDBM.WhiteMinorCnt) < 2)
    {
        Ret.IsDrawByMaterial.IsDraw = 1;
    }
}

Define IsDrawByStalemate(string Ply) (warp=true)
{
    Call CalcBoardAttackedByMoveChecked((Ply + 1));
    If (((PlyIsOwn[Ply] == 1) And (Glob.IsBlackChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsWhiteChecked == 1)))
    {
        Ret.IsDrawByStalemate.IsDraw = 0;
        Stop(this script);
    }
    List.ReplaceItem(Quiescence, Ply, 0);
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0));
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    If (Quiescence[Ply] == 1)
    {
        Glob.MoveCount += MovesCount[Ply];
    }
    Else
    {
        Glob.MoveCountQ += MovesCount[Ply];
    }
    Ret.IsDrawByStalemate.IsDraw = 1;
    List.ReplaceItem(MovesIdx, Ply, 1);
    Repeat (MovesCount[Ply])
    {
        Call ApplyMoveLight(Ply);
        Call CalcBoardAttackedByMoveChecked((Ply + 1));
        If (((PlyIsOwn[Ply] == 1) And (Glob.IsBlackChecked == 0)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsWhiteChecked == 0)))
        {
            Ret.IsDrawByStalemate.IsDraw = 0;
            Call RevertMoveLight(Ply);
            Stop(this script);
        }
        Call RevertMoveLight(Ply);
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
    }
}

Define IsEngineValidMove(string Move) (warp=true)
{
    Call GenerateMovesPublic(1);
    If List.ContainsItem(Moves1, Move)
    {
        Ret.IsEngineValidMove.IsValid = 1;
    }
    Else
    {
        Ret.IsEngineValidMove.IsValid = 0;
    }
    If (Ret.IsEngineValidMove.IsValid == 1)
    {
        Call ClearMoveList(1);
        Call AddMoveToList(Move)(1)(0);
        List.ReplaceItem(MovesIdx, 1, 1);
        Glob.IsWhiteChecked = 0;
        Glob.IsBlackChecked = 0;
        Call ApplyMove(1)((1 == 0));
        Call CalcBoardAttackedByMove(2);
        If (((Glob.IsPlayerBlack == 1) And (Glob.IsWhiteChecked == 1)) Or ((Glob.IsPlayerBlack == 0) And (Glob.IsBlackChecked == 1)))
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
        Call RevertMove(1);
    }
}

Define IsLowerCase(string Char) (warp=true)
{
    ILC.Chars = "";
    ILC.CharsIdx = 1;
    Repeat (Variable.Length(Const.CharsUpperCase))
    {
        If (Operator.LetterOf(Const.CharsUpperCase, ILC.CharsIdx) == Char)
        {
            ILC.Chars = Operator.Join(ILC.Chars, Char);
        }
        Else
        {
            ILC.Chars = Operator.Join(ILC.Chars, Operator.LetterOf(Const.CharsUpperCase, ILC.CharsIdx));
        }
        ILC.CharsIdx += 1;
    }
    Looks.SwitchCostumeTo(_ABCDEFGHIJKLMNOPQRSTUVWXYZ);
    Looks.SwitchCostumeTo(ILC.Chars);
    If (Costume.GetNumberName(number) == 1)
    {
        Ret.IsLowerCase.IsLower = 0;
    }
    Else
    {
        Ret.IsLowerCase.IsLower = 1;
    }
}

Define IsMoveLegalFast(string Ply) (warp=true)
{
    If ((CheckedState[Ply] == 1) Or (floor((AppliedMove[Ply] / 100)) == 0))
    {
        Call IsCheckedFast((Ply + 1));
        Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        IMLF.FromIdx = floor((AppliedMove[Ply] / 100));
        IMLF.ToIdx = floor((AppliedMove[Ply] % 100));
        If ((abs(SourcePieces[Ply]) == GoK_BlackKing) Or (Not ((TargetPiecesIdx[Ply] == IMLF.ToIdx))))
        {
            Call IsCheckedFast((Ply + 1));
            Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            Ret.IsMoveLegalFast.IsLegal = 0;
            IMLF.PinIdx = 1;
            Repeat (PinCount[Ply])
            {
                If (PinSq[(((Ply - 1) * 8) + IMLF.PinIdx)] == IMLF.FromIdx)
                {
                    If (Not ((abs(MoveToPathStepInc[((IMLF.FromIdx * 100) + IMLF.ToIdx)]) == PinRay[(((Ply - 1) * 8) + IMLF.PinIdx)])))
                    {
                        Ret.IsMoveLegalFast.IsLegal = 1;
                    }
                }
                IMLF.PinIdx += 1;
            }
            If (Glob.ProfilerMode == 2)
            {
                IMLF.IsChecked = Ret.IsMoveLegalFast.IsLegal;
                Call IsCheckedFast((Ply + 1));
                Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
                If (Not ((IMLF.IsChecked == Ret.IsMoveLegalFast.IsLegal)))
                {
                    Call Log("CheckInfoMismatch legal depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(IMLF.IsChecked)(" old=")(Ret.IsMoveLegalFast.IsLegal);
                }
            }
        }
    }
}

Define IsMovePicked(string Ply)(string Move) (warp=true)
{
    Ret.IsMovePicked.Picked = 0;
    IMP.MPScanIdx = 1;
    Repeat Until (IMP.MPScanIdx > PickedPseudoLegalMovesCount[Ply])
    {
        If (PickedPseudoLegalMoves[(((Ply - 1) * Const.MaxMovesPerGeneration) + IMP.MPScanIdx)] == Move)
        {
            Ret.IsMovePicked.Picked = 1;
            Ret.IsMovePicked.Score = PickedPseudoLegalMovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + IMP.MPScanIdx)];
            Stop(this script);
        }
        IMP.MPScanIdx += 1;
    }
}

Define IsOwnKingCheckMate (warp=true)
{
    If (Glob.IsPlayerBlack == 1)
    {
        Call IsWhiteKingCheckMate;
        Ret.IsOwnKingCheckMate.IsCheckMate = Ret.IsWhiteKingCheckMate.IsCheckMate;
    }
    Else
    {
        Call IsBlackKingCheckMate;
        Ret.IsOwnKingCheckMate.IsCheckMate = Ret.IsBlackKingCheckMate.IsCheckMate;
    }
}

Define IsQuiescentCheckCond(string Ply) (warp=true)
{
    Call Comment("Quiescence search extension for checking moves, esp. check sequences. Return value defined whether check sequences should pursued at this point");
    Ret.IsQuiescentCheckCond.IsTrue = 0;
    If (1 == 1)
    {
        If (Glob.IsScratch3 == 0)
        {
            If ((Quiescence[Ply] == 1) And (Quiescence[(Ply - 1)] == 0))
            {
                Ret.IsQuiescentCheckCond.IsTrue = 1;
            }
        }
    }
}

Define IsReachableForAttack(string Piece)(string FromIdx)(string ToIdx) (warp=true)
{
    Ret.IsReachableForAttack.IsReachable = 0;
    If (Piece == 0)
    {
        Stop(this script);
    }
    If (MoveToHash[((((Piece > 0) * 60000) + (PieceIdxLookup[abs(Piece)] * 10000)) + ((FromIdx * 100) + ToIdx))] == 0)
    {
        Stop(this script);
    }
    If ((abs(Piece) == GoK_BlackKing) Or (abs(Piece) == GoK_BlackKnight))
    {
        Ret.IsReachableForAttack.IsReachable = 1;
        Stop(this script);
    }
    If (abs(Piece) == GoK_BlackPawn)
    {
        If (Not ((IdxToFile[(FromIdx + 0)] == IdxToFile[(ToIdx + 0)])))
        {
            Ret.IsReachableForAttack.IsReachable = 1;
            Stop(this script);
        }
    }
    If ((abs(Piece) > GoK_BlackKnight) And (abs(Piece) < GoK_BlackKing))
    {
        IRFA.Idx = ((FromIdx * 100) + ToIdx);
        IRFA.SourceIdx = FromIdx;
        Repeat ((MoveToPathDelta[IRFA.Idx] - 1))
        {
            IRFA.SourceIdx += MoveToPathStepInc[IRFA.Idx];
            If (Not ((Board[IRFA.SourceIdx] == 0)))
            {
                Stop(this script);
            }
        }
        Ret.IsReachableForAttack.IsReachable = 1;
    }
}

Define IsWhiteKingCheckMate (warp=true)
{
    Ret.IsWhiteKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(1);
    If (Glob.IsWhiteChecked == 1)
    {
        Ret.IsWhiteKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(2)((1 == 1));
                Call CalcBoardAttackedByMove(1);
                If (Glob.IsWhiteChecked == 0)
                {
                    Ret.IsWhiteKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(2);
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
    }
}

Define LoadList(string Data)(string ListName) (warp=true)
{
    LL.CharIdx = 1;
    LL.Token = "";
    Repeat Until (LL.CharIdx > Variable.Length(Data))
    {
        If ((Not ((Operator.LetterOf(Data, LL.CharIdx) == " "))) And (Not ((Operator.LetterOf(Data, LL.CharIdx) == ","))))
        {
            LL.Token = Operator.Join(LL.Token, Operator.LetterOf(Data, LL.CharIdx));
        }
        If ((Operator.LetterOf(Data, LL.CharIdx) == ",") Or (LL.CharIdx == Variable.Length(Data)))
        {
            If (ListName == "PawnPieceSquare")
            {
                List.Add(PawnPieceSquare, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "PawnPieceSquareEndgame")
            {
                List.Add(PawnPieceSquareEndgame, Operator.Round((LL.Token * 2)));
            }
            If (ListName == "PawnPieceSquarePreCastling")
            {
                List.Add(PawnPieceSquarePreCastling, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "KingPieceSquare")
            {
                List.Add(KingPieceSquare, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "KingPieceSquareEndgame")
            {
                List.Add(KingPieceSquareEndgame, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "QueenPieceSquare")
            {
                List.Add(QueenPieceSquare, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "QueenPieceSquareEndgame")
            {
                List.Add(QueenPieceSquareEndgame, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "RookPieceSquare")
            {
                List.Add(RookPieceSquare, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "RookPieceSquareEndgame")
            {
                List.Add(RookPieceSquareEndgame, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "BishopPieceSquare")
            {
                List.Add(BishopPieceSquare, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "BishopPieceSquareEndgame")
            {
                List.Add(BishopPieceSquareEndgame, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "KnightPieceSquare")
            {
                List.Add(KnightPieceSquare, Operator.Round((LL.Token * 0.4)));
            }
            If (ListName == "KnightPieceSquareEndgame")
            {
                List.Add(KnightPieceSquareEndgame, Operator.Round((LL.Token * 0.4)));
            }
            If (ListName == "PushToEdges")
            {
                List.Add(PushToEdges, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "PushClose")
            {
                List.Add(PushClose, Operator.Round((LL.Token * 1)));
            }
            LL.Token = "";
        }
        LL.CharIdx += 1;
    }
}

Define Log(string Txt1)(string Txt2)(string Txt3)(string Txt4)(string Txt5)(string Txt6)(string Txt7)(string Txt8) (warp=true)
{
    If (Glob.IsTestRunning == 1)
    {
        Stop(this script);
    }
    If (List.Length(Logfile) > 1000000)
    {
        Stop(this script);
    }
    Log.ElapsedSec = (floor((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * 1000)) / 1000);
    If Operator.Contains(Log.ElapsedSec, ".")
    {
        If ((Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 1)) == ".") Or (Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 2)) == "."))
        {
            Log.ElapsedSec = Operator.Join(Log.ElapsedSec, 0);
        }
    }
    Else
    {
        Log.ElapsedSec = Operator.Join(Log.ElapsedSec, .000);
    }
    List.Add(Logfile, Operator.Join(Operator.Join(Log.ElapsedSec, ": "), Operator.Join(Txt1, Operator.Join(Txt2, Operator.Join(Txt3, Operator.Join(Txt4, Operator.Join(Txt5, Operator.Join(Txt6, Operator.Join(Txt7, Txt8)))))))));
}

Define NNUE_ActDeactBulkImpl(string FromSquare)(string ToSquare)(string SourcePiece)(string PlacedPiece)(string TargetPiece)(string CapSquare)(string Ply) (warp=true)
{
    NNUE.ADBI.Side = 0;
    Repeat (2)
    {
        NNUE.ADBI.Chunk = 0;
        Repeat (1)
        {
            NNUE.ADBI.Offset = (NNUE.ADBI.Chunk * (Const.NNUE_HiddenPackedSize / 2));
            NNUE.ADBI.Idx1_Base = (((NNUE.ADBI.Side * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.Offset) + 1);
            NNUE.ADBI.FeatureFrom = (NNUE_InputIdxMap[(((NNUE.ADBI.Side * 1000) + ((64 * SourcePiece) + FromSquare)) + 1)] + 0);
            NNUE.ADBI.FeatureTo = (NNUE_InputIdxMap[(((NNUE.ADBI.Side * 1000) + ((64 * PlacedPiece) + ToSquare)) + 1)] + 0);
            If (TargetPiece == "")
            {
                NNUE.ADBI.FeatureCap = 0;
            }
            Else
            {
                NNUE.ADBI.FeatureCap = (NNUE_InputIdxMap[(((NNUE.ADBI.Side * 1000) + ((64 * TargetPiece) + CapSquare)) + 1)] + 0);
            }
            NNUE.ADBI.FromBase = (((NNUE.ADBI.FeatureFrom * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.Offset) + 1);
            NNUE.ADBI.ToBase = (((NNUE.ADBI.FeatureTo * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.Offset) + 1);
            If (NNUE.ADBI.FeatureCap == 0)
            {
                NNUE.ADBI.CapBase = 0;
            }
            Else
            {
                NNUE.ADBI.CapBase = (((NNUE.ADBI.FeatureCap * Const.NNUE_HiddenPackedSize) + NNUE.ADBI.Offset) + 1);
            }
            If (Ply == 0)
            {
                NNUE.ADBI.SourceIdx = NNUE.ADBI.Idx1_Base;
                NNUE.ADBI.TargetIdx = NNUE.ADBI.Idx1_Base;
            }
            Else
            {
                NNUE.ADBI.TargetIdx = (NNUE.ADBI.Idx1_Base + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                If (NNUE_Accumulator_MetaState[Ply] == 1)
                {
                    NNUE.ADBI.SourceIdx = (NNUE.ADBI.Idx1_Base + ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1)));
                }
                Else
                {
                    If (NNUE_Accumulator_MetaState[Ply] == 2)
                    {
                        NNUE.ADBI.SourceIdx = (NNUE.ADBI.Idx1_Base + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                    }
                    Else
                    {
                        Stop(this script);
                    }
                }
            }
            If (NNUE.ADBI.CapBase > 0)
            {
                NNUE.ADBI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADBI.TargetIdx + NNUE.ADBI.Idx), ((((NNUE_Accumulator[(NNUE.ADBI.SourceIdx + NNUE.ADBI.Idx)] - NNUE_InputWeights[(NNUE.ADBI.FromBase + NNUE.ADBI.Idx)]) + NNUE_InputWeights[(NNUE.ADBI.ToBase + NNUE.ADBI.Idx)]) - NNUE_InputWeights[(NNUE.ADBI.CapBase + NNUE.ADBI.Idx)]) + 1688862745264128));
                    NNUE.ADBI.Idx += 1;
                }
            }
            Else
            {
                NNUE.ADBI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADBI.TargetIdx + NNUE.ADBI.Idx), ((NNUE_Accumulator[(NNUE.ADBI.SourceIdx + NNUE.ADBI.Idx)] - NNUE_InputWeights[(NNUE.ADBI.FromBase + NNUE.ADBI.Idx)]) + NNUE_InputWeights[(NNUE.ADBI.ToBase + NNUE.ADBI.Idx)]));
                    NNUE.ADBI.Idx += 1;
                }
            }
            NNUE.ADBI.Chunk += 1;
        }
        NNUE.ADBI.Side += 1;
    }
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 2);
}

Define NNUE_ActDeactImpl(string Square)(string Piece)(bool Activate)(string Ply) (warp=true)
{
    NNUE.ADI.Side = 0;
    Repeat (2)
    {
        NNUE.ADI.Chunk = 0;
        Repeat (1)
        {
            NNUE.ADI.Offset = (NNUE.ADI.Chunk * (Const.NNUE_HiddenPackedSize / 2));
            NNUE.ADI.Idx1_Base = (((NNUE.ADI.Side * Const.NNUE_HiddenPackedSize) + NNUE.ADI.Offset) + 1);
            NNUE.ADI.Feature = (NNUE_InputIdxMap[(((NNUE.ADI.Side * 1000) + ((64 * Piece) + Square)) + 1)] + 0);
            NNUE.ADI.FeatureBase = (((NNUE.ADI.Feature * Const.NNUE_HiddenPackedSize) + NNUE.ADI.Offset) + 1);
            If (Ply == 0)
            {
                NNUE.ADI.SourceIdx = NNUE.ADI.Idx1_Base;
                NNUE.ADI.TargetIdx = NNUE.ADI.Idx1_Base;
            }
            Else
            {
                NNUE.ADI.TargetIdx = (NNUE.ADI.Idx1_Base + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                If (NNUE_Accumulator_MetaState[Ply] == 1)
                {
                    NNUE.ADI.SourceIdx = (NNUE.ADI.Idx1_Base + ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1)));
                }
                Else
                {
                    If (NNUE_Accumulator_MetaState[Ply] == 2)
                    {
                        NNUE.ADI.SourceIdx = (NNUE.ADI.Idx1_Base + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                    }
                    Else
                    {
                        Stop(this script);
                    }
                }
            }
            If Activate
            {
                NNUE.ADI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADI.TargetIdx + NNUE.ADI.Idx), ((NNUE_Accumulator[(NNUE.ADI.SourceIdx + NNUE.ADI.Idx)] + NNUE_InputWeights[(NNUE.ADI.FeatureBase + NNUE.ADI.Idx)]) - 1688862745264128));
                    NNUE.ADI.Idx += 1;
                }
            }
            Else
            {
                NNUE.ADI.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE.ADI.TargetIdx + NNUE.ADI.Idx), ((NNUE_Accumulator[(NNUE.ADI.SourceIdx + NNUE.ADI.Idx)] - NNUE_InputWeights[(NNUE.ADI.FeatureBase + NNUE.ADI.Idx)]) + 1688862745264128));
                    NNUE.ADI.Idx += 1;
                }
            }
            NNUE.ADI.Chunk += 1;
        }
        NNUE.ADI.Side += 1;
    }
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 2);
}

Define NNUE_Activate(string GoKIdx)(string GoKPiece)(string Ply) (warp=true)
{
    Call NNUE_ActDeactImpl(NNUE_GoKIdxToSquare[VirtualBoard[GoKIdx]])((((6 * (GoKPiece > 0)) + PieceIdxLookup[abs(GoKPiece)]) - 1))((1 == 1))(Ply);
}

Define NNUE_Deactivate(string GoKIdx)(string GoKPiece)(string Ply) (warp=true)
{
    Call NNUE_ActDeactImpl(NNUE_GoKIdxToSquare[VirtualBoard[GoKIdx]])((((6 * (GoKPiece > 0)) + PieceIdxLookup[abs(GoKPiece)]) - 1))((1 == 0))(Ply);
}

Define NNUE_DecodeNetwork (warp=true)
{
    If (NNUE.DN.IsDecoded == 1)
    {
        Stop(this script);
    }
    Call NNUE_HexToDec(Glob.NNUE_InputWeights_HEX);
    List.DeleteAll(NNUE_InputWeights);
    NNUE.DN.RowIdx = 0;
    Repeat (384)
    {
        NNUE.DN.WeightIdx = 0;
        Repeat (170)
        {
            List.Add(NNUE_InputWeights, (((NNUE_ListRes_1[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 1)] + 98304) + ((NNUE_ListRes_1[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 2)] + 98304) * 131072)) + ((NNUE_ListRes_1[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 3)] + 98304) * 17179869184)));
            NNUE.DN.WeightIdx += 1;
        }
        List.Add(NNUE_InputWeights, (((NNUE_ListRes_1[((NNUE.DN.RowIdx * 512) + 511)] + 98304) + ((NNUE_ListRes_1[((NNUE.DN.RowIdx * 512) + 512)] + 98304) * 131072)) + 1688849860263936));
        NNUE.DN.RowIdx += 1;
    }
    NNUE.DN.RowIdx = 0;
    Repeat (384)
    {
        NNUE.DN.WeightIdx = 0;
        Repeat (170)
        {
            List.Add(NNUE_InputWeights, (((NNUE_ListRes_2[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 1)] + 98304) + ((NNUE_ListRes_2[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 2)] + 98304) * 131072)) + ((NNUE_ListRes_2[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 3)] + 98304) * 17179869184)));
            NNUE.DN.WeightIdx += 1;
        }
        List.Add(NNUE_InputWeights, (((NNUE_ListRes_2[((NNUE.DN.RowIdx * 512) + 511)] + 98304) + ((NNUE_ListRes_2[((NNUE.DN.RowIdx * 512) + 512)] + 98304) * 131072)) + 1688849860263936));
        NNUE.DN.RowIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE_HiddenBias_CSV);
    List.DeleteAll(NNUE_HiddenBias);
    NNUE.DN.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenBias, (NNUE_ListRes_1[NNUE.DN.CharIdx] + 0));
        NNUE.DN.CharIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE_HIddenWeights_CSV);
    List.DeleteAll(NNUE_HiddenWeights);
    NNUE.DN.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenWeights, (NNUE_ListRes_1[NNUE.DN.CharIdx] + 0));
        NNUE.DN.CharIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE_OutputBias_CSV);
    List.DeleteAll(NNUE_OutputBias);
    NNUE.DN.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_OutputBias, (NNUE_ListRes_1[NNUE.DN.CharIdx] + 0));
        NNUE.DN.CharIdx += 1;
    }
    NNUE.DN.IsDecoded = 1;
    List.DeleteAll(NNUE_ListRes_1);
    NNUE.DN.RowIdx = 0;
    Repeat (1)
    {
        NNUE.DN.WeightIdx = 0;
        Repeat (170)
        {
            List.Add(NNUE_ListRes_1, (((NNUE_HiddenBias[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 1)] + 98304) + ((NNUE_HiddenBias[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 2)] + 98304) * 131072)) + ((NNUE_HiddenBias[(((NNUE.DN.RowIdx * 512) + (NNUE.DN.WeightIdx * 3)) + 3)] + 98304) * 17179869184)));
            NNUE.DN.WeightIdx += 1;
        }
        List.Add(NNUE_ListRes_1, (((NNUE_HiddenBias[((NNUE.DN.RowIdx * 512) + 511)] + 98304) + ((NNUE_HiddenBias[((NNUE.DN.RowIdx * 512) + 512)] + 98304) * 131072)) + 1688849860263936));
        NNUE.DN.RowIdx += 1;
    }
    List.DeleteAll(NNUE_HiddenBias);
    NNUE.DN.RowIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenBias, NNUE_ListRes_1[NNUE.DN.RowIdx]);
        NNUE.DN.RowIdx += 1;
    }
    List.DeleteAll(NNUE_ListRes_1);
}

Define NNUE_DecToHex(string CSV) (warp=true)
{
    List.DeleteAll(TmpList1);
    List.Add(TmpList1, 0);
    List.Add(TmpList1, 1);
    List.Add(TmpList1, 2);
    List.Add(TmpList1, 3);
    List.Add(TmpList1, 4);
    List.Add(TmpList1, 5);
    List.Add(TmpList1, 6);
    List.Add(TmpList1, 7);
    List.Add(TmpList1, 8);
    List.Add(TmpList1, 9);
    List.Add(TmpList1, "a");
    List.Add(TmpList1, "b");
    List.Add(TmpList1, "c");
    List.Add(TmpList1, "d");
    List.Add(TmpList1, "e");
    List.Add(TmpList1, "f");
    Call NNUE_LoadList(CSV);
    Ret.NNUE_DecToHex.Hex = "";
    NNUE.DTH.Idx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        NNUE.DTH.Word = NNUE_ListRes_1[NNUE.DTH.Idx];
        If (NNUE.DTH.Word < 0)
        {
            NNUE.DTH.Word = (2048 - NNUE.DTH.Word);
        }
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 256)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 16)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((NNUE.DTH.Word % 16) + 1)]);
        NNUE.DTH.Idx += 1;
    }
    NNUE.DTH.Idx = 1;
    Repeat (List.Length(NNUE_ListRes_2))
    {
        NNUE.DTH.Word = NNUE_ListRes_2[NNUE.DTH.Idx];
        If (NNUE.DTH.Word < 0)
        {
            NNUE.DTH.Word = (2048 - NNUE.DTH.Word);
        }
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 256)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE.DTH.Word / 16)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((NNUE.DTH.Word % 16) + 1)]);
        NNUE.DTH.Idx += 1;
    }
}

Define NNUE_Evaluate(string Side)(string Ply) (warp=true)
{
    Ret.NNUE_Evaluate.Score = (NNUE_OutputBias[1] + 0);
    NNUE.Eval.OurBase = ((Side * Const.NNUE_HiddenPackedSize) + (Ply * (Const.NNUE_HiddenPackedSize * 2)));
    NNUE.Eval.TheirBase = (((1 - Side) * Const.NNUE_HiddenPackedSize) + (Ply * (Const.NNUE_HiddenPackedSize * 2)));
    NNUE.Eval.Idx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        NNUE.Eval.OurPacked = floor(NNUE_Accumulator[(NNUE.Eval.OurBase + NNUE.Eval.Idx)]);
        NNUE.Eval.TheirPacked = floor(NNUE_Accumulator[(NNUE.Eval.TheirBase + NNUE.Eval.Idx)]);
        NNUE.Eval.WordHigh = floor((NNUE.Eval.OurPacked / 17179869184));
        NNUE.Eval.OurPacked = (NNUE.Eval.OurPacked - (17179869184 * NNUE.Eval.WordHigh));
        NNUE.Eval.WordHigh = (NNUE.Eval.WordHigh - 98304);
        NNUE.Eval.WordMid = floor((NNUE.Eval.OurPacked / 131072));
        NNUE.Eval.WordLow = ((NNUE.Eval.OurPacked - (131072 * NNUE.Eval.WordMid)) - 98304);
        NNUE.Eval.WordMid = (NNUE.Eval.WordMid - 98304);
        If (NNUE.Eval.WordLow > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordLow * floor(NNUE_HiddenWeights[((3 * NNUE.Eval.Idx) - 2)]));
        }
        If (NNUE.Eval.WordMid > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordMid * floor(NNUE_HiddenWeights[((3 * NNUE.Eval.Idx) - 1)]));
        }
        If (NNUE.Eval.WordHigh > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordHigh * floor(NNUE_HiddenWeights[(3 * NNUE.Eval.Idx)]));
        }
        NNUE.Eval.WordHigh = floor((NNUE.Eval.TheirPacked / 17179869184));
        NNUE.Eval.TheirPacked = (NNUE.Eval.TheirPacked - (17179869184 * NNUE.Eval.WordHigh));
        NNUE.Eval.WordHigh = (NNUE.Eval.WordHigh - 98304);
        NNUE.Eval.WordMid = floor((NNUE.Eval.TheirPacked / 131072));
        NNUE.Eval.WordLow = ((NNUE.Eval.TheirPacked - (131072 * NNUE.Eval.WordMid)) - 98304);
        NNUE.Eval.WordMid = (NNUE.Eval.WordMid - 98304);
        If (NNUE.Eval.WordLow > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordLow * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + ((3 * NNUE.Eval.Idx) - 2))]));
        }
        If (NNUE.Eval.WordMid > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordMid * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + ((3 * NNUE.Eval.Idx) - 1))]));
        }
        If (NNUE.Eval.WordHigh > 0)
        {
            Ret.NNUE_Evaluate.Score += (NNUE.Eval.WordHigh * floor(NNUE_HiddenWeights[(Const.NNUE_HiddenSize + (3 * NNUE.Eval.Idx))]));
        }
        NNUE.Eval.Idx += 1;
    }
    Ret.NNUE_Evaluate.Score = (Ret.NNUE_Evaluate.Score / (16 * Const.NNUE_HiddenSize));
}

Define NNUE_HexToDec(string Hex) (warp=true)
{
    List.DeleteAll(TmpList1);
    List.Add(TmpList1, 0);
    List.Add(TmpList1, 1);
    List.Add(TmpList1, 2);
    List.Add(TmpList1, 3);
    List.Add(TmpList1, 4);
    List.Add(TmpList1, 5);
    List.Add(TmpList1, 6);
    List.Add(TmpList1, 7);
    List.Add(TmpList1, 8);
    List.Add(TmpList1, 9);
    List.Add(TmpList1, "a");
    List.Add(TmpList1, "b");
    List.Add(TmpList1, "c");
    List.Add(TmpList1, "d");
    List.Add(TmpList1, "e");
    List.Add(TmpList1, "f");
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
    NNUE.HTD.Idx = 1;
    Repeat ((Variable.Length(Hex) / 3))
    {
        NNUE.HTD.Word = ((((List.IndexOf(TmpList1, Operator.LetterOf(Hex, NNUE.HTD.Idx)) - 1) * 256) + ((List.IndexOf(TmpList1, Operator.LetterOf(Hex, (NNUE.HTD.Idx + 1))) - 1) * 16)) + (List.IndexOf(TmpList1, Operator.LetterOf(Hex, (NNUE.HTD.Idx + 2))) - 1));
        If (NNUE.HTD.Word > 2048)
        {
            NNUE.HTD.Word = (2048 - NNUE.HTD.Word);
        }
        If (List.Length(NNUE_ListRes_1) < (768 * 256))
        {
            List.Add(NNUE_ListRes_1, (NNUE.HTD.Word + 0));
        }
        Else
        {
            List.Add(NNUE_ListRes_2, (NNUE.HTD.Word + 0));
        }
        NNUE.HTD.Idx += 3;
    }
}

Define NNUE_ImportNetwork(string InputWeights)(string HiddenBias)(string HiddenWeights)(string OutputBias) (warp=true)
{
    List.DeleteAll(NNUE_InputWeights);
    List.DeleteAll(NNUE_InputWeights);
    List.DeleteAll(NNUE_HiddenBias);
    List.DeleteAll(NNUE_HiddenWeights);
    List.DeleteAll(NNUE_OutputBias);
    Call NNUE_DecToHex(InputWeights);
    Glob.NNUE_InputWeights_HEX = Ret.NNUE_DecToHex.Hex;
    Glob.NNUE_HiddenBias_CSV = HiddenBias;
    Glob.NNUE_HIddenWeights_CSV = HiddenWeights;
    Glob.NNUE_OutputBias_CSV = OutputBias;
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
}

Define NNUE_Init (warp=true)
{
    Call NNUE_DecodeNetwork;
    Const.NNUE_HiddenSize = 512;
    Const.NNUE_HiddenPackedSize = 171;
    List.DeleteAll(NNUE_Accumulator);
    Repeat (((Const.NNUE_HiddenPackedSize * 2) * Const.MaxPlyStackFrames))
    {
        List.Add(NNUE_Accumulator, 0);
    }
    List.DeleteAll(NNUE_Accumulator_MetaState);
    List.DeleteAll(NNUE_AccStackState);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(NNUE_Accumulator_MetaState, 0);
        List.Add(NNUE_AccStackState, 0);
    }
    NNUE.Init.SqIdx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        List.ReplaceItem(NNUE_Accumulator, NNUE.Init.SqIdx, NNUE_HiddenBias[NNUE.Init.SqIdx]);
        List.ReplaceItem(NNUE_Accumulator, (Const.NNUE_HiddenPackedSize + NNUE.Init.SqIdx), NNUE_HiddenBias[NNUE.Init.SqIdx]);
        NNUE.Init.SqIdx += 1;
    }
    List.DeleteAll(NNUE_GoKIdxToSquare);
    NNUE.Init.SqIdx = 1;
    Repeat (64)
    {
        List.Add(NNUE_GoKIdxToSquare, ((((8 - IdxToRank[NNUE.Init.SqIdx]) * 8) + IdxToFile[NNUE.Init.SqIdx]) - 1));
        NNUE.Init.SqIdx += 1;
    }
    List.DeleteAll(NNUE_PrevRefreshBoard);
    Repeat (64)
    {
        List.Add(NNUE_PrevRefreshBoard, 0);
    }
    List.DeleteAll(NNUE_InputIdxMap);
    Repeat (2000)
    {
        List.Add(NNUE_InputIdxMap, 0);
    }
    NNUE.Init.SqIdx = 0;
    Repeat (12)
    {
        NNUE.Init.SqOffset = 0;
        Repeat (64)
        {
            List.ReplaceItem(NNUE_InputIdxMap, (((NNUE.Init.SqIdx * 64) + NNUE.Init.SqOffset) + 1), ((NNUE.Init.SqIdx * 64) + NNUE.Init.SqOffset));
            NNUE.Init.NNIdx = 0;
            NNUE.Init.Exp = 1;
            Repeat (8)
            {
                If (Not ((((NNUE.Init.SqOffset % (NNUE.Init.Exp * 2)) > (NNUE.Init.Exp - 1)) == ((56 % (NNUE.Init.Exp * 2)) > (NNUE.Init.Exp - 1)))))
                {
                    NNUE.Init.NNIdx += NNUE.Init.Exp;
                }
                NNUE.Init.Exp = (NNUE.Init.Exp * 2);
            }
            If (NNUE.Init.SqIdx > 5)
            {
                NNUE.Init.NNIdx += ((NNUE.Init.SqIdx - 6) * 64);
            }
            Else
            {
                NNUE.Init.NNIdx += ((NNUE.Init.SqIdx + 6) * 64);
            }
            List.ReplaceItem(NNUE_InputIdxMap, ((1000 + ((NNUE.Init.SqIdx * 64) + NNUE.Init.SqOffset)) + 1), NNUE.Init.NNIdx);
            NNUE.Init.SqOffset += 1;
        }
        NNUE.Init.SqIdx += 1;
    }
    List.DeleteAll(NNUE_VirtualBoard);
    NNUE.Init.SqIdx = 1;
    Repeat (64)
    {
        List.Add(NNUE_VirtualBoard, (((IdxToRank[NNUE.Init.SqIdx] - 1) * 8) + (9 - IdxToFile[NNUE.Init.SqIdx])));
        NNUE.Init.SqIdx += 1;
    }
    Call NNUE_Public_Evaluate(1);
}

Define NNUE_LoadList(string Data) (warp=true)
{
    List.DeleteAll(NNUE_ListRes_1);
    List.DeleteAll(NNUE_ListRes_2);
    NNUE.LL.CharIdx = 1;
    NNUE.LL.Token = "";
    Repeat Until (NNUE.LL.CharIdx > Variable.Length(Data))
    {
        If ((Not ((Operator.LetterOf(Data, NNUE.LL.CharIdx) == " "))) And (Not ((Operator.LetterOf(Data, NNUE.LL.CharIdx) == ","))))
        {
            NNUE.LL.Token = Operator.Join(NNUE.LL.Token, Operator.LetterOf(Data, NNUE.LL.CharIdx));
        }
        If ((Operator.LetterOf(Data, NNUE.LL.CharIdx) == ",") Or (NNUE.LL.CharIdx == Variable.Length(Data)))
        {
            If (List.Length(NNUE_ListRes_1) < (floor((200000 / 256)) * 256))
            {
                List.Add(NNUE_ListRes_1, NNUE.LL.Token);
            }
            Else
            {
                List.Add(NNUE_ListRes_2, NNUE.LL.Token);
            }
            NNUE.LL.Token = "";
        }
        NNUE.LL.CharIdx += 1;
    }
}

Define NNUE_OnApplyMove(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_AccStackState, Ply, 1);
}

Define NNUE_OnInitStack(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_AccStackState, Ply, 1);
}

Define NNUE_Public_Evaluate(string Ply) (warp=true)
{
    Call NNUE_Evaluate(PlyIsOwn[Ply])((Ply - 1));
    Ret.NNUE_Public_Evaluate.Score = Ret.NNUE_Evaluate.Score;
    If (Ret.NNUE_Public_Evaluate.Score > Const.AbsMinCheckmateEval)
    {
        Ret.NNUE_Public_Evaluate.Score = Const.AbsMinCheckmateEval;
    }
    Else
    {
        If (Ret.NNUE_Public_Evaluate.Score < (0 - Const.AbsMinCheckmateEval))
        {
            Ret.NNUE_Public_Evaluate.Score = (0 - Const.AbsMinCheckmateEval);
        }
    }
    If (PlyIsOwn[Ply] == 0)
    {
        Ret.NNUE_Public_Evaluate.Score = (0 - Ret.NNUE_Public_Evaluate.Score);
    }
    If (abs(Ret.NNUE_Public_Evaluate.Score) < Const.AbsMinCheckmateEval)
    {
        Ret.NNUE_Public_Evaluate.Score = (Operator.Round((Ret.NNUE_Public_Evaluate.Score * 100)) / 100);
    }
}

Define NNUE_Public_OnApplyMoveDone(string Ply)(string Move)(string SourcePiece)(string TargetPiece)(string PromotionPiece)(string TargetPieceIdx) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call ProfilerMethodEnter((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
    }
    If (Move == 0)
    {
        Call NNUE_UpdateAccStack((Ply - 1));
        NNUE.POAMD.PlyBase = ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1));
        NNUE.POAMD.TargetIdx = ((Const.NNUE_HiddenPackedSize * 2) * Ply);
        NNUE.POAMD.AccIdx = 1;
        Repeat ((Const.NNUE_HiddenPackedSize * 2))
        {
            List.ReplaceItem(NNUE_Accumulator, (NNUE.POAMD.TargetIdx + NNUE.POAMD.AccIdx), NNUE_Accumulator[(NNUE.POAMD.PlyBase + NNUE.POAMD.AccIdx)]);
            NNUE.POAMD.AccIdx += 1;
        }
        List.ReplaceItem(NNUE_AccStackState, Ply, 0);
        If (Glob.ProfilerMode == 2)
        {
            Call ProfilerMethodExit((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
        }
        Stop(this script);
    }
    Call NNUE_StartBulkActivation(Ply);
    If (floor((Move / 100)) == 0)
    {
        NNUE.POAMD.KingMove = (CastlingKingMove[(Move + 0)] + 0);
        NNUE.POAMD.RookMove = (CastlingRookMove[(Move + 0)] + 0);
        If (SourcePiece > 0)
        {
            NNUE.POAMD.RookPiece = GoK_BlackRook;
        }
        Else
        {
            NNUE.POAMD.RookPiece = GoK_WhiteRook;
        }
        NNUE.POAMD.SourcePiece = (((6 * (NNUE.POAMD.RookPiece > 0)) + PieceIdxLookup[abs(NNUE.POAMD.RookPiece)]) - 1);
        Call NNUE_ActDeactBulkImpl(floor((NNUE.POAMD.RookMove / 100)))(floor((NNUE.POAMD.RookMove % 100)))(NNUE.POAMD.SourcePiece)(NNUE.POAMD.SourcePiece)("")(0)(Ply);
        NNUE.POAMD.From = floor((NNUE.POAMD.KingMove / 100));
        NNUE.POAMD.To = floor((NNUE.POAMD.KingMove % 100));
    }
    Else
    {
        NNUE.POAMD.From = (NNUE_GoKIdxToSquare[VirtualBoard[floor((Move / 100))]] + 0);
        NNUE.POAMD.To = (NNUE_GoKIdxToSquare[VirtualBoard[floor((Move % 100))]] + 0);
    }
    NNUE.POAMD.SourcePiece = (((6 * (SourcePiece > 0)) + PieceIdxLookup[abs(SourcePiece)]) - 1);
    If (PromotionPiece == 0)
    {
        NNUE.POAMD.PlacedPiece = NNUE.POAMD.SourcePiece;
    }
    Else
    {
        NNUE.POAMD.PlacedPiece = (((6 * (PromotionPiece > 0)) + PieceIdxLookup[abs(PromotionPiece)]) - 1);
    }
    If (TargetPiece == 0)
    {
        NNUE.POAMD.CapturedPiece = "";
        NNUE.POAMD.CapSquare = 0;
    }
    Else
    {
        NNUE.POAMD.CapturedPiece = (((6 * (TargetPiece > 0)) + PieceIdxLookup[abs(TargetPiece)]) - 1);
        NNUE.POAMD.CapSquare = (NNUE_GoKIdxToSquare[VirtualBoard[(TargetPieceIdx + 0)]] + 0);
    }
    Call NNUE_ActDeactBulkImpl(NNUE.POAMD.From)(NNUE.POAMD.To)(NNUE.POAMD.SourcePiece)(NNUE.POAMD.PlacedPiece)(NNUE.POAMD.CapturedPiece)(NNUE.POAMD.CapSquare)(Ply);
    Call NNUE_StopBulkActivation(Ply);
    If (Glob.ProfilerMode == 2)
    {
        Call ProfilerMethodExit((((6 + Quiescence[Ply]) * Const.MaxPlyStackFrames) + Ply));
    }
}

Define NNUE_Public_OnMakeMoveStart(string Ply) (warp=true)
{
}

Define NNUE_Public_Refresh (warp=true)
{
    NNUE.PR.HiddenBiaIdx = 1;
    Repeat (Const.NNUE_HiddenPackedSize)
    {
        List.ReplaceItem(NNUE_Accumulator, NNUE.PR.HiddenBiaIdx, NNUE_HiddenBias[NNUE.PR.HiddenBiaIdx]);
        List.ReplaceItem(NNUE_Accumulator, (NNUE.PR.HiddenBiaIdx + Const.NNUE_HiddenPackedSize), NNUE_HiddenBias[NNUE.PR.HiddenBiaIdx]);
        NNUE.PR.HiddenBiaIdx += 1;
    }
    Call NNUE_StartBulkActivation(0);
    NNUE.PR.AccIdx = 1;
    Repeat (64)
    {
        If (Not ((Board[NNUE.PR.AccIdx] == 0)))
        {
            Call NNUE_Activate(NNUE.PR.AccIdx)(Board[NNUE.PR.AccIdx])(0);
        }
        NNUE.PR.AccIdx += 1;
    }
    Call NNUE_StopBulkActivation(0);
}

Define NNUE_StartBulkActivation(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 1);
}

Define NNUE_StopBulkActivation(string Ply) (warp=true)
{
    List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 3);
}

Define NNUE_UpdateAccStack(string Ply) (warp=true)
{
    If (Ply > 0)
    {
        If (NNUE_AccStackState[Ply] == 1)
        {
            Call NNUE_UpdateAccStack((Ply - 1));
            Call UpdateNNUEPostApplyMove(Ply);
            List.ReplaceItem(NNUE_AccStackState, Ply, 0);
        }
    }
}

Define OnEvaluationChanged(string Eval) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Glob.Level > 2)
    {
        OEC.ClampedEval = Eval;
        If (OEC.ClampedEval > 1000)
        {
            OEC.ClampedEval = 100;
        }
        Else
        {
            If (OEC.ClampedEval < -1000)
            {
                OEC.ClampedEval = -100;
            }
            Else
            {
                OEC.ClampedEval = (OEC.ClampedEval / 10);
            }
        }
    }
    Else
    {
        OEC.ClampedEval = 0;
    }
    If (Not ((GoK_EvaluationValue == OEC.ClampedEval)))
    {
        GoK_EvaluationValue = OEC.ClampedEval;
        Event.Broadcast("GoK_EvaluationValueChanged");
        Control.Wait(0);
    }
}

Define OnProgressChanged(string Progress) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    OPC.Percent = Operator.Round(Progress);
    If (OPC.Percent > 100)
    {
        OPC.Percent = 100;
    }
    If (OPC.Percent < 0)
    {
        OPC.Percent = 0;
    }
    If (Not ((OPC.Percent == GoK_ProgressValue)))
    {
        GoK_ProgressValue = OPC.Percent;
        Event.Broadcast("GoK_ProgressValueChanged");
        Control.Wait(0);
    }
}

Define OnRestart (warp=true)
{
    Looks.Say("");
    List.DeleteAll(Logfile);
    List.Hide(BoardHistory);
    List.Hide(GameMovesAN);
    List.Hide(ExportData);
    List.Hide(CreditsData);
    List.Hide(ExportMoves);
    List.Hide(Logfile);
    List.Hide(ProfilingData);
    Variable.Hide(Glob.IdxDeepening);
    Variable.Hide(GBM.Evaluation);
    Variable.Hide(GBM.Move);
    Variable.Hide(Glob.NPS);
    Variable.Hide(Glob.MPS);
    Variable.Hide(Glob.PV);
    Variable.Hide(Glob.CustomThinkTime);
    Glob.ProfilerMode = 1;
    Glob.DebugMode = -1;
    Glob.TimeControl = -1;
    Glob.IdxDeepening = "";
    GBM.Evaluation = "";
    Glob.NPS = "";
    Glob.MPS = "";
    Glob.PV = "";
    Glob.CustomThinkTime = 0;
}

Define PadInto(string value)(string width)(bool rightJustify) (warp=true)
{
    Ret.PadInto.Padded = value;
    Repeat Until (Not ((Variable.Length(Ret.PadInto.Padded) < width)))
    {
        If rightJustify
        {
            Ret.PadInto.Padded = Operator.Join(" ", Ret.PadInto.Padded);
        }
        Else
        {
            Ret.PadInto.Padded = Operator.Join(Ret.PadInto.Padded, " ");
        }
    }
}

Define Perft(string PerftPly)(string PerftHorizon)(string PerftStaged) (warp=true)
{
    If (PerftHorizon == 0)
    {
        Glob.PerftNodes += 1;
        Stop(this script);
    }
    Call PerftPrepareNode(PerftPly)(PerftStaged);
    If (PerftStaged == 0)
    {
        List.ReplaceItem(MovesIdx, PerftPly, 1);
        Repeat (MovesCount[PerftPly])
        {
            Call ApplyMove(PerftPly)((1 == 0));
            Call IsCheckedFast((PerftPly + 1));
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Call PerftValidateCheck(PerftPly);
                Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
            }
            Call RevertMove(PerftPly);
            List.ReplaceItem(MovesIdx, PerftPly, (MovesIdx[PerftPly] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, PerftPly, 1);
        List.ReplaceItem(PickMoveRes, PerftPly, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, PerftPly, 0);
        Repeat Until (PickMoveRes[PerftPly] == 0)
        {
            Call PickMove(PerftPly)((1 == 0))((1 == 0));
            If (PickMoveRes[PerftPly] == 1)
            {
                Call IsCheckedFast((PerftPly + 1));
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Call PerftValidateCheck(PerftPly);
                    Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
                }
                Call RevertMove(PerftPly);
            }
        }
    }
}

Define PerftDivide(string PerftDivHorizon)(string PerftDivStaged) (warp=true)
{
    List.DeleteAll(PerftDivideOut);
    Call PerftPrepareNode(1)(PerftDivStaged);
    If (PerftDivStaged == 0)
    {
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            Call ApplyMove(1)((1 == 0));
            Call IsCheckedFast(2);
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Glob.PerftNodes = 0;
                Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.PerftNodes));
            }
            Call RevertMove(1);
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, 1, 1);
        List.ReplaceItem(PickMoveRes, 1, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, 1, 0);
        Repeat Until (PickMoveRes[1] == 0)
        {
            Call PickMove(1)((1 == 0))((1 == 0));
            If (PickMoveRes[1] == 1)
            {
                Call IsCheckedFast(2);
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Glob.PerftNodes = 0;
                    Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                    List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.PerftNodes));
                }
                Call RevertMove(1);
            }
        }
    }
}

Define PerftPrepareNode(string PerftPrepPly)(string PerftPrepStaged) (warp=true)
{
    If (PerftPrepPly == 1)
    {
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
        Call SetInitialEnPassantTarget(1);
    }
    Else
    {
        List.ReplaceItem(CastlingState, PerftPrepPly, CastlingState[(PerftPrepPly - 1)]);
        List.ReplaceItem(EnPassantTarget, PerftPrepPly, EnPassantTarget[(PerftPrepPly - 1)]);
    }
    Call IsCheckedFast((PerftPrepPly + 1));
    List.ReplaceItem(CheckedState, PerftPrepPly, Ret.IsCheckedFast.IsChecked);
    List.ReplaceItem(BoardAttackedCalculated, PerftPrepPly, 0);
    Call PrepareCheckInfo(PerftPrepPly);
    If (PerftPrepStaged == 0)
    {
        Call CalcBoardAttackedOnDemand(PerftPrepPly)((1 == 0))((1 == 1))(99);
        Call GenerateMovesImplWrapper(PerftPrepPly)((1 == 0))((1 == 0));
    }
}

Define PerftValidateCheck(string ValPly) (warp=true)
{
    PVC.Source = floor((AppliedMove[ValPly] / 100));
    PVC.Target = floor((AppliedMove[ValPly] % 100));
    PVC.Fast = 0;
    Call IsCheckingPiece(PVC.Target);
    If (Ret.IsCheckingPiece.IsChecking == 1)
    {
        PVC.Fast = 1;
    }
    Call IsCheckingPieceDiscovery(PVC.Source)(PVC.Target)(ValPly);
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 1)
    {
        PVC.Fast = 1;
    }
    Call IsCheckedFast((ValPly + 2));
    PVC.Actual = Ret.IsCheckedFast.IsChecked;
    If (Not ((PVC.Fast == PVC.Actual)))
    {
        Glob.PerftCheckMismatches += 1;
        If (Glob.PerftCheckMismatches < 26)
        {
            PVC.Line = "";
            PVC.AppliedMoveIdx = 1;
            Repeat (ValPly)
            {
                PVC.Line = Operator.Join(PVC.Line, Operator.Join(AppliedMove[PVC.AppliedMoveIdx], " "));
                PVC.AppliedMoveIdx += 1;
            }
            Call TestLog("MISMATCH ply ")(ValPly)(" fast=")(PVC.Fast)(" actual=")(PVC.Actual)(" line: ")(PVC.Line);
        }
    }
}

Define PickMove(string Ply)(bool Quiescence)(bool UpdateNNUE) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call ProfilerMethodEnter((480 + Ply));
    }
    Call Comment("Staged move-generator implementation");
    If (PickPhase[Ply] == 1)
    {
        Call Comment("Phase 1: Look up hash-move from transposition table");
        List.ReplaceItem(HashMove, Ply, Const.EmptyVal);
        List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
        List.ReplaceItem(MovesCount, Ply, 0);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(BestMoveListIdx, Ply, 0);
        Call ClearMoveList(Ply);
        If ((Ply > 1) Or (1 == 1))
        {
            PM.Move = "";
            PM.Found = 0;
            If (Not ((Ply > List.Length(PVStablePrev))))
            {
                PM.Found = 1;
                PM.CalcMovesScoreListIdx = 1;
                PM.PVStablePrevIdx = 1;
                Repeat Until ((PM.CalcMovesScoreListIdx == Ply) Or (PM.Found == 0))
                {
                    If (Not ((AppliedMove[PM.CalcMovesScoreListIdx] == PVStablePrev[PM.PVStablePrevIdx])))
                    {
                        PM.Found = 0;
                    }
                    PM.CalcMovesScoreListIdx += 1;
                    PM.PVStablePrevIdx += 1;
                }
                If (PM.Found == 1)
                {
                    Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                    If List.ContainsItem(CalcMovesMoveList, PVStablePrev[Ply])
                    {
                        PM.Move = PVStablePrev[Ply];
                    }
                }
            }
            If (Ply > 1)
            {
                PM.TTQSMeta = NodeTTQSMeta[Ply];
                PM.TTHorizon = NodeTTHorizon[Ply];
                PM.TTHit = NodeTTHit[Ply];
                PM.HashMove = NodeTTMove[Ply];
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.TTMoveProbe)(HorizonAtPly[Ply])(Ply);
                }
                If (PM.TTHit == 1)
                {
                    If ((PM.Move == "") And (Not ((PM.HashMove == Const.EmptyVal))))
                    {
                        Call IsQuiescentCheckCond(Ply);
                        If ((Not (Quiescence)) Or ((Quiescence And (PM.TTHorizon == -1)) And (Not ((PM.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue)))))
                        {
                            If (Not ((floor((PM.HashMove / 100)) == 0)))
                            {
                                PM.SourceIdx = floor((PM.HashMove / 100));
                                PM.Targetdx = floor((PM.HashMove % 100));
                                PM.SourcePiece = Board[PM.SourceIdx];
                                PM.TargetPiece = Board[PM.Targetdx];
                                PM.CalcMovesScoreListIdx = ((PieceIdxLookup[abs(PM.SourcePiece)] * 10000) + ((PM.SourceIdx * 100) + PM.Targetdx));
                                If ((((PlyIsOwn[Ply] == 1) And (Not ((MoveToHash[(60000 + PM.CalcMovesScoreListIdx)] == 0)))) And ((PM.SourcePiece > 0) And (Not ((PM.TargetPiece > 0))))) Or (((PlyIsOwn[Ply] == 0) And (Not ((MoveToHash[PM.CalcMovesScoreListIdx] == 0)))) And ((PM.SourcePiece < 0) And (Not ((PM.TargetPiece < 0))))))
                                {
                                    PM.Move = PM.HashMove;
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                    }
                                }
                            }
                            Else
                            {
                                Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                                If List.ContainsItem(CalcMovesMoveList, PM.HashMove)
                                {
                                    PM.Move = PM.HashMove;
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            If (Not ((PM.Move == "")))
            {
                Call ClearMoveList(Ply);
                PM.MoveScore = 9100000;
                Call AddMoveToList(PM.Move)(Ply)(PM.MoveScore);
                List.ReplaceItem(MovesIdx, Ply, 0);
                List.ReplaceItem(PickPhase, Ply, 2);
                List.ReplaceItem(PickMoveRes, Ply, 0);
                Call PickMove.Iterate(Ply)(2)(UpdateNNUE);
                If (PickMoveRes[Ply] == 1)
                {
                    List.ReplaceItem(HashMove, Ply, PM.Move);
                    If (Glob.ProfilerMode == 2)
                    {
                        Call ProfilerMethodExit((480 + Ply));
                    }
                    Stop(this script);
                }
            }
        }
        List.ReplaceItem(PickPhase, Ply, 2);
    }
    If (PickPhase[Ply] == 2)
    {
        If (Quiescence Or ((Ply < 4) Or (CheckedState[Ply] == 1)))
        {
            List.ReplaceItem(PickPhase, Ply, 6);
        }
        Else
        {
            Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 1));
            If (Not ((HashMove[Ply] == Const.EmptyVal)))
            {
                If (Not (List.ContainsItem(CalcMovesMoveList, HashMove[Ply])))
                {
                    List.Add(CalcMovesMoveList, HashMove[Ply]);
                    List.Add(CalcMovesScoreList, 9100000);
                }
            }
            PM.CalcMovesScoreListIdx = 1;
            Repeat (List.Length(CalcMovesScoreList))
            {
                If (CalcMovesScoreList[PM.CalcMovesScoreListIdx] < 7000000)
                {
                    List.DeleteItem(CalcMovesMoveList, PM.CalcMovesScoreListIdx);
                    List.DeleteItem(CalcMovesScoreList, PM.CalcMovesScoreListIdx);
                }
                Else
                {
                    PM.CalcMovesScoreListIdx += 1;
                }
            }
            Call SortMoveList(Ply);
            List.ReplaceItem(MovesIdx, Ply, 0);
            List.ReplaceItem(PickPhase, Ply, 3);
        }
    }
    If (PickPhase[Ply] == 3)
    {
        Call PickMove.Iterate(Ply)(4)(UpdateNNUE);
    }
    If (PickPhase[Ply] == 4)
    {
        Call PrepareCurrentKillerMoves(Ply);
        PM.CounterMove = "";
        If (Ply > 1)
        {
            PM.CounterMove = HistoryCounterMoves[(PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))];
        }
        Call PickMove.TryKCMove(CurrentKillerMoves[1])(Ply)(6000000);
        Call PickMove.TryKCMove(CurrentKillerMoves[2])(Ply)(5000000);
        If (((Ply > 1) And ((Not ((PM.CounterMove == CurrentKillerMoves[1]))) And (Not ((PM.CounterMove == CurrentKillerMoves[2]))))) And (Not ((PM.CounterMove == ""))))
        {
            Call PickMove.TryKCMove(HistoryCounterMoves[(PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))])(Ply)(4000000);
        }
        List.ReplaceItem(PickPhase, Ply, 5);
    }
    If (PickPhase[Ply] == 5)
    {
        Call PickMove.Iterate(Ply)(6)(UpdateNNUE);
    }
    If (PickPhase[Ply] == 6)
    {
        Call CalcBoardAttackedOnDemand(Ply)(Quiescence)((1 == 1))(99);
        Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(PickPhase, Ply, 7);
    }
    If (PickPhase[Ply] == 7)
    {
        Call PickMove.Iterate(Ply)("*")(UpdateNNUE);
    }
    If (PickPhase[Ply] == "*")
    {
        List.ReplaceItem(PickMoveRes, Ply, 0);
    }
    If (Glob.ProfilerMode == 2)
    {
        Call ProfilerMethodExit((480 + Ply));
    }
}

Define PickMove.Iterate(string Ply)(string NextPhase)(bool UpdateNNUE) (warp=true)
{
    PMI.Picked = 1;
    Repeat Until ((PMI.Picked == 0) Or (Not ((MovesIdx[Ply] < MovesCount[Ply]))))
    {
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
        Call GetCurrentMove(Ply);
        PMI.Move = Ret.GetCurrentMove.Move;
        Call IsMovePicked(Ply)(PMI.Move);
        PMI.Picked = Ret.IsMovePicked.Picked;
        If (PMI.Picked == 0)
        {
            Call IsCastlingPathSafe(PMI.Move)(Ply);
            If (Ret.IsCastlingPathSafe.IsSafe == 0)
            {
                PMI.Picked = 1;
            }
            Else
            {
                List.ReplaceItem(PickedPseudoLegalMoves, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), PMI.Move);
                List.ReplaceItem(PickedPseudoLegalMovesScore, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])]);
                List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, (PickedPseudoLegalMovesCount[Ply] + 1));
                Call ApplyMove(Ply)(UpdateNNUE);
                Call IsMoveLegalFast(Ply);
                If (Ret.IsMoveLegalFast.IsLegal == 1)
                {
                    Call RevertMove(Ply);
                    PMI.Picked = 1;
                }
            }
        }
    }
    If (PMI.Picked == 0)
    {
        List.ReplaceItem(PickMoveRes, Ply, 1);
        Stop(this script);
    }
    List.ReplaceItem(PickPhase, Ply, NextPhase);
}

Define PickMove.TryKCMove(string Move)(string Ply)(string Score) (warp=true)
{
    If (Move == "")
    {
        Stop(this script);
    }
    PMTKCM.KCSrc = floor((Move / 100));
    If (PMTKCM.KCSrc == 0)
    {
        Stop(this script);
    }
    If ((Board[PMTKCM.KCSrc] * ((PlyIsOwn[Ply] * 2) - 1)) > 0)
    {
        PMTKCM.KCLegal = MoveToHash[((60000 * PlyIsOwn[Ply]) + ((PieceIdxLookup[abs(Board[PMTKCM.KCSrc])] * 10000) + Move))];
        If (Not ((PMTKCM.KCLegal == 0)))
        {
            Call IsMovePicked(Ply)(Move);
            If (Ret.IsMovePicked.Picked == 0)
            {
                List.DeleteAll(CalcMovesMoveList);
                List.DeleteAll(CalcMovesScoreList);
                Call GenerateMovesForSource(Ply)(PMTKCM.KCSrc)((1 == 0))((1 == 0));
                If List.ContainsItem(CalcMovesMoveList, Move)
                {
                    Call AddMoveToList(Move)(Ply)(Score);
                }
            }
        }
    }
}

Define PrepareCheckInfo(string Ply) (warp=true)
{
    List.ReplaceItem(PinCount, Ply, 0);
    List.ReplaceItem(DiscoveryCount, Ply, 0);
    CI.SideToMoveFactor = (((PlyIsOwn[Ply] == 1) * 2) - 1);
    If (PlyIsOwn[Ply] == 1)
    {
        CI.OurKingIdx = Glob.BlackKingIdx;
        PCI.TheirKingIdx = Glob.WhiteKingIdx;
    }
    Else
    {
        CI.OurKingIdx = Glob.WhiteKingIdx;
        PCI.TheirKingIdx = Glob.BlackKingIdx;
    }
    PCI.IsPin = 1;
    Repeat (2)
    {
        If (PCI.IsPin == 1)
        {
            PCI.KingIdx = CI.OurKingIdx;
            PCI.SliderFactor = -1;
        }
        Else
        {
            PCI.KingIdx = PCI.TheirKingIdx;
            PCI.SliderFactor = 1;
        }
        PCI.LineOffset = (MoveSourceIdxToListOffsetSliding[PCI.KingIdx] + 0);
        PCI.IsStraight = 1;
        Repeat (2)
        {
            If (PCI.IsStraight == 1)
            {
                PCI.SliderPiece = GoK_BlackRook;
            }
            Else
            {
                PCI.SliderPiece = GoK_BlackBishop;
            }
            PCI.DirIdx = 0;
            Repeat (4)
            {
                PCI.StepIdx = 1;
                PCI.BlockerIdx = 0;
                PCI.IsDone = 0;
                Repeat Until ((PCI.StepIdx > 8) Or (PCI.IsDone == 1))
                {
                    If (PCI.IsStraight == 1)
                    {
                        PCI.SqIdx = (MoveSlidingStraightListIdxToTargetIdx[((PCI.LineOffset + (PCI.DirIdx * 8)) + PCI.StepIdx)] + 0);
                    }
                    Else
                    {
                        PCI.SqIdx = (MoveCrossListIdxToTargetIdx[((PCI.LineOffset + (PCI.DirIdx * 8)) + PCI.StepIdx)] + 0);
                    }
                    If (PCI.SqIdx == -1)
                    {
                        PCI.IsDone = 1;
                    }
                    Else
                    {
                        PCI.Piece = (Board[PCI.SqIdx] + 0);
                        If (Not ((PCI.Piece == 0)))
                        {
                            If (PCI.BlockerIdx == 0)
                            {
                                If ((PCI.Piece * CI.SideToMoveFactor) > 0)
                                {
                                    PCI.BlockerIdx = PCI.SqIdx;
                                }
                                Else
                                {
                                    PCI.IsDone = 1;
                                }
                            }
                            Else
                            {
                                If ((((PCI.Piece * CI.SideToMoveFactor) * PCI.SliderFactor) > 0) And ((abs(PCI.Piece) == GoK_BlackQueen) Or (abs(PCI.Piece) == PCI.SliderPiece)))
                                {
                                    If (PCI.IsPin == 1)
                                    {
                                        List.ReplaceItem(PinSq, (((Ply - 1) * 8) + (PinCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(PinRay, (((Ply - 1) * 8) + (PinCount[Ply] + 1)), abs(MoveToPathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(PinCount, Ply, (PinCount[Ply] + 1));
                                    }
                                    Else
                                    {
                                        List.ReplaceItem(DiscoverySq, (((Ply - 1) * 8) + (DiscoveryCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(DiscoveryRay, (((Ply - 1) * 8) + (DiscoveryCount[Ply] + 1)), abs(MoveToPathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(DiscoveryCount, Ply, (DiscoveryCount[Ply] + 1));
                                    }
                                }
                                PCI.IsDone = 1;
                            }
                        }
                    }
                    PCI.StepIdx += 1;
                }
                PCI.DirIdx += 1;
            }
            PCI.IsStraight = 0;
        }
        PCI.IsPin = 0;
    }
}

Define PrepareCurrentKillerMoves(string Ply) (warp=true)
{
    If (Not ((List.Length(CurrentKillerMoves) == 2)))
    {
        List.DeleteAll(CurrentKillerMoves);
        List.Add(CurrentKillerMoves, "");
        List.Add(CurrentKillerMoves, "");
    }
    PCKM.KillerMoveIdx = (((Ply - 1) * 2) + 1);
    List.ReplaceItem(CurrentKillerMoves, 1, KillerMoves[PCKM.KillerMoveIdx]);
    List.ReplaceItem(CurrentKillerMoves, 2, KillerMoves[(PCKM.KillerMoveIdx + 1)]);
}

Define PrepareEvasionMask(string Ply) (warp=true)
{
    PEM.BoardAttackedEvasionTargetIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 0);
        PEM.BoardAttackedEvasionTargetIdx += 1;
    }
    Call IsCheckedFast((Ply + 1));
    If (Ret.IsCheckedFast.IsChecked == 1)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, Ret.IsCheckedFast.CheckedByIdx, 1);
        If (PlyIsOwn[Ply] == 1)
        {
            PEM.KingIdx = Glob.BlackKingIdx;
        }
        Else
        {
            PEM.KingIdx = Glob.WhiteKingIdx;
        }
        PEM.Move = ((Ret.IsCheckedFast.CheckedByIdx * 100) + PEM.KingIdx);
        PEM.BoardAttackedEvasionTargetIdx = Ret.IsCheckedFast.CheckedByIdx;
        Repeat ((MoveToPathDelta[PEM.Move] - 1))
        {
            PEM.BoardAttackedEvasionTargetIdx += MoveToPathStepInc[PEM.Move];
            List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 1);
        }
    }
}

Define PrepStats (warp=true)
{
    List.DeleteAll(ProfileByHorizon);
    Repeat (1728)
    {
        List.Add(ProfileByHorizon, 0);
    }
    List.DeleteAll(HorizonAtPly);
    Repeat (64)
    {
        List.Add(HorizonAtPly, 0);
    }
    List.DeleteAll(ProfileTimeByHorizon);
    Repeat (576)
    {
        List.Add(ProfileTimeByHorizon, 0);
    }
}

Define PrintStats (warp=true)
{
    Call Log("============================================================")("")("")("")("")("")("")("");
    PS.Line = "";
    Call PS.Cell("Function")(20)((1 == 0));
    Call PS.Cell("Invoked")(14)((1 == 1));
    Call PS.Cell("Hits/Pruned")(16)((1 == 1));
    Call PS.Cell("Ratio")(10)((1 == 1));
    Call Log(PS.Line)("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call PS.SummaryRow("TT-static-eval")(Const.Profile.TTStaticProbe)(Const.Profile.TTStaticHit)((1 == 0));
    Call PS.SummaryRow("TT-node-eval")(Const.Profile.TTNodeProbe)(Const.Profile.TTNodeHit)((1 == 0));
    Call PS.SummaryRow("TT-hashmove")(Const.Profile.TTMoveProbe)(Const.Profile.TTMoveHit)((1 == 0));
    Call PS.SummaryRow("Razoring")(Const.Profile.Razoring_Try)(Const.Profile.Razoring_Hit)((1 == 0));
    Call PS.SummaryRow("NMP")(Const.Profile.NMP_Try)(Const.Profile.NMP_Hit)((1 == 0));
    Call PS.SummaryRow("RFP")(Const.Profile.RFP_Inv)(Const.Profile.RFP_Hit)((1 == 0));
    Call PS.SummaryRow("Futility")(Const.Profile.Futility_Inv)(Const.Profile.Futility_Hit)((1 == 0));
    Call PS.SummaryRow("Delta")(Const.Profile.Delta_Inv)(Const.Profile.Delta_Hit)((1 == 0));
    Call PS.SummaryRow("QS-SEE")(Const.Profile.QSEE_Inv)(Const.Profile.QSEE_Hit)((1 == 0));
    Call PS.SummaryRow("LMR")(Const.Profile.LMR_Inv)(Const.Profile.LMR_Hit)((1 == 0));
    Call PS.SummaryRow("Non-PV search")(Const.Profile.PVS_Inv)(Const.Profile.PVS_ReSearch)((1 == 1));
    Call PS.CountRow("Full Search")(Const.Profile.Full_Inv);
    Call PS.CountRow("Extensions")(Const.Profile.Ext);
    Call PS.CountRow("Singular extensions")(Const.Profile.ExtSingular);
    Call Log("============================================================")("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon invocations and runtime, s (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 1));
    PS.H = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.H)((1 == 0));
        PS.H += 1;
    }
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon hit ratio (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 0));
    PS.H = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.H)((1 == 1));
        PS.H += 1;
    }
}

Define ProbePawnHist(string Piece)(string To) (warp=true)
{
    PPH.PawnHistKey = Glob.KPHash;
    Call GetPiecePosHash(Board[Glob.WhiteKingIdx])(Glob.WhiteKingIdx);
    PPH.PawnHistKey += (-1 * Ret.GetPiecePosHash.Hash);
    Call GetPiecePosHash(Board[Glob.BlackKingIdx])(Glob.BlackKingIdx);
    PPH.PawnHistKey += (-1 * Ret.GetPiecePosHash.Hash);
    PPH.PawnHistPieceIdx = PieceIdxLookup[GoK_WhiteKing];
    If (abs(Piece) > 0)
    {
        PPH.PawnHistPieceIdx = PieceIdxLookup[abs(Piece)];
    }
    Ret.ProbePawnHist.Idx = (((PPH.PawnHistKey % 512) * 384) + (((PPH.PawnHistPieceIdx - 1) * 64) + To));
}

Define ProfilerMethodEnter(string Id) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Repeat Until (Not ((List.Length(ProfilingData) < Id)))
        {
            List.Add(ProfilingData, 0);
        }
        List.ReplaceItem(ProfilingData, Id, (ProfilingData[Id] - ((Sensing.DaysSince2000() * 24) * 3600)));
        ProfMEn.Cat = floor(((Id - 1) / 60));
        ProfMEn.D = (Id - (ProfMEn.Cat * 60));
        Call Profile_TimeByHorizon((ProfMEn.Cat * 64))(ProfMEn.D)(-1);
    }
}

Define ProfilerMethodExit(string Id) (warp=false)
{
    If (Glob.ProfilerMode == 2)
    {
        List.ReplaceItem(ProfilingData, Id, (ProfilingData[Id] + ((Sensing.DaysSince2000() * 24) * 3600)));
        ProfMEx.Cat = floor(((Id - 1) / 60));
        ProfMEx.D = (Id - (ProfMEx.Cat * 60));
        Call Profile_TimeByHorizon((ProfMEx.Cat * 64))(ProfMEx.D)(1);
    }
}

Define ProfilerReset (warp=true)
{
    List.DeleteItem(ProfilingData, all);
}

Define Profile_CountByHorizon(string Base)(string HorizonVal)(string Ply) (warp=true)
{
    ProfCBH.Slot = (HorizonVal + 1);
    If (Quiescence[Ply] == 1)
    {
        ProfCBH.Slot = 64;
    }
    List.ReplaceItem(ProfileByHorizon, (Base + ProfCBH.Slot), (ProfileByHorizon[(Base + ProfCBH.Slot)] + 1));
}

Define Profile_TimeByHorizon(string Base)(string PlyIdx)(string Sign) (warp=true)
{
    ProfTBH.Slot = (HorizonAtPly[PlyIdx] + 1);
    If (Quiescence[PlyIdx] == 1)
    {
        ProfTBH.Slot = 64;
    }
    List.ReplaceItem(ProfileTimeByHorizon, (Base + ProfTBH.Slot), (ProfileTimeByHorizon[(Base + ProfTBH.Slot)] + (Sign * ((Sensing.DaysSince2000() * 24) * 3600))));
}

Define PS.Cell(string Value)(string Width)(bool RightJustify) (warp=true)
{
    Call PadInto(Value)(Width)(RightJustify);
    PS.Line = Operator.Join(PS.Line, Ret.PadInto.Padded);
}

Define PS.CountRow(string Label)(string Slot) (warp=true)
{
    Call PS.Sum(Slot);
    PS.Line = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(Ret.PS.Sum.Total)(14)((1 == 1));
    Call Log(PS.Line)("")("")("")("")("")("")("");
}

Define PS.HorizonHeader(bool WithTimes) (warp=true)
{
    PS.Line = "";
    Call PS.Cell("Horizon")(9)((1 == 0));
    Call PS.Cell("Razor")(9)((1 == 1));
    Call PS.Cell("RFP")(9)((1 == 1));
    Call PS.Cell("NMP")(9)((1 == 1));
    Call PS.Cell("Futil")(9)((1 == 1));
    Call PS.Cell("Delta")(9)((1 == 1));
    Call PS.Cell("QSEE")(9)((1 == 1));
    Call PS.Cell("LMR")(9)((1 == 1));
    Call PS.Cell("PVS")(9)((1 == 1));
    Call PS.Cell("TTnode")(9)((1 == 1));
    Call PS.Cell("TThash")(9)((1 == 1));
    If WithTimes
    {
        Call PS.Cell("EvalS")(9)((1 == 1));
        Call PS.Cell("MgenS")(9)((1 == 1));
        Call PS.Cell("PickS")(9)((1 == 1));
    }
    Call Log(PS.Line)("")("")("")("")("")("")("");
}

Define PS.HorizonRow(string H)(bool Ratios) (warp=true)
{
    If ((((((((((ProfileByHorizon[(Const.Profile.Razoring_Inv + H)] + ProfileByHorizon[(Const.Profile.RFP_Inv + H)]) + ProfileByHorizon[(Const.Profile.NMP_Inv + H)]) + ProfileByHorizon[(Const.Profile.Futility_Inv + H)]) + ProfileByHorizon[(Const.Profile.Delta_Inv + H)]) + ProfileByHorizon[(Const.Profile.QSEE_Inv + H)]) + ProfileByHorizon[(Const.Profile.LMR_Inv + H)]) + ProfileByHorizon[(Const.Profile.PVS_Inv + H)]) + ProfileByHorizon[(Const.Profile.TTNodeProbe + H)]) + ProfileByHorizon[(Const.Profile.TTMoveProbe + H)]) > 0)
    {
        If (H == 64)
        {
            PS.Label = "Q";
        }
        Else
        {
            PS.Label = (H - 1);
        }
        PS.Line = "";
        Call PS.Cell(PS.Label)(9)((1 == 0));
        If Ratios
        {
            Call PS.RatioCell(Const.Profile.Razoring_Hit)(Const.Profile.Razoring_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.RFP_Hit)(Const.Profile.RFP_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.NMP_Hit)(Const.Profile.NMP_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.Futility_Hit)(Const.Profile.Futility_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.Delta_Hit)(Const.Profile.Delta_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.QSEE_Hit)(Const.Profile.QSEE_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.LMR_Hit)(Const.Profile.LMR_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.PVS_ReSearch)(Const.Profile.PVS_Inv)(H)((1 == 1));
            Call PS.RatioCell(Const.Profile.TTNodeHit)(Const.Profile.TTNodeProbe)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.TTMoveHit)(Const.Profile.TTMoveProbe)(H)((1 == 0));
        }
        Else
        {
            Call PS.Cell(ProfileByHorizon[(Const.Profile.Razoring_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.RFP_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.NMP_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.Futility_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.Delta_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.QSEE_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.LMR_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.PVS_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTNodeProbe + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTMoveProbe + H)])(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(0 + H)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * (ProfileTimeByHorizon[(128 + H)] + ProfileTimeByHorizon[(192 + H)]))) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(512 + H)])) / 100))(9)((1 == 1));
        }
        Call Log(PS.Line)("")("")("")("")("")("")("");
    }
}

Define PS.RatioCell(string HitSlot)(string InvSlot)(string H)(bool HitSlotCountsMisses) (warp=true)
{
    PS.Inv = ProfileByHorizon[(InvSlot + H)];
    PS.Hit = ProfileByHorizon[(HitSlot + H)];
    If HitSlotCountsMisses
    {
        PS.Hit = (PS.Inv - PS.Hit);
    }
    Call PS.Cell(Operator.Join((floor(((1000 * PS.Hit) / (PS.Inv + (PS.Inv == 0)))) / 10), "%"))(9)((1 == 1));
}

Define PS.Sum(string Slot) (warp=true)
{
    Ret.PS.Sum.Total = 0;
    PS.SumIdx = 1;
    Repeat (64)
    {
        Ret.PS.Sum.Total += ProfileByHorizon[(Slot + PS.SumIdx)];
        PS.SumIdx += 1;
    }
}

Define PS.SummaryRow(string Label)(string InvSlot)(string HitSlot)(bool HitSlotCountsMisses) (warp=true)
{
    Call PS.Sum(InvSlot);
    PS.Inv = Ret.PS.Sum.Total;
    Call PS.Sum(HitSlot);
    PS.Hit = Ret.PS.Sum.Total;
    If HitSlotCountsMisses
    {
        PS.Hit = (PS.Inv - PS.Hit);
    }
    PS.Line = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(PS.Inv)(14)((1 == 1));
    Call PS.Cell(PS.Hit)(16)((1 == 1));
    Call PS.Cell(Operator.Join(floor(((100 * PS.Hit) / (PS.Inv + (PS.Inv == 0)))), "%"))(10)((1 == 1));
    Call Log(PS.Line)("")("")("")("")("")("")("");
}

Define QuickSort (warp=true)
{
    List.DeleteAll(QSPartStack);
    Call QuickSortImpl(1)(List.Length(CalcMovesScoreList));
}

Define QuickSortImpl(string Lo)(string Hi) (warp=true)
{
    QSI.QSPivot = CalcMovesScoreList[floor(((Lo + Hi) / 2))];
    QSI.QSLower = Lo;
    QSI.QSUpper = Hi;
    Repeat Until (QSI.QSLower > QSI.QSUpper)
    {
        Repeat Until (Not ((CalcMovesScoreList[QSI.QSLower] > QSI.QSPivot)))
        {
            QSI.QSLower += 1;
        }
        Repeat Until (Not ((CalcMovesScoreList[QSI.QSUpper] < QSI.QSPivot)))
        {
            QSI.QSUpper += -1;
        }
        If (Not ((QSI.QSLower > QSI.QSUpper)))
        {
            QSI.QSSwap = CalcMovesScoreList[QSI.QSLower];
            List.ReplaceItem(CalcMovesScoreList, QSI.QSLower, CalcMovesScoreList[QSI.QSUpper]);
            List.ReplaceItem(CalcMovesScoreList, QSI.QSUpper, QSI.QSSwap);
            QSI.QSSwap = CalcMovesMoveList[QSI.QSLower];
            List.ReplaceItem(CalcMovesMoveList, QSI.QSLower, CalcMovesMoveList[QSI.QSUpper]);
            List.ReplaceItem(CalcMovesMoveList, QSI.QSUpper, QSI.QSSwap);
            QSI.QSLower += 1;
            QSI.QSUpper += -1;
        }
    }
    If (Lo < QSI.QSUpper)
    {
        List.Add(QSPartStack, QSI.QSLower);
        Call QuickSortImpl(Lo)(QSI.QSUpper);
        QSI.QSLower = QSPartStack[List.Length(QSPartStack)];
        List.DeleteItem(QSPartStack, List.Length(QSPartStack));
    }
    If (QSI.QSLower < Hi)
    {
        Call QuickSortImpl(QSI.QSLower)(Hi);
    }
}

Define RevertMove(num Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
        Call SetInitialEnPassantTarget(1);
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
    }
    RM.Move = AppliedMove[Ply];
    RM.SourceIdx = floor((RM.Move / 100));
    If (RM.SourceIdx > 0)
    {
        RM.TargetIdx = floor((RM.Move % 100));
        List.ReplaceItem(Board, RM.SourceIdx, Board[RM.TargetIdx]);
        List.ReplaceItem(Board, RM.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (PromotionPieces[Ply] > 0)
        {
            RM.PromotionVal = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
            If (RM.PromotionVal == 1)
            {
                Glob.BlackQueenCountLocal += -1;
            }
            If (RM.PromotionVal == 2)
            {
                Glob.BlackRookCountLocal += -1;
                Glob.BlackNonQueenMajorMinorCountLocal += -1;
            }
            If (RM.PromotionVal == 3)
            {
                Glob.BlackNonQueenMajorMinorCountLocal += -1;
            }
            If (RM.PromotionVal == 4)
            {
                Glob.BlackNonQueenMajorMinorCountLocal += -1;
            }
            List.ReplaceItem(Board, RM.SourceIdx, GoK_BlackPawn);
            Glob.BlackPawnCountLocal += 1;
        }
        Else
        {
            If (PromotionPieces[Ply] < 0)
            {
                RM.PromotionVal = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
                If (RM.PromotionVal == 1)
                {
                    Glob.WhiteQueenCountLocal += -1;
                }
                If (RM.PromotionVal == 2)
                {
                    Glob.WhiteRookCountLocal += -1;
                    Glob.WhiteNonQueenMajorMinorCountLocal += -1;
                }
                If (RM.PromotionVal == 3)
                {
                    Glob.WhiteNonQueenMajorMinorCountLocal += -1;
                }
                If (RM.PromotionVal == 4)
                {
                    Glob.WhiteNonQueenMajorMinorCountLocal += -1;
                }
                List.ReplaceItem(Board, RM.SourceIdx, GoK_WhitePawn);
                Glob.WhitePawnCountLocal += 1;
            }
        }
        If (Board[RM.SourceIdx] == GoK_BlackKing)
        {
            Glob.BlackKingIdx = RM.SourceIdx;
        }
        If (Board[RM.SourceIdx] == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = RM.SourceIdx;
        }
        RM.TargetPiece = TargetPieces[Ply];
        If (RM.TargetPiece > 0)
        {
            If (RM.TargetPiece == GoK_BlackPawn)
            {
                Glob.BlackPawnCountLocal += 1;
            }
            Else
            {
                If (RM.TargetPiece < GoK_BlackQueen)
                {
                    Glob.BlackNonQueenMajorMinorCountLocal += 1;
                    If (RM.TargetPiece == GoK_BlackRook)
                    {
                        Glob.BlackRookCountLocal += 1;
                    }
                    If (RM.TargetPiece == GoK_BlackBishop)
                    {
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_BlackQueen)
                    {
                        Glob.BlackQueenCountLocal += 1;
                    }
                }
            }
        }
        If (RM.TargetPiece < 0)
        {
            If (RM.TargetPiece == GoK_WhitePawn)
            {
                Glob.WhitePawnCountLocal += 1;
            }
            Else
            {
                If (RM.TargetPiece > GoK_WhiteQueen)
                {
                    Glob.WhiteNonQueenMajorMinorCountLocal += 1;
                    If (RM.TargetPiece == GoK_WhiteRook)
                    {
                        Glob.WhiteRookCountLocal += 1;
                    }
                    If (RM.TargetPiece == GoK_WhiteBishop)
                    {
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_WhiteQueen)
                    {
                        Glob.WhiteQueenCountLocal += 1;
                    }
                }
            }
        }
    }
    Else
    {
        If (RM.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(Board, VirtualBoard[61], GoK_WhiteKing);
            List.ReplaceItem(Board, VirtualBoard[62], 0);
            List.ReplaceItem(Board, VirtualBoard[63], 0);
            List.ReplaceItem(Board, VirtualBoard[64], GoK_WhiteRook);
            Glob.WhiteKingIdx = VirtualBoard[61];
        }
        Else
        {
            If (RM.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(Board, VirtualBoard[57], GoK_WhiteRook);
                List.ReplaceItem(Board, VirtualBoard[59], 0);
                List.ReplaceItem(Board, VirtualBoard[60], 0);
                List.ReplaceItem(Board, VirtualBoard[61], GoK_WhiteKing);
                Glob.WhiteKingIdx = VirtualBoard[61];
            }
            Else
            {
                If (RM.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(Board, VirtualBoard[5], GoK_BlackKing);
                    List.ReplaceItem(Board, VirtualBoard[6], 0);
                    List.ReplaceItem(Board, VirtualBoard[7], 0);
                    List.ReplaceItem(Board, VirtualBoard[8], GoK_BlackRook);
                    Glob.BlackKingIdx = VirtualBoard[5];
                }
                Else
                {
                    If (RM.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(Board, VirtualBoard[1], GoK_BlackRook);
                        List.ReplaceItem(Board, VirtualBoard[4], 0);
                        List.ReplaceItem(Board, VirtualBoard[3], 0);
                        List.ReplaceItem(Board, VirtualBoard[5], GoK_BlackKing);
                        Glob.BlackKingIdx = VirtualBoard[5];
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
    Glob.KPHash = (PreviousBoardHashKP[Ply] + 0);
    List.ReplaceItem(AppliedMove, Ply, "");
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
}

Define RevertMoveLight(string Ply) (warp=true)
{
    RML.Move = AppliedMove[Ply];
    RML.SourceIdx = floor((RML.Move / 100));
    If (RML.SourceIdx > 0)
    {
        RML.TargetIdx = floor((RML.Move % 100));
        List.ReplaceItem(Board, RML.SourceIdx, Board[RML.TargetIdx]);
        List.ReplaceItem(Board, RML.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (Board[RML.SourceIdx] == GoK_BlackKing)
        {
            Glob.BlackKingIdx = RML.SourceIdx;
        }
        If (Board[RML.SourceIdx] == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = RML.SourceIdx;
        }
    }
    Else
    {
        If (RML.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(Board, VirtualBoard[61], GoK_WhiteKing);
            List.ReplaceItem(Board, VirtualBoard[62], 0);
            List.ReplaceItem(Board, VirtualBoard[63], 0);
            List.ReplaceItem(Board, VirtualBoard[64], GoK_WhiteRook);
            Glob.WhiteKingIdx = VirtualBoard[61];
        }
        Else
        {
            If (RML.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(Board, VirtualBoard[57], GoK_WhiteRook);
                List.ReplaceItem(Board, VirtualBoard[59], 0);
                List.ReplaceItem(Board, VirtualBoard[60], 0);
                List.ReplaceItem(Board, VirtualBoard[61], GoK_WhiteKing);
                Glob.WhiteKingIdx = VirtualBoard[61];
            }
            Else
            {
                If (RML.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(Board, VirtualBoard[5], GoK_BlackKing);
                    List.ReplaceItem(Board, VirtualBoard[6], 0);
                    List.ReplaceItem(Board, VirtualBoard[7], 0);
                    List.ReplaceItem(Board, VirtualBoard[8], GoK_BlackRook);
                    Glob.BlackKingIdx = VirtualBoard[5];
                }
                Else
                {
                    If (RML.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(Board, VirtualBoard[1], GoK_BlackRook);
                        List.ReplaceItem(Board, VirtualBoard[4], 0);
                        List.ReplaceItem(Board, VirtualBoard[3], 0);
                        List.ReplaceItem(Board, VirtualBoard[5], GoK_BlackKing);
                        Glob.BlackKingIdx = VirtualBoard[5];
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
}

Define SayAsync(string Text)(num Duration) (warp=false)
{
    Glob.SayAsyncText = Text;
    Glob.SayAsyncDuration = Duration;
    Event.Broadcast("sayasyncmsg");
}

Define Search(string Alpha)(string Beta)(string Horizon)(string Ply)(bool InitialDeepening) (warp=true)
{
    Glob.IsInitialDeepening = (InitialDeepening + 0);
    Glob.SearchAlpha = Alpha;
    Glob.SearchBeta = Beta;
    Call InitSearch(Horizon);
    Call Evaluate(0)((1 == 1));
    Glob.MoveCount = 0;
    Glob.MoveCountQ = 0;
    Glob.NodeCount = 0;
    Glob.NodeCountQ = 0;
    Glob.ProfBestMoveCount = 0;
    Glob.ProfBestMoveIdxSum = 0;
    Glob.ProfBestMoveCountQ = 0;
    Glob.ProfBestMoveIdxSumQ = 0;
    Search.Timer = (Sensing.DaysSince2000() * 86400);
    Call SearchImpl(Alpha)(Beta)(Horizon)(Ply)((1 == 0))((1 == 0))(Const.EmptyVal);
    Ret.Search.Eval = Ret.SearchImpl.Eval;
    Ret.Search.Move = Ret.SearchImpl.Move;
    Search.Timer = ((Sensing.DaysSince2000() * 86400) - Search.Timer);
    Call ExportBoardFEN((Glob.IsPlayerBlack == 1))((1 == 0));
    Call Log("PV: ")("[FEN "")(Ret.ExportBoardFEN.FEN)(""] ")(Glob.PV)("")("")("");
    If (Glob.ProfilerMode == 2)
    {
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log("SEARCH STATS")("")("")("")("")("")("")("");
        Call Log("Depth = ")(Horizon)(", Time = ")((Operator.Round((Search.Timer * 100)) / 100))("")("")("")("");
        Call Log((Glob.MoveCount + Glob.MoveCountQ))(" moves (all), ")((Operator.Round((((Glob.MoveCount + Glob.MoveCountQ) / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log((Glob.NodeCount + Glob.NodeCountQ))(" nodes (all), ")((Operator.Round((((Glob.NodeCount + Glob.NodeCountQ) / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call Log("Avg. best move idx (full) = ")((Operator.Round(((Glob.ProfBestMoveIdxSum / Glob.ProfBestMoveCount) * 100)) / 100))("")("")("")("")("")("");
        Call Log("Avg. best move idx (q) = ")((Operator.Round(((Glob.ProfBestMoveIdxSumQ / Glob.ProfBestMoveCountQ) * 100)) / 100))("")("")("")("")("")("");
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log(Glob.MoveCount)(" moves (full), ")((Operator.Round(((Glob.MoveCount / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log(Glob.NodeCount)(" nodes (full), ")((Operator.Round(((Glob.NodeCount / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call Log(Glob.MoveCountQ)(" moves (q), ")((Operator.Round(((Glob.MoveCountQ / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log(Glob.NodeCountQ)(" nodes (q), ")((Operator.Round(((Glob.NodeCountQ / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call PrintStats;
    }
    Glob.MPS = Operator.Round(((Glob.MoveCount + Glob.MoveCountQ) / Search.Timer));
    Glob.NPS = Operator.Round(((Glob.NodeCount + Glob.NodeCountQ) / Search.Timer));
    If (Not ((Ret.Search.Move == "")))
    {
        List.DeleteAll(PVStablePrev);
        Search.PVStableIdx = 1;
        Repeat (List.Length(PVStable))
        {
            List.Add(PVStablePrev, PVStable[Search.PVStableIdx]);
            Search.PVStableIdx += 1;
        }
        If (Not ((Ret.Search.Eval < Beta)))
        {
            Call StoreKillerMove(1)(Ret.Search.Move)(Horizon)((1 == 0))((1 == 0))((1 == 1));
        }
    }
}

Define SearchImpl(string Alpha)(string Beta)(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    List.ReplaceItem(Alphas, Ply, Alpha);
    List.ReplaceItem(Betas, Ply, Beta);
    If (Ply == 1)
    {
        Ret.SearchImpl.Eval = "";
        Ret.SearchImpl.Move = "";
    }
    If (Glob.ProfilerMode == 2)
    {
        List.ReplaceItem(HorizonAtPly, Ply, Horizon);
    }
    Call Comment("Search function (minimax / alpha-beta pruning)");
    List.ReplaceItem(SearchEval, Ply, Const.EmptyVal);
    If (Glob.IsSearchTimeout == 1)
    {
        Stop(this script);
    }
    Call Comment("Required for TT access and draw detection");
    Call Search_InitStack(Ply)(Quiescence);
    Call Search_DetectCheckmate(Ply);
    If (Not ((SearchEval[Ply] == Const.EmptyVal)))
    {
        Stop(this script);
    }
    Call Search_DetectDrawByRepetition(Ply)(Quiescence);
    If (Not ((SearchEval[Ply] == Const.EmptyVal)))
    {
        Stop(this script);
    }
    Call TTProbeNodeAtPly(Ply);
    Call Search_TTProbeEval(Horizon)(Ply)(Quiescence)(ExcludedMove);
    If (Not ((SearchEval[Ply] == Const.EmptyVal)))
    {
        Stop(this script);
    }
    Call Search_DetectDraw(Horizon)(Ply);
    If (Not ((SearchEval[Ply] == Const.EmptyVal)))
    {
        Stop(this script);
    }
    If (Ply > (Const.MaxPlyStackFrames - 10))
    {
        Call Comment("Search tree leaf reached => evaluate board and return result");
        Call Comment("This will seldomly be invoked, as the usual search termination is quiescence search having reached a quite position");
        Call Evaluate((Ply - 1))((1 == 1));
        List.ReplaceItem(SearchEval, Ply, (Ret.Evaluate.Score * PlySign[Ply]));
        Stop(this script);
    }
    If (CheckedState[Ply] == 0)
    {
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_CountByHorizon(Const.Profile.TTStaticProbe)(HorizonAtPly[Ply])(Ply);
        }
        If (Not ((NodeTTStaticEval[Ply] == Const.EmptyVal)))
        {
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.TTStaticHit)(HorizonAtPly[Ply])(Ply);
            }
            Call AdjustEvalScore(Ply)(NodeTTStaticEval[Ply]);
        }
    }
    If (Not (Quiescence))
    {
        If ((Ply > 1) And (((CheckedState[Ply] == 0) And ((Betas[Ply] - Alphas[Ply]) == 1)) And (ExcludedMove == Const.EmptyVal)))
        {
            Call GetStaticEval(Ply);
            Call Search_Razoring(Horizon)(Ply)(Quiescence)(ExcludedMove);
            If (Not ((SearchEval[Ply] == Const.EmptyVal)))
            {
                Stop(this script);
            }
            Call Search_ReverseFutilityPruning(Horizon)(Ply);
            If (Not ((SearchEval[Ply] == Const.EmptyVal)))
            {
                Stop(this script);
            }
            Call Search_NullMovePruning(Horizon)(Ply)(Cutnode)(Quiescence);
            If (Not ((SearchEval[Ply] == Const.EmptyVal)))
            {
                Stop(this script);
            }
        }
        Call Search_InternalIterativeDeepening(Horizon)(Ply)(Cutnode)(Quiescence);
    }
    Else
    {
        Call Comment("Quiescence search => standing pat handling (unless in check and must evade)");
        Call Comment("Important to consider in subsequent code that node eval might be set from here on");
        If (CheckedState[Ply] == 1)
        {
            Call Comment("Put a checkmate baseline into node eval, which must be improved later by at east one move that gets us out of check");
            List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
        }
        Else
        {
            Call GetStaticEval(Ply);
            List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
            If (Not ((StaticEval[Ply] < Betas[Ply])))
            {
                Call Comment("Failing high => cutoff");
                If (1 == 1)
                {
                    Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(SearchEval[Ply])(Const.EmptyVal)("B")(Const.EmptyVal)(-1)(0)(NodeTTStaticEval[Ply]);
                }
                Stop(this script);
            }
            If (StaticEval[Ply] > Alphas[Ply])
            {
                List.ReplaceItem(Alphas, Ply, StaticEval[Ply]);
            }
        }
    }
    List.ReplaceItem(PickPhase, Ply, 1);
    List.ReplaceItem(PickMoveRes, Ply, 1);
    List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCount, Ply, 0);
    Call PrepareCheckInfo(Ply);
    Call Comment("Move generation and move loop");
    Repeat Until (PickMoveRes[Ply] == 0)
    {
        If ((Not (Quiescence)) And ((Ply == 1) Or (Horizon > 3)))
        {
            If ((Glob.IsSearchTimeout == 0) And ((Not ((Glob.IsInitialDeepening == 1))) Or (Not ((Ret.SearchImpl.Move == "")))))
            {
                If (((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) > Glob.ThinkTimeLimitSearch)
                {
                    Glob.IsSearchTimeout = 1;
                }
            }
        }
        If (Glob.IsSearchTimeout == 1)
        {
            If (Quiescence[Ply] == 0)
            {
                Glob.MoveCount += MovesCount[Ply];
            }
            Else
            {
                Glob.MoveCountQ += MovesCount[Ply];
            }
            Stop(this script);
        }
        If (Glob.ProfilerMode == 2)
        {
            Call ProfilerMethodEnter(((5 * Const.MaxPlyStackFrames) + Ply));
        }
        Call Comment("Invoke staged move generator and apply next move from list");
        Call NNUE_Public_OnMakeMoveStart(Ply);
        Call PickMove(Ply)(Quiescence)((1 == 0));
        If (PickMoveRes[Ply] == 1)
        {
            If ((Not (Quiescence)) And (AppliedMove[Ply] == ExcludedMove))
            {
                Call RevertMove(Ply);
                Call PickMove(Ply)(Quiescence)((1 == 0));
            }
        }
        If (PickMoveRes[Ply] == 1)
        {
            List.ReplaceItem(PickedLegalMovesCount, Ply, (PickedLegalMovesCount[Ply] + 1));
            If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
            {
                List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, (PickedLegalMovesCountQuiet[Ply] + 1));
            }
        }
        If (Glob.ProfilerMode == 2)
        {
            Call ProfilerMethodExit(((5 * Const.MaxPlyStackFrames) + Ply));
        }
        If (PickMoveRes[Ply] == 1)
        {
            Call Comment("Show progress and collect statistics");
            List.ReplaceItem(PutsInCheck, Ply, 0);
            List.ReplaceItem(ReductionBase, Ply, Const.EmptyVal);
            List.ReplaceItem(SearchExtension, Ply, 0);
            Call Comment("Check detection for current move: does it put the opponent in check");
            Call GivesCheckFast(Ply);
            List.ReplaceItem(PutsInCheck, Ply, Ret.GivesCheckFast.GivesCheck);
            Call Search_FutilityPruning(Horizon)(Ply)(Quiescence);
            If (Ret.Search_FutilityPruning.IsFutile == 1)
            {
                If (Glob.ProfilerMode == 2)
                {
                    Call Search_CollectStats(Horizon)(Ply)(Quiescence)(Const.Profile.Delta_Hit)(Const.Profile.Futility_Hit);
                }
                Call RevertMove(Ply);
                If ((Ply == 1) And (Glob.IsSearchTimeout == 0))
                {
                    Call GetCurrentMove(Ply);
                    List.Add(SearchRootMovesDone, Ret.GetCurrentMove.Move);
                }
            }
            Else
            {
                Call NNUE_OnApplyMove(Ply);
                Call Search_DetectExtensions(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
                If (SearchExtension[Ply] == "*")
                {
                    Call RevertMove(Ply);
                    List.ReplaceItem(PickPhase, Ply, "*");
                }
                Else
                {
                    Call Comment("Late move reduction and PV search (null window), will prune all moves that are not worth covering with full depth + current window search");
                    Call Search_Core(Horizon)(Ply)(Cutnode)(Quiescence);
                    SI.NodeEval = Ret.Search_Core.NodeEval;
                    If ((Ply == 1) And (Glob.IsSearchTimeout == 0))
                    {
                        List.Add(SearchRootMovesDone, AppliedMove[Ply]);
                    }
                    Call Comment("Revert applied move, restore board to previous state");
                    Call RevertMove(Ply);
                    If (Glob.IsSearchTimeout == 1)
                    {
                        If (Quiescence[Ply] == 0)
                        {
                            Glob.MoveCount += MovesCount[Ply];
                        }
                        Else
                        {
                            Glob.MoveCountQ += MovesCount[Ply];
                        }
                        Stop(this script);
                    }
                    If (Not ((SI.NodeEval == Const.EmptyVal)))
                    {
                        Call Comment("Compare node evaluation with search window, adapt node evaluation result and alpha/beta funnel accordingly");
                        If ((SI.NodeEval > SearchEval[Ply]) Or (SearchEval[Ply] == Const.EmptyVal))
                        {
                            List.ReplaceItem(SearchEval, Ply, SI.NodeEval);
                            If ((Ply == 1) And (Glob.IsSearchTimeout == 0))
                            {
                                If (Not ((SI.NodeEval < (0 - Const.AbsMaxCheckmateEval))))
                                {
                                    Call GetCurrentMove(Ply);
                                    Ret.SearchImpl.Move = Ret.GetCurrentMove.Move;
                                    Ret.SearchImpl.Eval = SI.NodeEval;
                                }
                            }
                            If (SI.NodeEval > Alphas[Ply])
                            {
                                Call GetCurrentMove(Ply);
                                List.ReplaceItem(BestMoves, Ply, Ret.GetCurrentMove.Move);
                                List.ReplaceItem(BestMoveListIdx, Ply, MovesIdx[Ply]);
                                Call UpdatePV(Ply)(Ret.GetCurrentMove.Move);
                                If Quiescence
                                {
                                    If ((Not (((Betas[Ply] - Alphas[Ply]) == 1))) And (SI.NodeEval < Betas[Ply]))
                                    {
                                        List.ReplaceItem(Alphas, Ply, SI.NodeEval);
                                    }
                                    Else
                                    {
                                        Call Comment("Quiescence cutoff");
                                        List.ReplaceItem(MovesIdx, Ply, (MovesCount[Ply] + 1));
                                        List.ReplaceItem(PickPhase, Ply, "*");
                                    }
                                }
                                Else
                                {
                                    List.ReplaceItem(Alphas, Ply, SI.NodeEval);
                                    If ((Ply == 1) And (Glob.IsSearchTimeout == 0))
                                    {
                                        If (Not ((SI.NodeEval < (0 - Const.AbsMaxCheckmateEval))))
                                        {
                                            Call Comment("Best move found for depth = 1, special handling (re-use history for iterative deepening order, logging, move preview visualization)");
                                            If (SI.NodeEval > Glob.SearchAlpha)
                                            {
                                                Call Search_OnBestRootMoveFound(Ret.SearchImpl.Move)(Ret.SearchImpl.Eval);
                                                If ((SI.NodeEval > (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + Horizon))) And (SI.NodeEval < Glob.SearchBeta))
                                                {
                                                    Glob.IsSearchTimeout = 1;
                                                    Stop(this script);
                                                }
                                                If (Not ((Ret.SearchImpl.Eval < Glob.SearchBeta)))
                                                {
                                                    Call Comment("AW fail high => terminate immediately");
                                                    Stop(this script);
                                                }
                                            }
                                        }
                                    }
                                    If (Not ((SI.NodeEval < Betas[Ply])))
                                    {
                                        If (Ply > 1)
                                        {
                                            Call Comment("Full search cutoff");
                                            List.ReplaceItem(MovesIdx, Ply, (MovesCount[Ply] + 1));
                                            List.ReplaceItem(PickPhase, Ply, "*");
                                        }
                                    }
                                }
                            }
                        }
                        If (Not (Quiescence))
                        {
                            If ((LMRState[Ply] == 2) Or (LMRState[Ply] == 3))
                            {
                                Call GetCurrentMove(Ply);
                                Call StoreKillerMove(Ply)(Ret.GetCurrentMove.Move)(Horizon)((LMRState[Ply] == 3))((1 == 1))((1 == 1));
                            }
                        }
                    }
                }
            }
        }
    }
    Call Comment("Evaluation alpha-bound, beta-bound or exact?");
    If (Not ((SearchEval[Ply] < Betas[Ply])))
    {
        List.ReplaceItem(NodeTypes, Ply, "B");
    }
    Else
    {
        If ((Not (((Betas[Ply] - Alphas[Ply]) == 1))) And (((Not (Quiescence)) Or (SearchEval[Ply] > AlphasOld[Ply])) And (Not ((BestMoves[Ply] == Const.EmptyVal)))))
        {
            List.ReplaceItem(NodeTypes, Ply, "E");
        }
        Else
        {
            List.ReplaceItem(NodeTypes, Ply, "A");
        }
    }
    If ((Glob.IsSearchTimeout == 0) And (ExcludedMove == Const.EmptyVal))
    {
        If (PickedLegalMovesCount[Ply] == 0)
        {
            If (CheckedState[Ply] == 1)
            {
                If (((Not (Quiescence)) And (ExcludedMove == Const.EmptyVal)) Or Quiescence)
                {
                    Call Comment("Fast search checkmate detection (no check evasion found)");
                    List.ReplaceItem(NodeTypes, Ply, "E");
                    List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
                }
            }
            Else
            {
                If ((Not (Quiescence)) And (ExcludedMove == Const.EmptyVal))
                {
                    List.ReplaceItem(NodeTypes, Ply, "E");
                    Call CalcBoardAttackedByMoveChecked((Ply + 1));
                    If (((PlyIsOwn[Ply] == 1) And (Glob.IsBlackChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsWhiteChecked == 1)))
                    {
                        List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
                    }
                    Else
                    {
                        List.ReplaceItem(SearchEval, Ply, 0);
                    }
                }
            }
        }
        If ((Not (Quiescence)) And (Not ((BestMoves[Ply] == Const.EmptyVal))))
        {
            Call StoreKillerMove(Ply)(BestMoves[Ply])(Horizon)((1 == 0))((1 == 0))((1 == 1));
            If ((PickedPseudoLegalMovesCount[Ply] < MovesCount[Ply]) And (Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + BestMoveListIdx[Ply])] == BestMoves[Ply]))
            {
                Call StoreKillerMoveMalus(Ply)(Horizon)(BestMoveListIdx[Ply]);
            }
        }
        If (((Glob.IsSearchTimeout == 0) And (Ply > 1)) And (ExcludedMove == Const.EmptyVal))
        {
            Call Comment("Store evaluations, hash moves, attack tables, check state, mobility, ... to transposition table");
            SI.BestMoveStore = BestMoves[Ply];
            If (SI.BestMoveStore == Const.EmptyVal)
            {
                SI.BestMoveStore = Const.EmptyVal;
            }
            If Quiescence
            {
                Call IsQuiescentCheckCond(Ply);
                Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(SearchEval[Ply])(SI.BestMoveStore)(NodeTypes[Ply])(Const.EmptyVal)(-1)(Ret.IsQuiescentCheckCond.IsTrue)(NodeTTStaticEval[Ply]);
            }
            Else
            {
                If (Not ((StaticEval[Ply] == Const.EmptyVal)))
                {
                    SI.CorrDelta = (SearchEval[Ply] - StaticEval[Ply]);
                    SI.ImpVal = SI.CorrDelta;
                    SI.BM = BestMoves[Ply];
                    If ((CheckedState[Ply] == 0) And (((SI.BM == Const.EmptyVal) And (Not ((SI.ImpVal > 0)))) Or ((Not ((SI.BM == Const.EmptyVal))) And ((Board[floor((SI.BM % 100))] == 0) And (SI.ImpVal > 0)))))
                    {
                        Call GetCorrHistIndices(Ply);
                        SI.CorrBonus = ((SI.CorrDelta * Horizon) / 4);
                        If (SI.CorrBonus > 249)
                        {
                            SI.CorrBonus = 249;
                        }
                        If (SI.CorrBonus < -249)
                        {
                            SI.CorrBonus = -249;
                        }
                        If (Not ((CorrHistKey[Ret.GetCorrHistIndices.CorrIdx] == Ret.GetCorrHistIndices.PawnKey)))
                        {
                            List.ReplaceItem(CorrHistVal, Ret.GetCorrHistIndices.CorrIdx, 0);
                            List.ReplaceItem(CorrHistKey, Ret.GetCorrHistIndices.CorrIdx, Ret.GetCorrHistIndices.PawnKey);
                        }
                        List.ReplaceItem(CorrHistVal, Ret.GetCorrHistIndices.CorrIdx, ((CorrHistVal[Ret.GetCorrHistIndices.CorrIdx] + SI.CorrBonus) - floor(((CorrHistVal[Ret.GetCorrHistIndices.CorrIdx] * abs(SI.CorrBonus)) / 1024))));
                        If (Not ((CorrHistNPKey[Ret.GetCorrHistIndices.NPIdx] == Ret.GetCorrHistIndices.NPKey)))
                        {
                            List.ReplaceItem(CorrHistNP, Ret.GetCorrHistIndices.NPIdx, 0);
                            List.ReplaceItem(CorrHistNPKey, Ret.GetCorrHistIndices.NPIdx, Ret.GetCorrHistIndices.NPKey);
                        }
                        List.ReplaceItem(CorrHistNP, Ret.GetCorrHistIndices.NPIdx, ((CorrHistNP[Ret.GetCorrHistIndices.NPIdx] + SI.CorrBonus) - floor(((CorrHistNP[Ret.GetCorrHistIndices.NPIdx] * abs(SI.CorrBonus)) / 1024))));
                    }
                }
                Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(SearchEval[Ply])(SI.BestMoveStore)(NodeTypes[Ply])(Const.EmptyVal)(Horizon)(Const.EmptyVal)(NodeTTStaticEval[Ply]);
            }
        }
        If (BestMoveListIdx[Ply] > 0)
        {
            If Quiescence
            {
                Glob.ProfBestMoveCountQ += 1;
                Glob.ProfBestMoveIdxSumQ += BestMoveListIdx[Ply];
            }
            Else
            {
                Glob.ProfBestMoveCount += 1;
                Glob.ProfBestMoveIdxSum += BestMoveListIdx[Ply];
            }
            If ((Quiescence And (BestMoveListIdx[Ply] > 1)) Or ((Not (Quiescence)) And (BestMoveListIdx[Ply] > 2)))
            {
                If (Glob.ProfilerMode == 2)
                {
                    Call ExportBoardFEN((Glob.IsPlayerBlack == 1))((PlyIsOwn[Ply] == 0));
                    SI.FEN = Ret.ExportBoardFEN.FEN;
                    Call GetMoveNotation(BestMoves[Ply]);
                    SI.MOBestNotation = Ret.GetMoveNotation.Notation;
                    Call GetMoveNotation(Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + 1)]);
                    SI.MOTopNotation = Ret.GetMoveNotation.Notation;
                    Call Log("MoveOrd warning:")(Operator.Join(Operator.Join(Operator.Join(" idx=", BestMoveListIdx[Ply]), "/"), MovesCount[Ply]))(Operator.Join(" horizon=", Horizon))(Operator.Join(" ply=", Ply))(Operator.Join(Operator.Join(" ", Operator.LetterOf("FQ", (1 + Quiescence))), Operator.Join(" checked=", CheckedState[Ply])))(Operator.Join(Operator.Join(Operator.Join(Operator.Join(" ranked_best=", SI.MOTopNotation), "("), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + 1)]), ")"))(Operator.Join(Operator.Join(Operator.Join(Operator.Join(" eval_best=", SI.MOBestNotation), "("), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + BestMoveListIdx[Ply])]), ")"))(Operator.Join(" fen=", SI.FEN));
                }
            }
        }
    }
    Call Comment("Collect statistics");
    If (Quiescence[Ply] == 0)
    {
        Glob.MoveCount += MovesCount[Ply];
    }
    Else
    {
        Glob.MoveCountQ += MovesCount[Ply];
    }
}

Define SearchNextPly(string Alpha)(string Beta)(string Horizon)(string Reduction)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    SNP.NextHorizon = (((Horizon + SearchExtension[Ply]) - Reduction) - 1);
    If (SNP.NextHorizon < 0)
    {
        SNP.NextHorizon = 0;
    }
    Call SearchImpl(Alpha)(Beta)(SNP.NextHorizon)((Ply + 1))(Cutnode)((Quiescence Or (SNP.NextHorizon < 1)))(ExcludedMove);
}

Define Search_CollectStats(string Horizon)(string Ply)(bool Quiescence)(string QSCode)(string FullCode) (warp=true)
{
    If Quiescence
    {
        Call Profile_CountByHorizon(QSCode)(Horizon)(Ply);
    }
    Else
    {
        Call Profile_CountByHorizon(FullCode)(Horizon)(Ply);
    }
}

Define Search_ComputeReduction(string Horizon)(string Ply)(bool Cutnode) (warp=true)
{
    If (ReductionBase[Ply] == Const.EmptyVal)
    {
        Call Search_ComputeReductionBase(Horizon)(Ply);
        If (Search.CR.Applies == 1)
        {
            List.ReplaceItem(ReductionBase, Ply, Ret.Search_ComputeReduction.Reduction);
        }
        Else
        {
            List.ReplaceItem(ReductionBase, Ply, Const.EmptyVal);
        }
    }
    Ret.Search_ComputeReduction.Reduction = 0;
    If (Not ((ReductionBase[Ply] == Const.EmptyVal)))
    {
        Ret.Search_ComputeReduction.Reduction = (floor((ReductionBase[Ply] / 128)) + Cutnode);
        If (Ret.Search_ComputeReduction.Reduction < 0)
        {
            Ret.Search_ComputeReduction.Reduction = 0;
        }
    }
}

Define Search_ComputeReductionBase(string Horizon)(string Ply) (warp=true)
{
    Search.CR.Applies = 0;
    Ret.Search_ComputeReduction.Reduction = 0;
    Search.CR.DangerousPush = 0;
    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
    {
        Search.CR.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.CR.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.CR.PushRank < 4)))
        {
            Search.CR.DangerousPush = 1;
        }
    }
    If (Search.CR.DangerousPush == 1)
    {
        Stop(this script);
    }
    If (((Horizon + SearchExtension[Ply]) > 2) And (((CheckedState[Ply] == 0) And ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))) And ((1 == 1) Or (((Glob.BlackQueenCountLocal + Glob.BlackRookCountLocal) + (Glob.WhiteQueenCountLocal + Glob.WhiteRookCountLocal)) > 0))))
    {
        Call Comment("LMR search");
        Ret.Search_ComputeReduction.Reduction = 0;
        Search.CR.MinMoveCount = (2 + (2 * (Not (((Betas[Ply] - Alphas[Ply]) == 1)))));
        If (Search.CR.MinMoveCount == 0)
        {
            Search.CR.MinMoveCount = 1;
        }
        If (PickedLegalMovesCount[Ply] > Search.CR.MinMoveCount)
        {
            Search.CR.Applies = 1;
            Ret.Search_ComputeReduction.Reduction = floor(((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + SearchExtension[Ply]))) / 2.25)) * 128));
            If (1 == 1)
            {
                If (Not (((Betas[Ply] - Alphas[Ply]) == 1)))
                {
                    Ret.Search_ComputeReduction.Reduction += -128;
                }
            }
            If (1 == 1)
            {
                If (PutsInCheck[Ply] == 1)
                {
                    Ret.Search_ComputeReduction.Reduction += -64;
                }
            }
            If (1 == 1)
            {
                Search.CR.HistFrom = floor((AppliedMove[Ply] / 100));
                Search.CR.HistTo = floor((AppliedMove[Ply] % 100));
                If (Search.CR.HistFrom == 0)
                {
                    If ((AppliedMove[Ply] == 65) Or (AppliedMove[Ply] == 66))
                    {
                        Search.CR.HistFrom = VirtualBoard[5];
                    }
                    Else
                    {
                        Search.CR.HistFrom = VirtualBoard[61];
                    }
                    If (AppliedMove[Ply] == 65)
                    {
                        Search.CR.HistTo = VirtualBoard[8];
                    }
                    Else
                    {
                        If (AppliedMove[Ply] == 66)
                        {
                            Search.CR.HistTo = VirtualBoard[1];
                        }
                        Else
                        {
                            If (AppliedMove[Ply] == 67)
                            {
                                Search.CR.HistTo = VirtualBoard[64];
                            }
                            Else
                            {
                                Search.CR.HistTo = VirtualBoard[57];
                            }
                        }
                    }
                }
                Search.CR.KPHash = Glob.KPHash;
                If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
                {
                    Glob.KPHash = PreviousBoardHashKP[Ply];
                }
                Call GetHistoryStatScore(SourcePieces[Ply])(Search.CR.HistFrom)(Search.CR.HistTo)(AppliedMove[Ply])(Ply);
                Glob.KPHash = Search.CR.KPHash;
                If (1 == 1)
                {
                    Ret.Search_ComputeReduction.Reduction += (0 - Operator.Round(((Ret.GetHistoryStatScore.Score / 82000) * 128)));
                }
            }
            If (1 == 1)
            {
                Call GetImproving(Ply);
                If (Not ((Ret.GetImproving.IsImproving == 0)))
                {
                    Ret.Search_ComputeReduction.Reduction += -128;
                }
            }
        }
    }
}

Define Search_Core(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    Ret.Search_Core.NodeEval = Const.EmptyVal;
    List.ReplaceItem(LMRState, Ply, 0);
    Search.Core.LmrNonPV.IsReSearchRequired = 1;
    If ((Not (Quiescence)) And (Glob.IsSearchTimeout == 0))
    {
        Call Search_ComputeReduction(Horizon)(Ply)(Cutnode);
        Search.Core.Reduction = Ret.Search_ComputeReduction.Reduction;
        If (Search.Core.Reduction > 0)
        {
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.LMR_Inv)(Horizon)(Ply);
            }
            Call SearchNextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(Search.Core.Reduction)(Ply)((1 == 1))(Quiescence)(Const.EmptyVal);
            Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_Core.NodeEval == Const.EmptyVal)))
            {
                Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
            }
            Search.Core.LmrNonPV.IsReSearchRequired = 0;
            List.ReplaceItem(LMRState, Ply, 1);
            If (Not ((Ret.Search_Core.NodeEval > Alphas[Ply])))
            {
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.LMR_Hit)(Horizon)(Ply);
                }
            }
        }
        Call Comment("Non-PV search");
        If ((((Search.Core.LmrNonPV.IsReSearchRequired == 0) And (Ret.Search_Core.NodeEval > Alphas[Ply])) Or ((Search.Core.LmrNonPV.IsReSearchRequired == 1) And ((PickedLegalMovesCount[Ply] > 1) Or ((Betas[Ply] - Alphas[Ply]) == 1)))) And (Glob.IsSearchTimeout == 0))
        {
            If (Glob.ProfilerMode == 2)
            {
                If ((Betas[Ply] - Alphas[Ply]) > 1)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVS_Inv)(Horizon)(Ply);
                }
            }
            Call SearchNextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((Not (Cutnode)))(Quiescence)(Const.EmptyVal);
            Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_Core.NodeEval == Const.EmptyVal)))
            {
                Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
            }
            If (LMRState[Ply] == 1)
            {
                If (Ret.Search_Core.NodeEval > Alphas[Ply])
                {
                    List.ReplaceItem(LMRState, Ply, 2);
                }
                Else
                {
                    List.ReplaceItem(LMRState, Ply, 3);
                }
            }
            If ((Ret.Search_Core.NodeEval > Alphas[Ply]) And (Ret.Search_Core.NodeEval < Betas[Ply]))
            {
                Search.Core.LmrNonPV.IsReSearchRequired = 1;
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVS_ReSearch)(Horizon)(Ply);
                }
            }
            Else
            {
                Search.Core.LmrNonPV.IsReSearchRequired = 0;
            }
        }
    }
    If ((Search.Core.LmrNonPV.IsReSearchRequired == 1) And (Glob.IsSearchTimeout == 0))
    {
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_CountByHorizon(Const.Profile.Full_Inv)(Horizon)(Ply);
        }
        Call Comment("Move was not pruned upfront, enter full depth + current window search");
        Call SearchNextPly((0 - Betas[Ply]))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((1 == 0))(Quiescence)(Const.EmptyVal);
        Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
        If (Not ((Ret.Search_Core.NodeEval == Const.EmptyVal)))
        {
            Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
        }
    }
}

Define Search_DetectCheckmate(string Ply) (warp=true)
{
    If (Ply > 1)
    {
        Call Comment("Virtual king captures on previous ply => depth-corrected checkmate evaluation");
        If (abs(TargetPieces[(Ply - 1)]) == GoK_BlackKing)
        {
            List.ReplaceItem(SearchEval, Ply, (0 - (100000 - (List.Length(BoardHistoryFiftyMoves) - 1))));
            Stop(this script);
        }
        If (ChebyshevDistance[((Glob.BlackKingIdx * 100) + Glob.WhiteKingIdx)] < 2)
        {
            List.ReplaceItem(SearchEval, Ply, (100000 - List.Length(BoardHistoryFiftyMoves)));
            Stop(this script);
        }
        If (1 == 0)
        {
            If ((Ply == 2) Or (CheckedState[(Ply - 1)] == 1))
            {
                Call Comment("Early checkmate evaluation on previous checks when not evaded. As we now have special check evasion search, this is mainly for safety");
                Call CalcBoardAttackedByMoveChecked(Ply);
                If (((PlyIsOwn[Ply] == 1) And (Glob.IsWhiteChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsBlackChecked == 1)))
                {
                    List.ReplaceItem(SearchEval, Ply, (100000 - List.Length(BoardHistoryFiftyMoves)));
                    Stop(this script);
                }
            }
        }
    }
}

Define Search_DetectDraw(string Horizon)(string Ply) (warp=true)
{
    Search.DD.IsDraw = 0;
    If ((Ply > 1) And (Glob.IsInNullMove == 0))
    {
        Call Comment("Draw-by-stalemate detection. This is expensive, and is only applied at low search depth or during late endgame stage (no minor pieces left)");
        If (Ply < 9)
        {
            If (Not ((CheckedState[Ply] == 1)))
            {
                If (((PlyIsOwn[Ply] == 1) And ((Glob.BlackQueenCountLocal == 0) And (Glob.BlackNonQueenMajorMinorCountLocal < 2))) Or ((PlyIsOwn[Ply] == 0) And ((Glob.WhiteQueenCountLocal == 0) And (Glob.WhiteNonQueenMajorMinorCountLocal < 2))))
                {
                    If (1 == 0)
                    {
                        Call IsDrawByStalemate((Ply + 2));
                        If (Ret.IsDrawByStalemate.IsDraw == 1)
                        {
                            Search.DD.IsDraw = 1;
                        }
                    }
                }
            }
        }
        Call Comment("Fast draw-by-material verification");
        If (Glob.IsEndgame == 1)
        {
            If (((Glob.BlackQueenCountLocal == 0) And (Glob.WhiteQueenCountLocal == 0)) And ((Glob.BlackPawnCountLocal == 0) And (Glob.WhitePawnCountLocal == 0)))
            {
                If (((Glob.BlackRookCountLocal == 0) And (Glob.BlackNonQueenMajorMinorCountLocal < 2)) And ((Glob.WhiteRookCountLocal == 0) And (Glob.WhiteNonQueenMajorMinorCountLocal < 2)))
                {
                    Search.DD.IsDraw = 1;
                }
            }
        }
        If (Search.DD.IsDraw == 0)
        {
            Call Comment("Special K-KP endgame draw detection, according to pawn and king position. Finds draws otherwise not visible within search horizon");
            If (Glob.IsClassicEndgameEval == 1)
            {
                If ((Ply > 1) And (Quiescence[(Ply - 1)] == 0))
                {
                    If (((Glob.WhiteQueenCountLocal + Glob.WhiteNonQueenMajorMinorCountLocal) == 0) And ((Glob.BlackQueenCountLocal + Glob.BlackNonQueenMajorMinorCountLocal) == 0))
                    {
                        If ((Glob.BlackPawnCountLocal + Glob.WhitePawnCountLocal) == 1)
                        {
                            Search.DD.SqIdx = 1;
                            Repeat (64)
                            {
                                If ((Board[Search.DD.SqIdx] == GoK_WhitePawn) And (PlyIsOwn[Ply] == 0))
                                {
                                    If ((IdxToFile[Search.DD.SqIdx] == 1) Or (IdxToFile[Search.DD.SqIdx] == 8))
                                    {
                                        If ((IdxToFile[Search.DD.SqIdx] == IdxToFile[Glob.BlackKingIdx]) And (IdxToRank[Glob.BlackKingIdx] < IdxToRank[Search.DD.SqIdx]))
                                        {
                                            Search.DD.IsDraw = 1;
                                        }
                                    }
                                    Else
                                    {
                                        If (((Search.DD.SqIdx - 8) == Glob.BlackKingIdx) Or ((Search.DD.SqIdx - 16) == Glob.BlackKingIdx))
                                        {
                                            If (Not ((((Search.DD.SqIdx - 1) == Glob.WhiteKingIdx) Or ((Search.DD.SqIdx + 1) == Glob.WhiteKingIdx))))
                                            {
                                                Search.DD.IsDraw = 1;
                                            }
                                        }
                                        If ((Search.DD.SqIdx - 24) == Glob.BlackKingIdx)
                                        {
                                            If ((IdxToRank[Search.DD.SqIdx] > 4) And ((Search.DD.SqIdx - 8) == Glob.WhiteKingIdx))
                                            {
                                                Search.DD.IsDraw = 1;
                                            }
                                        }
                                    }
                                }
                                Else
                                {
                                    If ((Board[Search.DD.SqIdx] == GoK_BlackPawn) And (PlyIsOwn[Ply] == 1))
                                    {
                                        If ((IdxToFile[Search.DD.SqIdx] == 1) Or (IdxToFile[Search.DD.SqIdx] == 8))
                                        {
                                            If ((IdxToFile[Search.DD.SqIdx] == IdxToFile[Glob.WhiteKingIdx]) And (IdxToRank[Glob.WhiteKingIdx] > IdxToRank[Search.DD.SqIdx]))
                                            {
                                                Search.DD.IsDraw = 1;
                                            }
                                        }
                                        Else
                                        {
                                            If (((Search.DD.SqIdx + 8) == Glob.WhiteKingIdx) Or ((Search.DD.SqIdx + 16) == Glob.WhiteKingIdx))
                                            {
                                                If (Not ((((Search.DD.SqIdx - 1) == Glob.BlackKingIdx) Or ((Search.DD.SqIdx + 1) == Glob.BlackKingIdx))))
                                                {
                                                    Search.DD.IsDraw = 1;
                                                }
                                            }
                                            If ((Search.DD.SqIdx + 24) == Glob.WhiteKingIdx)
                                            {
                                                If ((IdxToRank[Search.DD.SqIdx] < 5) And ((Search.DD.SqIdx + 8) == Glob.BlackKingIdx))
                                                {
                                                    Search.DD.IsDraw = 1;
                                                }
                                            }
                                        }
                                    }
                                }
                                Search.DD.SqIdx += 1;
                            }
                        }
                    }
                }
            }
        }
    }
    If (Search.DD.IsDraw == 1)
    {
        List.ReplaceItem(SearchEval, Ply, 0);
        Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(0)(Const.EmptyVal)("E")(Const.EmptyVal)(99)(Const.EmptyVal)(NodeTTStaticEval[Ply]);
    }
}

Define Search_DetectDrawByRepetition(string Ply)(bool Quiescence) (warp=true)
{
    If ((Ply > 1) And (Glob.IsInNullMove == 0))
    {
        If ((BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 99) And (CheckedState[Ply] == 0))
        {
            List.ReplaceItem(SearchEval, Ply, (Const.DrawByRepetitionEval * PlySign[Ply]));
            Stop(this script);
        }
        Call Comment("Draw-by-repetition detection. This happens on every ply and could be costly, so we check previous plies for pawn moves and captures. When repetition is possible, history tables are searched for same board hash, when found we verify if the occurred for the same side.");
        Search.DDBR.Count = 1;
        Search.DDBR.RepHistCount = 0;
        If List.ContainsItem(PreviousBoardHash, (Glob.CurrentBoardHash + 0))
        {
            Search.DDBR.Idx = (Ply - 2);
            Repeat Until ((Search.DDBR.Idx < 2) Or (Search.DDBR.Count > 2))
            {
                If (((Glob.CurrentBoardHash + 0) == PreviousBoardHash[Search.DDBR.Idx]) And (CastlingState[Ply] == CastlingState[(Search.DDBR.Idx - 1)]))
                {
                    Search.DDBR.Count += 1;
                }
                Search.DDBR.Idx += -2;
            }
        }
        If List.ContainsItem(BoardHistoryHash, (Glob.CurrentBoardHash + 0))
        {
            Search.DDBR.Idx = ((List.Length(BoardHistoryHash) - 1) + PlyIsOwn[Ply]);
            Repeat Until ((Search.DDBR.Idx < 1) Or (Search.DDBR.RepHistCount > 2))
            {
                If (((Glob.CurrentBoardHash + 0) == BoardHistoryHash[Search.DDBR.Idx]) And (CastlingState[Ply] == BoardHistoryMetaState[Search.DDBR.Idx]))
                {
                    Search.DDBR.RepHistCount += 1;
                }
                Search.DDBR.Idx += -2;
            }
        }
        If ((Search.DDBR.Count > 1) Or (Search.DDBR.RepHistCount > 1))
        {
            List.ReplaceItem(SearchEval, Ply, (Const.DrawByRepetitionEval * PlySign[Ply]));
            Stop(this script);
        }
    }
}

Define Search_DetectExtensions(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Not (Quiescence))
    {
        Call Comment("Singular extensions");
        If ((Ply > 1) And ((ExcludedMove == Const.EmptyVal) And (1 == 0)))
        {
            If ((((TargetPieces[Ply] == 0) And (CheckedState[Ply] == 0)) And (Horizon > (3 + (2 * (Not (((Betas[Ply] - Alphas[Ply]) == 1))))))) And ((AppliedMove[Ply] == HashMove[Ply]) And (ExcludedMove == Const.EmptyVal)))
            {
                Call TTProbeNode(PreviousBoardHash[Ply])(Ply);
                If ((Ret.TTProbeNode.Hit == 1) And ((Not ((Ret.TTProbeNode.Score == Const.EmptyVal))) And (Not ((Ret.TTProbeNode.Horizon == Const.EmptyVal)))))
                {
                    If (Not ((Ret.TTProbeNode.Horizon < (Horizon - 3))))
                    {
                        If (Ret.TTProbeNode.Type == "B")
                        {
                            If (abs(Ret.TTProbeNode.Score) < Const.AbsMinCheckmateEval)
                            {
                                List.ReplaceItem(TTEval, Ply, Ret.TTProbeNode.Score);
                                List.ReplaceItem(SingularAlphaBeta, Ply, Ret.TTProbeNode.Score);
                                Call RevertMove(Ply);
                                List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), 0);
                                List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), 0);
                                Call ApplyMove(Ply)((1 == 1));
                                Call SkipSearchFrameEnter((Ply + 1))(Quiescence);
                                List.ReplaceItem(SingularAlphaBeta, Ply, (SingularAlphaBeta[Ply] + (0 - (Horizon * 3))));
                                Search.DE.Reduction = floor((Horizon / 2));
                                Glob.IsInNullMove += 1;
                                Call SearchNextPly((SingularAlphaBeta[Ply] - 1))(SingularAlphaBeta[Ply])(Horizon)(Search.DE.Reduction)((Ply + 1))(Cutnode)(Quiescence)(HashMove[Ply]);
                                Glob.IsInNullMove += -1;
                                Call SkipSearchFrameExit((Ply + 1));
                                Call RevertMove(Ply);
                                List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), HashMove[Ply]);
                                List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), 9100000);
                                Call ApplyMove(Ply)((1 == 1));
                                If (SearchEval[(Ply + 2)] < SingularAlphaBeta[Ply])
                                {
                                    List.ReplaceItem(SearchExtension, Ply, 1);
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.ExtSingular)(Horizon)(Ply);
                                    }
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
                                    }
                                    Stop(this script);
                                }
                                If (Not ((SingularAlphaBeta[Ply] < Betas[Ply])))
                                {
                                    List.ReplaceItem(SearchEval, Ply, SingularAlphaBeta[Ply]);
                                    List.ReplaceItem(SearchExtension, Ply, "*");
                                    Stop(this script);
                                }
                                If (1 == 0)
                                {
                                    If (Not ((TTEval[Ply] < Betas[Ply])))
                                    {
                                        List.ReplaceItem(SearchExtension, Ply, -2);
                                        Stop(this script);
                                    }
                                    If ((Not ((TTEval[Ply] > SearchEval[(Ply + 2)]))) And (Not ((TTEval[Ply] > Alphas[Ply]))))
                                    {
                                        List.ReplaceItem(SearchExtension, Ply, -1);
                                        Stop(this script);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        If ((Horizon > 1) And ((Ply > 1) And (CheckedState[Ply] == 1)))
        {
            List.ReplaceItem(SearchExtension, Ply, 1);
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
            }
        }
    }
}

Define Search_FutilityPruning(string Horizon)(string Ply)(bool Quiescence) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call Search_CollectStats(Horizon)(Ply)(Quiescence)(Const.Profile.Delta_Inv)(Const.Profile.Futility_Inv);
    }
    Ret.Search_FutilityPruning.IsFutile = 0;
    Search.FP.DangerousPush = 0;
    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
    {
        Search.FP.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.FP.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.FP.PushRank < 4)))
        {
            Search.FP.DangerousPush = 1;
        }
    }
    If ((Search.FP.DangerousPush == 1) And (Not (Quiescence)))
    {
        Stop(this script);
    }
    If (((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0)) And (PromotionPieces[Ply] == 0))
    {
        If (1 == 1)
        {
            If ((Not (Quiescence)) And (((Betas[Ply] - Alphas[Ply]) == 1) And (TargetPieces[Ply] == 0)))
            {
                Call GetImproving(Ply);
                Search.FP.IsImproving = Ret.GetImproving.IsImproving;
                If (Search.FP.IsImproving == Const.EmptyVal)
                {
                    Search.FP.IsImproving = 1;
                }
                If (PickedLegalMovesCountQuiet[Ply] > (3 + ((Horizon * Horizon) / (2 - (Search.FP.IsImproving == 1)))))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                    Stop(this script);
                }
            }
        }
        Search.FP.SEE = Const.EmptyVal;
        Search.FP.FutilityMargin = Const.EmptyVal;
        If Quiescence
        {
            If (((Not ((TargetPieces[Ply] == 0))) And (((PlyIsOwn[Ply] == 1) And ((Glob.BlackQueenCountLocal + Glob.BlackNonQueenMajorMinorCountLocal) > 0)) Or ((PlyIsOwn[Ply] == 0) And ((Glob.WhiteQueenCountLocal + Glob.WhiteNonQueenMajorMinorCountLocal) > 0)))) And (Search.FP.DangerousPush == 0))
            {
                Search.FP.FutilityMargin = 175;
            }
        }
        Else
        {
            If ((Ply > 1) And (Horizon < 6))
            {
                If ((TargetPieces[Ply] == 0) And ((PickedLegalMovesCount[Ply] > 1) And ((Betas[Ply] - Alphas[Ply]) == 1)))
                {
                    If (1 == 1)
                    {
                        Call Search_ComputeReduction(Horizon)(Ply)((1 == 0));
                        Search.FP.Reduction = Ret.Search_ComputeReduction.Reduction;
                        If (Search.FP.Reduction > Horizon)
                        {
                            Search.FP.Reduction = Horizon;
                        }
                        Search.FP.FutilityMargin = ((Horizon - Search.FP.Reduction) * 150);
                    }
                }
            }
        }
        If (Not ((Search.FP.FutilityMargin == Const.EmptyVal)))
        {
            If (Not ((StaticEval[Ply] == Const.EmptyVal)))
            {
                Search.FP.Eval = ((StaticEval[Ply] - (TargetPieces[Ply] * PlySign[Ply])) + Search.FP.FutilityMargin);
                If (Not ((Search.FP.Eval > Alphas[Ply])))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                }
                Else
                {
                    If Quiescence
                    {
                        Search.FP.Eval = (StaticEval[Ply] + Search.FP.FutilityMargin);
                        If (Not ((Search.FP.Eval > Alphas[Ply])))
                        {
                            Call SEE(Ply)((Glob.IsScratch3 == 0));
                            Search.FP.SEE = Ret.SEE.Gain;
                            If (Not ((Search.FP.SEE > 0)))
                            {
                                Ret.Search_FutilityPruning.IsFutile = 1;
                            }
                        }
                    }
                }
                If (Ret.Search_FutilityPruning.IsFutile == 1)
                {
                    If Quiescence
                    {
                        If (Search.FP.Eval > SearchEval[Ply])
                        {
                            List.ReplaceItem(SearchEval, Ply, Search.FP.Eval);
                        }
                    }
                }
            }
        }
        If (1 == 0)
        {
            If (Ret.Search_FutilityPruning.IsFutile == 0)
            {
                If ((Not (Quiescence)) And ((Ply > 1) And (Horizon < 6)))
                {
                    If ((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0))
                    {
                        If (Search.FP.SEE == Const.EmptyVal)
                        {
                            Call SEE(Ply)((Glob.IsScratch3 == 0));
                            Search.FP.SEE = Ret.SEE.Gain;
                        }
                        If (Search.FP.SEE < (-125 * Horizon))
                        {
                            Ret.Search_FutilityPruning.IsFutile = 1;
                        }
                    }
                }
            }
        }
        If ((Quiescence And (Ret.Search_FutilityPruning.IsFutile == 0)) And (Not ((TargetPieces[Ply] == 0))))
        {
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.QSEE_Inv)(Horizon)(Ply);
            }
            If (Search.FP.SEE == Const.EmptyVal)
            {
                Call SEE(Ply)((Glob.IsScratch3 == 0));
                Search.FP.SEE = Ret.SEE.Gain;
            }
            If (Search.FP.SEE < 0)
            {
                Ret.Search_FutilityPruning.IsFutile = 1;
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.QSEE_Hit)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_InitStack(string Ply)(bool Quiescence) (warp=true)
{
    Call NNUE_OnInitStack(Ply);
    Call Comment("Initialize local variables or forward state from previous ply");
    If (Ply == 1)
    {
        Call CalcBoardAttackedByMove(2);
        Call StoreAttackInfo(1);
        List.ReplaceItem(BoardAttackedCalculated, 1, 1);
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
        Call SetInitialEnPassantTarget(1);
    }
    Else
    {
        List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
        List.ReplaceItem(CheckedState, Ply, PutsInCheck[(Ply - 1)]);
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
    }
    List.ReplaceItem(AlphasOld, Ply, Alphas[Ply]);
    List.ReplaceItem(PutsInCheck, Ply, 0);
    List.ReplaceItem(SearchExtension, Ply, 0);
    List.ReplaceItem(NodeTypes, Ply, "E");
    List.ReplaceItem(BestMoves, Ply, Const.EmptyVal);
    List.ReplaceItem(AppliedMove, Ply, "");
    List.ReplaceItem(StaticEval, Ply, Const.EmptyVal);
    List.ReplaceItem(Improving, Ply, Const.EmptyVal);
    List.ReplaceItem(LMRState, Ply, 0);
    List.ReplaceItem(PV, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    List.ReplaceItem(PVRaw, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    If Quiescence
    {
        List.ReplaceItem(Quiescence, Ply, 1);
    }
    Else
    {
        List.ReplaceItem(Quiescence, Ply, 0);
    }
    Call Evaluate((Ply - 1))((1 == 0));
}

Define Search_InternalIterativeDeepening(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    If (((Not (Quiescence)) And (Horizon > 5)) And ((CheckedState[Ply] == 0) And (Not (((Betas[Ply] - Alphas[Ply]) == 1)))))
    {
        If (1 == 0)
        {
            Call Comment("IID");
            Call TTProbeNode(Glob.CurrentBoardHash)(Ply);
            If ((Ret.TTProbeNode.Hit == 0) Or (Ret.TTProbeNode.BestMove == Const.EmptyVal))
            {
                Call ClearMoveList(Ply);
                Call AddMoveToList(0)(Ply)(0);
                List.ReplaceItem(MovesIdx, Ply, 1);
                Call ApplyMove(Ply)((1 == 1));
                Call SkipSearchFrameEnter((Ply + 1))(Quiescence);
                Call SearchImpl(Alphas[Ply])(Betas[Ply])((Horizon - 3))((Ply + 2))(Cutnode)(Quiescence)(Const.EmptyVal);
                Call SkipSearchFrameExit((Ply + 1));
                Call RevertMove(Ply);
            }
        }
    }
}

Define Search_NullMovePruning(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_CountByHorizon(Const.Profile.NMP_Inv)(Horizon)(Ply);
    }
    Call Comment("Null move pruning");
    If (1 == 1)
    {
        If (Not ((AppliedMove[(Ply - 1)] == 0)))
        {
            Glob.IsInNullMove += 1;
            If (Not (Quiescence))
            {
                If ((Horizon > 2) And (((Betas[Ply] - Alphas[Ply]) == 1) And (CheckedState[Ply] == 0)))
                {
                    If ((((PlyIsOwn[Ply] == 1) And (((Glob.BlackQueenCountLocal + Glob.BlackNonQueenMajorMinorCountLocal) + Glob.BlackRookCountLocal) > 0)) Or ((PlyIsOwn[Ply] == 0) And (((Glob.WhiteQueenCountLocal + Glob.WhiteNonQueenMajorMinorCountLocal) + Glob.WhiteRookCountLocal) > 0))) And ((Glob.WhitePawnCountLocal + Glob.BlackPawnCountLocal) > 0))
                    {
                        If (Not ((StaticEval[Ply] == Const.EmptyVal)))
                        {
                            Search.NMP.EvalSurplus = (StaticEval[Ply] - Betas[Ply]);
                            If (Search.NMP.EvalSurplus > 535)
                            {
                                Search.NMP.EvalSurplus = 535;
                            }
                            Search.NMP.Reduction = ((4 + floor((Horizon / 3))) + floor((Search.NMP.EvalSurplus / 107)));
                            If (Search.NMP.Reduction < 0)
                            {
                                Search.NMP.Reduction = 0;
                            }
                            If ((Search.NMP.Reduction > 0) And (Search.NMP.EvalSurplus > 0))
                            {
                                Call GetImproving(Ply);
                                Search.NMP.IsImproving = Ret.GetImproving.IsImproving;
                                If (Search.NMP.IsImproving == Const.EmptyVal)
                                {
                                    Search.NMP.IsImproving = 1;
                                }
                                Search.NMP.Margin = 0;
                                Search.NMP.Eval = StaticEval[Ply];
                                If (Not ((Search.NMP.Eval == Const.EmptyVal)))
                                {
                                    If (Not ((Search.NMP.Eval < (Betas[Ply] + Search.NMP.Margin))))
                                    {
                                        Call ClearMoveList(Ply);
                                        Call AddMoveToList(0)(Ply)(0);
                                        If (Glob.ProfilerMode == 2)
                                        {
                                            Call Profile_CountByHorizon(Const.Profile.NMP_Try)(Horizon)(Ply);
                                        }
                                        List.ReplaceItem(MovesIdx, Ply, 1);
                                        Call ApplyMove(Ply)((1 == 1));
                                        Call SearchNextPly((0 - Betas[Ply]))((0 - (Betas[Ply] - 1)))(Horizon)(Search.NMP.Reduction)(Ply)((Not (Cutnode)))(Quiescence)(Const.EmptyVal);
                                        Search.NMP.NodeEval = SearchEval[(Ply + 1)];
                                        If (Not ((Search.NMP.NodeEval == Const.EmptyVal)))
                                        {
                                            Search.NMP.NodeEval = (0 - Search.NMP.NodeEval);
                                        }
                                        Call RevertMove(Ply);
                                        If ((Not ((abs(Search.NMP.NodeEval) > Const.AbsMinCheckmateEval))) And (Not ((abs(Search.NMP.NodeEval) == abs(Const.DrawByRepetitionEval)))))
                                        {
                                            If ((Not ((Search.NMP.NodeEval < Betas[Ply]))) And (Not ((abs(Search.NMP.NodeEval) > Const.AbsMinCheckmateEval))))
                                            {
                                                List.ReplaceItem(SearchEval, Ply, Search.NMP.NodeEval);
                                                If (Glob.ProfilerMode == 2)
                                                {
                                                    Call Profile_CountByHorizon(Const.Profile.NMP_Hit)(Horizon)(Ply);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Glob.IsInNullMove += -1;
        }
    }
}

Define Search_OnBestRootMoveFound(string Move)(string Eval) (warp=true)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Eval > Glob.SearchAlpha)
    {
        If (1 == 1)
        {
            Call Log(Glob.IdxDeepening)(" : ")(Move)(" : ")(Eval)("")("")("");
        }
    }
}

Define Search_Razoring(string Horizon)(string Ply)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_CountByHorizon(Const.Profile.Razoring_Inv)(Horizon)(Ply);
    }
    If (1 == 1)
    {
        If (((Not (Quiescence)) And ((CheckedState[Ply] == 0) And (Horizon < 5))) And ((Betas[Ply] - Alphas[Ply]) == 1))
        {
            If (Not ((StaticEval[Ply] == Const.EmptyVal)))
            {
                Search.Razoring.Margin = (21 + (150 * Horizon));
                Call GetCalibratedEval(Ply);
                If (Not ((Ret.GetCalibratedEval.Score == Const.EmptyVal)))
                {
                    If ((Ret.GetCalibratedEval.Score + Search.Razoring.Margin) < Alphas[Ply])
                    {
                        Glob.IsInNullMove += 1;
                        If (Glob.ProfilerMode == 2)
                        {
                            Call Profile_CountByHorizon(Const.Profile.Razoring_Try)(Horizon)(Ply);
                        }
                        Call ClearMoveList(Ply);
                        Call AddMoveToList(0)(Ply)(0);
                        List.ReplaceItem(MovesIdx, Ply, 1);
                        Call ApplyMove(Ply)((1 == 1));
                        Call SkipSearchFrameEnter((Ply + 1))((1 == 0));
                        Call SearchImpl(Alphas[Ply])(Betas[Ply])(0)((Ply + 2))((1 == 1))((1 == 1))(Const.EmptyVal);
                        Call SkipSearchFrameExit((Ply + 1));
                        Call RevertMove(Ply);
                        Glob.IsInNullMove += -1;
                        If (Not ((abs(SearchEval[(Ply + 2)]) == abs(Const.DrawByRepetitionEval))))
                        {
                            If (SearchEval[(Ply + 2)] < Alphas[Ply])
                            {
                                List.ReplaceItem(SearchEval, Ply, SearchEval[(Ply + 2)]);
                                If (Glob.ProfilerMode == 2)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.Razoring_Hit)(Horizon)(Ply);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define Search_ReverseFutilityPruning(string Horizon)(string Ply) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_CountByHorizon(Const.Profile.RFP_Inv)(Horizon)(Ply);
    }
    If (1 == 1)
    {
        If (((Ply > 1) And (Horizon < 8)) And ((CheckedState[Ply] == 0) And ((Betas[Ply] - Alphas[Ply]) == 1)))
        {
            If (abs(Betas[Ply]) > Const.AbsMinCheckmateEval)
            {
                Stop(this script);
            }
            If (Not ((StaticEval[Ply] == Const.EmptyVal)))
            {
                Call GetImproving(Ply);
                Search.RFP.Margin = ((79 * Horizon) - (138 * (Ret.GetImproving.IsImproving == 1)));
                If (Search.RFP.Margin < 15)
                {
                    Search.RFP.Margin = 15;
                }
                Call GetCalibratedEval(Ply);
                If (Not ((Ret.GetCalibratedEval.Score == Const.EmptyVal)))
                {
                    If (Not (((Ret.GetCalibratedEval.Score - Search.RFP.Margin) < Betas[Ply])))
                    {
                        List.ReplaceItem(SearchEval, Ply, Ret.GetCalibratedEval.Score);
                        If (Glob.ProfilerMode == 2)
                        {
                            Call Profile_CountByHorizon(Const.Profile.RFP_Hit)(Horizon)(Ply);
                        }
                    }
                }
            }
        }
    }
}

Define Search_TTProbeEval(string Horizon)(string Ply)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If ((Ply > 1) And (ExcludedMove == Const.EmptyVal))
    {
        If ((Betas[Ply] - Alphas[Ply]) == 1)
        {
            Call Comment("Probe transposition table for cached node evaluations");
            Search.TTPE.TTType = NodeTTType[Ply];
            Search.TTPE.TTScore = NodeTTScore[Ply];
            Search.TTPE.TTQSMeta = NodeTTQSMeta[Ply];
            Search.TTPE.TTHorizon = NodeTTHorizon[Ply];
            Search.TTPE.TTHit = NodeTTHit[Ply];
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.TTNodeProbe)(Horizon)(Ply);
            }
            If (Search.TTPE.TTHit == 1)
            {
                If ((Not ((Search.TTPE.TTScore == Const.EmptyVal))) And (Not ((Search.TTPE.TTHorizon == Const.EmptyVal))))
                {
                    Call IsQuiescentCheckCond(Ply);
                    If (((Not (Quiescence)) And (Not (((Search.TTPE.TTHorizon - 0) < Horizon)))) Or (Quiescence And ((Search.TTPE.TTHorizon > -2) And ((Not ((Search.TTPE.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue))) Or (Search.TTPE.TTHorizon > -1)))))
                    {
                        If ((Search.TTPE.TTType == "E") Or (((Betas[Ply] - Alphas[Ply]) == 1) And (((Search.TTPE.TTType == "A") And (Not ((Search.TTPE.TTScore > Alphas[Ply])))) Or ((Search.TTPE.TTType == "B") And (Not ((Search.TTPE.TTScore < Betas[Ply])))))))
                        {
                            If (1 == 1)
                            {
                                List.ReplaceItem(SearchEval, Ply, Search.TTPE.TTScore);
                                If (Glob.ProfilerMode == 2)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.TTNodeHit)(Horizon)(Ply);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define SEE(string MovePly)(bool WithPinFilter) (warp=true)
{
    Ret.SEE.Gain = 0;
    If (floor((AppliedMove[MovePly] / 100)) == 0)
    {
        Stop(this script);
    }
    SEE.Ply = MovePly;
    SEE.TargetIdx = floor((AppliedMove[SEE.Ply] % 100));
    If ((abs(SourcePieces[SEE.Ply]) == GoK_BlackPawn) And ((IdxToRank[SEE.TargetIdx] == 1) Or (IdxToRank[SEE.TargetIdx] == 8)))
    {
        Ret.SEE.Gain = 0;
        Stop(this script);
    }
    List.DeleteAll(SEE.TmpList4);
    List.DeleteAll(SEE.TmpList5);
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesMoveList))
    {
        List.Add(SEE.TmpList4, CalcMovesMoveList[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesScoreList))
    {
        List.Add(SEE.TmpList5, CalcMovesScoreList[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Side = 1;
    If (PlyIsOwn[MovePly] == 1)
    {
        SEE.Side = 2;
    }
    Else
    {
        SEE.Side = 1;
    }
    SEE.IsDone = 0;
    Repeat Until (SEE.IsDone == 1)
    {
        List.DeleteAll(CalcMovesMoveList);
        List.DeleteAll(CalcMovesScoreList);
        SEE.SourceIdx = 1;
        If WithPinFilter
        {
            SEE.Pin.QIdx = PieceIdxLookup[GoK_BlackQueen];
        }
        Repeat (64)
        {
            SEE.SourcePiece = Board[(SEE.SourceIdx + 0)];
            If (((SEE.Side == 1) And (SEE.SourcePiece > 0)) Or ((SEE.Side == 2) And (SEE.SourcePiece < 0)))
            {
                Call IsReachableForAttack(Board[(SEE.SourceIdx + 0)])(SEE.SourceIdx)(SEE.TargetIdx);
                If (Ret.IsReachableForAttack.IsReachable == 1)
                {
                    SEE.Pin.IsPinned = 0;
                    If WithPinFilter
                    {
                        SEE.Pin.AttackerPiece = Board[SEE.SourceIdx];
                        If (SEE.Pin.AttackerPiece > 0)
                        {
                            SEE.Pin.King = Glob.BlackKingIdx;
                        }
                        Else
                        {
                            SEE.Pin.King = Glob.WhiteKingIdx;
                        }
                        SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.SourceIdx * 100)) + SEE.Pin.King);
                        If (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0)))))
                        {
                            SEE.Pin.Move = ((SEE.Pin.King * 100) + SEE.SourceIdx);
                            SEE.Pin.RayStep = MoveToPathStepInc[SEE.Pin.Move];
                            SEE.Pin.Walk = SEE.Pin.King;
                            SEE.Pin.PathClear = 1;
                            Repeat ((MoveToPathDelta[SEE.Pin.Move] - 1))
                            {
                                SEE.Pin.Walk += SEE.Pin.RayStep;
                                SEE.Pin.PathClear = (SEE.Pin.PathClear * (Board[SEE.Pin.Walk] == 0));
                            }
                            If (SEE.Pin.PathClear == 1)
                            {
                                List.ReplaceItem(Board, SEE.SourceIdx, 0);
                                SEE.Pin.Walk = (SEE.SourceIdx + SEE.Pin.RayStep);
                                SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                SEE.Pin.OnLine = (0 + (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0))))));
                                SEE.Pin.BlockerPiece = Board[SEE.Pin.Walk];
                                Repeat Until ((Not ((SEE.Pin.OnLine == 1))) Or (Not ((SEE.Pin.BlockerPiece == 0))))
                                {
                                    SEE.Pin.Walk += SEE.Pin.RayStep;
                                    SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                    SEE.Pin.OnLine = (0 + (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0))))));
                                    SEE.Pin.BlockerPiece = Board[SEE.Pin.Walk];
                                }
                                If (((SEE.Pin.OnLine == 1) And ((SEE.Pin.AttackerPiece * SEE.Pin.BlockerPiece) < 0)) And (Not ((SEE.Pin.Walk == SEE.TargetIdx))))
                                {
                                    Call IsCheckingPiece(SEE.Pin.Walk);
                                    If (Ret.IsCheckingPiece.IsChecking == 1)
                                    {
                                        SEE.Pin.IsPinned = 1;
                                    }
                                }
                                List.ReplaceItem(Board, SEE.SourceIdx, SEE.Pin.AttackerPiece);
                            }
                        }
                    }
                    If (SEE.Pin.IsPinned == 0)
                    {
                        List.Add(CalcMovesMoveList, SEE.SourceIdx);
                        List.Add(CalcMovesScoreList, (0 - abs(SEE.SourcePiece)));
                    }
                }
            }
            SEE.SourceIdx += 1;
        }
        If (List.Length(CalcMovesMoveList) == 0)
        {
            SEE.IsDone = 1;
        }
        Else
        {
            If ((Const.MaxPlyStackFrames % 2) == 1)
            {
                Call SortMoveList(((Const.MaxPlyStackFrames + 1) - SEE.Side));
            }
            Else
            {
                Call SortMoveList((Const.MaxPlyStackFrames - SEE.Side));
            }
            SEE.SourceIdx = CalcMovesMoveList[1];
            SEE.Move = ((SEE.SourceIdx * 100) + SEE.TargetIdx);
            SEE.Ply += 1;
            Call ClearMoveList(SEE.Ply);
            Call AddMoveToList(SEE.Move)(SEE.Ply)(0);
            List.ReplaceItem(MovesIdx, SEE.Ply, 1);
            Call ApplyMoveLight(SEE.Ply);
            If (abs(TargetPieces[SEE.Ply]) == GoK_BlackKing)
            {
                SEE.IsDone = 1;
            }
            Else
            {
                Glob.MoveCountQ += 1;
                Glob.NodeCountQ += 1;
                If (SEE.Side == 1)
                {
                    SEE.Side = 2;
                }
                Else
                {
                    SEE.Side = 1;
                }
            }
        }
    }
    SEE.RunningGain = 0;
    Repeat Until (SEE.Ply == MovePly)
    {
        SEE.GainIfCapture = (abs(TargetPieces[SEE.Ply]) - SEE.RunningGain);
        If (SEE.GainIfCapture > 0)
        {
            SEE.RunningGain = SEE.GainIfCapture;
        }
        Else
        {
            SEE.RunningGain = 0;
        }
        Call RevertMoveLight(SEE.Ply);
        SEE.Ply += -1;
    }
    SEE.SwapValue = (abs(TargetPieces[MovePly]) - SEE.RunningGain);
    Ret.SEE.Gain = SEE.SwapValue;
    List.DeleteAll(CalcMovesMoveList);
    List.DeleteAll(CalcMovesScoreList);
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList4))
    {
        List.Add(CalcMovesMoveList, SEE.TmpList4[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList5))
    {
        List.Add(CalcMovesScoreList, SEE.TmpList5[SEE.Idx]);
        SEE.Idx += 1;
    }
}

Define SetCastlingStateFlag(string Ply)(string Offset)(string Val) (warp=true)
{
    Set.CSF.CastlingState = CastlingState[Ply];
    If (Not ((Operator.LetterOf(Set.CSF.CastlingState, Offset) == Val)))
    {
        Set.CSF.Idx = (((((Operator.LetterOf(Set.CSF.CastlingState, 1) * 128) + (Operator.LetterOf(Set.CSF.CastlingState, 2) * 64)) + ((Operator.LetterOf(Set.CSF.CastlingState, 3) * 32) + (Operator.LetterOf(Set.CSF.CastlingState, 4) * 16))) + (((Operator.LetterOf(Set.CSF.CastlingState, 5) * 8) + (Operator.LetterOf(Set.CSF.CastlingState, 6) * 4)) + ((Operator.LetterOf(Set.CSF.CastlingState, 7) * 2) + Operator.LetterOf(Set.CSF.CastlingState, 8)))) + 1);
        If (Val == 1)
        {
            List.ReplaceItem(CastlingState, Ply, CastlingStateLookup[(Set.CSF.Idx + CastlingStatePow2[(Offset + 0)])]);
        }
        Else
        {
            List.ReplaceItem(CastlingState, Ply, CastlingStateLookup[(Set.CSF.Idx - CastlingStatePow2[(Offset + 0)])]);
        }
    }
}

Define SetInitialEnPassantTarget(string Ply) (warp=true)
{
    List.ReplaceItem(EnPassantTarget, Ply, "");
    Call GetSubstringRight(Glob.GameMoves)(4);
    Set.IEPT.SourceIdx = floor((Ret.GetSubstringRight.Substring / 100));
    Set.IEPT.TargetIdx = floor((Ret.GetSubstringRight.Substring % 100));
    If ((abs(Board[Set.IEPT.TargetIdx]) == GoK_BlackPawn) And (abs((Set.IEPT.TargetIdx - Set.IEPT.SourceIdx)) == 16))
    {
        List.ReplaceItem(EnPassantTarget, Ply, Set.IEPT.TargetIdx);
    }
}

Define SkipSearchFrameEnter(string Ply)(bool Quiescence) (warp=true)
{
    Call Search_InitStack(Ply)(Quiescence);
    Call ClearMoveList(Ply);
    Call AddMoveToList(0)(Ply)(0);
    List.ReplaceItem(MovesIdx, Ply, 1);
    Call ApplyMove(Ply)((1 == 1));
}

Define SkipSearchFrameExit(string Ply) (warp=true)
{
    Call RevertMove(Ply);
}

Define SortList (warp=true)
{
    If (List.Length(CalcMovesScoreList) > 1)
    {
        Call QuickSort;
    }
}

Define SortMoveList(string Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.Add(Moves1, CalcMovesMoveList[SML.Idx]);
            SML.Idx += 1;
        }
        Call SortList;
        SML.Idx = 1;
        SML.MoveCount = List.Length(CalcMovesMoveList);
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, SML.Idx, CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, SML.Idx, CalcMovesScoreList[SML.Idx]);
            List.ReplaceItem(Moves1, SML.Idx, CalcMovesMoveList[SML.Idx]);
            SML.Idx += 1;
            SML.MoveCount += -1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(CalcMovesMoveList, SML.Idx, Moves[SML.Idx]);
            List.ReplaceItem(CalcMovesScoreList, SML.Idx, MovesScore[SML.Idx]);
            SML.Idx += 1;
        }
        Stop(this script);
    }
    If (Ply == 2)
    {
        Call SortList;
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SML.MoveCount + SML.Idx), CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, (SML.MoveCount + SML.Idx), CalcMovesScoreList[SML.Idx]);
            List.Add(Moves2, CalcMovesMoveList[SML.Idx]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        Stop(this script);
    }
    If (PlyIsOwn[Ply] == 1)
    {
        Call SortList;
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SML.MoveCount + SML.Idx), CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, (SML.MoveCount + SML.Idx), CalcMovesScoreList[SML.Idx]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(CalcMovesMoveList, SML.Idx, Moves[(SML.MoveCount + SML.Idx)]);
            List.ReplaceItem(CalcMovesScoreList, SML.Idx, MovesScore[(SML.MoveCount + SML.Idx)]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
    }
    Else
    {
        Call SortList;
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SML.MoveCount + SML.Idx), CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, (SML.MoveCount + SML.Idx), CalcMovesScoreList[SML.Idx]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
    }
}

Define StoreAttackInfo(string Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 0)
    {
        If (1 == 0)
        {
            SAI.Packed = "";
            SAI.PackedPieces = "";
            SAI.SqIdx = 1;
            Repeat (16)
            {
                SAI.Packed = Operator.Join(SAI.Packed, MoveToZeroPaddedStr[((((BoardAttackedByBlack[SAI.SqIdx] * 1000) + (BoardAttackedByBlack[(SAI.SqIdx + 1)] * 100)) + ((BoardAttackedByBlack[(SAI.SqIdx + 2)] * 10) + BoardAttackedByBlack[(SAI.SqIdx + 3)])) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByBlackPiece[SAI.SqIdx] * 100) + BoardAttackedByBlackPiece[(SAI.SqIdx + 1)]) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByBlackPiece[(SAI.SqIdx + 2)] * 100) + BoardAttackedByBlackPiece[(SAI.SqIdx + 3)]) + 1)]);
                SAI.SqIdx += 4;
            }
        }
        SAI.SqIdx = 1;
        SAI.SliceStart = (((Ply - 1) * 100) + 1);
        Repeat (64)
        {
            List.ReplaceItem(BoardAttackedByOpponentSnapshot, SAI.SliceStart, BoardAttackedByBlack[SAI.SqIdx]);
            List.ReplaceItem(BoardAttackedByOpponentPieceSnapshot, SAI.SliceStart, BoardAttackedByBlackPiece[SAI.SqIdx]);
            SAI.SqIdx += 1;
            SAI.SliceStart += 1;
        }
        SAI.IsChecked = Glob.IsWhiteChecked;
    }
    Else
    {
        If (1 == 0)
        {
            SAI.Packed = "";
            SAI.PackedPieces = "";
            SAI.SqIdx = 1;
            Repeat (16)
            {
                SAI.Packed = Operator.Join(SAI.Packed, MoveToZeroPaddedStr[((((BoardAttackedByWhite[SAI.SqIdx] * 1000) + (BoardAttackedByWhite[(SAI.SqIdx + 1)] * 100)) + ((BoardAttackedByWhite[(SAI.SqIdx + 2)] * 10) + BoardAttackedByWhite[(SAI.SqIdx + 3)])) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByWhitePiece[SAI.SqIdx] * 100) + BoardAttackedByWhitePiece[(SAI.SqIdx + 1)]) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByWhitePiece[(SAI.SqIdx + 2)] * 100) + BoardAttackedByWhitePiece[(SAI.SqIdx + 3)]) + 1)]);
                SAI.SqIdx += 4;
            }
        }
        SAI.SqIdx = 1;
        SAI.SliceStart = (((Ply - 1) * 100) + 1);
        Repeat (64)
        {
            List.ReplaceItem(BoardAttackedByOpponentSnapshot, SAI.SliceStart, BoardAttackedByWhite[SAI.SqIdx]);
            List.ReplaceItem(BoardAttackedByOpponentPieceSnapshot, SAI.SliceStart, BoardAttackedByWhitePiece[SAI.SqIdx]);
            SAI.SqIdx += 1;
            SAI.SliceStart += 1;
        }
        SAI.IsChecked = Glob.IsBlackChecked;
    }
    List.ReplaceItem(CheckedState, Ply, SAI.IsChecked);
    Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(Const.EmptyVal)(Const.EmptyVal)("")(CheckedState[Ply])(Const.EmptyVal)(Const.EmptyVal)(Const.EmptyVal);
}

Define StoreKillerMove(string Ply)(string Move)(string Horizon)(bool Malus)(bool ContinuationOnly)(bool QuietOk) (warp=true)
{
    SKM.HistoryBonusA = ((190 * Horizon) - 108);
    SKM.HistoryBonus = ((((SKM.HistoryBonusA + 1596) - abs((SKM.HistoryBonusA - 1596))) / 2) * (1 - (2 * Malus)));
    If ((floor((Move / 100)) == 0) And QuietOk)
    {
        If ((((Move == GoK_BlackKingsideCastling) Or (Move == GoK_BlackQueensideCastling)) Or (Move == GoK_WhiteKingsideCastling)) Or (Move == GoK_WhiteQueensideCastling))
        {
            If ((Move == 65) Or (Move == 66))
            {
                SKM.CastleFrom = VirtualBoard[5];
            }
            Else
            {
                SKM.CastleFrom = VirtualBoard[61];
            }
            If (Move == 65)
            {
                SKM.CastleTo = VirtualBoard[8];
            }
            Else
            {
                If (Move == 66)
                {
                    SKM.CastleTo = VirtualBoard[1];
                }
                Else
                {
                    If (Move == 67)
                    {
                        SKM.CastleTo = VirtualBoard[64];
                    }
                    Else
                    {
                        SKM.CastleTo = VirtualBoard[57];
                    }
                }
            }
            If (Not (ContinuationOnly))
            {
                SKM.HistoryMoveScoreIdx = (PlyHistOffset[Ply] + ((SKM.CastleFrom * 64) + SKM.CastleTo));
                List.ReplaceItem(HistoryMoveScores, SKM.HistoryMoveScoreIdx, (HistoryMoveScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor((HistoryMoveScores[SKM.HistoryMoveScoreIdx] * (abs(SKM.HistoryBonus) / 7183))))));
            }
            If ((Not (ContinuationOnly)) And (Not (Malus)))
            {
                SKM.KillerSlot = (((Ply - 1) * 2) + 1);
                If (Not ((KillerMoves[SKM.KillerSlot] == Move)))
                {
                    List.ReplaceItem(KillerMoves, (SKM.KillerSlot + 1), KillerMoves[SKM.KillerSlot]);
                    List.ReplaceItem(KillerMoves, SKM.KillerSlot, Move);
                }
                If (Ply > 1)
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
    }
    If (((((floor((Move / 100)) == 0) Or (Board[floor((Move % 100))] == 0)) And (Move == floor(Move))) And (Not (((abs(Board[floor((Move / 100))]) == GoK_BlackPawn) And (Not ((IdxToFile[floor((Move / 100))] == IdxToFile[floor((Move % 100))]))))))) And QuietOk)
    {
        If (Not (ContinuationOnly))
        {
            SKM.KillerSlot = (((Ply - 1) * 2) + 1);
            If ((Not (Malus)) And (Not ((KillerMoves[SKM.KillerSlot] == Move))))
            {
                List.ReplaceItem(KillerMoves, (SKM.KillerSlot + 1), KillerMoves[SKM.KillerSlot]);
                List.ReplaceItem(KillerMoves, SKM.KillerSlot, Move);
            }
            If (Not ((floor((Move / 100)) == 0)))
            {
                SKM.HistoryMoveScoreIdx = (PlyHistOffset[Ply] + ((floor((Move / 100)) * 64) + floor((Move % 100))));
                List.ReplaceItem(HistoryMoveScores, SKM.HistoryMoveScoreIdx, (HistoryMoveScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor((HistoryMoveScores[SKM.HistoryMoveScoreIdx] * (abs(SKM.HistoryBonus) / 7183))))));
                Call ProbePawnHist(Board[floor((Move / 100))])(floor((Move % 100)));
                List.ReplaceItem(HistoryPawnHist, Ret.ProbePawnHist.Idx, (HistoryPawnHist[Ret.ProbePawnHist.Idx] + ((SKM.HistoryBonus / 2) - floor((HistoryPawnHist[Ret.ProbePawnHist.Idx] * (abs((SKM.HistoryBonus / 2)) / 8192))))));
            }
            If (Not (Malus))
            {
                If (Ply > 1)
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
        If (floor((Move / 100)) == 0)
        {
            SKM.KillerSlot = ((PieceIdxLookup[GoK_BlackKing] * 68) + SKM.CastleTo);
        }
        Else
        {
            SKM.KillerSlot = ((PieceIdxLookup[abs(Board[floor((Move / 100))])] * 68) + floor((Move % 100)));
        }
        SKM.HistoryMoveScoreIdx = -1;
        If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
        {
            SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + SKM.KillerSlot);
        }
        If (Not ((SKM.HistoryMoveScoreIdx == -1)))
        {
            List.ReplaceItem(HistoryContinuation, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
        }
        If (Ply > 2)
        {
            If (1 == 1)
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation2, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation2[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation2[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
            }
            If ((Ply > 4) And (CheckedState[Ply] == 0))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation3, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation3[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + ((SKM.HistoryBonus / 1) - floor((HistoryContinuation3[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs((SKM.HistoryBonus / 1)) / 29952))))));
            }
            If ((Ply > 6) And (CheckedState[Ply] == 0))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation4, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation4[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation4[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
            }
        }
    }
    If ((Not ((floor((Move / 100)) == 0))) And (Not ((Board[floor((Move % 100))] == 0))))
    {
        SKM.HistoryMoveScoreIdx = (((PieceIdxLookup[abs(Board[floor((Move / 100))])] - 1) * 384) + (((PieceIdxLookup[abs(Board[floor((Move % 100))])] - 1) * 64) + floor((Move % 100))));
        List.ReplaceItem(HistoryCaptureScores, SKM.HistoryMoveScoreIdx, (HistoryCaptureScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor(((HistoryCaptureScores[SKM.HistoryMoveScoreIdx] * abs(SKM.HistoryBonus)) / 10692)))));
    }
}

Define StoreKillerMoveMalus(string Ply)(string Horizon)(string KillerMoveIdx) (warp=true)
{
    SKMM.Move = Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + KillerMoveIdx)];
    SKMM.Idx = 1;
    Repeat ((KillerMoveIdx - 1))
    {
        Call StoreKillerMove(Ply)(Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + SKMM.Idx)])(Horizon)((1 == 1))((1 == 0))(((floor((SKMM.Move / 100)) == 0) Or (Board[floor((SKMM.Move % 100))] == 0)));
        SKMM.Idx += 1;
    }
}

Define TestLog(string TestLogTxt0)(string TestLogTxt1)(string TestLogTxt2)(string TestLogTxt3)(string TestLogTxt4)(string TestLogTxt5)(string TestLogTxt6)(string TestLogTxt7) (warp=true)
{
    List.Add(Logfile, Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join("", TestLogTxt0), TestLogTxt1), TestLogTxt2), TestLogTxt3), TestLogTxt4), TestLogTxt5), TestLogTxt6), TestLogTxt7));
}

Define TestPad(string TestPadText)(string TestPadWidth) (warp=true)
{
    Ret.TestPad.PaddedText = TestPadText;
    Repeat Until (Not ((Variable.Length(Ret.TestPad.PaddedText) < TestPadWidth)))
    {
        Ret.TestPad.PaddedText = Operator.Join(Ret.TestPad.PaddedText, " ");
    }
}

Define TestPerft(string TestPerftPly) (warp=false)
{
    If (Not ((TestPerftPly > 0)))
    {
        Stop(this script);
    }
    Glob.IsTestRunning = 1;
    Glob.IsDCI = 1;
    Call InitTestSuite;
    TST.Passed = 0;
    Glob.PerftCheckMismatches = 0;
    TST.SearchCount = (List.Length(PerftSuiteFens) * TestPerftPly);
    Call TestLog("=== perft core vs staged movegen, depth 1 to ")(TestPerftPly)("")("")("")("")("")("");
    TST.Row = "";
    Call TestPad("Perft")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Core")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Staged")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    TST.Row = Operator.Join(TST.Row, "FEN");
    Call TestLog(TST.Row)("")("")("")("")("")("")("");
    TST.PosIdx = 1;
    Repeat (List.Length(PerftSuiteFens))
    {
        _dci fen = PerftSuiteFens[TST.PosIdx];
        _dci think time = 1;
        Call $gok_prepare;
        Call GetBestMoveMedDiff;
        TST.HorizonIdx = 1;
        Repeat (TestPerftPly)
        {
            Glob.PerftNodes = 0;
            Call Perft(1)(TST.HorizonIdx)(0);
            TST.Perft.CoreNodes = Glob.PerftNodes;
            Glob.PerftNodes = 0;
            Call Perft(1)(TST.HorizonIdx)(1);
            If ((TST.Perft.CoreNodes == PerftSuiteCounts[(((TST.PosIdx - 1) * 4) + TST.HorizonIdx)]) And (Glob.PerftNodes == PerftSuiteCounts[(((TST.PosIdx - 1) * 4) + TST.HorizonIdx)]))
            {
                TST.Passed += 1;
                TST.Perft.ResultTxt = "ok";
            }
            Else
            {
                TST.Perft.ResultTxt = "failed";
            }
            TST.Row = "";
            Call TestPad(Operator.Join(Operator.Join(TST.PosIdx, " / d="), TST.HorizonIdx))(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.Perft.ResultTxt)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(PerftSuiteCounts[(((TST.PosIdx - 1) * 4) + TST.HorizonIdx)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.Perft.CoreNodes)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(Glob.PerftNodes)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, PerftSuiteFens[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
            TST.HorizonIdx += 1;
        }
        TST.PosIdx += 1;
    }
    Call TestLog("=== ")(TST.Passed)(" / ")(TST.SearchCount)(" successful perft runs")("")("")("");
    Call TestLog("check-detection mismatches: ")(Glob.PerftCheckMismatches)("")("")("")("")("")("");
    Glob.IsDCI = 0;
    Glob.IsTestRunning = 0;
}

Define TestSearch(string SearchFen)(string SearchThinkTime) (warp=false)
{
    _dci fen = SearchFen;
    _dci think time = SearchThinkTime;
    Call $gok_prepare;
    Call GetBestMoveMedDiff;
    Ret.TestSearch.Move = Ret.GetBestMoveMedDiff.Move;
}

Define TestSuite(string TestCount)(string TestThinkTime) (warp=false)
{
    If (Not ((TestCount > 0)))
    {
        Stop(this script);
    }
    Glob.IsTestRunning = 1;
    Glob.IsDCI = 1;
    Call InitTestSuite;
    TST.Passed = 0;
    TST.SearchCount = TestCount;
    Call TestLog("=== search, ")(TST.SearchCount)(" positions at ")(TestThinkTime)("s each")("")("")("");
    TST.Row = "";
    Call TestPad("Test#")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Return")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    TST.Row = Operator.Join(TST.Row, "FEN");
    Call TestLog(TST.Row)("")("")("")("")("")("")("");
    TST.PosIdx = 1;
    Repeat (TST.SearchCount)
    {
        Call TestSearch(TestSuiteFens[TST.PosIdx])(TestThinkTime);
        Call GetMoveNotation(Ret.TestSearch.Move);
        TST.ReturnedNotation = Ret.GetMoveNotation.Notation;
        TST.SlotHit = 0;
        TST.SlotIdx = 1;
        Repeat (5)
        {
            If (TST.ReturnedNotation == TestSuiteSan[(((TST.PosIdx - 1) * 5) + TST.SlotIdx)])
            {
                TST.SlotHit = 1;
            }
            TST.SlotIdx += 1;
        }
        If (TST.SlotHit == 1)
        {
            TST.Passed += 1;
            TST.Row = "";
            Call TestPad(TST.PosIdx)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad("ok")(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteSan[(((TST.PosIdx - 1) * 5) + 1)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.ReturnedNotation)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, TestSuiteFens[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
        }
        Else
        {
            TST.Row = "";
            Call TestPad(TST.PosIdx)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad("failed")(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteSan[(((TST.PosIdx - 1) * 5) + 1)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.ReturnedNotation)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, TestSuiteFens[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
        }
        TST.PosIdx += 1;
    }
    Call TestLog("=== ")(TST.Passed)(" / ")(TST.SearchCount)(" successful tests")("")("")("");
    Glob.IsDCI = 0;
    Glob.IsTestRunning = 0;
}

Define TTProbeNode(string BoardHash)(string Ply) (warp=true)
{
    Call GetTTNodeHash(BoardHash)(Ply);
    TTPN.NodeHash = Ret.GetTTNodeHash.Hash;
    TTPN.HashBucket = ((TTPN.NodeHash % (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)) - 5)) + 1);
    TTPN.HashBucket = (((TTPN.HashBucket - 1) * Const.TTNodeEntrySize) + 1);
    TTPN.ProbeFound = 0;
    TTPN.ProbeIdx = 0;
    Repeat Until ((TTPN.ProbeFound == 1) Or (TTPN.ProbeIdx == 5))
    {
        If (TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Hash)] == TTPN.NodeHash)
        {
            TTPN.ProbeFound = 1;
        }
        Else
        {
            TTPN.HashBucket += Const.TTNodeEntrySize;
            TTPN.ProbeIdx += 1;
        }
    }
    If (TTPN.ProbeFound == 0)
    {
        Ret.TTProbeNode.Hit = 0;
        Stop(this script);
    }
    Ret.TTProbeNode.Hit = 1;
    Ret.TTProbeNode.BestMove = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.BestMove)];
    Ret.TTProbeNode.Score = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Score)];
    Ret.TTProbeNode.Type = NodeTypeLookup[TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Type)]];
    Ret.TTProbeNode.Checked = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Checked)];
    Ret.TTProbeNode.Horizon = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Horizon)];
    Ret.TTProbeNode.QSMeta = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.QSMeta)];
    Ret.TTProbeNode.StaticEval = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.StaticEval)];
    List.ReplaceItem(TTNodeEntry, (TTPN.HashBucket + TTNodeColIdx.Age), TT.CurrentAge);
}

Define TTProbeNodeAtPly(string Ply) (warp=true)
{
    List.ReplaceItem(NodeTTScore, Ply, Const.EmptyVal);
    List.ReplaceItem(NodeTTType, Ply, Const.EmptyVal);
    List.ReplaceItem(NodeTTHorizon, Ply, Const.EmptyVal);
    List.ReplaceItem(NodeTTQSMeta, Ply, Const.EmptyVal);
    List.ReplaceItem(NodeTTMove, Ply, Const.EmptyVal);
    List.ReplaceItem(NodeTTChecked, Ply, Const.EmptyVal);
    List.ReplaceItem(NodeTTStaticEval, Ply, Const.EmptyVal);
    Call TTProbeNode(Glob.CurrentBoardHash)(Ply);
    List.ReplaceItem(NodeTTHit, Ply, Ret.TTProbeNode.Hit);
    If (Ret.TTProbeNode.Hit == 1)
    {
        List.ReplaceItem(NodeTTScore, Ply, Ret.TTProbeNode.Score);
        List.ReplaceItem(NodeTTType, Ply, Ret.TTProbeNode.Type);
        List.ReplaceItem(NodeTTHorizon, Ply, Ret.TTProbeNode.Horizon);
        List.ReplaceItem(NodeTTQSMeta, Ply, Ret.TTProbeNode.QSMeta);
        List.ReplaceItem(NodeTTMove, Ply, Ret.TTProbeNode.BestMove);
        List.ReplaceItem(NodeTTChecked, Ply, Ret.TTProbeNode.Checked);
        If ((CheckedState[Ply] == Const.EmptyVal) And (Not ((NodeTTChecked[Ply] == Const.EmptyVal))))
        {
            List.ReplaceItem(CheckedState, Ply, NodeTTChecked[Ply]);
        }
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.TTProbeNode.StaticEval);
    }
}

Define TTStoreNode(string BoardHash)(string Ply)(string Score)(string BestMove)(string Type)(string Checked)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    If (Glob.IsSearchTimeout == 1)
    {
        Stop(this script);
    }
    If (abs(Score) == abs(Const.DrawByRepetitionEval))
    {
        Stop(this script);
    }
    If (ChebyshevDistance[((Glob.BlackKingIdx * 100) + Glob.WhiteKingIdx)] == 1)
    {
        Stop(this script);
    }
    Call GetTTNodeHash(BoardHash)(Ply);
    Call TTStoreNodeImpl(Ret.GetTTNodeHash.Hash)(Ply)(Score)(BestMove)(Type)(Checked)(Horizon)(QSMeta)(StaticEval);
}

Define TTStoreNodeImpl(string NodeHash)(string Ply)(string Score)(string BestMove)(string Type)(string Checked)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    TTSNI.FirstBucket = ((NodeHash % (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)) - 5)) + 1);
    TTSNI.FirstBucket = (((TTSNI.FirstBucket - 1) * Const.TTNodeEntrySize) + 1);
    TTSNI.HashBucket = TTSNI.FirstBucket;
    TTSNI.UpdateIdx = 0;
    TTSNI.EmptySlot = 0;
    TTSNI.EvictionSlot = 0;
    Repeat (5)
    {
        TTSNI.Hash = TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Hash)];
        If (TTSNI.Hash == NodeHash)
        {
            TTSNI.UpdateIdx = TTSNI.HashBucket;
        }
        Else
        {
            If (TTSNI.Hash == 0)
            {
                TTSNI.EmptySlot = TTSNI.HashBucket;
            }
            Else
            {
                TTSNI.EntryValue = (TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Horizon)] - (TT.CurrentAge - TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Age)]));
                If ((TTSNI.EvictionSlot == 0) Or (TTSNI.EntryValue < TTSNI.EvictionSlotValue))
                {
                    TTSNI.EvictionSlotValue = TTSNI.EntryValue;
                    TTSNI.EvictionSlot = TTSNI.HashBucket;
                }
            }
        }
        TTSNI.HashBucket += Const.TTNodeEntrySize;
    }
    If (TTSNI.UpdateIdx > 0)
    {
        TTSNI.HashBucket = TTSNI.UpdateIdx;
    }
    Else
    {
        If (TTSNI.EmptySlot > 0)
        {
            TTSNI.HashBucket = TTSNI.EmptySlot;
        }
        Else
        {
            TTSNI.HashBucket = TTSNI.EvictionSlot;
        }
    }
    If (TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Hash)] == NodeHash)
    {
        If (Not ((Checked == Const.EmptyVal)))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Checked), Checked);
        }
        If (Not ((StaticEval == Const.EmptyVal)))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.StaticEval), StaticEval);
        }
        TTSNI.StoredHorizon = TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Horizon)];
        If (((Not ((Score == Const.EmptyVal))) And (Not ((Horizon == Const.EmptyVal)))) And ((Type == "E") Or ((TTSNI.StoredHorizon == -1) Or (Not ((Horizon < TTSNI.StoredHorizon))))))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Type), List.IndexOf(NodeTypeLookup, Type));
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Score), Score);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Horizon), Horizon);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Age), TT.CurrentAge);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.BestMove), BestMove);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.QSMeta), QSMeta);
        }
    }
    Else
    {
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.BestMove), BestMove);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Checked), Checked);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.StaticEval), StaticEval);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Hash), NodeHash);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Type), List.IndexOf(NodeTypeLookup, Type));
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Score), Score);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Horizon), Horizon);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Age), TT.CurrentAge);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.QSMeta), QSMeta);
    }
}

Define UndoMove (warp=false)
{
    Call EnterExecution;
    If ((Glob.IsInUndo == 0) And (List.Length(GameMovesAN) > 1))
    {
        Glob.IsInUndo = 1;
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("Stg_FromSquareSelected");
        Event.BroadcastAndWait("Stg_ToSquareSelected");
        Call UndoPrevMove;
        If (BoardHistoryWasEngineMove[List.Length(BoardHistoryWasEngineMove)] == 0)
        {
            Call UndoPrevMove;
        }
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        Glob.IsInUndo = 0;
    }
    Call ExitExecution;
}

Define UndoPrevMove (warp=false)
{
    If (List.Length(GameMovesAN) > 0)
    {
        List.DeleteItem(BoardHistory, List.Length(BoardHistory));
        List.DeleteItem(BoardHistoryHash, List.Length(BoardHistoryHash));
        List.DeleteItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState));
        List.DeleteItem(BoardHistoryWasEngineMove, List.Length(BoardHistoryWasEngineMove));
        List.DeleteItem(GameMovesAN, List.Length(GameMovesAN));
        Call ImportBoardImpl(BoardHistory[List.Length(BoardHistory)]);
        Call GetSubstringLeft(Glob.GameMoves)((Variable.Length(Glob.GameMoves) - 4));
        Glob.GameMoves = Ret.GetSubstringLeft.Substring;
        Glob.HasBlackCastled = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 1);
        Glob.HasBlackKingMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 2);
        Glob.HasBlackRookKSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 3);
        Glob.HasBlackRookQSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 4);
        Glob.HasWhiteCastled = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 5);
        Glob.HasWhiteKingMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 6);
        Glob.HasWhiteRookKSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 7);
        Glob.HasWhiteRookQSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 8);
        Call CalcBoardStats;
    }
}

Define UpdateMoveHashPosEval(string Piece)(string SourceIdx)(string TargetIdx)(bool PosScoreUpdate)(string Ply) (warp=true)
{
    Call GetPiecePosHash(Piece)(SourceIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash - Ret.GetPiecePosHash.Hash);
    If ((abs(Piece) == GoK_BlackPawn) Or (abs(Piece) == GoK_BlackKing))
    {
        Glob.KPHash = (Glob.KPHash - Ret.GetPiecePosHash.Hash);
    }
    Call GetPiecePosHash(Piece)(TargetIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
    If ((abs(Piece) == GoK_BlackPawn) Or (abs(Piece) == GoK_BlackKing))
    {
        Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
    }
}

Define UpdateMoveNotationPV (warp=true)
{
    Glob.PV = "";
    UMNPV.PVIdx = 2;
    Repeat (PV[1])
    {
        Glob.PV = Operator.Join(Operator.Join(Glob.PV, PV[UMNPV.PVIdx]), " ");
        UMNPV.PVIdx += 1;
    }
}

Define UpdateNNUEPostApplyMove(string Ply) (warp=true)
{
    Call NNUE_Public_OnApplyMoveDone(Ply)(AppliedMove[Ply])(SourcePieces[Ply])(TargetPieces[Ply])(PromotionPieces[Ply])(TargetPiecesIdx[Ply]);
}

Define UpdatePV(string Ply)(string BestMove) (warp=true)
{
    If ((Betas[Ply] - Alphas[Ply]) == 1)
    {
        Stop(this script);
    }
    If (Glob.IsInNullMove > 0)
    {
        Stop(this script);
    }
    UPV.Idx = (((Ply - 1) * Const.MaxPlyStackFrames) + 1);
    UPV.PVSliceStart = ((Ply * Const.MaxPlyStackFrames) + 1);
    UPV.PVLength = PV[UPV.PVSliceStart];
    List.ReplaceItem(PV, UPV.Idx, (UPV.PVLength + 1));
    List.ReplaceItem(PVRaw, UPV.Idx, (UPV.PVLength + 1));
    Call GetMoveNotation(BestMove);
    List.ReplaceItem(PV, (UPV.Idx + 1), Ret.GetMoveNotation.Notation);
    List.ReplaceItem(PVRaw, (UPV.Idx + 1), BestMove);
    UPV.Idx += 2;
    UPV.PVSliceStart += 1;
    Repeat (UPV.PVLength)
    {
        List.ReplaceItem(PV, UPV.Idx, PV[UPV.PVSliceStart]);
        List.ReplaceItem(PVRaw, UPV.Idx, PVRaw[UPV.PVSliceStart]);
        UPV.Idx += 1;
        UPV.PVSliceStart += 1;
    }
    If (Ply == 1)
    {
        If ((PV[1] > 1) Or (1 == 1))
        {
            Call UpdateMoveNotationPV;
            List.DeleteAll(PVStable);
            UPV.Idx = 2;
            Repeat (PVRaw[1])
            {
                List.Add(PVStable, PVRaw[UPV.Idx]);
                UPV.Idx += 1;
            }
        }
    }
}
