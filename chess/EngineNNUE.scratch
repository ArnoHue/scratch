    If (List.Length(HistoryContinuation) == 400000)
    {
        InitBoard.ListIdx = 1;
        Repeat (400000)
        {
            List.ReplaceItem(HistoryContinuation, InitBoard.ListIdx, 0);
            List.ReplaceItem(HistoryContinuation2, InitBoard.ListIdx, 0);
            List.ReplaceItem(HistoryContinuation3, InitBoard.ListIdx, 0);
            List.ReplaceItem(HistoryContinuation4, InitBoard.ListIdx, 0);
            InitBoard.ListIdx += 1;
        }
    }
    Else
    {
        List.DeleteItem(HistoryContinuation, all);
        List.DeleteItem(HistoryContinuation2, all);
        List.DeleteItem(HistoryContinuation3, all);
        List.DeleteItem(HistoryContinuation4, all);
        If (Glob.Config.IsScratch3 == 0)
        {
            Repeat (400000)
            {
                List.Add(HistoryContinuation, 0);
                List.Add(HistoryContinuation2, 0);
                List.Add(HistoryContinuation3, 0);
                List.Add(HistoryContinuation4, 0);
            }
        }
    }
    List.DeleteItem(BoardHistory, all);
    List.DeleteItem(BoardHistoryFiftyMoves, all);
    List.DeleteItem(BoardHistoryHash, all);
    List.DeleteItem(BoardHistoryMetaState, all);
    List.DeleteItem(BoardHistoryWasEngineMove, all);
    List.DeleteItem(GameMovesAN, all);
    Glob.Game.FenFullMove = 1;
    Glob.Game.FenBlackToMove = 0;
    Glob.Game.FenPlyBase = 0;
    List.DeleteItem(BoardAttackedByWhite, all);
    List.DeleteItem(BoardAttackedByBlack, all);
    List.DeleteItem(PieceMobility, all);
    List.DeleteItem(BoardAttackedEvasionTarget, all);
    List.DeleteItem(BoardAttackedByWhitePiece, all);
    List.DeleteItem(BoardAttackedByBlackPiece, all);
    List.DeleteItem(BoardAttackedByOpponentSnapshot, all);
    List.DeleteItem(BoardAttackedByOpponentPieceSnapshot, all);
    Repeat (64)
    {
        List.Add(BoardAttackedByWhite, 0);
        List.Add(BoardAttackedByBlack, 0);
        List.Add(PieceMobility, 0);
        List.Add(BoardAttackedEvasionTarget, 0);
        List.Add(BoardAttackedByWhitePiece, 0);
        List.Add(BoardAttackedByBlackPiece, 0);
    }
    Repeat ((100 * Const.MaxPlyStackFrames))
    {
        List.Add(BoardAttackedByOpponentSnapshot, 0);
        List.Add(BoardAttackedByOpponentPieceSnapshot, 0);
    }
    Call //("Due to the lack of local variables in Scratch, we emulate a method stack for recursive Minimax using lists");
    List.DeleteItem(Alphas, all);
    List.DeleteItem(PlyHistoryBaseIdx, all);
    List.DeleteItem(PlyIsOwn, all);
    List.DeleteItem(PlySign, all);
    List.DeleteItem(PlyContinuationBaseIdx, all);
    List.DeleteItem(PlyCounterMoveBaseIdx, all);
    List.DeleteItem(PlyCorrectionBaseIdx, all);
    List.DeleteItem(Betas, all);
    List.DeleteItem(AlphasOld, all);
    List.DeleteItem(IsPvNode, all);
    List.DeleteItem(IsTTPv, all);
    List.DeleteItem(SearchEval, all);
    List.DeleteItem(MovesCount, all);
    List.DeleteItem(MovesIdx, all);
    List.DeleteItem(BestMoveListIdx, all);
    List.DeleteItem(TargetPieces, all);
    List.DeleteItem(PreviousBoardHash, all);
    List.DeleteItem(PreviousBoardHashKP, all);
    List.DeleteAll(PreviousNonPawnHashBlack);
    List.DeleteAll(PreviousNonPawnHashWhite);
    List.DeleteItem(ScoreTypes, all);
    List.DeleteItem(PickMoveRes, all);
    List.DeleteItem(PickPhase, all);
    List.DeleteItem(HorizonAtPly, all);
    List.DeleteItem(PickCaptureStageDone, all);
    List.DeleteItem(PickBadCaptureCount, all);
    List.DeleteItem(PickedPseudoLegalMovesCount, all);
    List.DeleteItem(BestMoves, all);
    List.DeleteAll(IsCurrentMoveQuiet);
    List.DeleteAll(IsBestMoveQuiet);
    List.DeleteItem(CheckedState, all);
    List.DeleteItem(PromotionPieces, all);
    List.DeleteItem(TargetPiecesIdx, all);
    List.DeleteItem(BoardAttackedCalculated, all);
    List.DeleteItem(PutsInCheck, all);
    List.DeleteItem(SearchExtension, all);
    List.DeleteItem(SourcePieces, all);
    List.DeleteItem(AppliedMove, all);
    List.DeleteItem(Quiescence, all);
    List.DeleteItem(EnPassantTarget, all);
    List.DeleteItem(CastlingState, all);
    List.DeleteItem(StaticEval, all);
    List.DeleteItem(StaticEval, all);
    List.DeleteItem(HashMove, all);
    List.DeleteItem(LMRState, all);
    List.DeleteItem(SingularQuietLMR, all);
    List.DeleteItem(DoubleExtensions, all);
    List.DeleteItem(SingularNodeBeta, all);
    List.DeleteItem(SingularNodeAlpha, all);
    List.DeleteItem(SingularBeta, all);
    List.DeleteItem(SingularMove, all);
    List.DeleteItem(SingularExtension, all);
    List.DeleteItem(SingularState, all);
    List.DeleteItem(ProbCutBeta, all);
    List.DeleteItem(IIDState, all);
    List.DeleteItem(RazorState, all);
    List.DeleteItem(CapturesSearchedCount, all);
    List.DeleteItem(QuietsSearchedCount, all);
    List.DeleteAll(NodeTTStaticEval);
    List.DeleteAll(NodeTTMove);
    List.DeleteAll(NodeTTQSMeta);
    List.DeleteAll(NodeTTHorizon);
    List.DeleteAll(NodeTTType);
    List.DeleteAll(NodeTTScore);
    List.DeleteAll(NodeTTHit);
    List.DeleteAll(TTSlot);
    List.DeleteAll(TTSlotHash);
    List.DeleteAll(ReductionBase);
    List.DeleteAll(Improving);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(Alphas, 0);
        List.Add(Betas, 0);
        List.Add(AlphasOld, Const.Null);
        List.Add(IsPvNode, Const.Null);
        List.Add(IsTTPv, 0);
        List.Add(SearchEval, Const.Null);
        List.Add(MovesCount, 0);
        List.Add(MovesIdx, 0);
        List.Add(BestMoveListIdx, Const.Null);
        List.Add(TargetPieces, Const.Null);
        List.Add(PreviousBoardHash, 0);
        List.Add(PreviousBoardHashKP, 0);
        List.Add(PreviousNonPawnHashBlack, 0);
        List.Add(PreviousNonPawnHashWhite, 0);
        List.Add(ScoreTypes, Const.TTType.None);
        List.Add(PickMoveRes, Const.Null);
        List.Add(PickPhase, Const.Null);
        List.Add(HorizonAtPly, 0);
        List.Add(PickCaptureStageDone, 0);
        List.Add(PickBadCaptureCount, 0);
        List.Add(PickedPseudoLegalMovesCount, 0);
        List.Add(BestMoves, Const.Null);
        List.Add(IsCurrentMoveQuiet, 0);
        List.Add(IsBestMoveQuiet, 0);
        List.Add(CheckedState, Const.Null);
        List.Add(PromotionPieces, Const.Null);
        List.Add(TargetPiecesIdx, 0);
        List.Add(BoardAttackedCalculated, Const.Null);
        List.Add(PutsInCheck, Const.Null);
        List.Add(SearchExtension, Const.Null);
        List.Add(SourcePieces, 0);
        List.Add(AppliedMove, Const.Null);
        List.Add(Quiescence, Const.Null);
        List.Add(EnPassantTarget, Const.Null);
        List.Add(CastlingState, 0);
        List.Add(StaticEval, Const.Null);
        List.Add(HashMove, Const.Null);
        List.Add(LMRState, Const.Null);
        List.Add(DoubleExtensions, 0);
        List.Add(SingularQuietLMR, 0);
        List.Add(SingularState, 0);
        List.Add(SingularExtension, 0);
        List.Add(SingularMove, Const.Null);
        List.Add(SingularBeta, Const.Null);
        List.Add(SingularNodeAlpha, Const.Null);
        List.Add(SingularNodeBeta, Const.Null);
        List.Add(IIDState, 0);
        List.Add(ProbCutBeta, Const.Null);
        List.Add(RazorState, 0);
        List.Add(QuietsSearchedCount, 0);
        List.Add(CapturesSearchedCount, 0);
        List.Add(NodeTTStaticEval, Const.Null);
        List.Add(NodeTTMove, Const.Null);
        List.Add(NodeTTQSMeta, Const.Null);
        List.Add(NodeTTHorizon, Const.Null);
        List.Add(NodeTTType, Const.Null);
        List.Add(NodeTTScore, Const.Null);
        List.Add(NodeTTHit, Const.Null);
        List.Add(TTSlot, Const.Null);
        List.Add(TTSlotHash, Const.Null);
        List.Add(ReductionBase, Const.Null);
        List.Add(Improving, Const.Null);
    }
    InitBoard.PlyIdx = 1;
    Repeat ((Const.MaxPlyStackFrames + 2))
    {
        List.Add(PlyHistoryBaseIdx, ((InitBoard.PlyIdx % 2) * 4200));
        List.Add(PlyIsOwn, (InitBoard.PlyIdx % 2));
        List.Add(PlySign, (((InitBoard.PlyIdx % 2) * 2) - 1));
        List.Add(PlyContinuationBaseIdx, (((InitBoard.PlyIdx + 1) % 2) * 200000));
        List.Add(PlyCounterMoveBaseIdx, ((InitBoard.PlyIdx % 2) * 1000));
        List.Add(PlyCorrectionBaseIdx, ((InitBoard.PlyIdx % 2) * 100000));
        InitBoard.PlyIdx += 1;
    }
    List.DeleteItem(PV, all);
    List.DeleteItem(PVRaw, all);
    List.DeleteItem(PVStable, all);
    List.DeleteItem(PVStablePrev, all);
    Repeat ((Const.MaxPlyStackFrames * Const.MaxPlyStackFrames))
    {
        List.Add(PV, 0);
        List.Add(PVRaw, 0);
    }
    List.DeleteItem(CastlingBit, all);
    InitBoard.Idx = 0;
    Repeat (256)
    {
        List.Add(CastlingBit, (floor((InitBoard.Idx / 128)) % 2));
        List.Add(CastlingBit, (floor((InitBoard.Idx / 64)) % 2));
        List.Add(CastlingBit, (floor((InitBoard.Idx / 32)) % 2));
        List.Add(CastlingBit, (floor((InitBoard.Idx / 16)) % 2));
        List.Add(CastlingBit, (floor((InitBoard.Idx / 8)) % 2));
        List.Add(CastlingBit, (floor((InitBoard.Idx / 4)) % 2));
        List.Add(CastlingBit, (floor((InitBoard.Idx / 2)) % 2));
        List.Add(CastlingBit, (InitBoard.Idx % 2));
        InitBoard.Idx += 1;
    }
    List.DeleteItem(CastlingStatePow2, all);
    InitBoard.Idx = 128;
    Repeat (8)
    {
        List.Add(CastlingStatePow2, InitBoard.Idx);
        InitBoard.Idx = (InitBoard.Idx / 2);
    }
    List.DeleteItem(PawnCount, all);
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    Call //("Generated moves are stores in per-ply segments within Moves list");
    List.DeleteAll(Moves);
    List.DeleteAll(MovesScore);
    List.DeleteAll(PickBadCaptureMoves);
    List.DeleteAll(PickBadCaptureScores);
    Repeat ((Const.MaxMovesPerGeneration * Const.MaxPlyStackFrames))
    {
        List.Add(Moves, 0);
        List.Add(MovesScore, 0);
        List.Add(PickBadCaptureMoves, 0);
        List.Add(PickBadCaptureScores, 0);
    }
    List.DeleteAll(QuietsSearched);
    List.DeleteAll(CapturesSearched);
    Repeat ((64 * Const.MaxPlyStackFrames))
    {
        List.Add(QuietsSearched, 0);
        List.Add(CapturesSearched, 0);
    }
    List.DeleteAll(PickedPseudoLegalMoves);
    List.DeleteAll(PickedPseudoLegalMovesScore);
    Repeat ((Const.MaxMovesPerGeneration * Const.MaxPlyStackFrames))
    {
        List.Add(PickedPseudoLegalMoves, 0);
        List.Add(PickedPseudoLegalMovesScore, 0);
    }
    List.DeleteAll(PickedLegalMovesCount);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(PickedLegalMovesCount, 0);
    }
    List.DeleteAll(PickedLegalMovesCountQuiet);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(PickedLegalMovesCountQuiet, 0);
    }
}

Define InitBoardPhase2 (warp=true)
{
    Call InitHashLookup;
    Call InitMoveLookup;
    Call InitMobilityBonusLookup;
    Call InitKingSafety;
    Call InitPieceSquareTables;
    Call CalcBoardStats;
    Call InitMovePosLookup((1 == 1));
    Call InitOpeningBook;
    Call InitBookMap;
    Call InitChebyshev;
    Call NNUE_Init;
    List.DeleteAll(CastlingKingMove);
    List.DeleteAll(CastlingRookMove);
    Repeat (68)
    {
        List.Add(CastlingKingMove, 0);
        List.Add(CastlingRookMove, 0);
    }
    List.ReplaceItem(CastlingKingMove, GoK_WhiteKingsideCastling, ((NNUE_GoKIdxToSquare[61] * 100) + NNUE_GoKIdxToSquare[63]));
    List.ReplaceItem(CastlingRookMove, GoK_WhiteKingsideCastling, ((NNUE_GoKIdxToSquare[64] * 100) + NNUE_GoKIdxToSquare[62]));
    List.ReplaceItem(CastlingKingMove, GoK_WhiteQueensideCastling, ((NNUE_GoKIdxToSquare[61] * 100) + NNUE_GoKIdxToSquare[59]));
    List.ReplaceItem(CastlingRookMove, GoK_WhiteQueensideCastling, ((NNUE_GoKIdxToSquare[57] * 100) + NNUE_GoKIdxToSquare[60]));
    List.ReplaceItem(CastlingKingMove, GoK_BlackKingsideCastling, ((NNUE_GoKIdxToSquare[5] * 100) + NNUE_GoKIdxToSquare[7]));
    List.ReplaceItem(CastlingRookMove, GoK_BlackKingsideCastling, ((NNUE_GoKIdxToSquare[8] * 100) + NNUE_GoKIdxToSquare[6]));
    List.ReplaceItem(CastlingKingMove, GoK_BlackQueensideCastling, ((NNUE_GoKIdxToSquare[5] * 100) + NNUE_GoKIdxToSquare[3]));
    List.ReplaceItem(CastlingRookMove, GoK_BlackQueensideCastling, ((NNUE_GoKIdxToSquare[1] * 100) + NNUE_GoKIdxToSquare[4]));
    Call AddBoardToHistory("");
}

Define InitBookMap (warp=true)
{
    List.DeleteAll(OpeningMovesMapHash);
    List.DeleteAll(OpeningMovesMapMove);
    List.DeleteAll(OpeningMovesMapStack);
    Repeat (List.Length(OpeningMoves))
    {
        List.Add(OpeningMovesMapStack, 1);
    }
    Call CreateCurrentBoardHash;
    Call InitBookMapImpl((1 + Glob.Game.IsPlayerBlack))(0)("")((1 == 1));
}

Define InitBookMapImpl(string Ply)(string GameMovesLen)(string Move)(bool Init) (warp=true)
{
    List.DeleteAll(OpeningMovesRes);
    InitBookMapImpl.OpeningMovesMapStackIdx = 1;
    Repeat (List.Length(OpeningMovesMapStack))
    {
        InitBookMapImpl.IsEqual = 0;
        InitBookMapImpl.Line = OpeningMoves[InitBookMapImpl.OpeningMovesMapStackIdx];
        If ((OpeningMovesMapStack[InitBookMapImpl.OpeningMovesMapStackIdx] % 2) == 1)
        {
            InitBookMapImpl.IsEqual = 1;
            InitBookMapImpl.CharIdx = 1;
            If (Not (Init))
            {
                Repeat Until ((InitBookMapImpl.IsEqual == 0) Or (InitBookMapImpl.CharIdx > 4))
                {
                    If (Not ((Operator.LetterOf(Move, InitBookMapImpl.CharIdx) == Operator.LetterOf(InitBookMapImpl.Line, (GameMovesLen + InitBookMapImpl.CharIdx)))))
                    {
                        InitBookMapImpl.IsEqual = 0;
                    }
                    InitBookMapImpl.CharIdx += 1;
                }
            }
        }
        If (InitBookMapImpl.IsEqual == 1)
        {
            InitBookMapImpl.MoveStr = Operator.Join(Operator.Join(Operator.LetterOf(InitBookMapImpl.Line, (GameMovesLen + InitBookMapImpl.CharIdx)), Operator.LetterOf(InitBookMapImpl.Line, ((GameMovesLen + InitBookMapImpl.CharIdx) + 1))), Operator.Join(Operator.LetterOf(InitBookMapImpl.Line, ((GameMovesLen + InitBookMapImpl.CharIdx) + 2)), Operator.LetterOf(InitBookMapImpl.Line, ((GameMovesLen + InitBookMapImpl.CharIdx) + 3))));
            If (Not ((InitBookMapImpl.MoveStr == "")))
            {
                List.Add(OpeningMovesRes, (InitBookMapImpl.MoveStr + 0));
            }
            List.ReplaceItem(OpeningMovesMapStack, InitBookMapImpl.OpeningMovesMapStackIdx, ((OpeningMovesMapStack[InitBookMapImpl.OpeningMovesMapStackIdx] * 2) + 1));
        }
        Else
        {
            List.ReplaceItem(OpeningMovesMapStack, InitBookMapImpl.OpeningMovesMapStackIdx, (OpeningMovesMapStack[InitBookMapImpl.OpeningMovesMapStackIdx] * 2));
        }
        InitBookMapImpl.OpeningMovesMapStackIdx += 1;
    }
    If (List.Length(OpeningMovesRes) > 0)
    {
        List.DeleteAll(TmpList1);
        Call ClearMoveList(Ply);
        InitBookMapImpl.OpeningMovesReIdx = 1;
        Repeat (List.Length(OpeningMovesRes))
        {
            InitBookMapImpl.MoveStr = OpeningMovesRes[InitBookMapImpl.OpeningMovesReIdx];
            List.Add(OpeningMovesMapHash, Glob.Board.CurrentHash);
            List.Add(OpeningMovesMapMove, InitBookMapImpl.MoveStr);
            If (Not (List.ContainsItem(TmpList1, InitBookMapImpl.MoveStr)))
            {
                Call AddMoveToList((InitBookMapImpl.MoveStr + 0))(Ply)(0);
                List.Add(TmpList1, InitBookMapImpl.MoveStr);
            }
            InitBookMapImpl.OpeningMovesReIdx += 1;
        }
        List.ReplaceItem(MovesIdx, Ply, 1);
        Repeat (MovesCount[Ply])
        {
            Call ApplyMoveLight(Ply);
            Call GetCurrentMove(Ply);
            If Init
            {
                Call GetNormalizedMove(AppliedMove[Ply]);
                Call InitBookMapImpl((Ply + 1))(0)(Ret.GetNormalizedMove.Move)((1 == 0));
            }
            Else
            {
                Call GetNormalizedMove(AppliedMove[Ply]);
                Call InitBookMapImpl((Ply + 1))((GameMovesLen + 4))(Ret.GetNormalizedMove.Move)((1 == 0));
            }
            Call RevertMoveLight(Ply);
            List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
        }
    }
    InitBookMapImpl.OpeningMovesMapStackIdx = 1;
    Repeat (List.Length(OpeningMovesMapStack))
    {
        List.ReplaceItem(OpeningMovesMapStack, InitBookMapImpl.OpeningMovesMapStackIdx, floor((OpeningMovesMapStack[InitBookMapImpl.OpeningMovesMapStackIdx] / 2)));
        InitBookMapImpl.OpeningMovesMapStackIdx += 1;
    }
}

Define InitChebyshev (warp=true)
{
    List.DeleteAll(ChebyshevDistance);
    Repeat (6500)
    {
        List.Add(ChebyshevDistance, 0);
    }
    InitChebyshev.FromSqIdx = 1;
    Repeat (64)
    {
        InitChebyshev.ToSqIdx = 1;
        Repeat (64)
        {
            InitChebyshev.RankDist = abs((IdxToRank[InitChebyshev.FromSqIdx] - IdxToRank[InitChebyshev.ToSqIdx]));
            InitChebyshev.FileDist = abs((IdxToFile[InitChebyshev.FromSqIdx] - IdxToFile[InitChebyshev.ToSqIdx]));
            If (InitChebyshev.RankDist > InitChebyshev.FileDist)
            {
                List.ReplaceItem(ChebyshevDistance, ((InitChebyshev.FromSqIdx * 100) + InitChebyshev.ToSqIdx), InitChebyshev.RankDist);
            }
            Else
            {
                List.ReplaceItem(ChebyshevDistance, ((InitChebyshev.FromSqIdx * 100) + InitChebyshev.ToSqIdx), InitChebyshev.FileDist);
            }
            InitChebyshev.ToSqIdx += 1;
        }
        InitChebyshev.FromSqIdx += 1;
    }
}

Define InitCoordLookup (warp=true)
{
    List.DeleteItem(RankFlipIdx, all);
    List.DeleteItem(IdxToFile, all);
    List.DeleteItem(IdxToRank, all);
    InitCoordLookup.Idx = 1;
    Repeat (64)
    {
        List.Add(IdxToFile, (((InitCoordLookup.Idx - 1) % 8) + 1));
        List.Add(IdxToRank, ceiling((InitCoordLookup.Idx / 8)));
        List.Add(RankFlipIdx, (((8 - IdxToRank[InitCoordLookup.Idx]) * 8) + IdxToFile[InitCoordLookup.Idx]));
        InitCoordLookup.Idx += 1;
    }
}

Define InitHashLookup (warp=true)
{
    Glob.TT.CurrentAge = 0;
    List.DeleteItem(PosPieceHashLookup, all);
    InitHashLookup.Seed = 1070372;
    Repeat (1024)
    {
        InitHashLookup.Seed = ((InitHashLookup.Seed * 48271) % 2147483647);
        InitHashLookup.High = InitHashLookup.Seed;
        InitHashLookup.Seed = ((InitHashLookup.Seed * 48271) % 2147483647);
        List.Add(PosPieceHashLookup, ((((InitHashLookup.High - 1) * 32768) + (InitHashLookup.Seed % 32768)) + 1));
    }
    If (List.Length(TTNodeEntry) > 0)
    {
        Call ClearTT;
    }
}

