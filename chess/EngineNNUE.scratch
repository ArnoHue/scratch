Define SearchNextPly(string Alpha)(string Beta)(string Horizon)(string Reduction)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    SNP.NextHorizon = (((Horizon + SearchExtension[Ply]) - Reduction) - 1);
    If (SNP.NextHorizon < 0)
    {
        SNP.NextHorizon = 0;
    }
    Call SearchImpl(Alpha)(Beta)(SNP.NextHorizon)((Ply + 1))(Cutnode)((Quiescence Or (SNP.NextHorizon < 1)))(ExcludedMove);
}

Define Search_CollectStats(string Horizon)(string Ply)(bool Quiescence)(string QSCode)(string FullCode) (warp=true)
{
    If Quiescence
    {
        Call Profile_CountByHorizon(QSCode)(Horizon)(Ply);
    }
    Else
    {
        Call Profile_CountByHorizon(FullCode)(Horizon)(Ply);
    }
}

Define Search_ComputeReduction(string Horizon)(string Ply)(bool Cutnode) (warp=true)
{
    If (ReductionBase[Ply] == Const.Null)
    {
        Call Search_ComputeReductionBase(Horizon)(Ply);
        If (Ret.Search_ComputeReductionBase.IsApplicable == 1)
        {
            List.ReplaceItem(ReductionBase, Ply, Ret.Search_ComputeReductionBase.Reduction);
        }
        Else
        {
            List.ReplaceItem(ReductionBase, Ply, Const.Null);
        }
    }
    Ret.Search_ComputeReduction.Reduction = 0;
    If (Not ((ReductionBase[Ply] == Const.Null)))
    {
        Ret.Search_ComputeReduction.Reduction = ((floor((ReductionBase[Ply] / 128)) + Cutnode) - (SingularQuietLMR[Ply] * (SingularState[Ply] == 1)));
        If ((1 == 0) And (Ret.Search_ComputeReduction.Reduction > ((Horizon + SearchExtension[Ply]) - 2)))
        {
            Ret.Search_ComputeReduction.Reduction = ((Horizon + SearchExtension[Ply]) - 2);
        }
        If (Ret.Search_ComputeReduction.Reduction < 0)
        {
            Ret.Search_ComputeReduction.Reduction = 0;
        }
    }
}

Define Search_ComputeReductionBase(string Horizon)(string Ply) (warp=true)
{
    Search.CR.DangerousPush = 0;
    Ret.Search_ComputeReductionBase.IsApplicable = 0;
    Ret.Search_ComputeReductionBase.Reduction = 0;
    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
    {
        Search.CR.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.CR.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.CR.PushRank < 4)))
        {
            Search.CR.DangerousPush = 1;
        }
    }
    If (Search.CR.DangerousPush == 1)
    {
        Stop(this script);
    }
    If ((Horizon + SearchExtension[Ply]) > 2)
    {
        If ((CheckedState[Ply] == 0) And ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0)))
        {
            Call //("LMR search");
            Search.CR.MinMoveCount = (2 + (2 * (IsPvNode[Ply] == 1)));
            If (Search.CR.MinMoveCount == 0)
            {
                Search.CR.MinMoveCount = 1;
            }
            If (PickedLegalMovesCount[Ply] > Search.CR.MinMoveCount)
            {
                Ret.Search_ComputeReductionBase.IsApplicable = 1;
                Ret.Search_ComputeReductionBase.Reduction = floor(((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + SearchExtension[Ply]))) / 2.25)) * 128));
                If (1 == 1)
                {
                    If (IsPvNode[Ply] == 1)
                    {
                        Ret.Search_ComputeReductionBase.Reduction += -128;
                    }
                }
                If (1 == 1)
                {
                    If (PutsInCheck[Ply] == 1)
                    {
                        Ret.Search_ComputeReductionBase.Reduction += -64;
                    }
                }
                If (1 == 1)
                {
                    Search.CR.HistFrom = floor((AppliedMove[Ply] / 100));
                    Search.CR.HistTo = floor((AppliedMove[Ply] % 100));
                    If (Search.CR.HistFrom == 0)
                    {
                        If ((AppliedMove[Ply] == 65) Or (AppliedMove[Ply] == 66))
                        {
                            Search.CR.HistFrom = 5;
                        }
                        Else
                        {
                            Search.CR.HistFrom = 61;
                        }
                        If (AppliedMove[Ply] == 65)
                        {
                            Search.CR.HistTo = 8;
                        }
                        Else
                        {
                            If (AppliedMove[Ply] == 66)
                            {
                                Search.CR.HistTo = 1;
                            }
                            Else
                            {
                                If (AppliedMove[Ply] == 67)
                                {
                                    Search.CR.HistTo = 64;
                                }
                                Else
                                {
                                    Search.CR.HistTo = 57;
                                }
                            }
                        }
                    }
                    Search.CR.KPHash = Glob.KPHash;
                    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
                    {
                        Glob.KPHash = PreviousBoardHashKP[Ply];
                    }
                    Call GetHistoryStatScore(SourcePieces[Ply])(Search.CR.HistFrom)(Search.CR.HistTo)(AppliedMove[Ply])(Ply);
                    Glob.KPHash = Search.CR.KPHash;
                    If (1 == 1)
                    {
                        Ret.Search_ComputeReductionBase.Reduction += (0 - Operator.Round(((Ret.GetHistoryStatScore.Score / 82000) * 128)));
                    }
                }
                If (1 == 1)
                {
                    Call GetImproving(Ply);
                    If (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))
                    {
                        Ret.Search_ComputeReductionBase.Reduction += -128;
                    }
                }
            }
        }
    }
}

Define Search_Core(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    Ret.Search_Core.NodeEval = Const.Null;
    List.ReplaceItem(LMRState, Ply, 0);
    Search.Core.LmrNonPV.IsReSearchRequired = 1;
    If ((Not (Quiescence)) And (Glob.IsSearchTimeout == 0))
    {
        Call Search_ComputeReduction(Horizon)(Ply)(Cutnode);
        Search.Core.Reduction = Ret.Search_ComputeReduction.Reduction;
        If (Search.Core.Reduction > 0)
        {
            If (Glob.ProfilerMode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.LMRCalls)(Horizon)(Ply);
            }
            Call SearchNextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(Search.Core.Reduction)(Ply)((1 == 1))(Quiescence)(Const.Null);
            Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
            {
                Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
            }
            Search.Core.LmrNonPV.IsReSearchRequired = 0;
            List.ReplaceItem(LMRState, Ply, 1);
            If (Not (((Not ((Ret.Search_Core.NodeEval == Const.Null))) And (Ret.Search_Core.NodeEval > Alphas[Ply]))))
            {
                If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.LMRHits)(Horizon)(Ply);
                }
            }
        }
        Call //("Non-PV search");
        Search.Core.IsFullDepthResearch = 0;
        If (Glob.IsSearchTimeout == 0)
        {
            If (Search.Core.LmrNonPV.IsReSearchRequired == 0)
            {
                If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
                {
                    If (Ret.Search_Core.NodeEval > Alphas[Ply])
                    {
                        Search.Core.IsFullDepthResearch = 1;
                    }
                }
            }
            Else
            {
                If ((PickedLegalMovesCount[Ply] > 1) Or (IsPvNode[Ply] == 0))
                {
                    Search.Core.IsFullDepthResearch = 1;
                }
            }
        }
        If (Search.Core.IsFullDepthResearch == 1)
        {
            If (Glob.ProfilerMode > Const.ProfilerMode.Off)
            {
                If (IsPvNode[Ply] == 1)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVSCalls)(Horizon)(Ply);
                }
            }
            Call SearchNextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((Not (Cutnode)))(Quiescence)(Const.Null);
            Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
            {
                Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
            }
            If (LMRState[Ply] == 1)
            {
                If ((Not ((Ret.Search_Core.NodeEval == Const.Null))) And (Ret.Search_Core.NodeEval > Alphas[Ply]))
                {
                    List.ReplaceItem(LMRState, Ply, 2);
                }
                Else
                {
                    List.ReplaceItem(LMRState, Ply, 3);
                }
            }
            Search.Core.IsPVReSearch = 0;
            If (IsPvNode[Ply] == 1)
            {
                If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
                {
                    If (Ret.Search_Core.NodeEval > Alphas[Ply])
                    {
                        If ((Ret.Search_Core.NodeEval < Betas[Ply]) Or (Ply == 1))
                        {
                            Search.Core.IsPVReSearch = 1;
                        }
                    }
                }
            }
            If (Search.Core.IsPVReSearch == 1)
            {
                Search.Core.LmrNonPV.IsReSearchRequired = 1;
                If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVSReSearches)(Horizon)(Ply);
                }
            }
            Else
            {
                Search.Core.LmrNonPV.IsReSearchRequired = 0;
            }
        }
    }
    If ((Search.Core.LmrNonPV.IsReSearchRequired == 1) And (Glob.IsSearchTimeout == 0))
    {
        If (Glob.ProfilerMode > Const.ProfilerMode.Off)
        {
            Call Profile_CountByHorizon(Const.Profile.FullCalls)(Horizon)(Ply);
        }
        Call //("Move was not pruned upfront, enter full depth + current window search");
        Call SearchNextPly((0 - Betas[Ply]))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((1 == 0))(Quiescence)(Const.Null);
        Ret.Search_Core.NodeEval = SearchEval[(Ply + 1)];
        If (Not ((Ret.Search_Core.NodeEval == Const.Null)))
        {
            Ret.Search_Core.NodeEval = (0 - Ret.Search_Core.NodeEval);
        }
    }
}

Define Search_DetectCheckmate(string Ply) (warp=true)
{
    If (Ply > 1)
    {
        Call //("Virtual king captures on previous ply => depth-corrected checkmate evaluation");
        If (abs(TargetPieces[(Ply - 1)]) == GoK_BlackKing)
        {
            List.ReplaceItem(SearchEval, Ply, (0 - (100000 - (List.Length(BoardHistoryFiftyMoves) - 1))));
            Stop(this script);
        }
        If (1 == 0)
        {
            If ((Ply == 2) Or (CheckedState[(Ply - 1)] == 1))
            {
                Call //("Early checkmate evaluation on previous checks when not evaded. As we now have special check evasion search, this is mainly for safety");
                Call CalcBoardAttackedByMoveChecked(Ply);
                If (((PlyIsOwn[Ply] == 1) And (Glob.IsWhiteChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsBlackChecked == 1)))
                {
                    List.ReplaceItem(SearchEval, Ply, (100000 - List.Length(BoardHistoryFiftyMoves)));
                    Stop(this script);
                }
            }
        }
    }
    If (ChebyshevDistance[((Glob.BlackKingIdx * 100) + Glob.WhiteKingIdx)] < 2)
    {
        List.ReplaceItem(SearchEval, Ply, (100000 - List.Length(BoardHistoryFiftyMoves)));
        List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
        Stop(this script);
    }
}

Define Search_DetectDraw(string Horizon)(string Ply) (warp=true)
{
    Search.DD.IsDraw = 0;
    If (Ply > 1)
    {
        Call //("Draw-by-stalemate detection. This is expensive, and is only applied at low search depth or during late endgame stage (no minor pieces left)");
        If (Ply < 9)
        {
            If (Not ((CheckedState[Ply] == 1)))
            {
                If (PlyIsOwn[Ply] == 1)
                {
                    Search.DD.QueenCount = Glob.BlackQueenCount;
                    Search.DD.MinorMajorCount = Glob.BlackNonQueenMajorMinorCount;
                }
                Else
                {
                    Search.DD.QueenCount = Glob.WhiteQueenCount;
                    Search.DD.MinorMajorCount = Glob.WhiteNonQueenMajorMinorCount;
                }
                If ((Search.DD.QueenCount == 0) And (Search.DD.MinorMajorCount < 2))
                {
                    If (1 == 0)
                    {
                        Call IsDrawByStalemate((Ply + 2));
                        If (Ret.IsDrawByStalemate.IsDraw == 1)
                        {
                            Search.DD.IsDraw = 1;
                        }
                    }
                }
            }
        }
        Call //("Fast draw-by-material verification");
        If (((Glob.BlackQueenCount == 0) And (Glob.WhiteQueenCount == 0)) And ((Glob.BlackPawnCount == 0) And (Glob.WhitePawnCount == 0)))
        {
            If (((Glob.BlackRookCount == 0) And (Glob.BlackNonQueenMajorMinorCount < 2)) And ((Glob.WhiteRookCount == 0) And (Glob.WhiteNonQueenMajorMinorCount < 2)))
            {
                Search.DD.IsDraw = 1;
            }
        }
        If (Search.DD.IsDraw == 0)
        {
            Call //("Special K-KP endgame draw detection, according to pawn and king position. Finds draws otherwise not visible within search horizon");
            If ((Ply > 1) And (Quiescence[(Ply - 1)] == 0))
            {
                If (((Glob.WhiteQueenCount + Glob.WhiteNonQueenMajorMinorCount) == 0) And ((Glob.BlackQueenCount + Glob.BlackNonQueenMajorMinorCount) == 0))
                {
                    If ((Glob.BlackPawnCount + Glob.WhitePawnCount) == 1)
                    {
                        Search.DD.SqIdx = 1;
                        Repeat (64)
                        {
                            If ((Board[Search.DD.SqIdx] == GoK_WhitePawn) And (PlyIsOwn[Ply] == 0))
                            {
                                If ((IdxToFile[Search.DD.SqIdx] == 1) Or (IdxToFile[Search.DD.SqIdx] == 8))
                                {
                                    If ((IdxToFile[Search.DD.SqIdx] == IdxToFile[Glob.BlackKingIdx]) And (IdxToRank[Glob.BlackKingIdx] < IdxToRank[Search.DD.SqIdx]))
                                    {
                                        Search.DD.IsDraw = 1;
                                    }
                                }
                                Else
                                {
                                    If (((Search.DD.SqIdx - 8) == Glob.BlackKingIdx) Or ((Search.DD.SqIdx - 16) == Glob.BlackKingIdx))
                                    {
                                        If (Not ((((Search.DD.SqIdx - 1) == Glob.WhiteKingIdx) Or ((Search.DD.SqIdx + 1) == Glob.WhiteKingIdx))))
                                        {
                                            Search.DD.IsDraw = 1;
                                        }
                                    }
                                    If ((Search.DD.SqIdx - 24) == Glob.BlackKingIdx)
                                    {
                                        If ((IdxToRank[Search.DD.SqIdx] > 4) And ((Search.DD.SqIdx - 8) == Glob.WhiteKingIdx))
                                        {
                                            Search.DD.IsDraw = 1;
                                        }
                                    }
                                }
                            }
                            Else
                            {
                                If ((Board[Search.DD.SqIdx] == GoK_BlackPawn) And (PlyIsOwn[Ply] == 1))
                                {
                                    If ((IdxToFile[Search.DD.SqIdx] == 1) Or (IdxToFile[Search.DD.SqIdx] == 8))
                                    {
                                        If ((IdxToFile[Search.DD.SqIdx] == IdxToFile[Glob.WhiteKingIdx]) And (IdxToRank[Glob.WhiteKingIdx] > IdxToRank[Search.DD.SqIdx]))
                                        {
                                            Search.DD.IsDraw = 1;
                                        }
                                    }
                                    Else
                                    {
                                        If (((Search.DD.SqIdx + 8) == Glob.WhiteKingIdx) Or ((Search.DD.SqIdx + 16) == Glob.WhiteKingIdx))
                                        {
                                            If (Not ((((Search.DD.SqIdx - 1) == Glob.BlackKingIdx) Or ((Search.DD.SqIdx + 1) == Glob.BlackKingIdx))))
                                            {
                                                Search.DD.IsDraw = 1;
                                            }
                                        }
                                        If ((Search.DD.SqIdx + 24) == Glob.WhiteKingIdx)
                                        {
                                            If ((IdxToRank[Search.DD.SqIdx] < 5) And ((Search.DD.SqIdx + 8) == Glob.BlackKingIdx))
                                            {
                                                Search.DD.IsDraw = 1;
                                            }
                                        }
                                    }
                                }
                            }
                            Search.DD.SqIdx += 1;
                        }
                    }
                }
            }
        }
    }
    If (Search.DD.IsDraw == 1)
    {
        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
    }
}

Define Search_DetectDrawByRepetition(string Ply)(bool Quiescence) (warp=true)
{
    If (Ply > 1)
    {
        If ((BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 99) And (CheckedState[Ply] == 0))
        {
            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
            Stop(this script);
        }
        Call //("Draw-by-repetition detection. This happens on every ply and could be costly, so we check previous plies for pawn moves and captures. When repetition is possible, history tables are searched for same board hash, when found we verify if the occurred for the same side.");
        If (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 3)
        {
            Search.DDBR.Count = 1;
            Search.DDBR.RepHistCount = 0;
            If List.ContainsItem(PreviousBoardHash, (Glob.CurrentBoardHash + 0))
            {
                Search.DDBR.Idx = (Ply - 2);
                Repeat Until ((Search.DDBR.Idx < 2) Or (Search.DDBR.Count > 2))
                {
                    If ((AppliedMove[Search.DDBR.Idx] == 0) Or (AppliedMove[(Search.DDBR.Idx + 1)] == 0))
                    {
                        Search.DDBR.Idx = 0;
                    }
                    Else
                    {
                        If ((((Glob.CurrentBoardHash + 0) == PreviousBoardHash[Search.DDBR.Idx]) And (CastlingState[Ply] == CastlingState[(Search.DDBR.Idx - 1)])) And (EnPassantTarget[Ply] == EnPassantTarget[(Search.DDBR.Idx - 1)]))
                        {
                            Search.DDBR.Count += 1;
                        }
                    }
                    Search.DDBR.Idx += -2;
                }
            }
            If (Glob.IsInNullMove == 0)
            {
                If List.ContainsItem(BoardHistoryHash, (Glob.CurrentBoardHash + 0))
                {
                    Search.DDBR.Idx = ((List.Length(BoardHistoryHash) - 1) + PlyIsOwn[Ply]);
                    Repeat Until ((Search.DDBR.Idx < 1) Or (Search.DDBR.RepHistCount > 2))
                    {
                        If (((Glob.CurrentBoardHash + 0) == BoardHistoryHash[Search.DDBR.Idx]) And (CastlingState[Ply] == BoardHistoryMetaState[Search.DDBR.Idx]))
                        {
                            Search.DDBR.RepHistCount += 1;
                        }
                        Search.DDBR.Idx += -2;
                    }
                }
            }
            If ((Search.DDBR.Count > 1) Or (Search.DDBR.RepHistCount > 1))
            {
                List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
                Stop(this script);
            }
        }
    }
}

Define Search_DetectExtensions(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Not (Quiescence))
    {
        If ((SingularState[Ply] == 1) And (AppliedMove[Ply] == SingularMove[Ply]))
        {
            List.ReplaceItem(SearchExtension, Ply, SingularExtension[Ply]);
            Stop(this script);
        }
        If (SearchExtension[Ply] == 0)
        {
            If ((Horizon > 1) And ((PutsInCheck[Ply] == 1) And ((StaticEval[Ply] == Const.Null) Or (abs(StaticEval[Ply]) > 35.5))))
            {
                List.ReplaceItem(SearchExtension, Ply, 1);
                If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_FutilityPruning(string Horizon)(string Ply)(bool Quiescence) (warp=true)
{
    If (Glob.ProfilerMode > Const.ProfilerMode.Off)
    {
        Call Search_CollectStats(Horizon)(Ply)(Quiescence)(Const.Profile.DeltaCalls)(Const.Profile.FutilityCalls);
    }
    Ret.Search_FutilityPruning.IsFutile = 0;
    Search.FP.DangerousPush = 0;
    If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
    {
        Search.FP.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.FP.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.FP.PushRank < 4)))
        {
            Search.FP.DangerousPush = 1;
        }
    }
    If ((Search.FP.DangerousPush == 1) And (Not (Quiescence)))
    {
        Stop(this script);
    }
    If (((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0)) And (PromotionPieces[Ply] == 0))
    {
        If (1 == 1)
        {
            Search.FP.CanPrune = 0;
            If (PlyIsOwn[Ply] == 1)
            {
                Search.FP.PieceCount = (Glob.BlackQueenCount + Glob.BlackNonQueenMajorMinorCount);
            }
            Else
            {
                Search.FP.PieceCount = (Glob.WhiteQueenCount + Glob.WhiteNonQueenMajorMinorCount);
            }
            If (Not (Quiescence))
            {
                If (Not ((SearchEval[Ply] == Const.Null)))
                {
                    If (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval))
                    {
                        If (Search.FP.PieceCount > 0)
                        {
                            Search.FP.CanPrune = 1;
                        }
                    }
                }
            }
            If (Search.FP.CanPrune == 1)
            {
                If ((Not (Quiescence)) And ((IsPvNode[Ply] == 0) And (TargetPieces[Ply] == 0)))
                {
                    Call GetImproving(Ply);
                    Search.FP.IsImproving = Ret.GetImproving.IsImproving;
                    If (Search.FP.IsImproving == Const.Null)
                    {
                        Search.FP.IsImproving = 1;
                    }
                    If (PickedLegalMovesCountQuiet[Ply] > (3 + ((Horizon * Horizon) / (2 - (Search.FP.IsImproving == 1)))))
                    {
                        Ret.Search_FutilityPruning.IsFutile = 1;
                        Stop(this script);
                    }
                }
            }
        }
        Search.FP.SEEGain = Const.Null;
        Search.FP.FutilityMargin = Const.Null;
        If Quiescence
        {
            If ((Not ((TargetPieces[Ply] == 0))) And (Search.FP.PieceCount > 0))
            {
                Search.FP.FutilityMargin = 175;
            }
        }
        Else
        {
            If (Search.FP.CanPrune == 1)
            {
                If ((Ply > 1) And (Horizon < 6))
                {
                    If ((TargetPieces[Ply] == 0) And ((PickedLegalMovesCount[Ply] > 1) And (IsPvNode[Ply] == 0)))
                    {
                        If (1 == 1)
                        {
                            Search.FP.Reduction = 0;
                            If (((Horizon + SearchExtension[Ply]) > 2) And (PickedLegalMovesCount[Ply] > 2))
                            {
                                Search.FP.Reduction = floor((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + SearchExtension[Ply]))) / 2.25)));
                                Call GetImproving(Ply);
                                If (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))
                                {
                                    Search.FP.Reduction += -1;
                                }
                            }
                            If (Search.FP.Reduction > (Horizon - 1))
                            {
                                Search.FP.Reduction = (Horizon - 1);
                            }
                            Search.FP.FutilityMargin = (103 + ((Horizon - Search.FP.Reduction) * 127));
                            If (Not ((floor((AppliedMove[Ply] / 100)) == 0)))
                            {
                                Search.FP.KPHash = Glob.KPHash;
                                If (abs(SourcePieces[Ply]) == GoK_BlackPawn)
                                {
                                    Glob.KPHash = PreviousBoardHashKP[Ply];
                                }
                                Call GetHistoryStatScore(SourcePieces[Ply])(floor((AppliedMove[Ply] / 100)))(floor((AppliedMove[Ply] % 100)))(AppliedMove[Ply])(Ply);
                                Glob.KPHash = Search.FP.KPHash;
                                Search.FP.FutilityMargin += floor((Ret.GetHistoryStatScore.Score / 120));
                            }
                        }
                    }
                }
            }
        }
        If (Not ((Search.FP.FutilityMargin == Const.Null)))
        {
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Search.FP.Eval = ((StaticEval[Ply] - (TargetPieces[Ply] * PlySign[Ply])) + Search.FP.FutilityMargin);
                If (Not ((Search.FP.Eval > Alphas[Ply])))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                }
                Else
                {
                    If Quiescence
                    {
                        Search.FP.Eval = (StaticEval[Ply] + Search.FP.FutilityMargin);
                        If (Not ((Search.FP.Eval > Alphas[Ply])))
                        {
                            Call SEE(Ply)((Glob.IsScratch3 == 0));
                            Search.FP.SEEGain = Ret.SEE.Gain;
                            If (Not ((Search.FP.SEEGain > 0)))
                            {
                                Ret.Search_FutilityPruning.IsFutile = 1;
                            }
                        }
                    }
                }
                If (Ret.Search_FutilityPruning.IsFutile == 1)
                {
                    If Quiescence
                    {
                        If (Search.FP.Eval > SearchEval[Ply])
                        {
                            List.ReplaceItem(SearchEval, Ply, Search.FP.Eval);
                        }
                    }
                }
            }
        }
        If (1 == 0)
        {
            If (Ret.Search_FutilityPruning.IsFutile == 0)
            {
                If ((Not (Quiescence)) And ((Ply > 1) And (Horizon < 6)))
                {
                    If ((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0))
                    {
                        If (Search.FP.SEEGain == Const.Null)
                        {
                            Call SEE(Ply)((Glob.IsScratch3 == 0));
                            Search.FP.SEEGain = Ret.SEE.Gain;
                        }
                        If (Search.FP.SEEGain < (-125 * Horizon))
                        {
                            Ret.Search_FutilityPruning.IsFutile = 1;
                        }
                    }
                }
            }
        }
        If ((Quiescence And (Ret.Search_FutilityPruning.IsFutile == 0)) And (Not ((TargetPieces[Ply] == 0))))
        {
            If (Glob.ProfilerMode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.QSEECalls)(Horizon)(Ply);
            }
            If (Search.FP.SEEGain == Const.Null)
            {
                Call SEE(Ply)((Glob.IsScratch3 == 0));
                Search.FP.SEEGain = Ret.SEE.Gain;
            }
            If (Search.FP.SEEGain < 0)
            {
                Ret.Search_FutilityPruning.IsFutile = 1;
                If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.QSEEHits)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_InitStack(string Ply)(bool Quiescence) (warp=true)
{
    If (Not (Quiescence))
    {
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 1), Const.Null);
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 2), Const.Null);
    }
    Call NNUE_OnInitStack(Ply);
    Call //("Initialize local variables or forward state from previous ply");
    If (Ply == 1)
    {
        Call CalcBoardAttackedByMove(2);
        Call StoreAttackInfo(1);
        List.ReplaceItem(BoardAttackedCalculated, 1, 1);
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
        If (Not ((CastlingState[1] == Const.Null)))
        {
            If ((Operator.LetterOf(CastlingState[1], 1) == 1) Or ((Operator.LetterOf(CastlingState[1], 2) == 1) Or ((Operator.LetterOf(CastlingState[1], 3) == 1) And (Operator.LetterOf(CastlingState[1], 4) == 1))))
            {
                Call SetCastlingStateFlag(1)(1)(1);
                Call SetCastlingStateFlag(1)(2)(1);
                Call SetCastlingStateFlag(1)(3)(1);
                Call SetCastlingStateFlag(1)(4)(1);
            }
            If ((Operator.LetterOf(CastlingState[1], 5) == 1) Or ((Operator.LetterOf(CastlingState[1], 6) == 1) Or ((Operator.LetterOf(CastlingState[1], 7) == 1) And (Operator.LetterOf(CastlingState[1], 8) == 1))))
            {
                Call SetCastlingStateFlag(1)(5)(1);
                Call SetCastlingStateFlag(1)(6)(1);
                Call SetCastlingStateFlag(1)(7)(1);
                Call SetCastlingStateFlag(1)(8)(1);
            }
        }
        Call SetInitialEnPassantTarget(1);
    }
    Else
    {
        List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
        List.ReplaceItem(CheckedState, Ply, PutsInCheck[(Ply - 1)]);
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
    }
    List.ReplaceItem(AlphasOld, Ply, Alphas[Ply]);
    If ((Betas[Ply] - Alphas[Ply]) > 1)
    {
        List.ReplaceItem(IsPvNode, Ply, 1);
        If ((Not (Quiescence)) And (Ply > Glob.SelDepth))
        {
            Glob.SelDepth = Ply;
        }
    }
    Else
    {
        List.ReplaceItem(IsPvNode, Ply, 0);
    }
    List.ReplaceItem(SearchExtension, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(DoubleExtensions, Ply, 0);
    }
    Else
    {
        List.ReplaceItem(DoubleExtensions, Ply, (DoubleExtensions[(Ply - 1)] + (SearchExtension[(Ply - 1)] == 2)));
    }
    List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
    List.ReplaceItem(BestMoves, Ply, Const.Null);
    List.ReplaceItem(IsBestMoveQuiet, Ply, 0);
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(StaticEval, Ply, Const.Null);
    List.ReplaceItem(Improving, Ply, Const.Null);
    List.ReplaceItem(LMRState, Ply, 0);
    List.ReplaceItem(QuietsSearchedCount, Ply, 0);
    List.ReplaceItem(CapturesSearchedCount, Ply, 0);
    List.ReplaceItem(PV, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    List.ReplaceItem(PVRaw, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    If Quiescence
    {
        List.ReplaceItem(Quiescence, Ply, 1);
    }
    Else
    {
        List.ReplaceItem(Quiescence, Ply, 0);
    }
    Call Evaluate((Ply - 1))((1 == 0));
    List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCount, Ply, 0);
}

Define Search_InternalIterativeDeepening(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    If ((IIDState[Ply] == 0) And (Not (Quiescence)))
    {
        If (Horizon > 5)
        {
            If ((CheckedState[Ply] == 0) And (IsPvNode[Ply] == 1))
            {
                If (1 == 0)
                {
                    If (NodeTTMove[Ply] == Const.Null)
                    {
                        List.ReplaceItem(IIDState, Ply, 1);
                    }
                }
            }
        }
    }
}

Define Search_NullMovePruning(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    Call //("Null move pruning");
    If (1 == 1)
    {
        If (Not ((AppliedMove[(Ply - 1)] == 0)))
        {
            Glob.IsInNullMove += 1;
            If (Not (Quiescence))
            {
                If ((Horizon > 2) And ((IsPvNode[Ply] == 0) And (CheckedState[Ply] == 0)))
                {
                    If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                    {
                        Call Profile_CountByHorizon(Const.Profile.NMPCalls)(Horizon)(Ply);
                    }
                    If (((PlyIsOwn[Ply] == 1) And ((Glob.BlackQueenCount + Glob.BlackNonQueenMajorMinorCount) > 0)) Or ((PlyIsOwn[Ply] == 0) And ((Glob.WhiteQueenCount + Glob.WhiteNonQueenMajorMinorCount) > 0)))
                    {
                        If (Not ((StaticEval[Ply] == Const.Null)))
                        {
                            Call GetCalibratedEval(Ply);
                            Search.NMP.EvalSurplus = (Ret.GetCalibratedEval.Score - Betas[Ply]);
                            If (Search.NMP.EvalSurplus > 535)
                            {
                                Search.NMP.EvalSurplus = 535;
                            }
                            Search.NMP.Reduction = ((3 + floor((Horizon / 3))) + floor((Search.NMP.EvalSurplus / 107)));
                            If (Search.NMP.Reduction < 0)
                            {
                                Search.NMP.Reduction = 0;
                            }
                            If ((Search.NMP.Reduction > 0) And (Search.NMP.EvalSurplus > 0))
                            {
                                Call GetImproving(Ply);
                                Search.NMP.IsImproving = Ret.GetImproving.IsImproving;
                                If (Search.NMP.IsImproving == Const.Null)
                                {
                                    Search.NMP.IsImproving = 1;
                                }
                                Search.NMP.Margin = 0;
                                Search.NMP.Eval = Ret.GetCalibratedEval.Score;
                                If (Not ((Search.NMP.Eval == Const.Null)))
                                {
                                    If ((Not ((Search.NMP.Eval < (Betas[Ply] + Search.NMP.Margin)))) And (Not ((Search.NMP.Eval < StaticEval[Ply]))))
                                    {
                                        Call ClearMoveList(Ply);
                                        Call AddMoveToList(0)(Ply)(0);
                                        If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                                        {
                                            Call Profile_CountByHorizon(Const.Profile.NMPTries)(Horizon)(Ply);
                                        }
                                        List.ReplaceItem(MovesIdx, Ply, 1);
                                        Call ApplyMove(Ply)((1 == 0));
                                        Call NNUE_OnApplyMove(Ply);
                                        Call SearchNextPly((0 - Betas[Ply]))((0 - (Betas[Ply] - 1)))(Horizon)(Search.NMP.Reduction)(Ply)((Not (Cutnode)))(Quiescence)(Const.Null);
                                        Search.NMP.NodeEval = SearchEval[(Ply + 1)];
                                        If (Not ((Search.NMP.NodeEval == Const.Null)))
                                        {
                                            Search.NMP.NodeEval = (0 - Search.NMP.NodeEval);
                                        }
                                        Call RevertMove(Ply);
                                        If (Not ((Search.NMP.NodeEval == Const.Null)))
                                        {
                                            Search.NMP.NodeEvalAbs = abs(Search.NMP.NodeEval);
                                            If (Not ((Search.NMP.NodeEvalAbs > Const.AbsMinCheckmateEval)))
                                            {
                                                If ((Not ((Search.NMP.NodeEval < Betas[Ply]))) And (Not ((abs(Search.NMP.NodeEval) > Const.AbsMinCheckmateEval))))
                                                {
                                                    List.ReplaceItem(SearchEval, Ply, Search.NMP.NodeEval);
                                                    If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                                                    {
                                                        Call Profile_CountByHorizon(Const.Profile.NMPHits)(Horizon)(Ply);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Glob.IsInNullMove += -1;
        }
    }
}

Define Search_OnBestRootMoveFound(string Move)(string Eval) (warp=true)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
}

Define Search_Razoring(string Horizon)(string Ply)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (1 == 1)
    {
        If (((Not (Quiescence)) And ((CheckedState[Ply] == 0) And (Horizon < 5))) And (IsPvNode[Ply] == 0))
        {
            If (Glob.ProfilerMode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.RazoringCalls)(Horizon)(Ply);
            }
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Search.Razoring.Margin = (174 + (129 * (Horizon * Horizon)));
                Call GetCalibratedEval(Ply);
                If (Not ((Ret.GetCalibratedEval.Score == Const.Null)))
                {
                    If (((Ret.GetCalibratedEval.Score + Search.Razoring.Margin) < Alphas[Ply]) And (RazorState[Ply] == 0))
                    {
                        If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                        {
                            Call Profile_CountByHorizon(Const.Profile.RazoringTries)(Horizon)(Ply);
                        }
                        Call SearchImpl(Alphas[Ply])(Betas[Ply])(0)(Ply)((1 == 1))((1 == 1))(Const.Null);
                        If (Not ((SearchEval[Ply] == Const.Null)))
                        {
                            If (1 == 1)
                            {
                                If (SearchEval[Ply] < AlphasOld[Ply])
                                {
                                    If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                                    {
                                        List.ReplaceItem(ProfileByHorizon, (Const.Profile.RazoringHits + (Horizon + 1)), (ProfileByHorizon[(Const.Profile.RazoringHits + (Horizon + 1))] + 1));
                                    }
                                    Stop(this script);
                                }
                            }
                        }
                        List.ReplaceItem(Alphas, Ply, AlphasOld[Ply]);
                        List.ReplaceItem(SearchEval, Ply, Const.Null);
                        List.ReplaceItem(RazorState, Ply, 1);
                        Stop(this script);
                    }
                }
            }
        }
    }
}

Define Search_ReverseFutilityPruning(string Horizon)(string Ply) (warp=true)
{
    If (1 == 1)
    {
        If (((Ply > 1) And (Horizon < 8)) And ((CheckedState[Ply] == 0) And (IsTTPv[Ply] == 0)))
        {
            If (Glob.ProfilerMode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.RFPCalls)(Horizon)(Ply);
            }
            If (abs(Betas[Ply]) > Const.AbsMinCheckmateEval)
            {
                Stop(this script);
            }
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Call GetImproving(Ply);
                Search.RFP.Margin = (117 * (Horizon - (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))));
                If (Search.RFP.Margin < 15)
                {
                    Search.RFP.Margin = 15;
                }
                Call GetCalibratedEval(Ply);
                If (Not ((Ret.GetCalibratedEval.Score == Const.Null)))
                {
                    If ((Not (((Ret.GetCalibratedEval.Score - Search.RFP.Margin) < Betas[Ply]))) And (Ret.GetCalibratedEval.Score < 13152))
                    {
                        List.ReplaceItem(SearchEval, Ply, Ret.GetCalibratedEval.Score);
                        If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                        {
                            Call Profile_CountByHorizon(Const.Profile.RFPHits)(Horizon)(Ply);
                        }
                    }
                }
            }
        }
    }
}

Define Search_TTProbeEval(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    Search.TTPE.Rule50 = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
    If ((Ply > 1) And (ExcludedMove == Const.Null))
    {
        If (IsPvNode[Ply] == 0)
        {
            Call //("Probe transposition table for cached node evaluations");
            Search.TTPE.TTType = NodeTTType[Ply];
            Search.TTPE.TTScore = NodeTTScore[Ply];
            Search.TTPE.TTQSMeta = NodeTTQSMeta[Ply];
            Search.TTPE.TTHorizon = NodeTTHorizon[Ply];
            Search.TTPE.TTHit = NodeTTHit[Ply];
            If (Glob.ProfilerMode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.TTNodeProbe)(Horizon)(Ply);
            }
            If (Search.TTPE.TTHit == 1)
            {
                If ((Not ((Search.TTPE.TTScore == Const.Null))) And (Not ((Search.TTPE.TTHorizon == Const.Null))))
                {
                    Call IsQuiescentCheckCond(Ply);
                    Search.TTPE.IsTTCutoffAllowed = 0;
                    If Quiescence
                    {
                        If (Search.TTPE.TTHorizon > -1)
                        {
                            Search.TTPE.IsTTCutoffAllowed = 1;
                        }
                        Else
                        {
                            If ((Search.TTPE.TTHorizon > -2) And ((Not ((Search.TTPE.TTQSMeta == Const.Null))) And (Not ((Search.TTPE.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue)))))
                            {
                                Search.TTPE.IsTTCutoffAllowed = 1;
                            }
                        }
                    }
                    Else
                    {
                        If ((Not ((Search.TTPE.TTHorizon < Horizon))) And (Search.TTPE.Rule50 < 90))
                        {
                            If ((Not ((Search.TTPE.TTScore > Alphas[Ply]))) Or Cutnode)
                            {
                                Search.TTPE.IsTTCutoffAllowed = 1;
                            }
                        }
                    }
                    If (Search.TTPE.IsTTCutoffAllowed == 1)
                    {
                        Search.TTPE.IsTTCutoff = 0;
                        If (Search.TTPE.TTType == Const.TTType.Exact)
                        {
                            Search.TTPE.IsTTCutoff = 1;
                        }
                        Else
                        {
                            If (IsPvNode[Ply] == 0)
                            {
                                If (Search.TTPE.TTType == Const.TTType.HighBound)
                                {
                                    If (Not ((Search.TTPE.TTScore > Alphas[Ply])))
                                    {
                                        Search.TTPE.IsTTCutoff = 1;
                                    }
                                }
                                Else
                                {
                                    If (Search.TTPE.TTType == Const.TTType.LowBound)
                                    {
                                        If (Not ((Search.TTPE.TTScore < Betas[Ply])))
                                        {
                                            Search.TTPE.IsTTCutoff = 1;
                                        }
                                    }
                                }
                            }
                        }
                        If (Search.TTPE.IsTTCutoff == 1)
                        {
                            If (1 == 1)
                            {
                                If ((Not ((NodeTTMove[Ply] == Const.Null))) And (Not ((Search.TTPE.TTScore < Betas[Ply]))))
                                {
                                    Call IsQuietMove(NodeTTMove[Ply]);
                                    If (Ret.IsQuietMove.IsQuiet == 1)
                                    {
                                        If (Not (Quiescence))
                                        {
                                            Call StoreKillerMove(Ply)(NodeTTMove[Ply])(Horizon)((1 == 0))((1 == 0))((1 == 1));
                                        }
                                    }
                                }
                                If ((Not (Quiescence)) And (Not ((NodeTTMove[Ply] == Const.Null))))
                                {
                                    If (Search.TTPE.TTScore < Betas[Ply])
                                    {
                                        Call IsQuietMove(NodeTTMove[Ply]);
                                        If (Ret.IsQuietMove.IsQuiet == 1)
                                        {
                                            Call StoreKillerMove(Ply)(NodeTTMove[Ply])(Horizon)((1 == 1))((1 == 0))((1 == 1));
                                        }
                                    }
                                }
                                List.ReplaceItem(SearchEval, Ply, Search.TTPE.TTScore);
                                If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.TTNodeHit)(Horizon)(Ply);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define SEE(string MovePly)(bool WithPinFilter) (warp=true)
{
    Ret.SEE.Gain = 0;
    If (floor((AppliedMove[MovePly] / 100)) == 0)
    {
        Stop(this script);
    }
    SEE.Ply = MovePly;
    SEE.TargetIdx = floor((AppliedMove[SEE.Ply] % 100));
    If ((abs(SourcePieces[SEE.Ply]) == GoK_BlackPawn) And ((IdxToRank[SEE.TargetIdx] == 1) Or (IdxToRank[SEE.TargetIdx] == 8)))
    {
        Ret.SEE.Gain = 0;
        Stop(this script);
    }
    List.DeleteAll(SEE.TmpList4);
    List.DeleteAll(SEE.TmpList5);
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesMoveList))
    {
        List.Add(SEE.TmpList4, CalcMovesMoveList[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesScoreList))
    {
        List.Add(SEE.TmpList5, CalcMovesScoreList[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Side = 1;
    If (PlyIsOwn[MovePly] == 1)
    {
        SEE.Side = 2;
    }
    Else
    {
        SEE.Side = 1;
    }
    SEE.IsDone = 0;
    Repeat Until (SEE.IsDone == 1)
    {
        List.DeleteAll(CalcMovesMoveList);
        List.DeleteAll(CalcMovesScoreList);
        SEE.SourceIdx = 1;
        If WithPinFilter
        {
            SEE.Pin.QIdx = PieceIdxLookup[GoK_BlackQueen];
        }
        Repeat (64)
        {
            SEE.SourcePiece = Board[(SEE.SourceIdx + 0)];
            If (((SEE.Side == 1) And (SEE.SourcePiece > 0)) Or ((SEE.Side == 2) And (SEE.SourcePiece < 0)))
            {
                Call IsReachableForAttack(Board[(SEE.SourceIdx + 0)])(SEE.SourceIdx)(SEE.TargetIdx);
                If (Ret.IsReachableForAttack.IsReachable == 1)
                {
                    SEE.Pin.IsPinned = 0;
                    If (WithPinFilter And (Not ((abs(Board[SEE.TargetIdx]) == GoK_BlackKing))))
                    {
                        SEE.Pin.AttackerPiece = Board[SEE.SourceIdx];
                        If (SEE.Pin.AttackerPiece > 0)
                        {
                            SEE.Pin.King = Glob.BlackKingIdx;
                        }
                        Else
                        {
                            SEE.Pin.King = Glob.WhiteKingIdx;
                        }
                        SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.SourceIdx * 100)) + SEE.Pin.King);
                        If (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0)))))
                        {
                            SEE.Pin.Move = ((SEE.Pin.King * 100) + SEE.SourceIdx);
                            SEE.Pin.RayStep = MoveToPathStepInc[SEE.Pin.Move];
                            SEE.Pin.Walk = SEE.Pin.King;
                            SEE.Pin.PathClear = 1;
                            Repeat ((MoveToPathDelta[SEE.Pin.Move] - 1))
                            {
                                SEE.Pin.Walk += SEE.Pin.RayStep;
                                SEE.Pin.PathClear = (SEE.Pin.PathClear * (Board[SEE.Pin.Walk] == 0));
                            }
                            If (SEE.Pin.PathClear == 1)
                            {
                                List.ReplaceItem(Board, SEE.SourceIdx, 0);
                                SEE.Pin.Walk = (SEE.SourceIdx + SEE.Pin.RayStep);
                                SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                SEE.Pin.OnLine = (0 + ((SEE.Pin.Walk > 0) And ((SEE.Pin.Walk < 65) And (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0))))))));
                                If (SEE.Pin.OnLine == 1)
                                {
                                    SEE.Pin.BlockerPiece = Board[SEE.Pin.Walk];
                                }
                                Else
                                {
                                    SEE.Pin.BlockerPiece = 0;
                                }
                                Repeat Until ((Not ((SEE.Pin.OnLine == 1))) Or (Not ((SEE.Pin.BlockerPiece == 0))))
                                {
                                    SEE.Pin.Walk += SEE.Pin.RayStep;
                                    SEE.Pin.MoveToHashIdx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                    SEE.Pin.OnLine = (0 + ((SEE.Pin.Walk > 0) And ((SEE.Pin.Walk < 65) And (((SEE.Pin.AttackerPiece > 0) And (Not ((MoveToHash[(60000 + SEE.Pin.MoveToHashIdx)] == 0)))) Or ((SEE.Pin.AttackerPiece < 0) And (Not ((MoveToHash[SEE.Pin.MoveToHashIdx] == 0))))))));
                                    If (SEE.Pin.OnLine == 1)
                                    {
                                        SEE.Pin.BlockerPiece = Board[SEE.Pin.Walk];
                                    }
                                    Else
                                    {
                                        SEE.Pin.BlockerPiece = 0;
                                    }
                                }
                                If (((SEE.Pin.OnLine == 1) And ((SEE.Pin.AttackerPiece * SEE.Pin.BlockerPiece) < 0)) And (Not ((SEE.Pin.Walk == SEE.TargetIdx))))
                                {
                                    Call IsCheckingPiece(SEE.Pin.Walk);
                                    If (Ret.IsCheckingPiece.IsChecking == 1)
                                    {
                                        SEE.Pin.IsPinned = 1;
                                    }
                                }
                                List.ReplaceItem(Board, SEE.SourceIdx, SEE.Pin.AttackerPiece);
                            }
                        }
                    }
                    If (SEE.Pin.IsPinned == 0)
                    {
                        List.Add(CalcMovesMoveList, SEE.SourceIdx);
                        List.Add(CalcMovesScoreList, (0 - abs(SEE.SourcePiece)));
                    }
                }
            }
            SEE.SourceIdx += 1;
        }
        If (List.Length(CalcMovesMoveList) == 0)
        {
            SEE.IsDone = 1;
        }
        Else
        {
            If ((Const.MaxPlyStackFrames % 2) == 1)
            {
                Call SortMoveList(((Const.MaxPlyStackFrames + 1) - SEE.Side));
            }
            Else
            {
                Call SortMoveList((Const.MaxPlyStackFrames - SEE.Side));
            }
            SEE.SourceIdx = CalcMovesMoveList[1];
            SEE.Move = ((SEE.SourceIdx * 100) + SEE.TargetIdx);
            SEE.Ply += 1;
            Call ClearMoveList(SEE.Ply);
            Call AddMoveToList(SEE.Move)(SEE.Ply)(0);
            List.ReplaceItem(MovesIdx, SEE.Ply, 1);
            Call ApplyMoveLight(SEE.Ply);
            If (abs(TargetPieces[SEE.Ply]) == GoK_BlackKing)
            {
                SEE.IsDone = 1;
            }
            Else
            {
                Glob.MoveCountQuiescence += 1;
                If (SEE.Side == 1)
                {
                    SEE.Side = 2;
                }
                Else
                {
                    SEE.Side = 1;
                }
            }
        }
    }
    SEE.RunningGain = 0;
    Repeat Until (SEE.Ply == MovePly)
    {
        SEE.GainIfCapture = (abs(TargetPieces[SEE.Ply]) - SEE.RunningGain);
        If (SEE.GainIfCapture > 0)
        {
            SEE.RunningGain = SEE.GainIfCapture;
        }
        Else
        {
            SEE.RunningGain = 0;
        }
        Call RevertMoveLight(SEE.Ply);
        SEE.Ply += -1;
    }
    SEE.SwapValue = (abs(TargetPieces[MovePly]) - SEE.RunningGain);
    Ret.SEE.Gain = SEE.SwapValue;
    List.DeleteAll(CalcMovesMoveList);
    List.DeleteAll(CalcMovesScoreList);
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList4))
    {
        List.Add(CalcMovesMoveList, SEE.TmpList4[SEE.Idx]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList5))
    {
        List.Add(CalcMovesScoreList, SEE.TmpList5[SEE.Idx]);
        SEE.Idx += 1;
    }
}

Define SetCastlingStateFlag(string Ply)(string Offset)(string Val) (warp=true)
{
    If (CastlingState[Ply] == Const.Null)
    {
        Stop(this script);
    }
    Set.CSF.CastlingState = CastlingState[Ply];
    If (Not ((Operator.LetterOf(Set.CSF.CastlingState, Offset) == Val)))
    {
        Set.CSF.Idx = (((((Operator.LetterOf(Set.CSF.CastlingState, 1) * 128) + (Operator.LetterOf(Set.CSF.CastlingState, 2) * 64)) + ((Operator.LetterOf(Set.CSF.CastlingState, 3) * 32) + (Operator.LetterOf(Set.CSF.CastlingState, 4) * 16))) + (((Operator.LetterOf(Set.CSF.CastlingState, 5) * 8) + (Operator.LetterOf(Set.CSF.CastlingState, 6) * 4)) + ((Operator.LetterOf(Set.CSF.CastlingState, 7) * 2) + Operator.LetterOf(Set.CSF.CastlingState, 8)))) + 1);
        If (Val == 1)
        {
            List.ReplaceItem(CastlingState, Ply, CastlingStateLookup[(Set.CSF.Idx + CastlingStatePow2[(Offset + 0)])]);
        }
        Else
        {
            List.ReplaceItem(CastlingState, Ply, CastlingStateLookup[(Set.CSF.Idx - CastlingStatePow2[(Offset + 0)])]);
        }
    }
}

Define SetInitialEnPassantTarget(string Ply) (warp=true)
{
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    If (List.Length(GameMoves) > 0)
    {
        Set.IEPT.SourceIdx = floor((GameMoves[List.Length(GameMoves)] / 100));
        Set.IEPT.TargetIdx = floor((GameMoves[List.Length(GameMoves)] % 100));
        If (Set.IEPT.SourceIdx > 0)
        {
            If ((abs(Board[Set.IEPT.TargetIdx]) == GoK_BlackPawn) And (abs((Set.IEPT.TargetIdx - Set.IEPT.SourceIdx)) == 16))
            {
                Set.IEPT.IsEnemyPawnAdjacent = 0;
                If ((IdxToFile[Set.IEPT.TargetIdx] > 1) And (Board[(Set.IEPT.TargetIdx - 1)] == (0 - Board[Set.IEPT.TargetIdx])))
                {
                    Set.IEPT.IsEnemyPawnAdjacent = 1;
                }
                If ((IdxToFile[Set.IEPT.TargetIdx] < 8) And (Board[(Set.IEPT.TargetIdx + 1)] == (0 - Board[Set.IEPT.TargetIdx])))
                {
                    Set.IEPT.IsEnemyPawnAdjacent = 1;
                }
                If (Set.IEPT.IsEnemyPawnAdjacent == 1)
                {
                    List.ReplaceItem(EnPassantTarget, Ply, Set.IEPT.TargetIdx);
                }
            }
        }
    }
}

Define SortList (warp=true)
{
    If (List.Length(CalcMovesScoreList) > 1)
    {
        Call QuickSort;
    }
}

Define SortMoveList(string Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.Add(Moves1, CalcMovesMoveList[SML.Idx]);
            SML.Idx += 1;
        }
        Call SortList;
        SML.Idx = 1;
        SML.MoveCount = List.Length(CalcMovesMoveList);
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, SML.Idx, CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, SML.Idx, CalcMovesScoreList[SML.Idx]);
            List.ReplaceItem(Moves1, SML.Idx, CalcMovesMoveList[SML.Idx]);
            SML.Idx += 1;
            SML.MoveCount += -1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(CalcMovesMoveList, SML.Idx, Moves[SML.Idx]);
            List.ReplaceItem(CalcMovesScoreList, SML.Idx, MovesScore[SML.Idx]);
            SML.Idx += 1;
        }
        Stop(this script);
    }
    If (Ply == 2)
    {
        Call SortList;
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SML.MoveCount + SML.Idx), CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, (SML.MoveCount + SML.Idx), CalcMovesScoreList[SML.Idx]);
            List.Add(Moves2, CalcMovesMoveList[SML.Idx]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        Stop(this script);
    }
    If (PlyIsOwn[Ply] == 1)
    {
        Call SortList;
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SML.MoveCount + SML.Idx), CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, (SML.MoveCount + SML.Idx), CalcMovesScoreList[SML.Idx]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(CalcMovesMoveList, SML.Idx, Moves[(SML.MoveCount + SML.Idx)]);
            List.ReplaceItem(CalcMovesScoreList, SML.Idx, MovesScore[(SML.MoveCount + SML.Idx)]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
    }
    Else
    {
        Call SortList;
        SML.MoveCount = ((Ply - 1) * Const.MaxMovesPerGeneration);
        SML.Idx = 1;
        Repeat (List.Length(CalcMovesMoveList))
        {
            List.ReplaceItem(Moves, (SML.MoveCount + SML.Idx), CalcMovesMoveList[SML.Idx]);
            List.ReplaceItem(MovesScore, (SML.MoveCount + SML.Idx), CalcMovesScoreList[SML.Idx]);
            SML.Idx += 1;
        }
        List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
    }
}

Define StoreAttackInfo(string Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 0)
    {
        If (1 == 0)
        {
            SAI.Packed = "";
            SAI.PackedPieces = "";
            SAI.SqIdx = 1;
            Repeat (16)
            {
                SAI.Packed = Operator.Join(SAI.Packed, MoveToZeroPaddedStr[((((BoardAttackedByBlack[SAI.SqIdx] * 1000) + (BoardAttackedByBlack[(SAI.SqIdx + 1)] * 100)) + ((BoardAttackedByBlack[(SAI.SqIdx + 2)] * 10) + BoardAttackedByBlack[(SAI.SqIdx + 3)])) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByBlackPiece[SAI.SqIdx] * 100) + BoardAttackedByBlackPiece[(SAI.SqIdx + 1)]) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByBlackPiece[(SAI.SqIdx + 2)] * 100) + BoardAttackedByBlackPiece[(SAI.SqIdx + 3)]) + 1)]);
                SAI.SqIdx += 4;
            }
        }
        SAI.SqIdx = 1;
        SAI.SliceStart = (((Ply - 1) * Const.SnapshotPlyStride) + 1);
        Repeat (64)
        {
            List.ReplaceItem(BoardAttackedByOpponentSnapshot, SAI.SliceStart, BoardAttackedByBlack[SAI.SqIdx]);
            List.ReplaceItem(BoardAttackedByOpponentPieceSnapshot, SAI.SliceStart, BoardAttackedByBlackPiece[SAI.SqIdx]);
            SAI.SqIdx += 1;
            SAI.SliceStart += 1;
        }
        SAI.IsChecked = Glob.IsWhiteChecked;
    }
    Else
    {
        If (1 == 0)
        {
            SAI.Packed = "";
            SAI.PackedPieces = "";
            SAI.SqIdx = 1;
            Repeat (16)
            {
                SAI.Packed = Operator.Join(SAI.Packed, MoveToZeroPaddedStr[((((BoardAttackedByWhite[SAI.SqIdx] * 1000) + (BoardAttackedByWhite[(SAI.SqIdx + 1)] * 100)) + ((BoardAttackedByWhite[(SAI.SqIdx + 2)] * 10) + BoardAttackedByWhite[(SAI.SqIdx + 3)])) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByWhitePiece[SAI.SqIdx] * 100) + BoardAttackedByWhitePiece[(SAI.SqIdx + 1)]) + 1)]);
                SAI.PackedPieces = Operator.Join(SAI.PackedPieces, MoveToZeroPaddedStr[(((BoardAttackedByWhitePiece[(SAI.SqIdx + 2)] * 100) + BoardAttackedByWhitePiece[(SAI.SqIdx + 3)]) + 1)]);
                SAI.SqIdx += 4;
            }
        }
        SAI.SqIdx = 1;
        SAI.SliceStart = (((Ply - 1) * Const.SnapshotPlyStride) + 1);
        Repeat (64)
        {
            List.ReplaceItem(BoardAttackedByOpponentSnapshot, SAI.SliceStart, BoardAttackedByWhite[SAI.SqIdx]);
            List.ReplaceItem(BoardAttackedByOpponentPieceSnapshot, SAI.SliceStart, BoardAttackedByWhitePiece[SAI.SqIdx]);
            SAI.SqIdx += 1;
            SAI.SliceStart += 1;
        }
        SAI.IsChecked = Glob.IsBlackChecked;
    }
    List.ReplaceItem(CheckedState, Ply, SAI.IsChecked);
    Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(Const.Null)(Const.Null)(Const.TTType.None)(Const.Null)(Const.Null)(Const.Null);
}

Define StoreExternalBoard (warp=true)
{
    List.DeleteAll(GoK_Board);
    StoreExternalBoard.SqIdx = 1;
    Repeat (64)
    {
        If (Glob.IsPlayerBlack == 1)
        {
            List.Add(GoK_Board, (0 - Board[RankFlipIdx[StoreExternalBoard.SqIdx]]));
        }
        Else
        {
            List.Add(GoK_Board, Board[StoreExternalBoard.SqIdx]);
        }
        StoreExternalBoard.SqIdx += 1;
    }
}

Define StoreKillerMove(string Ply)(string Move)(string Horizon)(bool Malus)(bool ContinuationOnly)(bool QuietOk) (warp=true)
{
    SKM.FromIdx = floor((Move / 100));
    SKM.ToIdx = floor((Move % 100));
    SKM.UnclampedHistoryBonus = ((190 * Horizon) - 108);
    SKM.HistoryBonus = ((((SKM.UnclampedHistoryBonus + 1596) - abs((SKM.UnclampedHistoryBonus - 1596))) / 2) * (1 - (2 * Malus)));
    If ((SKM.FromIdx == 0) And QuietOk)
    {
        If ((((Move == GoK_BlackKingsideCastling) Or (Move == GoK_BlackQueensideCastling)) Or (Move == GoK_WhiteKingsideCastling)) Or (Move == GoK_WhiteQueensideCastling))
        {
            If ((Move == 65) Or (Move == 66))
            {
                SKM.CastleFrom = 5;
            }
            Else
            {
                SKM.CastleFrom = 61;
            }
            If (Move == 65)
            {
                SKM.CastleTo = 8;
            }
            Else
            {
                If (Move == 66)
                {
                    SKM.CastleTo = 1;
                }
                Else
                {
                    If (Move == 67)
                    {
                        SKM.CastleTo = 64;
                    }
                    Else
                    {
                        SKM.CastleTo = 57;
                    }
                }
            }
            If (Not (ContinuationOnly))
            {
                SKM.HistoryMoveScoreIdx = (PlyHistoryBaseIdx[Ply] + ((SKM.CastleFrom * 64) + SKM.CastleTo));
                List.ReplaceItem(HistoryMoveScores, SKM.HistoryMoveScoreIdx, (HistoryMoveScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor((HistoryMoveScores[SKM.HistoryMoveScoreIdx] * (abs(SKM.HistoryBonus) / 7183))))));
            }
            If ((Not (ContinuationOnly)) And (Not (Malus)))
            {
                SKM.KillerSlot = (((Ply - 1) * 2) + 1);
                If (Not (((Not ((KillerMoves[SKM.KillerSlot] == Const.Null))) And (KillerMoves[SKM.KillerSlot] == Move))))
                {
                    List.ReplaceItem(KillerMoves, (SKM.KillerSlot + 1), KillerMoves[SKM.KillerSlot]);
                    List.ReplaceItem(KillerMoves, SKM.KillerSlot, Move);
                }
                If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
    }
    If QuietOk
    {
        If (Not (ContinuationOnly))
        {
            SKM.KillerSlot = (((Ply - 1) * 2) + 1);
            If ((Not (Malus)) And (Not (((Not ((KillerMoves[SKM.KillerSlot] == Const.Null))) And (KillerMoves[SKM.KillerSlot] == Move)))))
            {
                List.ReplaceItem(KillerMoves, (SKM.KillerSlot + 1), KillerMoves[SKM.KillerSlot]);
                List.ReplaceItem(KillerMoves, SKM.KillerSlot, Move);
            }
            If (Not ((SKM.FromIdx == 0)))
            {
                SKM.HistoryMoveScoreIdx = (PlyHistoryBaseIdx[Ply] + ((SKM.FromIdx * 64) + SKM.ToIdx));
                List.ReplaceItem(HistoryMoveScores, SKM.HistoryMoveScoreIdx, (HistoryMoveScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor((HistoryMoveScores[SKM.HistoryMoveScoreIdx] * (abs(SKM.HistoryBonus) / 7183))))));
                Call ProbePawnHist(Board[SKM.FromIdx])(SKM.ToIdx);
                List.ReplaceItem(HistoryPawnHist, Ret.ProbePawnHist.Idx, (HistoryPawnHist[Ret.ProbePawnHist.Idx] + ((SKM.HistoryBonus / 2) - floor((HistoryPawnHist[Ret.ProbePawnHist.Idx] * (abs((SKM.HistoryBonus / 2)) / 8192))))));
            }
            If (Not (Malus))
            {
                If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
        If (SKM.FromIdx == 0)
        {
            SKM.KillerSlot = ((PieceIdxLookup[GoK_BlackKing] * 68) + SKM.CastleTo);
        }
        Else
        {
            SKM.KillerSlot = ((PieceIdxLookup[abs(Board[SKM.FromIdx])] * 68) + SKM.ToIdx);
        }
        SKM.HistoryMoveScoreIdx = -1;
        If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
        {
            SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + SKM.KillerSlot);
        }
        If (Not ((SKM.HistoryMoveScoreIdx == -1)))
        {
            List.ReplaceItem(HistoryContinuation, (PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
        }
        If (Ply > 2)
        {
            If (Not ((AppliedMove[(Ply - 2)] == 0)))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation2, (PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
            }
            If (((Ply > 4) And (CheckedState[Ply] == 0)) And (Not ((AppliedMove[(Ply - 4)] == 0))))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation3, (PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] + ((SKM.HistoryBonus / 1) - floor((HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] * (abs((SKM.HistoryBonus / 1)) / 29952))))));
            }
            If (((Ply > 6) And (CheckedState[Ply] == 0)) And (Not ((AppliedMove[(Ply - 6)] == 0))))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation4, (PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
            }
        }
    }
    SKM.CapturedPiece = Board[SKM.ToIdx];
    If ((SKM.CapturedPiece == 0) And ((abs(Board[SKM.FromIdx]) == GoK_BlackPawn) And (Not ((IdxToFile[SKM.FromIdx] == IdxToFile[SKM.ToIdx])))))
    {
        SKM.CapturedPiece = (0 - Board[SKM.FromIdx]);
    }
    If ((Not ((SKM.FromIdx == 0))) And (Not ((SKM.CapturedPiece == 0))))
    {
        SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(Board[SKM.FromIdx])] - 1) * 384) + (((PieceIdxLookup[abs(SKM.CapturedPiece)] - 1) * 64) + SKM.ToIdx)) + (2304 * (Board[SKM.FromIdx] < 0)));
        List.ReplaceItem(HistoryCaptureScores, SKM.HistoryMoveScoreIdx, (HistoryCaptureScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor(((HistoryCaptureScores[SKM.HistoryMoveScoreIdx] * abs(SKM.HistoryBonus)) / 10692)))));
    }
}

Define TestLog(string TestLogTxt0)(string TestLogTxt1)(string TestLogTxt2)(string TestLogTxt3)(string TestLogTxt4)(string TestLogTxt5)(string TestLogTxt6)(string TestLogTxt7) (warp=true)
{
    List.Add(Logfile, Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join("", TestLogTxt0), TestLogTxt1), TestLogTxt2), TestLogTxt3), TestLogTxt4), TestLogTxt5), TestLogTxt6), TestLogTxt7));
}

Define TestPad(string TestPadText)(string TestPadWidth) (warp=true)
{
    Ret.TestPad.PaddedText = TestPadText;
    Repeat Until (Not ((Variable.Length(Ret.TestPad.PaddedText) < TestPadWidth)))
    {
        Ret.TestPad.PaddedText = Operator.Join(Ret.TestPad.PaddedText, " ");
    }
}

Define TestPerft(string TestPerftPly) (warp=false)
{
    If (Not ((TestPerftPly > 0)))
    {
        Stop(this script);
    }
    Glob.IsTestRunning = 1;
    Glob.IsDCI = 1;
    Call InitTestSuite;
    TST.Perft.PassedCount = 0;
    Glob.PerftCheckMismatches = 0;
    TST.Perft.SearchCount = (List.Length(PerftSuiteFens) * TestPerftPly);
    Call TestLog("=== perft core vs staged movegen, depth 1 to ")(TestPerftPly)("")("")("")("")("")("");
    TST.Perft.Row = "";
    Call TestPad("Perft")(10);
    TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Core")(10);
    TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
    Call TestPad("Staged")(10);
    TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
    TST.Perft.Row = Operator.Join(TST.Perft.Row, "FEN");
    Call TestLog(TST.Perft.Row)("")("")("")("")("")("")("");
    TST.Perft.PosIdx = 1;
    Repeat (List.Length(PerftSuiteFens))
    {
        _dci fen = PerftSuiteFens[TST.Perft.PosIdx];
        _dci think time = 1;
        Call $gok_prepare;
        Call GetBestMoveDeepening;
        TST.Perft.HorizonIdx = 1;
        Repeat (TestPerftPly)
        {
            Glob.PerftNodes = 0;
            Call Perft(1)(TST.Perft.HorizonIdx)(0);
            TST.Perft.CoreNodes = Glob.PerftNodes;
            Glob.PerftNodes = 0;
            Call Perft(1)(TST.Perft.HorizonIdx)(1);
            If ((TST.Perft.CoreNodes == PerftSuiteCounts[(((TST.Perft.PosIdx - 1) * 4) + TST.Perft.HorizonIdx)]) And (Glob.PerftNodes == PerftSuiteCounts[(((TST.Perft.PosIdx - 1) * 4) + TST.Perft.HorizonIdx)]))
            {
                TST.Perft.PassedCount += 1;
                TST.Perft.ResultTxt = "ok";
            }
            Else
            {
                TST.Perft.ResultTxt = "failed";
            }
            TST.Perft.Row = "";
            Call TestPad(Operator.Join(Operator.Join(TST.Perft.PosIdx, " / d="), TST.Perft.HorizonIdx))(10);
            TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.Perft.ResultTxt)(9);
            TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
            Call TestPad(PerftSuiteCounts[(((TST.Perft.PosIdx - 1) * 4) + TST.Perft.HorizonIdx)])(10);
            TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.Perft.CoreNodes)(10);
            TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
            Call TestPad(Glob.PerftNodes)(10);
            TST.Perft.Row = Operator.Join(TST.Perft.Row, Ret.TestPad.PaddedText);
            TST.Perft.Row = Operator.Join(TST.Perft.Row, PerftSuiteFens[TST.Perft.PosIdx]);
            Call TestLog(TST.Perft.Row)("")("")("")("")("")("")("");
            TST.Perft.HorizonIdx += 1;
        }
        TST.Perft.PosIdx += 1;
    }
    Call TestLog("=== ")(TST.Perft.PassedCount)(" / ")(TST.Perft.SearchCount)(" successful perft runs")("")("")("");
    Call TestLog("check-detection mismatches: ")(Glob.PerftCheckMismatches)("")("")("")("")("")("");
    Glob.IsDCI = 0;
    Glob.IsTestRunning = 0;
}

Define TestSearch(string SearchFen)(string SearchThinkTime) (warp=false)
{
    _dci fen = SearchFen;
    _dci think time = SearchThinkTime;
    Call $gok_prepare;
    Call GetBestMoveDeepening;
    Ret.TestSearch.Move = Ret.GetBestMoveDeepening.Move;
}

Define TestSuite(string TestCount)(string TestThinkTime) (warp=false)
{
    If (Not ((TestCount > 0)))
    {
        Stop(this script);
    }
    Glob.IsTestRunning = 1;
    Glob.IsDCI = 1;
    Call InitTestSuite;
    TST.PassedCount = 0;
    TST.SearchCount = TestCount;
    Call TestLog("=== search, ")(TST.SearchCount)(" positions at ")(TestThinkTime)("s each")("")("")("");
    TST.Row = "";
    Call TestPad("Test#")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Return")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    TST.Row = Operator.Join(TST.Row, "FEN");
    Call TestLog(TST.Row)("")("")("")("")("")("")("");
    TST.PosIdx = 1;
    Repeat (TST.SearchCount)
    {
        Call TestSearch(TestSuiteFEN[TST.PosIdx])(TestThinkTime);
        Call GetMoveNotation(Ret.TestSearch.Move);
        TST.ReturnedNotation = Ret.GetMoveNotation.Notation;
        TST.SlotHit = 0;
        TST.SlotIdx = 1;
        Repeat (5)
        {
            If (TST.ReturnedNotation == TestSuiteAN[(((TST.PosIdx - 1) * 5) + TST.SlotIdx)])
            {
                TST.SlotHit = 1;
            }
            TST.SlotIdx += 1;
        }
        If (TST.SlotHit == 1)
        {
            TST.PassedCount += 1;
            TST.Row = "";
            Call TestPad(TST.PosIdx)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad("ok")(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteAN[(((TST.PosIdx - 1) * 5) + 1)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.ReturnedNotation)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, TestSuiteFEN[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
        }
        Else
        {
            TST.Row = "";
            Call TestPad(TST.PosIdx)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad("failed")(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteAN[(((TST.PosIdx - 1) * 5) + 1)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.ReturnedNotation)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, TestSuiteFEN[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
        }
        TST.PosIdx += 1;
    }
    Call TestLog("=== ")(TST.PassedCount)(" / ")(TST.SearchCount)(" successful tests")("")("")("");
    Glob.IsDCI = 0;
    Glob.IsTestRunning = 0;
}

Define TTProbeNode(string BoardHash)(string Ply) (warp=true)
{
    Call GetTTNodeHash(BoardHash)(Ply);
    TTPN.NodeHash = Ret.GetTTNodeHash.Hash;
    TTPN.HashBucket = ((TTPN.NodeHash % (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)) - 5)) + 1);
    TTPN.HashBucket = (((TTPN.HashBucket - 1) * Const.TTNodeEntrySize) + 1);
    TTPN.ProbeFound = 0;
    TTPN.ProbeIdx = 0;
    Repeat Until ((TTPN.ProbeFound == 1) Or (TTPN.ProbeIdx == 5))
    {
        If ((Not ((TTNodeEntry[(TTPN.HashBucket + Const.TTNodeCol.HashIdx)] == Const.Null))) And (TTNodeEntry[(TTPN.HashBucket + Const.TTNodeCol.HashIdx)] == (TTPN.NodeHash % 1073741824)))
        {
            TTPN.ProbeFound = 1;
        }
        Else
        {
            TTPN.HashBucket += Const.TTNodeEntrySize;
            TTPN.ProbeIdx += 1;
        }
    }
    If (TTPN.ProbeFound == 0)
    {
        Ret.TTProbeNode.Hit = 0;
        Ret.TTProbeNode.IsPv = 0;
        Stop(this script);
    }
    Ret.TTProbeNode.Hit = 1;
    Ret.TTProbeNode.BestMove = TTNodeEntry[(TTPN.HashBucket + Const.TTNodeCol.BestMoveIdx)];
    If (Not ((Ret.TTProbeNode.BestMove == Const.Null)))
    {
        Ret.TTProbeNode.BestMove = (Ret.TTProbeNode.BestMove / 10);
    }
    Ret.TTProbeNode.Score = TTNodeEntry[(TTPN.HashBucket + Const.TTNodeCol.ScoreIdx)];
    If (Not ((Ret.TTProbeNode.Score == Const.Null)))
    {
        TTPN.GamePly = List.Length(BoardHistoryFiftyMoves);
        If (Ret.TTProbeNode.Score > Const.AbsMinCheckmateEval)
        {
            Ret.TTProbeNode.Score = (Ret.TTProbeNode.Score - TTPN.GamePly);
        }
        If (Ret.TTProbeNode.Score < (0 - Const.AbsMinCheckmateEval))
        {
            Ret.TTProbeNode.Score = (Ret.TTProbeNode.Score + TTPN.GamePly);
        }
        TTPN.Rule50 = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
        If (abs(Ret.TTProbeNode.Score) > Const.AbsMinCheckmateEval)
        {
            If (((100000 - abs(Ret.TTProbeNode.Score)) - TTPN.GamePly) > (99 - TTPN.Rule50))
            {
                Ret.TTProbeNode.Score = ((Const.AbsMinCheckmateEval - 1) * ((Ret.TTProbeNode.Score > 0) - (Ret.TTProbeNode.Score < 0)));
            }
        }
    }
    TTPN.Meta = TTNodeEntry[(TTPN.HashBucket + Const.TTNodeCol.MetaIdx)];
    Ret.TTProbeNode.IsPv = (floor((TTPN.Meta / 8192)) % 2);
    Ret.TTProbeNode.Type = (floor((TTPN.Meta / 256)) % 8);
    If (Ret.TTProbeNode.Type == 0)
    {
        Ret.TTProbeNode.Type = Const.Null;
    }
    Ret.TTProbeNode.Horizon = ((TTPN.Meta % 256) - 8);
    If (Ret.TTProbeNode.Horizon == -8)
    {
        Ret.TTProbeNode.Horizon = Const.Null;
    }
    Ret.TTProbeNode.QSMeta = ((floor((TTPN.Meta / 2048)) % 4) - 1);
    If (Ret.TTProbeNode.QSMeta == -1)
    {
        Ret.TTProbeNode.QSMeta = Const.Null;
    }
    Ret.TTProbeNode.StaticEval = TTNodeEntry[(TTPN.HashBucket + Const.TTNodeCol.StaticEvalIdx)];
    List.ReplaceItem(TTNodeEntry, (TTPN.HashBucket + Const.TTNodeCol.MetaIdx), ((TTPN.Meta % 16384) + (16384 * (Glob.TTCurrentAge % 131072))));
}

Define TTProbeNodeAtPly(string Ply) (warp=true)
{
    List.ReplaceItem(NodeTTScore, Ply, Const.Null);
    List.ReplaceItem(NodeTTType, Ply, Const.Null);
    List.ReplaceItem(NodeTTHorizon, Ply, Const.Null);
    List.ReplaceItem(NodeTTQSMeta, Ply, Const.Null);
    List.ReplaceItem(NodeTTMove, Ply, Const.Null);
    List.ReplaceItem(NodeTTStaticEval, Ply, Const.Null);
    Call TTProbeNode(Glob.CurrentBoardHash)(Ply);
    List.ReplaceItem(NodeTTHit, Ply, Ret.TTProbeNode.Hit);
    List.ReplaceItem(IsTTPv, Ply, IsPvNode[Ply]);
    If ((Ret.TTProbeNode.Hit == 1) And (Ret.TTProbeNode.IsPv == 1))
    {
        List.ReplaceItem(IsTTPv, Ply, 1);
    }
    If (Ret.TTProbeNode.Hit == 1)
    {
        List.ReplaceItem(NodeTTScore, Ply, Ret.TTProbeNode.Score);
        List.ReplaceItem(NodeTTType, Ply, Ret.TTProbeNode.Type);
        List.ReplaceItem(NodeTTHorizon, Ply, Ret.TTProbeNode.Horizon);
        List.ReplaceItem(NodeTTQSMeta, Ply, Ret.TTProbeNode.QSMeta);
        List.ReplaceItem(NodeTTMove, Ply, Ret.TTProbeNode.BestMove);
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.TTProbeNode.StaticEval);
    }
}

Define TTStoreNode(string BoardHash)(string Ply)(string Score)(string BestMove)(string Type)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    If (Glob.IsSearchTimeout == 1)
    {
        Stop(this script);
    }
    If (1 == 0)
    {
        Stop(this script);
    }
    Call GetTTNodeHash(BoardHash)(Ply);
    TTSN.Score = Score;
    If (Not ((Score == Const.Null)))
    {
        TTSN.GamePly = List.Length(BoardHistoryFiftyMoves);
        If (Score > Const.AbsMinCheckmateEval)
        {
            TTSN.Score = (Score + TTSN.GamePly);
        }
        If (Score < (0 - Const.AbsMinCheckmateEval))
        {
            TTSN.Score = (Score - TTSN.GamePly);
        }
    }
    Call TTStoreNodeImpl(Ret.GetTTNodeHash.Hash)(Ply)(TTSN.Score)(BestMove)(Type)(Horizon)(QSMeta)(StaticEval);
}

Define TTStoreNodeImpl(string NodeHash)(string Ply)(string Score)(string BestMove)(string Type)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    TTSNI.FirstBucket = ((NodeHash % (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)) - 5)) + 1);
    TTSNI.FirstBucket = (((TTSNI.FirstBucket - 1) * Const.TTNodeEntrySize) + 1);
    TTSNI.HashBucket = TTSNI.FirstBucket;
    TTSNI.UpdateIdx = Const.Null;
    TTSNI.EmptySlot = Const.Null;
    TTSNI.EvictionSlot = Const.Null;
    Repeat (5)
    {
        TTSNI.Hash = TTNodeEntry[(TTSNI.HashBucket + Const.TTNodeCol.HashIdx)];
        If (TTSNI.Hash == Const.Null)
        {
            TTSNI.EmptySlot = TTSNI.HashBucket;
        }
        Else
        {
            If (TTSNI.Hash == (NodeHash % 1073741824))
            {
                TTSNI.UpdateIdx = TTSNI.HashBucket;
            }
            Else
            {
                TTSNI.Meta = TTNodeEntry[(TTSNI.HashBucket + Const.TTNodeCol.MetaIdx)];
                If ((TTSNI.Meta % 256) == 0)
                {
                    TTSNI.EntryValue = Const.Null;
                }
                Else
                {
                    TTSNI.EntryValue = (((TTSNI.Meta % 256) - 8) - ((Glob.TTCurrentAge - floor((TTSNI.Meta / 16384))) % 131072));
                }
                If ((TTSNI.EvictionSlot == Const.Null) Or ((Not ((TTSNI.EvictionSlotValue == Const.Null))) And ((TTSNI.EntryValue == Const.Null) Or (TTSNI.EntryValue < TTSNI.EvictionSlotValue))))
                {
                    TTSNI.EvictionSlotValue = TTSNI.EntryValue;
                    TTSNI.EvictionSlot = TTSNI.HashBucket;
                }
            }
        }
        TTSNI.HashBucket += Const.TTNodeEntrySize;
    }
    If (Not ((TTSNI.UpdateIdx == Const.Null)))
    {
        TTSNI.HashBucket = TTSNI.UpdateIdx;
    }
    Else
    {
        If (Not ((TTSNI.EmptySlot == Const.Null)))
        {
            TTSNI.HashBucket = TTSNI.EmptySlot;
        }
        Else
        {
            TTSNI.HashBucket = TTSNI.EvictionSlot;
        }
    }
    If (Not ((TTSNI.UpdateIdx == Const.Null)))
    {
        If (Not ((StaticEval == Const.Null)))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.StaticEvalIdx), StaticEval);
        }
        TTSNI.Meta = TTNodeEntry[(TTSNI.HashBucket + Const.TTNodeCol.MetaIdx)];
        TTSNI.StoredHorizon = ((TTSNI.Meta % 256) - 8);
        If (TTSNI.StoredHorizon == -8)
        {
            TTSNI.StoredHorizon = Const.Null;
        }
        TTSNI.PV = 0;
        If (IsTTPv[Ply] == 1)
        {
            TTSNI.PV = 1;
        }
        TTSNI.IsReplace = 0;
        If (Type == Const.TTType.Exact)
        {
            TTSNI.IsReplace = 1;
        }
        Else
        {
            If (TTSNI.StoredHorizon == -1)
            {
                TTSNI.IsReplace = 1;
            }
            Else
            {
                If (TTSNI.StoredHorizon == Const.Null)
                {
                    TTSNI.IsReplace = 1;
                }
                Else
                {
                    If (Not ((((Horizon + 3) + (2 * TTSNI.PV)) < TTSNI.StoredHorizon)))
                    {
                        TTSNI.IsReplace = 1;
                    }
                }
            }
        }
        If ((Not ((Score == Const.Null))) And (Not ((Horizon == Const.Null))))
        {
            If (TTSNI.IsReplace == 1)
            {
                TTSNI.HC = 0;
                If (Not ((Horizon == Const.Null)))
                {
                    TTSNI.HC = (Horizon + 8);
                }
                TTSNI.TC = 0;
                If (Not ((Type == Const.Null)))
                {
                    TTSNI.TC = Type;
                }
                TTSNI.QC = 0;
                If (Not ((QSMeta == Const.Null)))
                {
                    TTSNI.QC = (QSMeta + 1);
                }
                List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.MetaIdx), (TTSNI.HC + (256 * (TTSNI.TC + (8 * (TTSNI.QC + (4 * (TTSNI.PV + (2 * (Glob.TTCurrentAge % 131072))))))))));
                List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.ScoreIdx), Score);
            }
        }
        If (Not ((BestMove == Const.Null)))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.BestMoveIdx), Operator.Round((BestMove * 10)));
        }
    }
    Else
    {
        If (BestMove == Const.Null)
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.BestMoveIdx), BestMove);
        }
        Else
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.BestMoveIdx), Operator.Round((BestMove * 10)));
        }
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.StaticEvalIdx), StaticEval);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.HashIdx), (NodeHash % 1073741824));
        TTSNI.HC = 0;
        If (Not ((Horizon == Const.Null)))
        {
            TTSNI.HC = (Horizon + 8);
        }
        TTSNI.TC = 0;
        If (Not ((Type == Const.Null)))
        {
            TTSNI.TC = Type;
        }
        TTSNI.QC = 0;
        If (Not ((QSMeta == Const.Null)))
        {
            TTSNI.QC = (QSMeta + 1);
        }
        TTSNI.PV = 0;
        If (IsTTPv[Ply] == 1)
        {
            TTSNI.PV = 1;
        }
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.MetaIdx), (TTSNI.HC + (256 * (TTSNI.TC + (8 * (TTSNI.QC + (4 * (TTSNI.PV + (2 * (Glob.TTCurrentAge % 131072))))))))));
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + Const.TTNodeCol.ScoreIdx), Score);
    }
}

Define UndoMove (warp=false)
{
    Call EnterExecution;
    If ((Glob.IsInUndo == 0) And (List.Length(GameMovesAN) > 1))
    {
        Glob.IsInUndo = 1;
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("Stg_FromSquareSelected");
        Event.BroadcastAndWait("Stg_ToSquareSelected");
        Call UndoPrevMove;
        If (BoardHistoryWasEngineMove[List.Length(BoardHistoryWasEngineMove)] == 0)
        {
            Call UndoPrevMove;
        }
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        Glob.IsInUndo = 0;
    }
    Call ExitExecution;
}

Define UndoPrevMove (warp=false)
{
    If (List.Length(GameMovesAN) > 0)
    {
        List.DeleteItem(BoardHistory, List.Length(BoardHistory));
        List.DeleteItem(BoardHistoryHash, List.Length(BoardHistoryHash));
        List.DeleteItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState));
        List.DeleteItem(BoardHistoryWasEngineMove, List.Length(BoardHistoryWasEngineMove));
        List.DeleteItem(GameMovesAN, List.Length(GameMovesAN));
        Call ImportBoardImpl(BoardHistory[List.Length(BoardHistory)]);
        List.DeleteItem(GameMoves, List.Length(GameMoves));
        Glob.HasBlackCastled = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 1);
        Glob.HasBlackKingMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 2);
        Glob.HasBlackRookKSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 3);
        Glob.HasBlackRookQSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 4);
        Glob.HasWhiteCastled = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 5);
        Glob.HasWhiteKingMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 6);
        Glob.HasWhiteRookKSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 7);
        Glob.HasWhiteRookQSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 8);
        Call CalcBoardStats;
    }
}

Define UpdateMoveHashPosEval(string Piece)(string SourceIdx)(string TargetIdx)(bool PosScoreUpdate)(string Ply) (warp=true)
{
    Call GetPiecePosHash(Piece)(SourceIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash - Ret.GetPiecePosHash.Hash);
    If (Not ((abs(Piece) == GoK_BlackPawn)))
    {
        If (Piece > 0)
        {
            Glob.NonPawnHashBlack = (Glob.NonPawnHashBlack - Ret.GetPiecePosHash.Hash);
        }
        Else
        {
            Glob.NonPawnHashWhite = (Glob.NonPawnHashWhite - Ret.GetPiecePosHash.Hash);
        }
    }
    If ((abs(Piece) == GoK_BlackPawn) Or (abs(Piece) == GoK_BlackKing))
    {
        Glob.KPHash = (Glob.KPHash - Ret.GetPiecePosHash.Hash);
    }
    Call GetPiecePosHash(Piece)(TargetIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
    If (Not ((abs(Piece) == GoK_BlackPawn)))
    {
        If (Piece > 0)
        {
            Glob.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
        }
        Else
        {
            Glob.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
        }
    }
    If ((abs(Piece) == GoK_BlackPawn) Or (abs(Piece) == GoK_BlackKing))
    {
        Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
    }
}

Define UpdateMoveNotationPV (warp=true)
{
    Glob.PV = "";
    UMNPV.PVIdx = 2;
    Repeat (PV[1])
    {
        Glob.PV = Operator.Join(Operator.Join(Glob.PV, PV[UMNPV.PVIdx]), " ");
        UMNPV.PVIdx += 1;
    }
}

Define UpdateNNUEPostApplyMove(string Ply) (warp=true)
{
    Call NNUE_Public_OnApplyMoveDone(Ply)(AppliedMove[Ply])(SourcePieces[Ply])(TargetPieces[Ply])(PromotionPieces[Ply])(TargetPiecesIdx[Ply]);
}

Define UpdatePV(string Ply)(string BestMove) (warp=true)
{
    If (IsPvNode[Ply] == 0)
    {
        Stop(this script);
    }
    If (Glob.IsInNullMove > 0)
    {
        Stop(this script);
    }
    UPV.Idx = (((Ply - 1) * Const.MaxPlyStackFrames) + 1);
    UPV.PVSliceStart = ((Ply * Const.MaxPlyStackFrames) + 1);
    UPV.PVLength = PV[UPV.PVSliceStart];
    List.ReplaceItem(PV, UPV.Idx, (UPV.PVLength + 1));
    List.ReplaceItem(PVRaw, UPV.Idx, (UPV.PVLength + 1));
    Call GetMoveNotation(BestMove);
    List.ReplaceItem(PV, (UPV.Idx + 1), Ret.GetMoveNotation.Notation);
    List.ReplaceItem(PVRaw, (UPV.Idx + 1), BestMove);
    UPV.Idx += 2;
    UPV.PVSliceStart += 1;
    Repeat (UPV.PVLength)
    {
        List.ReplaceItem(PV, UPV.Idx, PV[UPV.PVSliceStart]);
        List.ReplaceItem(PVRaw, UPV.Idx, PVRaw[UPV.PVSliceStart]);
        UPV.Idx += 1;
        UPV.PVSliceStart += 1;
    }
    If (Ply == 1)
    {
        If ((PV[1] > 1) Or (1 == 1))
        {
            Call UpdateMoveNotationPV;
            List.DeleteAll(PVStable);
            UPV.Idx = 2;
            Repeat (PVRaw[1])
            {
                List.Add(PVStable, PVRaw[UPV.Idx]);
                UPV.Idx += 1;
            }
        }
    }
}
