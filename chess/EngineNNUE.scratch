    EvalEG.KRPPKRP.RankBase = Ret.EvaluateEndgame.Locate.RelativeRankBase;
    EvalEG.KRPPKRP.RankSign = Ret.EvaluateEndgame.Locate.RelativeRankSign;
    EvalEG.KRPPKRP.PawnIdx = Ret.EvaluateEndgame.Locate.StrongPawnIdx;
    EvalEG.KRPPKRP.SecondPawnIdx = Ret.EvaluateEndgame.Locate.SecondStrongPawnIdx;
    EvalEG.KRPPKRP.WeakPawnIdx = Ret.EvaluateEndgame.Locate.WeakPawnIdx;
    EvalEG.KRPPKRP.WeakKingIdx = Ret.EvaluateEndgame.Locate.WeakKingIdx;
    EvalEG.KRPPKRP.PawnRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.PawnIdx]));
    EvalEG.KRPPKRP.SecondPawnRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.SecondPawnIdx]));
    EvalEG.KRPPKRP.WeakPawnRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.WeakPawnIdx]));
    EvalEG.KRPPKRP.WeakPawnFile = IdxToFile[EvalEG.KRPPKRP.WeakPawnIdx];
    EvalEG.KRPPKRP.IsPawnBlocked = 0;
    If ((abs((EvalEG.KRPPKRP.WeakPawnFile - IdxToFile[EvalEG.KRPPKRP.PawnIdx])) < 2) And (EvalEG.KRPPKRP.WeakPawnRank > EvalEG.KRPPKRP.PawnRank))
    {
        EvalEG.KRPPKRP.IsPawnBlocked = 1;
    }
    EvalEG.KRPPKRP.IsSecondPawnBlocked = 0;
    If ((abs((EvalEG.KRPPKRP.WeakPawnFile - IdxToFile[EvalEG.KRPPKRP.SecondPawnIdx])) < 2) And (EvalEG.KRPPKRP.WeakPawnRank > EvalEG.KRPPKRP.SecondPawnRank))
    {
        EvalEG.KRPPKRP.IsSecondPawnBlocked = 1;
    }
    If ((EvalEG.KRPPKRP.IsPawnBlocked == 0) Or (EvalEG.KRPPKRP.IsSecondPawnBlocked == 0))
    {
        Stop(this script);
    }
    EvalEG.KRPPKRP.FrontPawnRank = EvalEG.KRPPKRP.PawnRank;
    If (EvalEG.KRPPKRP.SecondPawnRank > EvalEG.KRPPKRP.FrontPawnRank)
    {
        EvalEG.KRPPKRP.FrontPawnRank = EvalEG.KRPPKRP.SecondPawnRank;
    }
    EvalEG.KRPPKRP.WeakKingFile = IdxToFile[EvalEG.KRPPKRP.WeakKingIdx];
    EvalEG.KRPPKRP.WeakKingRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.WeakKingIdx]));
    If ((abs((EvalEG.KRPPKRP.WeakKingFile - IdxToFile[EvalEG.KRPPKRP.PawnIdx])) < 2) And (abs((EvalEG.KRPPKRP.WeakKingFile - IdxToFile[EvalEG.KRPPKRP.SecondPawnIdx])) < 2))
    {
        If (EvalEG.KRPPKRP.WeakKingRank > EvalEG.KRPPKRP.FrontPawnRank)
        {
            Ret.EvaluateEndgame.KRPPKRP.Factor = (7 * EvalEG.KRPPKRP.FrontPawnRank);
        }
    }
}

Define EvaluateEndgame.Locate(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.Locate.StrongPawnIdx = 0;
    Ret.EvaluateEndgame.Locate.SecondStrongPawnIdx = 0;
    Ret.EvaluateEndgame.Locate.StrongBishopIdx = 0;
    Ret.EvaluateEndgame.Locate.StrongRookIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakPawnIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakBishopIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakKnightIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakRookIdx = 0;
    EvalEG.Locate.SqIdx = 1;
    Repeat (64)
    {
        EvalEG.Locate.StrongViewPiece = (Board[EvalEG.Locate.SqIdx] * StrongSide);
        If (EvalEG.Locate.StrongViewPiece == GoK_BlackPawn)
        {
            If (Ret.EvaluateEndgame.Locate.StrongPawnIdx == 0)
            {
                Ret.EvaluateEndgame.Locate.StrongPawnIdx = EvalEG.Locate.SqIdx;
            }
            Else
            {
                Ret.EvaluateEndgame.Locate.SecondStrongPawnIdx = EvalEG.Locate.SqIdx;
            }
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_BlackBishop)
        {
            Ret.EvaluateEndgame.Locate.StrongBishopIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_BlackRook)
        {
            Ret.EvaluateEndgame.Locate.StrongRookIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_WhitePawn)
        {
            Ret.EvaluateEndgame.Locate.WeakPawnIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_WhiteBishop)
        {
            Ret.EvaluateEndgame.Locate.WeakBishopIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_WhiteKnight)
        {
            Ret.EvaluateEndgame.Locate.WeakKnightIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_WhiteRook)
        {
            Ret.EvaluateEndgame.Locate.WeakRookIdx = EvalEG.Locate.SqIdx;
        }
        EvalEG.Locate.SqIdx += 1;
    }
    If (StrongSide == 1)
    {
        Ret.EvaluateEndgame.Locate.StrongKingIdx = Glob.BlackKingIdx;
        Ret.EvaluateEndgame.Locate.WeakKingIdx = Glob.WhiteKingIdx;
        Ret.EvaluateEndgame.Locate.RelativeRankBase = -1;
        Ret.EvaluateEndgame.Locate.RelativeRankSign = 1;
        Ret.EvaluateEndgame.Locate.PawnPushIdxDelta = 8;
    }
    Else
    {
        Ret.EvaluateEndgame.Locate.StrongKingIdx = Glob.WhiteKingIdx;
        Ret.EvaluateEndgame.Locate.WeakKingIdx = Glob.BlackKingIdx;
        Ret.EvaluateEndgame.Locate.RelativeRankBase = 8;
        Ret.EvaluateEndgame.Locate.RelativeRankSign = -1;
        Ret.EvaluateEndgame.Locate.PawnPushIdxDelta = -8;
    }
}

Define EvaluateEndgame.Material(string StrongSide) (warp=true)
{
    If (StrongSide == 1)
    {
        EvalEG.Material.StrongQueenCount = Glob.BlackQueenCount;
        EvalEG.Material.StrongRookCount = Glob.BlackRookCount;
        EvalEG.Material.StrongMajorMinorCount = Glob.BlackNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.StrongPawnCount = Glob.BlackPawnCount;
        EvalEG.Material.WeakQueenCount = Glob.WhiteQueenCount;
        Ret.EvaluateEndgame.Material.WeakRookCount = Glob.WhiteRookCount;
        EvalEG.Material.WeakMajorMinorCount = Glob.WhiteNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.WeakPawnCount = Glob.WhitePawnCount;
    }
    Else
    {
        EvalEG.Material.StrongQueenCount = Glob.WhiteQueenCount;
        EvalEG.Material.StrongRookCount = Glob.WhiteRookCount;
        EvalEG.Material.StrongMajorMinorCount = Glob.WhiteNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.StrongPawnCount = Glob.WhitePawnCount;
        EvalEG.Material.WeakQueenCount = Glob.BlackQueenCount;
        Ret.EvaluateEndgame.Material.WeakRookCount = Glob.BlackRookCount;
        EvalEG.Material.WeakMajorMinorCount = Glob.BlackNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.WeakPawnCount = Glob.BlackPawnCount;
    }
    EvalEG.Material.StrongBishopCount = 0;
    EvalEG.Material.WeakBishopCount = 0;
    EvalEG.Material.ScanIdx = 1;
    Repeat (64)
    {
        If ((Board[EvalEG.Material.ScanIdx] * StrongSide) == GoK_BlackBishop)
        {
            EvalEG.Material.StrongBishopCount += 1;
        }
        If ((Board[EvalEG.Material.ScanIdx] * StrongSide) == GoK_WhiteBishop)
        {
            EvalEG.Material.WeakBishopCount += 1;
        }
        EvalEG.Material.ScanIdx += 1;
    }
    EvalEG.Material.StrongKnightCount = ((EvalEG.Material.StrongMajorMinorCount - EvalEG.Material.StrongRookCount) - EvalEG.Material.StrongBishopCount);
    EvalEG.Material.StrongPieceCount = (EvalEG.Material.StrongQueenCount + EvalEG.Material.StrongMajorMinorCount);
    EvalEG.Material.WeakKnightCount = ((EvalEG.Material.WeakMajorMinorCount - Ret.EvaluateEndgame.Material.WeakRookCount) - EvalEG.Material.WeakBishopCount);
    EvalEG.Material.WeakPieceCount = (EvalEG.Material.WeakQueenCount + EvalEG.Material.WeakMajorMinorCount);
    Ret.EvaluateEndgame.Material.StrongPiecesAreNone = 0;
    If (EvalEG.Material.StrongPieceCount == 0)
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreNone = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreRook = 0;
    If ((EvalEG.Material.StrongPieceCount == 1) And (EvalEG.Material.StrongRookCount == 1))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreRook = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreQueen = 0;
    If ((EvalEG.Material.StrongPieceCount == 1) And (EvalEG.Material.StrongQueenCount == 1))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreQueen = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreBishop = 0;
    If ((EvalEG.Material.StrongPieceCount == 1) And (EvalEG.Material.StrongBishopCount == 1))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreBishop = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreTwoKnights = 0;
    If ((EvalEG.Material.StrongPieceCount == 2) And (EvalEG.Material.StrongKnightCount == 2))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreTwoKnights = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreNone = 0;
    If (EvalEG.Material.WeakPieceCount == 0)
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreNone = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreRook = 0;
    If ((EvalEG.Material.WeakPieceCount == 1) And (Ret.EvaluateEndgame.Material.WeakRookCount == 1))
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreRook = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreBishop = 0;
    If ((EvalEG.Material.WeakPieceCount == 1) And (EvalEG.Material.WeakBishopCount == 1))
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreBishop = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreKnight = 0;
    If ((EvalEG.Material.WeakPieceCount == 1) And (EvalEG.Material.WeakKnightCount == 1))
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreKnight = 1;
    }
}

Define EvaluateEndgame.PawnScan(string StrongSide)(string WeakKingIdx)(string WeakRookIdx) (warp=true)
{
    Ret.EvaluateEndgame.PawnScan.StrongPawnCount = 0;
    Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileACount = 0;
    Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileHCount = 0;
    Ret.EvaluateEndgame.PawnScan.PawnCount = 0;
    Ret.EvaluateEndgame.PawnScan.PawnOnFileBCount = 0;
    Ret.EvaluateEndgame.PawnScan.PawnOnFileGCount = 0;
    Ret.EvaluateEndgame.PawnScan.StrongPawnInKingSpanCount = 0;
    Ret.EvaluateEndgame.PawnScan.HasRookFortressPawn = 0;
    Ret.EvaluateEndgame.PawnScan.WeakFrontPawnIdx = 0;
    EvalEG.PawnScan.RelativeRankBase = -1;
    EvalEG.PawnScan.RelativeRankSign = 1;
    If (StrongSide < 0)
    {
        EvalEG.PawnScan.RelativeRankBase = 8;
        EvalEG.PawnScan.RelativeRankSign = -1;
    }
    EvalEG.PawnScan.WeakKingRelativeRank = (EvalEG.PawnScan.RelativeRankBase + (EvalEG.PawnScan.RelativeRankSign * IdxToRank[WeakKingIdx]));
    EvalEG.PawnScan.WeakFrontPawnRelativeRank = -1;
    EvalEG.PawnScan.ListIdx = 1;
    Repeat (64)
    {
        EvalEG.PawnScan.SqIdx = EvalEG.PawnScan.ListIdx;
        If (abs(Board[EvalEG.PawnScan.SqIdx]) == GoK_BlackPawn)
        {
            EvalEG.PawnScan.File = IdxToFile[EvalEG.PawnScan.SqIdx];
            EvalEG.PawnScan.RelativeRank = (EvalEG.PawnScan.RelativeRankBase + (EvalEG.PawnScan.RelativeRankSign * IdxToRank[EvalEG.PawnScan.SqIdx]));
            Ret.EvaluateEndgame.PawnScan.PawnCount += 1;
            If (EvalEG.PawnScan.File == 2)
            {
                Ret.EvaluateEndgame.PawnScan.PawnOnFileBCount += 1;
            }
            If (EvalEG.PawnScan.File == 7)
            {
                Ret.EvaluateEndgame.PawnScan.PawnOnFileGCount += 1;
            }
            If ((Board[EvalEG.PawnScan.SqIdx] * StrongSide) > 0)
            {
                Ret.EvaluateEndgame.PawnScan.StrongPawnCount += 1;
                If (EvalEG.PawnScan.File == 1)
                {
                    Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileACount += 1;
                }
                If (EvalEG.PawnScan.File == 8)
                {
                    Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileHCount += 1;
                }
                EvalEG.PawnScan.KingFileDeltaAbs = abs((EvalEG.PawnScan.File - IdxToFile[WeakKingIdx]));
                If ((EvalEG.PawnScan.KingFileDeltaAbs < 2) And (EvalEG.PawnScan.RelativeRank < EvalEG.PawnScan.WeakKingRelativeRank))
                {
                    Ret.EvaluateEndgame.PawnScan.StrongPawnInKingSpanCount += 1;
                }
            }
            Else
            {
                If (EvalEG.PawnScan.RelativeRank > EvalEG.PawnScan.WeakFrontPawnRelativeRank)
                {
                    Ret.EvaluateEndgame.PawnScan.WeakFrontPawnIdx = EvalEG.PawnScan.SqIdx;
                    EvalEG.PawnScan.WeakFrontPawnRelativeRank = EvalEG.PawnScan.RelativeRank;
                }
                If (WeakRookIdx > 0)
                {
                    EvalEG.PawnScan.IsNextToWeakKing = 0;
                    If (ChebyshevDistance[((EvalEG.PawnScan.SqIdx * 100) + WeakKingIdx)] == 1)
                    {
                        EvalEG.PawnScan.IsNextToWeakKing = 1;
                    }
                    EvalEG.PawnScan.RookRelativeRank = (EvalEG.PawnScan.RelativeRankBase + (EvalEG.PawnScan.RelativeRankSign * IdxToRank[WeakRookIdx]));
                    EvalEG.PawnScan.RookFileDeltaAbs = abs((EvalEG.PawnScan.File - IdxToFile[WeakRookIdx]));
                    If (((EvalEG.PawnScan.IsNextToWeakKing == 1) And (EvalEG.PawnScan.RelativeRank == (EvalEG.PawnScan.RookRelativeRank + 1))) And (EvalEG.PawnScan.RookFileDeltaAbs == 1))
                    {
                        Ret.EvaluateEndgame.PawnScan.HasRookFortressPawn = 1;
                    }
                }
            }
        }
        EvalEG.PawnScan.ListIdx += 1;
    }
}

Define EvaluateEndgame.PushToEdge(string SqIdx) (warp=true)
{
    EvalEG.PushToEdge.FileEdgeDistance = (IdxToFile[SqIdx] - 1);
    If (EvalEG.PushToEdge.FileEdgeDistance > 3)
    {
        EvalEG.PushToEdge.FileEdgeDistance = (7 - EvalEG.PushToEdge.FileEdgeDistance);
    }
    EvalEG.PushToEdge.RankEdgeDistance = (IdxToRank[SqIdx] - 1);
    If (EvalEG.PushToEdge.RankEdgeDistance > 3)
    {
        EvalEG.PushToEdge.RankEdgeDistance = (7 - EvalEG.PushToEdge.RankEdgeDistance);
    }
    EvalEG.PushToEdge.FilePenalty = floor(((7 * (EvalEG.PushToEdge.FileEdgeDistance * EvalEG.PushToEdge.FileEdgeDistance)) / 2));
    EvalEG.PushToEdge.RankPenalty = floor(((7 * (EvalEG.PushToEdge.RankEdgeDistance * EvalEG.PushToEdge.RankEdgeDistance)) / 2));
    Ret.EvaluateEndgame.PushToEdge.Score = (90 - (EvalEG.PushToEdge.FilePenalty + EvalEG.PushToEdge.RankPenalty));
}

Define EvaluateEndgame.Scale(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.Scale.Factor = Const.Null;
    Call EvaluateEndgame.Material((0 - StrongSide));
    EvalEG.Scale.IsOtherSideExactEndgame = 0;
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvaluateEndgame.Material.StrongPawnCount == 1))
    {
        If ((Ret.EvaluateEndgame.Material.WeakPawnCount == 0) And ((Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1) Or (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEG.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreBishop == 1) And (Ret.EvaluateEndgame.Material.WeakPawnCount == 0))
    {
        If (((Ret.EvaluateEndgame.Material.StrongPawnCount == 1) And ((Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1) Or (Ret.EvaluateEndgame.Material.WeakPiecesAreKnight == 1))) Or ((Ret.EvaluateEndgame.Material.StrongPawnCount == 2) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEG.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If (((Ret.EvaluateEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvaluateEndgame.Material.StrongPawnCount == 2)) And ((Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1) And (Ret.EvaluateEndgame.Material.WeakPawnCount == 1)))
    {
        EvalEG.Scale.IsOtherSideExactEndgame = 1;
    }
    If (EvalEG.Scale.IsOtherSideExactEndgame == 1)
    {
        Stop(this script);
    }
    Call EvaluateEndgame.Material(StrongSide);
    EvalEG.Scale.StrongPawnCount = Ret.EvaluateEndgame.Material.StrongPawnCount;
    EvalEG.Scale.WeakPawnCount = Ret.EvaluateEndgame.Material.WeakPawnCount;
    If (Ret.EvaluateEndgame.Material.StrongPiecesAreRook == 1)
    {
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvaluateEndgame.KRPKR(Ply)(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KRPKR.Factor;
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvaluateEndgame.KRPKB(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KRPKB.Factor;
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 2) And (EvalEG.Scale.WeakPawnCount == 1)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvaluateEndgame.KRPPKRP(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KRPPKRP.Factor;
            Stop(this script);
        }
    }
    If (Ret.EvaluateEndgame.Material.StrongPiecesAreBishop == 1)
    {
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvaluateEndgame.KBPKB(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KBPKB.Factor;
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreKnight == 1))
        {
            Call EvaluateEndgame.KBPKN(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KBPKN.Factor;
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 2) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvaluateEndgame.KBPPKB(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KBPPKB.Factor;
            Stop(this script);
        }
        If (EvalEG.Scale.StrongPawnCount > 0)
        {
            Call EvaluateEndgame.KBPsK(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KBPsK.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreQueen == 1) And (EvalEG.Scale.StrongPawnCount == 0))
    {
        If ((Ret.EvaluateEndgame.Material.WeakRookCount == 1) And (EvalEG.Scale.WeakPawnCount > 0))
        {
            Call EvaluateEndgame.KQKRPs(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KQKRPs.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreNone == 1) And (Ret.EvaluateEndgame.Material.WeakPiecesAreNone == 1))
    {
        If ((EvalEG.Scale.StrongPawnCount > 1) And (EvalEG.Scale.WeakPawnCount == 0))
        {
            Call EvaluateEndgame.KPsK(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KPsK.Factor;
        }
        If ((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 1))
        {
            Call EvaluateEndgame.KPK(Ply)(StrongSide);
            If (Not (((EvalEG.KPK.PawnRank > 3) And (EvalEG.KPK.PawnFile > 0))))
            {
                If (Ret.EvaluateEndgame.KPK.IsWin == 0)
                {
                    Ret.EvaluateEndgame.Scale.Factor = 0;
                }
            }
        }
    }
}

Define EvaluateEndgame.StrongToMove(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.StrongToMove.IsStrongToMove = PlyIsOwn[(Ply + 1)];
    If (StrongSide < 0)
    {
        Ret.EvaluateEndgame.StrongToMove.IsStrongToMove = (1 - Ret.EvaluateEndgame.StrongToMove.IsStrongToMove);
    }
}

Define EvaluatePostProcess(string Ply)(string Score) (warp=true)
{
    Ret.EvaluatePostProcess.Score = Score;
    Call //("Early promotion detection via Rule-of-Squares / Chebyshev distance");
    If (((Glob.WhiteQueenCount + Glob.WhiteNonQueenMajorMinorCount) == 0) And ((Glob.BlackQueenCount + Glob.BlackNonQueenMajorMinorCount) == 0))
    {
        List.DeleteItem(PawnCount, all);
        Repeat (8)
        {
            List.Add(PawnCount, 0);
        }
        Repeat (8)
        {
            List.Add(PawnCount, 0);
        }
        List.DeleteItem(PawnAdvancePerFile, all);
        Repeat (32)
        {
            List.Add(PawnAdvancePerFile, 0);
        }
        Eval.PP.Idx = 1;
        Repeat (64)
        {
            Eval.PP.SourcePiece = (Board[Eval.PP.Idx] + 0);
            If (Eval.PP.SourcePiece == GoK_BlackPawn)
            {
                Eval.PP.File = (IdxToFile[Eval.PP.Idx] + 0);
                Eval.PP.Rank = (IdxToRank[Eval.PP.Idx] + 0);
                List.ReplaceItem(PawnCount, (Eval.PP.File + 8), (PawnCount[(Eval.PP.File + 8)] + 1));
                If ((PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.BlackRear)] == 0) Or (Eval.PP.Rank < PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.BlackRear)]))
                {
                    List.ReplaceItem(PawnAdvancePerFile, (Eval.PP.File + Const.PawnAdvance.BlackRear), Eval.PP.Rank);
                }
                If (Eval.PP.Rank > PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.BlackFront)])
                {
                    List.ReplaceItem(PawnAdvancePerFile, (Eval.PP.File + Const.PawnAdvance.BlackFront), Eval.PP.Rank);
                }
            }
            If (Eval.PP.SourcePiece == GoK_WhitePawn)
            {
                Eval.PP.File = (IdxToFile[Eval.PP.Idx] + 0);
                Eval.PP.Rank = (IdxToRank[Eval.PP.Idx] + 0);
                List.ReplaceItem(PawnCount, Eval.PP.File, (PawnCount[Eval.PP.File] + 1));
                If (Eval.PP.Rank > PawnAdvancePerFile[Eval.PP.File])
                {
                    List.ReplaceItem(PawnAdvancePerFile, Eval.PP.File, Eval.PP.Rank);
                }
                If ((PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.WhiteFront)] == 0) Or (Eval.PP.Rank < PawnAdvancePerFile[(Eval.PP.File + Const.PawnAdvance.WhiteFront)]))
                {
                    List.ReplaceItem(PawnAdvancePerFile, (Eval.PP.File + Const.PawnAdvance.WhiteFront), Eval.PP.Rank);
                }
            }
            Eval.PP.Idx += 1;
        }
        Eval.PP.WhiteQueener = 99;
        Eval.PP.BlackQueener = 99;
        Eval.PP.BlackFastest = 99;
        Eval.PP.WhiteFastest = 99;
        Eval.PP.Side = 1;
        Repeat (2)
        {
            If (Eval.PP.Side == 1)
            {
                Eval.PP.OurOffset = Const.PawnAdvance.BlackFront;
                Eval.PP.TheirOffset = Const.PawnAdvance.WhiteRear;
                Eval.PP.PromoBase = 56;
                Eval.PP.KingIdx = Glob.BlackKingIdx;
                Eval.PP.TheirKingIdx = Glob.WhiteKingIdx;
            }
            Else
            {
                Eval.PP.OurOffset = Const.PawnAdvance.WhiteFront;
                Eval.PP.TheirOffset = Const.PawnAdvance.BlackRear;
                Eval.PP.PromoBase = 0;
                Eval.PP.KingIdx = Glob.WhiteKingIdx;
                Eval.PP.TheirKingIdx = Glob.BlackKingIdx;
            }
            Eval.PP.Idx = 1;
            Repeat (8)
            {
                Eval.PP.OurForwardRank = PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.OurOffset)];
                If (Not ((Eval.PP.OurForwardRank == 0)))
                {
                    Eval.PP.NFwd = ((Not ((Eval.PP.OurForwardRank == 0))) * (Eval.PP.OurForwardRank + ((Eval.PP.Side == 2) * (9 - (2 * Eval.PP.OurForwardRank)))));
                    If (Eval.PP.NFwd > 1)
                    {
                        Eval.PP.NBack = ((Not ((PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.TheirOffset)] == 0))) * (PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.TheirOffset)] + ((Eval.PP.Side == 2) * (9 - (2 * PawnAdvancePerFile[(Eval.PP.Idx + Eval.PP.TheirOffset)])))));
                        If (Eval.PP.NFwd > Eval.PP.NBack)
                        {
                            Eval.PP.NAdj = ((Not ((PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) - 1)] == 0))) * (PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) - 1)] + ((Eval.PP.Side == 2) * (9 - (2 * PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) - 1)])))));
                            If ((Eval.PP.Idx == 1) Or (Not ((Eval.PP.NFwd < Eval.PP.NAdj))))
                            {
                                Eval.PP.NAdj = ((Not ((PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) + 1)] == 0))) * (PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) + 1)] + ((Eval.PP.Side == 2) * (9 - (2 * PawnAdvancePerFile[((Eval.PP.Idx + Eval.PP.TheirOffset) + 1)])))));
                                If ((Eval.PP.Idx == 8) Or (Not ((Eval.PP.NFwd < Eval.PP.NAdj))))
                                {
                                    Eval.PP.TargetIdx = (Eval.PP.PromoBase + Eval.PP.Idx);
                                    Eval.PP.Delta = (8 - Eval.PP.NFwd);
                                    If (Eval.PP.Delta > 5)
                                    {
                                        Eval.PP.Delta = 5;
                                    }
                                    If (Eval.PP.Side == 1)
                                    {
                                        If (Eval.PP.Delta < Eval.PP.BlackFastest)
                                        {
                                            Eval.PP.BlackFastest = Eval.PP.Delta;
                                        }
                                    }
                                    Else
                                    {
                                        If (Eval.PP.Delta < Eval.PP.WhiteFastest)
                                        {
                                            Eval.PP.WhiteFastest = Eval.PP.Delta;
                                        }
                                    }
                                    If ((ChebyshevDistance[((Eval.PP.TheirKingIdx * 100) + Eval.PP.TargetIdx)] - (((Ply + Eval.PP.Side) + 1) % 2)) > Eval.PP.Delta)
                                    {
                                        Eval.PP.QueeningDelta = Eval.PP.Delta;
                                        If ((IdxToFile[Eval.PP.KingIdx] == Eval.PP.Idx) And (((Not ((IdxToRank[Eval.PP.KingIdx] == 0))) * (IdxToRank[Eval.PP.KingIdx] + ((Eval.PP.Side == 2) * (9 - (2 * IdxToRank[Eval.PP.KingIdx]))))) > Eval.PP.NFwd))
                                        {
                                            If ((Eval.PP.Idx == 1) Or (Eval.PP.Idx == 8))
                                            {
                                                Eval.PP.QueeningDelta = 99;
                                            }
                                            Else
                                            {
                                                Eval.PP.QueeningDelta += 1;
                                            }
                                        }
                                        If (Eval.PP.Side == 1)
                                        {
                                            If (Eval.PP.QueeningDelta < Eval.PP.BlackQueener)
                                            {
                                                Eval.PP.BlackQueener = Eval.PP.QueeningDelta;
                                            }
                                        }
                                        Else
                                        {
                                            If (Eval.PP.QueeningDelta < Eval.PP.WhiteQueener)
                                            {
                                                Eval.PP.WhiteQueener = Eval.PP.QueeningDelta;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Eval.PP.Idx += 1;
            }
            Eval.PP.Side += 1;
        }
        If ((Eval.PP.WhiteQueener < Eval.PP.BlackQueener) And (((2 * Eval.PP.BlackFastest) + ((Ply + 2) % 2)) > (((2 * Eval.PP.WhiteQueener) + ((Ply + 3) % 2)) + 1)))
        {
            Ret.EvaluatePostProcess.Score += ((GoK_WhiteQueen - GoK_WhitePawn) + 100);
        }
        Else
        {
            If ((Eval.PP.BlackQueener < Eval.PP.WhiteQueener) And (((2 * Eval.PP.WhiteFastest) + ((Ply + 3) % 2)) > (((2 * Eval.PP.BlackQueener) + ((Ply + 2) % 2)) + 1)))
            {
                Ret.EvaluatePostProcess.Score += ((GoK_BlackQueen - GoK_BlackPawn) - 100);
            }
        }
    }
}

Define ExecuteEngineMove (warp=false)
{
    Call EnterExecution;
    Call ExecuteEngineMoveImpl;
    Call ExitExecution;
}

Define ExecuteEngineMoveImpl (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Glob.PlayerClockRunning = 0;
    Event.Broadcast("UI_OpeningBookHide");
    EEMI.Move = Const.Null;
    If ((Glob.Level > 1) And (1 == 1))
    {
        Call GetOpeningMoves;
        If (List.Length(OpeningMovesRes) > 0)
        {
            Event.Broadcast("UI_OpeningBookShow");
            EEMI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
            If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
            {
                Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockTimeInc);
                Glob.ClockMoveCount += 1;
                If ((Glob.ClockStageMoves > 0) And (Glob.ClockMoveCount == Glob.ClockStageMoves))
                {
                    Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockStageTime);
                }
            }
        }
    }
    Call IsEngineValidMove(EEMI.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Control.Wait(0);
        Call GetBestMove;
        EEMI.Move = Ret.GetBestMove.Move;
    }
    Call OnProgressChanged(100);
    Control.Wait(0);
    Call IsEngineValidMove(EEMI.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Looks.Say(Operator.Join("Internal Error: No valid move found. Sorry, this should not happen. Maybe you cleared lookup lists in the editor? If you are running a normal game, please export board data and report bug via project comment", Operator.Join(" Move: ", EEMI.Move)), 10);
        GoK_IsGameSuspended = 1;
        Stop(this script);
    }
    Looks.Think("");
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((EEMI.Move / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((EEMI.Move % 100))];
    If (((EEMI.Move == GoK_BlackQueensideCastling) Or (EEMI.Move == GoK_BlackKingsideCastling)) Or ((EEMI.Move == GoK_WhiteQueensideCastling) Or (EEMI.Move == GoK_WhiteKingsideCastling)))
    {
        Pieces_MovePieceSpecial = EEMI.Move;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    If (EEMI.Move == GoK_BlackKingsideCastling)
    {
        Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
        Stg_BestMoveToIdx = GoK_ScreenIdx[7];
    }
    Else
    {
        If (EEMI.Move == GoK_BlackQueensideCastling)
        {
            Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
            Stg_BestMoveToIdx = GoK_ScreenIdx[3];
        }
        Else
        {
            Stg_BestMoveFromIdx = Pieces_MovePieceFromIdx;
            Stg_BestMoveToIdx = Pieces_MovePieceToIdx;
        }
    }
    Event.BroadcastAndWait("UI_ShowBestMove");
    Event.BroadcastAndWait("Pieces_MovePiece");
    Event.BroadcastAndWait("UI_HideBestMove");
    Event.Broadcast("SoundMove");
    List.Add(GameMoves, floor(EEMI.Move));
    Call GetMoveNotation(EEMI.Move);
    List.Add(GameMovesAN, Ret.GetMoveNotation.Notation);
    Call ClearMoveList(1);
    Call AddMoveToList(EEMI.Move)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1)((1 == 1));
    Call DrawBoardAndWait;
    If (Not ((floor((EEMI.Move / 100)) == 0)))
    {
        If (Board[(EEMI.Move % 100)] == GoK_BlackKing)
        {
            Glob.HasBlackKingMoved = 1;
        }
        If (Board[(EEMI.Move % 100)] == GoK_BlackRook)
        {
            If (floor((EEMI.Move / 100)) == 1)
            {
                Glob.HasBlackRookQSMoved = 1;
            }
            If (floor((EEMI.Move / 100)) == 8)
            {
                Glob.HasBlackRookKSMoved = 1;
            }
        }
    }
    If ((EEMI.Move == GoK_BlackQueensideCastling) Or (EEMI.Move == GoK_BlackKingsideCastling))
    {
        Glob.HasBlackKingMoved = 1;
        Glob.HasBlackCastled = 1;
    }
    Call AddBoardToHistory(1);
    Call GetRepetitionCount;
    If (Ret.GetRepetitionCount.Count > 2)
    {
        Looks.Say("Draw!");
        Event.Broadcast("SoundDraw");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByMaterial;
        If (Ret.IsDrawByMaterial.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call IsWhiteKingCheckMate;
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Looks.Say("Checkmate!");
                Event.Broadcast("SoundCheckmate");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(2);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call CalcBoardAttackedByMove(1);
                    If (Glob.IsWhiteChecked == 1)
                    {
                        Call SayAsync("Check!")(2);
                        Event.Broadcast("SoundCheck");
                    }
                }
            }
        }
    }
    Glob.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
    Glob.PlayerClockRunning = 1;
}

Define ExecuteInit (warp=false)
{
    Glob.ExecutionPly = 0;
    Glob.IsExecutionRunning = 0;
    If (Glob.IsPlayerBlack == 1)
    {
        Call ExecuteEngineMove;
    }
}

Define ExecuteUserMove(string UserMove) (warp=false)
{
    Call EnterExecution;
    Call ExecuteUserMoveImpl(UserMove);
    Call ExitExecution;
}

Define ExecuteUserMoveImpl(string UserMoveParam) (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    If (((Glob.TimeControl == 1) And ((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0))) And (Glob.CustomMaxDepth == 0))
    {
        Glob.PlayerClockTime = (Glob.PlayerClockTime + (Glob.ClockTimeInc - ((Sensing.DaysSince2000() * 86400) - Glob.PlayerMoveStart)));
        Glob.PlayerClockMoveCount += 1;
        If ((Glob.ClockStageMoves > 0) And (Glob.PlayerClockMoveCount == Glob.ClockStageMoves))
        {
            Glob.PlayerClockTime += Glob.ClockStageTime;
        }
        Glob.PlayerClockRunning = 0;
        Call PublishTimers(0);
    }
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((UserMoveParam / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((UserMoveParam % 100))];
    If (((UserMoveParam == GoK_BlackQueensideCastling) Or (UserMoveParam == GoK_BlackKingsideCastling)) Or ((UserMoveParam == GoK_WhiteQueensideCastling) Or (UserMoveParam == GoK_WhiteKingsideCastling)))
    {
        Pieces_MovePieceSpecial = UserMoveParam;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.Broadcast("SoundMove");
    Stg_FromSquareIdx = -1;
    Stg_ToSquareIdx = -1;
    Event.BroadcastAndWait("Stg_FromSquareSelected");
    Event.BroadcastAndWait("Stg_ToSquareSelected");
    Event.BroadcastAndWait("UI_HideBestMove");
    Call GenerateMovesPublic(2);
    If (Not (List.ContainsItem(Moves2, UserMoveParam)))
    {
        Call SayAsync("Invalid move!")(2);
        Event.Broadcast("SoundInvalidMove");
        Call DrawBoardAndWait;
        Stop(this script);
    }
    Glob.UserMove = UserMoveParam;
    If (Operator.LetterOf(Glob.UserMove, (Variable.Length(Glob.UserMove) - 1)) == ".")
    {
        Looks.Say("Please select promotion piece");
        Event.BroadcastAndWait("Pieces_SelectPromotionPiece");
        Looks.Say("");
        If (Pieces_SelectedPromotionPiece == GoK_WhiteQueen)
        {
            Glob.UserMove = (floor(Glob.UserMove) + 0.1);
        }
        Else
        {
            If (Pieces_SelectedPromotionPiece == GoK_WhiteRook)
            {
                Glob.UserMove = (floor(Glob.UserMove) + 0.2);
            }
            Else
            {
                If (Pieces_SelectedPromotionPiece == GoK_WhiteBishop)
                {
                    Glob.UserMove = (floor(Glob.UserMove) + 0.3);
                }
                Else
                {
                    If (Pieces_SelectedPromotionPiece == GoK_WhiteKnight)
                    {
                        Glob.UserMove = (floor(Glob.UserMove) + 0.4);
                    }
                }
            }
        }
    }
    Call GetMoveNotation(Glob.UserMove);
    EUMI.Notation = Ret.GetMoveNotation.Notation;
    Call ClearMoveList(2);
    Call AddMoveToList(Glob.UserMove)(2)(0);
    List.ReplaceItem(MovesIdx, 2, 1);
    Call ApplyMove(2)((1 == 1));
    Call CalcBoardAttackedByMove(1);
    If (Glob.IsWhiteChecked == 1)
    {
        Call RevertMove(2);
        Call DrawBoardAndWait;
        Control.Wait(0);
        Call SayAsync("Invalid move - Check!")(2);
        Event.Broadcast("SoundInvalidMoveCheck");
        Stop(this script);
    }
    List.Add(GameMovesAN, EUMI.Notation);
    List.Add(GameMoves, floor(Glob.UserMove));
    Call DrawBoardAndWait;
    Control.Wait(0);
    EUMI.SourceIdx = floor((Glob.UserMove / 100));
    EUMI.TargetIdx = floor((Glob.UserMove % 100));
    If (Board[EUMI.TargetIdx] == GoK_WhiteKing)
    {
        Glob.HasWhiteKingMoved = 1;
    }
    If (Board[EUMI.TargetIdx] == GoK_WhiteRook)
    {
        If (EUMI.SourceIdx == 57)
        {
            Glob.HasWhiteRookQSMoved = 1;
        }
        If (EUMI.SourceIdx == 64)
        {
            Glob.HasWhiteRookKSMoved = 1;
        }
    }
    If ((Glob.UserMove == GoK_WhiteQueensideCastling) Or (Glob.UserMove == GoK_WhiteKingsideCastling))
    {
        Glob.HasWhiteCastled = 1;
        Glob.HasWhiteKingMoved = 1;
    }
    Call AddBoardToHistory(0);
    Call IsBlackKingCheckMate;
    If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
    {
        Looks.Say("Checkmate!");
        Event.Broadcast("SoundCheckmate");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByStalemate(1);
        If (Ret.IsDrawByStalemate.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call GetRepetitionCount;
            If (Ret.GetRepetitionCount.Count > 2)
            {
                Looks.Say("Draw!");
                Event.Broadcast("SoundDraw");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByMaterial;
                If (Ret.IsDrawByMaterial.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
    }
}

Define ExitExecution (warp=false)
{
    Glob.ExecutionPly += -1;
    If (Glob.ExecutionPly == 0)
    {
        Glob.IsExecutionRunning = 0;
        Event.BroadcastAndWait("GoK_ModeInput");
        If ((Glob.PlayerClockRunning == 0) And (GoK_IsGameSuspended == 0))
        {
            Glob.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
            Glob.PlayerClockRunning = 1;
        }
        Call PublishTimers(0);
    }
}

Define ExportBoardFEN(string Ply) (warp=true)
{
    EBFEN.IsPlayerTurn = ((Ply % 2) == 0);
    EBFEN.StateIdx = Ply;
    If (Ply < 1)
    {
        EBFEN.StateIdx = 1;
    }
    Call StoreExternalBoard;
    EBFEN.SqIdx = 1;
    Ret.ExportBoardFEN.FEN = "";
    Ret.ExportBoardFEN.FENLichess = "https://lichess.org/analysis/";
    Repeat Until (EBFEN.SqIdx > 64)
    {
        EBFEN.Piece = GoK_Board[EBFEN.SqIdx];
        If (EBFEN.Piece == GoK_BlackPawn)
        {
            EBFEN.PieceChar = "p";
        }
        If (EBFEN.Piece == GoK_BlackKnight)
        {
            EBFEN.PieceChar = "n";
        }
        If (EBFEN.Piece == GoK_BlackBishop)
        {
            EBFEN.PieceChar = "b";
        }
        If (EBFEN.Piece == GoK_BlackRook)
        {
            EBFEN.PieceChar = "r";
        }
        If (EBFEN.Piece == GoK_BlackQueen)
        {
            EBFEN.PieceChar = "q";
        }
        If (EBFEN.Piece == GoK_BlackKing)
        {
            EBFEN.PieceChar = "k";
        }
        If (EBFEN.Piece == GoK_WhitePawn)
        {
            EBFEN.PieceChar = "P";
        }
        If (EBFEN.Piece == GoK_WhiteKnight)
        {
            EBFEN.PieceChar = "N";
        }
        If (EBFEN.Piece == GoK_WhiteBishop)
        {
            EBFEN.PieceChar = "B";
        }
        If (EBFEN.Piece == GoK_WhiteRook)
        {
            EBFEN.PieceChar = "R";
        }
        If (EBFEN.Piece == GoK_WhiteQueen)
        {
            EBFEN.PieceChar = "Q";
        }
        If (EBFEN.Piece == GoK_WhiteKing)
        {
            EBFEN.PieceChar = "K";
        }
        If (EBFEN.Piece == 0)
        {
            EBFEN.ScanSqIdx = EBFEN.SqIdx;
            Repeat Until (((EBFEN.ScanSqIdx % 8) == 0) Or (Not ((GoK_Board[(EBFEN.ScanSqIdx + 1)] == 0))))
            {
                EBFEN.ScanSqIdx += 1;
            }
            EBFEN.PieceChar = ((EBFEN.ScanSqIdx - EBFEN.SqIdx) + 1);
            EBFEN.SqIdx += (EBFEN.ScanSqIdx - EBFEN.SqIdx);
        }
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, EBFEN.PieceChar);
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, EBFEN.PieceChar);
        If (((EBFEN.SqIdx % 8) == 0) And (EBFEN.SqIdx < 64))
        {
            Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, "/");
            Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "/");
        }
        EBFEN.SqIdx += 1;
    }
    If (((Glob.IsPlayerBlack == 1) And (EBFEN.IsPlayerTurn == 1)) Or ((Not ((Glob.IsPlayerBlack == 1))) And (Not ((EBFEN.IsPlayerTurn == 1)))))
    {
        Call EBFEN.AppendField("b");
        EBFEN.BlackToMove = 1;
    }
    Else
    {
        Call EBFEN.AppendField("w");
        EBFEN.BlackToMove = 0;
    }
    Ret.ExportBoardFEN.IsWhite = (1 - EBFEN.BlackToMove);
    EBFEN.CS = CastlingState[EBFEN.StateIdx];
    If (EBFEN.CS == Const.Null)
    {
        EBFEN.CS = Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved)));
    }
    EBFEN.WhiteOff = 4;
    EBFEN.BlackOff = 0;
    If (Glob.IsPlayerBlack == 1)
    {
        EBFEN.WhiteOff = 0;
        EBFEN.BlackOff = 4;
    }
    EBFEN.Castling = "";
    Call EBFEN.AddCastling(EBFEN.CS)(EBFEN.WhiteOff)(61)(GoK_WhiteKing)(GoK_WhiteRook)(64)(57)("K")("Q");
    EBFEN.Castling = Operator.Join(EBFEN.Castling, Ret.EBFEN.AddCastling.Text);
    Call EBFEN.AddCastling(EBFEN.CS)(EBFEN.BlackOff)(5)(GoK_BlackKing)(GoK_BlackRook)(8)(1)("k")("q");
    EBFEN.Castling = Operator.Join(EBFEN.Castling, Ret.EBFEN.AddCastling.Text);
    If (Variable.Length(EBFEN.Castling) == 0)
    {
        EBFEN.Castling = "-";
    }
    Call EBFEN.AppendField(EBFEN.Castling);
    EBFEN.EPText = "-";
    EBFEN.EPSq = 0;
    EBFEN.EPX = 0;
    EBFEN.EP = EnPassantTarget[EBFEN.StateIdx];
    If ((Not ((EBFEN.EP == Const.Null))) And (EBFEN.EP > 0))
    {
        EBFEN.EPX = EBFEN.EP;
        If (Glob.IsPlayerBlack == 1)
        {
            EBFEN.EPX = RankFlipIdx[EBFEN.EP];
        }
        If ((EBFEN.EPX > 32) And (EBFEN.EPX < 41))
        {
            If (EBFEN.BlackToMove == 1)
            {
                EBFEN.EPSq = (EBFEN.EPX + 8);
            }
        }
        If ((EBFEN.EPX > 24) And (EBFEN.EPX < 33))
        {
            If (EBFEN.BlackToMove == 0)
            {
                EBFEN.EPSq = (EBFEN.EPX - 8);
            }
        }
    }
    If (EBFEN.EPSq > 0)
    {
        EBFEN.EPText = Operator.Join(Operator.LetterOf("abcdefgh", (((EBFEN.EPSq - 1) % 8) + 1)), (9 - ceiling((EBFEN.EPSq / 8))));
    }
    Call EBFEN.AppendField(EBFEN.EPText);
    EBFEN.Halfmove = 0;
    If (List.Length(BoardHistoryFiftyMoves) > 0)
    {
        EBFEN.Halfmove = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
    }
    Call EBFEN.AppendField(EBFEN.Halfmove);
    EBFEN.F0 = (Glob.FenFullMove + floor((((List.Length(GameMovesAN) - Glob.FenPlyBase) + Glob.FenBlackToMove) / 2)));
    EBFEN.Fullmove = EBFEN.F0;
    If (Ply > 1)
    {
        EBFEN.R = 0;
        If (Not ((Glob.IsPlayerBlack == 1)))
        {
            EBFEN.R = 1;
        }
        EBFEN.Fullmove = (EBFEN.F0 + floor((((Ply - 1) + EBFEN.R) / 2)));
    }
    Call EBFEN.AppendField(EBFEN.Fullmove);
}

Define ExportMovesPGN (warp=true)
{
    EMPGN.GameMovesANIdx = 1;
    Ret.ExportMovesPGN.PGN = "";
    Repeat (List.Length(GameMovesAN))
    {
        If ((EMPGN.GameMovesANIdx % 2) == 1)
        {
            Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join((((EMPGN.GameMovesANIdx - 1) / 2) + 1), ". "));
        }
        Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join(GameMovesAN[EMPGN.GameMovesANIdx], " "));
        EMPGN.GameMovesANIdx += 1;
    }
}

Define FillBoard (warp=true)
{
    List.DeleteAll(GoK_ScreenIdx);
    FB.ScreenSqIdx = 1;
    Repeat (64)
    {
        If (Glob.IsPlayerBlack == 1)
        {
            List.Add(GoK_ScreenIdx, (((IdxToRank[FB.ScreenSqIdx] - 1) * 8) + (9 - IdxToFile[FB.ScreenSqIdx])));
        }
        Else
        {
            List.Add(GoK_ScreenIdx, FB.ScreenSqIdx);
        }
        FB.ScreenSqIdx += 1;
    }
    List.DeleteItem(Board, all);
    Repeat (64)
    {
        List.Add(Board, 0);
    }
    List.ReplaceItem(Board, 1, GoK_BlackRook);
    List.ReplaceItem(Board, 2, GoK_BlackKnight);
    List.ReplaceItem(Board, 3, GoK_BlackBishop);
    List.ReplaceItem(Board, 4, GoK_BlackQueen);
    List.ReplaceItem(Board, 5, GoK_BlackKing);
    List.ReplaceItem(Board, 6, GoK_BlackBishop);
    List.ReplaceItem(Board, 7, GoK_BlackKnight);
    List.ReplaceItem(Board, 8, GoK_BlackRook);
    FB.SqIdx = 9;
    Repeat (8)
    {
        List.ReplaceItem(Board, FB.SqIdx, GoK_BlackPawn);
        FB.SqIdx += 1;
    }
    FB.SqIdx = 49;
    Repeat (8)
    {
        List.ReplaceItem(Board, FB.SqIdx, GoK_WhitePawn);
        FB.SqIdx += 1;
    }
    List.ReplaceItem(Board, 57, GoK_WhiteRook);
    List.ReplaceItem(Board, 58, GoK_WhiteKnight);
    List.ReplaceItem(Board, 59, GoK_WhiteBishop);
    List.ReplaceItem(Board, 60, GoK_WhiteQueen);
    List.ReplaceItem(Board, 61, GoK_WhiteKing);
    List.ReplaceItem(Board, 62, GoK_WhiteBishop);
    List.ReplaceItem(Board, 63, GoK_WhiteKnight);
    List.ReplaceItem(Board, 64, GoK_WhiteRook);
}

Define GenerateMovesForSource(string Ply)(string SourceIdx)(bool AttackTableOnly)(bool Quiescence) (warp=true)
{
    MoveGen.MFS.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    Call //("Pawn moves (generated via code logic)");
    If (MoveGen.MFS.SourcePiece == GoK_BlackPawn)
    {
        If (IdxToFile[(SourceIdx + 0)] > 1)
        {
            If (AttackTableOnly Or (Board[(SourceIdx + 7)] < 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx + 7))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (IdxToFile[(SourceIdx + 0)] < 8)
        {
            If (AttackTableOnly Or (Board[(SourceIdx + 9)] < 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx + 9))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (Not (AttackTableOnly))
        {
            If (Board[(SourceIdx + 8)] == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx + 8))(GoK_BlackPawn)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 8))(Ply)(AttackTableOnly)(Quiescence);
                }
                If ((IdxToRank[(SourceIdx + 0)] == 2) And (Board[(SourceIdx + 16)] == 0))
                {
                    If Quiescence
                    {
                        Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx + 16))(GoK_BlackPawn)(Ply);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx + 16))(Ply)(AttackTableOnly)(Quiescence);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            MoveGen.MFS.TargetIdx = EnPassantTarget[Ply];
            If ((Not (AttackTableOnly)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[MoveGen.MFS.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[MoveGen.MFS.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((MoveGen.MFS.TargetIdx + 8))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_WhitePawn)
    {
        If (IdxToFile[(SourceIdx + 0)] > 1)
        {
            If (AttackTableOnly Or (Board[(SourceIdx - 9)] > 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx - 9))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (IdxToFile[(SourceIdx + 0)] < 8)
        {
            If (AttackTableOnly Or (Board[(SourceIdx - 7)] > 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx - 7))(Ply)(AttackTableOnly)(Quiescence);
            }
        }
        If (Not (AttackTableOnly))
        {
            If (Board[(SourceIdx - 8)] == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx - 8))(GoK_WhitePawn)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 8))(Ply)(AttackTableOnly)(Quiescence);
                }
                If ((IdxToRank[(SourceIdx + 0)] == 7) And (Board[(SourceIdx - 16)] == 0))
                {
                    If Quiescence
                    {
                        Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx - 16))(GoK_WhitePawn)(Ply);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx - 16))(Ply)(AttackTableOnly)(Quiescence);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            MoveGen.MFS.TargetIdx = EnPassantTarget[Ply];
            If ((Not (AttackTableOnly)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[MoveGen.MFS.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[MoveGen.MFS.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((MoveGen.MFS.TargetIdx - 8))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        Stop(this script);
    }
    Call //("Non-pawn moves (generated via lookup tables)");
    MoveGen.MFS.SourcePiece = abs(MoveGen.MFS.SourcePiece);
    If (MoveGen.MFS.SourcePiece == GoK_BlackRook)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackBishop)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackKnight)
    {
        Call AddLookupMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackKing)
    {
        Call AddLookupMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1));
        Stop(this script);
    }
    If (MoveGen.MFS.SourcePiece == GoK_BlackQueen)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1));
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0));
        Stop(this script);
    }
}

Define GenerateMovesImpl(string Ply)(bool AttackTableOnly)(bool Quiescence)(bool IsBlackMove) (warp=true)
{
    If ((CheckedState[Ply] == 1) And (Not (AttackTableOnly)))
    {
        Call PrepareEvasionMask(Ply);
    }
    MoveGen.MI.SkipIdx = -1;
    List.DeleteAll(CalcMovesScoreList);
    List.DeleteAll(CalcMovesMoveList);
    Call PrepareCurrentKillerMoves(Ply);
    Call ClearMoveList(Ply);
    MoveGen.MI.PieceMobilityIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(PieceMobility, MoveGen.MI.PieceMobilityIdx, 0);
        MoveGen.MI.PieceMobilityIdx += 1;
    }
    MoveGen.MI.SourceIdx = 1;
    Repeat (64)
    {
        If (Not ((MoveGen.MI.SourceIdx == MoveGen.MI.SkipIdx)))
        {
            If ((IsBlackMove And (Board[MoveGen.MI.SourceIdx] > 0)) Or ((Not (IsBlackMove)) And (Board[MoveGen.MI.SourceIdx] < 0)))
            {
                Call GenerateMovesForSource(Ply)(MoveGen.MI.SourceIdx)(AttackTableOnly)(Quiescence);
            }
        }
        MoveGen.MI.SourceIdx += 1;
    }
    Call //("Castling moves");
    If ((Not (AttackTableOnly)) And (Not (Quiescence)))
    {
        If IsBlackMove
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 1) == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 2) == 0)))
            {
                If (Operator.LetterOf(CastlingState[Ply], 4) == 0)
                {
                    If ((((Board[1] == GoK_BlackRook) And (Board[2] == 0)) And ((Board[3] == 0) And (Board[4] == 0))) And (Board[5] == GoK_BlackKing))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 3)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 4)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0))))
                        {
                            Call AddSpecialMove(GoK_BlackQueensideCastling)(Ply);
                        }
                    }
                }
                If (Operator.LetterOf(CastlingState[Ply], 3) == 0)
                {
                    If (((Board[5] == GoK_BlackKing) And (Board[6] == 0)) And ((Board[7] == 0) And (Board[8] == GoK_BlackRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 6)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 7)] == 0))))
                        {
                            Call AddSpecialMove(GoK_BlackKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
        Else
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 5) == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 6) == 0)))
            {
                If (Operator.LetterOf(CastlingState[Ply], 8) == 0)
                {
                    If (((Board[57] == GoK_WhiteRook) And (Board[58] == 0)) And ((Board[59] == 0) And ((Board[60] == 0) And (Board[61] == GoK_WhiteKing))))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 59)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 60)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0))))
                        {
                            Call AddSpecialMove(GoK_WhiteQueensideCastling)(Ply);
                        }
                    }
                }
                If (Operator.LetterOf(CastlingState[Ply], 7) == 0)
                {
                    If (((Board[62] == 0) And (Board[61] == GoK_WhiteKing)) And ((Board[63] == 0) And (Board[64] == GoK_WhiteRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 62)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 63)] == 0))))
                        {
                            Call AddSpecialMove(GoK_WhiteKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
    }
    Call //("Move ordering");
    If (Not (AttackTableOnly))
    {
        Call SortMoveList(Ply);
    }
}

Define GenerateMovesImplWrapper(string Ply)(bool AttackTableOnly)(bool Quiescence) (warp=true)
{
    If (Glob.ProfilerMode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodEnter(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * Quiescence)) - ((2 * Const.MaxPlyStackFrames) * AttackTableOnly)) + Ply));
    }
    Glob.IsPotentialNonCapQuiescMove = 0;
    If Quiescence
    {
        Call IsQuiescentCheckCond(Ply);
        Glob.IsPotentialNonCapQuiescMove = Ret.IsQuiescentCheckCond.IsTrue;
    }
    Call GenerateMovesImpl(Ply)(AttackTableOnly)(Quiescence)((PlyIsOwn[Ply] == 1));
    If (Glob.ProfilerMode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodExit(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * Quiescence)) - ((2 * Const.MaxPlyStackFrames) * AttackTableOnly)) + Ply));
    }
}

Define GenerateMovesPublic(string Ply) (warp=true)
{
    MoveGen.MP.SqIdx = 1;
    Repeat (64)
    {
        If (Board[MoveGen.MP.SqIdx] == GoK_WhiteKing)
        {
            Glob.WhiteKingIdx = MoveGen.MP.SqIdx;
        }
        Else
        {
            If (Board[MoveGen.MP.SqIdx] == GoK_BlackKing)
            {
                Glob.BlackKingIdx = MoveGen.MP.SqIdx;
            }
        }
        MoveGen.MP.SqIdx += 1;
    }
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call SetInitialEnPassantTarget(Ply);
    List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasBlackCastled, Glob.HasBlackKingMoved), Operator.Join(Glob.HasBlackRookKSMoved, Glob.HasBlackRookQSMoved)), Operator.Join(Operator.Join(Glob.HasWhiteCastled, Glob.HasWhiteKingMoved), Operator.Join(Glob.HasWhiteRookKSMoved, Glob.HasWhiteRookQSMoved))));
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0));
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    List.ReplaceItem(CastlingState, Ply, Const.Null);
}

Define GetBestMove (warp=false)
{
    Call GetBestMoveDeepening;
    Ret.GetBestMove.Move = Ret.GetBestMoveDeepening.Move;
    If (List.Length(RootLineMoves) > 0)
    {
        Get.BME.TopScore = RootLineEvals[1];
        Get.BME.Delta = (Get.BME.TopScore - RootLineEvals[List.Length(RootLineEvals)]);
        If (Get.BME.Delta > 100)
        {
            Get.BME.Delta = 100;
        }
        Get.BME.Weakness = (147 - (9 * Glob.Level));
        Get.BME.MaxScore = -1000000;
        Get.BME.LineIdx = 1;
        Repeat (List.Length(RootLineMoves))
        {
            Get.BME.Push = floor((((Get.BME.Weakness * (Get.BME.TopScore - RootLineEvals[Get.BME.LineIdx])) + (Get.BME.Delta * Operator.Random(0 , (Get.BME.Weakness - 1)))) / 128));
            If (Not (((RootLineEvals[Get.BME.LineIdx] + Get.BME.Push) < Get.BME.MaxScore)))
            {
                Get.BME.MaxScore = (RootLineEvals[Get.BME.LineIdx] + Get.BME.Push);
                Ret.GetBestMove.Move = RootLineMoves[Get.BME.LineIdx];
            }
            Get.BME.LineIdx += 1;
        }
    }
    Call LogSearchEnd(Ret.GetBestMove.Move);
}

Define GetBestMoveDCI (warp=true)
{
    Call GetBestMoveDeepening.Prepare;
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveDeepening.Iteration;
    }
    Ret.GetBestMoveDCI.Move = Glob.DeepeningBestMove;
    Call LogSearchEnd(Glob.DeepeningBestMove);
}

Define GetBestMoveDCI.Slice (warp=true)
{
    Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Repeat Until ((Glob.IsDeepeningDone == 1) Or ((Sensing.DaysSince2000() * 86400) > (Glob.PrevProgressUpdate + 1)))
    {
        Call GetBestMoveDeepening.Iteration;
    }
    Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Ret.GetBestMoveDCI.Move = Glob.DeepeningBestMove;
    If (Glob.IsDeepeningDone == 1)
    {
        Call LogSearchEnd(Glob.DeepeningBestMove);
    }
}

Define GetBestMoveDeepening (warp=false)
{
    Call GetBestMoveDeepening.Prepare;
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveDeepening.Iteration;
        If (Not ((Glob.IsDCI == 1)))
        {
            If (Not ((Icons_SearchDepth == Glob.IdxDeepening)))
            {
                Icons_SearchDepth = Glob.IdxDeepening;
                Event.Broadcast("Icons_SearchDepthChanged");
            }
            If (((Sensing.DaysSince2000() * 86400) > Glob.NextUIUpdate) Or (Glob.IsDeepeningDone == 1))
            {
                If (Not ((Glob.BestMove == Const.Null)))
                {
                    Call OnEvaluationChanged(Glob.BestMoveEval);
                    If (Glob.BestMove == GoK_BlackKingsideCastling)
                    {
                        Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                        Stg_BestMoveToIdx = GoK_ScreenIdx[7];
                    }
                    Else
                    {
                        If (Glob.BestMove == GoK_BlackQueensideCastling)
                        {
                            Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
                            Stg_BestMoveToIdx = GoK_ScreenIdx[3];
                        }
                        Else
                        {
                            Stg_BestMoveFromIdx = GoK_ScreenIdx[floor((Glob.BestMove / 100))];
                            Stg_BestMoveToIdx = GoK_ScreenIdx[floor((Glob.BestMove % 100))];
                        }
                    }
                    Event.Broadcast("UI_ShowBestMove");
                }
                Get.BMD.Now = (Sensing.DaysSince2000() * 86400);
                Call OnProgressChanged((((Get.BMD.Now - Glob.ThinkTimeStart) / Glob.ProgressLimit) * 100));
                If (Glob.IsDeepeningDone == 0)
                {
                    Call PublishTimers((Get.BMD.Now - Glob.ThinkTimeStart));
                    Glob.NextUIUpdate = (Get.BMD.Now + 0.5);
                }
                If (Glob.IsDeepeningDone == 1)
                {
                    Call PublishTimers(0);
                }
            }
        }
    }
    Ret.GetBestMoveDeepening.Move = Glob.DeepeningBestMove;
}

Define GetBestMoveDeepening.Iteration (warp=true)
{
    Glob.ThinkTimeLimitSearch = Glob.DeepeningThinkTimeLimit;
    If (((Glob.IdxDeepening > 4) And (1 == 1)) And ((Not ((Glob.BestMoveEval == Const.Null))) And (abs(Glob.BestMoveEval) < Const.AbsMinCheckmateEval)))
    {
        Get.BMDI.AspirationDelta = Operator.Round((40 + ((abs(Glob.BestMoveEval) * abs(Glob.BestMoveEval)) / 2400)));
        Get.BMDI.AspirationAlpha = Operator.Round((Glob.BestMoveEval - Get.BMDI.AspirationDelta));
        Get.BMDI.AspirationBeta = Operator.Round((Glob.BestMoveEval + Get.BMDI.AspirationDelta));
    }
    Else
    {
        Get.BMDI.AspirationAlpha = -100000;
        Get.BMDI.AspirationBeta = 100000;
    }
    Glob.SelDepth = 0;
    Get.BMDI.IsAspirationDone = 0;
    Get.BMDI.FailedHighCount = 0;
    Get.BMDI.SavedLimit = Glob.DeepeningThinkTimeLimit;
    Repeat Until ((Get.BMDI.IsAspirationDone == 1) Or (Glob.IsSearchTimeout == 1))
    {
        Glob.ThinkTimeLimitSearch = Glob.DeepeningThinkTimeLimit;
        Get.BMDI.SearchDepth = Glob.IdxDeepening;
        If (Get.BMDI.SearchDepth < 1)
        {
            Get.BMDI.SearchDepth = 1;
        }
        Call Search(Get.BMDI.AspirationAlpha)(Get.BMDI.AspirationBeta)(Get.BMDI.SearchDepth)(1)((Glob.IdxDeepening == 1));
        Get.BMDI.SearchEval = Ret.Search.Eval;
        If ((Not ((Ret.Search.Move == Const.Null))) And (Get.BMDI.SearchEval > Get.BMDI.AspirationAlpha))
        {
            If ((Glob.DeepeningBestMove == Const.Null) Or List.ContainsItem(SearchRootMovesDone, Glob.DeepeningBestMove))
            {
                Glob.DeepeningBestMove = Ret.Search.Move;
                Glob.BestMove = Glob.DeepeningBestMove;
                Glob.BestMoveEval = Get.BMDI.SearchEval;
                If (Glob.IsSearchTimeout == 1)
                {
                    Glob.InfoAdopted = 1;
                }
            }
        }
        Get.BMDI.IsAspirationFail = 0;
        If (Not ((Get.BMDI.SearchEval == Const.Null)))
        {
            If ((Not ((Get.BMDI.SearchEval > Get.BMDI.AspirationAlpha))) Or (Not ((Get.BMDI.SearchEval < Get.BMDI.AspirationBeta))))
            {
                Get.BMDI.IsAspirationFail = 1;
            }
        }
        Get.BMDI.InfoMove = Glob.DeepeningBestMove;
        If (Not ((Ret.Search.Move == Const.Null)))
        {
            Get.BMDI.InfoMove = Ret.Search.Move;
        }
        If (Glob.IsSearchTimeout == 0)
        {
            Call LogSearchInfo(Glob.IdxDeepening)(1)(Get.BMDI.SearchEval)(Get.BMDI.AspirationAlpha)(Get.BMDI.AspirationBeta)(Get.BMDI.InfoMove)(1);
        }
        If ((Glob.IsSearchTimeout == 1) And (Glob.InfoAdopted == 1))
        {
            Call LogSearchInfo(Glob.IdxDeepening)(1)(Get.BMDI.SearchEval)(Get.BMDI.AspirationAlpha)(Get.BMDI.AspirationBeta)(Get.BMDI.InfoMove)(0);
        }
        If ((Glob.IsSearchTimeout == 0) And (Get.BMDI.IsAspirationFail == 1))
        {
            If (Glob.IsDCI == 0)
            {
                Get.BMDI.Now = (Sensing.DaysSince2000() * 86400);
                If (Get.BMDI.Now > Glob.NextUIUpdate)
                {
                    Call OnProgressChanged((((Get.BMDI.Now - Glob.ThinkTimeStart) / Glob.ProgressLimit) * 100));
                }
                If (Get.BMDI.Now > Glob.NextUIUpdate)
                {
                    Call PublishTimers((Get.BMDI.Now - Glob.ThinkTimeStart));
                    Glob.NextUIUpdate = (Get.BMDI.Now + 0.5);
                }
            }
            If ((((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0)) And (Not ((Get.BMDI.SearchEval > Get.BMDI.AspirationAlpha))))
            {
                Glob.DeepeningThinkTimeLimit = Glob.MaxThinkTime;
            }
            Get.BMDI.AspirationDelta = Operator.Round((Get.BMDI.AspirationDelta * 1.5));
            If (Not ((Get.BMDI.SearchEval > Get.BMDI.AspirationAlpha)))
            {
                Get.BMDI.FailedHighCount = 0;
            }
            Else
            {
                Get.BMDI.FailedHighCount += 1;
            }
            If ((Get.BMDI.AspirationDelta < 300) And (abs(Get.BMDI.SearchEval) < Const.AbsMinCheckmateEval))
            {
                If (Not ((Get.BMDI.SearchEval > Get.BMDI.AspirationAlpha)))
                {
                    If (1 == 1)
                    {
                        Get.BMDI.AspirationBeta = Operator.Round(((Get.BMDI.AspirationAlpha + Get.BMDI.AspirationBeta) / 2));
                    }
                    Get.BMDI.AspirationAlpha = Operator.Round((Get.BMDI.SearchEval - Get.BMDI.AspirationDelta));
                }
                Else
                {
                    Get.BMDI.AspirationBeta = Operator.Round((Get.BMDI.SearchEval + Get.BMDI.AspirationDelta));
                }
            }
            Else
            {
                Get.BMDI.AspirationAlpha = -100000;
                Get.BMDI.AspirationBeta = 100000;
            }
        }
        Else
        {
            Get.BMDI.IsAspirationDone = 1;
        }
    }
    If (((Glob.Level < 6) And (Glob.IsSearchTimeout == 0)) And (Not ((Glob.DeepeningBestMove == Const.Null))))
    {
        List.DeleteAll(RootLineMoves);
        List.DeleteAll(RootLineEvals);
        List.Add(RootLineMoves, Glob.DeepeningBestMove);
        List.Add(RootLineEvals, Glob.BestMoveEval);
        Get.BMDI.LineDone = 0;
        List.DeleteAll(RootExcludedMoves);
        List.Add(RootExcludedMoves, Glob.DeepeningBestMove);
        Repeat Until ((List.Length(RootLineMoves) > 3) Or (Get.BMDI.LineDone == 1))
        {
            Glob.SelDepth = 0;
            Call Search(-100000)(100000)(Glob.IdxDeepening)(1)((1 == 0));
            If (((Glob.IsSearchTimeout == 0) And (Not ((Ret.Search.Move == Const.Null)))) And (Not ((Ret.Search.Eval == Const.Null))))
            {
                List.Add(RootLineMoves, Ret.Search.Move);
                List.Add(RootExcludedMoves, Ret.Search.Move);
                List.Add(RootLineEvals, Ret.Search.Eval);
                Call LogSearchInfo(Glob.IdxDeepening)(List.Length(RootLineMoves))(Ret.Search.Eval)(-100000)(100000)(Ret.Search.Move)(1);
            }
            Else
            {
                Get.BMDI.LineDone = 1;
            }
        }
        List.DeleteAll(RootExcludedMoves);
        Get.BMDI.SortIdx = 2;
        Repeat ((List.Length(RootLineEvals) - 1))
        {
            Get.BMDI.SortPos = Get.BMDI.SortIdx;
            Repeat Until ((Get.BMDI.SortPos < 2) Or (Not ((RootLineEvals[Get.BMDI.SortPos] > RootLineEvals[(Get.BMDI.SortPos - 1)]))))
            {
                Get.BMDI.SwapEval = RootLineEvals[Get.BMDI.SortPos];
                Get.BMDI.SwapMove = RootLineMoves[Get.BMDI.SortPos];
                List.ReplaceItem(RootLineEvals, Get.BMDI.SortPos, RootLineEvals[(Get.BMDI.SortPos - 1)]);
                List.ReplaceItem(RootLineMoves, Get.BMDI.SortPos, RootLineMoves[(Get.BMDI.SortPos - 1)]);
                List.ReplaceItem(RootLineEvals, (Get.BMDI.SortPos - 1), Get.BMDI.SwapEval);
                List.ReplaceItem(RootLineMoves, (Get.BMDI.SortPos - 1), Get.BMDI.SwapMove);
                Get.BMDI.SortPos += -1;
            }
            Get.BMDI.SortIdx += 1;
        }
        Glob.DeepeningBestMove = RootLineMoves[1];
        Glob.BestMove = Glob.DeepeningBestMove;
        Glob.BestMoveEval = RootLineEvals[1];
        List.DeleteAll(RootLinePrevMoves);
        Get.BMDI.SortIdx = 1;
        Repeat (List.Length(RootLineMoves))
        {
            List.Add(RootLinePrevMoves, RootLineMoves[Get.BMDI.SortIdx]);
            Get.BMDI.SortIdx += 1;
        }
    }
    Glob.DeepeningThinkTimeLimit = Get.BMDI.SavedLimit;
    Get.BMDI.IsDeepeningDone = 0;
    If (Glob.IsSearchTimeout == 1)
    {
        Get.BMDI.IsDeepeningDone = 1;
    }
    Else
    {
        If (Glob.IdxDeepening == Glob.DeepeningMaxSearchPly)
        {
            Get.BMDI.IsDeepeningDone = 1;
        }
        Else
        {
            If ((Glob.CustomMaxDepth > 0) And (Not ((Glob.IdxDeepening < Glob.CustomMaxDepth))))
            {
                Get.BMDI.IsDeepeningDone = 1;
            }
            Else
            {
                If (Not ((Glob.BestMoveEval == Const.Null)))
                {
                    If (abs(Glob.BestMoveEval) > (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + Glob.IdxDeepening)))
                    {
                        Get.BMDI.IsDeepeningDone = 1;
                    }
                }
            }
        }
    }
    If ((Glob.Level < 6) And (Not ((Glob.IdxDeepening < ((2 * Glob.Level) - 2)))))
    {
        Get.BMDI.IsDeepeningDone = 1;
    }
    If ((Glob.IdxDeepening == 1) And (Ret.Search.LegalMoveCount == 1))
    {
        Get.BMDI.IsDeepeningDone = 1;
    }
    If (Get.BMDI.IsDeepeningDone == 1)
    {
        Glob.IsDeepeningDone = 1;
    }
    Else
    {
        If ((((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0)) And (Glob.IdxDeepening > 4))
        {
            Glob.BestMoveChanges = (Glob.BestMoveChanges / 2);
            If (Glob.DeepeningBestMove == Glob.StableBestMove)
            {
                Glob.StableBestMoveCount += 1;
            }
            Else
            {
                Glob.StableBestMoveCount = 0;
                If (Not ((Glob.StableBestMove == Const.Null)))
                {
                    Glob.BestMoveChanges += 1;
                }
            }
            Glob.StableBestMove = Glob.DeepeningBestMove;
            If (Glob.StableBestMoveCount > 5)
            {
                Get.BMDI.SoftThinkTime = (Glob.OptimumThinkTime * 0.6);
            }
            Else
            {
                Get.BMDI.SoftThinkTime = (Glob.OptimumThinkTime * (1.3 - (0.14 * Glob.StableBestMoveCount)));
            }
            Get.BMDI.BestMoveInstability = (1 + (1.88 * Glob.BestMoveChanges));
            Get.BMDI.SoftThinkTime = (Get.BMDI.SoftThinkTime * Get.BMDI.BestMoveInstability);
            If ((Glob.PrevMoveEval == Const.Null) Or ((Glob.PrevIterEval == Const.Null) Or (Glob.BestMoveEval == Const.Null)))
            {
                Get.BMDI.FallingEval = 1;
            }
            Else
            {
                Get.BMDI.FallingEval = ((69 + ((24 * (Glob.PrevMoveEval - Glob.BestMoveEval)) + (12 * (Glob.PrevIterEval - Glob.BestMoveEval)))) / 781.4);
                If (Get.BMDI.FallingEval < 0.5)
                {
                    Get.BMDI.FallingEval = 0.5;
                }
                If (Get.BMDI.FallingEval > 1.5)
                {
                    Get.BMDI.FallingEval = 1.5;
                }
            }
            Get.BMDI.SoftThinkTime = (Get.BMDI.SoftThinkTime * (Get.BMDI.FallingEval / 0.5));
            If (Get.BMDI.SoftThinkTime > Glob.DeepeningThinkTimeLimit)
            {
                Get.BMDI.SoftThinkTime = Glob.DeepeningThinkTimeLimit;
            }
            Get.BMDI.DepthTimeGrowth = 1.4;
            If ((((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * Get.BMDI.DepthTimeGrowth) > Get.BMDI.SoftThinkTime) And (Not ((Glob.IdxDeepening < Glob.MinThinkDepth)))) Or ((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * 1.9) > Glob.DeepeningThinkTimeLimit))
            {
                Glob.IsDeepeningDone = 1;
            }
            Glob.PrevIterEval = Glob.BestMoveEval;
        }
        If (Glob.IsDeepeningDone == 0)
        {
            Glob.IdxDeepening += 1;
        }
    }
    If ((Glob.IsDeepeningDone == 1) And (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0)))
    {
        Glob.PrevMoveEval = Glob.BestMoveEval;
        Glob.CurrentClockTime = (Glob.CurrentClockTime + (Glob.ClockTimeInc - ((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart)));
        Glob.ClockMoveCount += 1;
        If ((Glob.ClockStageMoves > 0) And (Glob.ClockMoveCount == Glob.ClockStageMoves))
        {
            Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockStageTime);
        }
        If (Glob.AvgCompletedDepth == Const.Null)
        {
            Glob.AvgCompletedDepth = (Glob.IdxDeepening - Glob.IsSearchTimeout);
        }
        Else
        {
            Glob.AvgCompletedDepth = ((0.8 * Glob.AvgCompletedDepth) + (0.2 * (Glob.IdxDeepening - Glob.IsSearchTimeout)));
        }
        If ((Glob.TimeControl == 1) And (Glob.CurrentClockTime < 0))
        {
            Looks.Say("Engine out of time");
            GoK_IsGameSuspended = 1;
        }
    }
}

Define GetBestMoveDeepening.Prepare (warp=true)
{
    GBMD.Prepare.HistIdx = 1;
    Repeat (List.Length(HistoryMoveScores))
    {
        List.ReplaceItem(HistoryMoveScores, GBMD.Prepare.HistIdx, (HistoryMoveScores[GBMD.Prepare.HistIdx] / 2));
        GBMD.Prepare.HistIdx += 1;
    }
    GBMD.Prepare.HistIdx = 1;
    Repeat (List.Length(HistoryCaptureScores))
    {
        List.ReplaceItem(HistoryCaptureScores, GBMD.Prepare.HistIdx, (HistoryCaptureScores[GBMD.Prepare.HistIdx] / 2));
        GBMD.Prepare.HistIdx += 1;
    }
    If (Glob.IsScratch3 == 0)
    {
        GBMD.Prepare.HistIdx = 1;
        Repeat (List.Length(HistoryContinuation))
        {
            List.ReplaceItem(HistoryContinuation, GBMD.Prepare.HistIdx, (HistoryContinuation[GBMD.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation2, GBMD.Prepare.HistIdx, (HistoryContinuation2[GBMD.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation3, GBMD.Prepare.HistIdx, (HistoryContinuation3[GBMD.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation4, GBMD.Prepare.HistIdx, (HistoryContinuation4[GBMD.Prepare.HistIdx] / 2));
            GBMD.Prepare.HistIdx += 1;
        }
    }
    If (List.Length(TTNodeEntry) == 0)
    {
        Call ClearTT;
    }
    List.DeleteAll(RootLineMoves);
    List.DeleteAll(RootLineEvals);
    Glob.DeepeningMaxSearchPly = (Const.MaxPlyStackFrames - 30);
    Glob.DeepeningThinkTimeLimit = 20;
    If ((Glob.IsDCI == 0) And (Glob.IsScratch3 == 1))
    {
        If (Not ((Glob.Level < 6)))
        {
            Glob.DeepeningThinkTimeLimit = 30;
        }
    }
    If (Glob.CustomThinkTime > 0)
    {
        Glob.DeepeningThinkTimeLimit = Glob.CustomThinkTime;
    }
    If ((Glob.IsDCI == 0) And (Glob.TimeControl == 0))
    {
        Glob.InitialClockTime = 0;
        If (Glob.CustomThinkTime == 0)
        {
            Glob.ClockTimeInc = Glob.DeepeningThinkTimeLimit;
        }
        Else
        {
            Glob.ClockTimeInc = 0;
        }
        Glob.CurrentClockTime = 0;
    }
    If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
    {
        Get.BMDP.RemainingTime = (Glob.CurrentClockTime + Glob.ClockTimeInc);
        If (Glob.ClockStageMoves > Glob.ClockMoveCount)
        {
            Get.BMDP.MovesToGo = (Glob.ClockStageMoves - Glob.ClockMoveCount);
            If (Get.BMDP.MovesToGo > 50)
            {
                Get.BMDP.MovesToGo = 50;
            }
            Get.BMDP.MaxScale = (1.5 + (0.11 * Get.BMDP.MovesToGo));
            If (Get.BMDP.MaxScale > 6.3)
            {
                Get.BMDP.MaxScale = 6.3;
            }
        }
        Else
        {
            If (Glob.ClockTimeInc == 0)
            {
                Get.BMDP.MovesToGo = 40;
            }
            Else
            {
                Get.BMDP.MovesToGo = 19;
            }
            Get.BMDP.MaxScale = 4.5;
        }
        Glob.OptimumThinkTime = ((Get.BMDP.RemainingTime / Get.BMDP.MovesToGo) + Glob.ClockTimeInc);
        Glob.MaxThinkTime = (0.8 * Get.BMDP.RemainingTime);
        If (Glob.TimeControl == 1)
        {
            Glob.MaxThinkTime = (0.8 * Glob.CurrentClockTime);
        }
        If (Glob.ClockStageMoves > Glob.ClockMoveCount)
        {
            If (Glob.MaxThinkTime > (Get.BMDP.RemainingTime - ((Get.BMDP.MovesToGo - 1) * (0.75 * Glob.OptimumThinkTime))))
            {
                Glob.MaxThinkTime = (Get.BMDP.RemainingTime - ((Get.BMDP.MovesToGo - 1) * (0.75 * Glob.OptimumThinkTime)));
            }
        }
        Else
        {
            If (Glob.ClockTimeInc == 0)
            {
                If (Glob.MaxThinkTime > (Get.BMDP.MaxScale * Glob.OptimumThinkTime))
                {
                    Glob.MaxThinkTime = (Get.BMDP.MaxScale * Glob.OptimumThinkTime);
                }
            }
        }
        Glob.DeepeningThinkTimeLimit = (Get.BMDP.MaxScale * Glob.OptimumThinkTime);
        If (Glob.DeepeningThinkTimeLimit > Glob.MaxThinkTime)
        {
            Glob.DeepeningThinkTimeLimit = Glob.MaxThinkTime;
        }
        If (Glob.TimeControl == 1)
        {
            If (Glob.MaxThinkTime < 0.05)
            {
                Glob.MaxThinkTime = 0.05;
            }
            If (Glob.DeepeningThinkTimeLimit < 0.05)
            {
                Glob.DeepeningThinkTimeLimit = 0.05;
            }
        }
        Glob.BestMoveChanges = 0;
        If (Glob.ClockTimeInc > 0)
        {
            Glob.MinThinkDepth = (floor((11.5 + (1.66 * ln(Glob.ClockTimeInc)))) - 1);
        }
        Else
        {
            Glob.MinThinkDepth = 0;
        }
        If ((Not ((Glob.AvgCompletedDepth == Const.Null))) And (Glob.AvgCompletedDepth < Glob.MinThinkDepth))
        {
            Glob.MinThinkDepth = floor(Glob.AvgCompletedDepth);
        }
        Glob.StableBestMoveCount = 0;
        Glob.StableBestMove = Const.Null;
        Glob.PrevIterEval = Glob.PrevMoveEval;
    }
    If (((Glob.IsDCI == 0) And (Glob.CustomThinkTime == 0)) And (Glob.TimeControl == 0))
    {
        If (Glob.DeepeningThinkTimeLimit > (2 * Glob.Level))
        {
            Glob.DeepeningThinkTimeLimit = (2 * Glob.Level);
        }
        If (Glob.MaxThinkTime > (2 * Glob.Level))
        {
            Glob.MaxThinkTime = (2 * Glob.Level);
        }
    }
    Glob.ProgressLimit = Glob.DeepeningThinkTimeLimit;
    If ((Glob.TimeControl == 1) And (Glob.OptimumThinkTime > 0.05))
    {
        Glob.ProgressLimit = Glob.OptimumThinkTime;
    }
    Glob.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Call ResetSearchInfo;
    Glob.NextUIUpdate = Glob.ThinkTimeStart;
    If (Glob.IsTimeModelLogged == 0)
    {
        Glob.IsTimeModelLogged = 1;
    }
    Glob.IsSearchTimeout = 0;
    Glob.IsDeepeningDone = 0;
    Glob.IdxDeepening = 1;
    List.DeleteAll(RootLinePrevMoves);
    Glob.DeepeningBestMove = Const.Null;
    Glob.BestMove = Glob.DeepeningBestMove;
    Glob.BestMoveEval = Const.Null;
}

Define GetBoardString (warp=true)
{
    Get.BS.SqIdx = 1;
    Ret.GetBoardString.BoardString = "";
    Repeat (64)
    {
        Ret.GetBoardString.BoardString = Operator.Join(Ret.GetBoardString.BoardString, Operator.Join(Board[Get.BS.SqIdx], ","));
        Get.BS.SqIdx += 1;
    }
}

Define GetCalibratedEval(string Ply) (warp=true)
{
    Ret.GetCalibratedEval.Score = StaticEval[Ply];
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        If ((NodeTTHit[Ply] == 1) And (Not ((NodeTTScore[Ply] == Const.Null))))
        {
            GCE.TTType = NodeTTType[Ply];
            GCE.TTScore = NodeTTScore[Ply];
            GCE.StaticEval = StaticEval[Ply];
            GCE.IsTTScoreUsable = 0;
            If (GCE.TTType == Const.TTType.Exact)
            {
                GCE.IsTTScoreUsable = 1;
            }
            Else
            {
                If (GCE.TTType == Const.TTType.HighBound)
                {
                    If (GCE.TTScore < GCE.StaticEval)
                    {
                        GCE.IsTTScoreUsable = 1;
                    }
                }
                Else
                {
                    If (GCE.TTType == Const.TTType.LowBound)
                    {
                        If (GCE.TTScore > GCE.StaticEval)
                        {
                            GCE.IsTTScoreUsable = 1;
                        }
                    }
                }
            }
            If (GCE.IsTTScoreUsable == 1)
            {
                If (1 == 1)
                {
                    If (Not ((abs(NodeTTScore[Ply]) > Const.AbsMinCheckmateEval)))
                    {
                        Ret.GetCalibratedEval.Score = NodeTTScore[Ply];
                    }
                }
            }
        }
    }
}

Define GetCorrHistIndices(string Ply) (warp=true)
{
    Ret.GetCorrHistIndices.PawnKey = Glob.KPHash;
    Call GetPiecePosHash(Board[Glob.WhiteKingIdx])(Glob.WhiteKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Call GetPiecePosHash(Board[Glob.BlackKingIdx])(Glob.BlackKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Ret.GetCorrHistIndices.CorrIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.PawnKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnBlackKey = Glob.NonPawnHashBlack;
    Ret.GetCorrHistIndices.NonPawnBlackIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnBlackKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnWhiteKey = Glob.NonPawnHashWhite;
    Ret.GetCorrHistIndices.NonPawnWhiteIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnWhiteKey % 100000)) + 1);
    Ret.GetCorrHistIndices.ContIdx2 = Const.Null;
    Ret.GetCorrHistIndices.ContIdx4 = Const.Null;
    If ((Ply > 2) And (Glob.IsScratch3 == 0))
    {
        If ((Not ((AppliedMove[(Ply - 1)] == 0))) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            Get.CHI.PieceTo1 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] - 1) + (6 * (SourcePieces[(Ply - 1)] < 0))) * 64) + floor((AppliedMove[(Ply - 1)] % 100)));
            Get.CHI.PieceTo2 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] - 1) + (6 * (SourcePieces[(Ply - 2)] < 0))) * 64) + floor((AppliedMove[(Ply - 2)] % 100)));
            Ret.GetCorrHistIndices.ContIdx2 = ((((PlyIsOwn[Ply] * 646416) + (Get.CHI.PieceTo1 * 804)) + Get.CHI.PieceTo2) + 1);
            If (Ply > 4)
            {
                If (Not ((AppliedMove[(Ply - 4)] == 0)))
                {
                    Get.CHI.PieceTo4 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] - 1) + (6 * (SourcePieces[(Ply - 4)] < 0))) * 64) + floor((AppliedMove[(Ply - 4)] % 100)));
                    Ret.GetCorrHistIndices.ContIdx4 = ((((PlyIsOwn[Ply] * 646416) + (Get.CHI.PieceTo1 * 804)) + Get.CHI.PieceTo4) + 1);
                }
            }
        }
    }
}

Define GetCurrentMove(num Ply) (warp=true)
{
    Ret.GetCurrentMove.Move = Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])];
}

Define GetHashfull(string Age) (warp=true)
{
    Ret.GetHashfull.Permill = 0;
    GHF.Span = (Age - (floor((Age / 100)) * 100));
    GHF.AgeNow = (Age % 131072);
    GHF.Idx = 1;
    Repeat (1000)
    {
        If (Not ((TTNodeEntry[(GHF.Idx + Const.TTNodeCol.HashIdx)] == Const.Null)))
        {
            GHF.Diff = (GHF.AgeNow - floor((TTNodeEntry[(GHF.Idx + Const.TTNodeCol.MetaIdx)] / 16384)));
            If ((Not ((GHF.Diff < 0))) And (Not ((GHF.Diff > GHF.Span))))
            {
                Ret.GetHashfull.Permill += 1;
            }
        }
        GHF.Idx += Const.TTNodeEntrySize;
    }
}

Define GetHistoryStatScore(string SourcePieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply) (warp=true)
{
    Get.HSS.PieceToKey = 0;
    Ret.GetHistoryStatScore.Score = 0;
    If (floor((Move / 100)) == 0)
    {
        Ret.GetHistoryStatScore.Score += (2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]);
        Get.HSS.PieceToKey = ((PieceIdxLookup[GoK_BlackKing] * 68) + ToIdx);
    }
    Else
    {
        If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
        {
            Ret.GetHistoryStatScore.Score += (2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]);
            Get.HSS.PieceToKey = ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx);
        }
    }
    Get.HSS.Idx = -1;
    If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
    {
        If (1 == 1)
        {
            Get.HSS.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + Get.HSS.PieceToKey);
        }
    }
    If (Not ((Get.HSS.Idx == -1)))
    {
        Ret.GetHistoryStatScore.Score += (HistoryContinuation[(PlyContinuationBaseIdx[Ply] + Get.HSS.Idx)] * 2);
    }
    If (1 == 1)
    {
        If ((Ply > 2) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            If (1 == 1)
            {
                Get.HSS.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                Ret.GetHistoryStatScore.Score += (HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + Get.HSS.Idx)] * 1);
            }
        }
    }
    If ((Ply > 4) And (Not ((AppliedMove[(Ply - 4)] == 0))))
    {
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))]));
    }
    If ((Ply > 6) And (Not ((AppliedMove[(Ply - 6)] == 0))))
    {
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))]));
    }
    Call ProbePawnHist(SourcePieceParam)(ToIdx);
    Ret.GetHistoryStatScore.Score += (HistoryPawnHist[Ret.ProbePawnHist.Idx] * 2);
}

Define GetImproving(string Ply) (warp=true)
{
    If (Improving[Ply] == Const.Null)
    {
        Call GetImprovingImpl(Ply);
        List.ReplaceItem(Improving, Ply, Ret.GetImprovingImpl.IsImproving);
    }
    Ret.GetImproving.IsImproving = Improving[Ply];
}

Define GetImprovingImpl(string Ply) (warp=true)
{
    If (CheckedState[Ply] == 1)
    {
        Ret.GetImprovingImpl.IsImproving = 0;
        Stop(this script);
    }
    If (Ply > 1)
    {
        If (AppliedMove[(Ply - 1)] == 0)
        {
            Ret.GetImprovingImpl.IsImproving = 0;
            Stop(this script);
        }
    }
    Ret.GetImprovingImpl.IsImproving = Const.Null;
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        Get.Improving.StaticEvalIdx = (Ply - 2);
        If (Get.Improving.StaticEvalIdx > 0)
        {
            If (StaticEval[Get.Improving.StaticEvalIdx] == Const.Null)
            {
                Get.Improving.StaticEvalIdx = (Get.Improving.StaticEvalIdx - 2);
            }
        }
        If ((Get.Improving.StaticEvalIdx > 0) And (Not ((StaticEval[Get.Improving.StaticEvalIdx] == Const.Null))))
        {
            If (StaticEval[Ply] > StaticEval[Get.Improving.StaticEvalIdx])
            {
                Ret.GetImprovingImpl.IsImproving = 1;
            }
            Else
            {
                Ret.GetImprovingImpl.IsImproving = 0;
            }
        }
    }
}

Define GetMoveNotation(num Move) (warp=true)
{
    Call GetPhysicalMove(Move);
    Ret.GetMoveNotation.VirtualMove = Ret.GetPhysicalMove.Move;
    Ret.GetMoveNotation.Notation = "";
    If ((Ret.GetPhysicalMove.Move == GoK_BlackKingsideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteKingsideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O";
        Stop(this script);
    }
    If ((Ret.GetPhysicalMove.Move == GoK_BlackQueensideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteQueensideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O-O";
        Stop(this script);
    }
    Get.MN.SourceIdx = floor((Ret.GetPhysicalMove.Move / 100));
    Get.MN.TargetIdx = floor((Ret.GetPhysicalMove.Move % 100));
    Get.MN.Piece = Board[floor((Move / 100))];
    If ((Get.MN.Piece == GoK_BlackBishop) Or (Get.MN.Piece == GoK_WhiteBishop))
    {
        Ret.GetMoveNotation.Notation = "B";
    }
    If ((Get.MN.Piece == GoK_BlackKing) Or (Get.MN.Piece == GoK_WhiteKing))
    {
        Ret.GetMoveNotation.Notation = "K";
    }
    If ((Get.MN.Piece == GoK_BlackRook) Or (Get.MN.Piece == GoK_WhiteRook))
    {
        Ret.GetMoveNotation.Notation = "R";
    }
    If ((Get.MN.Piece == GoK_BlackKnight) Or (Get.MN.Piece == GoK_WhiteKnight))
    {
        Ret.GetMoveNotation.Notation = "N";
    }
    If ((Get.MN.Piece == GoK_WhiteQueen) Or (Get.MN.Piece == GoK_BlackQueen))
    {
        Ret.GetMoveNotation.Notation = "Q";
    }
    Get.MN.File = IdxToFile[Get.MN.SourceIdx];
    Get.MN.NotationRank = (9 - IdxToRank[Get.MN.SourceIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", Get.MN.File), Get.MN.NotationRank));
    If (Not ((Board[floor((Move % 100))] == 0)))
    {
        Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "x");
    }
    Get.MN.File = IdxToFile[Get.MN.TargetIdx];
    Get.MN.NotationRank = (9 - IdxToRank[Get.MN.TargetIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", Get.MN.File), Get.MN.NotationRank));
    If (Operator.LetterOf(Ret.GetPhysicalMove.Move, (Variable.Length(Ret.GetPhysicalMove.Move) - 1)) == ".")
    {
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 1)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=Q");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 2)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=R");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 3)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=B");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 4)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=N");
        }
    }
}

Define GetMoveScore(string SourcePieceParam)(string TargetPieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply) (warp=true)
{
    Ret.GetMoveScore.Score = 0;
    Call IsMovePicked(Ply)(Move);
    If (Ret.IsMovePicked.Picked == 1)
    {
        Ret.GetMoveScore.Score = Ret.IsMovePicked.Score;
        Stop(this script);
    }
    Call //("1: Hash moves, handled by staged move generator / PickMove()");
    If (CheckedState[Ply] == 1)
    {
        If ((abs(SourcePieceParam) == GoK_BlackKing) Or (BoardAttackedEvasionTarget[ToIdx] == 1))
        {
            Ret.GetMoveScore.Score = 8000000;
            If ((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0))))
            {
                Ret.GetMoveScore.Score += (100000 + ((PieceIdxLookup[abs(TargetPieceParam)] * 100) + (7 - PieceIdxLookup[abs(SourcePieceParam)])));
            }
            Else
            {
                Get.MS.ContMoveScore = 0;
                If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
                {
                    Get.MS.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                    Get.MS.ContMoveScore = (2 * HistoryContinuation[(PlyContinuationBaseIdx[Ply] + Get.MS.Idx)]);
                }
                Ret.GetMoveScore.Score += ((2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]) + Get.MS.ContMoveScore);
            }
            Stop(this script);
        }
    }
    If (Not ((Move == floor(Move))))
    {
        Call //("Promotions");
        If (((Move * 10) % 10) == 1)
        {
            If (Board[floor((Move % 100))] == 0)
            {
                Ret.GetMoveScore.Score = 7000000;
            }
            Else
            {
                Get.MS.PieceIdx = PieceIdxLookup[abs(Board[floor((Move % 100))])];
                Get.MS.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((Get.MS.PieceIdx - 1) * 64) + floor((Move % 100)))) + (2304 * (SourcePieceParam < 0)));
                Ret.GetMoveScore.Score = ((7000000 + (100000 * Get.MS.PieceIdx)) + HistoryCaptureScores[Get.MS.BaseIdx]);
            }
            Stop(this script);
        }
        Else
        {
            Call GetHistoryStatScore(SourcePieceParam)(floor((floor(Move) / 100)))(floor((Move % 100)))(floor(Move))(Ply);
            Ret.GetMoveScore.Score = (2100000 + Ret.GetHistoryStatScore.Score);
            Stop(this script);
        }
    }
    If (((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0)))) Or (((abs(SourcePieceParam) == GoK_BlackPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx]))))))
    {
        Get.MS.TargetPiece = TargetPieceParam;
        If (((abs(SourcePieceParam) == GoK_BlackPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))))
        {
            Get.MS.TargetPiece = (0 - SourcePieceParam);
        }
        Get.MS.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((PieceIdxLookup[abs(Get.MS.TargetPiece)] - 1) * 64) + ToIdx)) + (2304 * (SourcePieceParam < 0)));
        Get.MS.BaseScore = 7100000;
        If (Not (((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 1))))
        {
            If (Not (((PieceIdxLookup[abs(Get.MS.TargetPiece)] + 1) > PieceIdxLookup[abs(SourcePieceParam)])))
            {
                If (Not ((Glob.IsScratch3 == 1)))
                {
                    Call ClearMoveList((Ply + 2));
                    Call AddMoveToList(Move)((Ply + 2))(0);
                    List.ReplaceItem(MovesIdx, (Ply + 2), 1);
                    Call ApplyMoveLight((Ply + 2));
                    Call SEE((Ply + 2))((1 == 0));
                    Get.MS.SEEGain = Ret.SEE.Gain;
                    Call RevertMoveLight((Ply + 2));
                    If (Not ((Not ((Get.MS.SEEGain < (-50 - (abs(Get.MS.TargetPiece) / 4)))))))
                    {
                        Get.MS.BaseScore = 1000000;
                    }
                }
            }
        }
        Ret.GetMoveScore.Score = ((Get.MS.BaseScore + (6 * abs(Get.MS.TargetPiece))) + HistoryCaptureScores[Get.MS.BaseIdx]);
        Stop(this script);
    }
    Call //("4: Killer moves");
    Call PrepareCurrentKillerMoves(Ply);
    If ((Not ((CurrentKillerMoves[1] == Const.Null))) And (CurrentKillerMoves[1] == Move))
    {
        Ret.GetMoveScore.Score = 6000000;
        Stop(this script);
    }
    Else
    {
        If ((Not ((CurrentKillerMoves[2] == Const.Null))) And (CurrentKillerMoves[2] == Move))
        {
            Ret.GetMoveScore.Score = 5000000;
            Stop(this script);
        }
    }
    Call //("5. Counter Moves");
    If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
    {
        If ((Not ((AppliedMove[(Ply - 1)] == Const.Null))) And (HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))] == Move))
        {
            Ret.GetMoveScore.Score = 4000000;
            Stop(this script);
        }
    }
    Call //("6: Quiets with high history score");
    Ret.GetMoveScore.Score = 2100000;
    Call GetHistoryStatScore(SourcePieceParam)(FromIdx)(ToIdx)(Move)(Ply);
    Ret.GetMoveScore.Score += Ret.GetHistoryStatScore.Score;
    If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
    {
        If (BoardAttackedCalculated[Ply] == 1)
        {
            Get.MS.PieceAbs = abs(SourcePieceParam);
            If ((Get.MS.PieceAbs > GoK_BlackPawn) And (Get.MS.PieceAbs < GoK_BlackKing))
            {
                Get.MS.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + FromIdx);
                If (BoardAttackedByOpponentSnapshot[Get.MS.AttackIdx] > 0)
                {
                    Get.MS.ThreatenedByPieceAbs = abs(Board[BoardAttackedByOpponentPieceSnapshot[Get.MS.AttackIdx]]);
                    If (((Get.MS.PieceAbs == GoK_BlackQueen) And (Get.MS.ThreatenedByPieceAbs < GoK_BlackQueen)) Or (((Get.MS.PieceAbs == GoK_BlackRook) And (Get.MS.ThreatenedByPieceAbs < GoK_BlackRook)) Or (((Get.MS.PieceAbs == GoK_BlackKnight) Or (Get.MS.PieceAbs == GoK_BlackBishop)) And (Get.MS.ThreatenedByPieceAbs == GoK_BlackPawn))))
                    {
                        Get.MS.ThreatenedByPieceAbs = 0;
                        Get.MS.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + ToIdx);
                        If (BoardAttackedByOpponentSnapshot[Get.MS.AttackIdx] > 0)
                        {
                            Get.MS.ThreatenedByPieceAbs = abs(Board[BoardAttackedByOpponentPieceSnapshot[Get.MS.AttackIdx]]);
                        }
                        If (Get.MS.ThreatenedByPieceAbs < GoK_BlackKing)
                        {
                            If ((Get.MS.PieceAbs == GoK_BlackQueen) And ((Get.MS.ThreatenedByPieceAbs == 0) Or (Get.MS.ThreatenedByPieceAbs == GoK_BlackQueen)))
                            {
                                Ret.GetMoveScore.Score += 50000;
                            }
                            Else
                            {
                                If ((Get.MS.PieceAbs == GoK_BlackRook) And ((Get.MS.ThreatenedByPieceAbs == 0) Or (Get.MS.ThreatenedByPieceAbs > GoK_BlackBishop)))
                                {
                                    Ret.GetMoveScore.Score += 25000;
                                }
                                Else
                                {
                                    If ((Get.MS.ThreatenedByPieceAbs == 0) Or (Get.MS.ThreatenedByPieceAbs > GoK_BlackPawn))
                                    {
                                        Ret.GetMoveScore.Score += 15000;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define GetMoveUci(string Move)(string IsWhite) (warp=true)
{
    Ret.GetMoveUci.Uci = "";
    Call GetPhysicalMove(Move);
    GMU.IsCastle = 0;
    GMU.Rank = 8;
    If (IsWhite == 1)
    {
        GMU.Rank = 1;
    }
    If ((Ret.GetPhysicalMove.Move == GoK_BlackKingsideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteKingsideCastling))
    {
        GMU.IsCastle = 1;
        Ret.GetMoveUci.Uci = Operator.Join("e", Operator.Join(GMU.Rank, Operator.Join("g", GMU.Rank)));
    }
    If ((Ret.GetPhysicalMove.Move == GoK_BlackQueensideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteQueensideCastling))
    {
        GMU.IsCastle = 1;
        Ret.GetMoveUci.Uci = Operator.Join("e", Operator.Join(GMU.Rank, Operator.Join("c", GMU.Rank)));
    }
    If (GMU.IsCastle == 0)
    {
        GMU.From = floor((Ret.GetPhysicalMove.Move / 100));
        GMU.To = floor((Ret.GetPhysicalMove.Move % 100));
        Ret.GetMoveUci.Uci = Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[GMU.From]), Operator.Join((9 - IdxToRank[GMU.From]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[GMU.To]), (9 - IdxToRank[GMU.To]))));
        If (Operator.LetterOf(Move, (Variable.Length(Move) - 1)) == ".")
        {
            Ret.GetMoveUci.Uci = Operator.Join(Ret.GetMoveUci.Uci, Operator.LetterOf("qrbn", Operator.LetterOf(Move, Variable.Length(Move))));
        }
    }
}

Define GetNormalizedMove(string Move) (warp=true)
{
    If (Move == floor(Move))
    {
        Ret.GetNormalizedMove.Move = MoveToZeroPaddedStr[(Move + 1)];
    }
    Else
    {
        Ret.GetNormalizedMove.Move = Operator.Join(MoveToZeroPaddedStr[(floor(Move) + 1)], Operator.Join(".", Operator.LetterOf(Move, Variable.Length(Move))));
    }
}

Define GetOpeningMoves (warp=true)
{
    List.DeleteItem(OpeningMovesRes, all);
    If (1 == 1)
    {
        Call GenerateMovesPublic(1);
        Call CreateCurrentBoardHash;
        Get.OM.OpeningMovesMapMoveIdx = 1;
        Repeat (List.Length(OpeningMovesMapHash))
        {
            If (OpeningMovesMapHash[Get.OM.OpeningMovesMapMoveIdx] == Glob.CurrentBoardHash)
            {
                If List.ContainsItem(Moves1, OpeningMovesMapMove[Get.OM.OpeningMovesMapMoveIdx])
                {
                    List.Add(OpeningMovesRes, OpeningMovesMapMove[Get.OM.OpeningMovesMapMoveIdx]);
                }
            }
            Get.OM.OpeningMovesMapMoveIdx += 1;
        }
    }
}

Define GetPawnHistHash(string From)(string To) (warp=true)
{
    Call GetPiecePosHash(Board[Glob.WhiteKingIdx])(Glob.WhiteKingIdx);
    Call GetPiecePosHash(Board[Glob.BlackKingIdx])(Glob.BlackKingIdx);
    Call GetPiecePosHash(GoK_WhitePawn)(From);
    Call GetPiecePosHash(GoK_WhitePawn)(To);
}

Define GetPhysicalMove(num Move) (warp=true)
{
    If (Glob.IsPlayerBlack == 0)
    {
        Ret.GetPhysicalMove.Move = Move;
    }
    Else
    {
        If (Not ((floor((Move / 100)) == 0)))
        {
            Ret.GetPhysicalMove.Move = ((RankFlipIdx[floor((Move / 100))] * 100) + RankFlipIdx[floor((Move % 100))]);
            If (Operator.LetterOf(Move, (Variable.Length(Move) - 1)) == ".")
            {
                Ret.GetPhysicalMove.Move = (Ret.GetPhysicalMove.Move + (0.1 * Operator.LetterOf(Move, Variable.Length(Move))));
            }
        }
        Else
        {
            If (Move == GoK_BlackKingsideCastling)
            {
                Ret.GetPhysicalMove.Move = GoK_WhiteKingsideCastling;
            }
            Else
            {
                If (Move == GoK_BlackQueensideCastling)
                {
                    Ret.GetPhysicalMove.Move = GoK_WhiteQueensideCastling;
                }
                Else
                {
                    If (Move == GoK_WhiteKingsideCastling)
                    {
                        Ret.GetPhysicalMove.Move = GoK_BlackKingsideCastling;
                    }
                    Else
                    {
                        If (Move == GoK_WhiteQueensideCastling)
                        {
                            Ret.GetPhysicalMove.Move = GoK_BlackQueensideCastling;
                        }
                    }
                }
            }
        }
    }
}

Define GetPiecePosEval(string Piece)(string Idx) (warp=true)
{
    Ret.GetPiecePosEval.Score = 0;
    If ((Idx == 0) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece == GoK_BlackPawn)
    {
        If (Glob.IsEndgame == 0)
        {
            Ret.GetPiecePosEval.Score = (PawnPieceSquare[Idx] + 0);
        }
        Else
        {
            Ret.GetPiecePosEval.Score = (PawnPieceSquareEndgame[Idx] + 0);
        }
        Stop(this script);
    }
    If (Piece == GoK_WhitePawn)
    {
        If (Glob.IsEndgame == 0)
        {
            Ret.GetPiecePosEval.Score = (0 - PawnPieceSquare[RankFlipIdx[(Idx + 0)]]);
        }
        Else
        {
            Ret.GetPiecePosEval.Score = (0 - PawnPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
        }
        Stop(this script);
    }
    If (Glob.IsEndgame == 1)
    {
        If (Piece > GoK_BlackBishop)
        {
            If (Piece == GoK_BlackKing)
            {
                If ((Glob.RootBlackPawnCount == 0) And ((Glob.RootBlackQueenCount + Glob.RootBlackNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((1.33 * KingPieceSquareEndgame[Idx]));
                    Stop(this script);
                }
                If ((Glob.RootWhitePawnCount == 0) And ((Glob.RootWhiteQueenCount + Glob.RootWhiteNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((0.67 * KingPieceSquareEndgame[Idx]));
                    Stop(this script);
                }
                Ret.GetPiecePosEval.Score = (KingPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_BlackRook)
            {
                Ret.GetPiecePosEval.Score = (RookPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Piece == GoK_BlackQueen)
            {
                Ret.GetPiecePosEval.Score = (QueenPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
        }
        If (Piece > 0)
        {
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_BlackKnight)
            {
                Ret.GetPiecePosEval.Score = (KnightPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Piece == GoK_BlackBishop)
            {
                Ret.GetPiecePosEval.Score = (BishopPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
        }
        If (Piece < GoK_WhiteBishop)
        {
            If (Piece == GoK_WhiteKing)
            {
                If ((Glob.RootWhitePawnCount == 0) And ((Glob.RootWhiteQueenCount + Glob.RootWhiteNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((1.33 * (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]])));
                    Stop(this script);
                }
                If ((Glob.RootBlackPawnCount == 0) And ((Glob.RootBlackQueenCount + Glob.RootBlackNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((0.67 * (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]])));
                    Stop(this script);
                }
                Ret.GetPiecePosEval.Score = (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_WhiteRook)
            {
                Ret.GetPiecePosEval.Score = (0 - RookPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Piece == GoK_WhiteQueen)
            {
                Ret.GetPiecePosEval.Score = (0 - QueenPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
        }
        If (Piece < 0)
        {
            If (Glob.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_WhiteBishop)
            {
                Ret.GetPiecePosEval.Score = (0 - BishopPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Piece == GoK_WhiteKnight)
            {
                Ret.GetPiecePosEval.Score = (0 - KnightPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
        }
        Stop(this script);
    }
    If (Piece > GoK_BlackBishop)
    {
        If (Piece == GoK_BlackRook)
        {
            Ret.GetPiecePosEval.Score = (RookPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackQueen)
        {
            Ret.GetPiecePosEval.Score = (QueenPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackKing)
        {
            Ret.GetPiecePosEval.Score = (KingPieceSquare[Idx] + 0);
            Stop(this script);
        }
    }
    If (Piece > 0)
    {
        If (Piece == GoK_BlackKnight)
        {
            Ret.GetPiecePosEval.Score = (KnightPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackBishop)
        {
            Ret.GetPiecePosEval.Score = (BishopPieceSquare[Idx] + 0);
            Stop(this script);
        }
    }
    If (Piece < GoK_WhiteBishop)
    {
        If (Piece == GoK_WhiteRook)
        {
            Ret.GetPiecePosEval.Score = (0 - RookPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteQueen)
        {
            Ret.GetPiecePosEval.Score = (0 - QueenPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteKing)
        {
            Ret.GetPiecePosEval.Score = (0 - KingPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
    }
    If (Piece < 0)
    {
        If (Piece == GoK_WhiteBishop)
        {
            Ret.GetPiecePosEval.Score = (0 - BishopPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteKnight)
        {
            Ret.GetPiecePosEval.Score = (0 - KnightPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
    }
}

Define GetPiecePosHash(string Piece)(string Pos) (warp=true)
{
    Ret.GetPiecePosHash.Hash = 0;
    If ((Not ((Pos > 0))) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[((64 * (PieceIdxLookup[(Piece + 0)] - 1)) + Pos)] + 0);
    }
    Else
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[(384 + ((64 * (PieceIdxLookup[abs(Piece)] - 1)) + Pos))] + 0);
    }
}

Define GetPvUci(string RootMove)(string IsWhite) (warp=true)
{
    Ret.GetPvUci.Text = "";
    Ret.GetPvUci.First = RootMove;
    Ret.GetPvUci.Ponder = Const.Null;
    GPU.Len = PV[1];
    If (GPU.Len < 1)
    {
        Call GetMoveUci(RootMove)(IsWhite);
        Ret.GetPvUci.Text = Ret.GetMoveUci.Uci;
    }
    If (Not ((GPU.Len < 1)))
    {
        GPU.Idx = 1;
        GPU.Side = IsWhite;
        Repeat (GPU.Len)
        {
            Call GetMoveUci(PVRaw[(GPU.Idx + 1)])(GPU.Side);
            If (GPU.Idx == 1)
            {
                Ret.GetPvUci.Text = Ret.GetMoveUci.Uci;
                Ret.GetPvUci.First = PVRaw[2];
            }
            If (GPU.Idx > 1)
            {
                Ret.GetPvUci.Text = Operator.Join(Ret.GetPvUci.Text, Operator.Join(" ", Ret.GetMoveUci.Uci));
            }
            If (GPU.Idx == 2)
            {
                Ret.GetPvUci.Ponder = Ret.GetMoveUci.Uci;
            }
            GPU.Side = (1 - GPU.Side);
            GPU.Idx += 1;
        }
    }
}

Define GetRepetitionCount (warp=true)
{
    Get.RC.BoardHistoryIdx = (List.Length(BoardHistory) - 2);
    Ret.GetRepetitionCount.Count = 1;
    Repeat Until (Get.RC.BoardHistoryIdx < 1)
    {
        If ((BoardHistory[Get.RC.BoardHistoryIdx] == BoardHistory[List.Length(BoardHistory)]) And (BoardHistoryMetaState[Get.RC.BoardHistoryIdx] == BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]))
        {
            Ret.GetRepetitionCount.Count += 1;
        }
        Get.RC.BoardHistoryIdx += -2;
    }
}

Define GetStaticEval(string Ply) (warp=true)
{
    If (StaticEval[Ply] == Const.Null)
    {
        Call Evaluate((Ply - 1))((1 == 1));
        Call AdjustEvalScore(Ply)(Ret.Evaluate.Score);
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.Evaluate.Score);
        Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(Const.Null)(Const.Null)(Const.TTType.None)(Const.Null)(Const.Null)(Ret.Evaluate.Score);
    }
}

Define GetSubstring(string Text)(num FromIdx)(num ToIdx) (warp=true)
{
    Get.Substring.CharIdx = FromIdx;
    Ret.GetSubstring.Substring = "";
    Repeat (((ToIdx - FromIdx) + 1))
    {
        Ret.GetSubstring.Substring = Operator.Join(Ret.GetSubstring.Substring, Operator.LetterOf(Text, Get.Substring.CharIdx));
        Get.Substring.CharIdx += 1;
    }
}

Define GetSubstringLeft(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(1)(Count);
    Ret.GetSubstringLeft.Substring = Ret.GetSubstring.Substring;
}

Define GetSubstringRight(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(((Variable.Length(Text) - Count) + 1))(Variable.Length(Text));
    Ret.GetSubstringRight.Substring = Ret.GetSubstring.Substring;
}

Define GetTargetIdx(num SourceIdx)(num DeltaX)(num DeltaY) (warp=true)
{
    Get.TI.File = (IdxToFile[SourceIdx] + DeltaX);
    Ret.GetTargetIdx.SqIdx = -1;
    If ((Get.TI.File > 0) And (Get.TI.File < 9))
    {
        Get.TI.Rank = (IdxToRank[SourceIdx] + DeltaY);
        If ((Get.TI.Rank > 0) And (Get.TI.Rank < 9))
        {
            Ret.GetTargetIdx.SqIdx = (Get.TI.File + ((Get.TI.Rank - 1) * 8));
        }
    }
}

Define GetTTNodeHash(string BoardHash)(string Ply) (warp=true)
{
    Ret.GetTTNodeHash.Hash = (PlyIsOwn[Ply] + 1);
    If (EnPassantTarget[Ply] == Const.Null)
    {
        GTTN.EnPassantIdx = 0;
    }
    Else
    {
        GTTN.EnPassantIdx = EnPassantTarget[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 67) + (GTTN.EnPassantIdx + 1));
    If (CastlingState[Ply] == Const.Null)
    {
        GTTN.Castling = 0;
    }
    Else
    {
        GTTN.Castling = CastlingState[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 11111117) + (GTTN.Castling + 1));
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 97) + BoardHash);
}

Define GivesCheckFast(string Ply) (warp=true)
{
    If (floor((AppliedMove[Ply] / 100)) == 0)
    {
        Call IsCheckedFast((Ply + 2));
        Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        GCF.FromIdx = floor((AppliedMove[Ply] / 100));
        GCF.ToIdx = floor((AppliedMove[Ply] % 100));
        If (Not ((TargetPiecesIdx[Ply] == GCF.ToIdx)))
        {
            Call IsCheckedFast((Ply + 2));
            Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            If (PlyIsOwn[Ply] == 1)
            {
                GCF.TheirKingIdx = Glob.WhiteKingIdx;
            }
            Else
            {
                GCF.TheirKingIdx = Glob.BlackKingIdx;
            }
            Ret.GivesCheckFast.GivesCheck = 0;
            If (Not ((abs(Board[GCF.ToIdx]) == GoK_BlackKing)))
            {
                Call IsReachableForAttack(Board[GCF.ToIdx])(GCF.ToIdx)(GCF.TheirKingIdx);
                GCF.IsReachable = Ret.IsReachableForAttack.IsReachable;
                Ret.GivesCheckFast.GivesCheck = GCF.IsReachable;
            }
            If (Ret.GivesCheckFast.GivesCheck == 0)
            {
                GCF.DiscoveryIdx = 1;
                Repeat (DiscoveryCount[Ply])
                {
                    If (DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + GCF.DiscoveryIdx)] == GCF.FromIdx)
                    {
                        If (Not ((abs(MoveToPathStepInc[((GCF.FromIdx * 100) + GCF.ToIdx)]) == DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + GCF.DiscoveryIdx)])))
                        {
                            Ret.GivesCheckFast.GivesCheck = 1;
                        }
                    }
                    GCF.DiscoveryIdx += 1;
                }
            }
            If (Glob.ProfilerMode == Const.ProfilerMode.Full)
            {
                GCF.IsChecked = Ret.GivesCheckFast.GivesCheck;
                Call IsCheckedFast((Ply + 2));
                Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
                If (Not ((GCF.IsChecked == Ret.GivesCheckFast.GivesCheck)))
                {
                    Call Log("CheckInfoMismatch check depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(GCF.IsChecked)(" old=")(Ret.GivesCheckFast.GivesCheck);
                    Call Log("  detail pieceAtTo=")(Board[GCF.ToIdx])(" enemyK=")(GCF.TheirKingIdx)(" ira=")(GCF.IsReachable)(" discCount=")(DiscoveryCount[Ply]);
                    Call Log("  disc1=")(DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])(" ray1=")(DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])("")("")("")("");
                    Call Log("  board=")(Board)("")("")("")("")("")("");
                }
            }
        }
    }
}

Define ImportBoard(string ImpBoard) (warp=false)
{
    Call EnterExecution;
    Call ExportBoardFEN(0);
    IB.FEN = Ret.ExportBoardFEN.FEN;
    Call ImportBoardFEN(ImpBoard);
    Call CalcBoardStats;
    If ((Glob.BlackKingIdx == Const.Null) Or (Glob.WhiteKingIdx == Const.Null))
    {
        Call SayAsync("Invalid FEN data")(5);
        Call ImportBoardFEN(IB.FEN);
        Call CalcBoardStats;
    }
    Else
    {
        Call ImportFEN(ImpBoard);
        Call CalcBoardStats;
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("Stg_FromSquareSelected");
        Event.BroadcastAndWait("Stg_ToSquareSelected");
        List.DeleteItem(BoardHistory, all);
        List.DeleteItem(BoardHistoryHash, all);
        List.DeleteItem(BoardHistoryMetaState, all);
        List.DeleteItem(BoardHistoryWasEngineMove, all);
        List.DeleteItem(GameMovesAN, all);
        Glob.FenPlyBase = 0;
        Call AddBoardToHistory("");
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        Call CalcBoardAttackedByMoveChecked(1);
        Call CalcBoardAttackedByMoveChecked(2);
        If (((Ret.ImportFEN.IsWhiteToMove == 0) And (Glob.IsPlayerBlack == 0)) Or ((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.IsPlayerBlack == 1)))
        {
            Call IsWhiteKingCheckMate;
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Call SayAsync("Checkmate!")(5);
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Call SayAsync("Draw!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
        Else
        {
            If (((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.IsPlayerBlack == 0)) Or ((Ret.ImportFEN.IsWhiteToMove == 0) And (Glob.IsPlayerBlack == 1)))
            {
                Call IsBlackKingCheckMate;
                If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
                {
                    Call SayAsync("Checkmate!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call IsDrawByStalemate(2);
                    If (Ret.IsDrawByStalemate.IsDraw == 1)
                    {
                        Call SayAsync("Draw!")(5);
                        GoK_IsGameSuspended = 1;
                    }
                }
            }
        }
    }
    Call ExitExecution;
}

Define ImportBoardFEN(string ImpBoard) (warp=false)
{
    List.DeleteAll(GoK_Board);
    IBFEN.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_Board, 0);
        IBFEN.SqIdx += 1;
    }
    IBFEN.SqIdx = 1;
    Ret.ImportBoardFEN.CharIdx = 1;
    Repeat Until (((IBFEN.SqIdx > 64) Or (IBFEN.SqIdx < 1)) Or (Ret.ImportBoardFEN.CharIdx > Variable.Length(ImpBoard)))
    {
        IBFEN.Char = Operator.LetterOf(ImpBoard, Ret.ImportBoardFEN.CharIdx);
        If ((Not ((IBFEN.Char < "A"))) And (Not ((IBFEN.Char > "Z"))))
        {
            IBFEN.Piece = 0;
            If (IBFEN.Char == "P")
            {
                IBFEN.Piece = GoK_BlackPawn;
            }
            If (IBFEN.Char == "N")
            {
                IBFEN.Piece = GoK_BlackKnight;
            }
            If (IBFEN.Char == "B")
            {
                IBFEN.Piece = GoK_BlackBishop;
            }
            If (IBFEN.Char == "R")
            {
                IBFEN.Piece = GoK_BlackRook;
            }
            If (IBFEN.Char == "Q")
            {
                IBFEN.Piece = GoK_BlackQueen;
            }
            If (IBFEN.Char == "K")
            {
                IBFEN.Piece = GoK_BlackKing;
            }
            Call IsLowerCase(IBFEN.Char);
            If (Ret.IsLowerCase.IsLower == 0)
            {
                IBFEN.Piece = (IBFEN.Piece * -1);
            }
            List.ReplaceItem(GoK_Board, IBFEN.SqIdx, IBFEN.Piece);
            IBFEN.SqIdx += 1;
        }
        Else
        {
            If ((Not ((IBFEN.Char < 0))) And (Not ((IBFEN.Char > 9))))
            {
                Repeat (IBFEN.Char)
                {
                    List.ReplaceItem(GoK_Board, IBFEN.SqIdx, 0);
                    IBFEN.SqIdx += 1;
                }
            }
            Else
            {
                If (IBFEN.Char == "/")
                {
                    Repeat Until ((IBFEN.SqIdx % 8) == 1)
                    {
                        List.ReplaceItem(GoK_Board, IBFEN.SqIdx, 0);
                        IBFEN.SqIdx += 1;
                    }
                }
            }
        }
        Ret.ImportBoardFEN.CharIdx += 1;
    }
    Call LoadInternalBoard;
}

Define ImportBoardImpl(string ImpBoard) (warp=true)
{
    IBI.SqIdx = 1;
    IBI.CharIdx = 1;
    IBI.Piece = "";
    Repeat Until (IBI.CharIdx > Variable.Length(ImpBoard))
    {
        If (Operator.LetterOf(ImpBoard, IBI.CharIdx) == ",")
        {
            List.ReplaceItem(Board, IBI.SqIdx, IBI.Piece);
            IBI.SqIdx += 1;
            IBI.Piece = "";
        }
        Else
        {
            IBI.Piece = Operator.Join(IBI.Piece, Operator.LetterOf(ImpBoard, IBI.CharIdx));
        }
        IBI.CharIdx += 1;
    }
}

Define ImportFEN(string FenText) (warp=true)
{
    Call ImportBoardFEN(FenText);
    IFEN.CharIdx = Ret.ImportBoardFEN.CharIdx;
    IFEN.Side = "";
    IFEN.Castling = "";
    IFEN.EP = "";
    IFEN.Half = "";
    IFEN.Full = "";
    IFEN.Token = 0;
    Repeat (((Variable.Length(FenText) - IFEN.CharIdx) + 1))
    {
        IFEN.Char = Operator.LetterOf(FenText, IFEN.CharIdx);
        If (IFEN.Char == " ")
        {
            IFEN.Token += 1;
        }
        Else
        {
            If (IFEN.Token == 1)
            {
                IFEN.Side = Operator.Join(IFEN.Side, IFEN.Char);
            }
            If (IFEN.Token == 2)
            {
                IFEN.Castling = Operator.Join(IFEN.Castling, IFEN.Char);
            }
            If (IFEN.Token == 3)
            {
                IFEN.EP = Operator.Join(IFEN.EP, IFEN.Char);
            }
            If (IFEN.Token == 4)
            {
                IFEN.Half = Operator.Join(IFEN.Half, IFEN.Char);
            }
            If (IFEN.Token == 5)
            {
                If ((Not ((IFEN.Char < 0))) And (Not ((IFEN.Char > 9))))
                {
                    IFEN.Full = Operator.Join(IFEN.Full, IFEN.Char);
                }
            }
        }
        IFEN.CharIdx += 1;
    }
    Ret.ImportFEN.IsWhiteToMove = 0;
    If (IFEN.Side == "w")
    {
        Ret.ImportFEN.IsWhiteToMove = 1;
    }
    Glob.FenBlackToMove = (1 - Ret.ImportFEN.IsWhiteToMove);
    Glob.FenFullMove = 1;
    If (Variable.Length(IFEN.Full) > 0)
    {
        Glob.FenFullMove = (IFEN.Full + 0);
    }
    Glob.FenPlyBase = List.Length(GameMovesAN);
    If (Variable.Length(IFEN.Castling) > 0)
    {
        IFEN.CanOwnCastleKingside = 0;
        IFEN.CanOwnCastleQueenside = 0;
        IFEN.CanOppCastleKingside = 0;
        IFEN.CanOppCastleQueenside = 0;
        IFEN.CastlingCharIdx = 1;
        Repeat Until ((IFEN.CastlingCharIdx > Variable.Length(IFEN.Castling)) Or (Operator.LetterOf(IFEN.Castling, IFEN.CastlingCharIdx) == " "))
        {
            If (Operator.LetterOf(IFEN.Castling, IFEN.CastlingCharIdx) == "K")
            {
                Call IsLowerCase(Operator.LetterOf(IFEN.Castling, IFEN.CastlingCharIdx));
                If (Ret.IsLowerCase.IsLower == 0)
                {
                    If (Glob.IsPlayerBlack == 1)
                    {
                        IFEN.CanOwnCastleKingside = 1;
                    }
                    Else
                    {
                        IFEN.CanOppCastleKingside = 1;
                    }
                }
                Else
                {
                    If (Glob.IsPlayerBlack == 1)
                    {
                        IFEN.CanOppCastleKingside = 1;
                    }
                    Else
                    {
                        IFEN.CanOwnCastleKingside = 1;
                    }
                }
            }
            If (Operator.LetterOf(IFEN.Castling, IFEN.CastlingCharIdx) == "Q")
            {
                Call IsLowerCase(Operator.LetterOf(IFEN.Castling, IFEN.CastlingCharIdx));
                If (Ret.IsLowerCase.IsLower == 0)
                {
                    If (Glob.IsPlayerBlack == 1)
                    {
                        IFEN.CanOwnCastleQueenside = 1;
                    }
                    Else
                    {
                        IFEN.CanOppCastleQueenside = 1;
                    }
                }
                Else
                {
                    If (Glob.IsPlayerBlack == 1)
                    {
                        IFEN.CanOppCastleQueenside = 1;
                    }
                    Else
                    {
                        IFEN.CanOwnCastleQueenside = 1;
                    }
                }
            }
            IFEN.CastlingCharIdx += 1;
        }
        Glob.HasWhiteRookKSMoved = 0;
        Glob.HasWhiteRookQSMoved = 0;
        Glob.HasWhiteKingMoved = 0;
        Glob.HasWhiteCastled = 0;
        Glob.HasBlackRookKSMoved = 0;
        Glob.HasBlackRookQSMoved = 0;
        Glob.HasBlackKingMoved = 0;
        Glob.HasBlackCastled = 0;
        If (Not ((IFEN.CanOwnCastleQueenside == 1)))
        {
            Glob.HasBlackRookQSMoved = 1;
        }
        If (Not (((IFEN.CanOwnCastleQueenside == 1) Or (IFEN.CanOwnCastleKingside == 1))))
        {
            Glob.HasBlackKingMoved = 1;
            Glob.HasBlackCastled = 1;
        }
        If (Not ((IFEN.CanOwnCastleKingside == 1)))
        {
            Glob.HasBlackRookKSMoved = 1;
        }
        If (Not ((IFEN.CanOppCastleQueenside == 1)))
        {
            Glob.HasWhiteRookQSMoved = 1;
        }
        If (Not (((IFEN.CanOppCastleQueenside == 1) Or (IFEN.CanOppCastleKingside == 1))))
        {
            Glob.HasWhiteKingMoved = 1;
            Glob.HasWhiteCastled = 1;
        }
        If (Not ((IFEN.CanOppCastleKingside == 1)))
        {
            Glob.HasWhiteRookKSMoved = 1;
        }
    }
    Else
    {
        Glob.HasWhiteKingMoved = 0;
        Glob.HasBlackKingMoved = 0;
        Glob.HasWhiteCastled = 0;
        Glob.HasBlackCastled = 0;
        Glob.HasWhiteRookKSMoved = 0;
        Glob.HasWhiteRookQSMoved = 0;
        Glob.HasBlackRookKSMoved = 0;
        Glob.HasBlackRookQSMoved = 0;
        If (Not ((Board[1] == GoK_BlackRook)))
        {
            Glob.HasBlackRookQSMoved = 1;
        }
        If (Not ((Board[5] == GoK_BlackKing)))
        {
            Glob.HasBlackKingMoved = 1;
        }
        If (Not ((Board[8] == GoK_BlackRook)))
        {
            Glob.HasBlackRookKSMoved = 1;
        }
        If (Not ((Board[57] == GoK_WhiteRook)))
        {
            Glob.HasWhiteRookQSMoved = 1;
        }
        If (Not ((Board[61] == GoK_WhiteKing)))
        {
            Glob.HasWhiteKingMoved = 1;
        }
        If (Not ((Board[64] == GoK_WhiteRook)))
        {
            Glob.HasWhiteRookKSMoved = 1;
        }
    }
    List.ReplaceItem(EnPassantTarget, 1, Const.Null);
    IFEN.EnPassantFile = 0;
    If (Operator.LetterOf(IFEN.EP, 1) == "a")
    {
        IFEN.EnPassantFile = 1;
    }
    If (Operator.LetterOf(IFEN.EP, 1) == "b")
    {
        IFEN.EnPassantFile = 2;
    }
    If (Operator.LetterOf(IFEN.EP, 1) == "c")
    {
        IFEN.EnPassantFile = 3;
    }
    If (Operator.LetterOf(IFEN.EP, 1) == "d")
    {
        IFEN.EnPassantFile = 4;
    }
    If (Operator.LetterOf(IFEN.EP, 1) == "e")
    {
        IFEN.EnPassantFile = 5;
    }
    If (Operator.LetterOf(IFEN.EP, 1) == "f")
    {
        IFEN.EnPassantFile = 6;
    }
    If (Operator.LetterOf(IFEN.EP, 1) == "g")
    {
        IFEN.EnPassantFile = 7;
    }
    If (Operator.LetterOf(IFEN.EP, 1) == "h")
    {
        IFEN.EnPassantFile = 8;
    }
    If (IFEN.EnPassantFile > 0)
    {
        If (((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.IsPlayerBlack == 1)) Or ((Not ((Ret.ImportFEN.IsWhiteToMove == 1))) And (Not ((Glob.IsPlayerBlack == 1)))))
        {
            List.ReplaceItem(EnPassantTarget, 1, (32 + IFEN.EnPassantFile));
        }
        Else
        {
            List.ReplaceItem(EnPassantTarget, 1, (24 + IFEN.EnPassantFile));
        }
    }
    List.DeleteAll(GameMoves);
    If (Not ((EnPassantTarget[1] == Const.Null)))
    {
        IFEN.SynthTargetIdx = EnPassantTarget[1];
        If (Board[IFEN.SynthTargetIdx] > 0)
        {
            IFEN.SynthSourceIdx = (IFEN.SynthTargetIdx - 16);
        }
        Else
        {
            IFEN.SynthSourceIdx = (IFEN.SynthTargetIdx + 16);
        }
        List.DeleteAll(GameMoves);
        List.Add(GameMoves, ((IFEN.SynthSourceIdx * 100) + IFEN.SynthTargetIdx));
    }
    List.DeleteAll(BoardHistoryFiftyMoves);
    IFEN.HalfCount = 0;
    Repeat (IFEN.Half)
    {
        IFEN.HalfCount += 1;
        List.Add(BoardHistoryFiftyMoves, IFEN.HalfCount);
    }
}

Define InitBoard (warp=true)
{
    Const.ProfileTime.EvaluateBaseIdx = 0;
    Const.ProfileTime.MoveGenBaseIdx = 192;
    Const.ProfileTime.MoveGenImplBaseIdx = 128;
    Const.ProfileTime.PickMoveBaseIdx = 512;
    Const.SnapshotPlyStride = 100;
    Const.CheckInfoPlyStride = 8;
    Glob.PV = "";
    Stg_FromSquareIdx = -1;
    Stg_ToSquareIdx = -1;
    Glob.DebugMode = 0;
    If (GoK_ClockActive == 0)
    {
        Glob.TimeControl = 0;
    }
    Glob.CurrentClockTime = Glob.InitialClockTime;
    Glob.ClockMoveCount = 0;
    Glob.PlayerClockTime = Glob.InitialClockTime;
    Glob.PlayerClockMoveCount = 0;
    Glob.PlayerClockRunning = 0;
    Glob.IsTimeModelLogged = 0;
    Glob.PrevMoveEval = Const.Null;
    Glob.AvgCompletedDepth = Const.Null;
    Glob.MoveFromIdx = -1;
    Glob.MoveToIdx = -1;
    GoK_ProgressValue = 0;
    GoK_EvaluationValue = 0;
    Glob.IsAdvisorEnabled = 1;
    Glob.IsInUndo = 0;
    Glob.IsEndgame = 0;
    Glob.IsLateEndgame = 0;
    GoK_BlackKingsideCastling = 65;
    GoK_WhiteKingsideCastling = 67;
    GoK_BlackQueensideCastling = 66;
    GoK_WhiteQueensideCastling = 68;
    Glob.HasBlackCastled = 0;
    Glob.HasWhiteKingMoved = 0;
    Glob.HasWhiteCastled = 0;
    Glob.HasBlackKingMoved = 0;
    Glob.HasWhiteRookKSMoved = 0;
    Glob.HasWhiteRookQSMoved = 0;
    Glob.HasBlackRookKSMoved = 0;
    Glob.HasBlackRookQSMoved = 0;
    List.DeleteAll(GameMoves);
    GoK_IsGameSuspended = 0;
    Glob.PrevProgressUpdate = 0;
    GoK_Empty = 0;
    GoK_WhiteKing = -50000;
    GoK_WhiteQueen = -936;
    GoK_WhiteRook = -512;
    GoK_WhiteBishop = -297;
    GoK_WhiteKnight = -281;
    GoK_WhitePawn = -114;
    GoK_BlackKing = 50000;
    GoK_BlackQueen = 936;
    GoK_BlackRook = 512;
    GoK_BlackBishop = 297;
    GoK_BlackKnight = 281;
    GoK_BlackPawn = 114;
    Const.AbsMinCheckmateEval = (GoK_BlackKing - 10000);
    Const.AbsMaxCheckmateEval = 100000;
    Const.DrawByRepetitionEval = 0;
    Const.Null = 999999999;
    Const.PawnAdvance.WhiteRear = 0;
    Const.PawnAdvance.WhiteFront = 8;
    Const.PawnAdvance.BlackRear = 16;
    Const.PawnAdvance.BlackFront = 24;
    Const.TTNodeCol.HashIdx = 0;
    Const.TTNodeCol.MetaIdx = 1;
    Const.TTNodeCol.BestMoveIdx = 2;
    Const.TTNodeCol.ScoreIdx = 3;
    Const.TTNodeCol.StaticEvalIdx = 4;
    Const.TTNodeEntrySize = 5;
    Const.PickPhase.Done = 0;
    Const.TTType.None = 1;
    Const.TTType.HighBound = 2;
    Const.TTType.LowBound = 3;
    Const.TTType.Exact = 4;
    Const.MaxPlyStackFrames = 60;
    Const.Profile.TTNodeProbe = 0;
    Const.Profile.TTNodeHit = 64;
    Const.Profile.RazoringCalls = 128;
    Const.Profile.RazoringTries = 192;
    Const.Profile.RazoringHits = 256;
    Const.Profile.RFPCalls = 320;
    Const.Profile.RFPHits = 384;
    Const.Profile.NMPCalls = 448;
    Const.Profile.NMPTries = 512;
    Const.Profile.NMPHits = 576;
    Const.Profile.FutilityCalls = 640;
    Const.Profile.FutilityHits = 704;
    Const.Profile.DeltaCalls = 768;
    Const.Profile.DeltaHits = 832;
    Const.Profile.QSEECalls = 896;
    Const.Profile.QSEEHits = 960;
    Const.Profile.LMRCalls = 1024;
    Const.Profile.LMRHits = 1088;
    Const.Profile.PVSCalls = 1152;
    Const.Profile.PVSReSearches = 1216;
    Const.Profile.FullCalls = 1280;
    Const.Profile.Ext = 1344;
    Const.Profile.TTStaticProbe = 1472;
    Const.Profile.TTStaticHit = 1536;
    Const.Profile.TTMoveProbe = 1600;
    Const.Profile.TTMoveHit = 1664;
    Const.MaxMovesPerGeneration = 300;
    Call InitCoordLookup;
    Call FillBoard;
    List.DeleteAll(PieceIdxLookup);
    Init.Board.Idx = 1;
    Repeat (GoK_BlackKing)
    {
        List.Add(PieceIdxLookup, 0);
        Init.Board.Idx += 1;
    }
    List.ReplaceItem(PieceIdxLookup, GoK_BlackPawn, 1);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackKnight, 2);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackBishop, 3);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackRook, 4);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackQueen, 5);
    List.ReplaceItem(PieceIdxLookup, GoK_BlackKing, 6);
    Const.CharsUpperCase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    List.DeleteItem(CharsUpperCaseList, all);
    Init.Board.Idx = 1;
    Repeat (List.Length(CharsUpperCaseList))
    {
        List.Add(CharsUpperCaseList, Operator.LetterOf(Const.CharsUpperCase, Init.Board.Idx));
        Init.Board.Idx += 1;
    }
    List.DeleteItem(KillerMoves, all);
    Repeat ((2 * Const.MaxPlyStackFrames))
    {
        List.Add(KillerMoves, Const.Null);
    }
    List.DeleteAll(PinSq);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(PinSq, 0);
    }
    List.DeleteAll(PinRay);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(PinRay, 0);
    }
    List.DeleteAll(PinCount);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(PinCount, 0);
    }
