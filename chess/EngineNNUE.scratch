WhenBroadcastReceived(UI_ExportClicked)
{
    If (Glob.Game.IsExecutionRunning == 0)
    {
        Call ExportBoardFEN(0);
        Exp.FENLichess = Ret.ExportBoardFEN.FENLichess;
        Exp.FEN = Ret.ExportBoardFEN.FEN;
        List.DeleteItem(ExportData, all);
        List.Add(ExportData, "DATA EXPORT");
        List.Add(ExportData, "Select data row by triple-clicking. You can then copy to");
        List.Add(ExportData, "clipboard by right-click / Copy or by pressing Ctrl-C.");
        List.Add(ExportData, "");
        List.Add(ExportData, "PGN (Game Protocol):");
        Call ExportMovesPGN;
        List.Add(ExportData, Ret.ExportMovesPGN.PGN);
        List.Add(ExportData, "");
        List.Add(ExportData, "FEN (Current Board):");
        List.Add(ExportData, Exp.FEN);
        List.Add(ExportData, "");
        List.Add(ExportData, "Board Analysis Link (lichess.org)");
        List.Add(ExportData, Exp.FENLichess);
        List.Show(ExportData);
    }
}

WhenBroadcastReceived(UI_ImportClicked)
{
    If (Glob.Game.IsExecutionRunning == 0)
    {
        Sensing.Ask("Board data import. Please paste FEN data from your clipboard into the text field by pressing Ctrl-V.");
        If (Variable.Length(Sensing.Answer()) > 0)
        {
            Call ImportBoard(Sensing.Answer());
        }
    }
}

WhenBroadcastReceived(UI_UndoClicked)
{
    If (Glob.Game.IsExecutionRunning == 0)
    {
        Call UndoMove;
        GoK_EvaluationValue = 0;
        Event.Broadcast("GoK_EvaluationValueChanged");
        Looks.Say("");
    }
}


//----- Custom blocks -------------------------------------------------------------------------------------------------

Define $gok_prepare (warp=true)
{
    List.ReplaceItem(EnPassantTarget, 1, Const.Null);
    Glob.Config.Level = 6;
    GoK_Level = 6;
    $gok_prepare.TargetIsPlayerBlack = 0;
    If Operator.Contains(_dci fen, " w")
    {
        $gok_prepare.TargetIsPlayerBlack = 1;
    }
    If (Not (($gok_prepare.TargetIsPlayerBlack == Glob.Game.IsPlayerBlack)))
    {
        Glob.Game.IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        GoK_IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        Glob.Game.ExecutionPly = 0;
        Glob.Game.IsExecutionRunning = 0;
        Glob.Config.Level = 6;
        GoK_Level = 6;
        $gok_prepare.SavedClockTime = Glob.Clock.CurrentTime;
        $gok_prepare.SavedClockMoveCount = Glob.Clock.MoveCount;
        $gok_prepare.SavedTimeModelLogged = Glob.Config.IsTimeModelLogged;
        Call InitBoard;
        Glob.Clock.CurrentTime = $gok_prepare.SavedClockTime;
        Glob.Clock.MoveCount = $gok_prepare.SavedClockMoveCount;
        Glob.Config.IsTimeModelLogged = $gok_prepare.SavedTimeModelLogged;
        Call InitBoardPhase2;
        Call ​​warn​​("$gok_reinit");
    }
    Call ImportFEN(_dci fen);
    Call CalcBoardStats;
    If (_dci think time == "Infinity")
    {
        Glob.Config.CustomThinkTime = 100000;
        Glob.Config.CustomMaxDepth = _dci max depth;
    }
    Else
    {
        If (_dci think time > 0)
        {
            Glob.Config.CustomThinkTime = _dci think time;
        }
        Else
        {
            Glob.Config.CustomThinkTime = 1;
        }
        Glob.Config.CustomMaxDepth = 0;
    }
    Glob.Clock.InitialTime = 0;
    Glob.Clock.TimeInc = 0;
    Glob.Clock.StageMoves = 0;
    Glob.Clock.StageTime = 0;
    If ((Glob.Config.CustomMaxDepth == 0) And (Not ((_dci clock time == ""))))
    {
        $gok_prepare.ClockSlashIdx = 0;
        $gok_prepare.ClockPlusIdx = 0;
        $gok_prepare.ClockCharIdx = 1;
        Repeat (Variable.Length(_dci clock time))
        {
            If (Operator.LetterOf(_dci clock time, $gok_prepare.ClockCharIdx) == "/")
            {
                $gok_prepare.ClockSlashIdx = $gok_prepare.ClockCharIdx;
            }
            If (Operator.LetterOf(_dci clock time, $gok_prepare.ClockCharIdx) == "+")
            {
                $gok_prepare.ClockPlusIdx = $gok_prepare.ClockCharIdx;
            }
            $gok_prepare.ClockCharIdx += 1;
        }
        If ($gok_prepare.ClockSlashIdx > 0)
        {
            $gok_prepare.ClockPart = "";
            $gok_prepare.ClockCharIdx = 1;
            Repeat (($gok_prepare.ClockSlashIdx - 1))
            {
                $gok_prepare.ClockPart = Operator.Join($gok_prepare.ClockPart, Operator.LetterOf(_dci clock time, $gok_prepare.ClockCharIdx));
                $gok_prepare.ClockCharIdx += 1;
            }
            If (Not (($gok_prepare.ClockPart == "")))
            {
                Glob.Clock.InitialTime = $gok_prepare.ClockPart;
            }
            If ($gok_prepare.ClockPlusIdx > $gok_prepare.ClockSlashIdx)
            {
                $gok_prepare.ClockPart = "";
                $gok_prepare.ClockCharIdx = ($gok_prepare.ClockSlashIdx + 1);
                Repeat ((($gok_prepare.ClockPlusIdx - $gok_prepare.ClockSlashIdx) - 1))
                {
                    $gok_prepare.ClockPart = Operator.Join($gok_prepare.ClockPart, Operator.LetterOf(_dci clock time, $gok_prepare.ClockCharIdx));
                    $gok_prepare.ClockCharIdx += 1;
                }
                If ($gok_prepare.ClockPart == "")
                {
                    Glob.Clock.StageMoves = 0;
                }
                Else
                {
                    Glob.Clock.StageMoves = $gok_prepare.ClockPart;
                }
                $gok_prepare.ClockPart = "";
                $gok_prepare.ClockCharIdx = ($gok_prepare.ClockPlusIdx + 1);
                Repeat ((Variable.Length(_dci clock time) - $gok_prepare.ClockPlusIdx))
                {
                    $gok_prepare.ClockPart = Operator.Join($gok_prepare.ClockPart, Operator.LetterOf(_dci clock time, $gok_prepare.ClockCharIdx));
                    $gok_prepare.ClockCharIdx += 1;
                }
                If ($gok_prepare.ClockPart == "")
                {
                    Glob.Clock.StageTime = 0;
                }
                Else
                {
                    Glob.Clock.StageTime = $gok_prepare.ClockPart;
                }
            }
            Else
            {
                $gok_prepare.ClockPart = "";
                $gok_prepare.ClockCharIdx = ($gok_prepare.ClockSlashIdx + 1);
                Repeat ((Variable.Length(_dci clock time) - $gok_prepare.ClockSlashIdx))
                {
                    $gok_prepare.ClockPart = Operator.Join($gok_prepare.ClockPart, Operator.LetterOf(_dci clock time, $gok_prepare.ClockCharIdx));
                    $gok_prepare.ClockCharIdx += 1;
                }
                If (Not (($gok_prepare.ClockPart == "")))
                {
                    Glob.Clock.TimeInc = $gok_prepare.ClockPart;
                }
            }
        }
        $gok_prepare.ClockValid = 1;
        If (Not ((Glob.Clock.InitialTime == (Glob.Clock.InitialTime + 0))))
        {
            $gok_prepare.ClockValid = 0;
        }
        If (Glob.Clock.InitialTime < 0)
        {
            $gok_prepare.ClockValid = 0;
        }
        If (Not ((Glob.Clock.TimeInc == (Glob.Clock.TimeInc + 0))))
        {
            $gok_prepare.ClockValid = 0;
        }
        If (Glob.Clock.TimeInc < 0)
        {
            $gok_prepare.ClockValid = 0;
        }
        If (Not ((Glob.Clock.StageMoves == (Glob.Clock.StageMoves + 0))))
        {
            $gok_prepare.ClockValid = 0;
        }
        If (Glob.Clock.StageMoves < 0)
        {
            $gok_prepare.ClockValid = 0;
        }
        If (Not ((Glob.Clock.StageTime == (Glob.Clock.StageTime + 0))))
        {
            $gok_prepare.ClockValid = 0;
        }
        If (Glob.Clock.StageTime < 0)
        {
            $gok_prepare.ClockValid = 0;
        }
        If ($gok_prepare.ClockValid == 0)
        {
            Glob.Clock.InitialTime = 0;
            Glob.Clock.TimeInc = 0;
            Glob.Clock.StageMoves = 0;
            Glob.Clock.StageTime = 0;
            Call Log("DCI clock invalid, no clock set : ")(_dci clock time)("")("")("")("")("")("");
        }
    }
    If (Glob.Clock.CurrentTime == Const.Null)
    {
        Glob.Clock.CurrentTime = Glob.Clock.InitialTime;
        Glob.Clock.MoveCount = 0;
    }
    List.DeleteAll(GameMoves);
    If ((Not ((EnPassantTarget[1] == Const.Null))) And (EnPassantTarget[1] > 0))
    {
        If (Board[EnPassantTarget[1]] > 0)
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] - 16) * 100) + EnPassantTarget[1]));
        }
        Else
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] + 16) * 100) + EnPassantTarget[1]));
        }
    }
}

Define //(string Comment) (warp=true)
{
}

Define AddBoardToHistory(string WasEngineMove) (warp=true)
{
    Call GetBoardString;
    List.Add(BoardHistory, Ret.GetBoardString.BoardString);
    Call CreateCurrentBoardHash;
    List.Add(BoardHistoryHash, Glob.Board.CurrentHash);
    If ((Glob.Board.HasBlackCastled == 1) Or ((Glob.Board.HasBlackKingMoved == 1) Or ((Glob.Board.HasBlackRookKSMoved == 1) And (Glob.Board.HasBlackRookQSMoved == 1))))
    {
        Glob.Board.HasBlackCastled = 1;
        Glob.Board.HasBlackKingMoved = 1;
        Glob.Board.HasBlackRookKSMoved = 1;
        Glob.Board.HasBlackRookQSMoved = 1;
    }
    If ((Glob.Board.HasWhiteCastled == 1) Or ((Glob.Board.HasWhiteKingMoved == 1) Or ((Glob.Board.HasWhiteRookKSMoved == 1) And (Glob.Board.HasWhiteRookQSMoved == 1))))
    {
        Glob.Board.HasWhiteCastled = 1;
        Glob.Board.HasWhiteKingMoved = 1;
        Glob.Board.HasWhiteRookKSMoved = 1;
        Glob.Board.HasWhiteRookQSMoved = 1;
    }
    List.Add(BoardHistoryMetaState, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
    List.Add(BoardHistoryWasEngineMove, WasEngineMove);
}

Define AddLookupMove(string SourceIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool LookupMoveTypeKing)(bool QuietsOnly)(bool QuietChecks) (warp=true)
{
    AddLookupMove.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddLookupMove.Idx = (MoveSourceIdxToListOffsetNonSliding[(SourceIdx + 0)] + 0);
    AddLookupMove.Count = 1;
    Repeat (8)
    {
        If LookupMoveTypeKing
        {
            AddLookupMove.TargetIdx = (MoveListOffsetToTargetIdxKing[(AddLookupMove.Idx + AddLookupMove.Count)] + 0);
        }
        Else
        {
            AddLookupMove.TargetIdx = (MoveListOffsetToTargetIdxKnight[(AddLookupMove.Idx + AddLookupMove.Count)] + 0);
        }
        If (AddLookupMove.TargetIdx == -1)
        {
            Stop(this script);
        }
        If CalcAttackState
        {
            Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
        }
        Else
        {
            If (Board[AddLookupMove.TargetIdx] == 0)
            {
                If CapturesOnly
                {
                    If LookupMoveTypeKing
                    {
                        If (CheckedState[Ply] == 1)
                        {
                            Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                        }
                        Else
                        {
                            Call AddPotentialQMove(SourceIdx)(AddLookupMove.TargetIdx)(AddLookupMove.SourcePiece)(Ply)(QuietChecks);
                        }
                    }
                    Else
                    {
                        Call AddPotentialQMove(SourceIdx)(AddLookupMove.TargetIdx)(AddLookupMove.SourcePiece)(Ply)(QuietChecks);
                    }
                }
                Else
                {
                    Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                }
            }
            Else
            {
                If (Not (QuietsOnly))
                {
                    If (AddLookupMove.SourcePiece > 0)
                    {
                        If (Board[AddLookupMove.TargetIdx] < 0)
                        {
                            Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                        }
                    }
                    Else
                    {
                        If (Board[AddLookupMove.TargetIdx] > 0)
                        {
                            Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                        }
                    }
                }
            }
        }
        AddLookupMove.Count += 1;
    }
}

Define AddMoveImpl(string SourceIdx)(string TargetIdx)(string Ply)(bool AttackTableOnly)(bool Quiescence) (warp=true)
{
    If AttackTableOnly
    {
        AddMoveImpl.SourcePiece = (Board[(SourceIdx + 0)] + 0);
        If (AddMoveImpl.SourcePiece > 0)
        {
            AddMoveImpl.AttackCount = (BoardAttackedByBlack[(TargetIdx + 0)] + 0);
            If (AddMoveImpl.AttackCount < 9)
            {
                List.ReplaceItem(BoardAttackedByBlack, (TargetIdx + 0), (AddMoveImpl.AttackCount + 1));
            }
            If (((BoardAttackedByBlackPiece[(TargetIdx + 0)] + 0) == 0) Or ((Board[BoardAttackedByBlackPiece[(TargetIdx + 0)]] + 0) > (AddMoveImpl.SourcePiece + 0)))
            {
                List.ReplaceItem(BoardAttackedByBlackPiece, (TargetIdx + 0), SourceIdx);
            }
            If ((Board[(TargetIdx + 0)] + 0) == (GoK_WhiteKing + 0))
            {
                Glob.Board.IsWhiteChecked = 1;
            }
        }
        Else
        {
            AddMoveImpl.AttackCount = (BoardAttackedByWhite[(TargetIdx + 0)] + 0);
            If (AddMoveImpl.AttackCount < 9)
            {
                List.ReplaceItem(BoardAttackedByWhite, (TargetIdx + 0), (AddMoveImpl.AttackCount + 1));
            }
            If (((BoardAttackedByWhitePiece[(TargetIdx + 0)] + 0) == 0) Or ((Board[BoardAttackedByWhitePiece[(TargetIdx + 0)]] + 0) < (AddMoveImpl.SourcePiece + 0)))
            {
                List.ReplaceItem(BoardAttackedByWhitePiece, (TargetIdx + 0), SourceIdx);
            }
            If ((Board[(TargetIdx + 0)] + 0) == (GoK_BlackKing + 0))
            {
                Glob.Board.IsBlackChecked = 1;
            }
        }
        Stop(this script);
    }
    If ((CheckedState[Ply] + 0) == 1)
    {
        If (Not (((BoardAttackedEvasionTarget[(TargetIdx + 0)] + 0) == 1)))
        {
            If (Not ((abs(Board[(SourceIdx + 0)]) == (GoK_BlackKing + 0))))
            {
                If ((EnPassantTarget[Ply] + 0) == (Const.Null + 0))
                {
                    Stop(this script);
                }
            }
        }
    }
    AddMoveImpl.Move = ((SourceIdx * 100) + TargetIdx);
    If (abs(Board[(SourceIdx + 0)]) == (GoK_BlackPawn + 0))
    {
        If (((IdxToRank[(TargetIdx + 0)] + 0) == 1) Or ((IdxToRank[(TargetIdx + 0)] + 0) == 8))
        {
            Call AddSpecialMove((AddMoveImpl.Move + 0.1))(Ply);
            If (Not (Quiescence))
            {
                Call AddSpecialMove((AddMoveImpl.Move + 0.2))(Ply);
                Call AddSpecialMove((AddMoveImpl.Move + 0.3))(Ply);
                Call AddSpecialMove((AddMoveImpl.Move + 0.4))(Ply);
            }
            Stop(this script);
        }
    }
    Else
    {
        If (Glob.Eval.IsClassicEndgame == 1)
        {
            If (Not (Quiescence))
            {
                If ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + TargetIdx)] + 0) == 0)
                {
                    List.ReplaceItem(PieceMobility, (SourceIdx + 0), (PieceMobility[(SourceIdx + 0)] + 1));
                }
            }
        }
    }
    List.Add(CalcMovesMoveList, AddMoveImpl.Move);
    Call GetMoveScore(Board[(SourceIdx + 0)])(Board[(TargetIdx + 0)])(SourceIdx)(TargetIdx)(AddMoveImpl.Move)(Ply);
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddMoveImplLookup(string SourceIdx)(string TargetIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool IsKing) (warp=true)
{
    If IsKing
    {
        If (Not (CalcAttackState))
        {
            If ((BoardAttackedCalculated[Ply] == 1) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + TargetIdx)] > 0))
            {
                Stop(this script);
            }
            If (PlyIsOwn[Ply] == 1)
            {
                AddMoveImplLookup.KingIdx = Glob.Board.WhiteKingIdx;
            }
            Else
            {
                AddMoveImplLookup.KingIdx = Glob.Board.BlackKingIdx;
            }
            If (ChebyshevDistance[((AddMoveImplLookup.KingIdx * 100) + TargetIdx)] < 2)
            {
                Stop(this script);
            }
        }
    }
    Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)(CalcAttackState)(CapturesOnly);
}

Define AddMoveToList(string Move)(string Ply)(string MoveScore) (warp=true)
{
    List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), Move);
    List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), MoveScore);
    List.ReplaceItem(MovesCount, Ply, (MovesCount[Ply] + 1));
    If (Ply < 3)
    {
        If (Ply == 1)
        {
            List.Add(Moves1, Move);
        }
        Else
        {
            If (Ply == 2)
            {
                List.Add(Moves2, Move);
            }
        }
    }
}

Define AddPotentialQMove(string SourceIdx)(string TargetIdx)(string Piece)(string Ply)(bool QuietChecks) (warp=true)
{
    Call //("Allow check evasions and - up to a limit - also checks during quiescence search");
    If (CheckedState[Ply] == 1)
    {
        If (abs(Piece) == GoK_BlackKing)
        {
            If ((BoardAttackedCalculated[Ply] == 1) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + TargetIdx)] > 0))
            {
                Stop(this script);
            }
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        }
        Else
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        }
        Stop(this script);
    }
    If (Piece == GoK_BlackPawn)
    {
        If (IdxToRank[TargetIdx] == 8)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
            Stop(this script);
        }
    }
    If (Piece == GoK_WhitePawn)
    {
        If (IdxToRank[TargetIdx] == 1)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
            Stop(this script);
        }
    }
    If (Not (QuietChecks))
    {
        Stop(this script);
    }
    AddPotentialQMove.TargetPiece = Board[TargetIdx];
    List.ReplaceItem(Board, TargetIdx, Board[SourceIdx]);
    List.ReplaceItem(Board, SourceIdx, 0);
    Call IsCheckingPieceDiscovery(SourceIdx)(TargetIdx)(Ply);
    List.ReplaceItem(Board, SourceIdx, Board[TargetIdx]);
    List.ReplaceItem(Board, TargetIdx, AddPotentialQMove.TargetPiece);
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        Stop(this script);
    }
    If (abs(Piece) == GoK_BlackKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.Board.WhiteKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.Board.BlackKingIdx);
    }
    If (Ret.IsReachableForAttack.IsReachable == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
    }
}

Define AddSlidingMove(string SourceIdx)(string Ply)(bool AttackTableOnly)(bool Quiescence)(bool SlidingStraight)(bool QuietsOnly)(bool QuietChecks) (warp=true)
{
    If AttackTableOnly
    {
        Call AddSlidingMoveForAT(SourceIdx)(Ply)(SlidingStraight);
    }
    Else
    {
        Call AddSlidingMoveRays(SourceIdx)(Ply)(Quiescence)(SlidingStraight)(QuietsOnly)(QuietChecks);
    }
}

Define AddSlidingMoveForAT(string SourceIdx)(string Ply)(bool SlidingStraight) (warp=true)
{
    AddSlidingMoveForAT.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddSlidingMoveForAT.RaySlot = 1;
    AddSlidingMoveForAT.RayOffset = (MoveSourceIdxToListOffsetSliding[(SourceIdx + 0)] + 0);
    AddSlidingMoveForAT.RaySqLeft = 8;
    Repeat Until (AddSlidingMoveForAT.RaySlot > 32)
    {
        If SlidingStraight
        {
            AddSlidingMoveForAT.TargetIdx = (MoveSlidingStraightListIdxToTargetIdx[(AddSlidingMoveForAT.RayOffset + AddSlidingMoveForAT.RaySlot)] + 0);
        }
        Else
        {
            AddSlidingMoveForAT.TargetIdx = (MoveCrossListIdxToTargetIdx[(AddSlidingMoveForAT.RayOffset + AddSlidingMoveForAT.RaySlot)] + 0);
        }
        If (AddSlidingMoveForAT.TargetIdx == -1)
        {
            AddSlidingMoveForAT.RaySlot += AddSlidingMoveForAT.RaySqLeft;
            AddSlidingMoveForAT.RaySqLeft = 8;
        }
        Else
        {
            AddSlidingMoveForAT.TargetPiece = (Board[(AddSlidingMoveForAT.TargetIdx + 0)] + 0);
            If (AddSlidingMoveForAT.TargetPiece == 0)
            {
                Call AddMoveImpl(SourceIdx)(AddSlidingMoveForAT.TargetIdx)(Ply)((1 == 1))((1 == 0));
                AddSlidingMoveForAT.RaySlot += 1;
                AddSlidingMoveForAT.RaySqLeft += -1;
            }
            Else
            {
                Call AddMoveImpl(SourceIdx)(AddSlidingMoveForAT.TargetIdx)(Ply)((1 == 1))((1 == 0));
                AddSlidingMoveForAT.IsXRay = 0;
                If (AddSlidingMoveForAT.SourcePiece > 0)
                {
                    If (AddSlidingMoveForAT.TargetPiece > GoK_BlackKnight)
                    {
                        If SlidingStraight
                        {
                            If ((AddSlidingMoveForAT.TargetPiece == GoK_BlackQueen) Or (AddSlidingMoveForAT.TargetPiece == GoK_BlackRook))
                            {
                                AddSlidingMoveForAT.IsXRay = 0;
                            }
                        }
                        Else
                        {
                            If ((AddSlidingMoveForAT.TargetPiece == GoK_BlackQueen) Or (AddSlidingMoveForAT.TargetPiece == GoK_BlackBishop))
                            {
                                AddSlidingMoveForAT.IsXRay = 0;
                            }
                        }
                    }
                }
                Else
                {
                    If (AddSlidingMoveForAT.TargetPiece < GoK_WhiteKnight)
                    {
                        If SlidingStraight
                        {
                            If ((AddSlidingMoveForAT.TargetPiece == GoK_WhiteQueen) Or (AddSlidingMoveForAT.TargetPiece == GoK_WhiteRook))
                            {
                                AddSlidingMoveForAT.IsXRay = 0;
                            }
                        }
                        Else
                        {
                            If ((AddSlidingMoveForAT.TargetPiece == GoK_WhiteQueen) Or (AddSlidingMoveForAT.TargetPiece == GoK_WhiteBishop))
                            {
                                AddSlidingMoveForAT.IsXRay = 0;
                            }
                        }
                    }
                }
                If (AddSlidingMoveForAT.IsXRay == 1)
                {
                    AddSlidingMoveForAT.RaySlot += 1;
                    AddSlidingMoveForAT.RaySqLeft += -1;
                }
                Else
                {
                    AddSlidingMoveForAT.RaySlot += AddSlidingMoveForAT.RaySqLeft;
                    AddSlidingMoveForAT.RaySqLeft = 8;
                }
            }
        }
    }
}

Define AddSlidingMoveRays(string SourceIdx)(string Ply)(bool Quiescence)(bool SlidingStraight)(bool QuietsOnly)(bool QuietChecks) (warp=true)
{
    AddSlidingMoveRays.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddSlidingMoveRays.RaySlot = 1;
    AddSlidingMoveRays.RayOffset = (MoveSourceIdxToListOffsetSliding[(SourceIdx + 0)] + 0);
    AddSlidingMoveRays.RaySqLeft = 8;
    Repeat Until (AddSlidingMoveRays.RaySlot > 32)
    {
        If SlidingStraight
        {
            AddSlidingMoveRays.TargetIdx = (MoveSlidingStraightListIdxToTargetIdx[(AddSlidingMoveRays.RayOffset + AddSlidingMoveRays.RaySlot)] + 0);
        }
        Else
        {
            AddSlidingMoveRays.TargetIdx = (MoveCrossListIdxToTargetIdx[(AddSlidingMoveRays.RayOffset + AddSlidingMoveRays.RaySlot)] + 0);
        }
        If (AddSlidingMoveRays.TargetIdx == -1)
        {
            AddSlidingMoveRays.RaySlot += AddSlidingMoveRays.RaySqLeft;
            AddSlidingMoveRays.RaySqLeft = 8;
        }
        Else
        {
            AddSlidingMoveRays.TargetPiece = (Board[(AddSlidingMoveRays.TargetIdx + 0)] + 0);
            If (AddSlidingMoveRays.TargetPiece == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQMove(SourceIdx)(AddSlidingMoveRays.TargetIdx)(AddSlidingMoveRays.SourcePiece)(Ply)(QuietChecks);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)(AddSlidingMoveRays.TargetIdx)(Ply)((1 == 0))(Quiescence);
                }
                AddSlidingMoveRays.RaySlot += 1;
                AddSlidingMoveRays.RaySqLeft += -1;
            }
            Else
            {
                If (Not (QuietsOnly))
                {
                    If (AddSlidingMoveRays.SourcePiece > 0)
                    {
                        If (AddSlidingMoveRays.TargetPiece < 0)
                        {
                            Call AddMoveImpl(SourceIdx)(AddSlidingMoveRays.TargetIdx)(Ply)((1 == 0))(Quiescence);
                        }
                    }
                    Else
                    {
                        If (AddSlidingMoveRays.TargetPiece > 0)
                        {
                            Call AddMoveImpl(SourceIdx)(AddSlidingMoveRays.TargetIdx)(Ply)((1 == 0))(Quiescence);
                        }
                    }
                }
                AddSlidingMoveRays.RaySlot += AddSlidingMoveRays.RaySqLeft;
                AddSlidingMoveRays.RaySqLeft = 8;
            }
        }
    }
}

Define AddSpecialMove(string Move)(string Ply) (warp=true)
{
    List.Add(CalcMovesMoveList, Move);
    AddSpecialMove.SourcePiece = Const.Null;
    If (Not ((Move == floor(Move))))
    {
        AddSpecialMove.SourcePiece = GoK_BlackPawn;
    }
    If (floor((Move / 100)) == 0)
    {
        AddSpecialMove.SourcePiece = GoK_BlackKing;
    }
    AddSpecialMove.CastleFrom = floor((Move / 100));
    AddSpecialMove.CastleTo = floor((Move % 100));
    If (floor((Move / 100)) == 0)
    {
        If ((Move == 65) Or (Move == 66))
        {
            AddSpecialMove.CastleFrom = 5;
        }
        Else
        {
            AddSpecialMove.CastleFrom = 61;
        }
        If (Move == 65)
        {
            AddSpecialMove.CastleTo = 8;
        }
        Else
        {
            If (Move == 66)
            {
                AddSpecialMove.CastleTo = 1;
            }
            Else
            {
                If (Move == 67)
                {
                    AddSpecialMove.CastleTo = 64;
                }
                Else
                {
                    AddSpecialMove.CastleTo = 57;
                }
            }
        }
    }
    If (PlyIsOwn[Ply] == 1)
    {
        Call GetMoveScore(AddSpecialMove.SourcePiece)(0)(AddSpecialMove.CastleFrom)(AddSpecialMove.CastleTo)(Move)(Ply);
    }
    Else
    {
        Call GetMoveScore((0 - AddSpecialMove.SourcePiece))(0)(AddSpecialMove.CastleFrom)(AddSpecialMove.CastleTo)(Move)(Ply);
    }
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddTestCase(string FEN)(string AN1)(string AN2)(string AN3)(string AN4)(string AN5) (warp=true)
{
    List.Add(TestSuiteFEN, FEN);
    List.Add(TestSuiteAN, AN1);
    List.Add(TestSuiteAN, AN2);
    List.Add(TestSuiteAN, AN3);
    List.Add(TestSuiteAN, AN4);
    List.Add(TestSuiteAN, AN5);
}

Define AddToFiftyMoves(bool IsCaptureOrPawnMove) (warp=true)
{
    If IsCaptureOrPawnMove
    {
        List.Add(BoardHistoryFiftyMoves, 0);
    }
    Else
    {
        If (List.Length(BoardHistoryFiftyMoves) == 0)
        {
            List.Add(BoardHistoryFiftyMoves, 0);
        }
        List.Add(BoardHistoryFiftyMoves, (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] + 1));
    }
}

Define AdjustEvalScore(string Ply)(string RawEval) (warp=true)
{
    If (RawEval == Const.Null)
    {
        List.ReplaceItem(StaticEval, Ply, Const.Null);
    }
    Else
    {
        If (1 == 0)
        {
            AdjustEvalScore.KW = 0;
            If (RawEval > 4000)
            {
                AdjustEvalScore.KW = 5000;
            }
            If (RawEval < -4000)
            {
                AdjustEvalScore.KW = -5000;
            }
            AdjustEvalScore.Damped = ((((RawEval - AdjustEvalScore.KW) * (195 - BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)])) / 211) + AdjustEvalScore.KW);
            List.ReplaceItem(StaticEval, Ply, ((((AdjustEvalScore.Damped > 0) - (AdjustEvalScore.Damped < 0)) * floor(abs(AdjustEvalScore.Damped))) * PlySign[Ply]));
        }
        Else
        {
            List.ReplaceItem(StaticEval, Ply, (RawEval * PlySign[Ply]));
        }
        If (1 == 0)
        {
            Call GetCorrHistIndices(Ply);
            AdjustEvalScore.CorrSum = 0;
            If (CorrHistKey[Ret.GetCorrHistIndices.CorrIdx] == (floor((Ret.GetCorrHistIndices.PawnKey / 100000)) % 1073741824))
            {
                AdjustEvalScore.CorrSum += (53 * CorrHistVal[Ret.GetCorrHistIndices.CorrIdx]);
            }
            If (CorrHistNonPawnBlackKey[Ret.GetCorrHistIndices.NonPawnBlackIdx] == (floor((Ret.GetCorrHistIndices.NonPawnBlackKey / 100000)) % 1073741824))
            {
                AdjustEvalScore.CorrSum += (65 * CorrHistNonPawnBlack[Ret.GetCorrHistIndices.NonPawnBlackIdx]);
            }
            If (CorrHistNonPawnWhiteKey[Ret.GetCorrHistIndices.NonPawnWhiteIdx] == (floor((Ret.GetCorrHistIndices.NonPawnWhiteKey / 100000)) % 1073741824))
            {
                AdjustEvalScore.CorrSum += (65 * CorrHistNonPawnWhite[Ret.GetCorrHistIndices.NonPawnWhiteIdx]);
            }
            If (Not ((Ret.GetCorrHistIndices.ContIdx2 == Const.Null)))
            {
                AdjustEvalScore.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx2]);
            }
            If (Not ((Ret.GetCorrHistIndices.ContIdx4 == Const.Null)))
            {
                AdjustEvalScore.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx4]);
            }
            List.ReplaceItem(StaticEval, Ply, (StaticEval[Ply] + Operator.Round((AdjustEvalScore.CorrSum / 512))));
        }
    }
}

Define ApplyMove(string Ply)(bool UpdateNNUE) (warp=true)
{
    If UpdateNNUE
    {
        Call NNUE_Public_OnMakeMoveStart(Ply);
    }
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, Ply, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(PutsInCheck, Ply, 0);
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.Board.CurrentHash);
    List.ReplaceItem(PreviousBoardHashKP, Ply, Glob.Board.KPHash);
    List.ReplaceItem(PreviousNonPawnHashBlack, Ply, Glob.Board.NonPawnHashBlack);
    List.ReplaceItem(PreviousNonPawnHashWhite, Ply, Glob.Board.NonPawnHashWhite);
    Call GetCurrentMove(Ply);
    ApplyMove.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, ApplyMove.Move);
    Call AddToFiftyMoves((((Not ((ApplyMove.Move == 0))) And (Not ((floor((ApplyMove.Move / 100)) == 0)))) And ((abs(Board[floor((ApplyMove.Move / 100))]) == GoK_BlackPawn) Or (Not ((Board[floor((ApplyMove.Move % 100))] == 0))))));
    ApplyMove.SourceIdx = floor((ApplyMove.Move / 100));
    If (ApplyMove.SourceIdx > 0)
    {
        ApplyMove.TargetIdx = floor((ApplyMove.Move % 100));
        ApplyMove.SourcePiece = (Board[ApplyMove.SourceIdx] + 0);
        ApplyMove.TargetPiece = (Board[ApplyMove.TargetIdx] + 0);
        Call //("Update search stack variables");
        List.ReplaceItem(SourcePieces, Ply, ApplyMove.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMove.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, ApplyMove.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, ApplyMove.TargetIdx, ApplyMove.SourcePiece);
        List.ReplaceItem(Board, ApplyMove.SourceIdx, 0);
        ApplyMove.MoveKey = ((((PlySign[Ply] + 1) * 30000) + (PieceIdxLookup[abs(ApplyMove.SourcePiece)] * 10000)) + ((ApplyMove.SourceIdx * 100) + ApplyMove.TargetIdx));
        Call //("Incremental Zobrist hash update via move-to-hash lookup table");
        Glob.Board.CurrentHash += MoveToHash[ApplyMove.MoveKey];
        If (Not ((abs(ApplyMove.SourcePiece) == GoK_BlackPawn)))
        {
            If (ApplyMove.SourcePiece > 0)
            {
                Glob.Board.NonPawnHashBlack += MoveToHash[ApplyMove.MoveKey];
            }
            Else
            {
                Glob.Board.NonPawnHashWhite += MoveToHash[ApplyMove.MoveKey];
            }
        }
        If (abs(ApplyMove.SourcePiece) == GoK_BlackPawn)
        {
            Glob.Board.KPHash += MoveToHash[ApplyMove.MoveKey];
            If (Not ((IdxToFile[ApplyMove.SourceIdx] == IdxToFile[ApplyMove.TargetIdx])))
            {
                If (TargetPieces[Ply] == 0)
                {
                    Call //("en-passant => stack vars and Zobrist hash update");
                    ApplyMove.SqIdx = (ApplyMove.TargetIdx + (8 * (0 - PlySign[Ply])));
                    List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMove.SqIdx);
                    List.ReplaceItem(TargetPieces, Ply, Board[ApplyMove.SqIdx]);
                    ApplyMove.TargetPiece = (Board[ApplyMove.SqIdx] + 0);
                    List.ReplaceItem(Board, ApplyMove.SqIdx, 0);
                    If (1 == 0)
                    {
                        Call GetPiecePosHash(ApplyMove.TargetPiece)(ApplyMove.SqIdx);
                        Glob.Board.CurrentHash = (Glob.Board.CurrentHash - Ret.GetPiecePosHash.Hash);
                        If (Not ((abs(ApplyMove.TargetPiece) == GoK_BlackPawn)))
                        {
                            If (ApplyMove.TargetPiece > 0)
                            {
                                Glob.Board.NonPawnHashBlack = (Glob.Board.NonPawnHashBlack - Ret.GetPiecePosHash.Hash);
                            }
                            Else
                            {
                                Glob.Board.NonPawnHashWhite = (Glob.Board.NonPawnHashWhite - Ret.GetPiecePosHash.Hash);
                            }
                        }
                        Glob.Board.KPHash = (Glob.Board.KPHash - Ret.GetPiecePosHash.Hash);
                    }
                }
            }
            If (((ApplyMove.TargetIdx - ApplyMove.SourceIdx) == (16 * PlySign[Ply])) And (((IdxToFile[ApplyMove.TargetIdx] > 1) And (Board[(ApplyMove.TargetIdx - 1)] == (GoK_WhitePawn * PlySign[Ply]))) Or ((IdxToFile[ApplyMove.TargetIdx] < 8) And (Board[(ApplyMove.TargetIdx + 1)] == (GoK_WhitePawn * PlySign[Ply])))))
            {
                List.ReplaceItem(EnPassantTarget, Ply, ApplyMove.TargetIdx);
            }
            If (ApplyMove.TargetIdx < 9)
            {
                ApplyMove.PromotionCode = (Operator.LetterOf(ApplyMove.Move, Variable.Length(ApplyMove.Move)) + 0);
                If (ApplyMove.PromotionCode == 1)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteQueen);
                    Glob.Board.WhiteQueenCount += 1;
                }
                If (ApplyMove.PromotionCode == 2)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteRook);
                    Glob.Board.WhiteRookCount += 1;
                    Glob.Board.WhiteNonQueenMajorMinorCount += 1;
                }
                If (ApplyMove.PromotionCode == 3)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteBishop);
                    Glob.Board.WhiteNonQueenMajorMinorCount += 1;
                }
                If (ApplyMove.PromotionCode == 4)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_WhiteKnight);
                    Glob.Board.WhiteNonQueenMajorMinorCount += 1;
                }
                Glob.Board.WhitePawnCount += -1;
            }
            If (ApplyMove.TargetIdx > 56)
            {
                ApplyMove.PromotionCode = (Operator.LetterOf(ApplyMove.Move, Variable.Length(ApplyMove.Move)) + 0);
                If (ApplyMove.PromotionCode == 1)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackQueen);
                    Glob.Board.BlackQueenCount += 1;
                }
                If (ApplyMove.PromotionCode == 2)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackRook);
                    Glob.Board.BlackRookCount += 1;
                    Glob.Board.BlackNonQueenMajorMinorCount += 1;
                }
                If (ApplyMove.PromotionCode == 3)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackBishop);
                    Glob.Board.BlackNonQueenMajorMinorCount += 1;
                }
                If (ApplyMove.PromotionCode == 4)
                {
                    List.ReplaceItem(PromotionPieces, Ply, GoK_BlackKnight);
                    Glob.Board.BlackNonQueenMajorMinorCount += 1;
                }
                Glob.Board.BlackPawnCount += -1;
            }
            If ((ApplyMove.TargetIdx < 9) Or (ApplyMove.TargetIdx > 56))
            {
                Call //("promotions => Zobrist hash update");
                Call GetPiecePosHash(ApplyMove.SourcePiece)(ApplyMove.TargetIdx);
                Glob.Board.CurrentHash = (Glob.Board.CurrentHash - Ret.GetPiecePosHash.Hash);
                If (Not ((abs(ApplyMove.SourcePiece) == GoK_BlackPawn)))
                {
                    If (ApplyMove.SourcePiece > 0)
                    {
                        Glob.Board.NonPawnHashBlack = (Glob.Board.NonPawnHashBlack - Ret.GetPiecePosHash.Hash);
                    }
                    Else
                    {
                        Glob.Board.NonPawnHashWhite = (Glob.Board.NonPawnHashWhite - Ret.GetPiecePosHash.Hash);
                    }
                }
                Glob.Board.KPHash = (Glob.Board.KPHash - Ret.GetPiecePosHash.Hash);
                List.ReplaceItem(Board, ApplyMove.TargetIdx, PromotionPieces[Ply]);
                Call GetPiecePosHash(PromotionPieces[Ply])(ApplyMove.TargetIdx);
                Glob.Board.CurrentHash = (Glob.Board.CurrentHash + Ret.GetPiecePosHash.Hash);
                If (Not ((abs(PromotionPieces[Ply]) == GoK_BlackPawn)))
                {
                    If (PromotionPieces[Ply] > 0)
                    {
                        Glob.Board.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
                    }
                    Else
                    {
                        Glob.Board.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
                    }
                }
            }
        }
        Call //("King or rook move => update castling meta state");
        If (ApplyMove.SourcePiece == GoK_BlackKing)
        {
            Glob.Board.BlackKingIdx = ApplyMove.TargetIdx;
            Glob.Board.KPHash += MoveToHash[ApplyMove.MoveKey];
            Call SetCastlingStateFlag(Ply)(2)(1);
        }
        If (ApplyMove.SourcePiece == GoK_BlackRook)
        {
            If ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 3)] == 0))
            {
                If (ApplyMove.SourceIdx == 8)
                {
                    Call SetCastlingStateFlag(Ply)(3)(1);
                }
            }
            If ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 4)] == 0))
            {
                If (ApplyMove.SourceIdx == 1)
                {
                    Call SetCastlingStateFlag(Ply)(4)(1);
                }
            }
        }
        If (ApplyMove.SourcePiece == GoK_WhiteKing)
        {
            Glob.Board.WhiteKingIdx = ApplyMove.TargetIdx;
            Glob.Board.KPHash += MoveToHash[ApplyMove.MoveKey];
            Call SetCastlingStateFlag(Ply)(6)(1);
        }
        If (ApplyMove.SourcePiece == GoK_WhiteRook)
        {
            If ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 7)] == 0))
            {
                If (ApplyMove.SourceIdx == 64)
                {
                    Call SetCastlingStateFlag(Ply)(7)(1);
                }
            }
            If ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 8)] == 0))
            {
                If (ApplyMove.SourceIdx == 57)
                {
                    Call SetCastlingStateFlag(Ply)(8)(1);
                }
            }
        }
        If (Not ((ApplyMove.TargetPiece == 0)))
        {
            If (ApplyMove.TargetPiece == GoK_WhiteRook)
            {
                If (ApplyMove.TargetIdx == 64)
                {
                    Call SetCastlingStateFlag(Ply)(7)(1);
                }
                If (ApplyMove.TargetIdx == 57)
                {
                    Call SetCastlingStateFlag(Ply)(8)(1);
                }
            }
            If (ApplyMove.TargetPiece == GoK_BlackRook)
            {
                If (ApplyMove.TargetIdx == 8)
                {
                    Call SetCastlingStateFlag(Ply)(3)(1);
                }
                If (ApplyMove.TargetIdx == 1)
                {
                    Call SetCastlingStateFlag(Ply)(4)(1);
                }
            }
            Call //("Captures => incremental positional eval and Zobrist hash update");
            ApplyMove.MoveKey = ((((PlySign[(Ply + 1)] + 1) * 30000) + (PieceIdxLookup[abs(ApplyMove.TargetPiece)] * 10000)) + (TargetPiecesIdx[Ply] * 100));
            Glob.Board.CurrentHash += MoveToHash[ApplyMove.MoveKey];
            If (Not ((abs(ApplyMove.TargetPiece) == GoK_BlackPawn)))
            {
                If (ApplyMove.TargetPiece > 0)
                {
                    Glob.Board.NonPawnHashBlack += MoveToHash[ApplyMove.MoveKey];
                }
                Else
                {
                    Glob.Board.NonPawnHashWhite += MoveToHash[ApplyMove.MoveKey];
                }
            }
            If ((abs(ApplyMove.TargetPiece) == GoK_BlackPawn) Or (abs(ApplyMove.TargetPiece) == GoK_BlackKing))
            {
                Glob.Board.KPHash += MoveToHash[ApplyMove.MoveKey];
            }
            If (ApplyMove.TargetPiece > 0)
            {
                If (ApplyMove.TargetPiece == GoK_BlackPawn)
                {
                    Glob.Board.BlackPawnCount += -1;
                }
                Else
                {
                    If (ApplyMove.TargetPiece < GoK_BlackQueen)
                    {
                        Glob.Board.BlackNonQueenMajorMinorCount += -1;
                        If (ApplyMove.TargetPiece == GoK_BlackRook)
                        {
                            Glob.Board.BlackRookCount += -1;
                        }
                    }
                    Else
                    {
                        If (ApplyMove.TargetPiece == GoK_BlackQueen)
                        {
                            Glob.Board.BlackQueenCount += -1;
                        }
                    }
                }
            }
            Else
            {
                If (ApplyMove.TargetPiece == GoK_WhitePawn)
                {
                    Glob.Board.WhitePawnCount += -1;
                }
                Else
                {
                    If (ApplyMove.TargetPiece > GoK_WhiteQueen)
                    {
                        Glob.Board.WhiteNonQueenMajorMinorCount += -1;
                        If (ApplyMove.TargetPiece == GoK_WhiteRook)
                        {
                            Glob.Board.WhiteRookCount += -1;
                        }
                    }
                    Else
                    {
                        If (ApplyMove.TargetPiece == GoK_WhiteQueen)
                        {
                            Glob.Board.WhiteQueenCount += -1;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        Call //("Castling => incremental positional eval and Zobrist hash update");
        If (ApplyMove.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_WhiteRook);
            List.ReplaceItem(Board, 63, GoK_WhiteKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.Board.WhiteKingIdx = 63;
            Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(63)((1 == 0))(Ply);
            Call UpdateMoveHashPosEval(GoK_WhiteRook)(64)(62)((1 == 1))(Ply);
            Call SetCastlingStateFlag(Ply)(5)(1);
        }
        Else
        {
            If (ApplyMove.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_WhiteKing);
                List.ReplaceItem(Board, 60, GoK_WhiteRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.Board.WhiteKingIdx = 59;
                Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(59)((1 == 0))(Ply);
                Call UpdateMoveHashPosEval(GoK_WhiteRook)(57)(60)((1 == 1))(Ply);
                Call SetCastlingStateFlag(Ply)(5)(1);
            }
            Else
            {
                If (ApplyMove.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_BlackRook);
                    List.ReplaceItem(Board, 7, GoK_BlackKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.Board.BlackKingIdx = 7;
                    Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(7)((1 == 0))(Ply);
                    Call UpdateMoveHashPosEval(GoK_BlackRook)(8)(6)((1 == 1))(Ply);
                    Call SetCastlingStateFlag(Ply)(1)(1);
                }
                Else
                {
                    If (ApplyMove.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_BlackKing);
                        List.ReplaceItem(Board, 4, GoK_BlackRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.Board.BlackKingIdx = 3;
                        Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(3)((1 == 0))(Ply);
                        Call UpdateMoveHashPosEval(GoK_BlackRook)(1)(4)((1 == 1))(Ply);
                        Call SetCastlingStateFlag(Ply)(1)(1);
                    }
                }
            }
        }
    }
    If UpdateNNUE
    {
        Call UpdateNNUEPostApplyMove(Ply);
    }
    If (Not ((AppliedMove[Ply] == 0)))
    {
        If ((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 0))
        {
            Glob.Stats.NodeCount += 1;
        }
        Else
        {
            Glob.Stats.NodeCountQuiescence += 1;
        }
    }
    If (Not ((CastlingState[Ply] == Const.Null)))
    {
        If ((CastlingBit[((8 * CastlingState[Ply]) + 1)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 2)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 3)] == 1) And (CastlingBit[((8 * CastlingState[Ply]) + 4)] == 1))))
        {
            Call SetCastlingStateFlag(Ply)(1)(1);
            Call SetCastlingStateFlag(Ply)(2)(1);
            Call SetCastlingStateFlag(Ply)(3)(1);
            Call SetCastlingStateFlag(Ply)(4)(1);
        }
        If ((CastlingBit[((8 * CastlingState[Ply]) + 5)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 6)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 7)] == 1) And (CastlingBit[((8 * CastlingState[Ply]) + 8)] == 1))))
        {
            Call SetCastlingStateFlag(Ply)(5)(1);
            Call SetCastlingStateFlag(Ply)(6)(1);
            Call SetCastlingStateFlag(Ply)(7)(1);
            Call SetCastlingStateFlag(Ply)(8)(1);
        }
    }
}

Define ApplyMoveLight(string Ply) (warp=true)
{
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.Board.CurrentHash);
    Call GetCurrentMove(Ply);
    ApplyMoveLight.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, ApplyMoveLight.Move);
    ApplyMoveLight.SourceIdx = floor((ApplyMoveLight.Move / 100));
    If (ApplyMoveLight.SourceIdx > 0)
    {
        ApplyMoveLight.TargetIdx = floor((ApplyMoveLight.Move % 100));
        ApplyMoveLight.SourcePiece = (Board[ApplyMoveLight.SourceIdx] + 0);
        ApplyMoveLight.TargetPiece = (Board[ApplyMoveLight.TargetIdx] + 0);
        List.ReplaceItem(SourcePieces, Ply, ApplyMoveLight.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMoveLight.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, ApplyMoveLight.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, ApplyMoveLight.TargetIdx, ApplyMoveLight.SourcePiece);
        List.ReplaceItem(Board, ApplyMoveLight.SourceIdx, 0);
        If (ApplyMoveLight.SourcePiece == GoK_BlackKing)
        {
            Glob.Board.BlackKingIdx = ApplyMoveLight.TargetIdx;
        }
        If (ApplyMoveLight.SourcePiece == GoK_WhiteKing)
        {
            Glob.Board.WhiteKingIdx = ApplyMoveLight.TargetIdx;
        }
        ApplyMoveLight.MoveToHashIdx = ((PieceIdxLookup[abs(ApplyMoveLight.SourcePiece)] * 10000) + ((ApplyMoveLight.SourceIdx * 100) + ApplyMoveLight.TargetIdx));
        If (ApplyMoveLight.SourcePiece > 0)
        {
            ApplyMoveLight.MoveToHashIdx += 60000;
        }
        Glob.Board.CurrentHash += MoveToHash[ApplyMoveLight.MoveToHashIdx];
        If (Not ((ApplyMoveLight.TargetPiece == 0)))
        {
            ApplyMoveLight.MoveToHashIdx = ((PieceIdxLookup[abs(ApplyMoveLight.TargetPiece)] * 10000) + (ApplyMoveLight.TargetIdx * 100));
            If (ApplyMoveLight.TargetPiece > 0)
            {
                ApplyMoveLight.MoveToHashIdx += 60000;
            }
            Glob.Board.CurrentHash += MoveToHash[ApplyMoveLight.MoveToHashIdx];
        }
        If (((abs(ApplyMoveLight.SourcePiece) == GoK_BlackPawn) And (ApplyMoveLight.TargetPiece == 0)) And (Not ((IdxToFile[ApplyMoveLight.SourceIdx] == IdxToFile[ApplyMoveLight.TargetIdx]))))
        {
            If (ApplyMoveLight.SourcePiece > 0)
            {
                ApplyMoveLight.EnPassantSquare = (ApplyMoveLight.TargetIdx - 8);
            }
            Else
            {
                ApplyMoveLight.EnPassantSquare = (ApplyMoveLight.TargetIdx + 8);
            }
            ApplyMoveLight.EnPassantCaptured = (Board[ApplyMoveLight.EnPassantSquare] + 0);
            List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMoveLight.EnPassantSquare);
            List.ReplaceItem(TargetPieces, Ply, ApplyMoveLight.EnPassantCaptured);
            List.ReplaceItem(Board, ApplyMoveLight.EnPassantSquare, 0);
            ApplyMoveLight.MoveToHashIdx = ((PieceIdxLookup[abs(ApplyMoveLight.EnPassantCaptured)] * 10000) + (ApplyMoveLight.EnPassantSquare * 100));
            If (ApplyMoveLight.EnPassantCaptured > 0)
            {
                ApplyMoveLight.MoveToHashIdx = (ApplyMoveLight.MoveToHashIdx + 60000);
            }
            Glob.Board.CurrentHash = (Glob.Board.CurrentHash + MoveToHash[ApplyMoveLight.MoveToHashIdx]);
        }
    }
    Else
    {
        List.ReplaceItem(SourcePieces, Ply, 0);
        List.ReplaceItem(TargetPiecesIdx, Ply, 0);
        List.ReplaceItem(TargetPieces, Ply, 0);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        Call //("Castling => incremental positional eval and Zobrist hash update");
        If (ApplyMoveLight.Move == GoK_WhiteKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_WhiteRook);
            List.ReplaceItem(Board, 63, GoK_WhiteKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.Board.WhiteKingIdx = 63;
            Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(63)((1 == 0))(Ply);
            Call UpdateMoveHashPosEval(GoK_WhiteRook)(64)(62)((1 == 1))(Ply);
            Call SetCastlingStateFlag(Ply)(5)(1);
        }
        Else
        {
            If (ApplyMoveLight.Move == GoK_WhiteQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_WhiteKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_WhiteKing);
                List.ReplaceItem(Board, 60, GoK_WhiteRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.Board.WhiteKingIdx = 59;
                Call UpdateMoveHashPosEval(GoK_WhiteKing)(61)(59)((1 == 0))(Ply);
                Call UpdateMoveHashPosEval(GoK_WhiteRook)(57)(60)((1 == 1))(Ply);
                Call SetCastlingStateFlag(Ply)(5)(1);
            }
            Else
            {
                If (ApplyMoveLight.Move == GoK_BlackKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_BlackRook);
                    List.ReplaceItem(Board, 7, GoK_BlackKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.Board.BlackKingIdx = 7;
                    Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(7)((1 == 0))(Ply);
                    Call UpdateMoveHashPosEval(GoK_BlackRook)(8)(6)((1 == 1))(Ply);
                    Call SetCastlingStateFlag(Ply)(1)(1);
                }
                Else
                {
                    If (ApplyMoveLight.Move == GoK_BlackQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_BlackKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_BlackKing);
                        List.ReplaceItem(Board, 4, GoK_BlackRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.Board.BlackKingIdx = 3;
                        Call UpdateMoveHashPosEval(GoK_BlackKing)(5)(3)((1 == 0))(Ply);
                        Call UpdateMoveHashPosEval(GoK_BlackRook)(1)(4)((1 == 1))(Ply);
                        Call SetCastlingStateFlag(Ply)(1)(1);
                    }
                }
            }
        }
    }
}

Define AskTimeControl (warp=false)
{
    Ret.AskTimeControl.IsSet = 0;
    Event.BroadcastAndWait("GoK_AskTime");
    AskTimeControl.Answer = Sensing.Answer();
    AskTimeControl.SlashIdx = 0;
    AskTimeControl.PlusIdx = 0;
    AskTimeControl.CharIdx = 1;
    Repeat (Variable.Length(AskTimeControl.Answer))
    {
        If (Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx) == "/")
        {
            AskTimeControl.SlashIdx = AskTimeControl.CharIdx;
        }
        If (Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx) == "+")
        {
            AskTimeControl.PlusIdx = AskTimeControl.CharIdx;
        }
        AskTimeControl.CharIdx += 1;
    }
    AskTimeControl.IsValid = 1;
    AskTimeControl.CharIdx = 1;
    Repeat (Variable.Length(AskTimeControl.Answer))
    {
        If (Not (Operator.Contains("0123456789./+", Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx))))
        {
            If (Not (((AskTimeControl.CharIdx == 1) And ((Operator.LetterOf(AskTimeControl.Answer, 1) == "e") Or (Operator.LetterOf(AskTimeControl.Answer, 1) == "d")))))
            {
                AskTimeControl.IsValid = 0;
            }
        }
        AskTimeControl.CharIdx += 1;
    }
    If (((Operator.LetterOf(AskTimeControl.Answer, 1) == "e") Or (Operator.LetterOf(AskTimeControl.Answer, 1) == "d")) And ((AskTimeControl.SlashIdx > 0) Or (AskTimeControl.PlusIdx > 0)))
    {
        AskTimeControl.IsValid = 0;
    }
    If ((AskTimeControl.PlusIdx > 0) And ((AskTimeControl.SlashIdx == 0) Or (AskTimeControl.PlusIdx < AskTimeControl.SlashIdx)))
    {
        AskTimeControl.IsValid = 0;
    }
    If (Variable.Length(AskTimeControl.Answer) == 0)
    {
        AskTimeControl.IsValid = 0;
    }
    If (AskTimeControl.IsValid == 1)
    {
        If (AskTimeControl.SlashIdx > 0)
        {
            AskTimeControl.Part = "";
            AskTimeControl.CharIdx = 1;
            Repeat ((AskTimeControl.SlashIdx - 1))
            {
                AskTimeControl.Part = Operator.Join(AskTimeControl.Part, Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx));
                AskTimeControl.CharIdx += 1;
            }
            If (AskTimeControl.Part == "")
            {
                Glob.Clock.InitialTime = 0;
            }
            Else
            {
                Glob.Clock.InitialTime = AskTimeControl.Part;
            }
            If (AskTimeControl.PlusIdx > AskTimeControl.SlashIdx)
            {
                AskTimeControl.Part = "";
                AskTimeControl.CharIdx = (AskTimeControl.SlashIdx + 1);
                Repeat (((AskTimeControl.PlusIdx - AskTimeControl.SlashIdx) - 1))
                {
                    AskTimeControl.Part = Operator.Join(AskTimeControl.Part, Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx));
                    AskTimeControl.CharIdx += 1;
                }
                If (AskTimeControl.Part == "")
                {
                    Glob.Clock.StageMoves = 0;
                }
                Else
                {
                    Glob.Clock.StageMoves = AskTimeControl.Part;
                }
                AskTimeControl.Part = "";
                AskTimeControl.CharIdx = (AskTimeControl.PlusIdx + 1);
                Repeat ((Variable.Length(AskTimeControl.Answer) - AskTimeControl.PlusIdx))
                {
                    AskTimeControl.Part = Operator.Join(AskTimeControl.Part, Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx));
                    AskTimeControl.CharIdx += 1;
                }
                If (AskTimeControl.Part == "")
                {
                    Glob.Clock.StageTime = 0;
                }
                Else
                {
                    Glob.Clock.StageTime = AskTimeControl.Part;
                }
                Glob.Clock.TimeInc = 0;
            }
            Else
            {
                AskTimeControl.Part = "";
                AskTimeControl.CharIdx = (AskTimeControl.SlashIdx + 1);
                Repeat ((Variable.Length(AskTimeControl.Answer) - AskTimeControl.SlashIdx))
                {
                    AskTimeControl.Part = Operator.Join(AskTimeControl.Part, Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx));
                    AskTimeControl.CharIdx += 1;
                }
                If (AskTimeControl.Part == "")
                {
                    Glob.Clock.TimeInc = 0;
                }
                Else
                {
                    Glob.Clock.TimeInc = AskTimeControl.Part;
                }
                Glob.Clock.StageMoves = 0;
                Glob.Clock.StageTime = 0;
            }
            Glob.Clock.CurrentTime = Glob.Clock.InitialTime;
            Glob.Config.CustomThinkTime = 0;
            Glob.Config.CustomMaxDepth = 0;
            Glob.Clock.TimeControl = 1;
            Glob.Clock.PlayerTime = Glob.Clock.InitialTime;
            Glob.Clock.PlayerMoveCount = 0;
            Ret.AskTimeControl.IsSet = 1;
            Glob.Clock.MoveCount = 0;
            If (Glob.Clock.InitialTime == 0)
            {
                Glob.Config.CustomThinkTime = Glob.Clock.TimeInc;
                Glob.Clock.TimeInc = 0;
                Glob.Clock.TimeControl = 0;
            }
        }
        Else
        {
            If (Not ((AskTimeControl.Answer == "")))
            {
                If (Operator.LetterOf(AskTimeControl.Answer, 1) == "d")
                {
                    AskTimeControl.Part = "";
                    AskTimeControl.CharIdx = 2;
                    Repeat ((Variable.Length(AskTimeControl.Answer) - 1))
                    {
                        AskTimeControl.Part = Operator.Join(AskTimeControl.Part, Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx));
                        AskTimeControl.CharIdx += 1;
                    }
                    Glob.Clock.InitialTime = 0;
                    Glob.Clock.TimeInc = 0;
                    Glob.Clock.StageMoves = 0;
                    Glob.Clock.StageTime = 0;
                    Glob.Config.CustomThinkTime = 100000;
                    Glob.Config.CustomMaxDepth = AskTimeControl.Part;
                    Glob.Clock.TimeControl = 0;
                    Glob.Clock.CurrentTime = 0;
                    Glob.Clock.MoveCount = 0;
                    Glob.Clock.PlayerTime = 0;
                    Glob.Clock.PlayerMoveCount = 0;
                    Ret.AskTimeControl.IsSet = 1;
                }
                Else
                {
                    If (Operator.LetterOf(AskTimeControl.Answer, 1) == "e")
                    {
                        AskTimeControl.Part = "";
                        AskTimeControl.CharIdx = 2;
                        Repeat ((Variable.Length(AskTimeControl.Answer) - 1))
                        {
                            AskTimeControl.Part = Operator.Join(AskTimeControl.Part, Operator.LetterOf(AskTimeControl.Answer, AskTimeControl.CharIdx));
                            AskTimeControl.CharIdx += 1;
                        }
                        Glob.Clock.InitialTime = 0;
                        Glob.Clock.TimeInc = 0;
                        Glob.Clock.StageMoves = 0;
                        Glob.Clock.StageTime = 0;
                        Glob.Config.CustomThinkTime = AskTimeControl.Part;
                        Glob.Config.CustomMaxDepth = 0;
                        Glob.Clock.TimeControl = 0;
                        Glob.Clock.CurrentTime = 0;
                        Glob.Clock.MoveCount = 0;
                        Glob.Clock.PlayerTime = 0;
                        Glob.Clock.PlayerMoveCount = 0;
                        Ret.AskTimeControl.IsSet = 1;
                    }
                    Else
                    {
                        Glob.Clock.InitialTime = AskTimeControl.Answer;
                        Glob.Clock.TimeInc = 0;
                        Glob.Clock.StageMoves = 0;
                        Glob.Clock.StageTime = 0;
                        Glob.Config.CustomThinkTime = 0;
                        Glob.Config.CustomMaxDepth = 0;
                        Glob.Clock.TimeControl = 1;
                        Glob.Clock.CurrentTime = Glob.Clock.InitialTime;
                        Glob.Clock.MoveCount = 0;
                        Glob.Clock.PlayerTime = Glob.Clock.InitialTime;
                        Glob.Clock.PlayerMoveCount = 0;
                        Ret.AskTimeControl.IsSet = 1;
                    }
                }
            }
        }
        AskTimeControl.IsValid = 1;
        If (Glob.Clock.TimeControl == 1)
        {
            If (Not ((Glob.Clock.InitialTime > 0)))
            {
                AskTimeControl.IsValid = 0;
            }
            If (Not ((Glob.Clock.InitialTime == (Glob.Clock.InitialTime + 0))))
            {
                AskTimeControl.IsValid = 0;
            }
            If (Not ((Glob.Clock.TimeInc == (Glob.Clock.TimeInc + 0))))
            {
                AskTimeControl.IsValid = 0;
            }
            If (Not ((Glob.Clock.StageMoves == (Glob.Clock.StageMoves + 0))))
            {
                AskTimeControl.IsValid = 0;
            }
            If (Not ((Glob.Clock.StageTime == (Glob.Clock.StageTime + 0))))
            {
                AskTimeControl.IsValid = 0;
            }
        }
        Else
        {
            If (Not ((Glob.Config.CustomThinkTime > 0)))
            {
                AskTimeControl.IsValid = 0;
            }
            If (Not ((Glob.Config.CustomThinkTime == (Glob.Config.CustomThinkTime + 0))))
            {
                AskTimeControl.IsValid = 0;
            }
            If (Operator.LetterOf(AskTimeControl.Answer, 1) == "d")
            {
                If (Not ((Glob.Config.CustomMaxDepth > 0)))
                {
                    AskTimeControl.IsValid = 0;
                }
                If (Not ((Glob.Config.CustomMaxDepth == (Glob.Config.CustomMaxDepth + 0))))
                {
                    AskTimeControl.IsValid = 0;
                }
            }
        }
        If (AskTimeControl.IsValid == 0)
        {
            Glob.Clock.InitialTime = 0;
            Glob.Clock.TimeInc = 0;
            Glob.Clock.StageMoves = 0;
            Glob.Clock.StageTime = 0;
            Glob.Config.CustomThinkTime = 0;
            Glob.Config.CustomMaxDepth = 0;
            Glob.Clock.TimeControl = 0;
            Glob.Clock.CurrentTime = 0;
            Glob.Clock.MoveCount = 0;
            Glob.Clock.PlayerTime = 0;
            Glob.Clock.PlayerMoveCount = 0;
            Ret.AskTimeControl.IsSet = 0;
            Call SayAsync("Invalid clock format")(6);
        }
    }
    Else
    {
        If (Not ((Variable.Length(AskTimeControl.Answer) == 0)))
        {
            Call SayAsync("Invalid clock format")(6);
        }
        Ret.AskTimeControl.IsSet = 0;
    }
}

Define CalcBoardAttacked(string CheckingPly) (warp=true)
{
    CalcBoardAttacked.IsChecked = 0;
    CalcBoardAttacked.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    CalcBoardAttacked.SqIdx = 1;
    Repeat (64)
    {
        If ((Board[CalcBoardAttacked.SqIdx] * CalcBoardAttacked.Factor) > 0)
        {
            Call IsCheckingPiece(CalcBoardAttacked.SqIdx);
            If (Ret.IsCheckingPiece.IsChecking == 1)
            {
                CalcBoardAttacked.IsChecked = 1;
            }
        }
        CalcBoardAttacked.SqIdx += 1;
    }
    If (PlyIsOwn[CheckingPly] == 1)
    {
        Glob.Board.IsWhiteChecked = CalcBoardAttacked.IsChecked;
    }
    Else
    {
        Glob.Board.IsBlackChecked = CalcBoardAttacked.IsChecked;
    }
}

Define CalcBoardAttackedByMove(string Ply) (warp=true)
{
    Call ClearBoardAttacked(Ply);
    Call GenerateMovesImplWrapper(Ply)((1 == 1))((1 == 0))((1 == 0));
}

Define CalcBoardAttackedOnDemand(string Ply)(bool Quiescence)(bool ForceOnCheck)(string Horizon) (warp=true)
{
    If (BoardAttackedCalculated[Ply] == 0)
    {
        If ((ForceOnCheck And (CheckedState[Ply] == 1)) Or ((Not (Quiescence)) And (Not ((Ply > Horizon)))))
        {
            Call CalcBoardAttackedByMove((Ply + 1));
            Call StoreAttackInfo(Ply);
            List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
        }
    }
}

Define CalcBoardStats (warp=true)
{
    Glob.Board.BlackKingIdx = Const.Null;
    Glob.Board.WhiteKingIdx = Const.Null;
    Glob.Board.CurrentHash = 0;
    Glob.Board.NonPawnHashBlack = 0;
    Glob.Board.NonPawnHashWhite = 0;
    Glob.Board.KPHash = 0;
    CalcBoardStats.SqIdx = 1;
    Repeat (8)
    {
        List.ReplaceItem(PawnCount, (CalcBoardStats.SqIdx + 8), 0);
        List.ReplaceItem(PawnCount, CalcBoardStats.SqIdx, 0);
        CalcBoardStats.SqIdx += 1;
    }
    CalcBoardStats.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CalcBoardStats.SqIdx] == GoK_WhitePawn)
        {
            List.ReplaceItem(PawnCount, IdxToFile[CalcBoardStats.SqIdx], (PawnCount[IdxToFile[CalcBoardStats.SqIdx]] + 1));
        }
        Else
        {
            If (Board[CalcBoardStats.SqIdx] == GoK_BlackPawn)
            {
                List.ReplaceItem(PawnCount, (IdxToFile[CalcBoardStats.SqIdx] + 8), (PawnCount[(IdxToFile[CalcBoardStats.SqIdx] + 8)] + 1));
            }
            Else
            {
                If (Board[CalcBoardStats.SqIdx] == GoK_WhiteKing)
                {
                    Glob.Board.WhiteKingIdx = CalcBoardStats.SqIdx;
                }
                Else
                {
                    If (Board[CalcBoardStats.SqIdx] == GoK_BlackKing)
                    {
                        Glob.Board.BlackKingIdx = CalcBoardStats.SqIdx;
                    }
                }
            }
        }
        Call GetPiecePosHash(Board[CalcBoardStats.SqIdx])(CalcBoardStats.SqIdx);
        Glob.Board.CurrentHash = (Glob.Board.CurrentHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CalcBoardStats.SqIdx]) == GoK_BlackPawn)))
        {
            If (Board[CalcBoardStats.SqIdx] > 0)
            {
                Glob.Board.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.Board.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CalcBoardStats.SqIdx]) == GoK_BlackPawn) Or (abs(Board[CalcBoardStats.SqIdx]) == GoK_BlackKing))
        {
            Glob.Board.KPHash = (Glob.Board.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CalcBoardStats.SqIdx += 1;
    }
    Glob.Board.RootBlackNonQueenMajorMinorCount = 0;
    Glob.Board.RootBlackQueenCount = 0;
    Glob.Board.RootBlackPawnCount = 0;
    CalcBoardStats.BlackRookCount = 0;
    Glob.Board.RootWhiteQueenCount = 0;
    Glob.Board.RootWhiteNonQueenMajorMinorCount = 0;
    Glob.Board.RootWhitePawnCount = 0;
    CalcBoardStats.WhiteRookCount = 0;
    CalcBoardStats.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CalcBoardStats.SqIdx] == GoK_WhiteQueen)
        {
            Glob.Board.RootWhiteQueenCount += 1;
        }
        If (Board[CalcBoardStats.SqIdx] == GoK_BlackQueen)
        {
            Glob.Board.RootBlackQueenCount += 1;
        }
        If ((Board[CalcBoardStats.SqIdx] == GoK_WhiteKnight) Or ((Board[CalcBoardStats.SqIdx] == GoK_WhiteBishop) Or (Board[CalcBoardStats.SqIdx] == GoK_WhiteRook)))
        {
            Glob.Board.RootWhiteNonQueenMajorMinorCount += 1;
            If (Board[CalcBoardStats.SqIdx] == GoK_WhiteRook)
            {
                CalcBoardStats.WhiteRookCount += 1;
            }
        }
        If ((Board[CalcBoardStats.SqIdx] == GoK_BlackKnight) Or ((Board[CalcBoardStats.SqIdx] == GoK_BlackBishop) Or (Board[CalcBoardStats.SqIdx] == GoK_BlackRook)))
        {
            Glob.Board.RootBlackNonQueenMajorMinorCount += 1;
            If (Board[CalcBoardStats.SqIdx] == GoK_BlackRook)
            {
                CalcBoardStats.BlackRookCount += 1;
            }
        }
        If (Board[CalcBoardStats.SqIdx] == GoK_WhitePawn)
        {
            Glob.Board.RootWhitePawnCount += 1;
        }
        If (Board[CalcBoardStats.SqIdx] == GoK_BlackPawn)
        {
            Glob.Board.RootBlackPawnCount += 1;
        }
        CalcBoardStats.SqIdx += 1;
    }
    Glob.Eval.IsClassicEndgame = 0;
    If (((((Glob.Board.RootBlackPawnCount + Glob.Board.RootBlackQueenCount) + Glob.Board.RootBlackNonQueenMajorMinorCount) + CalcBoardStats.BlackRookCount) == 0) And ((Glob.Board.RootWhiteQueenCount + Glob.Board.RootWhiteNonQueenMajorMinorCount) > 0))
    {
        Glob.Eval.IsClassicEndgame = 1;
    }
    If (((((Glob.Board.RootWhitePawnCount + Glob.Board.RootWhiteQueenCount) + Glob.Board.RootWhiteNonQueenMajorMinorCount) + CalcBoardStats.WhiteRookCount) == 0) And ((Glob.Board.RootBlackQueenCount + Glob.Board.RootBlackNonQueenMajorMinorCount) > 0))
    {
        Glob.Eval.IsClassicEndgame = 1;
    }
    If ((((Glob.Board.RootWhitePawnCount + Glob.Board.RootBlackPawnCount) == 0) And ((Glob.Board.RootWhiteQueenCount == 1) And (Glob.Board.RootWhiteNonQueenMajorMinorCount == 0))) And ((Glob.Board.RootBlackQueenCount == 0) And ((CalcBoardStats.BlackRookCount == 1) And (Glob.Board.RootBlackNonQueenMajorMinorCount == 1))))
    {
        Glob.Eval.IsClassicEndgame = 1;
    }
    If ((((Glob.Board.RootWhitePawnCount + Glob.Board.RootBlackPawnCount) == 0) And ((Glob.Board.RootBlackQueenCount == 1) And (Glob.Board.RootBlackNonQueenMajorMinorCount == 0))) And ((Glob.Board.RootWhiteQueenCount == 0) And ((CalcBoardStats.WhiteRookCount == 1) And (Glob.Board.RootWhiteNonQueenMajorMinorCount == 1))))
    {
        Glob.Eval.IsClassicEndgame = 1;
    }
    If ((((Glob.Board.RootWhiteQueenCount + Glob.Board.RootWhiteNonQueenMajorMinorCount) + (Glob.Board.RootBlackQueenCount + Glob.Board.RootBlackNonQueenMajorMinorCount)) < 3) And ((Glob.Board.RootWhiteQueenCount == 0) Or (Glob.Board.RootBlackQueenCount == 0)))
    {
        Glob.Board.IsLateEndgame = 1;
        Glob.Board.IsEndgame = 1;
    }
    Else
    {
        If ((((Glob.Board.RootWhiteQueenCount * 9) + (Glob.Board.RootWhiteNonQueenMajorMinorCount * 4)) < 10) Or (((Glob.Board.RootBlackQueenCount * 9) + (Glob.Board.RootBlackNonQueenMajorMinorCount * 4)) < 10))
        {
            Glob.Board.IsLateEndgame = 0;
            Glob.Board.IsEndgame = 1;
        }
        Else
        {
            Glob.Board.IsLateEndgame = 0;
            Glob.Board.IsEndgame = 0;
        }
    }
    Glob.Board.WhiteQueenCount = Glob.Board.RootWhiteQueenCount;
    Glob.Board.WhiteNonQueenMajorMinorCount = Glob.Board.RootWhiteNonQueenMajorMinorCount;
    Glob.Board.BlackQueenCount = Glob.Board.RootBlackQueenCount;
    Glob.Board.BlackNonQueenMajorMinorCount = Glob.Board.RootBlackNonQueenMajorMinorCount;
    Glob.Board.WhiteRookCount = CalcBoardStats.WhiteRookCount;
    Glob.Board.BlackRookCount = CalcBoardStats.BlackRookCount;
    Glob.Board.WhitePawnCount = Glob.Board.RootWhitePawnCount;
    Glob.Board.BlackPawnCount = Glob.Board.RootBlackPawnCount;
    List.ReplaceItem(CastlingState, 1, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
    List.ReplaceItem(CastlingState, 2, CastlingState[1]);
}

Define ClearBoardAttacked(num Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 1)
    {
        List.DeleteAll(BoardAttackedByBlack);
        List.DeleteAll(BoardAttackedByBlackPiece);
        Repeat (64)
        {
            List.Add(BoardAttackedByBlack, 0);
            List.Add(BoardAttackedByBlackPiece, 0);
        }
        Glob.Board.IsWhiteChecked = 0;
    }
    Else
    {
        List.DeleteAll(BoardAttackedByWhite);
        List.DeleteAll(BoardAttackedByWhitePiece);
        Repeat (64)
        {
            List.Add(BoardAttackedByWhite, 0);
            List.Add(BoardAttackedByWhitePiece, 0);
        }
        Glob.Board.IsBlackChecked = 0;
    }
}

Define ClearMoveList(num Ply) (warp=true)
{
    List.ReplaceItem(MovesCount, Ply, 0);
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
    }
    Else
    {
        If (Ply == 2)
        {
            List.DeleteAll(Moves2);
        }
    }
}

Define ClearTT (warp=true)
{
    Call //("TT sizes must be powers of two (entries, hence clusters of 4): ResizeTT moves cluster c to c or c + clusters by one bit of the stored key. Scratch 3 (40000) is never resized");
    If (Glob.Config.IsScratch3 == 1)
    {
        Call ClearTTImpl(40000);
    }
    Else
    {
        Call ClearTTImpl(262144);
    }
}

Define ClearTTImpl(string Size) (warp=true)
{
    Call //("Size must be a power of two (entries) for ResizeTT to keep the entries; only the Scratch 3 size 40000 is not, and it is never resized");
    If (List.Length(TTNodeEntry) == (Size * 5))
    {
        ClearTTImpl.EntryIdx = 1;
        Repeat (List.Length(TTNodeEntry))
        {
            List.ReplaceItem(TTNodeEntry, ClearTTImpl.EntryIdx, Const.Null);
            ClearTTImpl.EntryIdx += 1;
        }
    }
    Else
    {
        List.DeleteItem(TTNodeEntry, all);
        Repeat (Size)
        {
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
        }
    }
    Call TTResetSlots;
}

Define CreateCurrentBoardHash (warp=true)
{
    Glob.Board.CurrentHash = 0;
    Glob.Board.NonPawnHashBlack = 0;
    Glob.Board.NonPawnHashWhite = 0;
    Glob.Board.KPHash = 0;
    CreateCurrentBoardHash.SqIdx = 1;
    Repeat (64)
    {
        Call GetPiecePosHash(Board[CreateCurrentBoardHash.SqIdx])(CreateCurrentBoardHash.SqIdx);
        Glob.Board.CurrentHash = (Glob.Board.CurrentHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CreateCurrentBoardHash.SqIdx]) == GoK_BlackPawn)))
        {
            If (Board[CreateCurrentBoardHash.SqIdx] > 0)
            {
                Glob.Board.NonPawnHashBlack += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.Board.NonPawnHashWhite += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CreateCurrentBoardHash.SqIdx]) == GoK_BlackPawn) Or (abs(Board[CreateCurrentBoardHash.SqIdx]) == GoK_BlackKing))
        {
            Glob.Board.KPHash = (Glob.Board.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CreateCurrentBoardHash.SqIdx += 1;
    }
}

Define DrawBoardAndWait (warp=false)
{
    Call StoreExternalBoard;
    List.DeleteAll(GoK_ScreenBoard);
    DrawBoardAndWait.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_ScreenBoard, Board[GoK_ScreenIdx[DrawBoardAndWait.SqIdx]]);
        DrawBoardAndWait.SqIdx += 1;
    }
    If (Glob.Config.IsDCI == 0)
    {
        GoK_ProgressValue = 0;
        Event.BroadcastAndWait("Pieces_DrawBoard");
        Event.BroadcastAndWait("GoK_ProgressValueChanged");
        Event.BroadcastAndWait("GoK_EvaluationValueChanged");
    }
}

Define EBFEN.AddCastling(string CS)(string Off)(string KingSq)(string King)(string Rook)(string KSRookSq)(string QSRookSq)(string KSChar)(string QSChar) (warp=true)
{
    Ret.EBFEN.AddCastling.Text = "";
    If (((CastlingBit[((8 * CS) + (Off + 1))] == 0) And (CastlingBit[((8 * CS) + (Off + 2))] == 0)) And (GoK_Board[KingSq] == King))
    {
        If ((CastlingBit[((8 * CS) + (Off + 3))] == 0) And (GoK_Board[KSRookSq] == Rook))
        {
            Ret.EBFEN.AddCastling.Text = Operator.Join(Ret.EBFEN.AddCastling.Text, KSChar);
        }
        If ((CastlingBit[((8 * CS) + (Off + 4))] == 0) And (GoK_Board[QSRookSq] == Rook))
        {
            Ret.EBFEN.AddCastling.Text = Operator.Join(Ret.EBFEN.AddCastling.Text, QSChar);
        }
    }
}

Define EBFEN.AppendField(string Text) (warp=true)
{
    Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, Operator.Join(" ", Text));
    Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, Operator.Join("_", Text));
}

Define EnterExecution (warp=false)
{
    Glob.Game.ExecutionPly += 1;
    If (Glob.Game.ExecutionPly == 1)
    {
        Glob.Game.IsExecutionRunning = 1;
        Event.BroadcastAndWait("GoK_ModeBusy");
    }
}

Define EvalEndgame(string Ply) (warp=true)
{
    Ret.EvalEndgame.KnownWin = 0;
    Ret.EvalEndgame.Score = Const.Null;
    EvalEndgame.StrongSide = 1;
    Repeat (2)
    {
        If (Ret.EvalEndgame.Score == Const.Null)
        {
            Call EvalEndgame.Material(EvalEndgame.StrongSide);
            EvalEndgame.StrongScore = Const.Null;
            EvalEndgame.StrongKnownWin = 0;
            If (((Ret.EvalEndgame.Material.WeakPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 0)) And ((EvalEndgame.Material.StrongQueenCount + EvalEndgame.Material.StrongRookCount) > 0))
            {
                Call EvalEndgame.Locate(EvalEndgame.StrongSide);
                Call EvalEndgame.PushToEdge(Ret.EvalEndgame.Locate.WeakKingIdx);
                EvalEndgame.Score = (((((EvalEndgame.Material.StrongQueenCount * 2538) + (EvalEndgame.Material.StrongRookCount * 1276)) + ((EvalEndgame.Material.StrongBishopCount * 825) + (EvalEndgame.Material.StrongKnightCount * 781))) + (Ret.EvalEndgame.Material.StrongPawnCount * 208)) + (Ret.EvalEndgame.PushToEdge.Score + (140 - (20 * ChebyshevDistance[((Ret.EvalEndgame.Locate.StrongKingIdx * 100) + Ret.EvalEndgame.Locate.WeakKingIdx)]))));
                EvalEndgame.KW = 1;
                Call EvalEndgame.StrongToMove(Ply)(EvalEndgame.StrongSide);
                If (Ret.EvalEndgame.StrongToMove.IsStrongToMove == 0)
                {
                    EvalEndgame.Weak = Board[Ret.EvalEndgame.Locate.WeakKingIdx];
                    List.ReplaceItem(Board, Ret.EvalEndgame.Locate.WeakKingIdx, 0);
                    EvalEndgame.Mobile = 0;
                    EvalEndgame.InCheck = 0;
                    EvalEndgame.Dir = 0;
                    Repeat (9)
                    {
                        EvalEndgame.Dx = ((EvalEndgame.Dir % 3) - 1);
                        EvalEndgame.Dy = (floor((EvalEndgame.Dir / 3)) - 1);
                        EvalEndgame.To = ((Ret.EvalEndgame.Locate.WeakKingIdx + (EvalEndgame.Dy * 8)) + EvalEndgame.Dx);
                        If (((EvalEndgame.To > 0) And (EvalEndgame.To < 65)) And ((IdxToFile[EvalEndgame.To] - IdxToFile[Ret.EvalEndgame.Locate.WeakKingIdx]) == EvalEndgame.Dx))
                        {
                            EvalEndgame.Att = 0;
                            If (ChebyshevDistance[((Ret.EvalEndgame.Locate.StrongKingIdx * 100) + EvalEndgame.To)] < 2)
                            {
                                EvalEndgame.Att = 1;
                            }
                            EvalEndgame.Sq = 1;
                            Repeat Until ((EvalEndgame.Att == 1) Or (EvalEndgame.Sq > 64))
                            {
                                If ((((Board[EvalEndgame.Sq] * EvalEndgame.StrongSide) > 0) And (Not ((EvalEndgame.Sq == EvalEndgame.To)))) And (Not ((EvalEndgame.Sq == Ret.EvalEndgame.Locate.StrongKingIdx))))
                                {
                                    Call IsReachableForAttack(Board[EvalEndgame.Sq])(EvalEndgame.Sq)(EvalEndgame.To);
                                    If (Ret.IsReachableForAttack.IsReachable == 1)
                                    {
                                        EvalEndgame.Att = 1;
                                    }
                                }
                                EvalEndgame.Sq += 1;
                            }
                            If (EvalEndgame.Dir == 4)
                            {
                                EvalEndgame.InCheck = EvalEndgame.Att;
                            }
                            Else
                            {
                                If (EvalEndgame.Att == 0)
                                {
                                    EvalEndgame.Mobile = 1;
                                }
                            }
                        }
                        EvalEndgame.Dir += 1;
                    }
                    List.ReplaceItem(Board, Ret.EvalEndgame.Locate.WeakKingIdx, EvalEndgame.Weak);
                    If ((EvalEndgame.InCheck == 0) And (EvalEndgame.Mobile == 0))
                    {
                        EvalEndgame.Score = 0;
                        EvalEndgame.KW = 0;
                    }
                }
                EvalEndgame.StrongScore = EvalEndgame.Score;
                EvalEndgame.StrongKnownWin = EvalEndgame.KW;
            }
            If (Ret.EvalEndgame.Material.StrongPawnCount == 0)
            {
                If ((Ret.EvalEndgame.Material.WeakPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 1))
                {
                    If (Ret.EvalEndgame.Material.StrongPiecesAreRook == 1)
                    {
                        Call EvalEndgame.KRKP(Ply)(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KRKP.Score;
                    }
                    If (Ret.EvalEndgame.Material.StrongPiecesAreQueen == 1)
                    {
                        Call EvalEndgame.KQKP(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KQKP.Score;
                    }
                    If (Ret.EvalEndgame.Material.StrongPiecesAreTwoKnights == 1)
                    {
                        Call EvalEndgame.KNNKP(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KNNKP.Score;
                    }
                }
                If (Ret.EvalEndgame.Material.WeakPawnCount == 0)
                {
                    If ((Ret.EvalEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1))
                    {
                        Call EvalEndgame.KRKB(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KRKB.Score;
                    }
                    If ((Ret.EvalEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvalEndgame.Material.WeakPiecesAreKnight == 1))
                    {
                        Call EvalEndgame.KRKN(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KRKN.Score;
                    }
                    If ((Ret.EvalEndgame.Material.StrongPiecesAreQueen == 1) And (Ret.EvalEndgame.Material.WeakPiecesAreRook == 1))
                    {
                        Call EvalEndgame.KQKR(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KQKR.Score;
                    }
                }
            }
            If (((Ret.EvalEndgame.Material.StrongPawnCount == 1) And (Ret.EvalEndgame.Material.StrongPiecesAreNone == 1)) And ((Ret.EvalEndgame.Material.WeakPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 0)))
            {
                Call EvalEndgame.KPK(Ply)(EvalEndgame.StrongSide);
                EvalEndgame.StrongScore = Ret.EvalEndgame.KPK.Score;
                EvalEndgame.StrongKnownWin = Ret.EvalEndgame.KPK.IsWin;
            }
            If (Not ((EvalEndgame.StrongScore == Const.Null)))
            {
                Ret.EvalEndgame.Score = (EvalEndgame.StrongSide * Operator.Round((EvalEndgame.StrongScore * 0.35)));
                Ret.EvalEndgame.KnownWin = (EvalEndgame.StrongSide * EvalEndgame.StrongKnownWin);
            }
        }
        EvalEndgame.StrongSide = (0 - EvalEndgame.StrongSide);
    }
}

Define EvalEndgame.BishopSees(string FromIdx)(string BishopIdx) (warp=true)
{
    Ret.EvalEndgame.BishopSees.IsSeen = 0;
    EvalEndgame.BishopSees.FileDelta = (IdxToFile[BishopIdx] - IdxToFile[FromIdx]);
    EvalEndgame.BishopSees.RankDelta = (IdxToRank[BishopIdx] - IdxToRank[FromIdx]);
    If ((abs(EvalEndgame.BishopSees.FileDelta) == abs(EvalEndgame.BishopSees.RankDelta)) And (Not ((EvalEndgame.BishopSees.FileDelta == 0))))
    {
        EvalEndgame.BishopSees.Step = ((((EvalEndgame.BishopSees.RankDelta > 0) - (EvalEndgame.BishopSees.RankDelta < 0)) * 8) + ((EvalEndgame.BishopSees.FileDelta > 0) - (EvalEndgame.BishopSees.FileDelta < 0)));
        EvalEndgame.BishopSees.SqIdx = (FromIdx + EvalEndgame.BishopSees.Step);
        Ret.EvalEndgame.BishopSees.IsSeen = 1;
        Repeat ((abs(EvalEndgame.BishopSees.FileDelta) - 1))
        {
            If (Not ((Board[EvalEndgame.BishopSees.SqIdx] == 0)))
            {
                Ret.EvalEndgame.BishopSees.IsSeen = 0;
            }
            EvalEndgame.BishopSees.SqIdx += EvalEndgame.BishopSees.Step;
        }
    }
}

Define EvalEndgame.KBPKB(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KBPKB.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    Call EvalEndgame.KingBlocksBishopPawn(StrongSide);
    If (Ret.EvalEndgame.KingBlocksBishopPawn.IsBlocked == 1)
    {
        Ret.EvalEndgame.KBPKB.Factor = 0;
        Stop(this script);
    }
    EvalEndgame.KBPKB.StrongBishopIdx = Ret.EvalEndgame.Locate.StrongBishopIdx;
    EvalEndgame.KBPKB.WeakBishopIdx = Ret.EvalEndgame.Locate.WeakBishopIdx;
    EvalEndgame.KBPKB.StrongBishopColour = ((IdxToFile[EvalEndgame.KBPKB.StrongBishopIdx] + IdxToRank[EvalEndgame.KBPKB.StrongBishopIdx]) % 2);
    EvalEndgame.KBPKB.WeakBishopColour = ((IdxToFile[EvalEndgame.KBPKB.WeakBishopIdx] + IdxToRank[EvalEndgame.KBPKB.WeakBishopIdx]) % 2);
    If (Not ((EvalEndgame.KBPKB.StrongBishopColour == EvalEndgame.KBPKB.WeakBishopColour)))
    {
        Ret.EvalEndgame.KBPKB.Factor = 0;
    }
}

Define EvalEndgame.KBPKN(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KBPKN.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    Call EvalEndgame.KingBlocksBishopPawn(StrongSide);
    If (Ret.EvalEndgame.KingBlocksBishopPawn.IsBlocked == 1)
    {
        Ret.EvalEndgame.KBPKN.Factor = 0;
    }
}

Define EvalEndgame.KBPPKB(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KBPPKB.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    EvalEndgame.KBPPKB.StrongBishopIdx = Ret.EvalEndgame.Locate.StrongBishopIdx;
    EvalEndgame.KBPPKB.WeakBishopIdx = Ret.EvalEndgame.Locate.WeakBishopIdx;
    EvalEndgame.KBPPKB.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
    EvalEndgame.KBPPKB.PawnIdx1 = Ret.EvalEndgame.Locate.StrongPawnIdx;
    EvalEndgame.KBPPKB.PawnIdx2 = Ret.EvalEndgame.Locate.SecondStrongPawnIdx;
    EvalEndgame.KBPPKB.Push = Ret.EvalEndgame.Locate.PawnPushIdxDelta;
    If (((IdxToFile[EvalEndgame.KBPPKB.StrongBishopIdx] + IdxToRank[EvalEndgame.KBPPKB.StrongBishopIdx]) % 2) == ((IdxToFile[EvalEndgame.KBPPKB.WeakBishopIdx] + IdxToRank[EvalEndgame.KBPPKB.WeakBishopIdx]) % 2))
    {
        Stop(this script);
    }
    EvalEndgame.KBPPKB.Rank1 = (Ret.EvalEndgame.Locate.RelativeRankBase + (Ret.EvalEndgame.Locate.RelativeRankSign * IdxToRank[EvalEndgame.KBPPKB.PawnIdx1]));
    EvalEndgame.KBPPKB.Rank2 = (Ret.EvalEndgame.Locate.RelativeRankBase + (Ret.EvalEndgame.Locate.RelativeRankSign * IdxToRank[EvalEndgame.KBPPKB.PawnIdx2]));
    If (EvalEndgame.KBPPKB.Rank1 > EvalEndgame.KBPPKB.Rank2)
    {
        EvalEndgame.KBPPKB.Block1 = (EvalEndgame.KBPPKB.PawnIdx1 + EvalEndgame.KBPPKB.Push);
        EvalEndgame.KBPPKB.Block2 = (((IdxToRank[EvalEndgame.KBPPKB.PawnIdx1] - 1) * 8) + IdxToFile[EvalEndgame.KBPPKB.PawnIdx2]);
    }
    Else
    {
        EvalEndgame.KBPPKB.Block1 = (EvalEndgame.KBPPKB.PawnIdx2 + EvalEndgame.KBPPKB.Push);
        EvalEndgame.KBPPKB.Block2 = (((IdxToRank[EvalEndgame.KBPPKB.PawnIdx2] - 1) * 8) + IdxToFile[EvalEndgame.KBPPKB.PawnIdx1]);
    }
    EvalEndgame.KBPPKB.FileDist = abs((IdxToFile[EvalEndgame.KBPPKB.PawnIdx1] - IdxToFile[EvalEndgame.KBPPKB.PawnIdx2]));
    If (EvalEndgame.KBPPKB.FileDist == 0)
    {
        If ((IdxToFile[EvalEndgame.KBPPKB.WeakKingIdx] == IdxToFile[EvalEndgame.KBPPKB.Block1]) And ((Not (((Ret.EvalEndgame.Locate.RelativeRankBase + (Ret.EvalEndgame.Locate.RelativeRankSign * IdxToRank[EvalEndgame.KBPPKB.WeakKingIdx])) < (Ret.EvalEndgame.Locate.RelativeRankBase + (Ret.EvalEndgame.Locate.RelativeRankSign * IdxToRank[EvalEndgame.KBPPKB.Block1]))))) And (Not ((((IdxToFile[EvalEndgame.KBPPKB.WeakKingIdx] + IdxToRank[EvalEndgame.KBPPKB.WeakKingIdx]) % 2) == ((IdxToFile[EvalEndgame.KBPPKB.StrongBishopIdx] + IdxToRank[EvalEndgame.KBPPKB.StrongBishopIdx]) % 2))))))
        {
            Ret.EvalEndgame.KBPPKB.Factor = 0;
        }
    }
    If (EvalEndgame.KBPPKB.FileDist == 1)
    {
        Call EvalEndgame.BishopSees(EvalEndgame.KBPPKB.Block1)(EvalEndgame.KBPPKB.WeakBishopIdx);
        EvalEndgame.KBPPKB.Sees1 = Ret.EvalEndgame.BishopSees.IsSeen;
        Call EvalEndgame.BishopSees(EvalEndgame.KBPPKB.Block2)(EvalEndgame.KBPPKB.WeakBishopIdx);
        EvalEndgame.KBPPKB.Sees2 = Ret.EvalEndgame.BishopSees.IsSeen;
        If (((EvalEndgame.KBPPKB.WeakKingIdx == EvalEndgame.KBPPKB.Block1) And (Not ((((IdxToFile[EvalEndgame.KBPPKB.WeakKingIdx] + IdxToRank[EvalEndgame.KBPPKB.WeakKingIdx]) % 2) == ((IdxToFile[EvalEndgame.KBPPKB.StrongBishopIdx] + IdxToRank[EvalEndgame.KBPPKB.StrongBishopIdx]) % 2))))) And (((EvalEndgame.KBPPKB.WeakBishopIdx == EvalEndgame.KBPPKB.Block2) Or (EvalEndgame.KBPPKB.Sees2 == 1)) Or (abs((IdxToRank[EvalEndgame.KBPPKB.PawnIdx1] - IdxToRank[EvalEndgame.KBPPKB.PawnIdx2])) > 1)))
        {
            Ret.EvalEndgame.KBPPKB.Factor = 0;
        }
        Else
        {
            If (((EvalEndgame.KBPPKB.WeakKingIdx == EvalEndgame.KBPPKB.Block2) And (Not ((((IdxToFile[EvalEndgame.KBPPKB.WeakKingIdx] + IdxToRank[EvalEndgame.KBPPKB.WeakKingIdx]) % 2) == ((IdxToFile[EvalEndgame.KBPPKB.StrongBishopIdx] + IdxToRank[EvalEndgame.KBPPKB.StrongBishopIdx]) % 2))))) And ((EvalEndgame.KBPPKB.WeakBishopIdx == EvalEndgame.KBPPKB.Block1) Or (EvalEndgame.KBPPKB.Sees1 == 1)))
            {
                Ret.EvalEndgame.KBPPKB.Factor = 0;
            }
        }
    }
}

Define EvalEndgame.KBPsK(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KBPsK.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    EvalEndgame.KBPsK.StrongKingIdx = Ret.EvalEndgame.Locate.StrongKingIdx;
    EvalEndgame.KBPsK.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
    EvalEndgame.KBPsK.StrongBishopIdx = Ret.EvalEndgame.Locate.StrongBishopIdx;
    EvalEndgame.KBPsK.RelativeRankBase = Ret.EvalEndgame.Locate.RelativeRankBase;
    EvalEndgame.KBPsK.RelativeRankSign = Ret.EvalEndgame.Locate.RelativeRankSign;
    EvalEndgame.KBPsK.PawnPushIdxDelta = Ret.EvalEndgame.Locate.PawnPushIdxDelta;
    EvalEndgame.KBPsK.BishopColour = ((IdxToFile[EvalEndgame.KBPsK.StrongBishopIdx] + IdxToRank[EvalEndgame.KBPsK.StrongBishopIdx]) % 2);
    Call EvalEndgame.PawnScan(StrongSide)(EvalEndgame.KBPsK.WeakKingIdx)(0);
    EvalEndgame.KBPsK.StrongPawnCount = Ret.EvalEndgame.PawnScan.StrongPawnCount;
    If ((Ret.EvalEndgame.PawnScan.StrongPawnOnFileACount == EvalEndgame.KBPsK.StrongPawnCount) Or (Ret.EvalEndgame.PawnScan.StrongPawnOnFileHCount == EvalEndgame.KBPsK.StrongPawnCount))
    {
        EvalEndgame.KBPsK.PawnIdx = Ret.EvalEndgame.Locate.StrongPawnIdx;
        EvalEndgame.KBPsK.PawnRelativeRank = (EvalEndgame.KBPsK.RelativeRankBase + (EvalEndgame.KBPsK.RelativeRankSign * IdxToRank[EvalEndgame.KBPsK.PawnIdx]));
        EvalEndgame.KBPsK.QueeningSqIdx = (EvalEndgame.KBPsK.PawnIdx + (EvalEndgame.KBPsK.PawnPushIdxDelta * (7 - EvalEndgame.KBPsK.PawnRelativeRank)));
        EvalEndgame.KBPsK.QueeningSqColour = ((IdxToFile[EvalEndgame.KBPsK.QueeningSqIdx] + IdxToRank[EvalEndgame.KBPsK.QueeningSqIdx]) % 2);
        EvalEndgame.KBPsK.WeakKingQueeningDistance = ChebyshevDistance[((EvalEndgame.KBPsK.QueeningSqIdx * 100) + EvalEndgame.KBPsK.WeakKingIdx)];
        If ((Not ((EvalEndgame.KBPsK.QueeningSqColour == EvalEndgame.KBPsK.BishopColour))) And (EvalEndgame.KBPsK.WeakKingQueeningDistance < 2))
        {
            Ret.EvalEndgame.KBPsK.Factor = 0;
            Stop(this script);
        }
    }
    Call EvalEndgame.Material(StrongSide);
    EvalEndgame.KBPsK.HasWeakOnlyPawns = 0;
    If ((Ret.EvalEndgame.Material.WeakPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPawnCount > 0))
    {
        EvalEndgame.KBPsK.HasWeakOnlyPawns = 1;
    }
    EvalEndgame.KBPsK.PawnCount = Ret.EvalEndgame.PawnScan.PawnCount;
    EvalEndgame.KBPsK.IsAllPawnsOnBOrGFile = 0;
    If ((Ret.EvalEndgame.PawnScan.PawnOnFileBCount == EvalEndgame.KBPsK.PawnCount) Or (Ret.EvalEndgame.PawnScan.PawnOnFileGCount == EvalEndgame.KBPsK.PawnCount))
    {
        EvalEndgame.KBPsK.IsAllPawnsOnBOrGFile = 1;
    }
    If ((EvalEndgame.KBPsK.IsAllPawnsOnBOrGFile == 1) And (EvalEndgame.KBPsK.HasWeakOnlyPawns == 1))
    {
        EvalEndgame.KBPsK.WeakPawnIdx = Ret.EvalEndgame.PawnScan.WeakFrontPawnIdx;
        EvalEndgame.KBPsK.WeakPawnRelativeRank = (EvalEndgame.KBPsK.RelativeRankBase + (EvalEndgame.KBPsK.RelativeRankSign * IdxToRank[EvalEndgame.KBPsK.WeakPawnIdx]));
        EvalEndgame.KBPsK.IsWeakPawnBlocked = 0;
        If ((Board[(EvalEndgame.KBPsK.WeakPawnIdx - EvalEndgame.KBPsK.PawnPushIdxDelta)] * StrongSide) == GoK_BlackPawn)
        {
            EvalEndgame.KBPsK.IsWeakPawnBlocked = 1;
        }
        EvalEndgame.KBPsK.WeakPawnColour = ((IdxToFile[EvalEndgame.KBPsK.WeakPawnIdx] + IdxToRank[EvalEndgame.KBPsK.WeakPawnIdx]) % 2);
        EvalEndgame.KBPsK.IsBishopUseless = 0;
        If ((Not ((EvalEndgame.KBPsK.WeakPawnColour == EvalEndgame.KBPsK.BishopColour))) Or (EvalEndgame.KBPsK.StrongPawnCount == 1))
        {
            EvalEndgame.KBPsK.IsBishopUseless = 1;
        }
        If (((EvalEndgame.KBPsK.WeakPawnRelativeRank == 6) And (EvalEndgame.KBPsK.IsWeakPawnBlocked == 1)) And (EvalEndgame.KBPsK.IsBishopUseless == 1))
        {
            EvalEndgame.KBPsK.StrongKingDistance = ChebyshevDistance[((EvalEndgame.KBPsK.WeakPawnIdx * 100) + EvalEndgame.KBPsK.StrongKingIdx)];
            EvalEndgame.KBPsK.WeakKingDistance = ChebyshevDistance[((EvalEndgame.KBPsK.WeakPawnIdx * 100) + EvalEndgame.KBPsK.WeakKingIdx)];
            EvalEndgame.KBPsK.WeakKingRelativeRank = (EvalEndgame.KBPsK.RelativeRankBase + (EvalEndgame.KBPsK.RelativeRankSign * IdxToRank[EvalEndgame.KBPsK.WeakKingIdx]));
            If ((EvalEndgame.KBPsK.WeakKingRelativeRank > 5) And ((EvalEndgame.KBPsK.WeakKingDistance < 3) And (Not ((EvalEndgame.KBPsK.WeakKingDistance > EvalEndgame.KBPsK.StrongKingDistance)))))
            {
                Ret.EvalEndgame.KBPsK.Factor = 0;
            }
        }
    }
}

Define EvalEndgame.KingBlocksBishopPawn(string StrongSide) (warp=true)
{
    EvalEndgame.KingBlocksBishopPawn.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
    EvalEndgame.KingBlocksBishopPawn.PawnIdx = Ret.EvalEndgame.Locate.StrongPawnIdx;
    EvalEndgame.KingBlocksBishopPawn.BishopIdx = Ret.EvalEndgame.Locate.StrongBishopIdx;
