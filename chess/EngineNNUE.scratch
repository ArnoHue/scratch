    List.Add(TmpList1, 2);
    List.Add(TmpList1, 3);
    List.Add(TmpList1, 4);
    List.Add(TmpList1, 5);
    List.Add(TmpList1, 6);
    List.Add(TmpList1, 7);
    List.Add(TmpList1, 8);
    List.Add(TmpList1, 9);
    List.Add(TmpList1, "a");
    List.Add(TmpList1, "b");
    List.Add(TmpList1, "c");
    List.Add(TmpList1, "d");
    List.Add(TmpList1, "e");
    List.Add(TmpList1, "f");
    Call NNUE_LoadList(CSV);
    Ret.NNUE_DecToHex.Hex = "";
    NNUE_DecToHex.Idx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        NNUE_DecToHex.Word = NNUE_ListRes_1[NNUE_DecToHex.Idx];
        If (NNUE_DecToHex.Word < 0)
        {
            NNUE_DecToHex.Word = (2048 - NNUE_DecToHex.Word);
        }
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE_DecToHex.Word / 256)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE_DecToHex.Word / 16)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((NNUE_DecToHex.Word % 16) + 1)]);
        NNUE_DecToHex.Idx += 1;
    }
    NNUE_DecToHex.Idx = 1;
    Repeat (List.Length(NNUE_ListRes_2))
    {
        NNUE_DecToHex.Word = NNUE_ListRes_2[NNUE_DecToHex.Idx];
        If (NNUE_DecToHex.Word < 0)
        {
            NNUE_DecToHex.Word = (2048 - NNUE_DecToHex.Word);
        }
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE_DecToHex.Word / 256)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((floor((NNUE_DecToHex.Word / 16)) % 16) + 1)]);
        Ret.NNUE_DecToHex.Hex = Operator.Join(Ret.NNUE_DecToHex.Hex, TmpList1[((NNUE_DecToHex.Word % 16) + 1)]);
        NNUE_DecToHex.Idx += 1;
    }
}

