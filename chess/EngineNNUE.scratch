Define IsBlackKingCheckMate (warp=true)
{
    Ret.IsBlackKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(2);
    If (Glob.Board.IsBlackChecked == 1)
    {
        Ret.IsBlackKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(1);
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(1)((1 == 1));
                Call CalcBoardAttackedByMove(2);
                If (Glob.Board.IsBlackChecked == 0)
                {
                    Ret.IsBlackKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(1);
            }
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
}

Define IsCastlingPathSafe(string Move)(string Ply) (warp=true)
{
    Ret.IsCastlingPathSafe.IsSafe = 1;
    If (floor((Move / 100)) == 0)
    {
        IsCastlingPathSafe.FirstIdx = 0;
        If (Move == GoK_BlackQueensideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 3;
        }
        If (Move == GoK_BlackKingsideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 5;
        }
        If (Move == GoK_WhiteQueensideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 59;
        }
        If (Move == GoK_WhiteKingsideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 61;
        }
        If (IsCastlingPathSafe.FirstIdx > 0)
        {
            Call CalcBoardAttackedOnDemand(Ply)((1 == 0))((1 == 1))(99);
            IsCastlingPathSafe.BaseIdx = ((Ply - 1) * Const.SnapshotPlyStride);
            If (Not (((BoardAttackedByOpponentSnapshot[(IsCastlingPathSafe.BaseIdx + IsCastlingPathSafe.FirstIdx)] == 0) And ((BoardAttackedByOpponentSnapshot[(IsCastlingPathSafe.BaseIdx + (IsCastlingPathSafe.FirstIdx + 1))] == 0) And (BoardAttackedByOpponentSnapshot[(IsCastlingPathSafe.BaseIdx + (IsCastlingPathSafe.FirstIdx + 2))] == 0)))))
            {
                Ret.IsCastlingPathSafe.IsSafe = 0;
            }
        }
    }
}

Define IsCheckedFast(string CheckingPly) (warp=true)
{
    IsCheckedFast.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    IsCheckedFast.SideOffset = ((IsCheckedFast.Factor > 0) * 60000);
    Ret.IsCheckedFast.IsChecked = 0;
    If (IsCheckedFast.Factor > 0)
    {
        IsCheckedFast.KingIdx = Glob.Board.WhiteKingIdx;
    }
    Else
    {
        IsCheckedFast.KingIdx = Glob.Board.BlackKingIdx;
    }
    IsCheckedFast.SqIdx = 1;
    Repeat (64)
    {
        If ((Board[IsCheckedFast.SqIdx] * IsCheckedFast.Factor) > 0)
        {
            If (Not ((MoveToHash[((IsCheckedFast.SideOffset + (PieceIdxLookup[abs(Board[IsCheckedFast.SqIdx])] * 10000)) + ((IsCheckedFast.SqIdx * 100) + IsCheckedFast.KingIdx))] == 0)))
            {
                Call IsCheckingPiece(IsCheckedFast.SqIdx);
                If (Ret.IsCheckingPiece.IsChecking == 1)
                {
                    Ret.IsCheckedFast.IsChecked = 1;
                    Ret.IsCheckedFast.CheckedByIdx = IsCheckedFast.SqIdx;
                    Stop(this script);
                }
            }
        }
        IsCheckedFast.SqIdx += 1;
    }
}

Define IsCheckingPiece(string Idx) (warp=true)
{
    Call IsCheckingPieceImpl(Idx)(Board[(Idx + 0)]);
    Ret.IsCheckingPiece.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
}

Define IsCheckingPieceDiscovery(string SourceIdx)(string TargetIdx)(string Ply) (warp=true)
{
    Call IsCheckingPieceImpl(SourceIdx)((GoK_BlackQueen * ((2 * PlyIsOwn[Ply]) - 1)));
    Ret.IsCheckingPieceDiscovery.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 0)
    {
        Stop(this script);
    }
    Call CalcBoardAttacked((Ply + 2));
    If (((PlyIsOwn[Ply] == 1) And (Glob.Board.IsWhiteChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.Board.IsBlackChecked == 1)))
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 1;
    }
    Else
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 0;
    }
}

Define IsCheckingPieceImpl(string Idx)(string Piece) (warp=true)
{
    Ret.IsCheckingPieceImpl.IsChecking = 0;
    If (abs(Piece) == GoK_BlackKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.Board.WhiteKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.Board.BlackKingIdx);
    }
    Ret.IsCheckingPieceImpl.IsChecking = Ret.IsReachableForAttack.IsReachable;
}

Define IsDrawByMaterial (warp=true)
{
    IsDrawByMaterial.BlackMinorCnt = 0;
    IsDrawByMaterial.WhiteMinorCnt = 0;
    IsDrawByMaterial.SqIdx = 1;
    Ret.IsDrawByMaterial.IsDraw = 0;
    Repeat (64)
    {
        IsDrawByMaterial.Piece = Board[IsDrawByMaterial.SqIdx];
        If (Not ((IsDrawByMaterial.Piece == 0)))
        {
            If ((IsDrawByMaterial.Piece == GoK_BlackBishop) Or (IsDrawByMaterial.Piece == GoK_BlackKnight))
            {
                IsDrawByMaterial.BlackMinorCnt += 1;
            }
            Else
            {
                If ((IsDrawByMaterial.Piece == GoK_WhiteBishop) Or (IsDrawByMaterial.Piece == GoK_WhiteKnight))
                {
                    IsDrawByMaterial.WhiteMinorCnt += 1;
                }
                Else
                {
                    If (Not ((abs(IsDrawByMaterial.Piece) == GoK_BlackKing)))
                    {
                        Stop(this script);
                    }
                }
            }
        }
        IsDrawByMaterial.SqIdx += 1;
    }
    If ((IsDrawByMaterial.BlackMinorCnt + IsDrawByMaterial.WhiteMinorCnt) < 2)
    {
        Ret.IsDrawByMaterial.IsDraw = 1;
    }
}

Define IsDrawByStalemate(string Ply) (warp=true)
{
    Call CalcBoardAttacked((Ply + 1));
    If (((PlyIsOwn[Ply] == 1) And (Glob.Board.IsBlackChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.Board.IsWhiteChecked == 1)))
    {
        Ret.IsDrawByStalemate.IsDraw = 0;
        Stop(this script);
    }
    List.ReplaceItem(Quiescence, Ply, 0);
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0))((1 == 0));
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    If (Quiescence[Ply] == 1)
    {
        Glob.Stats.MoveCount += MovesCount[Ply];
    }
    Else
    {
        Glob.Stats.MoveCountQuiescence += MovesCount[Ply];
    }
    Ret.IsDrawByStalemate.IsDraw = 1;
    List.ReplaceItem(MovesIdx, Ply, 1);
    Repeat (MovesCount[Ply])
    {
        Call ApplyMoveLight(Ply);
        Call CalcBoardAttacked((Ply + 1));
        If (((PlyIsOwn[Ply] == 1) And (Glob.Board.IsBlackChecked == 0)) Or ((PlyIsOwn[Ply] == 0) And (Glob.Board.IsWhiteChecked == 0)))
        {
            Ret.IsDrawByStalemate.IsDraw = 0;
            Call RevertMoveLight(Ply);
            Stop(this script);
        }
        Call RevertMoveLight(Ply);
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
    }
}

Define IsEngineValidMove(string Move) (warp=true)
{
    Call GenerateMovesPublic(1);
    If (Move == Const.Null)
    {
        Ret.IsEngineValidMove.IsValid = 0;
    }
    Else
    {
        If List.ContainsItem(Moves1, Move)
        {
            Ret.IsEngineValidMove.IsValid = 1;
        }
        Else
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
    }
    If (Ret.IsEngineValidMove.IsValid == 1)
    {
        Call ClearMoveList(1);
        Call AddMoveToList((Move + 0))(1)(0);
        List.ReplaceItem(MovesIdx, 1, 1);
        Glob.Board.IsWhiteChecked = 0;
        Glob.Board.IsBlackChecked = 0;
        Call ApplyMove(1)((1 == 0));
        Call CalcBoardAttackedByMove(2);
        If (((Glob.Game.IsPlayerBlack == 1) And (Glob.Board.IsWhiteChecked == 1)) Or ((Glob.Game.IsPlayerBlack == 0) And (Glob.Board.IsBlackChecked == 1)))
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
        Call RevertMove(1);
    }
}

Define IsLosingCapture(string Ply)(string Move)(string AttackerPiece)(string VictimPiece) (warp=true)
{
    Ret.IsLosingCapture.IsLosing = 0;
    If ((Not ((Glob.Config.IsScratch3 == 1))) And (Not (((PieceIdxLookup[abs(VictimPiece)] + 1) > PieceIdxLookup[abs(AttackerPiece)]))))
    {
        Call ClearMoveList((Ply + 2));
        Call AddMoveToList(Move)((Ply + 2))(0);
        List.ReplaceItem(MovesIdx, (Ply + 2), 1);
        Call ApplyMoveLight((Ply + 2));
        Call SEE((Ply + 2))((1 == 0));
        IsLosingCapture.SeeGain = Ret.SEE.Gain;
        Call RevertMoveLight((Ply + 2));
        If (IsLosingCapture.SeeGain < ((0 - Const.SeeLosingCaptureMargin) - (abs(VictimPiece) / Const.SeeLosingCaptureVictimDivisor)))
        {
            Ret.IsLosingCapture.IsLosing = 1;
        }
    }
}

Define IsLowerCase(string Char) (warp=true)
{
    IsLowerCase.Chars = "";
    IsLowerCase.CharsIdx = 1;
    Repeat (Variable.Length(Const.CharsUpperCase))
    {
        If (Operator.LetterOf(Const.CharsUpperCase, IsLowerCase.CharsIdx) == Char)
        {
            IsLowerCase.Chars = Operator.Join(IsLowerCase.Chars, Char);
        }
        Else
        {
            IsLowerCase.Chars = Operator.Join(IsLowerCase.Chars, Operator.LetterOf(Const.CharsUpperCase, IsLowerCase.CharsIdx));
        }
        IsLowerCase.CharsIdx += 1;
    }
    Looks.SwitchCostumeTo(_ABCDEFGHIJKLMNOPQRSTUVWXYZ);
    Looks.SwitchCostumeTo(IsLowerCase.Chars);
    If (Costume.GetNumberName(number) == 1)
    {
        Ret.IsLowerCase.IsLower = 0;
    }
    Else
    {
        Ret.IsLowerCase.IsLower = 1;
    }
}

Define IsMoveLegalFast(string Ply) (warp=true)
{
    If ((CheckedState[Ply] == 1) Or (floor((AppliedMove[Ply] / 100)) == 0))
    {
        Call IsCheckedFast((Ply + 1));
        Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        IsMoveLegalFast.FromIdx = floor((AppliedMove[Ply] / 100));
        IsMoveLegalFast.ToIdx = floor((AppliedMove[Ply] % 100));
        If ((abs(SourcePieces[Ply]) == GoK_BlackKing) Or (Not ((TargetPiecesIdx[Ply] == IsMoveLegalFast.ToIdx))))
        {
            Call IsCheckedFast((Ply + 1));
            Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            Ret.IsMoveLegalFast.IsLegal = 0;
            IsMoveLegalFast.PinIdx = 1;
            Repeat (PinCount[Ply])
            {
                If (PinSq[(((Ply - 1) * Const.CheckInfoPlyStride) + IsMoveLegalFast.PinIdx)] == IsMoveLegalFast.FromIdx)
                {
                    If (Not ((abs(MoveToPathStepInc[((IsMoveLegalFast.FromIdx * 100) + IsMoveLegalFast.ToIdx)]) == PinRay[(((Ply - 1) * Const.CheckInfoPlyStride) + IsMoveLegalFast.PinIdx)])))
                    {
                        Ret.IsMoveLegalFast.IsLegal = 1;
                    }
                }
                IsMoveLegalFast.PinIdx += 1;
            }
            If (Glob.Profile.Mode == Const.ProfilerMode.Full)
            {
                IsMoveLegalFast.IsChecked = Ret.IsMoveLegalFast.IsLegal;
                Call IsCheckedFast((Ply + 1));
                Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
                If (Not ((IsMoveLegalFast.IsChecked == Ret.IsMoveLegalFast.IsLegal)))
                {
                    Call Log("CheckInfoMismatch legal depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(IsMoveLegalFast.IsChecked)(" old=")(Ret.IsMoveLegalFast.IsLegal);
                }
            }
        }
    }
}

Define IsMovePicked(string Ply)(string Move) (warp=true)
{
    IsMovePicked.PickedScanIdx = 1;
    Ret.IsMovePicked.Picked = 0;
    Repeat Until (IsMovePicked.PickedScanIdx > PickedPseudoLegalMovesCount[Ply])
    {
        If (PickedPseudoLegalMoves[(((Ply - 1) * Const.MaxMovesPerGeneration) + IsMovePicked.PickedScanIdx)] == Move)
        {
            Ret.IsMovePicked.Picked = 1;
            Ret.IsMovePicked.Score = PickedPseudoLegalMovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + IsMovePicked.PickedScanIdx)];
            Stop(this script);
        }
        IsMovePicked.PickedScanIdx += 1;
    }
}

Define IsOwnKingCheckMate (warp=true)
{
    If (Glob.Game.IsPlayerBlack == 1)
    {
        Call IsWhiteKingCheckMate;
        Ret.IsOwnKingCheckMate.IsCheckMate = Ret.IsWhiteKingCheckMate.IsCheckMate;
    }
    Else
    {
        Call IsBlackKingCheckMate;
        Ret.IsOwnKingCheckMate.IsCheckMate = Ret.IsBlackKingCheckMate.IsCheckMate;
    }
}

Define IsQuiescentCheckCond(string Ply) (warp=true)
{
    Call //("Quiescence search extension for checking moves, esp. check sequences. Return value defined whether check sequences should pursued at this point");
    Ret.IsQuiescentCheckCond.IsTrue = 0;
    If (1 == 0)
    {
        If (Glob.Config.IsScratch3 == 0)
        {
            If ((Quiescence[Ply] == 1) And (Quiescence[(Ply - 1)] == 0))
            {
                Ret.IsQuiescentCheckCond.IsTrue = 1;
            }
        }
    }
}

Define IsQuietMove(string Move) (warp=true)
{
    Ret.IsQuietMove.IsQuiet = 0;
    IsQuietMove.FromIdx = floor((Move / 100));
    IsQuietMove.ToIdx = floor((Move % 100));
    If (IsQuietMove.FromIdx == 0)
    {
        Ret.IsQuietMove.IsQuiet = 1;
        Stop(this script);
    }
    If (Not ((Board[IsQuietMove.ToIdx] == 0)))
    {
        Stop(this script);
    }
    If (Not ((Move == floor(Move))))
    {
        Stop(this script);
    }
    If (abs(Board[IsQuietMove.FromIdx]) == GoK_BlackPawn)
    {
        If (Not ((IdxToFile[IsQuietMove.FromIdx] == IdxToFile[IsQuietMove.ToIdx])))
        {
            Stop(this script);
        }
    }
    Ret.IsQuietMove.IsQuiet = 1;
}

Define IsReachableForAttack(string Piece)(string FromIdx)(string ToIdx) (warp=true)
{
    Ret.IsReachableForAttack.IsReachable = 0;
    IsReachableForAttack.PieceAbs = abs(Piece);
    IsReachableForAttack.LegalMoveKey = ((PieceIdxLookup[IsReachableForAttack.PieceAbs] * 10000) + ((FromIdx * 100) + ToIdx));
    If (Piece > 0)
    {
        IsReachableForAttack.LegalMoveKey += 60000;
    }
    If (MoveToHash[IsReachableForAttack.LegalMoveKey] == 0)
    {
        Stop(this script);
    }
    If (IsReachableForAttack.PieceAbs == GoK_BlackPawn)
    {
        If (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))
        {
            Ret.IsReachableForAttack.IsReachable = 1;
        }
        Stop(this script);
    }
    If ((IsReachableForAttack.PieceAbs == GoK_BlackKnight) Or (IsReachableForAttack.PieceAbs == GoK_BlackKing))
    {
        Ret.IsReachableForAttack.IsReachable = 1;
        Stop(this script);
    }
    IsReachableForAttack.Idx = ((FromIdx * 100) + ToIdx);
    IsReachableForAttack.SourceIdx = FromIdx;
    Repeat ((MoveToPathDelta[IsReachableForAttack.Idx] - 1))
    {
        IsReachableForAttack.SourceIdx += MoveToPathStepInc[IsReachableForAttack.Idx];
        If (Not ((Board[IsReachableForAttack.SourceIdx] == 0)))
        {
            Stop(this script);
        }
    }
    Ret.IsReachableForAttack.IsReachable = 1;
}

Define IsWhiteKingCheckMate (warp=true)
{
    Ret.IsWhiteKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(1);
    If (Glob.Board.IsWhiteChecked == 1)
    {
        Ret.IsWhiteKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(2)((1 == 1));
                Call CalcBoardAttackedByMove(1);
                If (Glob.Board.IsWhiteChecked == 0)
                {
                    Ret.IsWhiteKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(2);
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
    }
}

Define LoadInternalBoard (warp=true)
{
    LoadInternalBoard.SqIdx = 1;
    Repeat (64)
    {
        If (Glob.Game.IsPlayerBlack == 1)
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, (0 - GoK_Board[RankFlipIdx[LoadInternalBoard.SqIdx]]));
        }
        Else
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, GoK_Board[LoadInternalBoard.SqIdx]);
        }
        LoadInternalBoard.SqIdx += 1;
    }
}

Define LoadList(string Data)(string ListName) (warp=true)
{
    LoadList.CharIdx = 1;
    LoadList.Token = "";
    Repeat Until (LoadList.CharIdx > Variable.Length(Data))
    {
        If ((Not ((Operator.LetterOf(Data, LoadList.CharIdx) == " "))) And (Not ((Operator.LetterOf(Data, LoadList.CharIdx) == ","))))
        {
            LoadList.Token = Operator.Join(LoadList.Token, Operator.LetterOf(Data, LoadList.CharIdx));
        }
        If ((Operator.LetterOf(Data, LoadList.CharIdx) == ",") Or (LoadList.CharIdx == Variable.Length(Data)))
        {
            If (ListName == "PawnPieceSquare")
            {
                List.Add(PawnPieceSquare, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "PawnPieceSquareEndgame")
            {
                List.Add(PawnPieceSquareEndgame, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "KingPieceSquare")
            {
                List.Add(KingPieceSquare, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "KingPieceSquareEndgame")
            {
                List.Add(KingPieceSquareEndgame, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "QueenPieceSquare")
            {
                List.Add(QueenPieceSquare, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "QueenPieceSquareEndgame")
            {
                List.Add(QueenPieceSquareEndgame, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "RookPieceSquare")
            {
                List.Add(RookPieceSquare, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "RookPieceSquareEndgame")
            {
                List.Add(RookPieceSquareEndgame, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "BishopPieceSquare")
            {
                List.Add(BishopPieceSquare, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "BishopPieceSquareEndgame")
            {
                List.Add(BishopPieceSquareEndgame, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "KnightPieceSquare")
            {
                List.Add(KnightPieceSquare, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "KnightPieceSquareEndgame")
            {
                List.Add(KnightPieceSquareEndgame, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "PushToEdges")
            {
                List.Add(PushToEdges, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "PushClose")
            {
                List.Add(PushClose, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "KPKBitbase")
            {
                List.Add(KPKBitbase, Operator.Round((LoadList.Token + 0)));
            }
            If (ListName == "KPKPow2")
            {
                List.Add(KPKPow2, Operator.Round((LoadList.Token + 0)));
            }
            LoadList.Token = "";
        }
        LoadList.CharIdx += 1;
    }
}

Define Log(string Txt1)(string Txt2)(string Txt3)(string Txt4)(string Txt5)(string Txt6)(string Txt7)(string Txt8) (warp=true)
{
    If (Glob.Config.IsTestRunning == 1)
    {
        Stop(this script);
    }
    If (List.Length(Logfile) > 1000000)
    {
        Stop(this script);
    }
    List.Add(Logfile, Operator.Join(Txt1, Operator.Join(Txt2, Operator.Join(Txt3, Operator.Join(Txt4, Operator.Join(Txt5, Operator.Join(Txt6, Operator.Join(Txt7, Txt8))))))));
}

Define LogInfoLine(string Depth)(string SelDepth)(string MultiPV)(string Score)(string Bound)(string Pv) (warp=true)
{
    LogInfoLine.Time = Operator.Round((1000 * ((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart)));
    LogInfoLine.Nodes = (Glob.Info.Nodes + Glob.Info.NodesQ);
    LogInfoLine.Line = Operator.Join("info depth ", Operator.Join(Depth, Operator.Join(" seldepth ", Operator.Join(SelDepth, Operator.Join(" multipv ", Operator.Join(MultiPV, Operator.Join(" score ", Operator.Join(Score, Bound))))))));
    LogInfoLine.Line = Operator.Join(LogInfoLine.Line, Operator.Join(" nodes ", Operator.Join(LogInfoLine.Nodes, Operator.Join(" nps ", floor(((LogInfoLine.Nodes * 1000) / (LogInfoLine.Time + (LogInfoLine.Time == 0))))))));
    Call GetHashfull(Glob.TT.CurrentAge);
    LogInfoLine.Line = Operator.Join(LogInfoLine.Line, Operator.Join(" hashfull ", Ret.GetHashfull.Permill));
    LogInfoLine.Line = Operator.Join(LogInfoLine.Line, Operator.Join(" time ", Operator.Join(LogInfoLine.Time, Operator.Join(" pv ", Pv))));
    Call Log(LogInfoLine.Line)("")("")("")("")("")("")("");
}

Define LogSearchEnd(string Move) (warp=true)
{
    If (Move == Const.Null)
    {
        Stop(this script);
    }
    Call ExportBoardFEN(1);
    LogSearchEnd.White = Ret.ExportBoardFEN.IsWhite;
    If ((Glob.Search.IsTimeout == 1) And (Not ((Glob.Info.LastDepth == Const.Null))))
    {
        Call LogInfoLine(Glob.Info.LastDepth)(Glob.Info.LastSelDepth)(1)(Glob.Info.LastScore)(Glob.Info.LastBound)(Glob.Info.LastPv);
    }
    Call GetMoveUci(Move)(LogSearchEnd.White);
    LogSearchEnd.Line = Operator.Join("bestmove ", Ret.GetMoveUci.Uci);
    If (((Not ((Glob.Info.LastDepth == Const.Null))) And (Glob.Info.LastPv1 == Move)) And (Not ((Glob.Info.LastPonder == Const.Null))))
    {
        LogSearchEnd.Line = Operator.Join(LogSearchEnd.Line, Operator.Join(" ponder ", Glob.Info.LastPonder));
    }
    Call Log(LogSearchEnd.Line)("")("")("")("")("")("")("");
    LogSearchEnd.Pv = Ret.GetMoveUci.Uci;
    If ((Not ((Glob.Info.LastDepth == Const.Null))) And (Glob.Info.LastPv1 == Move))
    {
        LogSearchEnd.Pv = Glob.Info.LastPv;
    }
    Call Log("info string [FEN "")(Ret.ExportBoardFEN.FEN)(""] ")(LogSearchEnd.Pv)("")("")("")("");
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        LogSearchEnd.Time = ((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart);
        LogSearchEnd.Sec = (LogSearchEnd.Time + (LogSearchEnd.Time == 0));
        LogSearchEnd.Depth = Glob.Info.LastDepth;
        If (LogSearchEnd.Depth == Const.Null)
        {
            LogSearchEnd.Depth = 0;
        }
        Call Log("============================================================")("")("")("")("")("")("")("");
        Call Log("SEARCH STATS (move total: depth 1-")(LogSearchEnd.Depth)(", ")((Operator.Round((LogSearchEnd.Time * 100)) / 100))(" s)")("")("")("");
        Call Log("============================================================")("")("")("")("")("")("")("");
        Call Log("Nodes   full ")(Glob.Info.Nodes)("   q ")(Glob.Info.NodesQ)("   all ")((Glob.Info.Nodes + Glob.Info.NodesQ))("   ")(Operator.Join("kNPS: ", (Operator.Round((((Glob.Info.Nodes + Glob.Info.NodesQ) / LogSearchEnd.Sec) / 100)) / 10)));
        Call Log("Moves   full ")(Glob.Info.Moves)("   q ")(Glob.Info.MovesQ)("   all ")((Glob.Info.Moves + Glob.Info.MovesQ))("   ")(Operator.Join("kMPS: ", (Operator.Round((((Glob.Info.Moves + Glob.Info.MovesQ) / LogSearchEnd.Sec) / 100)) / 10)));
        Call PrintStats;
        Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
        Call Log("Move ordering: avg best move idx  full ")((Operator.Round(((Glob.Stats.BestMoveIdxSum / (Glob.Stats.BestMoveCount + (Glob.Stats.BestMoveCount == 0))) * 100)) / 100))("   q ")((Operator.Round(((Glob.Stats.BestMoveIdxSumQuiescence / (Glob.Stats.BestMoveCountQuiescence + (Glob.Stats.BestMoveCountQuiescence == 0))) * 100)) / 100))("")("")("")("");
        LogSearchEnd.M = (Glob.Stats.BestMoveCount + Glob.Stats.BestMoveCountQuiescence);
        Call Log("Bad move ordering (best idx > 2 full, > 1 q): ")(Glob.Stats.BadOrderCount)(" of ")(LogSearchEnd.M)(" nodes (")((Operator.Round(((1000 * Glob.Stats.BadOrderCount) / (LogSearchEnd.M + (LogSearchEnd.M == 0)))) / 10))("%)")("");
        Call Log("============================================================")("")("")("")("")("")("")("");
    }
}

Define LogSearchInfo(string Depth)(string MultiPV)(string Eval)(string Alpha)(string Beta)(string RootMove)(string Emit) (warp=true)
{
    If ((Not ((Eval == Const.Null))) And (Not ((RootMove == Const.Null))))
    {
        LogSearchInfo.White = Ret.ExportBoardFEN.IsWhite;
        If (abs(Eval) > Const.AbsMinCheckmateEval)
        {
            LogSearchInfo.Mate = ceiling((((100000 - abs(Eval)) - List.Length(BoardHistoryFiftyMoves)) / 2));
            If (Eval < 0)
            {
                LogSearchInfo.Mate = (0 - LogSearchInfo.Mate);
            }
            LogSearchInfo.Score = Operator.Join("mate ", LogSearchInfo.Mate);
        }
        If (Not ((abs(Eval) > Const.AbsMinCheckmateEval)))
        {
            LogSearchInfo.Score = Operator.Join("cp ", Eval);
        }
        LogSearchInfo.Bound = "";
        If (Not ((Eval > Alpha)))
        {
            LogSearchInfo.Bound = " upperbound";
        }
        If (Not ((Eval < Beta)))
        {
            LogSearchInfo.Bound = " lowerbound";
        }
        Call GetPvUci(RootMove)(LogSearchInfo.White);
        If (MultiPV == 1)
        {
            Glob.Info.LastDepth = Depth;
            Glob.Info.LastSelDepth = Glob.Search.SelDepth;
            Glob.Info.LastScore = LogSearchInfo.Score;
            Glob.Info.LastBound = LogSearchInfo.Bound;
            Glob.Info.LastPv = Ret.GetPvUci.Text;
            Glob.Info.LastPv1 = Ret.GetPvUci.First;
            Glob.Info.LastPonder = Ret.GetPvUci.Ponder;
        }
        If (Emit == 1)
        {
            Call LogInfoLine(Depth)(Glob.Search.SelDepth)(MultiPV)(LogSearchInfo.Score)(LogSearchInfo.Bound)(Ret.GetPvUci.Text);
        }
    }
}

Define NNUE_ActDeactBulkImpl(string FromSquare)(string ToSquare)(string SourcePiece)(string PlacedPiece)(string TargetPiece)(string CapSquare)(string Ply) (warp=true)
{
    NNUE_ActDeactBulkImpl.Side = 0;
    Repeat (2)
    {
        NNUE_ActDeactBulkImpl.Chunk = 0;
        Repeat (1)
        {
            NNUE_ActDeactBulkImpl.ChunkBaseIdx = (NNUE_ActDeactBulkImpl.Chunk * (Const.NNUE_HiddenPackedSize / 2));
            NNUE_ActDeactBulkImpl.AccumulatorBaseIdx = (((NNUE_ActDeactBulkImpl.Side * Const.NNUE_HiddenPackedSize) + NNUE_ActDeactBulkImpl.ChunkBaseIdx) + 1);
            NNUE_ActDeactBulkImpl.FeatureFrom = (NNUE_InputIdxMap[(((NNUE_ActDeactBulkImpl.Side * 1000) + ((64 * SourcePiece) + FromSquare)) + 1)] + 0);
            NNUE_ActDeactBulkImpl.FeatureTo = (NNUE_InputIdxMap[(((NNUE_ActDeactBulkImpl.Side * 1000) + ((64 * PlacedPiece) + ToSquare)) + 1)] + 0);
            If (TargetPiece == Const.Null)
            {
                NNUE_ActDeactBulkImpl.FeatureCap = 0;
            }
            Else
            {
                NNUE_ActDeactBulkImpl.FeatureCap = (NNUE_InputIdxMap[(((NNUE_ActDeactBulkImpl.Side * 1000) + ((64 * TargetPiece) + CapSquare)) + 1)] + 0);
            }
            NNUE_ActDeactBulkImpl.FromBaseIdx = (((NNUE_ActDeactBulkImpl.FeatureFrom * Const.NNUE_HiddenPackedSize) + NNUE_ActDeactBulkImpl.ChunkBaseIdx) + 1);
            NNUE_ActDeactBulkImpl.ToBaseIdx = (((NNUE_ActDeactBulkImpl.FeatureTo * Const.NNUE_HiddenPackedSize) + NNUE_ActDeactBulkImpl.ChunkBaseIdx) + 1);
            If (NNUE_ActDeactBulkImpl.FeatureCap == 0)
            {
                NNUE_ActDeactBulkImpl.CaptureBaseIdx = 0;
            }
            Else
            {
                NNUE_ActDeactBulkImpl.CaptureBaseIdx = (((NNUE_ActDeactBulkImpl.FeatureCap * Const.NNUE_HiddenPackedSize) + NNUE_ActDeactBulkImpl.ChunkBaseIdx) + 1);
            }
            If (Ply == 0)
            {
                NNUE_ActDeactBulkImpl.SourceIdx = NNUE_ActDeactBulkImpl.AccumulatorBaseIdx;
                NNUE_ActDeactBulkImpl.TargetIdx = NNUE_ActDeactBulkImpl.AccumulatorBaseIdx;
            }
            Else
            {
                NNUE_ActDeactBulkImpl.TargetIdx = (NNUE_ActDeactBulkImpl.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                If (NNUE_Accumulator_MetaState[Ply] == 1)
                {
                    NNUE_ActDeactBulkImpl.SourceIdx = (NNUE_ActDeactBulkImpl.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1)));
                }
                Else
                {
                    If (NNUE_Accumulator_MetaState[Ply] == 2)
                    {
                        NNUE_ActDeactBulkImpl.SourceIdx = (NNUE_ActDeactBulkImpl.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                    }
                    Else
                    {
                        Stop(this script);
                    }
                }
            }
            If (NNUE_ActDeactBulkImpl.CaptureBaseIdx > 0)
            {
                NNUE_ActDeactBulkImpl.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE_ActDeactBulkImpl.TargetIdx + NNUE_ActDeactBulkImpl.Idx), ((((NNUE_Accumulator[(NNUE_ActDeactBulkImpl.SourceIdx + NNUE_ActDeactBulkImpl.Idx)] - NNUE_InputWeights[(NNUE_ActDeactBulkImpl.FromBaseIdx + NNUE_ActDeactBulkImpl.Idx)]) + NNUE_InputWeights[(NNUE_ActDeactBulkImpl.ToBaseIdx + NNUE_ActDeactBulkImpl.Idx)]) - NNUE_InputWeights[(NNUE_ActDeactBulkImpl.CaptureBaseIdx + NNUE_ActDeactBulkImpl.Idx)]) + 3079008413292000));
                    NNUE_ActDeactBulkImpl.Idx += 1;
                }
            }
            Else
            {
                NNUE_ActDeactBulkImpl.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE_ActDeactBulkImpl.TargetIdx + NNUE_ActDeactBulkImpl.Idx), ((NNUE_Accumulator[(NNUE_ActDeactBulkImpl.SourceIdx + NNUE_ActDeactBulkImpl.Idx)] - NNUE_InputWeights[(NNUE_ActDeactBulkImpl.FromBaseIdx + NNUE_ActDeactBulkImpl.Idx)]) + NNUE_InputWeights[(NNUE_ActDeactBulkImpl.ToBaseIdx + NNUE_ActDeactBulkImpl.Idx)]));
                    NNUE_ActDeactBulkImpl.Idx += 1;
                }
            }
            NNUE_ActDeactBulkImpl.Chunk += 1;
        }
        NNUE_ActDeactBulkImpl.Side += 1;
    }
    If (Ply > 0)
    {
        List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 2);
    }
}

Define NNUE_ActDeactImpl(string Square)(string Piece)(bool Activate)(string Ply) (warp=true)
{
    NNUE_ActDeactImpl.Side = 0;
    Repeat (2)
    {
        NNUE_ActDeactImpl.Chunk = 0;
        Repeat (1)
        {
            NNUE_ActDeactImpl.ChunkBaseIdx = (NNUE_ActDeactImpl.Chunk * (Const.NNUE_HiddenPackedSize / 2));
            NNUE_ActDeactImpl.AccumulatorBaseIdx = (((NNUE_ActDeactImpl.Side * Const.NNUE_HiddenPackedSize) + NNUE_ActDeactImpl.ChunkBaseIdx) + 1);
            NNUE_ActDeactImpl.Feature = (NNUE_InputIdxMap[(((NNUE_ActDeactImpl.Side * 1000) + ((64 * Piece) + Square)) + 1)] + 0);
            NNUE_ActDeactImpl.FeatureBaseIdx = (((NNUE_ActDeactImpl.Feature * Const.NNUE_HiddenPackedSize) + NNUE_ActDeactImpl.ChunkBaseIdx) + 1);
            If (Ply == 0)
            {
                NNUE_ActDeactImpl.SourceIdx = NNUE_ActDeactImpl.AccumulatorBaseIdx;
                NNUE_ActDeactImpl.TargetIdx = NNUE_ActDeactImpl.AccumulatorBaseIdx;
            }
            Else
            {
                NNUE_ActDeactImpl.TargetIdx = (NNUE_ActDeactImpl.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                If (NNUE_Accumulator_MetaState[Ply] == 1)
                {
                    NNUE_ActDeactImpl.SourceIdx = (NNUE_ActDeactImpl.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * (Ply - 1)));
                }
                Else
                {
                    If (NNUE_Accumulator_MetaState[Ply] == 2)
                    {
                        NNUE_ActDeactImpl.SourceIdx = (NNUE_ActDeactImpl.AccumulatorBaseIdx + ((Const.NNUE_HiddenPackedSize * 2) * Ply));
                    }
                    Else
                    {
                        Stop(this script);
                    }
                }
            }
            If Activate
            {
                NNUE_ActDeactImpl.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE_ActDeactImpl.TargetIdx + NNUE_ActDeactImpl.Idx), ((NNUE_Accumulator[(NNUE_ActDeactImpl.SourceIdx + NNUE_ActDeactImpl.Idx)] + NNUE_InputWeights[(NNUE_ActDeactImpl.FeatureBaseIdx + NNUE_ActDeactImpl.Idx)]) - 3079008413292000));
                    NNUE_ActDeactImpl.Idx += 1;
                }
            }
            Else
            {
                NNUE_ActDeactImpl.Idx = 0;
                Repeat (Const.NNUE_HiddenPackedSize)
                {
                    List.ReplaceItem(NNUE_Accumulator, (NNUE_ActDeactImpl.TargetIdx + NNUE_ActDeactImpl.Idx), ((NNUE_Accumulator[(NNUE_ActDeactImpl.SourceIdx + NNUE_ActDeactImpl.Idx)] - NNUE_InputWeights[(NNUE_ActDeactImpl.FeatureBaseIdx + NNUE_ActDeactImpl.Idx)]) + 3079008413292000));
                    NNUE_ActDeactImpl.Idx += 1;
                }
            }
            NNUE_ActDeactImpl.Chunk += 1;
        }
        NNUE_ActDeactImpl.Side += 1;
    }
    If (Ply > 0)
    {
        List.ReplaceItem(NNUE_Accumulator_MetaState, Ply, 2);
    }
}

Define NNUE_Activate(string GoKIdx)(string GoKPiece)(string Ply) (warp=true)
{
    Call NNUE_ActDeactImpl(NNUE_GoKIdxToSquare[GoKIdx])((((6 * (GoKPiece > 0)) + PieceIdxLookup[abs(GoKPiece)]) - 1))((1 == 1))(Ply);
}

Define NNUE_Deactivate(string GoKIdx)(string GoKPiece)(string Ply) (warp=true)
{
    Call NNUE_ActDeactImpl(NNUE_GoKIdxToSquare[GoKIdx])((((6 * (GoKPiece > 0)) + PieceIdxLookup[abs(GoKPiece)]) - 1))((1 == 0))(Ply);
}

Define NNUE_DecodeNetwork (warp=true)
{
    If (Glob.NNUE.IsNetworkDecoded == 1)
    {
        Stop(this script);
    }
    Call NNUE_HexToDec(Glob.NNUE.InputWeights_HEX);
    List.DeleteAll(NNUE_InputWeights);
    NNUE_DecodeNetwork.RowIdx = 0;
    Repeat (384)
    {
        NNUE_DecodeNetwork.WeightIdx = 0;
        Repeat (128)
        {
            List.Add(NNUE_InputWeights, ((((NNUE_ListRes_1[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 1)] + 5600) + ((NNUE_ListRes_1[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 2)] + 5600) * 8192)) + ((NNUE_ListRes_1[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 3)] + 5600) * 67108864)) + ((NNUE_ListRes_1[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 4)] + 5600) * 549755813888)));
            NNUE_DecodeNetwork.WeightIdx += 1;
        }
        NNUE_DecodeNetwork.RowIdx += 1;
    }
    NNUE_DecodeNetwork.RowIdx = 0;
    Repeat (384)
    {
        NNUE_DecodeNetwork.WeightIdx = 0;
        Repeat (128)
        {
            List.Add(NNUE_InputWeights, ((((NNUE_ListRes_2[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 1)] + 5600) + ((NNUE_ListRes_2[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 2)] + 5600) * 8192)) + ((NNUE_ListRes_2[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 3)] + 5600) * 67108864)) + ((NNUE_ListRes_2[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 4)] + 5600) * 549755813888)));
            NNUE_DecodeNetwork.WeightIdx += 1;
        }
        NNUE_DecodeNetwork.RowIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE.HiddenBias_CSV);
    List.DeleteAll(NNUE_HiddenBias);
    NNUE_DecodeNetwork.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenBias, (NNUE_ListRes_1[NNUE_DecodeNetwork.CharIdx] + 0));
        NNUE_DecodeNetwork.CharIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE.HiddenWeights_CSV);
    List.DeleteAll(NNUE_HiddenWeights);
    NNUE_DecodeNetwork.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenWeights, (NNUE_ListRes_1[NNUE_DecodeNetwork.CharIdx] + 0));
        NNUE_DecodeNetwork.CharIdx += 1;
    }
    Call NNUE_LoadList(Glob.NNUE.OutputBias_CSV);
    List.DeleteAll(NNUE_OutputBias);
    NNUE_DecodeNetwork.CharIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_OutputBias, (NNUE_ListRes_1[NNUE_DecodeNetwork.CharIdx] + 0));
        NNUE_DecodeNetwork.CharIdx += 1;
    }
    Glob.NNUE.IsNetworkDecoded = 1;
    List.DeleteAll(NNUE_ListRes_1);
    NNUE_DecodeNetwork.RowIdx = 0;
    Repeat (1)
    {
        NNUE_DecodeNetwork.WeightIdx = 0;
        Repeat (128)
        {
            List.Add(NNUE_ListRes_1, ((((NNUE_HiddenBias[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 1)] + 5600) + ((NNUE_HiddenBias[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 2)] + 5600) * 8192)) + ((NNUE_HiddenBias[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 3)] + 5600) * 67108864)) + ((NNUE_HiddenBias[(((NNUE_DecodeNetwork.RowIdx * 512) + (NNUE_DecodeNetwork.WeightIdx * 4)) + 4)] + 5600) * 549755813888)));
            NNUE_DecodeNetwork.WeightIdx += 1;
        }
        NNUE_DecodeNetwork.RowIdx += 1;
    }
    List.DeleteAll(NNUE_HiddenBias);
    NNUE_DecodeNetwork.RowIdx = 1;
    Repeat (List.Length(NNUE_ListRes_1))
    {
        List.Add(NNUE_HiddenBias, NNUE_ListRes_1[NNUE_DecodeNetwork.RowIdx]);
        NNUE_DecodeNetwork.RowIdx += 1;
    }
    List.DeleteAll(NNUE_ListRes_1);
}

