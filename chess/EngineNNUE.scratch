        List.Add(OpeningMovesBlack, 53371329634602196226091726331026334207220067062749330102332617264629192952362736603612205438291936440065);
        Call //("Caro-Kann");
        List.Add(OpeningMovesBlack, 53371119523612283729192736271321);
        Call //("other first moves");
        List.Add(OpeningMovesBlack, 544613295843021953370627623512205244162463530440554740484328485561520504606203486255485564611925);
        List.Add(OpeningMovesBlack, 58431228534507225236112763460219);
        List.Add(OpeningMovesBlack, 5042122859500722534503306346132158431624);
        Call //("other 1.d4");
        List.Add(OpeningMovesBlack, 5236132151351228584311195345021263460722);
        List.Add(OpeningMovesBlack, 523613215135122863462835534507226235112700670917362704606260062735620065);
    }
    List.DeleteItem(OpeningMoves, all);
    InitOpeningBook.OpeningMoveIdx = 1;
    Repeat (List.Length(OpeningMovesNeutral))
    {
        List.Add(OpeningMoves, OpeningMovesNeutral[InitOpeningBook.OpeningMoveIdx]);
        InitOpeningBook.OpeningMoveIdx += 1;
    }
    If (Glob.Game.IsPlayerBlack == 1)
    {
        InitOpeningBook.OpeningMoveIdx = 1;
        Repeat (List.Length(OpeningMovesWhite))
        {
            List.Add(OpeningMoves, OpeningMovesWhite[InitOpeningBook.OpeningMoveIdx]);
            InitOpeningBook.OpeningMoveIdx += 1;
        }
    }
    Else
    {
        InitOpeningBook.OpeningMoveIdx = 1;
        Repeat (List.Length(OpeningMovesBlack))
        {
            List.Add(OpeningMoves, OpeningMovesBlack[InitOpeningBook.OpeningMoveIdx]);
            InitOpeningBook.OpeningMoveIdx += 1;
        }
    }
    If (Glob.Game.IsPlayerBlack == 1)
    {
        InitOpeningBook.OpeningMoveIdx = 1;
        Repeat (List.Length(OpeningMoves))
        {
            InitOpeningBook.Line = OpeningMoves[InitOpeningBook.OpeningMoveIdx];
            InitOpeningBook.LineMoves = "";
            InitOpeningBook.CharIdx = 1;
            Repeat ((Variable.Length(InitOpeningBook.Line) / 4))
            {
                InitOpeningBook.MoveStr = Operator.Join(Operator.Join(Operator.LetterOf(InitOpeningBook.Line, InitOpeningBook.CharIdx), Operator.LetterOf(InitOpeningBook.Line, (InitOpeningBook.CharIdx + 1))), Operator.Join(Operator.LetterOf(InitOpeningBook.Line, (InitOpeningBook.CharIdx + 2)), Operator.LetterOf(InitOpeningBook.Line, (InitOpeningBook.CharIdx + 3))));
                Call GetPhysicalMove(InitOpeningBook.MoveStr);
                InitOpeningBook.LineMoves = Operator.Join(InitOpeningBook.LineMoves, MoveToZeroPaddedStr[(floor(Ret.GetPhysicalMove.Move) + 1)]);
                InitOpeningBook.CharIdx += 4;
            }
            If ((Operator.Join(Operator.LetterOf(InitOpeningBook.LineMoves, 1), Operator.LetterOf(InitOpeningBook.LineMoves, 2)) == 9) Or (Operator.Join(Operator.LetterOf(InitOpeningBook.LineMoves, 1), Operator.LetterOf(InitOpeningBook.LineMoves, 2)) == 16))
            {
                List.ReplaceItem(OpeningMoves, InitOpeningBook.OpeningMoveIdx, "");
            }
            Else
            {
                List.ReplaceItem(OpeningMoves, InitOpeningBook.OpeningMoveIdx, InitOpeningBook.LineMoves);
            }
            InitOpeningBook.OpeningMoveIdx += 1;
        }
    }
}

