    {
        EvalEndgame.KRPKR.StrongKingPushDistance = ChebyshevDistance[((EvalEndgame.KRPKR.StrongKingIdx * 100) + EvalEndgame.KRPKR.PushSqIdx)];
        EvalEndgame.KRPKR.WeakKingPushDistance = ChebyshevDistance[((EvalEndgame.KRPKR.WeakKingIdx * 100) + EvalEndgame.KRPKR.PushSqIdx)];
        If (EvalEndgame.KRPKR.StrongKingPushDistance < ((EvalEndgame.KRPKR.WeakKingPushDistance - 2) + EvalEndgame.KRPKR.IsStrongToMove))
        {
            EvalEndgame.KRPKR.IsWeakKingAwayFromRook = 0;
            If (Not (((EvalEndgame.KRPKR.WeakKingStrongRookDistance + EvalEndgame.KRPKR.IsStrongToMove) < 3)))
            {
                EvalEndgame.KRPKR.IsWeakKingAwayFromRook = 1;
            }
            If ((EvalEndgame.KRPKR.StrongKingQueeningDistance < (EvalEndgame.KRPKR.WeakKingStrongRookDistance + EvalEndgame.KRPKR.IsStrongToMove)) And (EvalEndgame.KRPKR.StrongKingPushDistance < (ChebyshevDistance[((EvalEndgame.KRPKR.WeakKingIdx * 100) + EvalEndgame.KRPKR.PawnIdx)] + EvalEndgame.KRPKR.IsStrongToMove)))
            {
                EvalEndgame.KRPKR.IsWeakKingAwayFromRook = 1;
            }
            If (EvalEndgame.KRPKR.IsWeakKingAwayFromRook == 1)
            {
                EvalEndgame.KRPKR.PawnQueeningDistance = ChebyshevDistance[((EvalEndgame.KRPKR.PawnIdx * 100) + EvalEndgame.KRPKR.QueeningSqIdx)];
                Ret.EvalEndgame.KRPKR.Factor = ((128 - (8 * EvalEndgame.KRPKR.PawnQueeningDistance)) - (2 * EvalEndgame.KRPKR.StrongKingQueeningDistance));
                Stop(this script);
            }
        }
    }
    EvalEndgame.KRPKR.WeakKingSqNumber = ((EvalEndgame.KRPKR.WeakKingRank * 8) + EvalEndgame.KRPKR.WeakKingFile);
    EvalEndgame.KRPKR.PawnSqNumber = ((EvalEndgame.KRPKR.PawnRank * 8) + EvalEndgame.KRPKR.PawnFile);
    If ((EvalEndgame.KRPKR.PawnRank < 4) And (EvalEndgame.KRPKR.WeakKingSqNumber > EvalEndgame.KRPKR.PawnSqNumber))
    {
        If (EvalEndgame.KRPKR.WeakKingFile == EvalEndgame.KRPKR.PawnFile)
        {
            Ret.EvalEndgame.KRPKR.Factor = 10;
            Stop(this script);
        }
        EvalEndgame.KRPKR.KingDistance = ChebyshevDistance[((EvalEndgame.KRPKR.StrongKingIdx * 100) + EvalEndgame.KRPKR.WeakKingIdx)];
        If ((abs((EvalEndgame.KRPKR.WeakKingFile - EvalEndgame.KRPKR.PawnFile)) == 1) And (EvalEndgame.KRPKR.KingDistance > 2))
        {
            Ret.EvalEndgame.KRPKR.Factor = (24 - (2 * EvalEndgame.KRPKR.KingDistance));
        }
    }
}

Define EvalEndgame.KRPPKRP(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KRPPKRP.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    EvalEndgame.KRPPKRP.RankBase = Ret.EvalEndgame.Locate.RelativeRankBase;
    EvalEndgame.KRPPKRP.RankSign = Ret.EvalEndgame.Locate.RelativeRankSign;
    EvalEndgame.KRPPKRP.PawnIdx = Ret.EvalEndgame.Locate.StrongPawnIdx;
    EvalEndgame.KRPPKRP.SecondPawnIdx = Ret.EvalEndgame.Locate.SecondStrongPawnIdx;
    EvalEndgame.KRPPKRP.WeakPawnIdx = Ret.EvalEndgame.Locate.WeakPawnIdx;
    EvalEndgame.KRPPKRP.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
    EvalEndgame.KRPPKRP.PawnRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.PawnIdx]));
    EvalEndgame.KRPPKRP.SecondPawnRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.SecondPawnIdx]));
    EvalEndgame.KRPPKRP.WeakPawnRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.WeakPawnIdx]));
    EvalEndgame.KRPPKRP.WeakPawnFile = IdxToFile[EvalEndgame.KRPPKRP.WeakPawnIdx];
    EvalEndgame.KRPPKRP.IsPawnBlocked = 0;
    If ((abs((EvalEndgame.KRPPKRP.WeakPawnFile - IdxToFile[EvalEndgame.KRPPKRP.PawnIdx])) < 2) And (EvalEndgame.KRPPKRP.WeakPawnRank > EvalEndgame.KRPPKRP.PawnRank))
    {
        EvalEndgame.KRPPKRP.IsPawnBlocked = 1;
    }
    EvalEndgame.KRPPKRP.IsSecondPawnBlocked = 0;
    If ((abs((EvalEndgame.KRPPKRP.WeakPawnFile - IdxToFile[EvalEndgame.KRPPKRP.SecondPawnIdx])) < 2) And (EvalEndgame.KRPPKRP.WeakPawnRank > EvalEndgame.KRPPKRP.SecondPawnRank))
    {
        EvalEndgame.KRPPKRP.IsSecondPawnBlocked = 1;
    }
    If ((EvalEndgame.KRPPKRP.IsPawnBlocked == 0) Or (EvalEndgame.KRPPKRP.IsSecondPawnBlocked == 0))
    {
        Stop(this script);
    }
    EvalEndgame.KRPPKRP.FrontPawnRank = EvalEndgame.KRPPKRP.PawnRank;
    If (EvalEndgame.KRPPKRP.SecondPawnRank > EvalEndgame.KRPPKRP.FrontPawnRank)
    {
        EvalEndgame.KRPPKRP.FrontPawnRank = EvalEndgame.KRPPKRP.SecondPawnRank;
    }
    EvalEndgame.KRPPKRP.WeakKingFile = IdxToFile[EvalEndgame.KRPPKRP.WeakKingIdx];
    EvalEndgame.KRPPKRP.WeakKingRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.WeakKingIdx]));
    If ((abs((EvalEndgame.KRPPKRP.WeakKingFile - IdxToFile[EvalEndgame.KRPPKRP.PawnIdx])) < 2) And (abs((EvalEndgame.KRPPKRP.WeakKingFile - IdxToFile[EvalEndgame.KRPPKRP.SecondPawnIdx])) < 2))
    {
        If (EvalEndgame.KRPPKRP.WeakKingRank > EvalEndgame.KRPPKRP.FrontPawnRank)
        {
            Ret.EvalEndgame.KRPPKRP.Factor = (7 * EvalEndgame.KRPPKRP.FrontPawnRank);
        }
    }
}

Define EvalEndgame.Locate(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.Locate.StrongPawnIdx = 0;
    Ret.EvalEndgame.Locate.SecondStrongPawnIdx = 0;
    Ret.EvalEndgame.Locate.StrongBishopIdx = 0;
    Ret.EvalEndgame.Locate.StrongRookIdx = 0;
    Ret.EvalEndgame.Locate.WeakPawnIdx = 0;
    Ret.EvalEndgame.Locate.WeakBishopIdx = 0;
    Ret.EvalEndgame.Locate.WeakKnightIdx = 0;
    Ret.EvalEndgame.Locate.WeakRookIdx = 0;
    EvalEndgame.Locate.SqIdx = 1;
    Repeat (64)
    {
        EvalEndgame.Locate.StrongViewPiece = (Board[EvalEndgame.Locate.SqIdx] * StrongSide);
        If (EvalEndgame.Locate.StrongViewPiece == GoK_BlackPawn)
        {
            If (Ret.EvalEndgame.Locate.StrongPawnIdx == 0)
            {
                Ret.EvalEndgame.Locate.StrongPawnIdx = EvalEndgame.Locate.SqIdx;
            }
            Else
            {
                Ret.EvalEndgame.Locate.SecondStrongPawnIdx = EvalEndgame.Locate.SqIdx;
            }
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_BlackBishop)
        {
            Ret.EvalEndgame.Locate.StrongBishopIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_BlackRook)
        {
            Ret.EvalEndgame.Locate.StrongRookIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_WhitePawn)
        {
            Ret.EvalEndgame.Locate.WeakPawnIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_WhiteBishop)
        {
            Ret.EvalEndgame.Locate.WeakBishopIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_WhiteKnight)
        {
            Ret.EvalEndgame.Locate.WeakKnightIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_WhiteRook)
        {
            Ret.EvalEndgame.Locate.WeakRookIdx = EvalEndgame.Locate.SqIdx;
        }
        EvalEndgame.Locate.SqIdx += 1;
    }
    If (StrongSide == 1)
    {
        Ret.EvalEndgame.Locate.StrongKingIdx = Glob.Board.BlackKingIdx;
        Ret.EvalEndgame.Locate.WeakKingIdx = Glob.Board.WhiteKingIdx;
        Ret.EvalEndgame.Locate.RelativeRankBase = -1;
        Ret.EvalEndgame.Locate.RelativeRankSign = 1;
        Ret.EvalEndgame.Locate.PawnPushIdxDelta = 8;
    }
    Else
    {
        Ret.EvalEndgame.Locate.StrongKingIdx = Glob.Board.WhiteKingIdx;
        Ret.EvalEndgame.Locate.WeakKingIdx = Glob.Board.BlackKingIdx;
        Ret.EvalEndgame.Locate.RelativeRankBase = 8;
        Ret.EvalEndgame.Locate.RelativeRankSign = -1;
        Ret.EvalEndgame.Locate.PawnPushIdxDelta = -8;
    }
}

Define EvalEndgame.Material(string StrongSide) (warp=true)
{
    If (StrongSide == 1)
    {
        EvalEndgame.Material.StrongQueenCount = Glob.Board.BlackQueenCount;
        EvalEndgame.Material.StrongRookCount = Glob.Board.BlackRookCount;
        EvalEndgame.Material.StrongMajorMinorCount = Glob.Board.BlackNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.StrongPawnCount = Glob.Board.BlackPawnCount;
        EvalEndgame.Material.WeakQueenCount = Glob.Board.WhiteQueenCount;
        Ret.EvalEndgame.Material.WeakRookCount = Glob.Board.WhiteRookCount;
        EvalEndgame.Material.WeakMajorMinorCount = Glob.Board.WhiteNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.WeakPawnCount = Glob.Board.WhitePawnCount;
    }
    Else
    {
        EvalEndgame.Material.StrongQueenCount = Glob.Board.WhiteQueenCount;
        EvalEndgame.Material.StrongRookCount = Glob.Board.WhiteRookCount;
        EvalEndgame.Material.StrongMajorMinorCount = Glob.Board.WhiteNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.StrongPawnCount = Glob.Board.WhitePawnCount;
        EvalEndgame.Material.WeakQueenCount = Glob.Board.BlackQueenCount;
        Ret.EvalEndgame.Material.WeakRookCount = Glob.Board.BlackRookCount;
        EvalEndgame.Material.WeakMajorMinorCount = Glob.Board.BlackNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.WeakPawnCount = Glob.Board.BlackPawnCount;
    }
    EvalEndgame.Material.StrongBishopCount = 0;
    EvalEndgame.Material.WeakBishopCount = 0;
    EvalEndgame.Material.ScanIdx = 1;
    Repeat (64)
    {
        If ((Board[EvalEndgame.Material.ScanIdx] * StrongSide) == GoK_BlackBishop)
        {
            EvalEndgame.Material.StrongBishopCount += 1;
        }
        If ((Board[EvalEndgame.Material.ScanIdx] * StrongSide) == GoK_WhiteBishop)
        {
            EvalEndgame.Material.WeakBishopCount += 1;
        }
        EvalEndgame.Material.ScanIdx += 1;
    }
    EvalEndgame.Material.StrongKnightCount = ((EvalEndgame.Material.StrongMajorMinorCount - EvalEndgame.Material.StrongRookCount) - EvalEndgame.Material.StrongBishopCount);
    EvalEndgame.Material.StrongPieceCount = (EvalEndgame.Material.StrongQueenCount + EvalEndgame.Material.StrongMajorMinorCount);
    EvalEndgame.Material.WeakKnightCount = ((EvalEndgame.Material.WeakMajorMinorCount - Ret.EvalEndgame.Material.WeakRookCount) - EvalEndgame.Material.WeakBishopCount);
    EvalEndgame.Material.WeakPieceCount = (EvalEndgame.Material.WeakQueenCount + EvalEndgame.Material.WeakMajorMinorCount);
    Ret.EvalEndgame.Material.StrongPiecesAreNone = 0;
    If (EvalEndgame.Material.StrongPieceCount == 0)
    {
        Ret.EvalEndgame.Material.StrongPiecesAreNone = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreRook = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 1) And (EvalEndgame.Material.StrongRookCount == 1))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreRook = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreQueen = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 1) And (EvalEndgame.Material.StrongQueenCount == 1))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreQueen = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreBishop = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 1) And (EvalEndgame.Material.StrongBishopCount == 1))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreBishop = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreTwoKnights = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 2) And (EvalEndgame.Material.StrongKnightCount == 2))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreTwoKnights = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreNone = 0;
    If (EvalEndgame.Material.WeakPieceCount == 0)
    {
        Ret.EvalEndgame.Material.WeakPiecesAreNone = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreRook = 0;
    If ((EvalEndgame.Material.WeakPieceCount == 1) And (Ret.EvalEndgame.Material.WeakRookCount == 1))
    {
        Ret.EvalEndgame.Material.WeakPiecesAreRook = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreBishop = 0;
    If ((EvalEndgame.Material.WeakPieceCount == 1) And (EvalEndgame.Material.WeakBishopCount == 1))
    {
        Ret.EvalEndgame.Material.WeakPiecesAreBishop = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreKnight = 0;
    If ((EvalEndgame.Material.WeakPieceCount == 1) And (EvalEndgame.Material.WeakKnightCount == 1))
    {
        Ret.EvalEndgame.Material.WeakPiecesAreKnight = 1;
    }
}

Define EvalEndgame.PawnScan(string StrongSide)(string WeakKingIdx)(string WeakRookIdx) (warp=true)
{
    Ret.EvalEndgame.PawnScan.StrongPawnCount = 0;
    Ret.EvalEndgame.PawnScan.StrongPawnOnFileACount = 0;
    Ret.EvalEndgame.PawnScan.StrongPawnOnFileHCount = 0;
    Ret.EvalEndgame.PawnScan.PawnCount = 0;
    Ret.EvalEndgame.PawnScan.PawnOnFileBCount = 0;
    Ret.EvalEndgame.PawnScan.PawnOnFileGCount = 0;
    Ret.EvalEndgame.PawnScan.StrongPawnInKingSpanCount = 0;
    Ret.EvalEndgame.PawnScan.HasRookFortressPawn = 0;
    Ret.EvalEndgame.PawnScan.WeakFrontPawnIdx = 0;
    EvalEndgame.PawnScan.RelativeRankBase = -1;
    EvalEndgame.PawnScan.RelativeRankSign = 1;
    If (StrongSide < 0)
    {
        EvalEndgame.PawnScan.RelativeRankBase = 8;
        EvalEndgame.PawnScan.RelativeRankSign = -1;
    }
    EvalEndgame.PawnScan.WeakKingRelativeRank = (EvalEndgame.PawnScan.RelativeRankBase + (EvalEndgame.PawnScan.RelativeRankSign * IdxToRank[WeakKingIdx]));
    EvalEndgame.PawnScan.WeakFrontPawnRelativeRank = -1;
    EvalEndgame.PawnScan.ListIdx = 1;
    Repeat (64)
    {
        EvalEndgame.PawnScan.SqIdx = EvalEndgame.PawnScan.ListIdx;
        If (abs(Board[EvalEndgame.PawnScan.SqIdx]) == GoK_BlackPawn)
        {
            EvalEndgame.PawnScan.File = IdxToFile[EvalEndgame.PawnScan.SqIdx];
            EvalEndgame.PawnScan.RelativeRank = (EvalEndgame.PawnScan.RelativeRankBase + (EvalEndgame.PawnScan.RelativeRankSign * IdxToRank[EvalEndgame.PawnScan.SqIdx]));
            Ret.EvalEndgame.PawnScan.PawnCount += 1;
            If (EvalEndgame.PawnScan.File == 2)
            {
                Ret.EvalEndgame.PawnScan.PawnOnFileBCount += 1;
            }
            If (EvalEndgame.PawnScan.File == 7)
            {
                Ret.EvalEndgame.PawnScan.PawnOnFileGCount += 1;
            }
            If ((Board[EvalEndgame.PawnScan.SqIdx] * StrongSide) > 0)
            {
                Ret.EvalEndgame.PawnScan.StrongPawnCount += 1;
                If (EvalEndgame.PawnScan.File == 1)
                {
                    Ret.EvalEndgame.PawnScan.StrongPawnOnFileACount += 1;
                }
                If (EvalEndgame.PawnScan.File == 8)
                {
                    Ret.EvalEndgame.PawnScan.StrongPawnOnFileHCount += 1;
                }
                EvalEndgame.PawnScan.KingFileDeltaAbs = abs((EvalEndgame.PawnScan.File - IdxToFile[WeakKingIdx]));
                If ((EvalEndgame.PawnScan.KingFileDeltaAbs < 2) And (EvalEndgame.PawnScan.RelativeRank < EvalEndgame.PawnScan.WeakKingRelativeRank))
                {
                    Ret.EvalEndgame.PawnScan.StrongPawnInKingSpanCount += 1;
                }
            }
            Else
            {
                If (EvalEndgame.PawnScan.RelativeRank > EvalEndgame.PawnScan.WeakFrontPawnRelativeRank)
                {
                    Ret.EvalEndgame.PawnScan.WeakFrontPawnIdx = EvalEndgame.PawnScan.SqIdx;
                    EvalEndgame.PawnScan.WeakFrontPawnRelativeRank = EvalEndgame.PawnScan.RelativeRank;
                }
                If (WeakRookIdx > 0)
                {
                    EvalEndgame.PawnScan.IsNextToWeakKing = 0;
                    If (ChebyshevDistance[((EvalEndgame.PawnScan.SqIdx * 100) + WeakKingIdx)] == 1)
                    {
                        EvalEndgame.PawnScan.IsNextToWeakKing = 1;
                    }
                    EvalEndgame.PawnScan.RookRelativeRank = (EvalEndgame.PawnScan.RelativeRankBase + (EvalEndgame.PawnScan.RelativeRankSign * IdxToRank[WeakRookIdx]));
                    EvalEndgame.PawnScan.RookFileDeltaAbs = abs((EvalEndgame.PawnScan.File - IdxToFile[WeakRookIdx]));
                    If (((EvalEndgame.PawnScan.IsNextToWeakKing == 1) And (EvalEndgame.PawnScan.RelativeRank == (EvalEndgame.PawnScan.RookRelativeRank + 1))) And (EvalEndgame.PawnScan.RookFileDeltaAbs == 1))
                    {
                        Ret.EvalEndgame.PawnScan.HasRookFortressPawn = 1;
                    }
                }
            }
        }
        EvalEndgame.PawnScan.ListIdx += 1;
    }
}

Define EvalEndgame.PushToEdge(string SqIdx) (warp=true)
{
    EvalEndgame.PushToEdge.FileEdgeDistance = (IdxToFile[SqIdx] - 1);
    If (EvalEndgame.PushToEdge.FileEdgeDistance > 3)
    {
        EvalEndgame.PushToEdge.FileEdgeDistance = (7 - EvalEndgame.PushToEdge.FileEdgeDistance);
    }
    EvalEndgame.PushToEdge.RankEdgeDistance = (IdxToRank[SqIdx] - 1);
    If (EvalEndgame.PushToEdge.RankEdgeDistance > 3)
    {
        EvalEndgame.PushToEdge.RankEdgeDistance = (7 - EvalEndgame.PushToEdge.RankEdgeDistance);
    }
    EvalEndgame.PushToEdge.FilePenalty = floor(((7 * (EvalEndgame.PushToEdge.FileEdgeDistance * EvalEndgame.PushToEdge.FileEdgeDistance)) / 2));
    EvalEndgame.PushToEdge.RankPenalty = floor(((7 * (EvalEndgame.PushToEdge.RankEdgeDistance * EvalEndgame.PushToEdge.RankEdgeDistance)) / 2));
    Ret.EvalEndgame.PushToEdge.Score = (90 - (EvalEndgame.PushToEdge.FilePenalty + EvalEndgame.PushToEdge.RankPenalty));
}

Define EvalEndgame.Scale(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.Scale.Factor = Const.Null;
    Call EvalEndgame.Material((0 - StrongSide));
    EvalEndgame.Scale.IsOtherSideExactEndgame = 0;
    If ((Ret.EvalEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvalEndgame.Material.StrongPawnCount == 1))
    {
        If ((Ret.EvalEndgame.Material.WeakPawnCount == 0) And ((Ret.EvalEndgame.Material.WeakPiecesAreRook == 1) Or (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEndgame.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If ((Ret.EvalEndgame.Material.StrongPiecesAreBishop == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 0))
    {
        If (((Ret.EvalEndgame.Material.StrongPawnCount == 1) And ((Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1) Or (Ret.EvalEndgame.Material.WeakPiecesAreKnight == 1))) Or ((Ret.EvalEndgame.Material.StrongPawnCount == 2) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEndgame.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If (((Ret.EvalEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvalEndgame.Material.StrongPawnCount == 2)) And ((Ret.EvalEndgame.Material.WeakPiecesAreRook == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 1)))
    {
        EvalEndgame.Scale.IsOtherSideExactEndgame = 1;
    }
    If (EvalEndgame.Scale.IsOtherSideExactEndgame == 1)
    {
        Stop(this script);
    }
    Call EvalEndgame.Material(StrongSide);
    EvalEndgame.Scale.StrongPawnCount = Ret.EvalEndgame.Material.StrongPawnCount;
    EvalEndgame.Scale.WeakPawnCount = Ret.EvalEndgame.Material.WeakPawnCount;
    If (Ret.EvalEndgame.Material.StrongPiecesAreRook == 1)
    {
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvalEndgame.KRPKR(Ply)(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KRPKR.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvalEndgame.KRPKB(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KRPKB.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 2) And (EvalEndgame.Scale.WeakPawnCount == 1)) And (Ret.EvalEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvalEndgame.KRPPKRP(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KRPPKRP.Factor;
            Stop(this script);
        }
    }
    If (Ret.EvalEndgame.Material.StrongPiecesAreBishop == 1)
    {
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvalEndgame.KBPKB(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPKB.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreKnight == 1))
        {
            Call EvalEndgame.KBPKN(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPKN.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 2) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvalEndgame.KBPPKB(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPPKB.Factor;
            Stop(this script);
        }
        If (EvalEndgame.Scale.StrongPawnCount > 0)
        {
            Call EvalEndgame.KBPsK(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPsK.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvalEndgame.Material.StrongPiecesAreQueen == 1) And (EvalEndgame.Scale.StrongPawnCount == 0))
    {
        If ((Ret.EvalEndgame.Material.WeakRookCount == 1) And (EvalEndgame.Scale.WeakPawnCount > 0))
        {
            Call EvalEndgame.KQKRPs(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KQKRPs.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvalEndgame.Material.StrongPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPiecesAreNone == 1))
    {
        If ((EvalEndgame.Scale.StrongPawnCount > 1) And (EvalEndgame.Scale.WeakPawnCount == 0))
        {
            Call EvalEndgame.KPsK(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KPsK.Factor;
        }
        If ((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 1))
        {
            Call EvalEndgame.KPK(Ply)(StrongSide);
            If (Not (((EvalEndgame.KPK.PawnRank > 3) And (EvalEndgame.KPK.PawnFile > 0))))
            {
                If (Ret.EvalEndgame.KPK.IsWin == 0)
                {
                    Ret.EvalEndgame.Scale.Factor = 0;
                }
            }
        }
    }
}

Define EvalEndgame.StrongToMove(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.StrongToMove.IsStrongToMove = PlyIsOwn[(Ply + 1)];
    If (StrongSide < 0)
    {
        Ret.EvalEndgame.StrongToMove.IsStrongToMove = (1 - Ret.EvalEndgame.StrongToMove.IsStrongToMove);
    }
}

Define Evaluate(string Ply)(bool ForceFullEval) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodEnter(Ply);
    }
    Ret.Evaluate.Score = Const.Null;
    If (Glob.Eval.IsClassicEndgame == 1)
    {
        If (Ply == 0)
        {
            Call EvaluateBoardBasic;
            Call CalcBoardAttackedByMove(2);
            Call StoreAttackInfo(1);
        }
    }
    If ForceFullEval
    {
        Ret.Evaluate.Score = 0;
        Eval.Side = 0;
        If (((Glob.Board.BlackPawnCount + (Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount)) == 0) And (((Glob.Board.WhiteQueenCount + Glob.Board.WhiteRookCount) > 0) Or (Glob.Board.WhiteNonQueenMajorMinorCount > 1)))
        {
            Eval.Side = 2;
        }
        If (((Glob.Board.WhitePawnCount + (Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount)) == 0) And (((Glob.Board.BlackQueenCount + Glob.Board.BlackRookCount) > 0) Or (Glob.Board.BlackNonQueenMajorMinorCount > 1)))
        {
            Eval.Side = 1;
        }
        If (Eval.Side == 0)
        {
            Call NNUE_UpdateAccStack(Ply);
            Call NNUE_Public_Evaluate((Ply + 1));
            Ret.Evaluate.Score = Operator.Round(Ret.NNUE_Public_Evaluate.Score);
            If (1 == 0)
            {
                Ret.Evaluate.Score = Operator.Round(((Ret.Evaluate.Score * (52 + ((Glob.Board.WhiteNonQueenMajorMinorCount + Glob.Board.BlackNonQueenMajorMinorCount) + ((Glob.Board.WhiteRookCount + Glob.Board.BlackRookCount) + (4 * (Glob.Board.WhiteQueenCount + Glob.Board.BlackQueenCount)))))) / 64));
                If (Ret.Evaluate.Score > 4096)
                {
                    Ret.Evaluate.Score = Operator.Round((4096 + ((Ret.Evaluate.Score - 4096) / 8)));
                }
                If (Ret.Evaluate.Score < -4096)
                {
                    Ret.Evaluate.Score = Operator.Round((-4096 + ((Ret.Evaluate.Score + 4096) / 8)));
                }
            }
            Evaluate.IsSpecialized = 0;
            Evaluate.PieceCount = ((Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount) + (Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount));
            If (Evaluate.PieceCount < 4)
            {
                Call EvalEndgame(Ply);
                If (Not ((Ret.EvalEndgame.Score == Const.Null)))
                {
                    Ret.Evaluate.Score = (Operator.Round(((Ret.EvalEndgame.Score * (52 + ((Glob.Board.WhiteNonQueenMajorMinorCount + Glob.Board.BlackNonQueenMajorMinorCount) + ((Glob.Board.WhiteRookCount + Glob.Board.BlackRookCount) + (4 * (Glob.Board.WhiteQueenCount + Glob.Board.BlackQueenCount)))))) / 64)) + (Ret.EvalEndgame.KnownWin * 5000));
                    Evaluate.IsSpecialized = 1;
                }
                Else
                {
                    Evaluate.StrongSide = ((Ret.Evaluate.Score > 0) - (Ret.Evaluate.Score < 0));
                    If (Not ((Evaluate.StrongSide == 0)))
                    {
                        Call EvalEndgame.Scale(Ply)(Evaluate.StrongSide);
                        If (Not ((Ret.EvalEndgame.Scale.Factor == Const.Null)))
                        {
                            Ret.Evaluate.Score = Operator.Round(((Ret.Evaluate.Score * Ret.EvalEndgame.Scale.Factor) / 64));
                        }
                    }
                }
            }
            If (Evaluate.IsSpecialized == 0)
            {
                Call EvaluatePostProcess(Ply)(Ret.Evaluate.Score);
                Ret.Evaluate.Score = Ret.EvaluatePostProcess.Score;
            }
        }
        Else
        {
            Call EvaluateBoardBasic;
            Ret.Evaluate.Score = Ret.EvaluateBoardBasic.Score;
            If (Not ((Eval.Side == 0)))
            {
                If (Eval.Side == 2)
                {
                    Eval.MateDriveBonus = (PushToEdges[Glob.Board.BlackKingIdx] + PushClose[ChebyshevDistance[((Glob.Board.WhiteKingIdx * 100) + Glob.Board.BlackKingIdx)]]);
                    Eval.MateCornerBonus = 0;
                    If (((Glob.Board.WhitePawnCount == 0) And (Glob.Board.WhiteQueenCount == 0)) And ((Glob.Board.WhiteRookCount == 0) And (Glob.Board.WhiteNonQueenMajorMinorCount == 2)))
                    {
                        Eval.KBNScanIdx = 0;
                        Eval.KBNBishopCount = 0;
                        Eval.KBNBishopIdx = 0;
                        Repeat (64)
                        {
                            Eval.KBNScanIdx += 1;
                            If (Board[Eval.KBNScanIdx] == GoK_WhiteBishop)
                            {
                                Eval.KBNBishopCount += 1;
                                Eval.KBNBishopIdx = Eval.KBNScanIdx;
                            }
                        }
                        If (Eval.KBNBishopCount == 1)
                        {
                            If (((IdxToFile[Eval.KBNBishopIdx] + IdxToRank[Eval.KBNBishopIdx]) % 2) == 1)
                            {
                                Eval.MateCornerBonus = (abs((IdxToRank[Glob.Board.BlackKingIdx] - IdxToFile[Glob.Board.BlackKingIdx])) * 210);
                            }
                            Else
                            {
                                Eval.MateCornerBonus = (abs(((IdxToRank[Glob.Board.BlackKingIdx] + IdxToFile[Glob.Board.BlackKingIdx]) - 9)) * 210);
                            }
                        }
                    }
                    Eval.MateDriveBonus += Eval.MateCornerBonus;
                    Ret.Evaluate.Score += (0 - Eval.MateDriveBonus);
                }
                Else
                {
                    Eval.MateDriveBonus = (PushToEdges[Glob.Board.WhiteKingIdx] + PushClose[ChebyshevDistance[((Glob.Board.WhiteKingIdx * 100) + Glob.Board.BlackKingIdx)]]);
                    Eval.MateCornerBonus = 0;
                    If (((Glob.Board.BlackPawnCount == 0) And (Glob.Board.BlackQueenCount == 0)) And ((Glob.Board.BlackRookCount == 0) And (Glob.Board.BlackNonQueenMajorMinorCount == 2)))
                    {
                        Eval.KBNScanIdx = 0;
                        Eval.KBNBishopCount = 0;
                        Eval.KBNBishopIdx = 0;
                        Repeat (64)
                        {
                            Eval.KBNScanIdx += 1;
                            If (Board[Eval.KBNScanIdx] == GoK_BlackBishop)
                            {
                                Eval.KBNBishopCount += 1;
                                Eval.KBNBishopIdx = Eval.KBNScanIdx;
                            }
                        }
                        If (Eval.KBNBishopCount == 1)
                        {
                            If (((IdxToFile[Eval.KBNBishopIdx] + IdxToRank[Eval.KBNBishopIdx]) % 2) == 1)
                            {
                                Eval.MateCornerBonus = (abs((IdxToRank[Glob.Board.WhiteKingIdx] - IdxToFile[Glob.Board.WhiteKingIdx])) * 210);
                            }
                            Else
                            {
                                Eval.MateCornerBonus = (abs(((IdxToRank[Glob.Board.WhiteKingIdx] + IdxToFile[Glob.Board.WhiteKingIdx]) - 9)) * 210);
                            }
                        }
                    }
                    Eval.MateDriveBonus += Eval.MateCornerBonus;
                    Ret.Evaluate.Score += Eval.MateDriveBonus;
                }
            }
            Ret.Evaluate.Score = Operator.Round(((Ret.Evaluate.Score * (52 + ((Glob.Board.WhiteNonQueenMajorMinorCount + Glob.Board.BlackNonQueenMajorMinorCount) + ((Glob.Board.WhiteRookCount + Glob.Board.BlackRookCount) + (4 * (Glob.Board.WhiteQueenCount + Glob.Board.BlackQueenCount)))))) / 64));
            Eval.KnownWin = 0;
            Evaluate.Sign = ((Eval.Side == 1) - (Eval.Side == 2));
            Evaluate.Queens = 0;
            Evaluate.Rooks = 0;
            Evaluate.Pawns = 0;
            If (Eval.Side == 1)
            {
                Evaluate.Queens = Glob.Board.BlackQueenCount;
                Evaluate.Rooks = Glob.Board.BlackRookCount;
                Evaluate.Pawns = Glob.Board.BlackPawnCount;
            }
            If (Eval.Side == 2)
            {
                Evaluate.Queens = Glob.Board.WhiteQueenCount;
                Evaluate.Rooks = Glob.Board.WhiteRookCount;
                Evaluate.Pawns = Glob.Board.WhitePawnCount;
            }
            Evaluate.BishopsOdd = 0;
            Evaluate.BishopsEven = 0;
            Evaluate.Knights = 0;
            Evaluate.Idx = 1;
            Repeat (64)
            {
                If ((Board[Evaluate.Idx] * Evaluate.Sign) == GoK_BlackBishop)
                {
                    If (((IdxToFile[Evaluate.Idx] + IdxToRank[Evaluate.Idx]) % 2) == 1)
                    {
                        Evaluate.BishopsOdd += 1;
                    }
                    If (((IdxToFile[Evaluate.Idx] + IdxToRank[Evaluate.Idx]) % 2) == 0)
                    {
                        Evaluate.BishopsEven += 1;
                    }
                }
                If ((Board[Evaluate.Idx] * Evaluate.Sign) == GoK_BlackKnight)
                {
                    Evaluate.Knights += 1;
                }
                Evaluate.Idx += 1;
            }
            If (((Evaluate.Queens + Evaluate.Rooks) > 0) Or (((Evaluate.BishopsOdd > 0) And (Evaluate.BishopsEven > 0)) Or (((Evaluate.BishopsOdd + Evaluate.BishopsEven) > 0) And (Evaluate.Knights > 0))))
            {
                Eval.KnownWin = 1;
            }
            If ((((Evaluate.Knights == 2) And ((Evaluate.BishopsOdd + Evaluate.BishopsEven) == 0)) And ((Evaluate.Queens + Evaluate.Rooks) == 0)) And (Evaluate.Pawns == 0))
            {
                Ret.Evaluate.Score = 0;
            }
            If (Eval.KnownWin == 1)
            {
                If (Eval.Side == 2)
                {
                    Ret.Evaluate.Score += -5000;
                }
                If (Eval.Side == 1)
                {
                    Ret.Evaluate.Score += 5000;
                }
            }
            If (((Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount) + (Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount)) < 4)
            {
                Call EvalEndgame(Ply);
                If (Not ((Ret.EvalEndgame.Score == Const.Null)))
                {
                    Ret.Evaluate.Score = (Operator.Round(((Ret.EvalEndgame.Score * (52 + ((Glob.Board.WhiteNonQueenMajorMinorCount + Glob.Board.BlackNonQueenMajorMinorCount) + ((Glob.Board.WhiteRookCount + Glob.Board.BlackRookCount) + (4 * (Glob.Board.WhiteQueenCount + Glob.Board.BlackQueenCount)))))) / 64)) + (Ret.EvalEndgame.KnownWin * 5000));
                }
            }
            Call EvaluatePostProcess(Ply)(Ret.Evaluate.Score);
            Ret.Evaluate.Score = Ret.EvaluatePostProcess.Score;
        }
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodExit(Ply);
    }
}

Define EvaluateBoardBasic (warp=true)
{
    EvaluateBoardBasic.SqIdx = 1;
    Ret.EvaluateBoardBasic.Score = 0;
    Repeat (64)
    {
        EvaluateBoardBasic.Piece = (Board[EvaluateBoardBasic.SqIdx] + 0);
        If (Not ((EvaluateBoardBasic.Piece == 0)))
        {
            Ret.EvaluateBoardBasic.Score += EvaluateBoardBasic.Piece;
            Call GetPiecePosEval(EvaluateBoardBasic.Piece)(EvaluateBoardBasic.SqIdx);
            Ret.EvaluateBoardBasic.Score += Ret.GetPiecePosEval.Score;
        }
        EvaluateBoardBasic.SqIdx += 1;
    }
}

Define EvaluatePostProcess(string Ply)(string Score) (warp=true)
{
    Ret.EvaluatePostProcess.Score = Score;
    Call //("Early promotion detection via Rule-of-Squares / Chebyshev distance");
    If (((Glob.Board.WhiteQueenCount + Glob.Board.WhiteNonQueenMajorMinorCount) == 0) And ((Glob.Board.BlackQueenCount + Glob.Board.BlackNonQueenMajorMinorCount) == 0))
    {
        List.DeleteItem(PawnCount, all);
        Repeat (8)
        {
            List.Add(PawnCount, 0);
        }
        Repeat (8)
        {
            List.Add(PawnCount, 0);
        }
        List.DeleteItem(PawnAdvancePerFile, all);
        Repeat (32)
        {
            List.Add(PawnAdvancePerFile, 0);
        }
        EvaluatePostProcess.Idx = 1;
        Repeat (64)
        {
            EvaluatePostProcess.SourcePiece = (Board[EvaluatePostProcess.Idx] + 0);
            If (EvaluatePostProcess.SourcePiece == GoK_BlackPawn)
            {
                EvaluatePostProcess.File = (IdxToFile[EvaluatePostProcess.Idx] + 0);
                EvaluatePostProcess.Rank = (IdxToRank[EvaluatePostProcess.Idx] + 0);
                List.ReplaceItem(PawnCount, (EvaluatePostProcess.File + 8), (PawnCount[(EvaluatePostProcess.File + 8)] + 1));
                If ((PawnAdvancePerFile[(EvaluatePostProcess.File + Const.PawnAdvance.BlackRear)] == 0) Or (EvaluatePostProcess.Rank < PawnAdvancePerFile[(EvaluatePostProcess.File + Const.PawnAdvance.BlackRear)]))
                {
                    List.ReplaceItem(PawnAdvancePerFile, (EvaluatePostProcess.File + Const.PawnAdvance.BlackRear), EvaluatePostProcess.Rank);
                }
                If (EvaluatePostProcess.Rank > PawnAdvancePerFile[(EvaluatePostProcess.File + Const.PawnAdvance.BlackFront)])
                {
                    List.ReplaceItem(PawnAdvancePerFile, (EvaluatePostProcess.File + Const.PawnAdvance.BlackFront), EvaluatePostProcess.Rank);
                }
            }
            If (EvaluatePostProcess.SourcePiece == GoK_WhitePawn)
            {
                EvaluatePostProcess.File = (IdxToFile[EvaluatePostProcess.Idx] + 0);
                EvaluatePostProcess.Rank = (IdxToRank[EvaluatePostProcess.Idx] + 0);
                List.ReplaceItem(PawnCount, EvaluatePostProcess.File, (PawnCount[EvaluatePostProcess.File] + 1));
                If (EvaluatePostProcess.Rank > PawnAdvancePerFile[EvaluatePostProcess.File])
                {
                    List.ReplaceItem(PawnAdvancePerFile, EvaluatePostProcess.File, EvaluatePostProcess.Rank);
                }
                If ((PawnAdvancePerFile[(EvaluatePostProcess.File + Const.PawnAdvance.WhiteFront)] == 0) Or (EvaluatePostProcess.Rank < PawnAdvancePerFile[(EvaluatePostProcess.File + Const.PawnAdvance.WhiteFront)]))
                {
                    List.ReplaceItem(PawnAdvancePerFile, (EvaluatePostProcess.File + Const.PawnAdvance.WhiteFront), EvaluatePostProcess.Rank);
                }
            }
            EvaluatePostProcess.Idx += 1;
        }
        EvaluatePostProcess.WhiteQueener = 99;
        EvaluatePostProcess.BlackQueener = 99;
        EvaluatePostProcess.BlackFastest = 99;
        EvaluatePostProcess.WhiteFastest = 99;
        EvaluatePostProcess.Side = 1;
        Repeat (2)
        {
            If (EvaluatePostProcess.Side == 1)
            {
                EvaluatePostProcess.OurOffset = Const.PawnAdvance.BlackFront;
                EvaluatePostProcess.TheirOffset = Const.PawnAdvance.WhiteRear;
                EvaluatePostProcess.PromoBase = 56;
                EvaluatePostProcess.KingIdx = Glob.Board.BlackKingIdx;
                EvaluatePostProcess.TheirKingIdx = Glob.Board.WhiteKingIdx;
            }
            Else
            {
                EvaluatePostProcess.OurOffset = Const.PawnAdvance.WhiteFront;
                EvaluatePostProcess.TheirOffset = Const.PawnAdvance.BlackRear;
                EvaluatePostProcess.PromoBase = 0;
                EvaluatePostProcess.KingIdx = Glob.Board.WhiteKingIdx;
                EvaluatePostProcess.TheirKingIdx = Glob.Board.BlackKingIdx;
            }
            EvaluatePostProcess.Idx = 1;
            Repeat (8)
            {
                EvaluatePostProcess.OurForwardRank = PawnAdvancePerFile[(EvaluatePostProcess.Idx + EvaluatePostProcess.OurOffset)];
                If (Not ((EvaluatePostProcess.OurForwardRank == 0)))
                {
                    EvaluatePostProcess.NFwd = ((Not ((EvaluatePostProcess.OurForwardRank == 0))) * (EvaluatePostProcess.OurForwardRank + ((EvaluatePostProcess.Side == 2) * (9 - (2 * EvaluatePostProcess.OurForwardRank)))));
                    If (EvaluatePostProcess.NFwd > 1)
                    {
                        EvaluatePostProcess.NBack = ((Not ((PawnAdvancePerFile[(EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset)] == 0))) * (PawnAdvancePerFile[(EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset)] + ((EvaluatePostProcess.Side == 2) * (9 - (2 * PawnAdvancePerFile[(EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset)])))));
                        If (EvaluatePostProcess.NFwd > EvaluatePostProcess.NBack)
                        {
                            If (EvaluatePostProcess.Idx > 1)
                            {
                                EvaluatePostProcess.NAdj = ((Not ((PawnAdvancePerFile[((EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset) - 1)] == 0))) * (PawnAdvancePerFile[((EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset) - 1)] + ((EvaluatePostProcess.Side == 2) * (9 - (2 * PawnAdvancePerFile[((EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset) - 1)])))));
                            }
                            If ((EvaluatePostProcess.Idx == 1) Or (Not ((EvaluatePostProcess.NFwd < EvaluatePostProcess.NAdj))))
                            {
                                EvaluatePostProcess.NAdj = ((Not ((PawnAdvancePerFile[((EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset) + 1)] == 0))) * (PawnAdvancePerFile[((EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset) + 1)] + ((EvaluatePostProcess.Side == 2) * (9 - (2 * PawnAdvancePerFile[((EvaluatePostProcess.Idx + EvaluatePostProcess.TheirOffset) + 1)])))));
                                If ((EvaluatePostProcess.Idx == 8) Or (Not ((EvaluatePostProcess.NFwd < EvaluatePostProcess.NAdj))))
                                {
                                    EvaluatePostProcess.TargetIdx = (EvaluatePostProcess.PromoBase + EvaluatePostProcess.Idx);
                                    EvaluatePostProcess.Delta = (8 - EvaluatePostProcess.NFwd);
                                    If (EvaluatePostProcess.Delta > 5)
                                    {
                                        EvaluatePostProcess.Delta = 5;
                                    }
                                    If (EvaluatePostProcess.Side == 1)
                                    {
                                        If (EvaluatePostProcess.Delta < EvaluatePostProcess.BlackFastest)
                                        {
                                            EvaluatePostProcess.BlackFastest = EvaluatePostProcess.Delta;
                                        }
                                    }
                                    Else
                                    {
                                        If (EvaluatePostProcess.Delta < EvaluatePostProcess.WhiteFastest)
                                        {
                                            EvaluatePostProcess.WhiteFastest = EvaluatePostProcess.Delta;
                                        }
                                    }
                                    If ((ChebyshevDistance[((EvaluatePostProcess.TheirKingIdx * 100) + EvaluatePostProcess.TargetIdx)] - (((Ply + EvaluatePostProcess.Side) + 1) % 2)) > EvaluatePostProcess.Delta)
                                    {
                                        EvaluatePostProcess.QueeningDelta = EvaluatePostProcess.Delta;
                                        If ((IdxToFile[EvaluatePostProcess.KingIdx] == EvaluatePostProcess.Idx) And (((Not ((IdxToRank[EvaluatePostProcess.KingIdx] == 0))) * (IdxToRank[EvaluatePostProcess.KingIdx] + ((EvaluatePostProcess.Side == 2) * (9 - (2 * IdxToRank[EvaluatePostProcess.KingIdx]))))) > EvaluatePostProcess.NFwd))
                                        {
                                            If ((EvaluatePostProcess.Idx == 1) Or (EvaluatePostProcess.Idx == 8))
                                            {
                                                EvaluatePostProcess.QueeningDelta = 99;
                                            }
                                            Else
                                            {
                                                EvaluatePostProcess.QueeningDelta += 1;
                                            }
                                        }
                                        If (EvaluatePostProcess.Side == 1)
                                        {
                                            If (EvaluatePostProcess.QueeningDelta < EvaluatePostProcess.BlackQueener)
                                            {
                                                EvaluatePostProcess.BlackQueener = EvaluatePostProcess.QueeningDelta;
                                            }
                                        }
                                        Else
                                        {
                                            If (EvaluatePostProcess.QueeningDelta < EvaluatePostProcess.WhiteQueener)
                                            {
                                                EvaluatePostProcess.WhiteQueener = EvaluatePostProcess.QueeningDelta;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                EvaluatePostProcess.Idx += 1;
            }
            EvaluatePostProcess.Side += 1;
        }
        If ((EvaluatePostProcess.WhiteQueener < EvaluatePostProcess.BlackQueener) And (((2 * EvaluatePostProcess.BlackFastest) + ((Ply + 2) % 2)) > (((2 * EvaluatePostProcess.WhiteQueener) + ((Ply + 3) % 2)) + 1)))
        {
            Ret.EvaluatePostProcess.Score += ((GoK_WhiteQueen - GoK_WhitePawn) + 100);
        }
        Else
        {
            If ((EvaluatePostProcess.BlackQueener < EvaluatePostProcess.WhiteQueener) And (((2 * EvaluatePostProcess.WhiteFastest) + ((Ply + 3) % 2)) > (((2 * EvaluatePostProcess.BlackQueener) + ((Ply + 2) % 2)) + 1)))
            {
                Ret.EvaluatePostProcess.Score += ((GoK_BlackQueen - GoK_BlackPawn) - 100);
            }
        }
    }
}

Define ExecuteEngineMove (warp=false)
{
    Call EnterExecution;
    Call ExecuteEngineMoveImpl;
    Call ExitExecution;
}

Define ExecuteEngineMoveImpl (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Glob.Clock.PlayerRunning = 0;
    Event.Broadcast("UI_OpeningBookHide");
    ExecuteEngineMoveImpl.Move = Const.Null;
    If ((Glob.Config.Level > 1) And (1 == 1))
    {
        Call GetOpeningMoves;
        If (List.Length(OpeningMovesRes) > 0)
        {
            Event.Broadcast("UI_OpeningBookShow");
            ExecuteEngineMoveImpl.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
            If (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0))
            {
                Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.TimeInc);
                Glob.Clock.MoveCount += 1;
                If ((Glob.Clock.StageMoves > 0) And (Glob.Clock.MoveCount == Glob.Clock.StageMoves))
                {
                    Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.StageTime);
                }
            }
        }
    }
    Call IsEngineValidMove(ExecuteEngineMoveImpl.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Control.Wait(0);
        Call SearchWrp.Main;
        ExecuteEngineMoveImpl.Move = Ret.SearchWrp.Main.Move;
    }
    Call OnProgressChanged(100);
    Control.Wait(0);
    Call IsEngineValidMove(ExecuteEngineMoveImpl.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Looks.Say(Operator.Join("Internal Error: No valid move found. Sorry, this should not happen. Maybe you cleared lookup lists in the editor? If you are running a normal game, please export board data and report bug via project comment", Operator.Join(" Move: ", ExecuteEngineMoveImpl.Move)), 10);
        GoK_IsGameSuspended = 1;
        Stop(this script);
    }
    Looks.Think("");
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((ExecuteEngineMoveImpl.Move / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((ExecuteEngineMoveImpl.Move % 100))];
    If (((ExecuteEngineMoveImpl.Move == GoK_BlackQueensideCastling) Or (ExecuteEngineMoveImpl.Move == GoK_BlackKingsideCastling)) Or ((ExecuteEngineMoveImpl.Move == GoK_WhiteQueensideCastling) Or (ExecuteEngineMoveImpl.Move == GoK_WhiteKingsideCastling)))
    {
        Pieces_MovePieceSpecial = ExecuteEngineMoveImpl.Move;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    If (ExecuteEngineMoveImpl.Move == GoK_BlackKingsideCastling)
    {
        Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
        Stg_BestMoveToIdx = GoK_ScreenIdx[7];
    }
    Else
    {
        If (ExecuteEngineMoveImpl.Move == GoK_BlackQueensideCastling)
        {
            Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
            Stg_BestMoveToIdx = GoK_ScreenIdx[3];
        }
        Else
        {
            Stg_BestMoveFromIdx = Pieces_MovePieceFromIdx;
            Stg_BestMoveToIdx = Pieces_MovePieceToIdx;
        }
    }
    Event.BroadcastAndWait("UI_ShowBestMove");
    Event.BroadcastAndWait("Pieces_MovePiece");
    Event.BroadcastAndWait("UI_HideBestMove");
    Event.Broadcast("SoundMove");
    List.Add(GameMoves, floor(ExecuteEngineMoveImpl.Move));
    Call GetMoveNotation(ExecuteEngineMoveImpl.Move);
    List.Add(GameMovesAN, Ret.GetMoveNotation.Notation);
    Call ClearMoveList(1);
    Call AddMoveToList((ExecuteEngineMoveImpl.Move + 0))(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1)((1 == 1));
    Call DrawBoardAndWait;
    If (Not ((floor((ExecuteEngineMoveImpl.Move / 100)) == 0)))
    {
        If (Board[(ExecuteEngineMoveImpl.Move % 100)] == GoK_BlackKing)
        {
            Glob.Board.HasBlackKingMoved = 1;
        }
        If (Board[(ExecuteEngineMoveImpl.Move % 100)] == GoK_BlackRook)
        {
            If (floor((ExecuteEngineMoveImpl.Move / 100)) == 1)
            {
                Glob.Board.HasBlackRookQSMoved = 1;
            }
            If (floor((ExecuteEngineMoveImpl.Move / 100)) == 8)
            {
                Glob.Board.HasBlackRookKSMoved = 1;
            }
        }
    }
    If ((ExecuteEngineMoveImpl.Move == GoK_BlackQueensideCastling) Or (ExecuteEngineMoveImpl.Move == GoK_BlackKingsideCastling))
    {
        Glob.Board.HasBlackKingMoved = 1;
        Glob.Board.HasBlackCastled = 1;
    }
    Call AddBoardToHistory(1);
    Call GetRepetitionCount;
    If (Ret.GetRepetitionCount.Count > 2)
    {
        Looks.Say("Draw!");
        Event.Broadcast("SoundDraw");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByMaterial;
        If (Ret.IsDrawByMaterial.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call IsWhiteKingCheckMate;
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Looks.Say("Checkmate!");
                Event.Broadcast("SoundCheckmate");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(2);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call CalcBoardAttackedByMove(1);
                    If (Glob.Board.IsWhiteChecked == 1)
                    {
                        Call SayAsync("Check!")(2);
                        Event.Broadcast("SoundCheck");
                    }
                }
            }
        }
    }
    Glob.Clock.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
    Glob.Clock.PlayerRunning = 1;
}

Define ExecuteInit (warp=false)
{
    Glob.Game.ExecutionPly = 0;
    Glob.Game.IsExecutionRunning = 0;
    If (Glob.Game.IsPlayerBlack == 1)
    {
        Call ExecuteEngineMove;
    }
}

Define ExecuteUserMove(string UserMove) (warp=false)
{
    Call EnterExecution;
    Call ExecuteUserMoveImpl(UserMove);
    Call ExitExecution;
}

Define ExecuteUserMoveImpl(string UserMoveParam) (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((UserMoveParam / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((UserMoveParam % 100))];
    If (((UserMoveParam == GoK_BlackQueensideCastling) Or (UserMoveParam == GoK_BlackKingsideCastling)) Or ((UserMoveParam == GoK_WhiteQueensideCastling) Or (UserMoveParam == GoK_WhiteKingsideCastling)))
    {
        Pieces_MovePieceSpecial = UserMoveParam;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.Broadcast("SoundMove");
    Stg_FromSquareIdx = -1;
    Stg_ToSquareIdx = -1;
    Event.BroadcastAndWait("Stg_FromSquareSelected");
    Event.BroadcastAndWait("Stg_ToSquareSelected");
    Event.BroadcastAndWait("UI_HideBestMove");
    Call GenerateMovesPublic(2);
    If (Not (List.ContainsItem(Moves2, UserMoveParam)))
    {
        Call SayAsync("Invalid move!")(2);
        Event.Broadcast("SoundInvalidMove");
        Call DrawBoardAndWait;
        Stop(this script);
    }
    If (((Glob.Clock.TimeControl == 1) And ((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0))) And (Glob.Config.CustomMaxDepth == 0))
    {
        Glob.Clock.PlayerTime = (Glob.Clock.PlayerTime + (Glob.Clock.TimeInc - (Glob.Clock.PlayerMoveEnd - Glob.Clock.PlayerMoveStart)));
        Glob.Clock.PlayerMoveCount += 1;
        If ((Glob.Clock.StageMoves > 0) And (Glob.Clock.PlayerMoveCount == Glob.Clock.StageMoves))
        {
            Glob.Clock.PlayerTime += Glob.Clock.StageTime;
        }
        Glob.Clock.PlayerRunning = 0;
        Call PublishTimers(0);
    }
    Glob.Game.UserMove = UserMoveParam;
    If (Operator.LetterOf(Glob.Game.UserMove, (Variable.Length(Glob.Game.UserMove) - 1)) == ".")
    {
        Looks.Say("Please select promotion piece");
        Event.BroadcastAndWait("Pieces_SelectPromotionPiece");
        Looks.Say("");
        If (Pieces_SelectedPromotionPiece == GoK_WhiteQueen)
        {
            Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.1);
        }
        Else
        {
            If (Pieces_SelectedPromotionPiece == GoK_WhiteRook)
            {
                Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.2);
            }
            Else
            {
                If (Pieces_SelectedPromotionPiece == GoK_WhiteBishop)
                {
                    Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.3);
                }
                Else
                {
                    If (Pieces_SelectedPromotionPiece == GoK_WhiteKnight)
                    {
                        Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.4);
                    }
                }
            }
        }
    }
    Call GetMoveNotation(Glob.Game.UserMove);
    ExecuteUserMoveImpl.Notation = Ret.GetMoveNotation.Notation;
    Call ClearMoveList(2);
    Call AddMoveToList((Glob.Game.UserMove + 0))(2)(0);
    List.ReplaceItem(MovesIdx, 2, 1);
    Call ApplyMove(2)((1 == 1));
    Call CalcBoardAttackedByMove(1);
    If (Glob.Board.IsWhiteChecked == 1)
    {
        Call RevertMove(2);
        Call DrawBoardAndWait;
        Control.Wait(0);
        Call SayAsync("Invalid move - Check!")(2);
        Event.Broadcast("SoundInvalidMoveCheck");
        Stop(this script);
    }
    List.Add(GameMovesAN, ExecuteUserMoveImpl.Notation);
    List.Add(GameMoves, floor(Glob.Game.UserMove));
    Call DrawBoardAndWait;
    Control.Wait(0);
    ExecuteUserMoveImpl.SourceIdx = floor((Glob.Game.UserMove / 100));
    ExecuteUserMoveImpl.TargetIdx = floor((Glob.Game.UserMove % 100));
    If (Board[ExecuteUserMoveImpl.TargetIdx] == GoK_WhiteKing)
    {
        Glob.Board.HasWhiteKingMoved = 1;
    }
    If (Board[ExecuteUserMoveImpl.TargetIdx] == GoK_WhiteRook)
    {
        If (ExecuteUserMoveImpl.SourceIdx == 57)
        {
            Glob.Board.HasWhiteRookQSMoved = 1;
        }
        If (ExecuteUserMoveImpl.SourceIdx == 64)
        {
            Glob.Board.HasWhiteRookKSMoved = 1;
        }
    }
    If ((Glob.Game.UserMove == GoK_WhiteQueensideCastling) Or (Glob.Game.UserMove == GoK_WhiteKingsideCastling))
    {
        Glob.Board.HasWhiteCastled = 1;
        Glob.Board.HasWhiteKingMoved = 1;
    }
    Call AddBoardToHistory(0);
    Call IsBlackKingCheckMate;
    If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
    {
        Looks.Say("Checkmate!");
        Event.Broadcast("SoundCheckmate");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByStalemate(1);
        If (Ret.IsDrawByStalemate.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call GetRepetitionCount;
            If (Ret.GetRepetitionCount.Count > 2)
            {
                Looks.Say("Draw!");
                Event.Broadcast("SoundDraw");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByMaterial;
                If (Ret.IsDrawByMaterial.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
    }
}

Define ExitExecution (warp=false)
{
    Glob.Game.ExecutionPly += -1;
    If (Glob.Game.ExecutionPly == 0)
    {
        Glob.Game.IsExecutionRunning = 0;
        Event.BroadcastAndWait("GoK_ModeInput");
        If ((Glob.Clock.PlayerRunning == 0) And (GoK_IsGameSuspended == 0))
        {
            Glob.Clock.PlayerMoveStart = (Sensing.DaysSince2000() * 86400);
            Glob.Clock.PlayerRunning = 1;
        }
        Call PublishTimers(0);
    }
}

Define ExportBoardFEN(string Ply) (warp=true)
{
    ExportBoardFEN.IsPlayerTurn = (((Ply % 2) == 0) + 0);
    ExportBoardFEN.StateIdx = Ply;
    If (Ply < 1)
    {
        ExportBoardFEN.StateIdx = 1;
    }
    Call StoreExternalBoard;
    ExportBoardFEN.SqIdx = 1;
    Ret.ExportBoardFEN.FEN = "";
    Ret.ExportBoardFEN.FENLichess = "https://lichess.org/analysis/";
    Repeat Until (ExportBoardFEN.SqIdx > 64)
    {
        ExportBoardFEN.Piece = GoK_Board[ExportBoardFEN.SqIdx];
        If (ExportBoardFEN.Piece == GoK_BlackPawn)
        {
            ExportBoardFEN.PieceChar = "p";
        }
        If (ExportBoardFEN.Piece == GoK_BlackKnight)
        {
            ExportBoardFEN.PieceChar = "n";
        }
        If (ExportBoardFEN.Piece == GoK_BlackBishop)
        {
            ExportBoardFEN.PieceChar = "b";
        }
        If (ExportBoardFEN.Piece == GoK_BlackRook)
        {
            ExportBoardFEN.PieceChar = "r";
        }
        If (ExportBoardFEN.Piece == GoK_BlackQueen)
        {
            ExportBoardFEN.PieceChar = "q";
        }
        If (ExportBoardFEN.Piece == GoK_BlackKing)
        {
            ExportBoardFEN.PieceChar = "k";
        }
        If (ExportBoardFEN.Piece == GoK_WhitePawn)
        {
            ExportBoardFEN.PieceChar = "P";
        }
        If (ExportBoardFEN.Piece == GoK_WhiteKnight)
        {
            ExportBoardFEN.PieceChar = "N";
        }
        If (ExportBoardFEN.Piece == GoK_WhiteBishop)
        {
            ExportBoardFEN.PieceChar = "B";
        }
        If (ExportBoardFEN.Piece == GoK_WhiteRook)
        {
            ExportBoardFEN.PieceChar = "R";
        }
        If (ExportBoardFEN.Piece == GoK_WhiteQueen)
        {
            ExportBoardFEN.PieceChar = "Q";
        }
        If (ExportBoardFEN.Piece == GoK_WhiteKing)
        {
            ExportBoardFEN.PieceChar = "K";
        }
        If (ExportBoardFEN.Piece == 0)
        {
            ExportBoardFEN.ScanSqIdx = ExportBoardFEN.SqIdx;
            Repeat Until (((ExportBoardFEN.ScanSqIdx % 8) == 0) Or (Not ((GoK_Board[(ExportBoardFEN.ScanSqIdx + 1)] == 0))))
            {
                ExportBoardFEN.ScanSqIdx += 1;
            }
            ExportBoardFEN.PieceChar = ((ExportBoardFEN.ScanSqIdx - ExportBoardFEN.SqIdx) + 1);
            ExportBoardFEN.SqIdx += (ExportBoardFEN.ScanSqIdx - ExportBoardFEN.SqIdx);
        }
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, ExportBoardFEN.PieceChar);
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, ExportBoardFEN.PieceChar);
        If (((ExportBoardFEN.SqIdx % 8) == 0) And (ExportBoardFEN.SqIdx < 64))
        {
            Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, "/");
            Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "/");
        }
        ExportBoardFEN.SqIdx += 1;
    }
    If (((Glob.Game.IsPlayerBlack == 1) And (ExportBoardFEN.IsPlayerTurn == 1)) Or ((Not ((Glob.Game.IsPlayerBlack == 1))) And (Not ((ExportBoardFEN.IsPlayerTurn == 1)))))
    {
        Call EBFEN.AppendField("b");
        ExportBoardFEN.BlackToMove = 1;
    }
    Else
    {
        Call EBFEN.AppendField("w");
        ExportBoardFEN.BlackToMove = 0;
    }
    Ret.ExportBoardFEN.IsWhite = (1 - ExportBoardFEN.BlackToMove);
    ExportBoardFEN.CS = CastlingState[ExportBoardFEN.StateIdx];
    If (ExportBoardFEN.CS == Const.Null)
    {
        ExportBoardFEN.CS = ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8]))));
    }
    ExportBoardFEN.WhiteOff = 4;
    ExportBoardFEN.BlackOff = 0;
    If (Glob.Game.IsPlayerBlack == 1)
    {
        ExportBoardFEN.WhiteOff = 0;
        ExportBoardFEN.BlackOff = 4;
    }
    ExportBoardFEN.Castling = "";
    Call EBFEN.AddCastling(ExportBoardFEN.CS)(ExportBoardFEN.WhiteOff)(61)(GoK_WhiteKing)(GoK_WhiteRook)(64)(57)("K")("Q");
    ExportBoardFEN.Castling = Operator.Join(ExportBoardFEN.Castling, Ret.EBFEN.AddCastling.Text);
    Call EBFEN.AddCastling(ExportBoardFEN.CS)(ExportBoardFEN.BlackOff)(5)(GoK_BlackKing)(GoK_BlackRook)(8)(1)("k")("q");
    ExportBoardFEN.Castling = Operator.Join(ExportBoardFEN.Castling, Ret.EBFEN.AddCastling.Text);
    If (Variable.Length(ExportBoardFEN.Castling) == 0)
    {
        ExportBoardFEN.Castling = "-";
    }
    Call EBFEN.AppendField(ExportBoardFEN.Castling);
    ExportBoardFEN.EPText = "-";
    ExportBoardFEN.EPSq = 0;
    ExportBoardFEN.EPX = 0;
    ExportBoardFEN.EP = EnPassantTarget[ExportBoardFEN.StateIdx];
    If ((Not ((ExportBoardFEN.EP == Const.Null))) And (ExportBoardFEN.EP > 0))
    {
        ExportBoardFEN.EPX = ExportBoardFEN.EP;
        If (Glob.Game.IsPlayerBlack == 1)
        {
            ExportBoardFEN.EPX = RankFlipIdx[ExportBoardFEN.EP];
        }
        If ((ExportBoardFEN.EPX > 32) And (ExportBoardFEN.EPX < 41))
        {
            If (ExportBoardFEN.BlackToMove == 1)
            {
                ExportBoardFEN.EPSq = (ExportBoardFEN.EPX + 8);
            }
        }
        If ((ExportBoardFEN.EPX > 24) And (ExportBoardFEN.EPX < 33))
        {
            If (ExportBoardFEN.BlackToMove == 0)
            {
                ExportBoardFEN.EPSq = (ExportBoardFEN.EPX - 8);
            }
        }
    }
    If (ExportBoardFEN.EPSq > 0)
    {
        ExportBoardFEN.EPText = Operator.Join(Operator.LetterOf("abcdefgh", (((ExportBoardFEN.EPSq - 1) % 8) + 1)), (9 - ceiling((ExportBoardFEN.EPSq / 8))));
    }
    Call EBFEN.AppendField(ExportBoardFEN.EPText);
    ExportBoardFEN.Halfmove = 0;
    If (List.Length(BoardHistoryFiftyMoves) > 0)
    {
        ExportBoardFEN.Halfmove = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
    }
    Call EBFEN.AppendField(ExportBoardFEN.Halfmove);
    ExportBoardFEN.F0 = (Glob.Game.FenFullMove + floor((((List.Length(GameMovesAN) - Glob.Game.FenPlyBase) + Glob.Game.FenBlackToMove) / 2)));
    ExportBoardFEN.Fullmove = ExportBoardFEN.F0;
    If (Ply > 1)
    {
        ExportBoardFEN.R = 0;
        If (Not ((Glob.Game.IsPlayerBlack == 1)))
        {
            ExportBoardFEN.R = 1;
        }
        ExportBoardFEN.Fullmove = (ExportBoardFEN.F0 + floor((((Ply - 1) + ExportBoardFEN.R) / 2)));
    }
    Call EBFEN.AppendField(ExportBoardFEN.Fullmove);
}

Define ExportMovesPGN (warp=true)
{
    ExportMovesPGN.GameMovesANIdx = 1;
    Ret.ExportMovesPGN.PGN = "";
    Repeat (List.Length(GameMovesAN))
    {
        If ((ExportMovesPGN.GameMovesANIdx % 2) == 1)
        {
            Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join((((ExportMovesPGN.GameMovesANIdx - 1) / 2) + 1), ". "));
        }
        Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join(GameMovesAN[ExportMovesPGN.GameMovesANIdx], " "));
        ExportMovesPGN.GameMovesANIdx += 1;
    }
}

Define FillBoard (warp=true)
{
    List.DeleteAll(GoK_ScreenIdx);
    FillBoard.ScreenSqIdx = 1;
    Repeat (64)
    {
        If (Glob.Game.IsPlayerBlack == 1)
        {
            List.Add(GoK_ScreenIdx, (((IdxToRank[FillBoard.ScreenSqIdx] - 1) * 8) + (9 - IdxToFile[FillBoard.ScreenSqIdx])));
        }
        Else
        {
            List.Add(GoK_ScreenIdx, FillBoard.ScreenSqIdx);
        }
        FillBoard.ScreenSqIdx += 1;
    }
    List.DeleteItem(Board, all);
    Repeat (64)
    {
        List.Add(Board, 0);
    }
    List.ReplaceItem(Board, 1, GoK_BlackRook);
    List.ReplaceItem(Board, 2, GoK_BlackKnight);
    List.ReplaceItem(Board, 3, GoK_BlackBishop);
    List.ReplaceItem(Board, 4, GoK_BlackQueen);
    List.ReplaceItem(Board, 5, GoK_BlackKing);
    List.ReplaceItem(Board, 6, GoK_BlackBishop);
    List.ReplaceItem(Board, 7, GoK_BlackKnight);
    List.ReplaceItem(Board, 8, GoK_BlackRook);
    FillBoard.SqIdx = 9;
    Repeat (8)
    {
        List.ReplaceItem(Board, FillBoard.SqIdx, GoK_BlackPawn);
        FillBoard.SqIdx += 1;
    }
    FillBoard.SqIdx = 49;
    Repeat (8)
    {
        List.ReplaceItem(Board, FillBoard.SqIdx, GoK_WhitePawn);
        FillBoard.SqIdx += 1;
    }
    List.ReplaceItem(Board, 57, GoK_WhiteRook);
    List.ReplaceItem(Board, 58, GoK_WhiteKnight);
    List.ReplaceItem(Board, 59, GoK_WhiteBishop);
    List.ReplaceItem(Board, 60, GoK_WhiteQueen);
    List.ReplaceItem(Board, 61, GoK_WhiteKing);
    List.ReplaceItem(Board, 62, GoK_WhiteBishop);
    List.ReplaceItem(Board, 63, GoK_WhiteKnight);
    List.ReplaceItem(Board, 64, GoK_WhiteRook);
}

Define GenerateMovesForSource(string Ply)(string SourceIdx)(bool AttackTableOnly)(bool Quiescence)(bool QuietsOnly)(bool QuietChecks) (warp=true)
{
    GenerateMovesForSource.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    Call //("Pawn moves (generated via code logic)");
    If (GenerateMovesForSource.SourcePiece == GoK_BlackPawn)
    {
        If (IdxToFile[(SourceIdx + 0)] > 1)
        {
            If (AttackTableOnly Or (Board[(SourceIdx + 7)] < 0))
            {
                If ((Not (QuietsOnly)) Or (IdxToRank[(SourceIdx + 0)] == 7))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 7))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        If (IdxToFile[(SourceIdx + 0)] < 8)
        {
            If (AttackTableOnly Or (Board[(SourceIdx + 9)] < 0))
            {
                If ((Not (QuietsOnly)) Or (IdxToRank[(SourceIdx + 0)] == 7))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 9))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        If (Not (AttackTableOnly))
        {
            If (Board[(SourceIdx + 8)] == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQMove(SourceIdx)((SourceIdx + 8))(GoK_BlackPawn)(Ply)(QuietChecks);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 8))(Ply)(AttackTableOnly)(Quiescence);
                }
                If ((IdxToRank[(SourceIdx + 0)] == 2) And (Board[(SourceIdx + 16)] == 0))
                {
                    If Quiescence
                    {
                        Call AddPotentialQMove(SourceIdx)((SourceIdx + 16))(GoK_BlackPawn)(Ply)(QuietChecks);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx + 16))(Ply)(AttackTableOnly)(Quiescence);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            GenerateMovesForSource.TargetIdx = EnPassantTarget[Ply];
            If ((Not (AttackTableOnly)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[GenerateMovesForSource.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[GenerateMovesForSource.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((GenerateMovesForSource.TargetIdx + 8))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        Stop(this script);
    }
    If (GenerateMovesForSource.SourcePiece == GoK_WhitePawn)
    {
        If (IdxToFile[(SourceIdx + 0)] > 1)
        {
            If (AttackTableOnly Or (Board[(SourceIdx - 9)] > 0))
            {
                If ((Not (QuietsOnly)) Or (IdxToRank[(SourceIdx + 0)] == 2))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 9))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        If (IdxToFile[(SourceIdx + 0)] < 8)
        {
            If (AttackTableOnly Or (Board[(SourceIdx - 7)] > 0))
            {
                If ((Not (QuietsOnly)) Or (IdxToRank[(SourceIdx + 0)] == 2))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 7))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        If (Not (AttackTableOnly))
        {
            If (Board[(SourceIdx - 8)] == 0)
            {
                If Quiescence
                {
                    Call AddPotentialQMove(SourceIdx)((SourceIdx - 8))(GoK_WhitePawn)(Ply)(QuietChecks);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 8))(Ply)(AttackTableOnly)(Quiescence);
                }
                If ((IdxToRank[(SourceIdx + 0)] == 7) And (Board[(SourceIdx - 16)] == 0))
                {
                    If Quiescence
                    {
                        Call AddPotentialQMove(SourceIdx)((SourceIdx - 16))(GoK_WhitePawn)(Ply)(QuietChecks);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx - 16))(Ply)(AttackTableOnly)(Quiescence);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            GenerateMovesForSource.TargetIdx = EnPassantTarget[Ply];
            If ((Not (AttackTableOnly)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[GenerateMovesForSource.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[GenerateMovesForSource.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((GenerateMovesForSource.TargetIdx - 8))(Ply)(AttackTableOnly)(Quiescence);
                }
            }
        }
        Stop(this script);
    }
    Call //("Non-pawn moves (generated via lookup tables)");
    GenerateMovesForSource.SourcePiece = abs(GenerateMovesForSource.SourcePiece);
    If (GenerateMovesForSource.SourcePiece == GoK_BlackRook)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1))(QuietsOnly)(QuietChecks);
        Stop(this script);
    }
    If (GenerateMovesForSource.SourcePiece == GoK_BlackBishop)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0))(QuietsOnly)(QuietChecks);
        Stop(this script);
    }
    If (GenerateMovesForSource.SourcePiece == GoK_BlackKnight)
    {
        Call AddLookupMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0))(QuietsOnly)(QuietChecks);
        Stop(this script);
    }
    If (GenerateMovesForSource.SourcePiece == GoK_BlackKing)
    {
        Call AddLookupMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1))(QuietsOnly)(QuietChecks);
        Stop(this script);
    }
    If (GenerateMovesForSource.SourcePiece == GoK_BlackQueen)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 1))(QuietsOnly)(QuietChecks);
        Call AddSlidingMove(SourceIdx)(Ply)(AttackTableOnly)(Quiescence)((1 == 0))(QuietsOnly)(QuietChecks);
        Stop(this script);
    }
}

Define GenerateMovesImpl(string Ply)(bool AttackTableOnly)(bool Quiescence)(bool IsBlackMove)(bool QuietsOnly)(bool QuietChecks) (warp=true)
{
    If ((CheckedState[Ply] == 1) And (Not (AttackTableOnly)))
    {
        Call PrepareEvasionMask(Ply);
    }
    GenerateMovesImpl.SkipIdx = -1;
    List.DeleteAll(CalcMovesScoreList);
    List.DeleteAll(CalcMovesMoveList);
    Call PrepareKillers(Ply);
    Call ClearMoveList(Ply);
    GenerateMovesImpl.PieceMobilityIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(PieceMobility, GenerateMovesImpl.PieceMobilityIdx, 0);
        GenerateMovesImpl.PieceMobilityIdx += 1;
    }
    GenerateMovesImpl.SourceIdx = 1;
    Repeat (64)
    {
        If (Not ((GenerateMovesImpl.SourceIdx == GenerateMovesImpl.SkipIdx)))
        {
            If ((IsBlackMove And (Board[GenerateMovesImpl.SourceIdx] > 0)) Or ((Not (IsBlackMove)) And (Board[GenerateMovesImpl.SourceIdx] < 0)))
            {
                Call GenerateMovesForSource(Ply)(GenerateMovesImpl.SourceIdx)(AttackTableOnly)(Quiescence)(QuietsOnly)(QuietChecks);
            }
        }
        GenerateMovesImpl.SourceIdx += 1;
    }
    Call //("Castling moves");
    If ((Not (AttackTableOnly)) And (Not (Quiescence)))
    {
        If IsBlackMove
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 1)] == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 2)] == 0)))
            {
                If (CastlingBit[((8 * CastlingState[Ply]) + 4)] == 0)
                {
                    If ((((Board[1] == GoK_BlackRook) And (Board[2] == 0)) And ((Board[3] == 0) And (Board[4] == 0))) And (Board[5] == GoK_BlackKing))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 3)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 4)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0))))
                        {
                            Call AddSpecialMove(GoK_BlackQueensideCastling)(Ply);
                        }
                    }
                }
                If (CastlingBit[((8 * CastlingState[Ply]) + 3)] == 0)
                {
                    If (((Board[5] == GoK_BlackKing) And (Board[6] == 0)) And ((Board[7] == 0) And (Board[8] == GoK_BlackRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 6)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 7)] == 0))))
                        {
                            Call AddSpecialMove(GoK_BlackKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
        Else
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 5)] == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 6)] == 0)))
            {
                If (CastlingBit[((8 * CastlingState[Ply]) + 8)] == 0)
                {
                    If (((Board[57] == GoK_WhiteRook) And (Board[58] == 0)) And ((Board[59] == 0) And ((Board[60] == 0) And (Board[61] == GoK_WhiteKing))))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 59)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 60)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0))))
                        {
                            Call AddSpecialMove(GoK_WhiteQueensideCastling)(Ply);
                        }
                    }
                }
                If (CastlingBit[((8 * CastlingState[Ply]) + 7)] == 0)
                {
                    If (((Board[62] == 0) And (Board[61] == GoK_WhiteKing)) And ((Board[63] == 0) And (Board[64] == GoK_WhiteRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0) And ((BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 62)] == 0) And (BoardAttackedByOpponentSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 63)] == 0))))
                        {
                            Call AddSpecialMove(GoK_WhiteKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
    }
    Call //("Move ordering");
    If ((Not (AttackTableOnly)) And (Not (QuietsOnly)))
    {
        Call SortMoveList(Ply);
    }
}

Define GenerateMovesImplWrapper(string Ply)(bool AttackTableOnly)(bool Quiescence)(bool QuietsOnly) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodEnter(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * Quiescence)) - ((2 * Const.MaxPlyStackFrames) * AttackTableOnly)) + Ply));
    }
    GenerateMovesImplWrapper.QuietChecks = 0;
    If Quiescence
    {
        Call IsQuiescentCheckCond(Ply);
        GenerateMovesImplWrapper.QuietChecks = Ret.IsQuiescentCheckCond.IsTrue;
    }
    Call GenerateMovesImpl(Ply)(AttackTableOnly)(Quiescence)((PlyIsOwn[Ply] == 1))(QuietsOnly)((GenerateMovesImplWrapper.QuietChecks == 1));
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call ProfilerMethodExit(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * Quiescence)) - ((2 * Const.MaxPlyStackFrames) * AttackTableOnly)) + Ply));
    }
}

Define GenerateMovesPublic(string Ply) (warp=true)
{
    GenerateMovesPublic.SqIdx = 1;
    Repeat (64)
    {
        If (Board[GenerateMovesPublic.SqIdx] == GoK_WhiteKing)
        {
            Glob.Board.WhiteKingIdx = GenerateMovesPublic.SqIdx;
        }
        Else
        {
            If (Board[GenerateMovesPublic.SqIdx] == GoK_BlackKing)
            {
                Glob.Board.BlackKingIdx = GenerateMovesPublic.SqIdx;
            }
        }
        GenerateMovesPublic.SqIdx += 1;
    }
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call SetInitialEP(Ply);
    List.ReplaceItem(CastlingState, Ply, ((((Glob.Board.HasBlackCastled * CastlingStatePow2[1]) + (Glob.Board.HasBlackKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasBlackRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasBlackRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasWhiteCastled * CastlingStatePow2[5]) + (Glob.Board.HasWhiteKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasWhiteRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasWhiteRookQSMoved * CastlingStatePow2[8])))));
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0))((1 == 0));
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    List.ReplaceItem(CastlingState, Ply, Const.Null);
}

Define GetBoardString (warp=true)
{
    GetBoardString.SqIdx = 1;
    Ret.GetBoardString.BoardString = "";
    Repeat (64)
    {
        Ret.GetBoardString.BoardString = Operator.Join(Ret.GetBoardString.BoardString, Operator.Join(Board[GetBoardString.SqIdx], ","));
        GetBoardString.SqIdx += 1;
    }
}

Define GetCalibratedEval(string Ply) (warp=true)
{
    Ret.GetCalibratedEval.Score = StaticEval[Ply];
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        If ((NodeTTHit[Ply] == 1) And (Not ((NodeTTScore[Ply] == Const.Null))))
        {
            GetCalibratedEval.TTType = NodeTTType[Ply];
            GetCalibratedEval.TTScore = NodeTTScore[Ply];
            GetCalibratedEval.StaticEval = StaticEval[Ply];
            GetCalibratedEval.IsTTScoreUsable = 0;
            If (GetCalibratedEval.TTType == Const.TTType.Exact)
            {
                GetCalibratedEval.IsTTScoreUsable = 1;
            }
            Else
            {
                If (GetCalibratedEval.TTType == Const.TTType.HighBound)
                {
                    If (GetCalibratedEval.TTScore < GetCalibratedEval.StaticEval)
                    {
                        GetCalibratedEval.IsTTScoreUsable = 1;
                    }
                }
                Else
                {
                    If (GetCalibratedEval.TTType == Const.TTType.LowBound)
                    {
                        If (GetCalibratedEval.TTScore > GetCalibratedEval.StaticEval)
                        {
                            GetCalibratedEval.IsTTScoreUsable = 1;
                        }
                    }
                }
            }
            If (GetCalibratedEval.IsTTScoreUsable == 1)
            {
                If (1 == 1)
                {
                    If (Not ((abs(NodeTTScore[Ply]) > Const.AbsMinCheckmateEval)))
                    {
                        Ret.GetCalibratedEval.Score = NodeTTScore[Ply];
                    }
                }
            }
        }
    }
}

Define GetCorrHistIndices(string Ply) (warp=true)
{
    Ret.GetCorrHistIndices.PawnKey = Glob.Board.KPHash;
    Call GetPiecePosHash(Board[Glob.Board.WhiteKingIdx])(Glob.Board.WhiteKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Call GetPiecePosHash(Board[Glob.Board.BlackKingIdx])(Glob.Board.BlackKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Ret.GetCorrHistIndices.CorrIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.PawnKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnBlackKey = Glob.Board.NonPawnHashBlack;
    Ret.GetCorrHistIndices.NonPawnBlackIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnBlackKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnWhiteKey = Glob.Board.NonPawnHashWhite;
    Ret.GetCorrHistIndices.NonPawnWhiteIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnWhiteKey % 100000)) + 1);
    Ret.GetCorrHistIndices.ContIdx2 = Const.Null;
    Ret.GetCorrHistIndices.ContIdx4 = Const.Null;
    If ((Ply > 2) And (Glob.Config.IsScratch3 == 0))
    {
        If ((Not ((AppliedMove[(Ply - 1)] == 0))) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            GetCorrHistIndices.PieceTo1 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] - 1) + (6 * (SourcePieces[(Ply - 1)] < 0))) * 64) + floor((AppliedMove[(Ply - 1)] % 100)));
            GetCorrHistIndices.PieceTo2 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] - 1) + (6 * (SourcePieces[(Ply - 2)] < 0))) * 64) + floor((AppliedMove[(Ply - 2)] % 100)));
            Ret.GetCorrHistIndices.ContIdx2 = ((((PlyIsOwn[Ply] * 646416) + (GetCorrHistIndices.PieceTo1 * 804)) + GetCorrHistIndices.PieceTo2) + 1);
            If (Ply > 4)
            {
                If (Not ((AppliedMove[(Ply - 4)] == 0)))
                {
                    GetCorrHistIndices.PieceTo4 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] - 1) + (6 * (SourcePieces[(Ply - 4)] < 0))) * 64) + floor((AppliedMove[(Ply - 4)] % 100)));
                    Ret.GetCorrHistIndices.ContIdx4 = ((((PlyIsOwn[Ply] * 646416) + (GetCorrHistIndices.PieceTo1 * 804)) + GetCorrHistIndices.PieceTo4) + 1);
                }
            }
        }
    }
}

Define GetCurrentMove(num Ply) (warp=true)
{
    Ret.GetCurrentMove.Move = Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])];
}

Define GetHashfull(string Age) (warp=true)
{
    Ret.GetHashfull.Permill = 0;
    GetHashfull.Span = (Age - (floor((Age / 100)) * 100));
    GetHashfull.AgeNow = (Age % 131072);
    GetHashfull.Idx = 1;
    Repeat (1000)
    {
        If (Not ((TTNodeEntry[(GetHashfull.Idx + Const.TTNodeCol.HashIdx)] == Const.Null)))
        {
            GetHashfull.Diff = (GetHashfull.AgeNow - floor((TTNodeEntry[(GetHashfull.Idx + Const.TTNodeCol.MetaIdx)] / 16384)));
            If ((Not ((GetHashfull.Diff < 0))) And (Not ((GetHashfull.Diff > GetHashfull.Span))))
            {
                Ret.GetHashfull.Permill += 1;
            }
        }
        GetHashfull.Idx += Const.TTNodeEntrySize;
    }
}

Define GetHistoryStatScore(string SourcePieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply)(string KPHash) (warp=true)
{
    GetHistoryStatScore.PieceToKey = 0;
    Ret.GetHistoryStatScore.Score = 0;
    Ret.GetHistoryStatScore.MainScore = 0;
    Ret.GetHistoryStatScore.Cont1Score = 0;
    Ret.GetHistoryStatScore.Cont2Score = 0;
    Ret.GetHistoryStatScore.Cont4Score = 0;
    If (floor((Move / 100)) == 0)
    {
        Ret.GetHistoryStatScore.MainScore = HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))];
        Ret.GetHistoryStatScore.Score += (2 * Ret.GetHistoryStatScore.MainScore);
        GetHistoryStatScore.PieceToKey = ((PieceIdxLookup[GoK_BlackKing] * 68) + ToIdx);
    }
    Else
    {
        If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
        {
            Ret.GetHistoryStatScore.MainScore = HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))];
            Ret.GetHistoryStatScore.Score += (2 * Ret.GetHistoryStatScore.MainScore);
            GetHistoryStatScore.PieceToKey = ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx);
        }
    }
    GetHistoryStatScore.Idx = -1;
    If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
    {
        If (1 == 1)
        {
            GetHistoryStatScore.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + GetHistoryStatScore.PieceToKey);
        }
    }
    If (Not ((GetHistoryStatScore.Idx == -1)))
    {
        Ret.GetHistoryStatScore.Cont1Score = HistoryContinuation[(PlyContinuationBaseIdx[Ply] + GetHistoryStatScore.Idx)];
        Ret.GetHistoryStatScore.Score += (Ret.GetHistoryStatScore.Cont1Score * 2);
    }
    If (1 == 1)
    {
        If ((Ply > 2) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            If (1 == 1)
            {
                GetHistoryStatScore.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                Ret.GetHistoryStatScore.Cont2Score = HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + GetHistoryStatScore.Idx)];
                Ret.GetHistoryStatScore.Score += (Ret.GetHistoryStatScore.Cont2Score * 1);
            }
        }
    }
    If ((Ply > 4) And (Not ((AppliedMove[(Ply - 4)] == 0))))
    {
        Ret.GetHistoryStatScore.Cont4Score = HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))];
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * Ret.GetHistoryStatScore.Cont4Score));
    }
    If ((Ply > 6) And (Not ((AppliedMove[(Ply - 6)] == 0))))
    {
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))]));
    }
    Call ProbePawnHist(SourcePieceParam)(ToIdx)(KPHash);
    Ret.GetHistoryStatScore.Score += (HistoryPawnHist[Ret.ProbePawnHist.Idx] * 2);
}

Define GetImproving(string Ply) (warp=true)
{
    If (Improving[Ply] == Const.Null)
    {
        Call GetImprovingImpl(Ply);
        List.ReplaceItem(Improving, Ply, Ret.GetImprovingImpl.IsImproving);
    }
    Ret.GetImproving.IsImproving = Improving[Ply];
}

Define GetImprovingImpl(string Ply) (warp=true)
{
    If (CheckedState[Ply] == 1)
    {
        Ret.GetImprovingImpl.IsImproving = 0;
        Stop(this script);
    }
    If (Ply > 1)
    {
        If (AppliedMove[(Ply - 1)] == 0)
        {
            Ret.GetImprovingImpl.IsImproving = 0;
            Stop(this script);
        }
    }
    Ret.GetImprovingImpl.IsImproving = Const.Null;
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        GetImprovingImpl.StaticEvalIdx = (Ply - 2);
        If (GetImprovingImpl.StaticEvalIdx > 0)
        {
            If (StaticEval[GetImprovingImpl.StaticEvalIdx] == Const.Null)
            {
                GetImprovingImpl.StaticEvalIdx = (GetImprovingImpl.StaticEvalIdx - 2);
            }
        }
        If ((GetImprovingImpl.StaticEvalIdx > 0) And (Not ((StaticEval[GetImprovingImpl.StaticEvalIdx] == Const.Null))))
        {
            If (StaticEval[Ply] > StaticEval[GetImprovingImpl.StaticEvalIdx])
            {
                Ret.GetImprovingImpl.IsImproving = 1;
            }
            Else
            {
                Ret.GetImprovingImpl.IsImproving = 0;
            }
        }
    }
}

Define GetMoveNotation(num Move) (warp=true)
{
    Call GetPhysicalMove(Move);
    Ret.GetMoveNotation.VirtualMove = Ret.GetPhysicalMove.Move;
    Ret.GetMoveNotation.Notation = "";
    If ((Ret.GetPhysicalMove.Move == GoK_BlackKingsideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteKingsideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O";
        Stop(this script);
    }
    If ((Ret.GetPhysicalMove.Move == GoK_BlackQueensideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteQueensideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O-O";
        Stop(this script);
    }
    GetMoveNotation.SourceIdx = floor((Ret.GetPhysicalMove.Move / 100));
    GetMoveNotation.TargetIdx = floor((Ret.GetPhysicalMove.Move % 100));
    GetMoveNotation.Piece = Board[floor((Move / 100))];
    If ((GetMoveNotation.Piece == GoK_BlackBishop) Or (GetMoveNotation.Piece == GoK_WhiteBishop))
    {
        Ret.GetMoveNotation.Notation = "B";
    }
    If ((GetMoveNotation.Piece == GoK_BlackKing) Or (GetMoveNotation.Piece == GoK_WhiteKing))
    {
        Ret.GetMoveNotation.Notation = "K";
    }
    If ((GetMoveNotation.Piece == GoK_BlackRook) Or (GetMoveNotation.Piece == GoK_WhiteRook))
    {
        Ret.GetMoveNotation.Notation = "R";
    }
    If ((GetMoveNotation.Piece == GoK_BlackKnight) Or (GetMoveNotation.Piece == GoK_WhiteKnight))
    {
        Ret.GetMoveNotation.Notation = "N";
    }
    If ((GetMoveNotation.Piece == GoK_WhiteQueen) Or (GetMoveNotation.Piece == GoK_BlackQueen))
    {
        Ret.GetMoveNotation.Notation = "Q";
    }
    GetMoveNotation.File = IdxToFile[GetMoveNotation.SourceIdx];
    GetMoveNotation.NotationRank = (9 - IdxToRank[GetMoveNotation.SourceIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", GetMoveNotation.File), GetMoveNotation.NotationRank));
    If (Not ((Board[floor((Move % 100))] == 0)))
    {
        Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "x");
    }
    GetMoveNotation.File = IdxToFile[GetMoveNotation.TargetIdx];
    GetMoveNotation.NotationRank = (9 - IdxToRank[GetMoveNotation.TargetIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", GetMoveNotation.File), GetMoveNotation.NotationRank));
    If (Operator.LetterOf(Ret.GetPhysicalMove.Move, (Variable.Length(Ret.GetPhysicalMove.Move) - 1)) == ".")
    {
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 1)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=Q");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 2)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=R");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 3)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=B");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 4)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=N");
        }
    }
}

Define GetMoveScore(string SourcePieceParam)(string TargetPieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply) (warp=true)
{
    Ret.GetMoveScore.Score = 0;
    Call IsMovePicked(Ply)(Move);
    If (Ret.IsMovePicked.Picked == 1)
    {
        Ret.GetMoveScore.Score = Ret.IsMovePicked.Score;
        Stop(this script);
    }
    Call //("1: Hash moves, handled by staged move generator / PickMove()");
    If (CheckedState[Ply] == 1)
    {
        If ((abs(SourcePieceParam) == GoK_BlackKing) Or (BoardAttackedEvasionTarget[ToIdx] == 1))
        {
            Ret.GetMoveScore.Score = 8000000;
            If ((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0))))
            {
                Ret.GetMoveScore.Score += (100000 + ((PieceIdxLookup[abs(TargetPieceParam)] * 100) + (7 - PieceIdxLookup[abs(SourcePieceParam)])));
            }
            Else
            {
                GetMoveScore.ContMoveScore = 0;
                If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
                {
                    GetMoveScore.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                    GetMoveScore.ContMoveScore = (2 * HistoryContinuation[(PlyContinuationBaseIdx[Ply] + GetMoveScore.Idx)]);
                }
                Ret.GetMoveScore.Score += ((2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]) + GetMoveScore.ContMoveScore);
            }
            Stop(this script);
        }
    }
    If (Not ((Move == floor(Move))))
    {
        Call //("Promotions");
        If (((Move * 10) % 10) == 1)
        {
            If (Board[floor((Move % 100))] == 0)
            {
                Ret.GetMoveScore.Score = 7000000;
            }
            Else
            {
                GetMoveScore.PieceIdx = PieceIdxLookup[abs(Board[floor((Move % 100))])];
                GetMoveScore.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((GetMoveScore.PieceIdx - 1) * 64) + floor((Move % 100)))) + (2304 * (SourcePieceParam < 0)));
                Ret.GetMoveScore.Score = ((7000000 + (100000 * GetMoveScore.PieceIdx)) + HistoryCaptureScores[GetMoveScore.BaseIdx]);
            }
            Stop(this script);
        }
        Else
        {
            Call GetHistoryStatScore(SourcePieceParam)(floor((floor(Move) / 100)))(floor((Move % 100)))(floor(Move))(Ply)(Glob.Board.KPHash);
            Ret.GetMoveScore.Score = (2100000 + Ret.GetHistoryStatScore.Score);
            Stop(this script);
        }
    }
    If (((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0)))) Or (((abs(SourcePieceParam) == GoK_BlackPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx]))))))
    {
        GetMoveScore.TargetPiece = TargetPieceParam;
        If (((abs(SourcePieceParam) == GoK_BlackPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))))
        {
            GetMoveScore.TargetPiece = (0 - SourcePieceParam);
        }
        GetMoveScore.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((PieceIdxLookup[abs(GetMoveScore.TargetPiece)] - 1) * 64) + ToIdx)) + (2304 * (SourcePieceParam < 0)));
        GetMoveScore.BaseScore = Const.CaptureGoodBaseScore;
        If ((Not (((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 1)))) And (Not ((PickCaptureStageDone[Ply] == 1))))
        {
            Call IsLosingCapture(Ply)(Move)(SourcePieceParam)(GetMoveScore.TargetPiece);
            If (Ret.IsLosingCapture.IsLosing == 1)
            {
                GetMoveScore.BaseScore = Const.CaptureBadBaseScore;
            }
        }
        Ret.GetMoveScore.Score = ((GetMoveScore.BaseScore + (6 * abs(GetMoveScore.TargetPiece))) + HistoryCaptureScores[GetMoveScore.BaseIdx]);
        Stop(this script);
    }
    Call //("4: Killer moves");
    Call PrepareKillers(Ply);
    If ((Not ((CurrentKillerMoves[1] == Const.Null))) And (CurrentKillerMoves[1] == Move))
    {
        Ret.GetMoveScore.Score = 6000000;
        Stop(this script);
    }
    Else
    {
        If ((Not ((CurrentKillerMoves[2] == Const.Null))) And (CurrentKillerMoves[2] == Move))
        {
            Ret.GetMoveScore.Score = 5000000;
            Stop(this script);
        }
    }
    Call //("5. Counter Moves");
    If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
    {
        If ((Not ((AppliedMove[(Ply - 1)] == Const.Null))) And (HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))] == Move))
        {
            Ret.GetMoveScore.Score = 4000000;
            Stop(this script);
        }
    }
    Call //("6: Quiets with high history score");
    Ret.GetMoveScore.Score = 2100000;
    Call GetHistoryStatScore(SourcePieceParam)(FromIdx)(ToIdx)(Move)(Ply)(Glob.Board.KPHash);
    Ret.GetMoveScore.Score += Ret.GetHistoryStatScore.Score;
    If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
    {
        If (BoardAttackedCalculated[Ply] == 1)
        {
            GetMoveScore.PieceAbs = abs(SourcePieceParam);
            If ((GetMoveScore.PieceAbs > GoK_BlackPawn) And (GetMoveScore.PieceAbs < GoK_BlackKing))
            {
                GetMoveScore.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + FromIdx);
                If (BoardAttackedByOpponentSnapshot[GetMoveScore.AttackIdx] > 0)
                {
                    GetMoveScore.ThreatenedByPieceAbs = abs(Board[BoardAttackedByOpponentPieceSnapshot[GetMoveScore.AttackIdx]]);
                    If (((GetMoveScore.PieceAbs == GoK_BlackQueen) And (GetMoveScore.ThreatenedByPieceAbs < GoK_BlackQueen)) Or (((GetMoveScore.PieceAbs == GoK_BlackRook) And (GetMoveScore.ThreatenedByPieceAbs < GoK_BlackRook)) Or (((GetMoveScore.PieceAbs == GoK_BlackKnight) Or (GetMoveScore.PieceAbs == GoK_BlackBishop)) And (GetMoveScore.ThreatenedByPieceAbs == GoK_BlackPawn))))
                    {
                        GetMoveScore.ThreatenedByPieceAbs = 0;
                        GetMoveScore.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + ToIdx);
                        If (BoardAttackedByOpponentSnapshot[GetMoveScore.AttackIdx] > 0)
                        {
                            GetMoveScore.ThreatenedByPieceAbs = abs(Board[BoardAttackedByOpponentPieceSnapshot[GetMoveScore.AttackIdx]]);
                        }
                        If (GetMoveScore.ThreatenedByPieceAbs < GoK_BlackKing)
                        {
                            If ((GetMoveScore.PieceAbs == GoK_BlackQueen) And ((GetMoveScore.ThreatenedByPieceAbs == 0) Or (GetMoveScore.ThreatenedByPieceAbs == GoK_BlackQueen)))
                            {
                                Ret.GetMoveScore.Score += 50000;
                            }
                            Else
                            {
                                If ((GetMoveScore.PieceAbs == GoK_BlackRook) And ((GetMoveScore.ThreatenedByPieceAbs == 0) Or (GetMoveScore.ThreatenedByPieceAbs > GoK_BlackBishop)))
                                {
                                    Ret.GetMoveScore.Score += 25000;
                                }
                                Else
                                {
                                    If ((GetMoveScore.ThreatenedByPieceAbs == 0) Or (GetMoveScore.ThreatenedByPieceAbs > GoK_BlackPawn))
                                    {
                                        Ret.GetMoveScore.Score += 15000;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define GetMoveUci(string Move)(string IsWhite) (warp=true)
{
    Ret.GetMoveUci.Uci = "";
    Call GetPhysicalMove(Move);
    GetMoveUci.IsCastle = 0;
    GetMoveUci.Rank = 8;
    If (IsWhite == 1)
    {
        GetMoveUci.Rank = 1;
    }
    If ((Ret.GetPhysicalMove.Move == GoK_BlackKingsideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteKingsideCastling))
    {
        GetMoveUci.IsCastle = 1;
        Ret.GetMoveUci.Uci = Operator.Join("e", Operator.Join(GetMoveUci.Rank, Operator.Join("g", GetMoveUci.Rank)));
    }
    If ((Ret.GetPhysicalMove.Move == GoK_BlackQueensideCastling) Or (Ret.GetPhysicalMove.Move == GoK_WhiteQueensideCastling))
    {
        GetMoveUci.IsCastle = 1;
        Ret.GetMoveUci.Uci = Operator.Join("e", Operator.Join(GetMoveUci.Rank, Operator.Join("c", GetMoveUci.Rank)));
    }
    If (GetMoveUci.IsCastle == 0)
    {
        GetMoveUci.From = floor((Ret.GetPhysicalMove.Move / 100));
        GetMoveUci.To = floor((Ret.GetPhysicalMove.Move % 100));
        Ret.GetMoveUci.Uci = Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[GetMoveUci.From]), Operator.Join((9 - IdxToRank[GetMoveUci.From]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[GetMoveUci.To]), (9 - IdxToRank[GetMoveUci.To]))));
        If (Operator.LetterOf(Move, (Variable.Length(Move) - 1)) == ".")
        {
            Ret.GetMoveUci.Uci = Operator.Join(Ret.GetMoveUci.Uci, Operator.LetterOf("qrbn", Operator.LetterOf(Move, Variable.Length(Move))));
        }
    }
}

Define GetNormalizedMove(string Move) (warp=true)
{
    If (Move == floor(Move))
    {
        Ret.GetNormalizedMove.Move = MoveToZeroPaddedStr[(Move + 1)];
    }
    Else
    {
        Ret.GetNormalizedMove.Move = Operator.Join(MoveToZeroPaddedStr[(floor(Move) + 1)], Operator.Join(".", Operator.LetterOf(Move, Variable.Length(Move))));
    }
}

Define GetOpeningMoves (warp=true)
{
    List.DeleteItem(OpeningMovesRes, all);
    If (1 == 1)
    {
        Call GenerateMovesPublic(1);
        Call CreateCurrentBoardHash;
        GetOpeningMoves.OpeningMovesMapMoveIdx = 1;
        Repeat (List.Length(OpeningMovesMapHash))
        {
            If (OpeningMovesMapHash[GetOpeningMoves.OpeningMovesMapMoveIdx] == Glob.Board.CurrentHash)
            {
                If List.ContainsItem(Moves1, OpeningMovesMapMove[GetOpeningMoves.OpeningMovesMapMoveIdx])
                {
                    List.Add(OpeningMovesRes, OpeningMovesMapMove[GetOpeningMoves.OpeningMovesMapMoveIdx]);
                }
            }
            GetOpeningMoves.OpeningMovesMapMoveIdx += 1;
        }
    }
}

Define GetPawnHistHash(string From)(string To) (warp=true)
{
    Call GetPiecePosHash(Board[Glob.Board.WhiteKingIdx])(Glob.Board.WhiteKingIdx);
    Call GetPiecePosHash(Board[Glob.Board.BlackKingIdx])(Glob.Board.BlackKingIdx);
    Call GetPiecePosHash(GoK_WhitePawn)(From);
    Call GetPiecePosHash(GoK_WhitePawn)(To);
}

Define GetPhysicalMove(num Move) (warp=true)
{
    If (Glob.Game.IsPlayerBlack == 0)
    {
        Ret.GetPhysicalMove.Move = Move;
    }
    Else
    {
        If (Not ((floor((Move / 100)) == 0)))
        {
            Ret.GetPhysicalMove.Move = ((RankFlipIdx[floor((Move / 100))] * 100) + RankFlipIdx[floor((Move % 100))]);
            If (Operator.LetterOf(Move, (Variable.Length(Move) - 1)) == ".")
            {
                Ret.GetPhysicalMove.Move = (Ret.GetPhysicalMove.Move + (0.1 * Operator.LetterOf(Move, Variable.Length(Move))));
            }
        }
        Else
        {
            If (Move == GoK_BlackKingsideCastling)
            {
                Ret.GetPhysicalMove.Move = GoK_WhiteKingsideCastling;
            }
            Else
            {
                If (Move == GoK_BlackQueensideCastling)
                {
                    Ret.GetPhysicalMove.Move = GoK_WhiteQueensideCastling;
                }
                Else
                {
                    If (Move == GoK_WhiteKingsideCastling)
                    {
                        Ret.GetPhysicalMove.Move = GoK_BlackKingsideCastling;
                    }
                    Else
                    {
                        If (Move == GoK_WhiteQueensideCastling)
                        {
                            Ret.GetPhysicalMove.Move = GoK_BlackQueensideCastling;
                        }
                    }
                }
            }
        }
    }
}

Define GetPiecePosEval(string Piece)(string Idx) (warp=true)
{
    Ret.GetPiecePosEval.Score = 0;
    If ((Idx == 0) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece == GoK_BlackPawn)
    {
        If (Glob.Board.IsEndgame == 0)
        {
            Ret.GetPiecePosEval.Score = (PawnPieceSquare[Idx] + 0);
        }
        Else
        {
            Ret.GetPiecePosEval.Score = (PawnPieceSquareEndgame[Idx] + 0);
        }
        Stop(this script);
    }
    If (Piece == GoK_WhitePawn)
    {
        If (Glob.Board.IsEndgame == 0)
        {
            Ret.GetPiecePosEval.Score = (0 - PawnPieceSquare[RankFlipIdx[(Idx + 0)]]);
        }
        Else
        {
            Ret.GetPiecePosEval.Score = (0 - PawnPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
        }
        Stop(this script);
    }
    If (Glob.Board.IsEndgame == 1)
    {
        If (Piece > GoK_BlackBishop)
        {
            If (Piece == GoK_BlackKing)
            {
                If ((Glob.Board.RootBlackPawnCount == 0) And ((Glob.Board.RootBlackQueenCount + Glob.Board.RootBlackNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((1.33 * KingPieceSquareEndgame[Idx]));
                    Stop(this script);
                }
                If ((Glob.Board.RootWhitePawnCount == 0) And ((Glob.Board.RootWhiteQueenCount + Glob.Board.RootWhiteNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((0.67 * KingPieceSquareEndgame[Idx]));
                    Stop(this script);
                }
                Ret.GetPiecePosEval.Score = (KingPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Glob.Board.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_BlackRook)
            {
                Ret.GetPiecePosEval.Score = (RookPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Piece == GoK_BlackQueen)
            {
                Ret.GetPiecePosEval.Score = (QueenPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
        }
        If (Piece > 0)
        {
            If (Glob.Board.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_BlackKnight)
            {
                Ret.GetPiecePosEval.Score = (KnightPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
            If (Piece == GoK_BlackBishop)
            {
                Ret.GetPiecePosEval.Score = (BishopPieceSquareEndgame[Idx] + 0);
                Stop(this script);
            }
        }
        If (Piece < GoK_WhiteBishop)
        {
            If (Piece == GoK_WhiteKing)
            {
                If ((Glob.Board.RootWhitePawnCount == 0) And ((Glob.Board.RootWhiteQueenCount + Glob.Board.RootWhiteNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((1.33 * (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]])));
                    Stop(this script);
                }
                If ((Glob.Board.RootBlackPawnCount == 0) And ((Glob.Board.RootBlackQueenCount + Glob.Board.RootBlackNonQueenMajorMinorCount) == 0))
                {
                    Ret.GetPiecePosEval.Score = Operator.Round((0.67 * (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]])));
                    Stop(this script);
                }
                Ret.GetPiecePosEval.Score = (0 - KingPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Glob.Board.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_WhiteRook)
            {
                Ret.GetPiecePosEval.Score = (0 - RookPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Piece == GoK_WhiteQueen)
            {
                Ret.GetPiecePosEval.Score = (0 - QueenPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
        }
        If (Piece < 0)
        {
            If (Glob.Board.IsLateEndgame == 1)
            {
                Stop(this script);
            }
            If (Piece == GoK_WhiteBishop)
            {
                Ret.GetPiecePosEval.Score = (0 - BishopPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
            If (Piece == GoK_WhiteKnight)
            {
                Ret.GetPiecePosEval.Score = (0 - KnightPieceSquareEndgame[RankFlipIdx[(Idx + 0)]]);
                Stop(this script);
            }
        }
        Stop(this script);
    }
    If (Piece > GoK_BlackBishop)
    {
        If (Piece == GoK_BlackRook)
        {
            Ret.GetPiecePosEval.Score = (RookPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackQueen)
        {
            Ret.GetPiecePosEval.Score = (QueenPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackKing)
        {
            Ret.GetPiecePosEval.Score = (KingPieceSquare[Idx] + 0);
            Stop(this script);
        }
    }
    If (Piece > 0)
    {
        If (Piece == GoK_BlackKnight)
        {
            Ret.GetPiecePosEval.Score = (KnightPieceSquare[Idx] + 0);
            Stop(this script);
        }
        If (Piece == GoK_BlackBishop)
        {
            Ret.GetPiecePosEval.Score = (BishopPieceSquare[Idx] + 0);
            Stop(this script);
        }
    }
    If (Piece < GoK_WhiteBishop)
    {
        If (Piece == GoK_WhiteRook)
        {
            Ret.GetPiecePosEval.Score = (0 - RookPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteQueen)
        {
            Ret.GetPiecePosEval.Score = (0 - QueenPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteKing)
        {
            Ret.GetPiecePosEval.Score = (0 - KingPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
    }
    If (Piece < 0)
    {
        If (Piece == GoK_WhiteBishop)
        {
            Ret.GetPiecePosEval.Score = (0 - BishopPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
        If (Piece == GoK_WhiteKnight)
        {
            Ret.GetPiecePosEval.Score = (0 - KnightPieceSquare[RankFlipIdx[(Idx + 0)]]);
            Stop(this script);
        }
    }
}

Define GetPiecePosHash(string Piece)(string Pos) (warp=true)
{
    Ret.GetPiecePosHash.Hash = 0;
    If ((Not ((Pos > 0))) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[((64 * (PieceIdxLookup[(Piece + 0)] - 1)) + Pos)] + 0);
    }
    Else
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[(384 + ((64 * (PieceIdxLookup[abs(Piece)] - 1)) + Pos))] + 0);
    }
}

Define GetPvUci(string RootMove)(string IsWhite) (warp=true)
{
    Ret.GetPvUci.Text = "";
    Ret.GetPvUci.First = RootMove;
    Ret.GetPvUci.Ponder = Const.Null;
    GetPvUci.Len = PV[1];
    If (GetPvUci.Len < 1)
    {
        Call GetMoveUci(RootMove)(IsWhite);
        Ret.GetPvUci.Text = Ret.GetMoveUci.Uci;
    }
    If (Not ((GetPvUci.Len < 1)))
    {
        GetPvUci.Idx = 1;
        GetPvUci.Side = IsWhite;
        Repeat (GetPvUci.Len)
        {
            Call GetMoveUci(PVRaw[(GetPvUci.Idx + 1)])(GetPvUci.Side);
            If (GetPvUci.Idx == 1)
            {
                Ret.GetPvUci.Text = Ret.GetMoveUci.Uci;
                Ret.GetPvUci.First = PVRaw[2];
            }
            If (GetPvUci.Idx > 1)
            {
                Ret.GetPvUci.Text = Operator.Join(Ret.GetPvUci.Text, Operator.Join(" ", Ret.GetMoveUci.Uci));
            }
            If (GetPvUci.Idx == 2)
            {
                Ret.GetPvUci.Ponder = Ret.GetMoveUci.Uci;
            }
            GetPvUci.Side = (1 - GetPvUci.Side);
            GetPvUci.Idx += 1;
        }
    }
}

Define GetRepetitionCount (warp=true)
{
    GetRepetitionCount.BoardHistoryIdx = (List.Length(BoardHistory) - 2);
    Ret.GetRepetitionCount.Count = 1;
    Repeat Until (GetRepetitionCount.BoardHistoryIdx < 1)
    {
        If ((BoardHistory[GetRepetitionCount.BoardHistoryIdx] == BoardHistory[List.Length(BoardHistory)]) And (BoardHistoryMetaState[GetRepetitionCount.BoardHistoryIdx] == BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]))
        {
            Ret.GetRepetitionCount.Count += 1;
        }
        GetRepetitionCount.BoardHistoryIdx += -2;
    }
}

Define GetStaticEval(string Ply) (warp=true)
{
    If (StaticEval[Ply] == Const.Null)
    {
        Call Evaluate((Ply - 1))((1 == 1));
        Call AdjustEvalScore(Ply)(Ret.Evaluate.Score);
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.Evaluate.Score);
        Call TTStoreNode(Glob.Board.CurrentHash)(Ply)(Const.Null)(Const.Null)(Const.TTType.None)(Const.Null)(Const.Null)(Ret.Evaluate.Score);
    }
}

Define GetSubstring(string Text)(num FromIdx)(num ToIdx) (warp=true)
{
    GetSubstring.CharIdx = FromIdx;
    Ret.GetSubstring.Substring = "";
    Repeat (((ToIdx - FromIdx) + 1))
    {
        Ret.GetSubstring.Substring = Operator.Join(Ret.GetSubstring.Substring, Operator.LetterOf(Text, GetSubstring.CharIdx));
        GetSubstring.CharIdx += 1;
    }
}

Define GetSubstringLeft(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(1)(Count);
    Ret.GetSubstringLeft.Substring = Ret.GetSubstring.Substring;
}

Define GetSubstringRight(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(((Variable.Length(Text) - Count) + 1))(Variable.Length(Text));
    Ret.GetSubstringRight.Substring = Ret.GetSubstring.Substring;
}

Define GetTargetIdx(num SourceIdx)(num DeltaX)(num DeltaY) (warp=true)
{
    GetTargetIdx.File = (IdxToFile[SourceIdx] + DeltaX);
    Ret.GetTargetIdx.SqIdx = -1;
    If ((GetTargetIdx.File > 0) And (GetTargetIdx.File < 9))
    {
        GetTargetIdx.Rank = (IdxToRank[SourceIdx] + DeltaY);
        If ((GetTargetIdx.Rank > 0) And (GetTargetIdx.Rank < 9))
        {
            Ret.GetTargetIdx.SqIdx = (GetTargetIdx.File + ((GetTargetIdx.Rank - 1) * 8));
        }
    }
}

Define GetTTNodeHash(string BoardHash)(string Ply) (warp=true)
{
    Ret.GetTTNodeHash.Hash = (PlyIsOwn[Ply] + 1);
    If (EnPassantTarget[Ply] == Const.Null)
    {
        GetTTNodeHash.EnPassantIdx = 0;
    }
    Else
    {
        GetTTNodeHash.EnPassantIdx = EnPassantTarget[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 67) + (GetTTNodeHash.EnPassantIdx + 1));
    If (CastlingState[Ply] == Const.Null)
    {
        GetTTNodeHash.Castling = 0;
    }
    Else
    {
        GetTTNodeHash.Castling = CastlingState[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 11111117) + (GetTTNodeHash.Castling + 1));
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 97) + BoardHash);
}

Define GivesCheckFast(string Ply) (warp=true)
{
    If (floor((AppliedMove[Ply] / 100)) == 0)
    {
        Call IsCheckedFast((Ply + 2));
        Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        GivesCheckFast.FromIdx = floor((AppliedMove[Ply] / 100));
        GivesCheckFast.ToIdx = floor((AppliedMove[Ply] % 100));
        If (Not ((TargetPiecesIdx[Ply] == GivesCheckFast.ToIdx)))
        {
            Call IsCheckedFast((Ply + 2));
            Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            If (PlyIsOwn[Ply] == 1)
            {
                GivesCheckFast.TheirKingIdx = Glob.Board.WhiteKingIdx;
            }
            Else
            {
                GivesCheckFast.TheirKingIdx = Glob.Board.BlackKingIdx;
            }
            Ret.GivesCheckFast.GivesCheck = 0;
            If (Not ((abs(Board[GivesCheckFast.ToIdx]) == GoK_BlackKing)))
            {
                Call IsReachableForAttack(Board[GivesCheckFast.ToIdx])(GivesCheckFast.ToIdx)(GivesCheckFast.TheirKingIdx);
                GivesCheckFast.IsReachable = Ret.IsReachableForAttack.IsReachable;
                Ret.GivesCheckFast.GivesCheck = GivesCheckFast.IsReachable;
            }
            If (Ret.GivesCheckFast.GivesCheck == 0)
            {
                GivesCheckFast.DiscoveryIdx = 1;
                Repeat (DiscoveryCount[Ply])
                {
                    If (DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + GivesCheckFast.DiscoveryIdx)] == GivesCheckFast.FromIdx)
                    {
                        If (Not ((abs(MoveToPathStepInc[((GivesCheckFast.FromIdx * 100) + GivesCheckFast.ToIdx)]) == DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + GivesCheckFast.DiscoveryIdx)])))
                        {
                            Ret.GivesCheckFast.GivesCheck = 1;
                        }
                    }
                    GivesCheckFast.DiscoveryIdx += 1;
                }
            }
            If (Glob.Profile.Mode == Const.ProfilerMode.Full)
            {
                GivesCheckFast.IsChecked = Ret.GivesCheckFast.GivesCheck;
                Call IsCheckedFast((Ply + 2));
                Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
                If (Not ((GivesCheckFast.IsChecked == Ret.GivesCheckFast.GivesCheck)))
                {
                    Call Log("CheckInfoMismatch check depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(GivesCheckFast.IsChecked)(" old=")(Ret.GivesCheckFast.GivesCheck);
                    Call Log("  detail pieceAtTo=")(Board[GivesCheckFast.ToIdx])(" enemyK=")(GivesCheckFast.TheirKingIdx)(" ira=")(GivesCheckFast.IsReachable)(" discCount=")(DiscoveryCount[Ply]);
                    Call Log("  disc1=")(DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])(" ray1=")(DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])("")("")("")("");
                    Call Log("  board=")(Board)("")("")("")("")("")("");
                }
            }
        }
    }
}

Define ImportBoard(string ImpBoard) (warp=false)
{
    Call EnterExecution;
    Call ExportBoardFEN(0);
    ImportBoard.FEN = Ret.ExportBoardFEN.FEN;
    Call ImportBoardFEN(ImpBoard);
    Call CalcBoardStats;
    If ((Glob.Board.BlackKingIdx == Const.Null) Or (Glob.Board.WhiteKingIdx == Const.Null))
    {
        Call SayAsync("Invalid FEN data")(5);
        Call ImportBoardFEN(ImportBoard.FEN);
        Call CalcBoardStats;
    }
    Else
    {
        Call ImportFEN(ImpBoard);
        Call CalcBoardStats;
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("Stg_FromSquareSelected");
        Event.BroadcastAndWait("Stg_ToSquareSelected");
        List.DeleteItem(BoardHistory, all);
        List.DeleteItem(BoardHistoryHash, all);
        List.DeleteItem(BoardHistoryMetaState, all);
        List.DeleteItem(BoardHistoryWasEngineMove, all);
        List.DeleteItem(GameMovesAN, all);
        Glob.Game.FenPlyBase = 0;
        Call AddBoardToHistory("");
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        Call CalcBoardAttacked(1);
        Call CalcBoardAttacked(2);
        If (((Ret.ImportFEN.IsWhiteToMove == 0) And (Glob.Game.IsPlayerBlack == 0)) Or ((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.Game.IsPlayerBlack == 1)))
        {
            Call IsWhiteKingCheckMate;
            If (Ret.IsWhiteKingCheckMate.IsCheckMate == 1)
            {
                Call SayAsync("Checkmate!")(5);
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Call SayAsync("Draw!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
        Else
        {
            If (((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.Game.IsPlayerBlack == 0)) Or ((Ret.ImportFEN.IsWhiteToMove == 0) And (Glob.Game.IsPlayerBlack == 1)))
            {
                Call IsBlackKingCheckMate;
                If (Ret.IsBlackKingCheckMate.IsCheckMate == 1)
                {
                    Call SayAsync("Checkmate!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call IsDrawByStalemate(2);
                    If (Ret.IsDrawByStalemate.IsDraw == 1)
                    {
                        Call SayAsync("Draw!")(5);
                        GoK_IsGameSuspended = 1;
                    }
                }
            }
        }
    }
    Call ExitExecution;
}

Define ImportBoardFEN(string ImpBoard) (warp=false)
{
    List.DeleteAll(GoK_Board);
    ImportBoardFEN.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_Board, 0);
        ImportBoardFEN.SqIdx += 1;
    }
    ImportBoardFEN.SqIdx = 1;
    Ret.ImportBoardFEN.CharIdx = 1;
    Repeat Until (((ImportBoardFEN.SqIdx > 64) Or (ImportBoardFEN.SqIdx < 1)) Or (Ret.ImportBoardFEN.CharIdx > Variable.Length(ImpBoard)))
    {
        ImportBoardFEN.Char = Operator.LetterOf(ImpBoard, Ret.ImportBoardFEN.CharIdx);
        If ((Not ((ImportBoardFEN.Char < "A"))) And (Not ((ImportBoardFEN.Char > "Z"))))
        {
            ImportBoardFEN.Piece = 0;
            If (ImportBoardFEN.Char == "P")
            {
                ImportBoardFEN.Piece = GoK_BlackPawn;
            }
            If (ImportBoardFEN.Char == "N")
            {
                ImportBoardFEN.Piece = GoK_BlackKnight;
            }
            If (ImportBoardFEN.Char == "B")
            {
                ImportBoardFEN.Piece = GoK_BlackBishop;
            }
            If (ImportBoardFEN.Char == "R")
            {
                ImportBoardFEN.Piece = GoK_BlackRook;
            }
            If (ImportBoardFEN.Char == "Q")
            {
                ImportBoardFEN.Piece = GoK_BlackQueen;
            }
            If (ImportBoardFEN.Char == "K")
            {
                ImportBoardFEN.Piece = GoK_BlackKing;
            }
            Call IsLowerCase(ImportBoardFEN.Char);
            If (Ret.IsLowerCase.IsLower == 0)
            {
                ImportBoardFEN.Piece = (ImportBoardFEN.Piece * -1);
            }
            List.ReplaceItem(GoK_Board, ImportBoardFEN.SqIdx, ImportBoardFEN.Piece);
            ImportBoardFEN.SqIdx += 1;
        }
        Else
        {
            If ((Not ((ImportBoardFEN.Char < 0))) And (Not ((ImportBoardFEN.Char > 9))))
            {
                Repeat (ImportBoardFEN.Char)
                {
                    List.ReplaceItem(GoK_Board, ImportBoardFEN.SqIdx, 0);
                    ImportBoardFEN.SqIdx += 1;
                }
            }
            Else
            {
                If (ImportBoardFEN.Char == "/")
                {
                    Repeat Until ((ImportBoardFEN.SqIdx % 8) == 1)
                    {
                        List.ReplaceItem(GoK_Board, ImportBoardFEN.SqIdx, 0);
                        ImportBoardFEN.SqIdx += 1;
                    }
                }
            }
        }
        Ret.ImportBoardFEN.CharIdx += 1;
    }
    Call LoadInternalBoard;
}

Define ImportBoardImpl(string ImpBoard) (warp=true)
{
    ImportBoardImpl.SqIdx = 1;
    ImportBoardImpl.CharIdx = 1;
    ImportBoardImpl.Piece = "";
    Repeat Until (ImportBoardImpl.CharIdx > Variable.Length(ImpBoard))
    {
        If (Operator.LetterOf(ImpBoard, ImportBoardImpl.CharIdx) == ",")
        {
            List.ReplaceItem(Board, ImportBoardImpl.SqIdx, (ImportBoardImpl.Piece + 0));
            ImportBoardImpl.SqIdx += 1;
            ImportBoardImpl.Piece = "";
        }
        Else
        {
            ImportBoardImpl.Piece = Operator.Join(ImportBoardImpl.Piece, Operator.LetterOf(ImpBoard, ImportBoardImpl.CharIdx));
        }
        ImportBoardImpl.CharIdx += 1;
    }
}

Define ImportFEN(string FenText) (warp=true)
{
    Call ImportBoardFEN(FenText);
    ImportFEN.CharIdx = Ret.ImportBoardFEN.CharIdx;
    ImportFEN.Side = "";
    ImportFEN.Castling = "";
    ImportFEN.EP = "";
    ImportFEN.Half = "";
    ImportFEN.Full = "";
    ImportFEN.Token = 0;
    Repeat (((Variable.Length(FenText) - ImportFEN.CharIdx) + 1))
    {
        ImportFEN.Char = Operator.LetterOf(FenText, ImportFEN.CharIdx);
        If (ImportFEN.Char == " ")
        {
            ImportFEN.Token += 1;
        }
        Else
        {
            If (ImportFEN.Token == 1)
            {
                ImportFEN.Side = Operator.Join(ImportFEN.Side, ImportFEN.Char);
            }
            If (ImportFEN.Token == 2)
            {
                ImportFEN.Castling = Operator.Join(ImportFEN.Castling, ImportFEN.Char);
            }
            If (ImportFEN.Token == 3)
            {
                ImportFEN.EP = Operator.Join(ImportFEN.EP, ImportFEN.Char);
            }
            If (ImportFEN.Token == 4)
            {
                ImportFEN.Half = Operator.Join(ImportFEN.Half, ImportFEN.Char);
            }
            If (ImportFEN.Token == 5)
            {
                If ((Not ((ImportFEN.Char < 0))) And (Not ((ImportFEN.Char > 9))))
                {
                    ImportFEN.Full = Operator.Join(ImportFEN.Full, ImportFEN.Char);
                }
            }
        }
        ImportFEN.CharIdx += 1;
    }
    Ret.ImportFEN.IsWhiteToMove = 0;
    If (ImportFEN.Side == "w")
    {
        Ret.ImportFEN.IsWhiteToMove = 1;
    }
    Glob.Game.FenBlackToMove = (1 - Ret.ImportFEN.IsWhiteToMove);
    Glob.Game.FenFullMove = 1;
    If (Variable.Length(ImportFEN.Full) > 0)
    {
        Glob.Game.FenFullMove = (ImportFEN.Full + 0);
    }
    Glob.Game.FenPlyBase = List.Length(GameMovesAN);
    If (Variable.Length(ImportFEN.Castling) > 0)
    {
        ImportFEN.CanOwnCastleKingside = 0;
        ImportFEN.CanOwnCastleQueenside = 0;
        ImportFEN.CanOppCastleKingside = 0;
        ImportFEN.CanOppCastleQueenside = 0;
        ImportFEN.CastlingCharIdx = 1;
        Repeat Until ((ImportFEN.CastlingCharIdx > Variable.Length(ImportFEN.Castling)) Or (Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx) == " "))
        {
            If (Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx) == "K")
            {
                Call IsLowerCase(Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx));
                If (Ret.IsLowerCase.IsLower == 0)
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOwnCastleKingside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOppCastleKingside = 1;
                    }
                }
                Else
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOppCastleKingside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOwnCastleKingside = 1;
                    }
                }
            }
            If (Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx) == "Q")
            {
                Call IsLowerCase(Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx));
                If (Ret.IsLowerCase.IsLower == 0)
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOwnCastleQueenside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOppCastleQueenside = 1;
                    }
                }
                Else
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOppCastleQueenside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOwnCastleQueenside = 1;
                    }
                }
            }
            ImportFEN.CastlingCharIdx += 1;
        }
        Glob.Board.HasWhiteRookKSMoved = 0;
        Glob.Board.HasWhiteRookQSMoved = 0;
        Glob.Board.HasWhiteKingMoved = 0;
        Glob.Board.HasWhiteCastled = 0;
        Glob.Board.HasBlackRookKSMoved = 0;
        Glob.Board.HasBlackRookQSMoved = 0;
        Glob.Board.HasBlackKingMoved = 0;
        Glob.Board.HasBlackCastled = 0;
        If (Not ((ImportFEN.CanOwnCastleQueenside == 1)))
        {
            Glob.Board.HasBlackRookQSMoved = 1;
        }
        If (Not (((ImportFEN.CanOwnCastleQueenside == 1) Or (ImportFEN.CanOwnCastleKingside == 1))))
        {
            Glob.Board.HasBlackKingMoved = 1;
            Glob.Board.HasBlackCastled = 1;
        }
        If (Not ((ImportFEN.CanOwnCastleKingside == 1)))
        {
            Glob.Board.HasBlackRookKSMoved = 1;
        }
        If (Not ((ImportFEN.CanOppCastleQueenside == 1)))
        {
            Glob.Board.HasWhiteRookQSMoved = 1;
        }
        If (Not (((ImportFEN.CanOppCastleQueenside == 1) Or (ImportFEN.CanOppCastleKingside == 1))))
        {
            Glob.Board.HasWhiteKingMoved = 1;
            Glob.Board.HasWhiteCastled = 1;
        }
        If (Not ((ImportFEN.CanOppCastleKingside == 1)))
        {
            Glob.Board.HasWhiteRookKSMoved = 1;
        }
    }
    Else
    {
        Glob.Board.HasWhiteKingMoved = 0;
        Glob.Board.HasBlackKingMoved = 0;
        Glob.Board.HasWhiteCastled = 0;
        Glob.Board.HasBlackCastled = 0;
        Glob.Board.HasWhiteRookKSMoved = 0;
        Glob.Board.HasWhiteRookQSMoved = 0;
        Glob.Board.HasBlackRookKSMoved = 0;
        Glob.Board.HasBlackRookQSMoved = 0;
        If (Not ((Board[1] == GoK_BlackRook)))
        {
            Glob.Board.HasBlackRookQSMoved = 1;
        }
        If (Not ((Board[5] == GoK_BlackKing)))
        {
            Glob.Board.HasBlackKingMoved = 1;
        }
        If (Not ((Board[8] == GoK_BlackRook)))
        {
            Glob.Board.HasBlackRookKSMoved = 1;
        }
        If (Not ((Board[57] == GoK_WhiteRook)))
        {
            Glob.Board.HasWhiteRookQSMoved = 1;
        }
        If (Not ((Board[61] == GoK_WhiteKing)))
        {
            Glob.Board.HasWhiteKingMoved = 1;
        }
        If (Not ((Board[64] == GoK_WhiteRook)))
        {
            Glob.Board.HasWhiteRookKSMoved = 1;
        }
    }
    List.ReplaceItem(EnPassantTarget, 1, Const.Null);
    ImportFEN.EnPassantFile = 0;
    If (Operator.LetterOf(ImportFEN.EP, 1) == "a")
    {
        ImportFEN.EnPassantFile = 1;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "b")
    {
        ImportFEN.EnPassantFile = 2;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "c")
    {
        ImportFEN.EnPassantFile = 3;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "d")
    {
        ImportFEN.EnPassantFile = 4;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "e")
    {
        ImportFEN.EnPassantFile = 5;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "f")
    {
        ImportFEN.EnPassantFile = 6;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "g")
    {
        ImportFEN.EnPassantFile = 7;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "h")
    {
        ImportFEN.EnPassantFile = 8;
    }
    If (ImportFEN.EnPassantFile > 0)
    {
        If (((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.Game.IsPlayerBlack == 1)) Or ((Not ((Ret.ImportFEN.IsWhiteToMove == 1))) And (Not ((Glob.Game.IsPlayerBlack == 1)))))
        {
            List.ReplaceItem(EnPassantTarget, 1, (32 + ImportFEN.EnPassantFile));
        }
        Else
        {
            List.ReplaceItem(EnPassantTarget, 1, (24 + ImportFEN.EnPassantFile));
        }
    }
    List.DeleteAll(GameMoves);
    If (Not ((EnPassantTarget[1] == Const.Null)))
    {
        ImportFEN.SynthTargetIdx = EnPassantTarget[1];
        If (Board[ImportFEN.SynthTargetIdx] > 0)
        {
            ImportFEN.SynthSourceIdx = (ImportFEN.SynthTargetIdx - 16);
        }
        Else
        {
            ImportFEN.SynthSourceIdx = (ImportFEN.SynthTargetIdx + 16);
        }
        List.DeleteAll(GameMoves);
        List.Add(GameMoves, ((ImportFEN.SynthSourceIdx * 100) + ImportFEN.SynthTargetIdx));
    }
    List.DeleteAll(BoardHistoryFiftyMoves);
    ImportFEN.HalfCount = 0;
    Repeat (ImportFEN.Half)
    {
        ImportFEN.HalfCount += 1;
        List.Add(BoardHistoryFiftyMoves, ImportFEN.HalfCount);
    }
}

