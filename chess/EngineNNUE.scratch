Define InitSearch(string Horizon) (warp=true)
{
    Glob.Search.IsInNullMove = 0;
    If (List.Length(BoardHistoryFiftyMoves) == 0)
    {
        List.Add(BoardHistoryFiftyMoves, 0);
    }
    Glob.Search.IsTimeout = 0;
    If (Glob.Search.IsInitialDeepening == 1)
    {
        Ret.Search.PV = "";
        Call UI.FormatPV;
        List.DeleteAll(PVStable);
        List.DeleteAll(PVStablePrev);
        Glob.TT.CurrentAge = ((floor((Glob.TT.CurrentAge / 100)) + 1) * 100);
        InitSearch.KillerMoveIdx = 1;
        Repeat (List.Length(KillerMoves))
        {
            List.ReplaceItem(KillerMoves, InitSearch.KillerMoveIdx, Const.Null);
            InitSearch.KillerMoveIdx += 1;
        }
    }
    Call SetInitialEP(1);
    List.DeleteItem(SearchRootMovesDone, all);
    Glob.TT.CurrentAge += 1;
    Call CalcBoardStats;
    Call InitMovePosLookup((1 == 0));
    Call NNUE_Public_Refresh;
    Call CreateCurrentBoardHash;
}

