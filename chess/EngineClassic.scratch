                                        If ((IdxToFile[EvaluatePawnsImpl.KingIdx] == EvaluatePawnsImpl.Idx) And (((Not ((IdxToRank[EvaluatePawnsImpl.KingIdx] == 0))) * (IdxToRank[EvaluatePawnsImpl.KingIdx] + ((EvaluatePawnsImpl.Side == 2) * (9 - (2 * IdxToRank[EvaluatePawnsImpl.KingIdx]))))) > EvaluatePawnsImpl.NormalizedFrontRank))
                                        {
                                            If ((EvaluatePawnsImpl.Idx == 1) Or (EvaluatePawnsImpl.Idx == 8))
                                            {
                                                EvaluatePawnsImpl.QueeningDelta = 99;
                                            }
                                            Else
                                            {
                                                EvaluatePawnsImpl.QueeningDelta += 1;
                                            }
                                        }
                                        If (EvaluatePawnsImpl.Side == 1)
                                        {
                                            If (EvaluatePawnsImpl.QueeningDelta < EvaluatePawnsImpl.OwnQueener)
                                            {
                                                EvaluatePawnsImpl.OwnQueener = EvaluatePawnsImpl.QueeningDelta;
                                            }
                                        }
                                        Else
                                        {
                                            If (EvaluatePawnsImpl.QueeningDelta < EvaluatePawnsImpl.OppQueener)
                                            {
                                                EvaluatePawnsImpl.OppQueener = EvaluatePawnsImpl.QueeningDelta;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                EvaluatePawnsImpl.Idx += 1;
            }
            EvaluatePawnsImpl.Side += 1;
        }
        If ((EvaluatePawnsImpl.OwnQueener < EvaluatePawnsImpl.OppQueener) And (((2 * EvaluatePawnsImpl.OppFastest) + ((Ply + 3) % 2)) > (((2 * EvaluatePawnsImpl.OwnQueener) + ((Ply + 2) % 2)) + 1)))
        {
            Ret.EvaluatePawnsImpl.Score += ((GoK_OwnQueen - GoK_OwnPawn) - 100);
        }
        Else
        {
            If ((EvaluatePawnsImpl.OppQueener < EvaluatePawnsImpl.OwnQueener) And (((2 * EvaluatePawnsImpl.OwnFastest) + ((Ply + 2) % 2)) > (((2 * EvaluatePawnsImpl.OppQueener) + ((Ply + 3) % 2)) + 1)))
            {
                Ret.EvaluatePawnsImpl.Score += ((GoK_OppQueen - GoK_OppPawn) + 100);
            }
        }
    }
    If (Glob.Eval.DebugLog == 1)
    {
        Call LogPVEvalLine("Eval.Pawns.Total ")(Ret.EvaluatePawnsImpl.Score)("")("")("")("");
    }
}

Define EvaluatePawnStructure (warp=true)
