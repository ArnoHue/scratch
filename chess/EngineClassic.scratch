            EvalP.PStruct.AllAhead = (((EvalP.PStruct.File == 1) Or ((PawnCount[(EvalP.PStruct.File - 1)] == 0) Or (PawnAdvancePerFile[((EvalP.PStruct.File - 1) + Const.PawnAdvance.OwnRear)] > EvalP.PStruct.Rank))) And ((EvalP.PStruct.File == 8) Or ((PawnCount[(EvalP.PStruct.File + 1)] == 0) Or (PawnAdvancePerFile[((EvalP.PStruct.File + 1) + Const.PawnAdvance.OwnRear)] > EvalP.PStruct.Rank))));
            EvalP.PStruct.Backward = 0;
            If ((EvalP.PStruct.Neigh == 1) And ((EvalP.PStruct.AllAhead == 1) And ((EvalP.PStruct.Blocked == 1) Or (EvalP.PStruct.LeverPush > 0))))
            {
                EvalP.PStruct.Backward = 1;
            }
            EvalP.PStruct.RankBonusIdx = ((2 * EvalP.PStruct.NormRank) - 1);
            If ((EvalP.PStruct.Support > 0) Or (EvalP.PStruct.Phalanx > 0))
            {
                If (EvalP.PStruct.Phalanx > 0)
