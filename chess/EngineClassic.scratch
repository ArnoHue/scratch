            {
                List.Add(PawnPassedRankBonus, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "PawnConnectedBonus")
            {
                List.Add(PawnConnectedBonus, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "PawnPhalanxBonus")
            {
                List.Add(PawnPhalanxBonus, Operator.Round((LL.Token * 1)));
            }
            If (ListName == "PawnPhalanxOpposedBonus")
            {
                List.Add(PawnPhalanxBonusOpposed, Operator.Round((LL.Token * 1)));
            }
