            }
            EvaluatePawnStructure.Neigh = ((((EvaluatePawnStructure.File > 1) And (PawnCount[((EvaluatePawnStructure.File - 1) + 8)] > 0)) Or ((EvaluatePawnStructure.File < 8) And (PawnCount[((EvaluatePawnStructure.File + 1) + 8)] > 0))) + 0);
            EvaluatePawnStructure.AllAhead = ((((EvaluatePawnStructure.File == 1) Or ((PawnCount[((EvaluatePawnStructure.File - 1) + 8)] == 0) Or (PawnAdvancePerFile[(EvaluatePawnStructure.File - 1)] < EvaluatePawnStructure.Rank))) And ((EvaluatePawnStructure.File == 8) Or ((PawnCount[((EvaluatePawnStructure.File + 1) + 8)] == 0) Or (PawnAdvancePerFile[(EvaluatePawnStructure.File + 1)] < EvaluatePawnStructure.Rank)))) + 0);
            EvaluatePawnStructure.Backward = 0;
