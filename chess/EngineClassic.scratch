                    Call TaperedEval.Add((EvaluatePawnStructure.Bonus * -1))(((floor(((EvaluatePawnStructure.Bonus * (EvaluatePawnStructure.NormRank - 3)) / 2)) / 2) * -1))("Eval.Pawns.Connected")(EvaluatePawnStructure.SqIdx)(2)("");
