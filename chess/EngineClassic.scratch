Define IsCastlingPathSafe(string Move)(string Ply) (warp=true)
{
    Ret.IsCastlingPathSafe.IsSafe = 1;
    If (floor((Move / 100)) == 0)
    {
        ICPS.FirstIdx = 0;
        If (Move == GoK_OwnQueensideCastling)
        {
            ICPS.FirstIdx = 3;
        }
        If (Move == GoK_OwnKingsideCastling)
        {
            ICPS.FirstIdx = 5;
        }
        If (Move == GoK_OppQueensideCastling)
        {
            ICPS.FirstIdx = 59;
        }
        If (Move == GoK_OppKingsideCastling)
        {
            ICPS.FirstIdx = 61;
        }
        If (ICPS.FirstIdx > 0)
        {
            Call CalcBoardAttackedOnDemand(Ply)((1 == 0))((1 == 1))(99);
            ICPS.BaseIdx = ((Ply - 1) * Const.SnapshotPlyStride);
            If (Not (((PersistedBoardAttackedSnapshot[(ICPS.BaseIdx + ICPS.FirstIdx)] == 0) And ((PersistedBoardAttackedSnapshot[(ICPS.BaseIdx + (ICPS.FirstIdx + 1))] == 0) And (PersistedBoardAttackedSnapshot[(ICPS.BaseIdx + (ICPS.FirstIdx + 2))] == 0)))))
            {
                Ret.IsCastlingPathSafe.IsSafe = 0;
            }
        }
    }
}

Define IsCheckedFast(string CheckingPly) (warp=true)
{
    Ret.IsCheckedFast.IsChecked = 0;
    If (ChebyshevDistance[((Glob.OwnKingIdx * 100) + Glob.OppKingIdx)] < 2)
    {
        Ret.IsCheckedFast.IsChecked = 1;
        Stop(this script);
    }
    ICF.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    If (ICF.Factor > 0)
    {
        ICF.KingIdx = Glob.OppKingIdx;
    }
    Else
    {
        ICF.KingIdx = Glob.OwnKingIdx;
    }
    ICF.KingFile = IdxToFile[ICF.KingIdx];
    ICF.KingRank = IdxToRank[ICF.KingIdx];
    ICF.File = (ICF.KingFile + 1);
    ICF.Rank = (ICF.KingRank + 2);
    If (((ICF.File > 0) And (ICF.File < 9)) And ((ICF.Rank > 0) And (ICF.Rank < 9)))
    {
        ICF.SqIdx = (ICF.File + ((ICF.Rank - 1) * 8));
        ICF.Piece = Board[ICF.SqIdx];
        If (((ICF.Piece * ICF.Factor) > 0) And (abs(ICF.Piece) == GoK_OwnKnight))
        {
            If ((Ret.IsCheckedFast.IsChecked == 0) Or (ICF.SqIdx < Ret.IsCheckedFast.CheckedByIdx))
            {
                Ret.IsCheckedFast.CheckedByIdx = ICF.SqIdx;
