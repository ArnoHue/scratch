            }
            If ((EvalP.PStruct.Blocked == 1) And (EvalP.PStruct.NormRank == 6))
            {
                Call TaperedEval.Add(4)(-2)("Eval.Pawns.BlockedPawn.Rank6")(EvalP.PStruct.SqIdx)(2)("");
            }
        }
        EvalP.PStruct.PawnListIdx += 1;
    }
    EvalP.Side = 1;
    Repeat (2)
    {
        If (EvalP.Side == 1)
        {
            EvalP.IsCastlingPossible = EvalP.IsOwnSideCastlingPossibleLocal;
            EvalP.Forward = 8;
            EvalP.Backward = -8;
            EvalP.OurKingIdx = Glob.OwnKingIdx;
            EvalP.TheirKingIdx = Glob.OppKingIdx;
            EvalP.TheirQueenCount = Glob.OppQueenCountLocal;
            EvalP.TheirRookCount = Glob.OppRookCountLocal;
