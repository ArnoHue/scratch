        Init.KS.KingFile = IdxToFile[Init.KS.KingIdx];
        If (Init.KS.KingFile < 2)
        {
            Init.KS.KingFile = 2;
        }
        Else
        {
            If (Init.KS.KingFile > 7)
            {
                Init.KS.KingFile = 7;
            }
        }
        If (1 == 1)
        {
            If (Init.KS.KingRank < 2)
            {
                Init.KS.KingRank = 2;
            }
            Else
            {
                If (Init.KS.KingRank > 7)
                {
                    Init.KS.KingRank = 7;
                }
