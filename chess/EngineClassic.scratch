                    {
                        EvalP.NBack = ((Not ((PawnAdvancePerFile[(EvalP.Idx + EvalP.TheirOffset)] == 0))) * (PawnAdvancePerFile[(EvalP.Idx + EvalP.TheirOffset)] + ((EvalP.Side == 2) * (9 - (2 * PawnAdvancePerFile[(EvalP.Idx + EvalP.TheirOffset)])))));
                        If (EvalP.NFwd > EvalP.NBack)
