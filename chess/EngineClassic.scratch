                }
                If (Glob.IsSearchTimeout == 0)
                {
                    If (Ply == 1)
                    {
                        List.Add(SearchPly1EvalMoves, AppliedMove[Ply]);
                    }
                }
                Call RevertMove(Ply);
                If (Glob.IsSearchTimeout == 1)
                {
                    Stop(this script);
                }
            }
            Else
            {
                Call Search_DetectExtension(Horizon)(Ply)(Cutnode)(Quiescence);
                If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
                {
                    List.ReplaceItem(IsCurrentMoveQuiet, Ply, 1);
                }
                Else
                {
                    List.ReplaceItem(IsCurrentMoveQuiet, Ply, 0);
                }
