Define EvaluatePieces(string Ply)(bool HasAttackTables) (warp=true)
{
    Call //("Tapered evaluation, interpolating between midgame and game");
    Call EvaluatePiecesImpl(Ply)(HasAttackTables);
    Ret.EvaluatePieces.Score = Ret.EvaluatePiecesImpl.Score;
}

Define EvaluatePiecesImpl(string Ply)(bool HasAttackTables) (warp=true)
{
    Ret.EvaluatePiecesImpl.Score = 0;
    Call TaperedEval.Init;
    EvaluatePiecesImpl.EvalPieceIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_NonPawns))
    {
        EvaluatePiecesImpl.PieceSqIdx = (EvalPiecesIdx_NonPawns[EvaluatePiecesImpl.EvalPieceIdx] + 0);
        EvaluatePiecesImpl.Piece = (Board[(EvaluatePiecesImpl.PieceSqIdx + 0)] + 0);
        EvaluatePiecesImpl.Factor = (((EvaluatePiecesImpl.Piece > 0) * 2) - 1);
        EvaluatePiecesImpl.Side = (2 - (EvaluatePiecesImpl.Piece > 0));
        EvaluatePiecesImpl.PieceAbs = abs(EvaluatePiecesImpl.Piece);
        If (EvaluatePiecesImpl.Piece > 0)
        {
            EvaluatePiecesImpl.KingIdx = Glob.Board.OwnKingIdx;
        }
        Else
        {
            EvaluatePiecesImpl.KingIdx = Glob.Board.OppKingIdx;
        }
        If HasAttackTables
        {
            EvaluatePiecesImpl.MobilityIdx = ((PieceMobility[(EvaluatePiecesImpl.PieceSqIdx + 0)] * 2) + 1);
            If (EvaluatePiecesImpl.PieceAbs == GoK_OwnRook)
            {
                Call TaperedEval.Add((RookMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 0)] * EvaluatePiecesImpl.Factor))((RookMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 1)] * EvaluatePiecesImpl.Factor))("")("")("")("");
            }
            Else
            {
                If (EvaluatePiecesImpl.PieceAbs == GoK_OwnBishop)
                {
                    Call TaperedEval.Add((BishopMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 0)] * EvaluatePiecesImpl.Factor))((BishopMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 1)] * EvaluatePiecesImpl.Factor))("")("")("")("");
                }
                Else
                {
                    If (EvaluatePiecesImpl.PieceAbs == GoK_OwnKnight)
                    {
                        Call TaperedEval.Add((KnightMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 0)] * EvaluatePiecesImpl.Factor))((KnightMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 1)] * EvaluatePiecesImpl.Factor))("")("")("")("");
                    }
                    Else
                    {
                        If (EvaluatePiecesImpl.PieceAbs == GoK_OwnQueen)
                        {
                            Call TaperedEval.Add((QueenMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 0)] * EvaluatePiecesImpl.Factor))((QueenMobilityBonus[(EvaluatePiecesImpl.MobilityIdx + 1)] * EvaluatePiecesImpl.Factor))("")("")("")("");
                        }
                    }
                }
            }
        }
        If ((EvaluatePiecesImpl.PieceAbs == GoK_OwnKnight) Or (EvaluatePiecesImpl.PieceAbs == GoK_OwnBishop))
        {
            EvaluatePiecesImpl.Rank = (IdxToRank[(EvaluatePiecesImpl.PieceSqIdx + 0)] + 0);
            EvaluatePiecesImpl.File = (IdxToFile[(EvaluatePiecesImpl.PieceSqIdx + 0)] + 0);
            If HasAttackTables
            {
                EvaluatePiecesImpl.OP.KnightStepIdx = 0;
                EvaluatePiecesImpl.OP.OnOutpost = 0;
                EvaluatePiecesImpl.OP.IsOutpostReachable = 0;
                Repeat ((1 + (8 * (EvaluatePiecesImpl.PieceAbs == GoK_OwnKnight))))
                {
                    If (EvaluatePiecesImpl.OP.KnightStepIdx == 0)
                    {
                        EvaluatePiecesImpl.OP.SquareFile = EvaluatePiecesImpl.File;
                        EvaluatePiecesImpl.OP.SquareRank = EvaluatePiecesImpl.Rank;
                    }
