Define InitKingCheckSquares (warp=true)
{
    List.DeleteAll(KingCheckSquares);
    List.DeleteAll(KingCheckSquaresCount);
    Repeat (2560)
    {
        List.Add(KingCheckSquares, 0);
    }
    InitKingCheckSquares.KingIdx = 1;
    Repeat (64)
    {
        InitKingCheckSquares.Count = 0;
        InitKingCheckSquares.SqIdx = 1;
        Repeat (64)
        {
            If (Not ((InitKingCheckSquares.SqIdx == InitKingCheckSquares.KingIdx)))
            {
                If ((MovePosLookupLegal[((PieceIdxLookup[GoK_OwnQueen] * 10000) + ((InitKingCheckSquares.SqIdx * 100) + InitKingCheckSquares.KingIdx))] == 1) Or (MovePosLookupLegal[((PieceIdxLookup[GoK_OwnKnight] * 10000) + ((InitKingCheckSquares.SqIdx * 100) + InitKingCheckSquares.KingIdx))] == 1))
                {
                    InitKingCheckSquares.Count += 1;
                    List.ReplaceItem(KingCheckSquares, (((InitKingCheckSquares.KingIdx - 1) * 40) + InitKingCheckSquares.Count), InitKingCheckSquares.SqIdx);
                }
            }
            InitKingCheckSquares.SqIdx += 1;
        }
        List.Add(KingCheckSquaresCount, InitKingCheckSquares.Count);
        InitKingCheckSquares.KingIdx += 1;
    }
}

