            {
                CBABMC.SqIdx = (CBABMC.File + ((CBABMC.Rank - 1) * 8));
                CBABMC.Piece = Board[CBABMC.SqIdx];
                If (Not ((CBABMC.Piece == 0)))
                {
                    CBABMC.IsRayDone = 1;
                    If (((CBABMC.Piece * CBABMC.Factor) > 0) And ((abs(CBABMC.Piece) == GoK_OwnQueen) Or (abs(CBABMC.Piece) == GoK_OwnRook)))
                    {
                        CBABMC.IsChecked = 1;
                    }
                }
            }
            Else
