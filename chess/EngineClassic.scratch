                }
                Else
                {
                    EvalMM.MateCornerBonus = (abs(((IdxToRank[Glob.OwnKingIdx] + IdxToFile[Glob.OwnKingIdx]) - 9)) * 20);
                }
            }
            EvalMM.MateDriveBonus += EvalMM.MateCornerBonus;
            Ret.EvaluateMajorsMinorsImpl.Score += (0 - EvalMM.MateDriveBonus);
        }
    }
}

Define EvaluatePawns(string Ply) (warp=true)
{
