Define IsCastlingPathSafe(string Move)(string Ply) (warp=true)
{
    Ret.IsCastlingPathSafe.IsSafe = 1;
    If (floor((Move / 100)) == 0)
    {
        ICPS.FirstIdx = 0;
        If (Move == GoK_OwnQueensideCastling)
        {
            ICPS.FirstIdx = 3;
        }
        If (Move == GoK_OwnKingsideCastling)
        {
            ICPS.FirstIdx = 5;
        }
        If (Move == GoK_OppQueensideCastling)
        {
            ICPS.FirstIdx = 59;
        }
        If (Move == GoK_OppKingsideCastling)
        {
            ICPS.FirstIdx = 61;
        }
        If (ICPS.FirstIdx > 0)
        {
            Call CalcBoardAttackedOnDemand(Ply)((1 == 0))((1 == 1))(99);
            ICPS.Base = ((Ply - 1) * 100);
            If (Not (((PersistedBoardAttackedSnapshot[(ICPS.Base + VirtualBoard[ICPS.FirstIdx])] == 0) And ((PersistedBoardAttackedSnapshot[(ICPS.Base + VirtualBoard[(ICPS.FirstIdx + 1)])] == 0) And (PersistedBoardAttackedSnapshot[(ICPS.Base + VirtualBoard[(ICPS.FirstIdx + 2)])] == 0)))))
            {
                Ret.IsCastlingPathSafe.IsSafe = 0;
            }
        }
    }
}

Define IsCheckedFast(string CheckingPly) (warp=true)
{
    Ret.IsCheckedFast.IsChecked = 0;
    If (ChebyshevDistance[((Glob.OwnKingIdx * 100) + Glob.OppKingIdx)] < 2)
    {
        Ret.IsCheckedFast.IsChecked = 1;
        Stop(this script);
    }
    ICF.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    If (ICF.Factor > 0)
    {
        ICF.KingIdx = Glob.OppKingIdx;
    }
    Else
    {
        ICF.KingIdx = Glob.OwnKingIdx;
    }
    ICF.SqIdx = 1;
    TCA.F0 = IdxToFile[ICF.KingIdx];
    TCA.R0 = IdxToRank[ICF.KingIdx];
    TCA.F = (TCA.F0 + 1);
    TCA.R = (TCA.R0 + 2);
    If (((TCA.F > 0) And (TCA.F < 9)) And ((TCA.R > 0) And (TCA.R < 9)))
    {
        TCA.Sq = (TCA.F + ((TCA.R - 1) * 8));
        TCA.P = Board[TCA.Sq];
        If (((TCA.P * ICF.Factor) > 0) And (abs(TCA.P) == GoK_OwnKnight))
        {
            If ((Ret.IsCheckedFast.IsChecked == 0) Or (TCA.Sq < Ret.IsCheckedFast.CheckedByIdx))
            {
                Ret.IsCheckedFast.CheckedByIdx = TCA.Sq;
            }
            Ret.IsCheckedFast.IsChecked = 1;
        }
    }
    TCA.F = (TCA.F0 + 2);
    TCA.R = (TCA.R0 + 1);
    If (((TCA.F > 0) And (TCA.F < 9)) And ((TCA.R > 0) And (TCA.R < 9)))
    {
        TCA.Sq = (TCA.F + ((TCA.R - 1) * 8));
        TCA.P = Board[TCA.Sq];
        If (((TCA.P * ICF.Factor) > 0) And (abs(TCA.P) == GoK_OwnKnight))
        {
            If ((Ret.IsCheckedFast.IsChecked == 0) Or (TCA.Sq < Ret.IsCheckedFast.CheckedByIdx))
            {
                Ret.IsCheckedFast.CheckedByIdx = TCA.Sq;
            }
            Ret.IsCheckedFast.IsChecked = 1;
        }
    }
    TCA.F = (TCA.F0 + 2);
    TCA.R = (TCA.R0 + -1);
    If (((TCA.F > 0) And (TCA.F < 9)) And ((TCA.R > 0) And (TCA.R < 9)))
    {
        TCA.Sq = (TCA.F + ((TCA.R - 1) * 8));
        TCA.P = Board[TCA.Sq];
        If (((TCA.P * ICF.Factor) > 0) And (abs(TCA.P) == GoK_OwnKnight))
        {
            If ((Ret.IsCheckedFast.IsChecked == 0) Or (TCA.Sq < Ret.IsCheckedFast.CheckedByIdx))
            {
                Ret.IsCheckedFast.CheckedByIdx = TCA.Sq;
            }
            Ret.IsCheckedFast.IsChecked = 1;
        }
    }
    TCA.F = (TCA.F0 + 1);
    TCA.R = (TCA.R0 + -2);
    If (((TCA.F > 0) And (TCA.F < 9)) And ((TCA.R > 0) And (TCA.R < 9)))
    {
        TCA.Sq = (TCA.F + ((TCA.R - 1) * 8));
        TCA.P = Board[TCA.Sq];
