        {
            EvalP.OppKingDistSum += ChebyshevDistance[((EvalP.Idx * 100) + Glob.OppKingIdx)];
        }
        EvalP.EvalPieceIdx += 1;
    }
    If (Glob.OwnPawnCountLocal > 0)
    {
        Call TaperedEval.Add(0)((0 - Operator.Round((5 * (EvalP.OwnKingDistSum / Glob.OwnPawnCountLocal)))))("Eval.Pawns.PawnKingTropism")("")(1)("");
    }
    If (Glob.OppPawnCountLocal > 0)
    {
        Call TaperedEval.Add(0)(Operator.Round((5 * (EvalP.OppKingDistSum / Glob.OppPawnCountLocal))))("Eval.Pawns.PawnKingTropism")("")(2)("");
    }
    Call Comment("Doubled pawns, passed pawns, open-file pawns");
    If (Not ((List.Length(PE.NormalizedRank) == 8)))
    {
        List.DeleteAll(PE.NormalizedRank);
        Repeat (8)
        {
            List.Add(PE.NormalizedRank, 0);
        }
    }
    EvalP.PStruct.OwnFixed = 0;
    EvalP.PStruct.OppFixed = 0;
    EvalP.PStruct.PawnListIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_Pawns))
    {
        EvalP.PStruct.SqIdx = (EvalPiecesIdx_Pawns[EvalP.PStruct.PawnListIdx] + 0);
        EvalP.PStruct.Pawn = (Board[EvalP.PStruct.SqIdx] + 0);
        EvalP.PStruct.File = (IdxToFile[EvalP.PStruct.SqIdx] + 0);
        EvalP.PStruct.Rank = (IdxToRank[EvalP.PStruct.SqIdx] + 0);
        If (EvalP.PStruct.Pawn > 0)
        {
            EvalP.PStruct.NormRank = EvalP.PStruct.Rank;
            If ((Board[(EvalP.PStruct.SqIdx + 8)] == GoK_OppPawn) Or ((EvalP.PStruct.NormRank < 7) And (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + 15)] == GoK_OppPawn)) Or ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + 17)] == GoK_OppPawn)))))
            {
                EvalP.PStruct.OwnFixed += 1;
            }
        }
