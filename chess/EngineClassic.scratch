    {
        Init.OB.OpeningMoveIdx = 1;
        Repeat (List.Length(OpeningMovesOpp))
        {
            List.Add(OpeningMoves, OpeningMovesOpp[Init.OB.OpeningMoveIdx]);
            Init.OB.OpeningMoveIdx += 1;
        }
    }
