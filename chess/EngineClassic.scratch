Define CalcBoardAttackedOnDemand(string Ply)(bool Quiescence)(bool ForceOnCheck)(string Horizon) (warp=true)
{
    If (BoardAttackedCalculated[Ply] == 0)
    {
        If ((ForceOnCheck And (CheckedState[Ply] == 1)) Or ((Not ((Ply > Horizon))) And (Not (Quiescence))))
        {
            Call CalcBoardAttackedByMove((Ply + 1));
            Call StoreAttackInfo((Ply + 1))(Ply);
            List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
        }
    }
}

Define CalcBoardStats (warp=true)
{
    Glob.OwnKingIdx = Const.Null;
    Glob.OppKingIdx = Const.Null;
    Glob.CurrentBoardHash = 0;
    Glob.NonPawnHashOwn = 0;
    Glob.NonPawnHashOpp = 0;
    Glob.KPHash = 0;
    CBS.SqIdx = 1;
    Repeat (8)
    {
        List.ReplaceItem(PawnCount, CBS.SqIdx, 0);
        List.ReplaceItem(PawnCount, (CBS.SqIdx + 8), 0);
        CBS.SqIdx += 1;
    }
    CBS.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CBS.SqIdx] == GoK_OppPawn)
        {
            List.ReplaceItem(PawnCount, (IdxToFile[CBS.SqIdx] + 8), (PawnCount[(IdxToFile[CBS.SqIdx] + 8)] + 1));
        }
        Else
        {
            If (Board[CBS.SqIdx] == GoK_OwnPawn)
            {
                List.ReplaceItem(PawnCount, IdxToFile[CBS.SqIdx], (PawnCount[IdxToFile[CBS.SqIdx]] + 1));
            }
            Else
            {
                If (Board[CBS.SqIdx] == GoK_OppKing)
                {
                    Glob.OppKingIdx = CBS.SqIdx;
                }
                Else
                {
                    If (Board[CBS.SqIdx] == GoK_OwnKing)
                    {
                        Glob.OwnKingIdx = CBS.SqIdx;
                    }
                }
            }
        }
        Call GetPiecePosHash(Board[CBS.SqIdx])(CBS.SqIdx);
        Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CBS.SqIdx]) == GoK_OwnPawn)))
        {
            If (Board[CBS.SqIdx] > 0)
            {
                Glob.NonPawnHashOwn += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.NonPawnHashOpp += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CBS.SqIdx]) == GoK_OwnPawn) Or (abs(Board[CBS.SqIdx]) == GoK_OwnKing))
        {
            Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CBS.SqIdx += 1;
    }
    CBS.OwnNonQueenMajorMinorCount = 0;
    CBS.OwnQueenCount = 0;
    CBS.OwnPawnCount = 0;
    CBS.OwnRookCount = 0;
    CBS.OwnBishopCount = 0;
    CBS.OppQueenCount = 0;
    CBS.OppNonQueenMajorMinorCount = 0;
    CBS.OppPawnCount = 0;
    CBS.OppRookCount = 0;
    CBS.OppBishopCount = 0;
    CBS.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CBS.SqIdx] == GoK_OppQueen)
        {
            CBS.OppQueenCount += 1;
        }
        If (Board[CBS.SqIdx] == GoK_OwnQueen)
        {
            CBS.OwnQueenCount += 1;
        }
        If ((Board[CBS.SqIdx] == GoK_OppKnight) Or ((Board[CBS.SqIdx] == GoK_OppBishop) Or (Board[CBS.SqIdx] == GoK_OppRook)))
        {
            CBS.OppNonQueenMajorMinorCount += 1;
            If (Board[CBS.SqIdx] == GoK_OppRook)
            {
                CBS.OppRookCount += 1;
            }
            If (Board[CBS.SqIdx] == GoK_OppBishop)
            {
                CBS.OppBishopCount += 1;
            }
        }
        If ((Board[CBS.SqIdx] == GoK_OwnKnight) Or ((Board[CBS.SqIdx] == GoK_OwnBishop) Or (Board[CBS.SqIdx] == GoK_OwnRook)))
        {
            CBS.OwnNonQueenMajorMinorCount += 1;
            If (Board[CBS.SqIdx] == GoK_OwnRook)
            {
                CBS.OwnRookCount += 1;
            }
            If (Board[CBS.SqIdx] == GoK_OwnBishop)
            {
                CBS.OwnBishopCount += 1;
            }
        }
        If (Board[CBS.SqIdx] == GoK_OppPawn)
        {
            CBS.OppPawnCount += 1;
        }
        If (Board[CBS.SqIdx] == GoK_OwnPawn)
        {
            CBS.OwnPawnCount += 1;
        }
        CBS.SqIdx += 1;
    }
    If ((((CBS.OppQueenCount + CBS.OppNonQueenMajorMinorCount) + (CBS.OwnQueenCount + CBS.OwnNonQueenMajorMinorCount)) < 3) And ((CBS.OppQueenCount == 0) Or (CBS.OwnQueenCount == 0)))
    {
        Glob.IsLateEndgame = 1;
        Glob.IsEndgame = 1;
    }
    Else
    {
        Glob.IsLateEndgame = 0;
        Glob.IsEndgame = 0;
        Call GetAttackForce((1 == 0));
        If (Ret.GetAttackForce.Force < 13)
        {
            Glob.IsEndgame = 1;
        }
        Call GetAttackForce((1 == 1));
        If (Ret.GetAttackForce.Force < 13)
        {
            Glob.IsEndgame = 1;
        }
    }
    Glob.OppQueenCount = CBS.OppQueenCount;
    Glob.OppNonQueenMajorMinorCount = CBS.OppNonQueenMajorMinorCount;
    Glob.OwnQueenCount = CBS.OwnQueenCount;
    Glob.OwnNonQueenMajorMinorCount = CBS.OwnNonQueenMajorMinorCount;
    Glob.OppRookCount = CBS.OppRookCount;
    Glob.OwnRookCount = CBS.OwnRookCount;
    Glob.OppPawnCount = CBS.OppPawnCount;
    Glob.OwnPawnCount = CBS.OwnPawnCount;
    Glob.OppBishopCount = CBS.OppBishopCount;
    Glob.OwnBishopCount = CBS.OwnBishopCount;
    List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    List.ReplaceItem(CastlingState, 2, CastlingState[1]);
}

Define CalculateMaterialImbalance(string Ply) (warp=true)
{
    Ret.CalculateMaterialImbalance.Score = 0;
    Ret.CalculateMaterialImbalance.ScoreEg = 0;
    List.DeleteAll(TmpList1);
    List.DeleteAll(TmpList2);
    If (Glob.OwnBishopCount == 2)
    {
        List.Add(TmpList1, 1);
    }
    Else
    {
        List.Add(TmpList1, 0);
    }
    List.Add(TmpList1, Glob.OwnPawnCount);
    List.Add(TmpList1, (Glob.OwnNonQueenMajorMinorCount - (Glob.OwnRookCount + Glob.OwnBishopCount)));
    List.Add(TmpList1, Glob.OwnBishopCount);
    List.Add(TmpList1, Glob.OwnRookCount);
    List.Add(TmpList1, Glob.OwnQueenCount);
    If (Glob.OppBishopCount == 2)
    {
        List.Add(TmpList2, 1);
    }
    Else
    {
        List.Add(TmpList2, 0);
    }
    List.Add(TmpList2, Glob.OppPawnCount);
    List.Add(TmpList2, (Glob.OppNonQueenMajorMinorCount - (Glob.OppRookCount + Glob.OppBishopCount)));
    List.Add(TmpList2, Glob.OppBishopCount);
    List.Add(TmpList2, Glob.OppRookCount);
    List.Add(TmpList2, Glob.OppQueenCount);
    CMI.Idx = 1;
    Repeat (6)
    {
        CMI.ImbalanceSum = 0;
        CMI.ImbalanceSumEg = 0;
        If (((PlyIsOwn[Ply] == 1) And (TmpList1[CMI.Idx] > 0)) Or ((PlyIsOwn[Ply] == 0) And (TmpList2[CMI.Idx] > 0)))
        {
            CMI.OtherPieceTypeIdx = 1;
            Repeat Until (CMI.OtherPieceTypeIdx > CMI.Idx)
            {
                If (PlyIsOwn[Ply] == 1)
                {
                    CMI.ImbalanceSum += ((ImbalanceSameSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList1[CMI.OtherPieceTypeIdx]) + (ImbalanceOppSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList2[CMI.OtherPieceTypeIdx]));
                    CMI.ImbalanceSumEg += ((ImbalanceSameSideEg[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList1[CMI.OtherPieceTypeIdx]) + (ImbalanceOppSideEg[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList2[CMI.OtherPieceTypeIdx]));
                }
                Else
                {
                    CMI.ImbalanceSum += ((ImbalanceSameSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList2[CMI.OtherPieceTypeIdx]) + (ImbalanceOppSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList1[CMI.OtherPieceTypeIdx]));
                    CMI.ImbalanceSumEg += ((ImbalanceSameSideEg[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList2[CMI.OtherPieceTypeIdx]) + (ImbalanceOppSideEg[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList1[CMI.OtherPieceTypeIdx]));
                }
                CMI.OtherPieceTypeIdx += 1;
            }
            If (PlyIsOwn[Ply] == 1)
            {
                Ret.CalculateMaterialImbalance.Score += (TmpList1[CMI.Idx] * CMI.ImbalanceSum);
                Ret.CalculateMaterialImbalance.ScoreEg += (TmpList1[CMI.Idx] * CMI.ImbalanceSumEg);
            }
            Else
            {
                Ret.CalculateMaterialImbalance.Score += (TmpList2[CMI.Idx] * CMI.ImbalanceSum);
                Ret.CalculateMaterialImbalance.ScoreEg += (TmpList2[CMI.Idx] * CMI.ImbalanceSumEg);
            }
        }
        CMI.Idx += 1;
    }
}

Define ClearBoardAttackedByMove(num Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 1)
    {
        CBABM.SqIdx = 1;
        Repeat (64)
        {
            List.ReplaceItem(BoardAttacked, CBABM.SqIdx, 0);
            List.ReplaceItem(BoardAttackedPiece, CBABM.SqIdx, 0);
            List.ReplaceItem(BoardAttackedTypeMask, CBABM.SqIdx, 0);
            CBABM.SqIdx += 1;
        }
        CBABM.SqIdx = 1;
        Repeat (384)
        {
            List.ReplaceItem(BoardAttackerType, CBABM.SqIdx, 0);
            List.ReplaceItem(BoardAttackerType2, CBABM.SqIdx, 0);
            CBABM.SqIdx += 1;
        }
        Glob.IsOppSideChecked = 0;
    }
    Else
    {
        CBABM.SqIdx = 1;
        Repeat (64)
        {
            List.ReplaceItem(BoardAttacked, (CBABM.SqIdx + 64), 0);
            List.ReplaceItem(BoardAttackedPiece, (CBABM.SqIdx + 64), 0);
            List.ReplaceItem(BoardAttackedTypeMask, (CBABM.SqIdx + 64), 0);
            CBABM.SqIdx += 1;
        }
        CBABM.SqIdx = 1;
        Repeat (384)
        {
            List.ReplaceItem(BoardAttackerType, (CBABM.SqIdx + 384), 0);
            List.ReplaceItem(BoardAttackerType2, (CBABM.SqIdx + 384), 0);
            CBABM.SqIdx += 1;
        }
        Glob.IsOwnSideChecked = 0;
    }
}

Define ClearMoveList(num Ply) (warp=true)
{
    List.ReplaceItem(MovesCount, Ply, 0);
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
    }
    Else
    {
        If (Ply == 2)
        {
            List.DeleteAll(Moves2);
        }
    }
}

Define ClearTT (warp=true)
{
    If (Glob.IsScratch3 == 1)
    {
        Call ClearTTImpl(65536);
    }
    Else
    {
        Call ClearTTImpl(1048576);
    }
}

Define ClearTTImpl(string Size) (warp=true)
{
    List.DeleteItem(TTNodeEntry, all);
    Repeat (Size)
    {
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
    }
}

Define CreateCurrentBoardHash (warp=true)
{
    Glob.CurrentBoardHash = 0;
    Glob.NonPawnHashOwn = 0;
    Glob.NonPawnHashOpp = 0;
    Glob.KPHash = 0;
    CCBH.SqIdx = 1;
    Repeat (64)
    {
        Call GetPiecePosHash(Board[CCBH.SqIdx])(CCBH.SqIdx);
        Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CCBH.SqIdx]) == GoK_OwnPawn)))
        {
            If (Board[CCBH.SqIdx] > 0)
            {
                Glob.NonPawnHashOwn += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.NonPawnHashOpp += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CCBH.SqIdx]) == GoK_OwnPawn) Or (abs(Board[CCBH.SqIdx]) == GoK_OwnKing))
        {
            Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CCBH.SqIdx += 1;
    }
}

Define DrawBoardAndWait (warp=false)
{
    Call StoreExternalBoard;
    List.DeleteAll(GoK_ScreenBoard);
    DBW.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_ScreenBoard, Board[GoK_ScreenIdx[DBW.SqIdx]]);
        DBW.SqIdx += 1;
    }
    If (Glob.IsDCI == 0)
    {
        GoK_ProgressValue = 0;
        Event.BroadcastAndWait("drawboard");
        Event.BroadcastAndWait("progressvaluechanged");
        Event.BroadcastAndWait("evaluationvaluechanged");
    }
}

Define EnterExecution (warp=false)
{
    Glob.ExecutionPly += 1;
    If (Glob.ExecutionPly == 1)
    {
        Glob.IsExecutionRunning = 1;
        Event.BroadcastAndWait("calcmode");
    }
}

Define Evaluate(string Ply)(bool FullEval) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(-1);
    }
    Ret.Evaluate.Score = Const.Null;
    If ((Glob.OppKingIdx == Const.Null) And (Glob.OwnKingIdx == Const.Null))
    {
        Ret.Evaluate.Score = 0;
        If (Glob.ProfilerMode == Const.ProfilerMode.On)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.OppKingIdx == Const.Null)
    {
        Ret.Evaluate.Score = (100000 - (List.Length(BoardHistoryFiftyMoves) - 1));
        If (Glob.ProfilerMode == Const.ProfilerMode.On)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.OwnKingIdx == Const.Null)
    {
        Ret.Evaluate.Score = (-100000 + (List.Length(BoardHistoryFiftyMoves) - 1));
        If (Glob.ProfilerMode == Const.ProfilerMode.On)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If (Ply == 0)
    {
        Call EvaluateBoard;
        Eval.BoardScore = Ret.EvaluateBoard.Score;
        If (Glob.ProfilerMode == Const.ProfilerMode.On)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_MethodEnter(Ply);
    }
    If FullEval
    {
        If (Glob.EvalDebugLog == 0)
        {
            If (Glob.ProfilerMode == Const.ProfilerMode.On)
            {
                Call Profile_CountByHorizon(Const.Profile.TTStaticProbe)(HorizonAtPly[Ply])(Ply);
            }
        }
        Glob.EvalMgTotal = 0;
        Glob.EvalEgTotal = 0;
        Glob.EvalPassedCount = 0;
        Glob.EvalOwnPassedCount = 0;
        Glob.EvalOppPassedCount = 0;
        Call EvaluateBoard;
        Eval.BoardScore = Ret.EvaluateBoard.Score;
        Call PrepareEvalPiecesData(Ply);
        Call EvaluatePawns(Ply);
        Eval.PawnsScore = Ret.EvaluatePawns.Score;
        If (Glob.EvalDebugLog == 1)
        {
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
        Call EvaluateMajorsMinors(Ply);
        Eval.MajorsMinorsScore = Ret.EvaluateMajorsMinors.Score;
        If (Glob.EvalDebugLog == 1)
        {
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
        Call EvaluateThreats(Ply);
        Eval.ThreatsScore = Ret.EvaluateThreats.Score;
        If (Glob.EvalDebugLog == 1)
        {
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
        Ret.Evaluate.Score = (Eval.BoardScore + ((Eval.PawnsScore + Eval.MajorsMinorsScore) + Eval.ThreatsScore));
        Call CalculateMaterialImbalance(1);
        Eval.OwnImbalance = Ret.CalculateMaterialImbalance.Score;
        Eval.OwnImbalanceEg = Ret.CalculateMaterialImbalance.ScoreEg;
        Call CalculateMaterialImbalance(2);
        Eval.OppImbalance = Ret.CalculateMaterialImbalance.Score;
        Eval.OppImbalanceEg = Ret.CalculateMaterialImbalance.ScoreEg;
        Call TaperedEval.Init;
        Eval.ImbalanceMgSf = ((Eval.OwnImbalance - Eval.OppImbalance) / 16);
        Eval.ImbalanceEgSf = ((Eval.OwnImbalanceEg - Eval.OppImbalanceEg) / 16);
        Call TaperedEval.Add(((((Eval.ImbalanceMgSf > 0) - (Eval.ImbalanceMgSf < 0)) * floor(abs(Eval.ImbalanceMgSf))) / 2))(((((Eval.ImbalanceEgSf > 0) - (Eval.ImbalanceEgSf < 0)) * floor(abs(Eval.ImbalanceEgSf))) / 2))("Eval.Imbalance")("")("")("");
        Call TaperedEval.GetSum;
        Glob.EvalMgTotal += Glob.TaperedEvalMg;
        Glob.EvalEgTotal += Glob.TaperedEvalEg;
        Ret.Evaluate.Score += Ret.TaperedEval.GetSum.Score;
        Eval.Winnable.KingOutflanking = (abs((IdxToFile[Glob.OwnKingIdx] - IdxToFile[Glob.OppKingIdx])) - abs((IdxToRank[Glob.OwnKingIdx] - IdxToRank[Glob.OppKingIdx])));
        Eval.Winnable.PawnsOnBothFlanks = ((((((((((PawnCount[1] + PawnCount[9]) + PawnCount[2]) + PawnCount[10]) + PawnCount[3]) + PawnCount[11]) + PawnCount[4]) + PawnCount[12]) > 0) And ((((((((PawnCount[5] + PawnCount[13]) + PawnCount[6]) + PawnCount[14]) + PawnCount[7]) + PawnCount[15]) + PawnCount[8]) + PawnCount[16]) > 0)) * 1);
        Eval.Winnable.Complexity = (((((((((9 * Glob.EvalPassedCount) + (12 * (Glob.OwnPawnCount + Glob.OppPawnCount))) + (9 * Eval.Winnable.KingOutflanking)) + (21 * Eval.Winnable.PawnsOnBothFlanks)) + (24 * ((Glob.OwnKingIdx > 32) Or (Glob.OppKingIdx < 33)))) + (51 * (((Glob.OwnQueenCount + Glob.OwnNonQueenMajorMinorCount) + (Glob.OppQueenCount + Glob.OppNonQueenMajorMinorCount)) == 0))) - (43 * ((Eval.Winnable.KingOutflanking < 0) And (Eval.Winnable.PawnsOnBothFlanks == 0)))) - 110) / 2);
        Eval.Winnable.MgAdjust = (Eval.Winnable.Complexity + 25);
        If (Eval.Winnable.MgAdjust > 0)
        {
            Eval.Winnable.MgAdjust = 0;
        }
        If (Eval.Winnable.MgAdjust < (0 - abs(Glob.EvalMgTotal)))
        {
            Eval.Winnable.MgAdjust = (0 - abs(Glob.EvalMgTotal));
        }
        Eval.Winnable.MgAdjust = (Eval.Winnable.MgAdjust * ((Glob.EvalMgTotal > 0) - (Glob.EvalMgTotal < 0)));
        Eval.Winnable.EgAdjust = Eval.Winnable.Complexity;
        If (Eval.Winnable.EgAdjust < (0 - abs(Glob.EvalEgTotal)))
        {
            Eval.Winnable.EgAdjust = (0 - abs(Glob.EvalEgTotal));
        }
        Eval.Winnable.EgAdjust = (Eval.Winnable.EgAdjust * ((Glob.EvalEgTotal > 0) - (Glob.EvalEgTotal < 0)));
        Ret.Evaluate.Score += Operator.Round((((Eval.Winnable.MgAdjust * Glob.TaperedEvalPhase) + (Eval.Winnable.EgAdjust * (128 - Glob.TaperedEvalPhase))) / 128));
        If (Glob.EvalDebugLog == 1)
        {
            Call Log("Eval.Winnable.Complexity = ")(Eval.Winnable.Complexity)(" MgAdjust = ")(Eval.Winnable.MgAdjust)(" EgAdjust = ")(Eval.Winnable.EgAdjust)("")("");
        }
        If (Glob.EvalDebugLog == 1)
        {
            Call Log("Eval.MaterialCaptureList = ")(TargetPieces)("")("")("")("")("")("");
            Call Log("Eval.MaterialPromotionList = ")(PromotionPieces)("")("")("")("")("")("");
            Call Log("Eval.Pawns = ")(Eval.PawnsScore)("")("")("")("")("")("");
            Call Log("Eval.MajorsMinors = ")(Eval.MajorsMinorsScore)("")("")("")("")("")("");
            Call Log("Eval.Threats = ")(Eval.ThreatsScore)("")("")("")("")("")("");
            Call Log("Eval.Imbalance = ")(Operator.Round(((Eval.OwnImbalance - Eval.OppImbalance) / 1)))("")("")("")("")("")("");
            Call Log("Eval.Total (pre-DrawScale)= ")(Ret.Evaluate.Score)("")("")("")("")("")("");
        }
        Eval.OppositeBishops.ScaleFactor = 128;
        If ((Glob.OwnBishopCount == 1) And (Glob.OppBishopCount == 1))
        {
            Eval.OppositeBishops.OwnBishopIdx = 0;
            Eval.OppositeBishops.OppBishopIdx = 0;
            Eval.OppositeBishops.Idx = 1;
            Repeat (64)
            {
                If (Board[Eval.OppositeBishops.Idx] == GoK_OwnBishop)
                {
                    Eval.OppositeBishops.OwnBishopIdx = Eval.OppositeBishops.Idx;
                }
                If (Board[Eval.OppositeBishops.Idx] == GoK_OppBishop)
                {
                    Eval.OppositeBishops.OppBishopIdx = Eval.OppositeBishops.Idx;
                }
                Eval.OppositeBishops.Idx += 1;
            }
            If (Not ((((IdxToFile[Eval.OppositeBishops.OwnBishopIdx] + IdxToRank[Eval.OppositeBishops.OwnBishopIdx]) % 2) == ((IdxToFile[Eval.OppositeBishops.OppBishopIdx] + IdxToRank[Eval.OppositeBishops.OppBishopIdx]) % 2))))
            {
                Eval.OppositeBishops.StrongSide = ((Glob.EvalEgTotal > 0) - (Glob.EvalEgTotal < 0));
                If (Not ((Eval.OppositeBishops.StrongSide == 0)))
                {
                    If ((((Glob.OwnQueenCount + Glob.OppQueenCount) + (Glob.OwnRookCount + Glob.OppRookCount)) == 0) And ((Glob.OwnNonQueenMajorMinorCount == 1) And (Glob.OppNonQueenMajorMinorCount == 1)))
                    {
                        If (Eval.OppositeBishops.StrongSide == 1)
                        {
                            Eval.OppositeBishops.StrongPieceCount = Glob.EvalOwnPassedCount;
                        }
                        Else
                        {
                            Eval.OppositeBishops.StrongPieceCount = Glob.EvalOppPassedCount;
                        }
                        Eval.OppositeBishops.ScaleFactor = (36 + (8 * Eval.OppositeBishops.StrongPieceCount));
                    }
                    Else
                    {
                        If (Eval.OppositeBishops.StrongSide == 1)
                        {
                            Eval.OppositeBishops.StrongPieceCount = (1 + (Glob.OwnPawnCount + (Glob.OwnQueenCount + Glob.OwnNonQueenMajorMinorCount)));
                        }
                        Else
                        {
                            Eval.OppositeBishops.StrongPieceCount = (1 + (Glob.OppPawnCount + (Glob.OppQueenCount + Glob.OppNonQueenMajorMinorCount)));
                        }
                        Eval.OppositeBishops.ScaleFactor = (44 + (6 * Eval.OppositeBishops.StrongPieceCount));
                    }
                    If (Eval.Winnable.PawnsOnBothFlanks == 0)
                    {
                        Eval.OppositeBishops.ScaleFactor += -8;
                    }
                    If (Eval.OppositeBishops.ScaleFactor > 128)
                    {
                        Eval.OppositeBishops.ScaleFactor = 128;
                    }
                    Ret.Evaluate.Score += Operator.Round((((Glob.EvalEgTotal * (128 - Glob.TaperedEvalPhase)) * (Eval.OppositeBishops.ScaleFactor - 128)) / 16384));
                    If (Glob.EvalDebugLog == 1)
                    {
                        Call Log("Eval.OppositeBishops.ScaleFactor = ")(Eval.OppositeBishops.ScaleFactor)("")("")("")("")("")("");
                    }
                }
            }
        }
        If (Eval.OppositeBishops.ScaleFactor == 128)
        {
            Eval.ScaleFactor.StrongSide = (((Glob.EvalEgTotal + Eval.Winnable.EgAdjust) > 0) - ((Glob.EvalEgTotal + Eval.Winnable.EgAdjust) < 0));
            If (Not ((Eval.ScaleFactor.StrongSide == 0)))
            {
                If (Eval.ScaleFactor.StrongSide == 1)
                {
                    Eval.ScaleFactor.StrongPawnCount = Glob.OwnPawnCount;
                    Eval.ScaleFactor.StrongMaterial = Ret.TaperedEval.Init.OwnMaterial;
                    Eval.ScaleFactor.WeakMaterial = Ret.TaperedEval.Init.OppMaterial;
                }
                Else
                {
                    Eval.ScaleFactor.StrongPawnCount = Glob.OppPawnCount;
                    Eval.ScaleFactor.StrongMaterial = Ret.TaperedEval.Init.OppMaterial;
                    Eval.ScaleFactor.WeakMaterial = Ret.TaperedEval.Init.OwnMaterial;
                }
                Eval.ScaleFactor.Value = 64;
                If ((Eval.ScaleFactor.StrongPawnCount == 0) And ((Eval.ScaleFactor.StrongMaterial - Eval.ScaleFactor.WeakMaterial) < (GoK_OwnBishop + 1)))
                {
                    If (Eval.ScaleFactor.StrongMaterial < GoK_OwnRook)
                    {
                        Eval.ScaleFactor.Value = 0;
                    }
                    Else
                    {
                        If (Eval.ScaleFactor.WeakMaterial < (GoK_OwnBishop + 1))
                        {
                            Eval.ScaleFactor.Value = 4;
                        }
                        Else
                        {
                            Eval.ScaleFactor.Value = 14;
                        }
                    }
                }
                Else
                {
                    If (Eval.ScaleFactor.StrongSide == 1)
                    {
                        Eval.ScaleFactor.WeakPawnCount = Glob.OppPawnCount;
                    }
                    Else
                    {
                        Eval.ScaleFactor.WeakPawnCount = Glob.OwnPawnCount;
                    }
                    If (Eval.ScaleFactor.StrongSide == 1)
                    {
                        Eval.ScaleFactor.WeakKingIdx = Glob.OppKingIdx;
                    }
                    Else
                    {
                        Eval.ScaleFactor.WeakKingIdx = Glob.OwnKingIdx;
                    }
                    Eval.ScaleFactor.QueensidePawnCount = 0;
                    Eval.ScaleFactor.KingsidePawnCount = 0;
                    Eval.ScaleFactor.File = 1;
                    Repeat (4)
                    {
                        Eval.ScaleFactor.QueensidePawnCount += PawnCount[(Eval.ScaleFactor.File + (8 * (Not ((Eval.ScaleFactor.StrongSide == 1)))))];
                        Eval.ScaleFactor.KingsidePawnCount += PawnCount[((Eval.ScaleFactor.File + 4) + (8 * (Not ((Eval.ScaleFactor.StrongSide == 1)))))];
                        Eval.ScaleFactor.File += 1;
                    }
                    Eval.ScaleFactor.KingPawn = 0;
                    Eval.ScaleFactor.PawnListIdx = 1;
                    Repeat (List.Length(EvalPiecesIdx_Pawns))
                    {
                        If (((Board[EvalPiecesIdx_Pawns[Eval.ScaleFactor.PawnListIdx]] * Eval.ScaleFactor.StrongSide) == (0 - GoK_OwnPawn)) And (ChebyshevDistance[((EvalPiecesIdx_Pawns[Eval.ScaleFactor.PawnListIdx] * 100) + Eval.ScaleFactor.WeakKingIdx)] == 1))
                        {
                            Eval.ScaleFactor.KingPawn = 1;
                        }
                        Eval.ScaleFactor.PawnListIdx += 1;
                    }
                    If (((((Glob.OwnRookCount == 1) And (Glob.OwnNonQueenMajorMinorCount == 1)) And (Glob.OwnQueenCount == 0)) And (((Glob.OppRookCount == 1) And (Glob.OppNonQueenMajorMinorCount == 1)) And (Glob.OppQueenCount == 0))) And ((Not (((Eval.ScaleFactor.StrongPawnCount - Eval.ScaleFactor.WeakPawnCount) > 1))) And ((Not (((Eval.ScaleFactor.QueensidePawnCount > 0) == (Eval.ScaleFactor.KingsidePawnCount > 0)))) And (Eval.ScaleFactor.KingPawn == 1))))
                    {
                        Eval.ScaleFactor.Value = 36;
                    }
                    Else
                    {
                        If ((Glob.OwnQueenCount + Glob.OppQueenCount) == 1)
                        {
                            If (Glob.OwnQueenCount == 1)
                            {
                                Eval.ScaleFactor.Value = (37 + (3 * (Glob.OppNonQueenMajorMinorCount - Glob.OppRookCount)));
                            }
                            Else
                            {
                                Eval.ScaleFactor.Value = (37 + (3 * (Glob.OwnNonQueenMajorMinorCount - Glob.OwnRookCount)));
                            }
                        }
                        Else
                        {
                            Eval.ScaleFactor.Value = (36 + (7 * Eval.ScaleFactor.StrongPawnCount));
                            If (Eval.ScaleFactor.Value > 64)
                            {
                                Eval.ScaleFactor.Value = 64;
                            }
                            Eval.ScaleFactor.Value += (-4 * (Eval.Winnable.PawnsOnBothFlanks == 0));
                        }
                    }
                    Eval.ScaleFactor.Value += (-4 * (Eval.Winnable.PawnsOnBothFlanks == 0));
                }
                Ret.Evaluate.Score += Operator.Round(((((Glob.EvalEgTotal + Eval.Winnable.EgAdjust) * (128 - Glob.TaperedEvalPhase)) * ((2 * Eval.ScaleFactor.Value) - 128)) / 16384));
                If (Glob.EvalDebugLog == 1)
                {
                    Call Log("Eval.ScaleFactor = ")(Eval.ScaleFactor.Value)("")("")("")("")("")("");
                }
            }
        }
        Ret.Evaluate.Score = (((Ret.Evaluate.Score > 0) - (Ret.Evaluate.Score < 0)) * floor(abs(Ret.Evaluate.Score)));
        If (Glob.EvalDebugLog == 1)
        {
            Call Log("Eval.Total= ")(Ret.Evaluate.Score)("")("")("")("")("")("");
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_MethodExit(Ply);
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
    }
}

Define EvaluateBoard (warp=true)
{
    Call TaperedEval.Init;
    Ret.EvaluateBoard.Score = 0;
    Eval.Board.SqIdx = 1;
    Repeat (64)
    {
        Eval.Board.CurrentPiece = (Board[Eval.Board.SqIdx] + 0);
        If (Not ((Eval.Board.CurrentPiece == 0)))
        {
            Ret.EvaluateBoard.Score += Eval.Board.CurrentPiece;
            Call TaperedEval.GetPiecePos(Eval.Board.CurrentPiece)(Eval.Board.SqIdx);
            Ret.EvaluateBoard.Score += Ret.TaperedEval.GetPiecePos.Score;
        }
        Eval.Board.SqIdx += 1;
    }
    Call TaperedEval.Add(0)((41 * Glob.OwnPawnCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-41 * Glob.OppPawnCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((36 * ((Glob.OwnNonQueenMajorMinorCount - Glob.OwnBishopCount) - Glob.OwnRookCount)))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-36 * ((Glob.OppNonQueenMajorMinorCount - Glob.OppBishopCount) - Glob.OppRookCount)))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((45 * Glob.OwnBishopCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-45 * Glob.OppBishopCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((52 * Glob.OwnRookCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-52 * Glob.OppRookCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((72 * Glob.OwnQueenCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-72 * Glob.OppQueenCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.GetSum;
    Ret.EvaluateBoard.Score += Ret.TaperedEval.GetSum.Score;
    Glob.EvalMgTotal += Ret.EvaluateBoard.Score;
    Glob.EvalEgTotal += Ret.EvaluateBoard.Score;
}

Define EvaluateMajorsMinors(string Ply) (warp=true)
{
    Call //("Tapered evaluation, interpolating between midgame and game");
    Call EvaluateMajorsMinorsImpl(Ply);
    Ret.EvaluateMajorsMinors.Score = Ret.EvaluateMajorsMinorsImpl.Score;
}

Define EvaluateMajorsMinorsImpl(string Ply) (warp=true)
{
    Ret.EvaluateMajorsMinorsImpl.Score = 0;
    Call TaperedEval.Init;
    EvalMM.EvalPieceIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_NonPawns))
    {
        EvalMM.PieceSqIdx = (EvalPiecesIdx_NonPawns[EvalMM.EvalPieceIdx] + 0);
        EvalMM.Piece = (Board[(EvalMM.PieceSqIdx + 0)] + 0);
        EvalMM.Factor = (((EvalMM.Piece > 0) * 2) - 1);
        EvalMM.Side = (2 - (EvalMM.Piece > 0));
        EvalMM.PieceAbs = abs(EvalMM.Piece);
        If (EvalMM.Piece > 0)
        {
            EvalMM.KingIdx = Glob.OwnKingIdx;
        }
        Else
        {
            EvalMM.KingIdx = Glob.OppKingIdx;
        }
        If (Glob.IsExtendedEval == 1)
        {
            EvalMM.MobilityIdx = ((PieceMobility[(EvalMM.PieceSqIdx + 0)] * 2) + 1);
            If (EvalMM.PieceAbs == GoK_OwnRook)
            {
                Call TaperedEval.Add((RookMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((RookMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
            }
            Else
            {
                If (EvalMM.PieceAbs == GoK_OwnBishop)
                {
                    Call TaperedEval.Add((BishopMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((BishopMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                }
                Else
                {
                    If (EvalMM.PieceAbs == GoK_OwnKnight)
                    {
                        Call TaperedEval.Add((KnightMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((KnightMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                    }
                    Else
                    {
                        If (EvalMM.PieceAbs == GoK_OwnQueen)
                        {
                            Call TaperedEval.Add((QueenMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((QueenMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                        }
                    }
                }
            }
        }
        If ((EvalMM.PieceAbs == GoK_OwnKnight) Or (EvalMM.PieceAbs == GoK_OwnBishop))
        {
            EvalMM.Rank = (IdxToRank[(EvalMM.PieceSqIdx + 0)] + 0);
            EvalMM.File = (IdxToFile[(EvalMM.PieceSqIdx + 0)] + 0);
            If (Glob.IsExtendedEval == 1)
            {
                EvalMM.OP.KnightStepIdx = 0;
                EvalMM.OP.OnOutpost = 0;
                EvalMM.OP.IsOutpostReachable = 0;
                Repeat ((1 + (8 * (EvalMM.PieceAbs == GoK_OwnKnight))))
                {
                    If (EvalMM.OP.KnightStepIdx == 0)
                    {
                        EvalMM.OP.SquareFile = EvalMM.File;
                        EvalMM.OP.SquareRank = EvalMM.Rank;
                    }
                    Else
                    {
                        EvalMM.OP.SquareFile = (EvalMM.File + KnightFileDelta[EvalMM.OP.KnightStepIdx]);
                        EvalMM.OP.SquareRank = (EvalMM.Rank + KnightRankDelta[EvalMM.OP.KnightStepIdx]);
                    }
                    EvalMM.OP.IsOnBoard = (((EvalMM.OP.SquareFile > 0) And (EvalMM.OP.SquareFile < 9)) And ((EvalMM.OP.SquareRank > 0) And (EvalMM.OP.SquareRank < 9)));
                    EvalMM.OP.SquareIdx = (((EvalMM.OP.SquareRank - 1) * 8) + EvalMM.OP.SquareFile);
                    EvalMM.OP.IsOutpost = 0;
                    If ((EvalMM.OP.IsOnBoard == 1) And ((EvalMM.OP.SquareRank > (2 + (EvalMM.Factor > 0))) And (EvalMM.OP.SquareRank < (6 + (EvalMM.Factor > 0)))))
                    {
                        If (((((EvalMM.OP.SquareFile > 1) And ((((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + -1) > 0) And (((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + -1) < 65))) And (Board[((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + -1)] == (GoK_OwnPawn * EvalMM.Factor))) Or (((EvalMM.OP.SquareFile < 8) And ((((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + 1) > 0) And (((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + 1) < 65))) And (Board[((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + 1)] == (GoK_OwnPawn * EvalMM.Factor)))) Or ((((EvalMM.OP.SquareIdx + (8 * EvalMM.Factor)) > 0) And ((EvalMM.OP.SquareIdx + (8 * EvalMM.Factor)) < 65)) And (abs(Board[(EvalMM.OP.SquareIdx + (8 * EvalMM.Factor))]) == GoK_OwnPawn)))
                        {
                            EvalMM.OP.IsPawnAttackable = 0;
                            EvalMM.OP.PawnListIdx = 1;
                            Repeat (List.Length(EvalPiecesIdx_Pawns))
                            {
                                EvalMM.OP.PawnIdx = (EvalPiecesIdx_Pawns[EvalMM.OP.PawnListIdx] + 0);
                                If ((EvalMM.OP.IsPawnAttackable == 0) And (Board[EvalMM.OP.PawnIdx] == (GoK_OppPawn * EvalMM.Factor)))
                                {
                                    EvalMM.OP.RankDelta = ((IdxToRank[EvalMM.OP.PawnIdx] - EvalMM.OP.SquareRank) * EvalMM.Factor);
                                    If ((abs((IdxToFile[EvalMM.OP.PawnIdx] - EvalMM.OP.SquareFile)) == 1) And (EvalMM.OP.RankDelta > 0))
                                    {
                                        If (EvalMM.OP.RankDelta == 1)
                                        {
                                            EvalMM.OP.IsPawnAttackable = 1;
                                        }
                                        Else
                                        {
                                            EvalMM.OP.Blocked = (Board[(EvalMM.OP.PawnIdx - (8 * EvalMM.Factor))] == (GoK_OwnPawn * EvalMM.Factor));
                                            EvalMM.OP.Lever = ((((IdxToFile[EvalMM.OP.PawnIdx] > 1) And (((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + -1) > 0) And ((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + -1) < 65))) And (Board[(((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + -1)] == (GoK_OwnPawn * EvalMM.Factor))) Or (((IdxToFile[EvalMM.OP.PawnIdx] < 8) And (((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + 1) > 0) And ((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + 1) < 65))) And (Board[(((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + 1)] == (GoK_OwnPawn * EvalMM.Factor))));
                                            EvalMM.OP.Supported = 0;
                                            EvalMM.OP.NeighbourListIdx = 1;
                                            Repeat (List.Length(EvalPiecesIdx_Pawns))
                                            {
                                                EvalMM.OP.NeighbourIdx = (EvalPiecesIdx_Pawns[EvalMM.OP.NeighbourListIdx] + 0);
                                                If (((Board[EvalMM.OP.NeighbourIdx] == (GoK_OppPawn * EvalMM.Factor)) And (abs((IdxToFile[EvalMM.OP.NeighbourIdx] - IdxToFile[EvalMM.OP.PawnIdx])) == 1)) And (Not ((((IdxToRank[EvalMM.OP.NeighbourIdx] - IdxToRank[EvalMM.OP.PawnIdx]) * EvalMM.Factor) < 0))))
                                                {
                                                    EvalMM.OP.Supported = 1;
                                                }
                                                EvalMM.OP.NeighbourListIdx += 1;
                                            }
                                            If ((EvalMM.OP.Blocked == 0) And (Not (((EvalMM.OP.Supported == 0) And ((EvalMM.OP.Lever == 1) Or (EvalMM.OP.Blocked == 1))))))
                                            {
                                                EvalMM.OP.IsPawnAttackable = 1;
