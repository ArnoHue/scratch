Define EvaluateThreats(string Ply) (warp=true)
{
    Call EvaluateThreatsImpl(Ply);
    Ret.EvaluateThreats.Score = Ret.EvaluateThreatsImpl.Score;
}

Define EvaluateThreatsImpl(string Ply) (warp=true)
{
    Call TaperedEval.Init;
    Ret.EvaluateThreatsImpl.Score = 0;
    EvalT.OwnKingThreat = 0;
    EvalT.OppKingThreat = 0;
    If (Glob.IsExtendedEval == 1)
    {
        EvalT.MobilityEval = 0;
        EvalT.EvalPieceIdx = 1;
        Repeat (List.Length(EvalPiecesIdx_NonPawns))
        {
            EvalT.SqIdx = (EvalPiecesIdx_NonPawns[EvalT.EvalPieceIdx] + 0);
            EvalT.Piece = (Board[(EvalT.SqIdx + 0)] + 0);
            EvalT.PieceAbs = abs(EvalT.Piece);
            If (Not ((EvalT.PieceAbs == GoK_OwnKing)))
            {
                EvalT.Factor = (((EvalT.Piece > 0) * 2) - 1);
                EvalT.MobilityIdx = ((PieceMobility[(EvalT.SqIdx + 0)] * 2) + 1);
                If (EvalT.PieceAbs == GoK_OwnRook)
                {
                    EvalT.MobilityEval += (RookMobilityBonus[(EvalT.MobilityIdx + 0)] * EvalT.Factor);
                }
                Else
                {
                    If (EvalT.PieceAbs == GoK_OwnBishop)
                    {
                        EvalT.MobilityEval += (BishopMobilityBonus[(EvalT.MobilityIdx + 0)] * EvalT.Factor);
                    }
                    Else
                    {
                        If (EvalT.PieceAbs == GoK_OwnKnight)
                        {
                            EvalT.MobilityEval += (KnightMobilityBonus[(EvalT.MobilityIdx + 0)] * EvalT.Factor);
                        }
                        Else
                        {
                            If (EvalT.PieceAbs == GoK_OwnQueen)
                            {
                                EvalT.MobilityEval += (QueenMobilityBonus[(EvalT.MobilityIdx + 0)] * EvalT.Factor);
                            }
                        }
                    }
                }
            }
            EvalT.EvalPieceIdx += 1;
        }
        If (Glob.EvalDebugLog == 1)
        {
            Call LogPVEvalLine("Eval.Threats.Mobility.Total")(EvalT.MobilityEval)("")("")("")("");
        }
        EvalT.EvalPieceIdx = 1;
        Repeat (List.Length(EvalPiecesIdx_All))
        {
            EvalT.SqIdx = (EvalPiecesIdx_All[EvalT.EvalPieceIdx] + 0);
            EvalT.Piece = (Board[(EvalT.SqIdx + 0)] + 0);
            EvalT.Factor = (((EvalT.Piece > 0) * 2) - 1);
            EvalT.PieceAbs = abs(EvalT.Piece);
            If (EvalT.PieceAbs > GoK_OwnPawn)
            {
                Glob.SafePawnPushCredited = 0;
                EvalT.File = (IdxToFile[(EvalT.SqIdx + 0)] + 0);
                EvalT.Rank = (IdxToRank[(EvalT.SqIdx + 0)] + 0);
                If (((EvalT.Factor > 0) And (EvalT.File > 1)) Or ((EvalT.Factor < 0) And (EvalT.File < 8)))
                {
                    EvalT.MobilityIdx = (EvalT.SqIdx + (15 * EvalT.Factor));
                    If (((EvalT.MobilityIdx > 8) And (EvalT.MobilityIdx < 57)) And (Board[(EvalT.MobilityIdx + 0)] == (GoK_OppPawn * EvalT.Factor)))
                    {
                        Call FindAndAddSafePawnPush(EvalT.MobilityIdx)((EvalT.SqIdx + (7 * EvalT.Factor)))(EvalT.Piece)(EvalT.Factor);
                    }
                    If (((EvalT.Rank == 4) And (EvalT.Piece > 0)) Or ((EvalT.Rank == 5) And (EvalT.Piece < 0)))
                    {
                        EvalT.StartRank = (2 + (5 * (EvalT.Piece > 0)));
                        EvalT.MobilityIdx = (EvalT.SqIdx + (23 * EvalT.Factor));
                        If (((EvalT.MobilityIdx > 8) And (EvalT.MobilityIdx < 57)) And ((IdxToRank[(EvalT.MobilityIdx + 0)] == EvalT.StartRank) And (Board[(EvalT.MobilityIdx + 0)] == (GoK_OppPawn * EvalT.Factor))))
                        {
                            Call FindAndAddSafePawnPush(EvalT.MobilityIdx)((EvalT.SqIdx + (7 * EvalT.Factor)))(EvalT.Piece)(EvalT.Factor);
                        }
                    }
                }
                If (((EvalT.Factor > 0) And (EvalT.File < 8)) Or ((EvalT.Factor < 0) And (EvalT.File > 1)))
                {
                    EvalT.MobilityIdx = (EvalT.SqIdx + (17 * EvalT.Factor));
                    If (((EvalT.MobilityIdx > 8) And (EvalT.MobilityIdx < 57)) And (Board[(EvalT.MobilityIdx + 0)] == (GoK_OppPawn * EvalT.Factor)))
                    {
                        Call FindAndAddSafePawnPush(EvalT.MobilityIdx)((EvalT.SqIdx + (9 * EvalT.Factor)))(EvalT.Piece)(EvalT.Factor);
                    }
                    If (((EvalT.Rank == 4) And (EvalT.Piece > 0)) Or ((EvalT.Rank == 5) And (EvalT.Piece < 0)))
                    {
                        EvalT.StartRank = (2 + (5 * (EvalT.Piece > 0)));
                        EvalT.MobilityIdx = (EvalT.SqIdx + (25 * EvalT.Factor));
                        If (((EvalT.MobilityIdx > 8) And (EvalT.MobilityIdx < 57)) And ((IdxToRank[(EvalT.MobilityIdx + 0)] == EvalT.StartRank) And (Board[(EvalT.MobilityIdx + 0)] == (GoK_OppPawn * EvalT.Factor))))
                        {
                            Call FindAndAddSafePawnPush(EvalT.MobilityIdx)((EvalT.SqIdx + (9 * EvalT.Factor)))(EvalT.Piece)(EvalT.Factor);
                        }
                    }
                }
            }
            If (EvalT.Piece > 0)
            {
                EvalT.Attacked = (BoardAttacked[((EvalT.SqIdx + 0) + 64)] + 0);
            }
            Else
            {
                EvalT.Attacked = (BoardAttacked[(EvalT.SqIdx + 0)] + 0);
            }
            If (EvalT.Attacked > 0)
            {
                Call PopulateAttackInfo(EvalT.SqIdx);
                EvalT.Attacked = Ret.PopulateAttackInfo.Attacked;
                EvalT.Defended = Ret.PopulateAttackInfo.Defended;
                EvalT.AttackerIdx = Ret.PopulateAttackInfo.AttackerIdx;
                EvalT.AttackerPieceAbs = Ret.PopulateAttackInfo.AttackerPieceAbs;
                EvalT.DefenderPieceAbs = Ret.PopulateAttackInfo.DefenderPieceAbs;
                EvalT.StronglyProtectedCurrentPiece = ((EvalT.DefenderPieceAbs == GoK_OwnPawn) Or ((EvalT.Defended > 1) And (EvalT.Attacked < 2)));
                EvalT.StronglyProtectedCurrentPieceNonPawn = ((EvalT.PieceAbs > GoK_OwnPawn) And (EvalT.StronglyProtectedCurrentPiece == 1));
                EvalT.IsWeakCurrentPiece = ((EvalT.Attacked > 0) And (EvalT.StronglyProtectedCurrentPiece == 0));
                If (EvalT.Piece > 0)
                {
                    EvalT.SafeAttacker = ((BoardAttacked[(EvalT.AttackerIdx + 0)] == 0) Or (BoardAttacked[((EvalT.AttackerIdx + 0) + 64)] > 0));
                }
