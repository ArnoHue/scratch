        }
    }
}

Define IsQuiescentCheckCond(string Ply) (warp=true)
{
    Call //("Quiescence search extension for checking moves, esp. check sequences. Return value defined whether check sequences should pursued at this point");
    Ret.IsQuiescentCheckCond.IsTrue = 0;
    If (1 == 0)
    {
        If (Glob.IsScratch3 == 0)
        {
            If ((Quiescence[Ply] == 1) And (Quiescence[(Ply - 1)] == 0))
            {
                Ret.IsQuiescentCheckCond.IsTrue = 1;
            }
        }
    }
}

Define IsQuietMove(string Move) (warp=true)
{
    Ret.IsQuietMove.IsQuiet = 0;
    IQM.FromIdx = floor((Move / 100));
    IQM.ToIdx = floor((Move % 100));
    If (IQM.FromIdx == 0)
    {
        Ret.IsQuietMove.IsQuiet = 1;
        Stop(this script);
    }
    If (Not ((Board[IQM.ToIdx] == 0)))
    {
        Stop(this script);
    }
    If (Not ((Move == floor(Move))))
    {
        Stop(this script);
    }
    If (abs(Board[IQM.FromIdx]) == GoK_OwnPawn)
    {
        If (Not ((IdxToFile[IQM.FromIdx] == IdxToFile[IQM.ToIdx])))
        {
            Stop(this script);
        }
    }
    Ret.IsQuietMove.IsQuiet = 1;
}

Define IsReachableForAttack(string Piece)(string FromIdx)(string ToIdx) (warp=true)
{
    Ret.IsReachableForAttack.IsReachable = 0;
    IRFA.PieceAbs = abs(Piece);
    IRFA.LegalMoveKey = ((PieceIdxLookup[IRFA.PieceAbs] * 10000) + ((FromIdx * 100) + ToIdx));
    If (Piece < 0)
    {
        IRFA.LegalMoveKey += Const.MovePosLookupOppBaseIdx;
    }
    If (MovePosLookupLegal[IRFA.LegalMoveKey] == 0)
    {
        Stop(this script);
    }
    If (IRFA.PieceAbs == GoK_OwnPawn)
    {
        If (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))
        {
            Ret.IsReachableForAttack.IsReachable = 1;
        }
        Stop(this script);
    }
    If ((IRFA.PieceAbs == GoK_OwnKnight) Or (IRFA.PieceAbs == GoK_OwnKing))
    {
        Ret.IsReachableForAttack.IsReachable = 1;
        Stop(this script);
    }
    IRFA.Idx = ((FromIdx * 100) + ToIdx);
    IRFA.SourceIdx = FromIdx;
    Repeat ((MovePathDelta[IRFA.Idx] - 1))
    {
        IRFA.SourceIdx += MovePathStepInc[IRFA.Idx];
        If (Not ((Board[IRFA.SourceIdx] == 0)))
        {
            Stop(this script);
        }
    }
    Ret.IsReachableForAttack.IsReachable = 1;
}

Define KingSafeChecks(string Side)(string TargetIdx)(string FoundMask)(string AttackerCount)(string DefenderCount)(string DefenderPieceAbs) (warp=true)
{
    KSC.Mask = FoundMask;
    KSC.RookFired = 0;
    KSC.QueenFired = 0;
    KSC.OrderIdx = 0;
    Repeat (4)
    {
        KSC.OrderIdx += 1;
        KSC.PieceAbs = (SafeCheckPieceOrder[KSC.OrderIdx] + 0);
        KSC.PieceIdx = PieceIdxLookup[KSC.PieceAbs];
        If (Not ((((KSC.PieceAbs == GoK_OwnQueen) And (KSC.RookFired == 1)) Or ((KSC.PieceAbs == GoK_OwnBishop) And (KSC.QueenFired == 1)))))
        {
            KSC.SafeCheckWeight = (AttackTypeMaskWeights[(KSC.PieceIdx - 1)] + 0);
            KSC.AttackWeight = (AttackTypeMaskWeights[KSC.PieceIdx] + 0);
            If ((floor((KSC.Mask / KSC.AttackWeight)) - (10 * floor((KSC.Mask / (KSC.AttackWeight * 10))))) > 0)
            {
                If (Side == 1)
                {
                    KSC.KingIdx = Glob.OwnKingIdx;
                }
                Else
                {
                    KSC.KingIdx = Glob.OppKingIdx;
                }
                KSC.IsSlider = (KSC.PieceAbs > GoK_OwnKnight);
                KSC.IsUnsafe = (KSC.PieceAbs < GoK_OwnQueen);
                KSC.Move = ((TargetIdx * 100) + KSC.KingIdx);
                KSC.LegalMoveKey = ((KSC.PieceIdx * 10000) + KSC.Move);
                If (MovePosLookupLegal[(KSC.LegalMoveKey + (Const.MovePosLookupOppBaseIdx * (Side == 1)))] == 1)
                {
                    KSC.TargetPiece = (Board[(TargetIdx + 0)] + 0);
                    KSC.AttackerOccupied = 1;
                    If (((Side == 1) And (Not ((KSC.TargetPiece < 0)))) Or ((Side == 2) And (Not ((KSC.TargetPiece > 0)))))
                    {
                        KSC.AttackerOccupied = 0;
                    }
                    KSC.Found = 1;
                    If (KSC.IsSlider == 1)
                    {
                        KSC.SourceIdx = TargetIdx;
                        KSC.RayStep = MovePathStepInc[KSC.Move];
                        Repeat Until ((KSC.Found == 0) Or ((KSC.SourceIdx + KSC.RayStep) == KSC.KingIdx))
                        {
                            KSC.SourceIdx += KSC.RayStep;
                            If (Not ((Board[KSC.SourceIdx] == 0)))
                            {
                                If (Not ((((Side == 1) And (Board[KSC.SourceIdx] == GoK_OwnQueen)) Or ((Side == 2) And (Board[KSC.SourceIdx] == GoK_OppQueen)))))
                                {
                                    KSC.Found = 0;
                                }
                            }
                        }
                    }
                    If (KSC.Found == 1)
                    {
                        KSC.IsWeak = ((DefenderCount == 0) Or ((DefenderCount < 2) And (DefenderPieceAbs > GoK_OwnRook)));
                        If ((((DefenderCount == 0) Or ((KSC.IsWeak == 1) And (AttackerCount > 1))) And (Not (((KSC.PieceAbs == GoK_OwnQueen) And (DefenderPieceAbs == GoK_OwnQueen))))) And (KSC.AttackerOccupied == 0))
                        {
                            List.ReplaceItem(KingAttackSafeChecks, (Side + 0), (KingAttackSafeChecks[(Side + 0)] + KSC.SafeCheckWeight));
                            If (KSC.PieceAbs == GoK_OwnRook)
                            {
                                KSC.RookFired = 1;
                            }
                            If (KSC.PieceAbs == GoK_OwnQueen)
                            {
                                KSC.QueenFired = 1;
                            }
                        }
                        Else
                        {
                            If (KSC.IsUnsafe == 1)
                            {
                                List.Add(KingUnsafeCheckSquares, ((TargetIdx * 10) + KSC.PieceIdx));
                            }
                        }
                    }
                }
            }
        }
    }
}

Define LoadInternalBoard (warp=true)
{
    LoadInternalBoard.SqIdx = 1;
    Repeat (64)
    {
        If (Glob.IsPlayerBlack == 1)
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, (0 - GoK_Board[RankFlipIdx[LoadInternalBoard.SqIdx]]));
        }
        Else
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, GoK_Board[LoadInternalBoard.SqIdx]);
        }
        LoadInternalBoard.SqIdx += 1;
    }
}

Define LoadList(string Data)(string ListName) (warp=true)
