Define Log(string Txt1)(string Txt2)(string Txt3)(string Txt4)(string Txt5)(string Txt6)(string Txt7)(string Txt8) (warp=true)
{
    If (Glob.IsTestRunning == 1)
    {
        Stop(this script);
    }
    Log.ElapsedSec = (floor((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * 1000)) / 1000);
    If Operator.Contains(Log.ElapsedSec, ".")
    {
        If ((Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 1)) == ".") Or (Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 2)) == "."))
        {
            Log.ElapsedSec = Operator.Join(Log.ElapsedSec, 0);
        }
    }
    Else
    {
        Log.ElapsedSec = Operator.Join(Log.ElapsedSec, .000);
    }
    List.Add(Logfile, Operator.Join(Operator.Join(Log.ElapsedSec, ": "), Operator.Join(Txt1, Operator.Join(Txt2, Operator.Join(Txt3, Operator.Join(Txt4, Operator.Join(Txt5, Operator.Join(Txt6, Operator.Join(Txt7, Txt8)))))))));
}

Define LogEval (warp=true)
{
    Call CalcBoardStats;
    List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    Call ClearMoveList(1);
    Call AddMoveToList(0)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1);
    Call ClearMoveList(2);
    Call AddMoveToList(0)(2)(0);
    List.ReplaceItem(MovesIdx, 2, 1);
    Call ApplyMove(2);
    Call Log("========================================")("")("")("")("")("")("")("");
    Call LogEvalImpl(2)((1 == 1));
    Call Log("========================================")("")("")("")("")("")("")("");
    Call RevertMove(2);
    Call RevertMove(1);
}

Define LogEvalImpl(string Ply)(bool IsPlayerTurn) (warp=true)
{
    Call Log("Evaluation Analysis")("")("")("")("")("")("")("");
    Call ExportBoardFEN((Glob.IsPlayerBlack == 1))(IsPlayerTurn);
    Log.EvalI.FENLichess = Ret.ExportBoardFEN.FENLichess;
    Call Log(Ret.ExportBoardFEN.FEN)("")("")("")("")("")("")("");
    Call Log(Log.EvalI.FENLichess)("")("")("")("")("")("")("");
    Call Log("----------------------------------------")("")("")("")("")("")("")("");
    Call Log("    a   b   c   d   e   f   g   h")("")("")("")("")("")("")("");
    Call Log("  +---+---+---+---+---+---+---+---+")("")("")("")("")("")("")("");
    Log.EvalI.Rank = 8;
    Repeat (8)
    {
        Log.EvalI.ExportDataBoard = Operator.Join(Log.EvalI.Rank, " |");
        Log.EvalI.File = 1;
        Repeat (8)
        {
            Log.EvalI.SqIdx = ((((9 - Log.EvalI.Rank) - 1) * 8) + Log.EvalI.File);
            If (Glob.IsPlayerBlack == 1)
            {
                Log.EvalI.Piece = (0 - Board[(65 - Log.EvalI.SqIdx)]);
            }
            Else
            {
                Log.EvalI.Piece = Board[Log.EvalI.SqIdx];
            }
            Log.EvalI.PieceChar = " ";
            If (Log.EvalI.Piece == GoK_OwnPawn)
            {
                Log.EvalI.PieceChar = "p";
            }
            If (Log.EvalI.Piece == GoK_OwnKnight)
            {
                Log.EvalI.PieceChar = "n";
            }
            If (Log.EvalI.Piece == GoK_OwnBishop)
            {
                Log.EvalI.PieceChar = "b";
            }
            If (Log.EvalI.Piece == GoK_OwnRook)
            {
                Log.EvalI.PieceChar = "r";
            }
            If (Log.EvalI.Piece == GoK_OwnQueen)
            {
                Log.EvalI.PieceChar = "q";
            }
            If (Log.EvalI.Piece == GoK_OwnKing)
            {
                Log.EvalI.PieceChar = "k";
            }
            If (Log.EvalI.Piece == GoK_OppPawn)
            {
                Log.EvalI.PieceChar = "P";
            }
            If (Log.EvalI.Piece == GoK_OppKnight)
            {
                Log.EvalI.PieceChar = "N";
            }
            If (Log.EvalI.Piece == GoK_OppBishop)
            {
                Log.EvalI.PieceChar = "B";
            }
            If (Log.EvalI.Piece == GoK_OppRook)
            {
                Log.EvalI.PieceChar = "R";
            }
            If (Log.EvalI.Piece == GoK_OppQueen)
            {
                Log.EvalI.PieceChar = "Q";
            }
            If (Log.EvalI.Piece == GoK_OppKing)
            {
                Log.EvalI.PieceChar = "K";
            }
            Log.EvalI.ExportDataBoard = Operator.Join(Operator.Join(Operator.Join(Log.EvalI.ExportDataBoard, " "), Log.EvalI.PieceChar), " |");
            Log.EvalI.File += 1;
        }
        Call Log(Log.EvalI.ExportDataBoard)("")("")("")("")("")("")("");
        Call Log("  +---+---+---+---+---+---+---+---+")("")("")("")("")("")("")("");
        Log.EvalI.Rank += -1;
    }
    Call Log("----------------------------------------")("")("")("")("")("")("")("");
    Call TaperedEval.Init;
    Call Log("Eval.TaperedEval.ScaleFacor")(" = ")(TaperedEval.ScaleFactor)("")("")("")("")("");
    Call Log("Eval.TaperedEval.Phase")(" = ")(TaperedEval.Phase)("")("")("")("")("");
    Call Log("----------------------------------------")("")("")("")("")("")("")("");
    Eval.DebugLog = 1;
    Call Evaluate(Ply)((1 == 1));
    Eval.DebugLog = 0;
}

Define LogPVEval (warp=true)
{
    If (List.Length(PVStable) > 1)
    {
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log("PV Leaf Evaluation Analysis")("")("")("")("")("")("")("");
        Call ExportBoardFEN((Glob.IsPlayerBlack == 1))((1 == 0));
        Call Log("PV: ")("[FEN "")(Ret.ExportBoardFEN.FEN)(""] ")(Glob.PV)("")("")("");
        Call Log("----------------------------------------")("")("")("")("")("")("")("");
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
        Log.PVE.Idx = 1;
        Repeat (List.Length(PVStable))
        {
            Call ClearMoveList(Log.PVE.Idx);
            Call AddMoveToList(PVStable[Log.PVE.Idx])(Log.PVE.Idx)(0);
            List.ReplaceItem(MovesIdx, Log.PVE.Idx, 1);
            Call ApplyMove(Log.PVE.Idx);
            Log.PVE.Idx += 1;
        }
        Call LogEvalImpl(List.Length(PVStable))((1 == 0));
        Call Log("========================================")("")("")("")("")("")("")("");
        Log.PVE.Idx = List.Length(PVStable);
        Repeat (List.Length(PVStable))
        {
            Call RevertMove(Log.PVE.Idx);
            Log.PVE.Idx += -1;
        }
    }
}

Define LogPVEvalLine(string Key)(string Val1)(string Val2)(string SquareIdx)(string Side)(string Move) (warp=true)
{
    If (Eval.DebugLog == 1)
    {
        If ((Variable.Length(Key) > 0) And (Variable.Length(Val1) > 0))
        {
            Log.PVEL.ValuesStr = Operator.Join("(", Val1);
            If (Variable.Length(Val2) > 0)
            {
                Log.PVEL.ValuesStr = Operator.Join(Operator.Join(Log.PVEL.ValuesStr, ", "), Val2);
            }
            Log.PVEL.ValuesStr = Operator.Join(Log.PVEL.ValuesStr, ")");
            Log.PVEL.SquareStr = "[ ]";
            If (Variable.Length(SquareIdx) > 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    Log.PVEL.SqIdx = (65 - SquareIdx);
                }
                Else
                {
                    Log.PVEL.SqIdx = SquareIdx;
                }
                Log.PVEL.SquareStr = Operator.Join(Operator.Join(" [", Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[Log.PVEL.SqIdx]), (9 - IdxToRank[Log.PVEL.SqIdx]))), "]");
            }
            Log.PVEL.SideStr = "[ ]";
            If (Side == 1)
            {
                Log.PVEL.SideStr = "[Engine]";
            }
            Else
            {
                If (Side == 2)
                {
                    Log.PVEL.SideStr = "[Player]";
                }
            }
            Log.PVEL.MoveStr = "[ ]";
            If (Variable.Length(Move) > 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    Log.PVEL.SourceIdx = (65 - floor((Move / 100)));
                    Log.PVEL.TargetIdx = (65 - floor((Move % 100)));
                }
                Else
                {
                    Log.PVEL.SourceIdx = floor((Move / 100));
                    Log.PVEL.TargetIdx = floor((Move % 100));
                }
                Log.PVEL.MoveStr = Operator.Join(Operator.Join(" [", Operator.Join(Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[Log.PVEL.SourceIdx]), (9 - IdxToRank[Log.PVEL.SourceIdx])), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[Log.PVEL.TargetIdx]), (9 - IdxToRank[Log.PVEL.TargetIdx])))), "]");
            }
            Call Log(Operator.Join(Key, " = "))(Log.PVEL.ValuesStr)(" ")(Log.PVEL.SquareStr)(" ")(Log.PVEL.MoveStr)(" ")(Log.PVEL.SideStr);
        }
    }
}

Define OnBestMoveChanged(string Move) (warp=true)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Move == GoK_OwnKingsideCastling)
    {
        Stg_BestMoveFromIdx = VirtualBoard[5];
        Stg_BestMoveToIdx = VirtualBoard[7];
    }
    Else
    {
        If (Move == GoK_OwnQueensideCastling)
        {
            Stg_BestMoveFromIdx = VirtualBoard[5];
            Stg_BestMoveToIdx = VirtualBoard[3];
        }
        Else
        {
            Stg_BestMoveFromIdx = floor((Move / 100));
            Stg_BestMoveToIdx = floor((Move % 100));
        }
    }
    Event.Broadcast("showbestmove");
}

Define OnEvaluationChanged(string Eval) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Glob.Level > 2)
    {
        If (Eval > 1000)
        {
            GoK_EvaluationValue = 100;
        }
        Else
        {
            If (Eval < -1000)
            {
                GoK_EvaluationValue = -100;
            }
            Else
            {
                GoK_EvaluationValue = (Eval / 10);
            }
        }
    }
    Else
    {
        GoK_EvaluationValue = 0;
    }
    Event.Broadcast("evaluationvaluechanged");
    Control.Wait(0);
}

Define OnProgressChanged(string Progress) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Progress < 100)
    {
        GoK_ProgressValue = Progress;
    }
    Else
    {
        GoK_ProgressValue = 100;
    }
    Event.Broadcast("progressvaluechanged");
    Control.Wait(0);
}

Define OnRestart (warp=true)
{
    Looks.Say("");
    List.DeleteAll(Logfile);
    List.Add(Logfile, Glob.VersionString);
    List.Hide(BoardHistory);
    List.Hide(GameMovesAN);
    List.Hide(ExportData);
    List.Hide(ExportMoves);
    List.Hide(Logfile);
    List.Hide(Profile_Data);
    Variable.Hide(Glob.IdxDeepening);
    Variable.Hide(GBM.Evaluation);
    Variable.Hide(GBM.Move);
    Variable.Hide(Glob.NPS);
    Variable.Hide(Glob.MPS);
    Variable.Hide(Glob.PV);
    Variable.Hide(Glob.CustomThinkTime);
    Glob.ProfilerMode = 1;
    Glob.DebugMode = 0;
    Glob.TimeControl = -1;
    Glob.IdxDeepening = "";
    GBM.Evaluation = "";
    Glob.NPS = "";
    Glob.MPS = "";
    Glob.CustomThinkTime = 0;
}

Define PadInto(string value)(string width)(bool rightJustify) (warp=true)
{
    Ret.PadInto.Padded = value;
    Repeat Until (Not ((Variable.Length(Ret.PadInto.Padded) < width)))
    {
        If rightJustify
        {
            Ret.PadInto.Padded = Operator.Join(" ", Ret.PadInto.Padded);
        }
        Else
        {
            Ret.PadInto.Padded = Operator.Join(Ret.PadInto.Padded, " ");
        }
    }
}

Define Perft(string PerftPly)(string PerftHorizon)(string PerftStaged) (warp=true)
{
    If (PerftHorizon == 0)
    {
        Glob.PerftNodes += 1;
        Stop(this script);
    }
    Call PerftPrepareNode(PerftPly)(PerftStaged);
    If (PerftStaged == 0)
    {
        List.ReplaceItem(MovesIdx, PerftPly, 1);
        Repeat (MovesCount[PerftPly])
        {
            Call ApplyMove(PerftPly);
            Call IsCheckedFast((PerftPly + 1));
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Call PerftValidateCheck(PerftPly);
                Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
            }
            Call RevertMove(PerftPly);
            List.ReplaceItem(MovesIdx, PerftPly, (MovesIdx[PerftPly] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, PerftPly, 1);
        List.ReplaceItem(PickMoveRes, PerftPly, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, PerftPly, 0);
        Repeat Until (PickMoveRes[PerftPly] == 0)
        {
            Call PickMove(PerftPly)((1 == 0));
            If (PickMoveRes[PerftPly] == 1)
            {
                Call IsCheckedFast((PerftPly + 1));
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Call PerftValidateCheck(PerftPly);
                    Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
                }
                Call RevertMove(PerftPly);
            }
        }
    }
}

Define PerftDivide(string PerftDivHorizon)(string PerftDivStaged) (warp=true)
{
    List.DeleteAll(PerftDivideOut);
    Call PerftPrepareNode(1)(PerftDivStaged);
    If (PerftDivStaged == 0)
    {
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            Call ApplyMove(1);
            Call IsCheckedFast(2);
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Glob.PerftNodes = 0;
                Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.PerftNodes));
            }
            Call RevertMove(1);
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, 1, 1);
        List.ReplaceItem(PickMoveRes, 1, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, 1, 0);
        Repeat Until (PickMoveRes[1] == 0)
        {
            Call PickMove(1)((1 == 0));
            If (PickMoveRes[1] == 1)
            {
                Call IsCheckedFast(2);
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Glob.PerftNodes = 0;
                    Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                    List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.PerftNodes));
                }
                Call RevertMove(1);
            }
        }
    }
}

Define PerftPrepareNode(string PerftPrepPly)(string PerftPrepStaged) (warp=true)
{
    If (PerftPrepPly == 1)
    {
        List.DeleteAll(PVStablePrev);
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
        Call SetInitialEnPassantTarget(1);
    }
    Else
    {
        List.ReplaceItem(CastlingState, PerftPrepPly, CastlingState[(PerftPrepPly - 1)]);
        List.ReplaceItem(EnPassantTarget, PerftPrepPly, EnPassantTarget[(PerftPrepPly - 1)]);
    }
    Call IsCheckedFast((PerftPrepPly + 1));
    List.ReplaceItem(CheckedState, PerftPrepPly, Ret.IsCheckedFast.IsChecked);
    List.ReplaceItem(BoardAttackedCalculated, PerftPrepPly, 0);
    Call PrepareCheckInfo(PerftPrepPly);
    If (PerftPrepStaged == 0)
    {
        Call CalcBoardAttackedOnDemand(PerftPrepPly)((1 == 0))((1 == 1))(99);
        Call GenerateMovesImplWrapper(PerftPrepPly)((1 == 0))((1 == 0));
    }
}

Define PerftValidateCheck(string ValPly) (warp=true)
{
    PVC.Source = floor((AppliedMove[ValPly] / 100));
    PVC.Target = floor((AppliedMove[ValPly] % 100));
    PVC.Fast = 0;
    Call IsCheckingPiece(PVC.Target);
    If (Ret.IsCheckingPiece.IsChecking == 1)
    {
        PVC.Fast = 1;
    }
    Call IsCheckingPieceDiscovery(PVC.Source)(PVC.Target)(ValPly);
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 1)
    {
        PVC.Fast = 1;
    }
    Call IsCheckedFast((ValPly + 2));
    PVC.Actual = Ret.IsCheckedFast.IsChecked;
    If (Not ((PVC.Fast == PVC.Actual)))
    {
        Glob.PerftCheckMismatches += 1;
        If (Glob.PerftCheckMismatches < 26)
        {
            PVC.Line = "";
            PVC.AppliedMoveIdx = 1;
            Repeat (ValPly)
            {
                PVC.Line = Operator.Join(PVC.Line, Operator.Join(AppliedMove[PVC.AppliedMoveIdx], " "));
                PVC.AppliedMoveIdx += 1;
            }
            Call TestLog("MISMATCH ply ")(ValPly)(" fast=")(PVC.Fast)(" actual=")(PVC.Actual)(" line: ")(PVC.Line);
        }
    }
}

Define PickMove(string Ply)(bool Quiescence) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_TimeByHorizon(512)(Ply)(-1);
    }
    Call Comment("Staged move-generator implementation");
    If (PickPhase[Ply] == 1)
    {
        Call Comment("Phase 1: Look up hash-move from transposition table");
        List.ReplaceItem(HashMove, Ply, Const.Null);
        List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
        List.ReplaceItem(MovesCount, Ply, 0);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(MovesIdxBestMove, Ply, 0);
        Call ClearMoveList(Ply);
        If ((Ply > 1) Or (1 == 1))
        {
            PM.Move = "";
            PM.Found = 0;
            If (Not ((Ply > List.Length(PVStablePrev))))
            {
                PM.Found = 1;
                PM.CalcMovesScoreListIdx = 1;
                PM.PVStablePrevIdx = 1;
                Repeat Until ((PM.CalcMovesScoreListIdx == Ply) Or (PM.Found == 0))
                {
                    If (Not ((AppliedMove[PM.CalcMovesScoreListIdx] == PVStablePrev[(PM.PVStablePrevIdx + 0)])))
                    {
                        PM.Found = 0;
                    }
                    PM.CalcMovesScoreListIdx += 1;
                    PM.PVStablePrevIdx += 1;
                }
                If (PM.Found == 1)
                {
                    Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                    If List.ContainsItem(CalcMovesMoveList, PVStablePrev[Ply])
                    {
                        PM.Move = PVStablePrev[Ply];
                    }
                }
            }
            If ((Ply > 1) Or (1 == 1))
            {
                PM.TTQSMeta = NodeTTQSMeta[Ply];
                PM.TTHorizon = NodeTTHorizon[Ply];
                PM.TTHit = NodeTTHit[Ply];
                PM.HashMove = NodeTTMove[Ply];
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.TTMoveProbe)(HorizonAtPly[Ply])(Ply);
                }
                If (PM.TTHit == 1)
                {
                    If ((PM.Move == "") And (Not ((PM.HashMove == Const.Null))))
                    {
                        Call IsQuiescentCheckCond(Ply);
                        If ((Not (Quiescence)) Or ((Quiescence And (PM.TTHorizon == -1)) And (Not ((PM.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue)))))
                        {
                            If (Not ((floor((PM.HashMove / 100)) == 0)))
                            {
                                PM.SourceIdx = floor((PM.HashMove / 100));
                                PM.TargetIdx = floor((PM.HashMove % 100));
                                PM.SourcePiece = Board[PM.SourceIdx];
                                PM.TargetPiece = Board[PM.TargetIdx];
                                PM.CalcMovesScoreListIdx = ((PieceIdxLookup[abs(PM.SourcePiece)] * 10000) + PM.HashMove);
                                Call IsLegalGeom(PieceIdxLookup[abs(PM.SourcePiece)])(PM.SourceIdx)(floor((PM.HashMove - (PM.SourceIdx * 100))))((0 + (PlyIsOwn[Ply] == 0)));
                                PM.HashMoveIsIllegalPawnCapture = 0;
                                If ((abs(PM.SourcePiece) == GoK_OwnPawn) And (PM.TargetPiece == 0))
                                {
                                    If (Not ((IdxToFile[PM.SourceIdx] == IdxToFile[PM.TargetIdx])))
                                    {
                                        If (Not ((PM.TargetIdx == (EnPassantTarget[Ply] + (8 * (((PM.SourcePiece > 0) * 2) - 1))))))
                                        {
                                            PM.HashMoveIsIllegalPawnCapture = 1;
                                        }
                                    }
                                }
                                If (((((PlyIsOwn[Ply] == 1) And (Ret.IsLegalGeom.IsLegal == 1)) And ((PM.SourcePiece > 0) And (Not ((PM.TargetPiece > 0))))) Or (((PlyIsOwn[Ply] == 0) And (Ret.IsLegalGeom.IsLegal == 1)) And ((PM.SourcePiece < 0) And (Not ((PM.TargetPiece < 0)))))) And (PM.HashMoveIsIllegalPawnCapture == 0))
                                {
                                    PM.Move = PM.HashMove;
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                    }
                                }
                            }
                            Else
                            {
                                Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                                If List.ContainsItem(CalcMovesMoveList, PM.HashMove)
                                {
                                    PM.Move = PM.HashMove;
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            If (Not ((PM.Move == "")))
            {
                Call ClearMoveList(Ply);
                PM.MoveScore = 9100000;
                Call AddMoveToList(PM.Move)(Ply)(PM.MoveScore);
                List.ReplaceItem(MovesIdx, Ply, 0);
                List.ReplaceItem(PickPhase, Ply, 2);
                List.ReplaceItem(PickMoveRes, Ply, 0);
                Call PickMove.Iterate(Ply)(2);
                If (PickMoveRes[Ply] == 1)
                {
                    List.ReplaceItem(HashMove, Ply, AppliedMove[Ply]);
                    If (Glob.ProfilerMode == 2)
                    {
                        Call Profile_TimeByHorizon(512)(Ply)(1);
                    }
                    Stop(this script);
                }
            }
        }
        List.ReplaceItem(PickPhase, Ply, 2);
    }
    Call Comment("Phase 2: Search for MVV-LVA captures via attack tables (and from recently moved pieces when attack tables not up-to-date)");
    If (PickPhase[Ply] == 2)
    {
        If (Quiescence Or ((Ply < 4) Or (CheckedState[Ply] == 1)))
        {
            List.ReplaceItem(PickPhase, Ply, 6);
        }
        Else
        {
            Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 1));
            If (Not ((HashMove[Ply] == Const.Null)))
            {
                If (Not (List.ContainsItem(CalcMovesMoveList, HashMove[Ply])))
                {
                    List.Add(CalcMovesMoveList, HashMove[Ply]);
                    List.Add(CalcMovesScoreList, 9100000);
                }
            }
            PM.CalcMovesScoreListIdx = 1;
            Repeat (List.Length(CalcMovesScoreList))
            {
                If (CalcMovesScoreList[PM.CalcMovesScoreListIdx] < 7000000)
                {
                    List.DeleteItem(CalcMovesMoveList, PM.CalcMovesScoreListIdx);
                    List.DeleteItem(CalcMovesScoreList, PM.CalcMovesScoreListIdx);
                }
                Else
                {
                    PM.CalcMovesScoreListIdx += 1;
                }
            }
            Call SortMoveList(Ply);
            List.ReplaceItem(MovesIdx, Ply, 0);
            List.ReplaceItem(PickPhase, Ply, 3);
        }
    }
    Call Comment("Phase 3: Return moves found in phase 2 on subsequent PickMove() invocations");
    If (PickPhase[Ply] == 3)
    {
        Call PickMove.Iterate(Ply)(4);
    }
    If (PickPhase[Ply] == 4)
    {
        Call PrepareCurrentKillerMoves(Ply);
        PM.CounterMove = "";
        If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
        {
            PM.CounterMove = HistoryCounterMoves[(PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))];
        }
        Call PickMove.TryKCMove(CurrentKillerMoves[1])(Ply)(6000000);
        Call PickMove.TryKCMove(CurrentKillerMoves[2])(Ply)(5000000);
        If (((Ply > 1) And ((Not ((PM.CounterMove == CurrentKillerMoves[1]))) And (Not ((PM.CounterMove == CurrentKillerMoves[2]))))) And (Not ((PM.CounterMove == ""))))
        {
            Call PickMove.TryKCMove(HistoryCounterMoves[(PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))])(Ply)(4000000);
        }
        List.ReplaceItem(PickPhase, Ply, 5);
    }
    If (PickPhase[Ply] == 5)
    {
        Call PickMove.Iterate(Ply)(6);
    }
    Call Comment("Phase 6: Full move generator for all moves not found yet");
    If (PickPhase[Ply] == 6)
    {
        Call CalcBoardAttackedOnDemand(Ply)(Quiescence)((1 == 1))(4);
        Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(PickPhase, Ply, 7);
    }
    Call Comment("Pick next move detected in phase 6, skip those applied in earlier stages");
    If (PickPhase[Ply] == 7)
    {
        Call PickMove.Iterate(Ply)("*");
    }
    If (PickPhase[Ply] == "*")
    {
        List.ReplaceItem(PickMoveRes, Ply, 0);
    }
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_TimeByHorizon(512)(Ply)(1);
    }
}

Define PickMove.Iterate(string Ply)(string NextPhase) (warp=true)
{
    PMI.Picked = 1;
    Repeat Until ((PMI.Picked == 0) Or (Not ((MovesIdx[Ply] < MovesCount[Ply]))))
    {
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
        Call GetCurrentMove(Ply);
        PMI.Move = Ret.GetCurrentMove.Move;
        Call IsMovePicked(Ply)(PMI.Move);
        PMI.Picked = Ret.IsMovePicked.Picked;
        If (PMI.Picked == 0)
        {
            Call IsCastlingPathSafe(PMI.Move)(Ply);
            If (Ret.IsCastlingPathSafe.IsSafe == 0)
            {
                PMI.Picked = 1;
            }
            Else
            {
                List.ReplaceItem(PickedPseudoLegalMoves, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), PMI.Move);
                List.ReplaceItem(PickedPseudoLegalMovesScore, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])]);
                List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, (PickedPseudoLegalMovesCount[Ply] + 1));
                Call ApplyMove(Ply);
                Call IsMoveLegalFast(Ply);
                If (Ret.IsMoveLegalFast.IsLegal == 1)
                {
                    Call RevertMove(Ply);
                    PMI.Picked = 1;
                }
            }
        }
    }
    If (PMI.Picked == 0)
    {
        List.ReplaceItem(PickMoveRes, Ply, 1);
        Stop(this script);
    }
    List.ReplaceItem(PickPhase, Ply, NextPhase);
}

Define PickMove.TryKCMove(string Move)(string Ply)(string Score) (warp=true)
{
    If (Move == "")
    {
        Stop(this script);
    }
    PMTKCM.KCSrc = floor((Move / 100));
    If (PMTKCM.KCSrc == 0)
    {
        Stop(this script);
    }
    If (((Board[PMTKCM.KCSrc] * ((PlyIsOwn[Ply] * 2) - 1)) > 0) And (Board[floor((Move % 100))] == 0))
    {
        If (PlyIsOwn[Ply] == 1)
        {
            Call IsLegalGeom(PieceIdxLookup[abs(Board[PMTKCM.KCSrc])])(PMTKCM.KCSrc)(floor((Move - (PMTKCM.KCSrc * 100))))(0);
            PMTKCM.KCLegal = Ret.IsLegalGeom.IsLegal;
        }
        Else
        {
            Call IsLegalGeom(PieceIdxLookup[abs(Board[PMTKCM.KCSrc])])(PMTKCM.KCSrc)(floor((Move - (PMTKCM.KCSrc * 100))))(1);
            PMTKCM.KCLegal = Ret.IsLegalGeom.IsLegal;
        }
        If (PMTKCM.KCLegal == 1)
        {
            Call IsMovePicked(Ply)(Move);
            If (Ret.IsMovePicked.Picked == 0)
            {
                List.DeleteAll(CalcMovesMoveList);
                List.DeleteAll(CalcMovesScoreList);
                Call GenerateMovesForSource(Ply)(PMTKCM.KCSrc)((1 == 0))((1 == 0));
                If List.ContainsItem(CalcMovesMoveList, Move)
                {
                    PMTKCM.MoveScore = Score;
                    Call AddMoveToList(Move)(Ply)(PMTKCM.MoveScore);
                }
            }
        }
    }
}

Define PopulateAttackInfo(string Idx) (warp=true)
{
    Ret.PopulateAttackInfo.Attacked = 0;
    Ret.PopulateAttackInfo.Defended = 0;
    Ret.PopulateAttackInfo.AttackerIdx = 0;
    PAI.DefenderIdx = 0;
    PAI.AttackerPiece = 0;
    Ret.PopulateAttackInfo.DefenderPieceAbs = 0;
    PAI.DefenderPiece = 0;
    Ret.PopulateAttackInfo.AttackerPieceAbs = 0;
    If (Board[(Idx + 0)] > 0)
    {
        Ret.PopulateAttackInfo.Attacked = (BoardAttacked[(Idx + 64)] + 0);
        Ret.PopulateAttackInfo.Defended = (BoardAttacked[(Idx + 0)] + 0);
        If (Ret.PopulateAttackInfo.Attacked > 0)
        {
            Ret.PopulateAttackInfo.AttackerIdx = (BoardAttackedPiece[(Idx + 64)] + 0);
        }
        If (Ret.PopulateAttackInfo.Defended > 0)
        {
            PAI.DefenderIdx = (BoardAttackedPiece[(Idx + 0)] + 0);
        }
    }
    Else
    {
        If (Board[(Idx + 0)] < 0)
        {
            Ret.PopulateAttackInfo.Attacked = (BoardAttacked[(Idx + 0)] + 0);
            Ret.PopulateAttackInfo.Defended = (BoardAttacked[(Idx + 64)] + 0);
            If (Ret.PopulateAttackInfo.Attacked > 0)
            {
                Ret.PopulateAttackInfo.AttackerIdx = (BoardAttackedPiece[(Idx + 0)] + 0);
            }
            If (Ret.PopulateAttackInfo.Defended > 0)
            {
                PAI.DefenderIdx = (BoardAttackedPiece[(Idx + 64)] + 0);
            }
        }
    }
    If (Ret.PopulateAttackInfo.Attacked > 0)
    {
        PAI.AttackerPiece = (Board[(Ret.PopulateAttackInfo.AttackerIdx + 0)] + 0);
        Ret.PopulateAttackInfo.AttackerPieceAbs = abs(PAI.AttackerPiece);
    }
    If (Ret.PopulateAttackInfo.Defended > 0)
    {
        PAI.DefenderPiece = (Board[(PAI.DefenderIdx + 0)] + 0);
        Ret.PopulateAttackInfo.DefenderPieceAbs = abs(PAI.DefenderPiece);
    }
}

Define PrepareCheckInfo(string Ply) (warp=true)
{
    List.ReplaceItem(PinCount, Ply, 0);
    List.ReplaceItem(DiscoveryCount, Ply, 0);
    CI.SideToMoveFactor = (((PlyIsOwn[Ply] == 1) * 2) - 1);
    If (PlyIsOwn[Ply] == 1)
    {
        CI.OurKingIdx = Glob.OwnKingIdx;
        PCI.TheirKingIdx = Glob.OppKingIdx;
    }
    Else
    {
        CI.OurKingIdx = Glob.OppKingIdx;
        PCI.TheirKingIdx = Glob.OwnKingIdx;
    }
    PCI.IsPin = 1;
    Repeat (2)
    {
        If (PCI.IsPin == 1)
        {
            PCI.KingIdx = CI.OurKingIdx;
            PCI.SliderFactor = -1;
        }
        Else
        {
            PCI.KingIdx = PCI.TheirKingIdx;
            PCI.SliderFactor = 1;
        }
        PCI.LineOffset = (MoveLookupLineIndexOffset[PCI.KingIdx] + 0);
        PCI.IsStraight = 1;
        Repeat (2)
        {
            If (PCI.IsStraight == 1)
            {
                PCI.SliderPiece = GoK_OwnRook;
                PCI.LookupBaseIdx = 0;
            }
            Else
            {
                PCI.SliderPiece = GoK_OwnBishop;
                PCI.LookupBaseIdx = List.Length(MoveLookupStraight);
            }
            PCI.DirIdx = 0;
            Repeat (4)
            {
                PCI.StepIdx = 1;
                PCI.BlockerIdx = 0;
                PCI.IsDone = 0;
                Repeat Until ((PCI.StepIdx > 8) Or (PCI.IsDone == 1))
                {
                    PCI.SqIdx = (MoveLookupRays[(PCI.LookupBaseIdx + ((PCI.LineOffset + (PCI.DirIdx * 8)) + PCI.StepIdx))] + 0);
                    If (PCI.SqIdx == -1)
                    {
                        PCI.IsDone = 1;
                    }
                    Else
                    {
                        PCI.Piece = (Board[PCI.SqIdx] + 0);
                        If (Not ((PCI.Piece == 0)))
                        {
                            If (PCI.BlockerIdx == 0)
                            {
                                If ((PCI.Piece * CI.SideToMoveFactor) > 0)
                                {
                                    PCI.BlockerIdx = PCI.SqIdx;
                                }
                                Else
                                {
                                    PCI.IsDone = 1;
                                }
                            }
                            Else
                            {
                                If ((((PCI.Piece * CI.SideToMoveFactor) * PCI.SliderFactor) > 0) And ((abs(PCI.Piece) == GoK_OwnQueen) Or (abs(PCI.Piece) == PCI.SliderPiece)))
                                {
                                    If (PCI.IsPin == 1)
                                    {
                                        List.ReplaceItem(PinSq, (((Ply - 1) * 8) + (PinCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(PinRay, (((Ply - 1) * 8) + (PinCount[Ply] + 1)), abs(MovePathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(PinCount, Ply, (PinCount[Ply] + 1));
                                    }
                                    Else
                                    {
                                        List.ReplaceItem(DiscoverySq, (((Ply - 1) * 8) + (DiscoveryCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(DiscoveryRay, (((Ply - 1) * 8) + (DiscoveryCount[Ply] + 1)), abs(MovePathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(DiscoveryCount, Ply, (DiscoveryCount[Ply] + 1));
                                    }
                                }
                                PCI.IsDone = 1;
                            }
                        }
                    }
                    PCI.StepIdx += 1;
                }
                PCI.DirIdx += 1;
            }
            PCI.IsStraight = 0;
        }
        PCI.IsPin = 0;
    }
}

Define PrepareCurrentKillerMoves(string Ply) (warp=true)
{
    List.DeleteAll(CurrentKillerMoves);
    PCKM.KillerMoveIdx = (((Ply - 1) * 2) + 1);
    List.Add(CurrentKillerMoves, KillerMoves[PCKM.KillerMoveIdx]);
    List.Add(CurrentKillerMoves, KillerMoves[(PCKM.KillerMoveIdx + 1)]);
}

Define PrepareEvalPiecesData(string Ply) (warp=true)
{
    Call GetEndgameLocal;
    If (Glob.IsScratch3 == 1)
    {
        Glob.IsExtendedEvalLocal = 0;
    }
    Else
    {
        Glob.IsExtendedEvalLocal = 1;
    }
    If (Eval.DebugLog == 1)
    {
        Call Log("IsExtendedEvalLocal =")(Glob.IsExtendedEvalLocal)("")("")("")("")("")("");
    }
    List.DeleteAll(EvalPiecesIdx_All);
    List.DeleteAll(EvalPiecesIdx_Pawns);
    List.DeleteAll(EvalPiecesIdx_NonPawns);
    Glob.OppSingleBishopIdxLocal = 0;
    Glob.OwnSingleBishopIdxLocal = 0;
    PEPD.Idx = 1;
    Repeat (64)
    {
        PEPD.Piece = (Board[(PEPD.Idx + 0)] + 0);
        If (Not ((PEPD.Piece == 0)))
        {
            PEPD.PieceAbs = abs(PEPD.Piece);
            List.Add(EvalPiecesIdx_All, PEPD.Idx);
            If (PEPD.PieceAbs == GoK_OwnPawn)
            {
                List.Add(EvalPiecesIdx_Pawns, PEPD.Idx);
            }
            Else
            {
                List.Add(EvalPiecesIdx_NonPawns, PEPD.Idx);
                If (PEPD.PieceAbs == GoK_OwnRook)
                {
                }
                Else
                {
                    If (PEPD.Piece == GoK_OppBishop)
                    {
                        If (Glob.OppBishopCountLocal == 1)
                        {
                            Glob.OppSingleBishopIdxLocal = PEPD.Idx;
                        }
                    }
                    Else
                    {
                        If (PEPD.Piece == GoK_OwnBishop)
                        {
                            If (Glob.OwnBishopCountLocal == 1)
                            {
                                Glob.OwnSingleBishopIdxLocal = PEPD.Idx;
                            }
                        }
                    }
                }
            }
        }
        PEPD.Idx += 1;
    }
    List.DeleteItem(PawnCount, all);
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    List.DeleteItem(PawnAdvancePerFile, all);
    Repeat (32)
    {
        List.Add(PawnAdvancePerFile, 0);
    }
    PEPD.EvalPieceIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_Pawns))
    {
        PEPD.Idx = (EvalPiecesIdx_Pawns[PEPD.EvalPieceIdx] + 0);
        PEPD.Piece = (Board[(PEPD.Idx + 0)] + 0);
        PEPD.File = (IdxToFile[(PEPD.Idx + 0)] + 0);
        PEPD.Rank = (IdxToRank[(PEPD.Idx + 0)] + 0);
        If (PEPD.Piece > 0)
        {
            List.ReplaceItem(PawnCount, (PEPD.File + 0), (PawnCount[(PEPD.File + 0)] + 1));
            If ((PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OwnRear)] == 0) Or (PEPD.Rank < PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OwnRear)]))
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OwnRear), PEPD.Rank);
            }
            If (PEPD.Rank > PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OwnFront)])
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OwnFront), PEPD.Rank);
            }
        }
        Else
        {
            List.ReplaceItem(PawnCount, ((PEPD.File + 0) + 8), (PawnCount[((PEPD.File + 0) + 8)] + 1));
            If (PEPD.Rank > PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OppRear)])
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OppRear), PEPD.Rank);
            }
            If ((PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OppFront)] == 0) Or (PEPD.Rank < PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OppFront)]))
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OppFront), PEPD.Rank);
            }
        }
        PEPD.EvalPieceIdx += 1;
    }
    PEPD.Idx = 1;
    Repeat (64)
    {
        List.ReplaceItem(PieceMobility, (PEPD.Idx + 0), 0);
        List.ReplaceItem(PieceMobilityPrep, (((PEPD.Idx - 1) * 32) + 1), 0);
        PEPD.Idx += 1;
    }
    If (Glob.IsExtendedEvalLocal == 0)
    {
        Call ClearBoardAttackedByMove((Ply + 3));
        Call ClearBoardAttackedByMove((Ply + 2));
    }
    Else
    {
        Glob.CalcAttackStateWithMobility = 1;
        Call CalcBoardAttackedByMove((Ply + 3));
        Call CalcBoardAttackedByMove((Ply + 2));
        Glob.CalcAttackStateWithMobility = 0;
        PEPD.EvalPieceIdx = 1;
        Repeat (List.Length(EvalPiecesIdx_NonPawns))
        {
            PEPD.Idx = (EvalPiecesIdx_NonPawns[PEPD.EvalPieceIdx] + 0);
            PEPD.Piece = (Board[(PEPD.Idx + 0)] + 0);
            PEPD.SliceStart = (((PEPD.Idx - 1) * 32) + 1);
            PEPD.Mobility = (PieceMobilityPrep[(PEPD.SliceStart + 0)] + 0);
            PEPD.SliceStart += 1;
            Repeat (PEPD.Mobility)
            {
                PEPD.TargetIdx = (PieceMobilityPrep[(PEPD.SliceStart + 0)] + 0);
                If (PEPD.Piece > 0)
                {
                    If (((BoardAttackedTypeMask[((PEPD.TargetIdx + 0) + 64)] % 10) == 0) And (Not ((Board[(PEPD.TargetIdx + 0)] > 0))))
                    {
                        List.ReplaceItem(PieceMobility, (PEPD.Idx + 0), (PieceMobility[(PEPD.Idx + 0)] + 1));
                    }
                }
                Else
                {
                    If (((BoardAttackedTypeMask[(PEPD.TargetIdx + 0)] % 10) == 0) And (Not ((Board[(PEPD.TargetIdx + 0)] < 0))))
                    {
                        List.ReplaceItem(PieceMobility, (PEPD.Idx + 0), (PieceMobility[(PEPD.Idx + 0)] + 1));
                    }
                }
                PEPD.SliceStart += 1;
            }
            PEPD.EvalPieceIdx += 1;
        }
    }
    If (Eval.DebugLog == 1)
    {
        Call Log("BoardAttacked = ")(BoardAttacked)("")("")("")("")("")("");
        Call Log("PieceMobility = ")(PieceMobility)("")("")("")("")("")("");
    }
}

Define PrepareEvasionMask(string Ply) (warp=true)
{
    PEM.BoardAttackedEvasionTargetIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 0);
        PEM.BoardAttackedEvasionTargetIdx += 1;
    }
    Call IsCheckedFast((Ply + 1));
    If (Ret.IsCheckedFast.IsChecked == 1)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, Ret.IsCheckedFast.CheckedByIdx, 1);
        If (PlyIsOwn[Ply] == 1)
        {
            PEM.KingIdx = Glob.OwnKingIdx;
        }
        Else
        {
            PEM.KingIdx = Glob.OppKingIdx;
        }
        PEM.Move = ((Ret.IsCheckedFast.CheckedByIdx * 100) + PEM.KingIdx);
        PEM.BoardAttackedEvasionTargetIdx = Ret.IsCheckedFast.CheckedByIdx;
        Repeat ((MovePathDelta[PEM.Move] - 1))
        {
            PEM.BoardAttackedEvasionTargetIdx += MovePathStepInc[PEM.Move];
            List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 1);
        }
    }
}

Define PrepStats (warp=true)
{
    List.DeleteAll(ProfileByHorizon);
    Repeat (1728)
    {
        List.Add(ProfileByHorizon, 0);
    }
    List.DeleteAll(HorizonAtPly);
    Repeat (64)
    {
        List.Add(HorizonAtPly, 0);
    }
    List.DeleteAll(ProfileTimeByHorizon);
    Repeat (576)
    {
        List.Add(ProfileTimeByHorizon, 0);
    }
}

Define PrintStats (warp=true)
{
    Call Log("============================================================")("")("")("")("")("")("")("");
    PS.Line = "";
    Call PS.Cell("Function")(20)((1 == 0));
    Call PS.Cell("Invoked")(14)((1 == 1));
    Call PS.Cell("Hits/Pruned")(16)((1 == 1));
    Call PS.Cell("Ratio")(10)((1 == 1));
    Call Log(PS.Line)("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call PS.SummaryRow("TT-static-eval")(Const.Profile.TTStaticProbe)(Const.Profile.TTStaticHit)((1 == 0));
    Call PS.SummaryRow("TT-node-eval")(Const.Profile.TTNodeProbe)(Const.Profile.TTNodeHit)((1 == 0));
    Call PS.SummaryRow("TT-hashmove")(Const.Profile.TTMoveProbe)(Const.Profile.TTMoveHit)((1 == 0));
    Call PS.SummaryRow("Razoring")(Const.Profile.Razoring_Try)(Const.Profile.Razoring_Hit)((1 == 0));
    Call PS.SummaryRow("NMP")(Const.Profile.NMP_Try)(Const.Profile.NMP_Hit)((1 == 0));
    Call PS.SummaryRow("RFP")(Const.Profile.RFP_Inv)(Const.Profile.RFP_Hit)((1 == 0));
    Call PS.SummaryRow("Futility")(Const.Profile.Futility_Inv)(Const.Profile.Futility_Hit)((1 == 0));
    Call PS.SummaryRow("Delta")(Const.Profile.Delta_Inv)(Const.Profile.Delta_Hit)((1 == 0));
    Call PS.SummaryRow("QS-SEE")(Const.Profile.QSEE_Inv)(Const.Profile.QSEE_Hit)((1 == 0));
    Call PS.SummaryRow("LMR")(Const.Profile.LMR_Inv)(Const.Profile.LMR_Hit)((1 == 0));
    Call PS.SummaryRow("Non-PV search")(Const.Profile.PVS_Inv)(Const.Profile.PVS_ReSearch)((1 == 1));
    Call PS.CountRow("Full Search")(Const.Profile.Full_Inv);
    Call PS.CountRow("Extensions")(Const.Profile.Ext);
    Call PS.CountRow("Singular extensions")(Const.Profile.ExtSingular);
    Call Log("============================================================")("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon invocations and runtime, s (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 1));
    PS.H = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.H)((1 == 0));
        PS.H += 1;
    }
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon hit ratio (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 0));
    PS.H = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.H)((1 == 1));
        PS.H += 1;
    }
}

Define Profile_CountByHorizon(string Base)(string HorizonVal)(string Ply) (warp=true)
{
    ProfCBH.Slot = (HorizonVal + 1);
    If (Quiescence[Ply] == 1)
    {
        ProfCBH.Slot = 64;
    }
    List.ReplaceItem(ProfileByHorizon, (Base + ProfCBH.Slot), (ProfileByHorizon[(Base + ProfCBH.Slot)] + 1));
}

Define Profile_MethodEnter(num Id) (warp=true)
{
    Repeat Until (Not ((List.Length(Profile_Data) < Id)))
    {
        List.Add(Profile_Data, 0);
    }
    List.ReplaceItem(Profile_Data, Id, (Profile_Data[Id] - ((Sensing.DaysSince2000() * 24) * 3600)));
}

Define Profile_MethodExit(num Id) (warp=false)
{
    List.ReplaceItem(Profile_Data, Id, (Profile_Data[Id] + ((Sensing.DaysSince2000() * 24) * 3600)));
}

Define Profile_Reset (warp=true)
{
    List.DeleteItem(Profile_Data, all);
}

Define Profile_TimeByHorizon(string Base)(string PlyIdx)(string Sign) (warp=true)
{
    ProfTBH.Slot = (HorizonAtPly[PlyIdx] + 1);
    If (Quiescence[PlyIdx] == 1)
    {
        ProfTBH.Slot = 64;
    }
    List.ReplaceItem(ProfileTimeByHorizon, (Base + ProfTBH.Slot), (ProfileTimeByHorizon[(Base + ProfTBH.Slot)] + (Sign * ((Sensing.DaysSince2000() * 24) * 3600))));
}

Define PS.Cell(string Value)(string Width)(bool RightJustify) (warp=true)
{
    Call PadInto(Value)(Width)(RightJustify);
    PS.Line = Operator.Join(PS.Line, Ret.PadInto.Padded);
}

Define PS.CountRow(string Label)(string Slot) (warp=true)
{
    Call PS.Sum(Slot);
    PS.Line = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(Ret.PS.Sum.Total)(14)((1 == 1));
    Call Log(PS.Line)("")("")("")("")("")("")("");
}

Define PS.HorizonHeader(bool WithTimes) (warp=true)
{
    PS.Line = "";
    Call PS.Cell("Horizon")(9)((1 == 0));
    Call PS.Cell("Razor")(9)((1 == 1));
    Call PS.Cell("RFP")(9)((1 == 1));
    Call PS.Cell("NMP")(9)((1 == 1));
    Call PS.Cell("Futil")(9)((1 == 1));
    Call PS.Cell("Delta")(9)((1 == 1));
    Call PS.Cell("QSEE")(9)((1 == 1));
    Call PS.Cell("LMR")(9)((1 == 1));
    Call PS.Cell("PVS")(9)((1 == 1));
    Call PS.Cell("TTnode")(9)((1 == 1));
    Call PS.Cell("TThash")(9)((1 == 1));
    If WithTimes
    {
        Call PS.Cell("EvalS")(9)((1 == 1));
        Call PS.Cell("MgenS")(9)((1 == 1));
        Call PS.Cell("PickS")(9)((1 == 1));
    }
    Call Log(PS.Line)("")("")("")("")("")("")("");
}

Define PS.HorizonRow(string H)(bool Ratios) (warp=true)
{
    If ((((((((((ProfileByHorizon[(Const.Profile.Razoring_Inv + H)] + ProfileByHorizon[(Const.Profile.RFP_Inv + H)]) + ProfileByHorizon[(Const.Profile.NMP_Inv + H)]) + ProfileByHorizon[(Const.Profile.Futility_Inv + H)]) + ProfileByHorizon[(Const.Profile.Delta_Inv + H)]) + ProfileByHorizon[(Const.Profile.QSEE_Inv + H)]) + ProfileByHorizon[(Const.Profile.LMR_Inv + H)]) + ProfileByHorizon[(Const.Profile.PVS_Inv + H)]) + ProfileByHorizon[(Const.Profile.TTNodeProbe + H)]) + ProfileByHorizon[(Const.Profile.TTMoveProbe + H)]) > 0)
    {
        If (H == 64)
        {
            PS.Label = "Q";
        }
        Else
        {
            PS.Label = (H - 1);
        }
        PS.Line = "";
        Call PS.Cell(PS.Label)(9)((1 == 0));
        If Ratios
        {
            Call PS.RatioCell(Const.Profile.Razoring_Hit)(Const.Profile.Razoring_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.RFP_Hit)(Const.Profile.RFP_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.NMP_Hit)(Const.Profile.NMP_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.Futility_Hit)(Const.Profile.Futility_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.Delta_Hit)(Const.Profile.Delta_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.QSEE_Hit)(Const.Profile.QSEE_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.LMR_Hit)(Const.Profile.LMR_Inv)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.PVS_ReSearch)(Const.Profile.PVS_Inv)(H)((1 == 1));
            Call PS.RatioCell(Const.Profile.TTNodeHit)(Const.Profile.TTNodeProbe)(H)((1 == 0));
            Call PS.RatioCell(Const.Profile.TTMoveHit)(Const.Profile.TTMoveProbe)(H)((1 == 0));
        }
        Else
        {
            Call PS.Cell(ProfileByHorizon[(Const.Profile.Razoring_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.RFP_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.NMP_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.Futility_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.Delta_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.QSEE_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.LMR_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.PVS_Inv + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTNodeProbe + H)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTMoveProbe + H)])(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(0 + H)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * (ProfileTimeByHorizon[(128 + H)] + ProfileTimeByHorizon[(192 + H)]))) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(512 + H)])) / 100))(9)((1 == 1));
        }
        Call Log(PS.Line)("")("")("")("")("")("")("");
    }
}

Define PS.RatioCell(string HitSlot)(string InvSlot)(string H)(bool HitSlotCountsMisses) (warp=true)
{
    PS.Inv = ProfileByHorizon[(InvSlot + H)];
    PS.Hit = ProfileByHorizon[(HitSlot + H)];
    If HitSlotCountsMisses
    {
        PS.Hit = (PS.Inv - PS.Hit);
    }
    Call PS.Cell(Operator.Join((floor(((1000 * PS.Hit) / (PS.Inv + (PS.Inv == 0)))) / 10), "%"))(9)((1 == 1));
}

Define PS.Sum(string Slot) (warp=true)
{
    Ret.PS.Sum.Total = 0;
    PS.SumIdx = 1;
    Repeat (64)
    {
        Ret.PS.Sum.Total += ProfileByHorizon[(Slot + PS.SumIdx)];
        PS.SumIdx += 1;
    }
}

Define PS.SummaryRow(string Label)(string InvSlot)(string HitSlot)(bool HitSlotCountsMisses) (warp=true)
{
    Call PS.Sum(InvSlot);
    PS.Inv = Ret.PS.Sum.Total;
    Call PS.Sum(HitSlot);
    PS.Hit = Ret.PS.Sum.Total;
    If HitSlotCountsMisses
    {
        PS.Hit = (PS.Inv - PS.Hit);
    }
    PS.Line = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(PS.Inv)(14)((1 == 1));
    Call PS.Cell(PS.Hit)(16)((1 == 1));
    Call PS.Cell(Operator.Join(floor(((100 * PS.Hit) / (PS.Inv + (PS.Inv == 0)))), "%"))(10)((1 == 1));
    Call Log(PS.Line)("")("")("")("")("")("")("");
}

Define QuickSort (warp=true)
{
    List.DeleteAll(QSPartStack);
    Call QuickSortImpl(1)(List.Length(CalcMovesScoreList));
}

Define QuickSortImpl(string Lo)(string Hi) (warp=true)
{
    QSI.QSPivot = CalcMovesScoreList[floor(((Lo + Hi) / 2))];
    QSI.QSLower = Lo;
    QSI.QSUpper = Hi;
    Repeat Until (QSI.QSLower > QSI.QSUpper)
    {
        Repeat Until (Not ((CalcMovesScoreList[(QSI.QSLower + 0)] > QSI.QSPivot)))
        {
            QSI.QSLower += 1;
        }
        Repeat Until (Not ((CalcMovesScoreList[QSI.QSUpper] < QSI.QSPivot)))
        {
            QSI.QSUpper += -1;
        }
        If (Not ((QSI.QSLower > QSI.QSUpper)))
        {
            QSI.QSSwap = CalcMovesScoreList[(QSI.QSLower + 0)];
            List.ReplaceItem(CalcMovesScoreList, (QSI.QSLower + 0), CalcMovesScoreList[QSI.QSUpper]);
            List.ReplaceItem(CalcMovesScoreList, QSI.QSUpper, QSI.QSSwap);
            QSI.QSSwap = CalcMovesMoveList[(QSI.QSLower + 0)];
            List.ReplaceItem(CalcMovesMoveList, (QSI.QSLower + 0), CalcMovesMoveList[QSI.QSUpper]);
            List.ReplaceItem(CalcMovesMoveList, QSI.QSUpper, QSI.QSSwap);
            QSI.QSLower += 1;
            QSI.QSUpper += -1;
        }
    }
    If (Lo < QSI.QSUpper)
    {
        List.Add(QSPartStack, QSI.QSLower);
        Call QuickSortImpl(Lo)(QSI.QSUpper);
        QSI.QSLower = QSPartStack[(List.Length(QSPartStack) + 0)];
        List.DeleteItem(QSPartStack, (List.Length(QSPartStack) + 0));
    }
    If (QSI.QSLower < Hi)
    {
        Call QuickSortImpl(QSI.QSLower)(Hi);
    }
}

Define RevertMove(num Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.ReplaceItem(EnPassantTarget, 1, Glob.RootEnPassantTarget);
        List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    RM.Move = AppliedMove[Ply];
    RM.SourceIdx = floor((RM.Move / 100));
    If (RM.SourceIdx > 0)
    {
        RM.TargetIdx = floor((RM.Move % 100));
        List.ReplaceItem(Board, (RM.SourceIdx + 0), Board[(RM.TargetIdx + 0)]);
        List.ReplaceItem(Board, (RM.TargetIdx + 0), 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (PromotionPieces[Ply] > 0)
        {
            RM.PromotionVal = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
            If (RM.PromotionVal == 1)
            {
                Glob.OwnQueenCountLocal += -1;
            }
            If (RM.PromotionVal == 2)
            {
                Glob.OwnRookCountLocal += -1;
                Glob.OwnNonQueenMajorMinorCountLocal += -1;
            }
            If (RM.PromotionVal == 3)
            {
                Glob.OwnBishopCountLocal += -1;
                Glob.OwnNonQueenMajorMinorCountLocal += -1;
            }
            If (RM.PromotionVal == 4)
            {
                Glob.OwnNonQueenMajorMinorCountLocal += -1;
            }
            List.ReplaceItem(Board, RM.SourceIdx, GoK_OwnPawn);
            Glob.OwnPawnCountLocal += 1;
        }
        Else
        {
            If (PromotionPieces[Ply] < 0)
            {
                RM.PromotionVal = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
                If (RM.PromotionVal == 1)
                {
                    Glob.OppQueenCountLocal += -1;
                }
                If (RM.PromotionVal == 2)
                {
                    Glob.OppRookCountLocal += -1;
                    Glob.OppNonQueenMajorMinorCountLocal += -1;
                }
                If (RM.PromotionVal == 3)
                {
                    Glob.OppBishopCountLocal += -1;
                    Glob.OppNonQueenMajorMinorCountLocal += -1;
                }
                If (RM.PromotionVal == 4)
                {
                    Glob.OppNonQueenMajorMinorCountLocal += -1;
                }
                List.ReplaceItem(Board, RM.SourceIdx, GoK_OppPawn);
                Glob.OppPawnCountLocal += 1;
            }
        }
        If (Board[(RM.SourceIdx + 0)] == GoK_OwnKing)
        {
            Glob.OwnKingIdx = RM.SourceIdx;
        }
        If (Board[(RM.SourceIdx + 0)] == GoK_OppKing)
        {
            Glob.OppKingIdx = RM.SourceIdx;
        }
        RM.TargetPiece = TargetPieces[Ply];
        If (RM.TargetPiece > 0)
        {
            If (RM.TargetPiece == GoK_OwnPawn)
            {
                Glob.OwnPawnCountLocal += 1;
            }
            Else
            {
                If (RM.TargetPiece < GoK_OwnQueen)
                {
                    Glob.OwnNonQueenMajorMinorCountLocal += 1;
                    If (RM.TargetPiece == GoK_OwnRook)
                    {
                        Glob.OwnRookCountLocal += 1;
                    }
                    If (RM.TargetPiece == GoK_OwnBishop)
                    {
                        Glob.OwnBishopCountLocal += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_OwnQueen)
                    {
                        Glob.OwnQueenCountLocal += 1;
                    }
                    Else
                    {
                        If (RM.TargetPiece == GoK_OwnKing)
                        {
                            Glob.OwnKingIdx = RM.TargetIdx;
                        }
                    }
                }
            }
        }
        If (RM.TargetPiece < 0)
        {
            If (RM.TargetPiece == GoK_OppPawn)
            {
                Glob.OppPawnCountLocal += 1;
            }
            Else
            {
                If (RM.TargetPiece > GoK_OppQueen)
                {
                    Glob.OppNonQueenMajorMinorCountLocal += 1;
                    If (RM.TargetPiece == GoK_OppRook)
                    {
                        Glob.OppRookCountLocal += 1;
                    }
                    If (RM.TargetPiece == GoK_OppBishop)
                    {
                        Glob.OppBishopCountLocal += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_OppQueen)
                    {
                        Glob.OppQueenCountLocal += 1;
                    }
                    Else
                    {
                        If (RM.TargetPiece == GoK_OppKing)
                        {
                            Glob.OppKingIdx = RM.TargetIdx;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        If (RM.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(Board, VirtualBoard[61], GoK_OppKing);
            List.ReplaceItem(Board, VirtualBoard[62], 0);
            List.ReplaceItem(Board, VirtualBoard[63], 0);
            List.ReplaceItem(Board, VirtualBoard[64], GoK_OppRook);
            Glob.OppKingIdx = VirtualBoard[61];
        }
        Else
        {
            If (RM.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(Board, VirtualBoard[57], GoK_OppRook);
                List.ReplaceItem(Board, VirtualBoard[59], 0);
                List.ReplaceItem(Board, VirtualBoard[60], 0);
                List.ReplaceItem(Board, VirtualBoard[61], GoK_OppKing);
                Glob.OppKingIdx = VirtualBoard[61];
            }
            Else
            {
                If (RM.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(Board, VirtualBoard[5], GoK_OwnKing);
                    List.ReplaceItem(Board, VirtualBoard[6], 0);
                    List.ReplaceItem(Board, VirtualBoard[7], 0);
                    List.ReplaceItem(Board, VirtualBoard[8], GoK_OwnRook);
                    Glob.OwnKingIdx = VirtualBoard[5];
                }
                Else
                {
                    If (RM.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(Board, VirtualBoard[1], GoK_OwnRook);
                        List.ReplaceItem(Board, VirtualBoard[4], 0);
                        List.ReplaceItem(Board, VirtualBoard[3], 0);
                        List.ReplaceItem(Board, VirtualBoard[5], GoK_OwnKing);
                        Glob.OwnKingIdx = VirtualBoard[5];
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
    Glob.KPHash = (PreviousBoardHash2[Ply] + 0);
    List.ReplaceItem(AppliedMove, Ply, "");
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
}

Define RevertMoveLight(string Ply) (warp=true)
{
    RML.Move = AppliedMove[Ply];
    RML.SourceIdx = floor((RML.Move / 100));
    If (RML.SourceIdx > 0)
    {
        RML.TargetIdx = floor((RML.Move % 100));
        List.ReplaceItem(Board, RML.SourceIdx, Board[RML.TargetIdx]);
        List.ReplaceItem(Board, RML.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (Board[RML.SourceIdx] == GoK_OwnKing)
        {
            Glob.OwnKingIdx = RML.SourceIdx;
        }
        If (Board[RML.SourceIdx] == GoK_OppKing)
        {
            Glob.OppKingIdx = RML.SourceIdx;
        }
    }
    Else
    {
        If (RML.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(Board, VirtualBoard[61], GoK_OppKing);
            List.ReplaceItem(Board, VirtualBoard[62], 0);
            List.ReplaceItem(Board, VirtualBoard[63], 0);
            List.ReplaceItem(Board, VirtualBoard[64], GoK_OppRook);
            Glob.OppKingIdx = VirtualBoard[61];
        }
        Else
        {
            If (RML.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(Board, VirtualBoard[57], GoK_OppRook);
                List.ReplaceItem(Board, VirtualBoard[59], 0);
                List.ReplaceItem(Board, VirtualBoard[60], 0);
                List.ReplaceItem(Board, VirtualBoard[61], GoK_OppKing);
                Glob.OppKingIdx = VirtualBoard[61];
            }
            Else
            {
                If (RML.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(Board, VirtualBoard[5], GoK_OwnKing);
                    List.ReplaceItem(Board, VirtualBoard[6], 0);
                    List.ReplaceItem(Board, VirtualBoard[7], 0);
                    List.ReplaceItem(Board, VirtualBoard[8], GoK_OwnRook);
                    Glob.OwnKingIdx = VirtualBoard[5];
                }
                Else
                {
                    If (RML.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(Board, VirtualBoard[1], GoK_OwnRook);
                        List.ReplaceItem(Board, VirtualBoard[4], 0);
                        List.ReplaceItem(Board, VirtualBoard[3], 0);
                        List.ReplaceItem(Board, VirtualBoard[5], GoK_OwnKing);
                        Glob.OwnKingIdx = VirtualBoard[5];
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
    List.ReplaceItem(AppliedMove, Ply, "");
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
}

Define SayAsync(string Text)(num Duration) (warp=false)
{
    Glob.SayAsyncText = Text;
    Glob.SayAsyncDuration = Duration;
    Event.Broadcast("sayasyncmsg");
}

Define Search(string Alpha)(string Beta)(string Horizon)(string Ply)(bool InitialDeepening) (warp=true)
{
    Glob.IsInitialDeepening = (InitialDeepening + 0);
    Glob.SearchAlpha = Alpha;
    Glob.SearchBeta = Beta;
    Call Search_Init(Horizon);
    Eval.DebugLog = 0;
    Glob.MoveCount = 0;
    Glob.MoveCountQ = 0;
    Glob.NodeCount = 0;
    Glob.NodeCountQ = 0;
    Glob.ProfBestMoveCount = 0;
    Glob.ProfBestMoveIdxSum = 0;
    If (Glob.ProfilerMode == 2)
    {
        Call PrepStats;
    }
    Glob.ProfBestMoveCountQ = 0;
    Glob.ProfBestMoveIdxSumQ = 0;
    Search.Timer = (Sensing.DaysSince2000() * 86400);
    Call Search_Main(Alpha)(Beta)(Horizon)(Ply)((1 == 0))((1 == 0))(Const.Null);
    Ret.Search.Eval = Ret.Search_Main.Eval;
    Ret.Search.Move = Ret.Search_Main.Move;
    Search.Timer = ((Sensing.DaysSince2000() * 86400) - Search.Timer);
    Call ExportBoardFEN((Glob.IsPlayerBlack == 1))((1 == 0));
    Call Log("PV: ")("[FEN "")(Ret.ExportBoardFEN.FEN)(""] ")(Glob.PV)("")("")("");
    If (Glob.ProfilerMode == 2)
    {
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log("SEARCH STATS")("")("")("")("")("")("")("");
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log("Depth = ")(Horizon)(", Time = ")((Operator.Round((Search.Timer * 100)) / 100))("")("")("")("");
        Call Log(Glob.MoveCount)(" moves (full), ")((Operator.Round(((Glob.MoveCount / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log(Glob.NodeCount)(" nodes (full), ")((Operator.Round(((Glob.NodeCount / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call Log(Glob.MoveCountQ)(" moves (q), ")((Operator.Round(((Glob.MoveCountQ / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log(Glob.NodeCountQ)(" nodes (q), ")((Operator.Round(((Glob.NodeCountQ / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call Log((Glob.MoveCount + Glob.MoveCountQ))(" moves (all), ")((Operator.Round((((Glob.MoveCount + Glob.MoveCountQ) / Search.Timer) / 100)) / 10))("k MPS")("")("")("")("");
        Call Log((Glob.NodeCount + Glob.NodeCountQ))(" nodes (all), ")((Operator.Round((((Glob.NodeCount + Glob.NodeCountQ) / Search.Timer) / 100)) / 10))("k NPS")("")("")("")("");
        Call Log("Avg. best move idx (full) = ")((Operator.Round(((Glob.ProfBestMoveIdxSum / Glob.ProfBestMoveCount) * 100)) / 100))("")("")("")("")("")("");
        Call Log("Avg. best move idx (q) = ")((Operator.Round(((Glob.ProfBestMoveIdxSumQ / Glob.ProfBestMoveCountQ) * 100)) / 100))("")("")("")("")("")("");
        Call Log("========================================")("")("")("")("")("")("")("");
        Call PrintStats;
    }
    Glob.MPS = Operator.Round(((Glob.MoveCount + Glob.MoveCountQ) / Search.Timer));
    Glob.NPS = Operator.Round(((Glob.NodeCount + Glob.NodeCountQ) / Search.Timer));
    If (Not ((Ret.Search.Move == "")))
    {
        List.DeleteAll(PVStablePrev);
        Search.PVStableIdx = 1;
        Repeat (List.Length(PVStable))
        {
            List.Add(PVStablePrev, PVStable[Search.PVStableIdx]);
            Search.PVStableIdx += 1;
        }
        If ((floor((Ret.Search.Move / 100)) == 0) Or (Board[floor((Ret.Search.Move % 100))] == 0))
        {
            If (Not ((Ret.Search.Eval < Beta)))
            {
                Call StoreKillerMove(1)(Horizon)(Ret.Search.Move)((1 == 0))((1 == 0));
            }
        }
        If (Glob.ProfilerMode == 2)
        {
            Call LogPVEval;
        }
    }
}

Define Search_CollectStats(string Horizon)(string Ply)(bool Quiescence)(string QSCode)(string FullCode) (warp=true)
{
    If Quiescence
    {
        Call Profile_CountByHorizon(QSCode)(Horizon)(Ply);
    }
    Else
    {
        Call Profile_CountByHorizon(FullCode)(Horizon)(Ply);
    }
}

Define Search_ComputeReduction(string Horizon)(string Ply)(bool Cutnode) (warp=true)
{
    If (ReductionBase[Ply] == Const.Null)
    {
        Call Search_ComputeReductionBase(Horizon)(Ply);
        If (Search.CR.Applies == 1)
        {
            List.ReplaceItem(ReductionBase, Ply, Ret.Search_ComputeReduction.Reduction);
        }
        Else
        {
            List.ReplaceItem(ReductionBase, Ply, Const.Null);
        }
    }
    Ret.Search_ComputeReduction.Reduction = 0;
    If (Not ((ReductionBase[Ply] == Const.Null)))
    {
        Ret.Search_ComputeReduction.Reduction = floor((((ReductionBase[Ply] + ((162 + (204 * ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0)))) * Cutnode)) + 64) / 128));
        If (Ret.Search_ComputeReduction.Reduction > ((Horizon + PlyExtension[Ply]) - 1))
        {
            Ret.Search_ComputeReduction.Reduction = ((Horizon + PlyExtension[Ply]) - 1);
        }
        If (Ret.Search_ComputeReduction.Reduction < 0)
        {
            Ret.Search_ComputeReduction.Reduction = 0;
        }
    }
}

Define Search_ComputeReductionBase(string Horizon)(string Ply) (warp=true)
{
    Search.CR.Applies = 0;
    Ret.Search_ComputeReduction.Reduction = 0;
    Search.CR.DangerousPush = 0;
    If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
    {
        Search.CR.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.CR.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.CR.PushRank < 4)))
        {
            Search.CR.DangerousPush = 1;
        }
    }
    If (Search.CR.DangerousPush == 1)
    {
        Stop(this script);
    }
    If (((((Horizon + PlyExtension[Ply]) > 0) And (CheckedState[Ply] == 0)) And ((1 == 1) Or (((Glob.OppQueenCountLocal + Glob.OppNonQueenMajorMinorCountLocal) + (Glob.OwnQueenCountLocal + Glob.OwnNonQueenMajorMinorCountLocal)) > 0))) And (((Betas[Ply] - Alphas[Ply]) == 1) Or ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))))
    {
        Ret.Search_ComputeReduction.Reduction = 0;
        Search.CR.MinMoveCount = (1 + (0 * (Not (((Betas[Ply] - Alphas[Ply]) == 1)))));
        If (Search.CR.MinMoveCount == 0)
        {
            Search.CR.MinMoveCount = 1;
        }
        If (PickedLegalMovesCount[Ply] > Search.CR.MinMoveCount)
        {
            Search.CR.Applies = 1;
            If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
            {
                Ret.Search_ComputeReduction.Reduction = floor((128 * (0.553 + ((ln((Horizon + PlyExtension[Ply])) * ln(PickedLegalMovesCount[Ply])) / 2.326))));
            }
            Else
            {
                Ret.Search_ComputeReduction.Reduction = floor((128 * (0.673 + ((ln((Horizon + PlyExtension[Ply])) * ln(PickedLegalMovesCount[Ply])) / 2.381))));
            }
            If (1 == 1)
            {
                If (((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0)) And ((Betas[Ply] - Alphas[Ply]) == 1))
                {
                    Ret.Search_ComputeReduction.Reduction += 30;
                }
            }
            If (1 == 1)
            {
                If (PutsInCheck[Ply] == 1)
                {
                    Ret.Search_ComputeReduction.Reduction += -142;
                }
            }
            If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
            {
                Search.CR.HistFrom = floor((AppliedMove[Ply] / 100));
                Search.CR.HistTo = floor((AppliedMove[Ply] % 100));
                If (Search.CR.HistFrom == 0)
                {
                    If ((AppliedMove[Ply] == 65) Or (AppliedMove[Ply] == 66))
                    {
                        Search.CR.HistFrom = VirtualBoard[5];
                    }
                    Else
                    {
                        Search.CR.HistFrom = VirtualBoard[61];
                    }
                    If (AppliedMove[Ply] == 65)
                    {
                        Search.CR.HistTo = VirtualBoard[8];
                    }
                    Else
                    {
                        If (AppliedMove[Ply] == 66)
                        {
                            Search.CR.HistTo = VirtualBoard[1];
                        }
                        Else
                        {
                            If (AppliedMove[Ply] == 67)
                            {
                                Search.CR.HistTo = VirtualBoard[64];
                            }
                            Else
                            {
                                Search.CR.HistTo = VirtualBoard[57];
                            }
                        }
                    }
                }
                Call GetHistoryStatScore(SourcePieces[Ply])(Search.CR.HistFrom)(Search.CR.HistTo)(AppliedMove[Ply])(Ply);
                Ret.Search_ComputeReduction.Reduction += (0 - Operator.Round(((Ret.GetHistoryStatScore.Score / 82000) * 128)));
            }
            If (1 == 1)
            {
                Call GetImproving(Ply);
                If (((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0)) And (Ret.GetImproving.IsImproving == 0))
                {
                    Ret.Search_ComputeReduction.Reduction += 76;
                }
            }
            If (Not (((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))))
            {
                If (PutsInCheck[Ply] == 1)
                {
                    Ret.Search_ComputeReduction.Reduction += 150;
                }
                If (Ret.GetImproving.IsImproving == 0)
                {
                    Ret.Search_ComputeReduction.Reduction += -36;
                }
            }
            If ((NodeTTHit[Ply] == 1) And (Not ((NodeTTHorizon[Ply] < Horizon))))
            {
                Ret.Search_ComputeReduction.Reduction += -26;
            }
            If (Not (((Betas[Ply] - Alphas[Ply]) == 1)))
            {
                Ret.Search_ComputeReduction.Reduction += (0 - floor(((128 * Horizon) / ((1 + Ply) + Horizon))));
            }
            If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
            {
                If (Not ((HashMove[Ply] == Const.Null)))
                {
                    If ((floor((HashMove[Ply] / 100)) > 0) And (((floor((HashMove[Ply] % 100)) == floor((AppliedMove[Ply] % 100))) And (Not ((TargetPieces[Ply] == 0)))) Or ((Not ((floor((HashMove[Ply] % 100)) == floor((AppliedMove[Ply] % 100))))) And (Not ((Board[floor((HashMove[Ply] % 100))] == 0))))))
                    {
                        Ret.Search_ComputeReduction.Reduction += 146;
                    }
                }
                If (Not ((MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])] < 4000000)))
                {
                    Ret.Search_ComputeReduction.Reduction += -336;
                }
            }
            If (Not (((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))))
            {
                If (MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])] < 7000000)
                {
                    Ret.Search_ComputeReduction.Reduction += -24;
                }
            }
            If (Not (((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))))
            {
                If (PieceIdxLookup[abs(SourcePieces[Ply])] < PieceIdxLookup[abs(TargetPieces[Ply])])
                {
                    Ret.Search_ComputeReduction.Reduction += -126;
                }
            }
        }
    }
}

Define Search_DetectCheckmatesAndDraws(string Horizon)(string Ply)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Ply > 1)
    {
        Call Comment("Virtual king captures on previous ply => depth-corrected checkmate evaluation");
        If (abs(TargetPieces[(Ply - 1)]) == GoK_OwnKing)
        {
            List.ReplaceItem(SearchEval, Ply, (0 - (100000 - (List.Length(BoardHistoryFiftyMoves) - 1))));
            List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
            Stop(this script);
        }
    }
    If (ChebyshevDistance[((Glob.OppKingIdx * 100) + Glob.OwnKingIdx)] < 2)
    {
        List.ReplaceItem(SearchEval, Ply, (100000 - (List.Length(BoardHistoryFiftyMoves) - 0)));
        List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
        Stop(this script);
    }
    If ((Ply > 1) And (Glob.IsInNullMove == 0))
    {
        Call Comment("Rule of 50 moves");
        Call Comment("Draw-by-repetition detection. This happens on every ply and could be costly, so we check previous plies for pawn moves and captures, and the history tables for board hash. Only then we count hash occurrences for same side.");
        If ((BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 99) And (CheckedState[Ply] == 0))
        {
            List.ReplaceItem(SearchEval, Ply, (Const.DrawByRepetitionEval * PlySign[Ply]));
            Stop(this script);
        }
        If (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 3)
        {
            Search.DCD.RepCount = 1;
            Search.DCD.RepHistCount = 0;
            If List.ContainsItem(PreviousBoardHash, Glob.CurrentBoardHash)
            {
                Search.DCD.SqIdx = (Ply - 2);
                Repeat Until ((Search.DCD.SqIdx < 2) Or (Search.DCD.RepCount > 2))
                {
                    If ((Glob.CurrentBoardHash == PreviousBoardHash[Search.DCD.SqIdx]) And (CastlingState[Ply] == CastlingState[(Search.DCD.SqIdx - 1)]))
                    {
                        Search.DCD.RepCount += 1;
                    }
                    Search.DCD.SqIdx += -2;
                }
            }
            If List.ContainsItem(BoardHistoryHash, Glob.CurrentBoardHash)
            {
                Search.DCD.SqIdx = ((List.Length(BoardHistoryHash) - 1) + PlyIsOwn[Ply]);
                Repeat Until ((Search.DCD.SqIdx < 1) Or (Search.DCD.RepHistCount > 2))
                {
                    If ((Glob.CurrentBoardHash == BoardHistoryHash[Search.DCD.SqIdx]) And (CastlingState[Ply] == BoardHistoryMetaState[Search.DCD.SqIdx]))
                    {
                        Search.DCD.RepHistCount += 1;
                    }
                    Search.DCD.SqIdx += -2;
                }
            }
            If ((Search.DCD.RepCount > 1) Or (Search.DCD.RepHistCount > 1))
            {
                List.ReplaceItem(SearchEval, Ply, (Const.DrawByRepetitionEval * PlySign[Ply]));
                List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
                Stop(this script);
            }
        }
    }
    If ((Ply > 1) And (Glob.IsInNullMove == 0))
    {
        Call Comment("Draw-by-stalemate detection. This is expensive, and is only applied at low search depth or during late endgame stage (no minor pieces left)");
        If (Not (Quiescence))
        {
            If (Not ((CheckedState[Ply] == 1)))
            {
                If (((PlyIsOwn[Ply] == 1) And ((Glob.OwnQueenCountLocal == 0) And (Glob.OwnNonQueenMajorMinorCountLocal < 2))) Or ((PlyIsOwn[Ply] == 0) And ((Glob.OppQueenCountLocal == 0) And (Glob.OppNonQueenMajorMinorCountLocal < 2))))
                {
                    If (1 == 0)
                    {
                        Call IsDrawByStalemate((Ply + 2));
                        If (Ret.IsDrawByStalemate.IsDraw == 1)
                        {
                            List.ReplaceItem(SearchEval, Ply, 0);
                            Stop(this script);
                        }
                    }
                }
            }
        }
        Call Comment("Fast draw-by-material verification");
        If (((Glob.OwnQueenCountLocal == 0) And (Glob.OppQueenCountLocal == 0)) And ((Glob.OwnPawnCountLocal == 0) And (Glob.OppPawnCountLocal == 0)))
        {
            If (((Glob.OwnRookCountLocal == 0) And (Glob.OwnNonQueenMajorMinorCountLocal < 2)) And ((Glob.OppRookCountLocal == 0) And (Glob.OppNonQueenMajorMinorCountLocal < 2)))
            {
                List.ReplaceItem(SearchEval, Ply, 0);
                Stop(this script);
            }
        }
        Call Comment("Special K-KP endgame draw detection, according to pawn and king position. Finds draws otherwise not visible within search horizon");
        If ((Ply > 1) And (Quiescence[(Ply - 1)] == 0))
        {
            If (((Glob.OppQueenCountLocal + Glob.OppNonQueenMajorMinorCountLocal) == 0) And ((Glob.OwnQueenCountLocal + Glob.OwnNonQueenMajorMinorCountLocal) == 0))
            {
                If ((Glob.OwnPawnCountLocal + Glob.OppPawnCountLocal) == 1)
                {
                    Search.DCD.SqIdx = 1;
                    Repeat (64)
                    {
                        Search.DCD.Piece = Board[(Search.DCD.SqIdx + 0)];
                        If ((Search.DCD.Piece == GoK_OppPawn) And (PlyIsOwn[Ply] == 0))
                        {
                            If ((IdxToFile[Search.DCD.SqIdx] == 1) Or (IdxToFile[Search.DCD.SqIdx] == 8))
                            {
                                If ((IdxToFile[Search.DCD.SqIdx] == IdxToFile[Glob.OwnKingIdx]) And (IdxToRank[Glob.OwnKingIdx] < IdxToRank[Search.DCD.SqIdx]))
                                {
                                    List.ReplaceItem(SearchEval, Ply, 0);
                                    Stop(this script);
                                }
                            }
                            Else
                            {
                                If (((Search.DCD.SqIdx - 8) == Glob.OwnKingIdx) Or ((Search.DCD.SqIdx - 16) == Glob.OwnKingIdx))
                                {
                                    If (Not ((((Search.DCD.SqIdx - 1) == Glob.OppKingIdx) Or ((Search.DCD.SqIdx + 1) == Glob.OppKingIdx))))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, 0);
                                        Stop(this script);
                                    }
                                }
                                If ((Search.DCD.SqIdx - 24) == Glob.OwnKingIdx)
                                {
                                    If ((IdxToRank[Search.DCD.SqIdx] > 4) And ((Search.DCD.SqIdx - 8) == Glob.OppKingIdx))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, 0);
                                        Stop(this script);
                                    }
                                }
                            }
                        }
                        Else
                        {
                            If ((Search.DCD.Piece == GoK_OwnPawn) And (PlyIsOwn[Ply] == 1))
                            {
                                If ((IdxToFile[Search.DCD.SqIdx] == 1) Or (IdxToFile[Search.DCD.SqIdx] == 8))
                                {
                                    If ((IdxToFile[Search.DCD.SqIdx] == IdxToFile[Glob.OppKingIdx]) And (IdxToRank[Glob.OppKingIdx] > IdxToRank[Search.DCD.SqIdx]))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, 0);
                                        Stop(this script);
                                    }
                                }
                                Else
                                {
                                    If (((Search.DCD.SqIdx + 8) == Glob.OppKingIdx) Or ((Search.DCD.SqIdx + 16) == Glob.OppKingIdx))
                                    {
                                        If (Not ((((Search.DCD.SqIdx - 1) == Glob.OwnKingIdx) Or ((Search.DCD.SqIdx + 1) == Glob.OwnKingIdx))))
                                        {
                                            List.ReplaceItem(SearchEval, Ply, 0);
                                            Stop(this script);
                                        }
                                    }
                                    If ((Search.DCD.SqIdx + 24) == Glob.OppKingIdx)
                                    {
                                        If ((IdxToRank[Search.DCD.SqIdx] < 5) And ((Search.DCD.SqIdx + 8) == Glob.OwnKingIdx))
                                        {
                                            List.ReplaceItem(SearchEval, Ply, 0);
                                            Stop(this script);
                                        }
                                    }
                                }
                            }
                        }
                        Search.DCD.SqIdx += 1;
                    }
                }
            }
        }
    }
}

Define Search_DetectExtension(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Not (Quiescence))
    {
        Call Comment("Singular extensions");
        If (1 == 0)
        {
            If ((((Not (Quiescence)) And ((Ply > 1) And ((TargetPieces[Ply] == 0) And (CheckedState[Ply] == 0)))) And (Horizon > (3 + (2 * (Not (((Betas[Ply] - Alphas[Ply]) == 1))))))) And ((HashMove[Ply] == AppliedMove[Ply]) And (ExcludedMove == Const.Null)))
            {
                Call TTProbeNode(PreviousBoardHash[Ply])(Ply);
                If ((Ret.TTProbeNode.Hit == 1) And ((Not ((Ret.TTProbeNode.Score == Const.Null))) And (Not ((Ret.TTProbeNode.Horizon == Const.Null)))))
                {
                    If (Not ((Ret.TTProbeNode.Horizon < (Horizon - 3))))
                    {
                        If (Ret.TTProbeNode.Type == Const.TTType.LowBound)
                        {
                            If (abs(Ret.TTProbeNode.Score) < Const.AbsMinCheckmateEval)
                            {
                                List.ReplaceItem(TTEval, Ply, Ret.TTProbeNode.Score);
                                List.ReplaceItem(SingularAlphaBeta, Ply, Ret.TTProbeNode.Score);
                                Call RevertMove(Ply);
                                List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), 0);
                                List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), 0);
                                Call ApplyMove(Ply);
                                Call SkipSearchFrameEnter((Ply + 1))(Quiescence);
                                List.ReplaceItem(SingularAlphaBeta, Ply, (SingularAlphaBeta[Ply] + (0 - (Horizon * 3))));
                                Search.DE.Reduction = floor((Horizon / 2));
                                Glob.IsInNullMove += 1;
                                Call Search_NextPly((SingularAlphaBeta[Ply] - 1))(SingularAlphaBeta[Ply])(Horizon)(Search.DE.Reduction)((Ply + 1))(Cutnode)(Quiescence)(HashMove[Ply]);
                                Glob.IsInNullMove += -1;
                                Call SkipSearchFrameExit((Ply + 1));
                                Call RevertMove(Ply);
                                List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), HashMove[Ply]);
                                List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply]), 9100000);
                                Call ApplyMove(Ply);
                                If (SearchEval[(Ply + 2)] < SingularAlphaBeta[Ply])
                                {
                                    List.ReplaceItem(PlyExtension, Ply, 1);
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.ExtSingular)(Horizon)(Ply);
                                    }
                                    If (Glob.ProfilerMode == 2)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
                                    }
                                    Stop(this script);
                                }
                                If (Not ((SingularAlphaBeta[Ply] < Betas[Ply])))
                                {
                                    List.ReplaceItem(SearchEval, Ply, SingularAlphaBeta[Ply]);
                                    List.ReplaceItem(PlyExtension, Ply, "*");
                                    Stop(this script);
                                }
                                If (1 == 0)
                                {
                                    If (Not ((TTEval[Ply] < Betas[Ply])))
                                    {
                                        List.ReplaceItem(PlyExtension, Ply, -2);
                                        Stop(this script);
                                    }
                                    If ((Not ((TTEval[Ply] > SearchEval[(Ply + 2)]))) And (Not ((TTEval[Ply] > Alphas[Ply]))))
                                    {
                                        List.ReplaceItem(PlyExtension, Ply, -1);
                                        Stop(this script);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        If (PlyExtension[Ply] == 0)
        {
            If ((Horizon > 1) And ((Ply > 1) And (CheckedState[Ply] == 1)))
            {
                List.ReplaceItem(PlyExtension, Ply, 1);
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_FutilityPruning(string Horizon)(string Ply)(bool Quiescence) (warp=true)
{
    Ret.Search_FutilityPruning.IsFutile = 0;
    Search.FP.DangerousPush = 0;
    If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
    {
        Search.FP.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.FP.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.FP.PushRank < 4)))
        {
            Search.FP.DangerousPush = 1;
        }
    }
    If ((Search.FP.DangerousPush == 1) And (Not (Quiescence)))
    {
        Stop(this script);
    }
    If (((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0)) And (PromotionPieces[Ply] == 0))
    {
        Call Comment("LMP");
        Search.FP.CanPrune = 0;
        If (Not (Quiescence))
        {
            If (((Not ((SearchEval[Ply] == Const.Null))) And (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval))) And (((PlyIsOwn[Ply] == 1) And ((Glob.OwnQueenCountLocal + Glob.OwnNonQueenMajorMinorCountLocal) > 0)) Or ((PlyIsOwn[Ply] == 0) And ((Glob.OppQueenCountLocal + Glob.OppNonQueenMajorMinorCountLocal) > 0))))
            {
                Search.FP.CanPrune = 1;
            }
        }
        If (Search.FP.CanPrune == 1)
        {
            If (((Not (Quiescence)) And ((Betas[Ply] - Alphas[Ply]) == 1)) And (TargetPieces[Ply] == 0))
            {
                Call GetImproving(Ply);
                If (PickedLegalMovesCountQuiet[Ply] > (3 + ((Horizon * Horizon) / (2 - (Not ((Ret.GetImproving.IsImproving == 0)))))))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                    Stop(this script);
                }
            }
        }
        Search.FP.Eval = "";
        Search.FP.SEE = Const.Null;
        Search.FP.FutilityMargin = Const.Null;
        If Quiescence
        {
            If ((Not ((TargetPieces[Ply] == 0))) And (Search.FP.DangerousPush == 0))
            {
                Search.FP.FutilityMargin = 184;
            }
        }
        Else
        {
            If (Search.FP.CanPrune == 1)
            {
                If ((Ply > 1) And (Horizon < 6))
                {
                    If (((TargetPieces[Ply] == 0) And (PickedLegalMovesCount[Ply] > 1)) And ((Betas[Ply] - Alphas[Ply]) == 1))
                    {
                        If (Not ((floor((AppliedMove[Ply] / 100)) == 0)))
                        {
                            Search.FP.Rank = IdxToRank[floor((AppliedMove[Ply] % 100))];
                        }
                        Else
                        {
                            Search.FP.Rank = 0;
                        }
                        If (((Not ((SourcePieces[Ply] == GoK_OwnPawn))) Or (Search.FP.Rank < 6)) And ((Not ((SourcePieces[Ply] == GoK_OppPawn))) Or (Search.FP.Rank > 3)))
                        {
                            Call Search_ComputeReduction(Horizon)(Ply)((1 == 0));
                            Search.FP.Reduction = Ret.Search_ComputeReduction.Reduction;
                            If (Search.FP.Reduction > Horizon)
                            {
                                Search.FP.Reduction = Horizon;
                            }
                            Search.FP.FutilityMargin = (103 + ((Horizon - Search.FP.Reduction) * 127));
                        }
                    }
                }
            }
        }
        If (Not ((Search.FP.FutilityMargin == Const.Null)))
        {
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Search.FP.StaticEval = StaticEval[Ply];
                Search.FP.Eval = (((Search.FP.StaticEval + 0) - (TargetPieces[Ply] * PlySign[Ply])) + Search.FP.FutilityMargin);
                If (Not ((Search.FP.Eval > Alphas[Ply])))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                }
                Else
                {
                    If Quiescence
                    {
                        Search.FP.Eval = (Search.FP.StaticEval + Search.FP.FutilityMargin);
                        If (Not ((Search.FP.Eval > Alphas[Ply])))
                        {
                            Call SEE(Ply)((Glob.IsScratch3 == 0));
                            Search.FP.SEE = Ret.SEE.Gain;
                            If (Not ((Search.FP.SEE > 0)))
                            {
                                Ret.Search_FutilityPruning.IsFutile = 1;
                            }
                        }
                    }
                }
                If (Ret.Search_FutilityPruning.IsFutile == 1)
                {
                    If Quiescence
                    {
                        If (Search.FP.Eval > SearchEval[Ply])
                        {
                            List.ReplaceItem(SearchEval, Ply, Search.FP.Eval);
                        }
                    }
                }
            }
        }
        If (1 == 0)
        {
            If (Ret.Search_FutilityPruning.IsFutile == 0)
            {
                If ((Not (Quiescence)) And ((Ply > 1) And (Horizon < 6)))
                {
                    If ((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0))
                    {
                        If (Search.FP.SEE == Const.Null)
                        {
                            Call SEE(Ply)((Glob.IsScratch3 == 0));
                            Search.FP.SEE = Ret.SEE.Gain;
                        }
                        If (Search.FP.SEE < (Horizon * -125))
                        {
                            Ret.Search_FutilityPruning.IsFutile = 1;
                        }
                    }
                }
            }
        }
        If ((Quiescence And (Ret.Search_FutilityPruning.IsFutile == 0)) And (Not ((TargetPieces[Ply] == 0))))
        {
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.QSEE_Inv)(Horizon)(Ply);
            }
            If (Search.FP.SEE == Const.Null)
            {
                Call SEE(Ply)((Glob.IsScratch3 == 0));
                Search.FP.SEE = Ret.SEE.Gain;
            }
            If (Search.FP.SEE < 0)
            {
                Ret.Search_FutilityPruning.IsFutile = 1;
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.QSEE_Hit)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_Init(string Horizon) (warp=true)
{
    Glob.IsInNullMove = 0;
    Init.Search.IsInProbeCut = 0;
    Glob.IsSearchTimeout = 0;
    If (Glob.IsInitialDeepening == 1)
    {
        Glob.PV = "";
        List.DeleteAll(PVStable);
        List.DeleteAll(PVStablePrev);
        Call Profile_Reset;
        Glob.TTCurrentAge = ((floor((Glob.TTCurrentAge / 100)) + 1) * 100);
        Search.Init.KillerIdx = 1;
        Repeat (List.Length(KillerMoves))
        {
            List.ReplaceItem(KillerMoves, Search.Init.KillerIdx, "");
            Search.Init.KillerIdx += 1;
        }
    }
    Call SetInitialEnPassantTarget(1);
    List.DeleteItem(SearchPly1EvalMoves, all);
    Glob.TTCurrentAge += 1;
    Call CalcBoardStats;
    Glob.CalcAttackStateWithMobility = 0;
    Call CreateCurrentBoardHash;
    Call Log(Horizon)(" : ")("Search start, depth = ")(Horizon)("")("")("")("");
}

Define Search_InitStack(string Ply)(bool Quiescence) (warp=true)
{
    If (Not (Quiescence))
    {
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 1), "");
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 2), "");
    }
    Call Comment("Search function (minimax / alpha-beta pruning)");
    Call Comment("Required for early TT access and draw detection");
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
        Call SetInitialEnPassantTarget(1);
        List.ReplaceItem(CheckedState, 1, Const.Null);
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
        List.ReplaceItem(CheckedState, Ply, PutsInCheck[(Ply - 1)]);
    }
    List.ReplaceItem(StaticEval, Ply, Const.Null);
    List.ReplaceItem(Improving, Ply, Const.Null);
    List.ReplaceItem(LMRState, Ply, 0);
    List.ReplaceItem(PlyExtension, Ply, 0);
    List.ReplaceItem(PV, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    List.ReplaceItem(AlphasOld, Ply, Alphas[Ply]);
    List.ReplaceItem(PutsInCheck, Ply, 0);
    List.ReplaceItem(LMRState, Ply, 0);
    If Quiescence
    {
        List.ReplaceItem(Quiescence, Ply, 1);
    }
    Else
    {
        List.ReplaceItem(Quiescence, Ply, 0);
    }
    Call Comment("Initialize local variables or forward state from previous ply");
    If (Ply == 1)
    {
        Call CalcBoardAttackedByMove(2);
        Call StoreAttackInfo(2)(1);
        List.ReplaceItem(BoardAttackedCalculated, 1, 1);
    }
    Else
    {
        List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
        If (Ply == 2)
        {
            Call CalcBoardAttackedByMove(3);
            Call StoreAttackInfo(3)(2);
            List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
        }
    }
}

Define Search_InternalIterative_Deepening(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    If (((Not (Quiescence)) And (Horizon > 5)) And ((Not (((Betas[Ply] - Alphas[Ply]) == 1))) And (CheckedState[Ply] == 0)))
    {
        If (1 == 0)
        {
            Call Comment("Internal iterative deepening");
            Call TTProbeNode(Glob.CurrentBoardHash)(Ply);
            If ((Ret.TTProbeNode.Hit == 0) Or (Ret.TTProbeNode.BestMove == Const.Null))
            {
                Call ClearMoveList(Ply);
                Call AddMoveToList(0)(Ply)(0);
                List.ReplaceItem(MovesIdx, Ply, 1);
                Call ApplyMove(Ply);
                Call SkipSearchFrameEnter((Ply + 1))(Quiescence);
                Call Search_Main(Alphas[Ply])(Betas[Ply])((Horizon - 3))((Ply + 2))(Cutnode)(Quiescence)(Const.Null);
                Call SkipSearchFrameExit((Ply + 1));
                Call RevertMove(Ply);
            }
        }
    }
}

Define Search_Main(string Alpha)(string Beta)(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    List.ReplaceItem(Alphas, Ply, Alpha);
    List.ReplaceItem(Betas, Ply, Beta);
    If (Ply == 1)
    {
        Ret.Search_Main.Eval = "";
        Ret.Search_Main.Move = "";
    }
    If (Glob.ProfilerMode == 2)
    {
        List.ReplaceItem(HorizonAtPly, Ply, Horizon);
    }
    List.ReplaceItem(SearchEval, Ply, Const.Null);
    List.ReplaceItem(ScoreTypes, Ply, Const.TTType.None);
    List.ReplaceItem(BestMoves, Ply, Const.Null);
    If (Glob.IsSearchTimeout == 1)
    {
        Stop(this script);
    }
    Call Search_InitStack(Ply)(Quiescence);
    Call Search_DetectCheckmatesAndDraws(Horizon)(Ply)(Quiescence)(ExcludedMove);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    Call TTProbeNodeAtPly(Ply);
    If ((Ply > 1) And (ExcludedMove == Const.Null))
    {
        If ((Betas[Ply] - Alphas[Ply]) == 1)
        {
            Call Comment("Probe transposition table for cached node evaluations");
            Search.Main.TTType = NodeTTType[Ply];
            Search.Main.TTScore = NodeTTScore[Ply];
            Search.Main.TTQSMeta = NodeTTQSMeta[Ply];
            Search.Main.TTHorizon = NodeTTHorizon[Ply];
            Search.Main.TTHit = NodeTTHit[Ply];
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.TTNodeProbe)(Horizon)(Ply);
            }
            If ((Search.Main.TTHit == 1) And ((Not ((Search.Main.TTScore == Const.Null))) And (Not ((Search.Main.TTHorizon == Const.Null)))))
            {
                Call IsQuiescentCheckCond(Ply);
                If (((Not (Quiescence)) And (Not (((Search.Main.TTHorizon - 0) < Horizon)))) Or ((Quiescence And (Search.Main.TTHorizon > -2)) And ((Not ((Search.Main.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue))) Or (Search.Main.TTHorizon > -1))))
                {
                    If ((Search.Main.TTType == Const.TTType.Exact) Or (((Betas[Ply] - Alphas[Ply]) == 1) And (((Search.Main.TTType == Const.TTType.HighBound) And (Not ((Search.Main.TTScore > Alphas[Ply])))) Or ((Search.Main.TTType == Const.TTType.LowBound) And (Not ((Search.Main.TTScore < Betas[Ply])))))))
                    {
                        If (1 == 1)
                        {
                            List.ReplaceItem(SearchEval, Ply, Search.Main.TTScore);
                            If (Glob.ProfilerMode == 2)
                            {
                                Call Profile_CountByHorizon(Const.Profile.TTNodeHit)(Horizon)(Ply);
                            }
                            Stop(this script);
                        }
                    }
                }
            }
        }
    }
    Call Comment("Search tree leaf reached");
    If (Ply > (Const.MaxPlyStackFrames - 10))
    {
        Call Evaluate((Ply - 1))((1 == 1));
        Call AdjustEvalScore(Ply)(Ret.Evaluate.Score);
        List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
        Stop(this script);
    }
    If (CheckedState[Ply] == 0)
    {
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_CountByHorizon(Const.Profile.TTStaticProbe)(HorizonAtPly[Ply])(Ply);
        }
        If (Not ((NodeTTStaticEval[Ply] == Const.Null)))
        {
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.TTStaticHit)(HorizonAtPly[Ply])(Ply);
            }
            Call AdjustEvalScore(Ply)(NodeTTStaticEval[Ply]);
        }
    }
    If Quiescence
    {
        If (CheckedState[Ply] == 1)
        {
            List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
        }
        Else
        {
            Call Comment("Standing pat");
            Call GetStaticEval(Ply);
            List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
            If (Not ((StaticEval[Ply] < Betas[Ply])))
            {
                List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
                If (1 == 1)
                {
                    Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(SearchEval[Ply])(Const.Null)(Const.TTType.LowBound)(Const.Null)(-1)(0)(NodeTTStaticEval[Ply]);
                }
                Stop(this script);
            }
            If (StaticEval[Ply] > Alphas[Ply])
            {
                List.ReplaceItem(Alphas, Ply, StaticEval[Ply]);
            }
        }
    }
    If (Not (Quiescence))
    {
        If (((Betas[Ply] - Alphas[Ply]) == 1) And (CheckedState[Ply] == 0))
        {
            Call GetStaticEval(Ply);
            If (Ply > 1)
            {
                Call Search_Pruning(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
                If (Not ((SearchEval[Ply] == Const.Null)))
                {
                    Stop(this script);
                }
            }
        }
        Call Search_InternalIterative_Deepening(Horizon)(Ply)(Cutnode)(Quiescence);
    }
    List.ReplaceItem(PickPhase, Ply, 1);
    List.ReplaceItem(PickMoveRes, Ply, 1);
    List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCount, Ply, 0);
    Call Comment("Move generation and application loop, recursive search invocation");
    Call PrepareCheckInfo(Ply);
    Repeat Until (PickMoveRes[Ply] == 0)
    {
        If ((Not (Quiescence)) And ((Ply == 1) Or (Horizon > 3)))
        {
            If ((Glob.IsSearchTimeout == 0) And ((Not ((Glob.IsInitialDeepening == 1))) Or (Not ((Ret.Search_Main.Move == "")))))
            {
                If (((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) > Glob.ThinkTimeLimitSearch)
                {
                    Glob.IsSearchTimeout = 1;
                }
            }
        }
        If (Glob.IsSearchTimeout == 1)
        {
            If (Quiescence[Ply] == 0)
            {
                Glob.MoveCount += MovesCount[Ply];
            }
            Else
            {
                Glob.MoveCountQ += MovesCount[Ply];
            }
            Stop(this script);
        }
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_MethodEnter(((5 * Const.MaxPlyStackFrames) + Ply));
        }
        If (1 == 0)
        {
            If (PickedLegalMovesCount[Ply] > 0)
            {
                If ((Ply == 1) And ((PickedLegalMovesCount[Ply] > Glob.AWCount) And (abs(Alphas[Ply]) < Const.AbsMinCheckmateEval)))
                {
                    If (Not ((Alphas[Ply] > Glob.SearchAlpha)))
                    {
                        List.ReplaceItem(SearchEval, Ply, Glob.SearchAlpha);
                        Stop(this script);
                    }
                }
            }
        }
        Call Comment("Invoke move generator and apply next move from list");
        Call PickMove(Ply)(Quiescence);
        If (PickMoveRes[Ply] == 1)
        {
            If (AppliedMove[Ply] == ExcludedMove)
            {
                Call RevertMove(Ply);
                Call PickMove(Ply)(Quiescence);
            }
        }
        If (PickMoveRes[Ply] == 1)
        {
            List.ReplaceItem(PickedLegalMovesCount, Ply, (PickedLegalMovesCount[Ply] + 1));
            If ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0))
            {
                List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, (PickedLegalMovesCountQuiet[Ply] + 1));
            }
        }
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_MethodExit(((5 * Const.MaxPlyStackFrames) + Ply));
        }
        If (PickMoveRes[Ply] == 1)
        {
            Call Comment("Show progress and collect statistics");
            List.ReplaceItem(PutsInCheck, Ply, 0);
            List.ReplaceItem(ReductionBase, Ply, Const.Null);
            List.ReplaceItem(PlyExtension, Ply, 0);
            Call Comment("Check detection for current move: does it put the opponent in check");
            Call GivesCheckFast(Ply);
            List.ReplaceItem(PutsInCheck, Ply, Ret.GivesCheckFast.GivesCheck);
            If (Glob.ProfilerMode == 2)
            {
                Call Search_CollectStats(Horizon)(Ply)(Quiescence)(Const.Profile.Delta_Inv)(Const.Profile.Futility_Inv);
            }
            Call Search_FutilityPruning(Horizon)(Ply)(Quiescence);
            If (Ret.Search_FutilityPruning.IsFutile == 1)
            {
                If (Glob.ProfilerMode == 2)
                {
                    Call Search_CollectStats(Horizon)(Ply)(Quiescence)(Const.Profile.Delta_Hit)(Const.Profile.Futility_Hit);
                }
                If (Glob.IsSearchTimeout == 0)
                {
                    If (Ply == 1)
                    {
                        List.Add(SearchPly1EvalMoves, AppliedMove[Ply]);
                    }
