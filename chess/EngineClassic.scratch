                }
            }
            If ((EvalP.PStruct.Doubled == 1) And (EvalP.PStruct.OwnFixed == 0))
            {
                Call TaperedEval.Add(-13)(-6)("Eval.Pawns.DoubledPawnEarly")(EvalP.PStruct.SqIdx)(1)("");
            }
            If ((EvalP.PStruct.Blocked == 1) And (EvalP.PStruct.NormRank == 5))
            {
                Call TaperedEval.Add(-10)(-4)("Eval.Pawns.BlockedPawn.Rank5")(EvalP.PStruct.SqIdx)(1)("");
            }
            If ((EvalP.PStruct.Blocked == 1) And (EvalP.PStruct.NormRank == 6))
            {
                Call TaperedEval.Add(-4)(2)("Eval.Pawns.BlockedPawn.Rank6")(EvalP.PStruct.SqIdx)(1)("");
            }
        }
        Else
        {
            EvalP.PStruct.NormRank = (9 - EvalP.PStruct.Rank);
            EvalP.PStruct.Opposed = ((PawnAdvancePerFile[(EvalP.PStruct.File + Const.PawnAdvance.OwnRear)] > 0) And (PawnAdvancePerFile[(EvalP.PStruct.File + Const.PawnAdvance.OwnRear)] < EvalP.PStruct.Rank));
            EvalP.PStruct.Blocked = (Board[(EvalP.PStruct.SqIdx + -8)] == GoK_OwnPawn);
            EvalP.PStruct.Doubled = (Board[(EvalP.PStruct.SqIdx + 8)] == GoK_OppPawn);
            EvalP.PStruct.Support = (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + 7)] == GoK_OppPawn)) + ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + 9)] == GoK_OppPawn)));
            EvalP.PStruct.Phalanx = (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + -1)] == GoK_OppPawn)) + ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + 1)] == GoK_OppPawn)));
            EvalP.PStruct.Lever = (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + -9)] == GoK_OwnPawn)) + ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + -7)] == GoK_OwnPawn)));
            EvalP.PStruct.LeverPush = 0;
            If (EvalP.PStruct.NormRank < 7)
            {
                EvalP.PStruct.LeverPush = (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + -17)] == GoK_OwnPawn)) + ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + -15)] == GoK_OwnPawn)));
            }
            EvalP.PStruct.Neigh = (((EvalP.PStruct.File > 1) And (PawnCount[((EvalP.PStruct.File - 1) + 8)] > 0)) Or ((EvalP.PStruct.File < 8) And (PawnCount[((EvalP.PStruct.File + 1) + 8)] > 0)));
            EvalP.PStruct.AllAhead = (((EvalP.PStruct.File == 1) Or ((PawnCount[((EvalP.PStruct.File - 1) + 8)] == 0) Or (PawnAdvancePerFile[(EvalP.PStruct.File - 1)] < EvalP.PStruct.Rank))) And ((EvalP.PStruct.File == 8) Or ((PawnCount[((EvalP.PStruct.File + 1) + 8)] == 0) Or (PawnAdvancePerFile[(EvalP.PStruct.File + 1)] < EvalP.PStruct.Rank))));
            EvalP.PStruct.Backward = 0;
            If ((EvalP.PStruct.Neigh == 1) And ((EvalP.PStruct.AllAhead == 1) And ((EvalP.PStruct.Blocked == 1) Or (EvalP.PStruct.LeverPush > 0))))
            {
                EvalP.PStruct.Backward = 1;
            }
            EvalP.PStruct.RankBonusIdx = ((2 * EvalP.PStruct.NormRank) - 1);
            If ((EvalP.PStruct.Support > 0) Or (EvalP.PStruct.Phalanx > 0))
            {
                If (EvalP.PStruct.Phalanx > 0)
                {
                    If (EvalP.PStruct.Opposed == 1)
                    {
                        Call TaperedEval.Add((PawnPhalanxBonusOpposed[EvalP.PStruct.RankBonusIdx] * -1))((PawnPhalanxBonusOpposed[(EvalP.PStruct.RankBonusIdx + 1)] * -1))("Eval.Pawns.Phalanx.Opposed")(EvalP.PStruct.SqIdx)(2)("");
                    }
                    Else
                    {
                        Call TaperedEval.Add((PawnPhalanxBonus[EvalP.PStruct.RankBonusIdx] * -1))((PawnPhalanxBonus[(EvalP.PStruct.RankBonusIdx + 1)] * -1))("Eval.Pawns.Phalanx.Unopposed")(EvalP.PStruct.SqIdx)(2)("");
                    }
                }
                If (EvalP.PStruct.Support > 0)
                {
                    EvalP.PStruct.Bonus = Operator.Round(((PawnConnectedBonus[EvalP.PStruct.NormRank] * ((2 + (EvalP.PStruct.Phalanx > 0)) - EvalP.PStruct.Opposed)) + (11 * EvalP.PStruct.Support)));
                    Call TaperedEval.Add((EvalP.PStruct.Bonus * -1))((Operator.Round(((EvalP.PStruct.Bonus * (EvalP.PStruct.NormRank - 3)) / 4)) * -1))("Eval.Pawns.Connected")(EvalP.PStruct.SqIdx)(2)("");
                }
            }
            Else
            {
                If (EvalP.PStruct.Neigh == 0)
                {
                    If (EvalP.PStruct.Opposed == 1)
                    {
                        Call TaperedEval.Add(2)(16)("Eval.Pawns.Isolated.Opposed")(EvalP.PStruct.SqIdx)(2)("");
                    }
                    Else
                    {
                        Call TaperedEval.Add(12)(30)("Eval.Pawns.Isolated.Unopposed")(EvalP.PStruct.SqIdx)(2)("");
                    }
                }
                Else
                {
                    If (EvalP.PStruct.Backward == 1)
                    {
                        If (EvalP.PStruct.Opposed == 1)
                        {
                            Call TaperedEval.Add(3)(10)("Eval.Pawns.NonIsolated.Backward.Opposed")(EvalP.PStruct.SqIdx)(2)("");
                        }
                        Else
                        {
                            If ((EvalP.PStruct.File > 1) And (EvalP.PStruct.File < 8))
                            {
                                Call TaperedEval.Add(11)(19)("Eval.Pawns.NonIsolated.Backward.Unopposed")(EvalP.PStruct.SqIdx)(2)("");
                            }
                            Else
                            {
                                Call TaperedEval.Add(3)(10)("Eval.Pawns.NonIsolated.Backward.Unopposed.Edge")(EvalP.PStruct.SqIdx)(2)("");
                            }
                        }
                    }
                }
            }
            If ((EvalP.PStruct.Backward == 0) And (EvalP.PStruct.Lever > 0))
            {
                Call TaperedEval.Add((PawnLeverBonus[EvalP.PStruct.RankBonusIdx] * -1))((PawnLeverBonus[(EvalP.PStruct.RankBonusIdx + 1)] * -1))("Eval.Pawns.Lever")(EvalP.PStruct.SqIdx)(2)("");
            }
            If (EvalP.PStruct.Support == 0)
            {
                If (EvalP.PStruct.Doubled == 1)
                {
                    Call TaperedEval.Add(9)(40)("Eval.Pawns.DoubledPawn")(EvalP.PStruct.SqIdx)(2)("");
                }
