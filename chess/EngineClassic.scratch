            }
            If (EvalT.RookChecks > 1)
            {
                EvalT.KingDanger += 943;
            }
            Else
            {
                If (EvalT.RookChecks == 1)
                {
                    EvalT.KingDanger += 536;
                }
            }
            If (EvalT.QueenChecks == 0)
