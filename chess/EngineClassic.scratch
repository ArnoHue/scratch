                    EvalMM.MateCornerBonus = (abs((IdxToRank[Glob.OwnKingIdx] - IdxToFile[Glob.OwnKingIdx])) * 20);
                }
                Else
                {
                    EvalMM.MateCornerBonus = (abs(((IdxToRank[Glob.OwnKingIdx] + IdxToFile[Glob.OwnKingIdx]) - 9)) * 20);
                }
            }
            EvalMM.MateDriveBonus += EvalMM.MateCornerBonus;
            Ret.EvaluateMajorsMinorsImpl.Score += (0 - EvalMM.MateDriveBonus);
        }
    }
    If (EvalMM.MatingSide == 0)
    {
        If (((Glob.OwnQueenCountLocal + Glob.OwnNonQueenMajorMinorCountLocal) < 3) And ((Glob.OppQueenCountLocal + Glob.OppNonQueenMajorMinorCountLocal) < 3))
        {
            If (((Glob.OwnQueenCountLocal * 2) + Glob.OwnNonQueenMajorMinorCountLocal) > ((Glob.OppQueenCountLocal * 2) + Glob.OppNonQueenMajorMinorCountLocal))
            {
                EvalMM.MatingSide = 1;
            }
            Else
            {
                If (((Glob.OppQueenCountLocal * 2) + Glob.OppNonQueenMajorMinorCountLocal) > ((Glob.OwnQueenCountLocal * 2) + Glob.OwnNonQueenMajorMinorCountLocal))
                {
                    EvalMM.MatingSide = 2;
                }
            }
            EvalMM.Side = 1;
            Repeat (2)
            {
                If ((EvalMM.Side == EvalMM.MatingSide) Or (EvalMM.MatingSide == 0))
                {
                    If (EvalMM.Side == 1)
                    {
                        EvalMM.KingIdx = Glob.OppKingIdx;
                    }
                    Else
                    {
                        EvalMM.KingIdx = Glob.OwnKingIdx;
                    }
                    EvalMM.File = (IdxToFile[EvalMM.KingIdx] + 0);
                    EvalMM.Rank = (IdxToRank[EvalMM.KingIdx] + 0);
                    EvalMM.KingCentreDist = 0;
                    EvalMM.KingCentreFileDist = 0;
                    If (EvalMM.Rank < 4)
                    {
                        EvalMM.KingCentreDist = (4 - EvalMM.Rank);
                    }
                    Else
                    {
                        If (EvalMM.Rank > 5)
                        {
                            EvalMM.KingCentreDist = (EvalMM.Rank - 5);
                        }
                    }
                    If (EvalMM.File < 4)
                    {
                        EvalMM.KingCentreFileDist = (4 - EvalMM.File);
                    }
                    Else
                    {
                        If (EvalMM.File > 5)
                        {
                            EvalMM.KingCentreFileDist = (EvalMM.File - 5);
                        }
                    }
                    EvalMM.KingCentreDist = (((EvalMM.KingCentreDist + EvalMM.KingCentreFileDist) + abs((EvalMM.KingCentreDist - EvalMM.KingCentreFileDist))) / 2);
                    If (EvalMM.Side == 1)
                    {
                        Ret.EvaluateMajorsMinorsImpl.Score += (20 * EvalMM.KingCentreDist);
                    }
                    Else
                    {
                        Ret.EvaluateMajorsMinorsImpl.Score += (-20 * EvalMM.KingCentreDist);
                    }
                }
                EvalMM.Side += 1;
            }
        }
    }
}

Define EvaluatePawns(string Ply) (warp=true)
{
    Ret.EvaluatePawns.Score = 0;
    Call Comment("Positional evaluation: king and pawn structure");
    Call EvaluatePawnsImpl(Ply);
    Ret.EvaluatePawns.Score = Ret.EvaluatePawnsImpl.Score;
}

Define EvaluatePawnsImpl(string Ply) (warp=true)
{
    Ret.EvaluatePawnsImpl.Score = 0;
    Call TaperedEval.Init;
    If (1 == 1)
    {
        Call TaperedEval.Add(0)((60 * Glob.OwnPawnCountLocal))("Eval.Pawns.EG")("")(1)("");
        Call TaperedEval.Add(0)((-60 * Glob.OppPawnCountLocal))("Eval.Pawns.EG")("")(2)("");
    }
    If (((Operator.LetterOf(CastlingState[Ply], 1) == 0) And (Operator.LetterOf(CastlingState[Ply], 2) == 0)) And ((Operator.LetterOf(CastlingState[Ply], 3) == 0) Or (Operator.LetterOf(CastlingState[Ply], 4) == 0)))
    {
        EvalP.IsOwnSideCastlingPossibleLocal = 1;
    }
    Else
    {
        EvalP.IsOwnSideCastlingPossibleLocal = 0;
    }
    If (((Operator.LetterOf(CastlingState[Ply], 5) == 0) And (Operator.LetterOf(CastlingState[Ply], 6) == 0)) And ((Operator.LetterOf(CastlingState[Ply], 7) == 0) Or (Operator.LetterOf(CastlingState[Ply], 8) == 0)))
    {
        EvalP.IsOppSideCastlingPossibleLocal = 1;
    }
    Else
    {
        EvalP.IsOppSideCastlingPossibleLocal = 0;
    }
    EvalP.OwnKingDistSum = 0;
    EvalP.OppKingDistSum = 0;
