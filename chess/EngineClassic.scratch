                    Search_Main.OrderingBestNotation = Ret.GetMoveNotation.Notation;
                    Call GetMoveNotation(Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + 1)]);
                    Search_Main.OrderingTopNotation = Ret.GetMoveNotation.Notation;
                    Call Log("MoveOrd warning:")(Operator.Join(Operator.Join(Operator.Join(" idx=", MovesIdxBestMove[Ply]), "/"), MovesCount[Ply]))(Operator.Join(" horizon=", Horizon))(Operator.Join(" ply=", Ply))(Operator.Join(Operator.Join(" ", Operator.LetterOf("FQ", (1 + Quiescence))), Operator.Join(" checked=", CheckedState[Ply])))(Operator.Join(Operator.Join(Operator.Join(Operator.Join(" ranked_best=", Search_Main.OrderingTopNotation), "("), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + 1)]), ")"))(Operator.Join(Operator.Join(Operator.Join(Operator.Join(" eval_best=", Search_Main.OrderingBestNotation), "("), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdxBestMove[Ply])]), ")"))(Operator.Join(" fen=", Search_Main.FEN));
