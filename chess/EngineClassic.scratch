    If ((((Glob.OppQueenCount + Glob.OppNonQueenMajorMinorCount) + Glob.OppPawnCount) == 0) And ((Glob.OwnQueenCount + Glob.OwnNonQueenMajorMinorCount) > 0))
    {
        EvalMM.MatingSide = 1;
    }
    If ((((Glob.OwnQueenCount + Glob.OwnNonQueenMajorMinorCount) + Glob.OwnPawnCount) == 0) And ((Glob.OppQueenCount + Glob.OppNonQueenMajorMinorCount) > 0))
    {
        EvalMM.MatingSide = 2;
    }
    If ((((Glob.OwnPawnCount + Glob.OppPawnCount) == 0) And ((Glob.OwnQueenCount == 1) And (Glob.OwnNonQueenMajorMinorCount == 0))) And ((Glob.OppQueenCount == 0) And ((Glob.OppRookCount == 1) And (Glob.OppNonQueenMajorMinorCount == 1))))
    {
        EvalMM.MatingSide = 1;
    }
    If ((((Glob.OwnPawnCount + Glob.OppPawnCount) == 0) And ((Glob.OppQueenCount == 1) And (Glob.OppNonQueenMajorMinorCount == 0))) And ((Glob.OwnQueenCount == 0) And ((Glob.OwnRookCount == 1) And (Glob.OwnNonQueenMajorMinorCount == 1))))
    {
        EvalMM.MatingSide = 2;
    }
    If (Not ((EvalMM.MatingSide == 0)))
    {
        If (EvalMM.MatingSide == 1)
        {
            EvalMM.MateDriveBonus = (PushToEdges[Glob.OppKingIdx] + PushClose[ChebyshevDistance[((Glob.OppKingIdx * 100) + Glob.OwnKingIdx)]]);
            EvalMM.MateCornerBonus = 0;
            If (((Glob.OwnPawnCount == 0) And (Glob.OwnQueenCount == 0)) And ((Glob.OwnRookCount == 0) And ((Glob.OwnBishopCount == 1) And (Glob.OwnNonQueenMajorMinorCount == 2))))
            {
                If (((IdxToFile[Glob.OwnSingleBishopIdx] + IdxToRank[Glob.OwnSingleBishopIdx]) % 2) == 1)
                {
                    EvalMM.MateCornerBonus = (abs((IdxToRank[Glob.OppKingIdx] - IdxToFile[Glob.OppKingIdx])) * 20);
                }
                Else
                {
                    EvalMM.MateCornerBonus = (abs(((IdxToRank[Glob.OppKingIdx] + IdxToFile[Glob.OppKingIdx]) - 9)) * 20);
                }
            }
            EvalMM.MateDriveBonus += EvalMM.MateCornerBonus;
            Ret.EvaluateMajorsMinorsImpl.Score += EvalMM.MateDriveBonus;
        }
        Else
        {
            EvalMM.MateDriveBonus = (PushToEdges[Glob.OwnKingIdx] + PushClose[ChebyshevDistance[((Glob.OppKingIdx * 100) + Glob.OwnKingIdx)]]);
            EvalMM.MateCornerBonus = 0;
            If (((Glob.OppPawnCount == 0) And (Glob.OppQueenCount == 0)) And ((Glob.OppRookCount == 0) And ((Glob.OppBishopCount == 1) And (Glob.OppNonQueenMajorMinorCount == 2))))
            {
                If (((IdxToFile[Glob.OppSingleBishopIdx] + IdxToRank[Glob.OppSingleBishopIdx]) % 2) == 1)
                {
