Define IsCheckingPiece(string Idx) (warp=true)
{
    Call IsCheckingPieceImpl(Idx)(Board[(Idx + 0)]);
    Ret.IsCheckingPiece.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
}

Define IsCheckingPieceDiscovery(string SourceIdx)(string TargetIdx)(string Ply) (warp=true)
{
    Call IsCheckingPieceImpl(SourceIdx)((GoK_OwnQueen * ((PlyIsOwn[Ply] * 2) - 1)));
    Ret.IsCheckingPieceDiscovery.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 0)
    {
        Stop(this script);
    }
    Call CalcBoardAttacked((Ply + 2));
    If (((PlyIsOwn[Ply] == 1) And (Glob.Board.IsOppSideChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.Board.IsOwnSideChecked == 1)))
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 1;
    }
    Else
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 0;
    }
}

Define IsCheckingPieceImpl(string Idx)(string Piece) (warp=true)
{
    Ret.IsCheckingPieceImpl.IsChecking = 0;
    If (abs(Piece) == GoK_OwnKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.Board.OppKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.Board.OwnKingIdx);
    }
    Ret.IsCheckingPieceImpl.IsChecking = Ret.IsReachableForAttack.IsReachable;
}

Define IsDrawByMaterial (warp=true)
{
    IsDrawByMaterial.OwnMinorCnt = 0;
    IsDrawByMaterial.OppMinorCnt = 0;
    IsDrawByMaterial.SqIdx = 1;
    Ret.IsDrawByMaterial.IsDraw = 0;
    Repeat (64)
    {
        IsDrawByMaterial.Piece = Board[IsDrawByMaterial.SqIdx];
        If (Not ((IsDrawByMaterial.Piece == 0)))
        {
            If ((IsDrawByMaterial.Piece == GoK_OwnBishop) Or (IsDrawByMaterial.Piece == GoK_OwnKnight))
            {
                IsDrawByMaterial.OwnMinorCnt += 1;
            }
            Else
            {
                If ((IsDrawByMaterial.Piece == GoK_OppBishop) Or (IsDrawByMaterial.Piece == GoK_OppKnight))
                {
                    IsDrawByMaterial.OppMinorCnt += 1;
                }
                Else
                {
                    If (Not ((abs(IsDrawByMaterial.Piece) == GoK_OwnKing)))
                    {
                        Stop(this script);
                    }
                }
            }
        }
        IsDrawByMaterial.SqIdx += 1;
    }
    If ((IsDrawByMaterial.OwnMinorCnt + IsDrawByMaterial.OppMinorCnt) < 2)
    {
        Ret.IsDrawByMaterial.IsDraw = 1;
    }
}

Define IsDrawByStalemate(string Ply) (warp=true)
{
    Call CalcBoardAttacked((Ply + 1));
    If (((PlyIsOwn[Ply] == 1) And (Glob.Board.IsOwnSideChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.Board.IsOppSideChecked == 1)))
    {
        Ret.IsDrawByStalemate.IsDraw = 0;
        Stop(this script);
    }
    List.ReplaceItem(CheckedState, Ply, 0);
    List.ReplaceItem(Quiescence, Ply, 0);
    Call CalcBoardAttackedByMove((Ply + 1))((1 == 0));
    Call StoreAttackInfo((Ply + 1))(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0))((1 == 0))((1 == 0));
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    If (Quiescence[Ply] == 0)
    {
        Glob.Stats.MoveCount += MovesCount[Ply];
    }
    Else
    {
        Glob.Stats.MoveCountQuiescence += MovesCount[Ply];
    }
    List.ReplaceItem(MovesIdx, Ply, 1);
    Ret.IsDrawByStalemate.IsDraw = 1;
    Repeat (MovesCount[Ply])
    {
        Call ApplyMove(Ply);
        Call CalcBoardAttacked((Ply + 1));
        If (((PlyIsOwn[Ply] == 1) And (Glob.Board.IsOwnSideChecked == 0)) Or ((PlyIsOwn[Ply] == 0) And (Glob.Board.IsOppSideChecked == 0)))
        {
            Ret.IsDrawByStalemate.IsDraw = 0;
            Call RevertMove(Ply);
            Stop(this script);
        }
        Call RevertMove(Ply);
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
    }
}

Define IsEngineValidMove(string Move) (warp=true)
{
    Call GenerateMovesPublic(1);
    If (Move == Const.Null)
    {
        Ret.IsEngineValidMove.IsValid = 0;
    }
    Else
    {
        If List.ContainsItem(Moves1, Move)
        {
            Ret.IsEngineValidMove.IsValid = 1;
        }
        Else
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
    }
    If (Ret.IsEngineValidMove.IsValid == 1)
    {
        Call ClearMoveList(1);
        Call AddMoveToList((Move + 0))(1)(0);
        List.ReplaceItem(MovesIdx, 1, 1);
        Glob.Board.IsOwnSideChecked = 0;
        Glob.Board.IsOppSideChecked = 0;
        Call ApplyMove(1);
        Call CalcBoardAttackedByMove(2)((1 == 0));
        If (Glob.Board.IsOwnSideChecked == 1)
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
        Call RevertMove(1);
    }
}

Define IsLosingCapture(string Ply)(string Move)(string AttackerPiece)(string VictimPiece) (warp=true)
{
    Ret.IsLosingCapture.IsLosing = 0;
    If ((Not ((Glob.Config.IsScratch3 == 1))) And (Not (((PieceIdxLookup[abs(VictimPiece)] + 1) > PieceIdxLookup[abs(AttackerPiece)]))))
    {
        Call ClearMoveList((Ply + 2));
        Call AddMoveToList(Move)((Ply + 2))(0);
        List.ReplaceItem(MovesIdx, (Ply + 2), 1);
        Call ApplyMoveLight((Ply + 2));
        Call SEE((Ply + 2))((1 == 0));
        IsLosingCapture.SeeGain = Ret.SEE.Gain;
        Call RevertMoveLight((Ply + 2));
        If (IsLosingCapture.SeeGain < ((0 - Const.SeeLosingCaptureMargin) - (abs(VictimPiece) / Const.SeeLosingCaptureVictimDivisor)))
        {
            Ret.IsLosingCapture.IsLosing = 1;
        }
    }
}

Define IsLowerCase(string Char) (warp=true)
{
    IsLowerCase.Chars = "";
    IsLowerCase.CharsIdx = 1;
    Repeat (Variable.Length(Const.CharsUpperCase))
    {
        If (Operator.LetterOf(Const.CharsUpperCase, IsLowerCase.CharsIdx) == Char)
        {
            IsLowerCase.Chars = Operator.Join(IsLowerCase.Chars, Char);
        }
        Else
        {
            IsLowerCase.Chars = Operator.Join(IsLowerCase.Chars, Operator.LetterOf(Const.CharsUpperCase, IsLowerCase.CharsIdx));
        }
        IsLowerCase.CharsIdx += 1;
    }
    Looks.SwitchCostumeTo(_ABCDEFGHIJKLMNOPQRSTUVWXYZ);
    Looks.SwitchCostumeTo(IsLowerCase.Chars);
    If (Costume.GetNumberName(number) == 1)
    {
        Ret.IsLowerCase.IsLower = 0;
    }
    Else
    {
        Ret.IsLowerCase.IsLower = 1;
    }
}

Define IsMoveLegalFast(string Ply) (warp=true)
{
    If ((CheckedState[Ply] == 1) Or (floor((AppliedMove[Ply] / 100)) == 0))
    {
        Call IsCheckedFast((Ply + 1));
        Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        IsMoveLegalFast.FromIdx = floor((AppliedMove[Ply] / 100));
        IsMoveLegalFast.ToIdx = floor((AppliedMove[Ply] % 100));
        If ((abs(SourcePieces[Ply]) == GoK_OwnKing) Or (Not ((TargetPiecesIdx[Ply] == IsMoveLegalFast.ToIdx))))
        {
            Call IsCheckedFast((Ply + 1));
            Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            Ret.IsMoveLegalFast.IsLegal = 0;
            IsMoveLegalFast.PinIdx = 1;
            Repeat (PinCount[Ply])
            {
                If (PinSq[(((Ply - 1) * Const.CheckInfoPlyStride) + IsMoveLegalFast.PinIdx)] == IsMoveLegalFast.FromIdx)
                {
                    If (Not ((abs(MovePathStepInc[((IsMoveLegalFast.FromIdx * 100) + IsMoveLegalFast.ToIdx)]) == PinRay[(((Ply - 1) * Const.CheckInfoPlyStride) + IsMoveLegalFast.PinIdx)])))
                    {
                        Ret.IsMoveLegalFast.IsLegal = 1;
                    }
                }
                IsMoveLegalFast.PinIdx += 1;
            }
            If (Glob.Profile.Mode == Const.ProfilerMode.Full)
            {
                IsMoveLegalFast.IsChecked = Ret.IsMoveLegalFast.IsLegal;
                Call IsCheckedFast((Ply + 1));
                Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
                If (Not ((IsMoveLegalFast.IsChecked == Ret.IsMoveLegalFast.IsLegal)))
                {
                    Call Log("CheckInfoMismatch legal depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(IsMoveLegalFast.IsChecked)(" old=")(Ret.IsMoveLegalFast.IsLegal);
                }
            }
        }
    }
}

Define IsMovePicked(string Ply)(string Move) (warp=true)
{
    IsMovePicked.PickedScanIdx = 1;
    Ret.IsMovePicked.Picked = 0;
    Repeat Until (IsMovePicked.PickedScanIdx > PickedPseudoLegalMovesCount[Ply])
    {
        If (PickedPseudoLegalMoves[(((Ply - 1) * Const.MaxMovesPerGeneration) + IsMovePicked.PickedScanIdx)] == Move)
        {
            Ret.IsMovePicked.Picked = 1;
            Ret.IsMovePicked.Score = PickedPseudoLegalMovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + IsMovePicked.PickedScanIdx)];
            Stop(this script);
        }
        IsMovePicked.PickedScanIdx += 1;
    }
}

Define IsOppKingCheckMate (warp=true)
{
    Ret.IsOppKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(1)((1 == 0));
    If (Glob.Board.IsOppSideChecked == 1)
    {
        Ret.IsOppKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            If (Ret.IsOppKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(2);
                Call CalcBoardAttackedByMove(1)((1 == 0));
                If (Glob.Board.IsOppSideChecked == 0)
                {
                    Ret.IsOppKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(2);
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
    }
}

Define IsOwnKingCheckMate (warp=true)
{
    Ret.IsOwnKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(2)((1 == 0));
    If (Glob.Board.IsOwnSideChecked == 1)
    {
        Ret.IsOwnKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(1);
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(1);
                Call CalcBoardAttackedByMove(2)((1 == 0));
                If (Glob.Board.IsOwnSideChecked == 0)
                {
                    Ret.IsOwnKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(1);
            }
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
}

Define IsQuiescentCheckCond(string Ply) (warp=true)
{
    Call //("Quiescence search extension for checking moves, esp. check sequences. Return value defined whether check sequences should pursued at this point");
    Ret.IsQuiescentCheckCond.IsTrue = 0;
    If (1 == 0)
    {
        If (Glob.Config.IsScratch3 == 0)
        {
            If ((Quiescence[Ply] == 1) And (Quiescence[(Ply - 1)] == 0))
            {
                Ret.IsQuiescentCheckCond.IsTrue = 1;
            }
        }
    }
}

Define IsQuietMove(string Move) (warp=true)
{
    Ret.IsQuietMove.IsQuiet = 0;
    IsQuietMove.FromIdx = floor((Move / 100));
    IsQuietMove.ToIdx = floor((Move % 100));
    If (IsQuietMove.FromIdx == 0)
    {
        Ret.IsQuietMove.IsQuiet = 1;
        Stop(this script);
    }
    If (Not ((Move == Const.Null)))
    {
        If (Not ((Board[IsQuietMove.ToIdx] == 0)))
        {
            Stop(this script);
        }
        If (Not ((Move == floor(Move))))
        {
            Stop(this script);
        }
        If (abs(Board[IsQuietMove.FromIdx]) == GoK_OwnPawn)
        {
            If (Not ((IdxToFile[IsQuietMove.FromIdx] == IdxToFile[IsQuietMove.ToIdx])))
            {
                Stop(this script);
            }
        }
        Ret.IsQuietMove.IsQuiet = 1;
    }
}

Define IsReachableForAttack(string Piece)(string FromIdx)(string ToIdx) (warp=true)
{
    Ret.IsReachableForAttack.IsReachable = 0;
    IsReachableForAttack.PieceAbs = abs(Piece);
    IsReachableForAttack.LegalMoveKey = ((PieceIdxLookup[IsReachableForAttack.PieceAbs] * 10000) + ((FromIdx * 100) + ToIdx));
    If (Piece < 0)
    {
        IsReachableForAttack.LegalMoveKey += Const.MovePosLookupOppBaseIdx;
    }
    If (MovePosLookupLegal[IsReachableForAttack.LegalMoveKey] == 0)
    {
        Stop(this script);
    }
    If (IsReachableForAttack.PieceAbs == GoK_OwnPawn)
    {
        If (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))
        {
            Ret.IsReachableForAttack.IsReachable = 1;
        }
        Stop(this script);
    }
    If ((IsReachableForAttack.PieceAbs == GoK_OwnKnight) Or (IsReachableForAttack.PieceAbs == GoK_OwnKing))
    {
        Ret.IsReachableForAttack.IsReachable = 1;
        Stop(this script);
    }
    IsReachableForAttack.Idx = ((FromIdx * 100) + ToIdx);
    IsReachableForAttack.SourceIdx = FromIdx;
    Repeat ((MovePathDelta[IsReachableForAttack.Idx] - 1))
    {
        IsReachableForAttack.SourceIdx += MovePathStepInc[IsReachableForAttack.Idx];
        If (Not ((Board[IsReachableForAttack.SourceIdx] == 0)))
        {
            Stop(this script);
        }
    }
    Ret.IsReachableForAttack.IsReachable = 1;
}

Define KingSafeChecks(string Side)(string TargetIdx)(string FoundMask)(string AttackerCount)(string DefenderCount)(string DefenderPieceAbs) (warp=true)
{
    KingSafeChecks.Mask = FoundMask;
    KingSafeChecks.RookFired = 0;
    KingSafeChecks.QueenFired = 0;
    KingSafeChecks.OrderIdx = 0;
    Repeat (4)
    {
        KingSafeChecks.OrderIdx += 1;
        KingSafeChecks.PieceAbs = (SafeCheckPieceOrder[KingSafeChecks.OrderIdx] + 0);
        KingSafeChecks.PieceIdx = PieceIdxLookup[KingSafeChecks.PieceAbs];
        If (Not (((KingSafeChecks.PieceAbs == (GoK_OwnQueen + 0)) And (KingSafeChecks.RookFired == 1))))
        {
            KingSafeChecks.SafeCheckWeight = (AttackTypeMaskWeights[(KingSafeChecks.PieceIdx - 1)] + 0);
            KingSafeChecks.AttackWeight = (AttackTypeMaskWeights[KingSafeChecks.PieceIdx] + 0);
            If ((floor((KingSafeChecks.Mask / KingSafeChecks.AttackWeight)) - (10 * floor((KingSafeChecks.Mask / (KingSafeChecks.AttackWeight * 10))))) > 0)
            {
                If (Side == 1)
                {
                    KingSafeChecks.KingIdx = Glob.Board.OwnKingIdx;
                }
                Else
                {
                    KingSafeChecks.KingIdx = Glob.Board.OppKingIdx;
                }
                KingSafeChecks.IsSlider = ((KingSafeChecks.PieceAbs > (GoK_OwnKnight + 0)) + 0);
                KingSafeChecks.IsUnsafe = ((KingSafeChecks.PieceAbs < (GoK_OwnQueen + 0)) + 0);
                KingSafeChecks.Move = ((TargetIdx * 100) + KingSafeChecks.KingIdx);
                KingSafeChecks.LegalMoveKey = ((KingSafeChecks.PieceIdx * 10000) + KingSafeChecks.Move);
                If (MovePosLookupLegal[(KingSafeChecks.LegalMoveKey + (Const.MovePosLookupOppBaseIdx * (Side == 1)))] == 1)
                {
                    KingSafeChecks.TargetPiece = (Board[(TargetIdx + 0)] + 0);
                    KingSafeChecks.AttackerOccupied = 1;
                    If (((Side == 1) And (Not ((KingSafeChecks.TargetPiece < 0)))) Or ((Side == 2) And (Not ((KingSafeChecks.TargetPiece > 0)))))
                    {
                        KingSafeChecks.AttackerOccupied = 0;
                    }
                    KingSafeChecks.Found = 1;
                    If (KingSafeChecks.IsSlider == 1)
                    {
                        KingSafeChecks.SourceIdx = TargetIdx;
                        KingSafeChecks.RayStep = MovePathStepInc[KingSafeChecks.Move];
                        Repeat Until ((KingSafeChecks.Found == 0) Or ((KingSafeChecks.SourceIdx + KingSafeChecks.RayStep) == (KingSafeChecks.KingIdx + 0)))
                        {
                            KingSafeChecks.SourceIdx += KingSafeChecks.RayStep;
                            If (Not (((Board[KingSafeChecks.SourceIdx] + 0) == 0)))
                            {
                                If (Not ((((Side == 1) And ((Board[KingSafeChecks.SourceIdx] + 0) == (GoK_OwnQueen + 0))) Or ((Side == 2) And ((Board[KingSafeChecks.SourceIdx] + 0) == (GoK_OppQueen + 0))))))
                                {
                                    KingSafeChecks.Found = 0;
                                }
                            }
                        }
                    }
                    If (KingSafeChecks.Found == 1)
                    {
                        KingSafeChecks.IsWeak = ((((DefenderCount + 0) == 0) Or (((DefenderCount + 0) < 2) And ((DefenderPieceAbs + 0) > (GoK_OwnRook + 0)))) + 0);
                        If ((((((DefenderCount + 0) == 0) Or ((KingSafeChecks.IsWeak == 1) And ((AttackerCount + 0) > 1))) And (Not (((KingSafeChecks.PieceAbs == (GoK_OwnQueen + 0)) And ((DefenderPieceAbs + 0) == (GoK_OwnQueen + 0)))))) And (KingSafeChecks.AttackerOccupied == 0)) And (Not (((KingSafeChecks.PieceAbs == (GoK_OwnBishop + 0)) And (KingSafeChecks.QueenFired == 1)))))
                        {
                            List.ReplaceItem(KingAttackSafeChecks, (Side + 0), (KingAttackSafeChecks[(Side + 0)] + KingSafeChecks.SafeCheckWeight));
                            If (KingSafeChecks.PieceAbs == (GoK_OwnRook + 0))
                            {
                                KingSafeChecks.RookFired = 1;
                            }
                            If (KingSafeChecks.PieceAbs == (GoK_OwnQueen + 0))
                            {
                                KingSafeChecks.QueenFired = 1;
                            }
                        }
                        Else
                        {
                            If (KingSafeChecks.IsUnsafe == 1)
                            {
                                List.Add(KingUnsafeCheckSquares, ((TargetIdx * 10) + KingSafeChecks.PieceIdx));
                            }
                        }
                    }
                }
            }
        }
    }
}

Define LoadInternalBoard (warp=true)
{
    LoadInternalBoard.SqIdx = 1;
    Repeat (64)
    {
        If (Glob.Game.IsPlayerBlack == 1)
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, (0 - GoK_Board[RankFlipIdx[LoadInternalBoard.SqIdx]]));
        }
        Else
        {
            List.ReplaceItem(Board, LoadInternalBoard.SqIdx, GoK_Board[LoadInternalBoard.SqIdx]);
        }
        LoadInternalBoard.SqIdx += 1;
    }
}

