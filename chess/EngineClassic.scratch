Define EvalEndgame.KRKP(string Ply)(string StrongSide) (warp=true)
{
    Call EvalEndgame.Locate(StrongSide);
    Call EvalEndgame.StrongToMove(Ply)(StrongSide);
    EvalEndgame.KRKP.IsStrongToMove = Ret.EvalEndgame.StrongToMove.IsStrongToMove;
    EvalEndgame.KRKP.StrongKingIdx = Ret.EvalEndgame.Locate.StrongKingIdx;
    EvalEndgame.KRKP.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
    EvalEndgame.KRKP.StrongRookIdx = Ret.EvalEndgame.Locate.StrongRookIdx;
    EvalEndgame.KRKP.WeakPawnIdx = Ret.EvalEndgame.Locate.WeakPawnIdx;
    EvalEndgame.KRKP.RelativeRankBase = Ret.EvalEndgame.Locate.RelativeRankBase;
    EvalEndgame.KRKP.RelativeRankSign = Ret.EvalEndgame.Locate.RelativeRankSign;
    EvalEndgame.KRKP.StrongKingRelativeRank = (EvalEndgame.KRKP.RelativeRankBase + (EvalEndgame.KRKP.RelativeRankSign * IdxToRank[EvalEndgame.KRKP.StrongKingIdx]));
    EvalEndgame.KRKP.WeakKingRelativeRank = (EvalEndgame.KRKP.RelativeRankBase + (EvalEndgame.KRKP.RelativeRankSign * IdxToRank[EvalEndgame.KRKP.WeakKingIdx]));
    EvalEndgame.KRKP.WeakPawnRelativeRank = (EvalEndgame.KRKP.RelativeRankBase + (EvalEndgame.KRKP.RelativeRankSign * IdxToRank[EvalEndgame.KRKP.WeakPawnIdx]));
    EvalEndgame.KRKP.StrongKingPawnDistance = ChebyshevDistance[((EvalEndgame.KRKP.StrongKingIdx * 100) + EvalEndgame.KRKP.WeakPawnIdx)];
    EvalEndgame.KRKP.WeakKingPawnDistance = ChebyshevDistance[((EvalEndgame.KRKP.WeakKingIdx * 100) + EvalEndgame.KRKP.WeakPawnIdx)];
    EvalEndgame.KRKP.WeakKingRookDistance = ChebyshevDistance[((EvalEndgame.KRKP.WeakKingIdx * 100) + EvalEndgame.KRKP.StrongRookIdx)];
    EvalEndgame.KRKP.IsStrongKingInFrontOfPawn = 0;
    If ((IdxToFile[EvalEndgame.KRKP.WeakPawnIdx] == IdxToFile[EvalEndgame.KRKP.StrongKingIdx]) And (EvalEndgame.KRKP.WeakPawnRelativeRank > EvalEndgame.KRKP.StrongKingRelativeRank))
    {
        EvalEndgame.KRKP.IsStrongKingInFrontOfPawn = 1;
    }
    EvalEndgame.KRKP.IsWeakKingTooFar = 0;
    If ((Not (((EvalEndgame.KRKP.WeakKingPawnDistance + EvalEndgame.KRKP.IsStrongToMove) < 4))) And (Not ((EvalEndgame.KRKP.WeakKingRookDistance < 3))))
    {
        EvalEndgame.KRKP.IsWeakKingTooFar = 1;
    }
    EvalEndgame.KRKP.IsPawnSupportedFarAdvanced = 0;
    If ((EvalEndgame.KRKP.WeakKingRelativeRank < 3) And (EvalEndgame.KRKP.WeakKingPawnDistance == 1))
    {
        If ((EvalEndgame.KRKP.StrongKingRelativeRank > 2) And ((EvalEndgame.KRKP.StrongKingPawnDistance - EvalEndgame.KRKP.IsStrongToMove) > 2))
        {
            EvalEndgame.KRKP.IsPawnSupportedFarAdvanced = 1;
        }
    }
    If ((EvalEndgame.KRKP.IsStrongKingInFrontOfPawn == 1) Or (EvalEndgame.KRKP.IsWeakKingTooFar == 1))
    {
        Ret.EvalEndgame.KRKP.Score = (1380 - EvalEndgame.KRKP.StrongKingPawnDistance);
    }
    Else
    {
        If (EvalEndgame.KRKP.IsPawnSupportedFarAdvanced == 1)
        {
            Ret.EvalEndgame.KRKP.Score = (80 - (8 * EvalEndgame.KRKP.StrongKingPawnDistance));
        }
        Else
        {
            EvalEndgame.KRKP.PushSqIdx = (EvalEndgame.KRKP.WeakPawnIdx - Ret.EvalEndgame.Locate.PawnPushIdxDelta);
            EvalEndgame.KRKP.QueeningSqIdx = (EvalEndgame.KRKP.WeakPawnIdx - (Ret.EvalEndgame.Locate.PawnPushIdxDelta * EvalEndgame.KRKP.WeakPawnRelativeRank));
            EvalEndgame.KRKP.StrongKingPushDistance = ChebyshevDistance[((EvalEndgame.KRKP.StrongKingIdx * 100) + EvalEndgame.KRKP.PushSqIdx)];
            EvalEndgame.KRKP.WeakKingPushDistance = ChebyshevDistance[((EvalEndgame.KRKP.WeakKingIdx * 100) + EvalEndgame.KRKP.PushSqIdx)];
            EvalEndgame.KRKP.PawnQueeningDistance = ChebyshevDistance[((EvalEndgame.KRKP.WeakPawnIdx * 100) + EvalEndgame.KRKP.QueeningSqIdx)];
            Ret.EvalEndgame.KRKP.Score = (200 - (8 * ((EvalEndgame.KRKP.StrongKingPushDistance - EvalEndgame.KRKP.WeakKingPushDistance) - EvalEndgame.KRKP.PawnQueeningDistance)));
        }
    }
}

Define EvalEndgame.KRPKB(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KRPKB.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    EvalEndgame.KRPKB.PawnIdx = Ret.EvalEndgame.Locate.StrongPawnIdx;
    If ((IdxToFile[EvalEndgame.KRPKB.PawnIdx] == 1) Or (IdxToFile[EvalEndgame.KRPKB.PawnIdx] == 8))
    {
        EvalEndgame.KRPKB.Push = Ret.EvalEndgame.Locate.PawnPushIdxDelta;
        EvalEndgame.KRPKB.Rank = (Ret.EvalEndgame.Locate.RelativeRankBase + (Ret.EvalEndgame.Locate.RelativeRankSign * IdxToRank[EvalEndgame.KRPKB.PawnIdx]));
        EvalEndgame.KRPKB.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
        EvalEndgame.KRPKB.WeakBishopIdx = Ret.EvalEndgame.Locate.WeakBishopIdx;
        EvalEndgame.KRPKB.StrongKingIdx = Ret.EvalEndgame.Locate.StrongKingIdx;
        If ((EvalEndgame.KRPKB.Rank == 4) And (((IdxToFile[EvalEndgame.KRPKB.WeakBishopIdx] + IdxToRank[EvalEndgame.KRPKB.WeakBishopIdx]) % 2) == ((IdxToFile[EvalEndgame.KRPKB.PawnIdx] + IdxToRank[EvalEndgame.KRPKB.PawnIdx]) % 2)))
        {
            EvalEndgame.KRPKB.Dist = ChebyshevDistance[(((EvalEndgame.KRPKB.PawnIdx + (3 * EvalEndgame.KRPKB.Push)) * 100) + EvalEndgame.KRPKB.WeakKingIdx)];
            If ((EvalEndgame.KRPKB.Dist < 3) And (Not (((EvalEndgame.KRPKB.Dist == 0) And (EvalEndgame.KRPKB.WeakKingIdx == (EvalEndgame.KRPKB.StrongKingIdx + (2 * EvalEndgame.KRPKB.Push)))))))
            {
                Ret.EvalEndgame.KRPKB.Factor = 24;
            }
            Else
            {
                Ret.EvalEndgame.KRPKB.Factor = 48;
            }
            Stop(this script);
        }
        If (((EvalEndgame.KRPKB.Rank == 5) And (ChebyshevDistance[(((EvalEndgame.KRPKB.PawnIdx + (2 * EvalEndgame.KRPKB.Push)) * 100) + EvalEndgame.KRPKB.WeakKingIdx)] < 2)) And ((abs((IdxToFile[EvalEndgame.KRPKB.WeakBishopIdx] - IdxToFile[(EvalEndgame.KRPKB.PawnIdx + EvalEndgame.KRPKB.Push)])) == abs((IdxToRank[EvalEndgame.KRPKB.WeakBishopIdx] - IdxToRank[(EvalEndgame.KRPKB.PawnIdx + EvalEndgame.KRPKB.Push)]))) And (abs((IdxToFile[EvalEndgame.KRPKB.WeakBishopIdx] - IdxToFile[EvalEndgame.KRPKB.PawnIdx])) > 1)))
        {
            Ret.EvalEndgame.KRPKB.Factor = 8;
        }
    }
}

Define EvalEndgame.KRPKR(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KRPKR.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    Call EvalEndgame.StrongToMove(Ply)(StrongSide);
    EvalEndgame.KRPKR.IsStrongToMove = Ret.EvalEndgame.StrongToMove.IsStrongToMove;
    EvalEndgame.KRPKR.StrongKingIdx = Ret.EvalEndgame.Locate.StrongKingIdx;
    EvalEndgame.KRPKR.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
    EvalEndgame.KRPKR.StrongRookIdx = Ret.EvalEndgame.Locate.StrongRookIdx;
    EvalEndgame.KRPKR.WeakRookIdx = Ret.EvalEndgame.Locate.WeakRookIdx;
    EvalEndgame.KRPKR.PawnIdx = Ret.EvalEndgame.Locate.StrongPawnIdx;
    EvalEndgame.KRPKR.RankBase = Ret.EvalEndgame.Locate.RelativeRankBase;
    EvalEndgame.KRPKR.RankSign = Ret.EvalEndgame.Locate.RelativeRankSign;
    EvalEndgame.KRPKR.FileBase = -1;
    EvalEndgame.KRPKR.FileSign = 1;
    If (IdxToFile[EvalEndgame.KRPKR.PawnIdx] > 4)
    {
        EvalEndgame.KRPKR.FileBase = 8;
        EvalEndgame.KRPKR.FileSign = -1;
    }
    EvalEndgame.KRPKR.PawnFile = (EvalEndgame.KRPKR.FileBase + (EvalEndgame.KRPKR.FileSign * IdxToFile[EvalEndgame.KRPKR.PawnIdx]));
    EvalEndgame.KRPKR.PawnRank = (EvalEndgame.KRPKR.RankBase + (EvalEndgame.KRPKR.RankSign * IdxToRank[EvalEndgame.KRPKR.PawnIdx]));
    EvalEndgame.KRPKR.StrongKingFile = (EvalEndgame.KRPKR.FileBase + (EvalEndgame.KRPKR.FileSign * IdxToFile[EvalEndgame.KRPKR.StrongKingIdx]));
    EvalEndgame.KRPKR.StrongKingRank = (EvalEndgame.KRPKR.RankBase + (EvalEndgame.KRPKR.RankSign * IdxToRank[EvalEndgame.KRPKR.StrongKingIdx]));
    EvalEndgame.KRPKR.StrongRookFile = (EvalEndgame.KRPKR.FileBase + (EvalEndgame.KRPKR.FileSign * IdxToFile[EvalEndgame.KRPKR.StrongRookIdx]));
    EvalEndgame.KRPKR.StrongRookRank = (EvalEndgame.KRPKR.RankBase + (EvalEndgame.KRPKR.RankSign * IdxToRank[EvalEndgame.KRPKR.StrongRookIdx]));
    EvalEndgame.KRPKR.WeakKingFile = (EvalEndgame.KRPKR.FileBase + (EvalEndgame.KRPKR.FileSign * IdxToFile[EvalEndgame.KRPKR.WeakKingIdx]));
    EvalEndgame.KRPKR.WeakKingRank = (EvalEndgame.KRPKR.RankBase + (EvalEndgame.KRPKR.RankSign * IdxToRank[EvalEndgame.KRPKR.WeakKingIdx]));
    EvalEndgame.KRPKR.WeakRookFile = (EvalEndgame.KRPKR.FileBase + (EvalEndgame.KRPKR.FileSign * IdxToFile[EvalEndgame.KRPKR.WeakRookIdx]));
    EvalEndgame.KRPKR.WeakRookRank = (EvalEndgame.KRPKR.RankBase + (EvalEndgame.KRPKR.RankSign * IdxToRank[EvalEndgame.KRPKR.WeakRookIdx]));
    EvalEndgame.KRPKR.QueeningSqIdx = (EvalEndgame.KRPKR.PawnIdx + (Ret.EvalEndgame.Locate.PawnPushIdxDelta * (7 - EvalEndgame.KRPKR.PawnRank)));
    EvalEndgame.KRPKR.PushSqIdx = (EvalEndgame.KRPKR.PawnIdx + Ret.EvalEndgame.Locate.PawnPushIdxDelta);
    EvalEndgame.KRPKR.WeakKingQueeningDistance = ChebyshevDistance[((EvalEndgame.KRPKR.WeakKingIdx * 100) + EvalEndgame.KRPKR.QueeningSqIdx)];
    EvalEndgame.KRPKR.StrongKingQueeningDistance = ChebyshevDistance[((EvalEndgame.KRPKR.StrongKingIdx * 100) + EvalEndgame.KRPKR.QueeningSqIdx)];
    EvalEndgame.KRPKR.StrongKingPawnDistance = ChebyshevDistance[((EvalEndgame.KRPKR.StrongKingIdx * 100) + EvalEndgame.KRPKR.PawnIdx)];
    EvalEndgame.KRPKR.WeakKingStrongRookDistance = ChebyshevDistance[((EvalEndgame.KRPKR.WeakKingIdx * 100) + EvalEndgame.KRPKR.StrongRookIdx)];
    EvalEndgame.KRPKR.IsWeakKingAtQueening = 0;
    If (EvalEndgame.KRPKR.WeakKingQueeningDistance < 2)
    {
        EvalEndgame.KRPKR.IsWeakKingAtQueening = 1;
    }
    If (((EvalEndgame.KRPKR.PawnRank < 5) And (EvalEndgame.KRPKR.IsWeakKingAtQueening == 1)) And (EvalEndgame.KRPKR.StrongKingRank < 5))
    {
        If ((EvalEndgame.KRPKR.WeakRookRank == 5) Or ((EvalEndgame.KRPKR.PawnRank < 3) And (Not ((EvalEndgame.KRPKR.StrongRookRank == 5)))))
        {
            Ret.EvalEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    If (((EvalEndgame.KRPKR.PawnRank == 5) And (EvalEndgame.KRPKR.IsWeakKingAtQueening == 1)) And ((EvalEndgame.KRPKR.StrongKingRank + EvalEndgame.KRPKR.IsStrongToMove) < 6))
    {
        If ((EvalEndgame.KRPKR.WeakRookRank == 0) Or ((EvalEndgame.KRPKR.IsStrongToMove == 0) And (abs((EvalEndgame.KRPKR.WeakRookFile - EvalEndgame.KRPKR.PawnFile)) > 2)))
        {
            Ret.EvalEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    If (((EvalEndgame.KRPKR.PawnRank > 4) And (EvalEndgame.KRPKR.WeakKingIdx == EvalEndgame.KRPKR.QueeningSqIdx)) And (EvalEndgame.KRPKR.WeakRookRank == 0))
    {
        If ((EvalEndgame.KRPKR.IsStrongToMove == 0) Or (EvalEndgame.KRPKR.StrongKingPawnDistance > 1))
        {
            Ret.EvalEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    EvalEndgame.KRPKR.IsPawnA7RookA8 = 0;
    If (((EvalEndgame.KRPKR.PawnFile == 0) And (EvalEndgame.KRPKR.PawnRank == 6)) And ((EvalEndgame.KRPKR.StrongRookFile == 0) And (EvalEndgame.KRPKR.StrongRookRank == 7)))
    {
        EvalEndgame.KRPKR.IsPawnA7RookA8 = 1;
    }
    If (((EvalEndgame.KRPKR.IsPawnA7RookA8 == 1) And (EvalEndgame.KRPKR.WeakKingRank == 6)) And ((EvalEndgame.KRPKR.WeakKingFile > 5) And (EvalEndgame.KRPKR.WeakRookFile == 0)))
    {
        If (((EvalEndgame.KRPKR.WeakRookRank < 3) Or (EvalEndgame.KRPKR.StrongKingFile > 2)) Or (EvalEndgame.KRPKR.StrongKingRank < 5))
        {
            Ret.EvalEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    If (((EvalEndgame.KRPKR.PawnRank < 5) And (EvalEndgame.KRPKR.WeakKingIdx == EvalEndgame.KRPKR.PushSqIdx)) And ((EvalEndgame.KRPKR.StrongKingPawnDistance - EvalEndgame.KRPKR.IsStrongToMove) > 1))
    {
        If ((ChebyshevDistance[((EvalEndgame.KRPKR.StrongKingIdx * 100) + EvalEndgame.KRPKR.WeakRookIdx)] - EvalEndgame.KRPKR.IsStrongToMove) > 1)
        {
            Ret.EvalEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    EvalEndgame.KRPKR.IsRookBehindPawn = 0;
    If (((Not ((EvalEndgame.KRPKR.PawnFile == 0))) And (EvalEndgame.KRPKR.StrongRookFile == EvalEndgame.KRPKR.PawnFile)) And (EvalEndgame.KRPKR.StrongRookRank < EvalEndgame.KRPKR.PawnRank))
    {
        EvalEndgame.KRPKR.IsRookBehindPawn = 1;
    }
    EvalEndgame.KRPKR.IsStrongKingCloserToQueening = 0;
    If (EvalEndgame.KRPKR.StrongKingQueeningDistance < ((EvalEndgame.KRPKR.WeakKingQueeningDistance - 2) + EvalEndgame.KRPKR.IsStrongToMove))
    {
        EvalEndgame.KRPKR.IsStrongKingCloserToQueening = 1;
    }
    If ((((EvalEndgame.KRPKR.PawnRank == 6) And (Not ((EvalEndgame.KRPKR.PawnFile == 0)))) And ((EvalEndgame.KRPKR.StrongRookFile == EvalEndgame.KRPKR.PawnFile) And (Not ((EvalEndgame.KRPKR.StrongRookIdx == EvalEndgame.KRPKR.QueeningSqIdx))))) And (EvalEndgame.KRPKR.IsStrongKingCloserToQueening == 1))
    {
        If (EvalEndgame.KRPKR.StrongKingQueeningDistance < (EvalEndgame.KRPKR.WeakKingStrongRookDistance + EvalEndgame.KRPKR.IsStrongToMove))
        {
            Ret.EvalEndgame.KRPKR.Factor = (128 - (2 * EvalEndgame.KRPKR.StrongKingQueeningDistance));
            Stop(this script);
        }
    }
    If ((EvalEndgame.KRPKR.IsRookBehindPawn == 1) And (EvalEndgame.KRPKR.IsStrongKingCloserToQueening == 1))
    {
        EvalEndgame.KRPKR.StrongKingPushDistance = ChebyshevDistance[((EvalEndgame.KRPKR.StrongKingIdx * 100) + EvalEndgame.KRPKR.PushSqIdx)];
        EvalEndgame.KRPKR.WeakKingPushDistance = ChebyshevDistance[((EvalEndgame.KRPKR.WeakKingIdx * 100) + EvalEndgame.KRPKR.PushSqIdx)];
        If (EvalEndgame.KRPKR.StrongKingPushDistance < ((EvalEndgame.KRPKR.WeakKingPushDistance - 2) + EvalEndgame.KRPKR.IsStrongToMove))
        {
            EvalEndgame.KRPKR.IsWeakKingAwayFromRook = 0;
            If (Not (((EvalEndgame.KRPKR.WeakKingStrongRookDistance + EvalEndgame.KRPKR.IsStrongToMove) < 3)))
            {
                EvalEndgame.KRPKR.IsWeakKingAwayFromRook = 1;
            }
            If ((EvalEndgame.KRPKR.StrongKingQueeningDistance < (EvalEndgame.KRPKR.WeakKingStrongRookDistance + EvalEndgame.KRPKR.IsStrongToMove)) And (EvalEndgame.KRPKR.StrongKingPushDistance < (ChebyshevDistance[((EvalEndgame.KRPKR.WeakKingIdx * 100) + EvalEndgame.KRPKR.PawnIdx)] + EvalEndgame.KRPKR.IsStrongToMove)))
            {
                EvalEndgame.KRPKR.IsWeakKingAwayFromRook = 1;
            }
            If (EvalEndgame.KRPKR.IsWeakKingAwayFromRook == 1)
            {
                EvalEndgame.KRPKR.PawnQueeningDistance = ChebyshevDistance[((EvalEndgame.KRPKR.PawnIdx * 100) + EvalEndgame.KRPKR.QueeningSqIdx)];
                Ret.EvalEndgame.KRPKR.Factor = ((128 - (8 * EvalEndgame.KRPKR.PawnQueeningDistance)) - (2 * EvalEndgame.KRPKR.StrongKingQueeningDistance));
                Stop(this script);
            }
        }
    }
    EvalEndgame.KRPKR.WeakKingSqNumber = ((EvalEndgame.KRPKR.WeakKingRank * 8) + EvalEndgame.KRPKR.WeakKingFile);
    EvalEndgame.KRPKR.PawnSqNumber = ((EvalEndgame.KRPKR.PawnRank * 8) + EvalEndgame.KRPKR.PawnFile);
    If ((EvalEndgame.KRPKR.PawnRank < 4) And (EvalEndgame.KRPKR.WeakKingSqNumber > EvalEndgame.KRPKR.PawnSqNumber))
    {
        If (EvalEndgame.KRPKR.WeakKingFile == EvalEndgame.KRPKR.PawnFile)
        {
            Ret.EvalEndgame.KRPKR.Factor = 10;
            Stop(this script);
        }
        EvalEndgame.KRPKR.KingDistance = ChebyshevDistance[((EvalEndgame.KRPKR.StrongKingIdx * 100) + EvalEndgame.KRPKR.WeakKingIdx)];
        If ((abs((EvalEndgame.KRPKR.WeakKingFile - EvalEndgame.KRPKR.PawnFile)) == 1) And (EvalEndgame.KRPKR.KingDistance > 2))
        {
            Ret.EvalEndgame.KRPKR.Factor = (24 - (2 * EvalEndgame.KRPKR.KingDistance));
        }
    }
}

Define EvalEndgame.KRPPKRP(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.KRPPKRP.Factor = Const.Null;
    Call EvalEndgame.Locate(StrongSide);
    EvalEndgame.KRPPKRP.RankBase = Ret.EvalEndgame.Locate.RelativeRankBase;
    EvalEndgame.KRPPKRP.RankSign = Ret.EvalEndgame.Locate.RelativeRankSign;
    EvalEndgame.KRPPKRP.PawnIdx = Ret.EvalEndgame.Locate.StrongPawnIdx;
    EvalEndgame.KRPPKRP.SecondPawnIdx = Ret.EvalEndgame.Locate.SecondStrongPawnIdx;
    EvalEndgame.KRPPKRP.WeakPawnIdx = Ret.EvalEndgame.Locate.WeakPawnIdx;
    EvalEndgame.KRPPKRP.WeakKingIdx = Ret.EvalEndgame.Locate.WeakKingIdx;
    EvalEndgame.KRPPKRP.PawnRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.PawnIdx]));
    EvalEndgame.KRPPKRP.SecondPawnRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.SecondPawnIdx]));
    EvalEndgame.KRPPKRP.WeakPawnRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.WeakPawnIdx]));
    EvalEndgame.KRPPKRP.WeakPawnFile = IdxToFile[EvalEndgame.KRPPKRP.WeakPawnIdx];
    EvalEndgame.KRPPKRP.IsPawnBlocked = 0;
    If ((abs((EvalEndgame.KRPPKRP.WeakPawnFile - IdxToFile[EvalEndgame.KRPPKRP.PawnIdx])) < 2) And (EvalEndgame.KRPPKRP.WeakPawnRank > EvalEndgame.KRPPKRP.PawnRank))
    {
        EvalEndgame.KRPPKRP.IsPawnBlocked = 1;
    }
    EvalEndgame.KRPPKRP.IsSecondPawnBlocked = 0;
    If ((abs((EvalEndgame.KRPPKRP.WeakPawnFile - IdxToFile[EvalEndgame.KRPPKRP.SecondPawnIdx])) < 2) And (EvalEndgame.KRPPKRP.WeakPawnRank > EvalEndgame.KRPPKRP.SecondPawnRank))
    {
        EvalEndgame.KRPPKRP.IsSecondPawnBlocked = 1;
    }
    If ((EvalEndgame.KRPPKRP.IsPawnBlocked == 0) Or (EvalEndgame.KRPPKRP.IsSecondPawnBlocked == 0))
    {
        Stop(this script);
    }
    EvalEndgame.KRPPKRP.FrontPawnRank = EvalEndgame.KRPPKRP.PawnRank;
    If (EvalEndgame.KRPPKRP.SecondPawnRank > EvalEndgame.KRPPKRP.FrontPawnRank)
    {
        EvalEndgame.KRPPKRP.FrontPawnRank = EvalEndgame.KRPPKRP.SecondPawnRank;
    }
    EvalEndgame.KRPPKRP.WeakKingFile = IdxToFile[EvalEndgame.KRPPKRP.WeakKingIdx];
    EvalEndgame.KRPPKRP.WeakKingRank = (EvalEndgame.KRPPKRP.RankBase + (EvalEndgame.KRPPKRP.RankSign * IdxToRank[EvalEndgame.KRPPKRP.WeakKingIdx]));
    If ((abs((EvalEndgame.KRPPKRP.WeakKingFile - IdxToFile[EvalEndgame.KRPPKRP.PawnIdx])) < 2) And (abs((EvalEndgame.KRPPKRP.WeakKingFile - IdxToFile[EvalEndgame.KRPPKRP.SecondPawnIdx])) < 2))
    {
        If (EvalEndgame.KRPPKRP.WeakKingRank > EvalEndgame.KRPPKRP.FrontPawnRank)
        {
            Ret.EvalEndgame.KRPPKRP.Factor = (7 * EvalEndgame.KRPPKRP.FrontPawnRank);
        }
    }
}

Define EvalEndgame.Locate(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.Locate.StrongPawnIdx = 0;
    Ret.EvalEndgame.Locate.SecondStrongPawnIdx = 0;
    Ret.EvalEndgame.Locate.StrongBishopIdx = 0;
    Ret.EvalEndgame.Locate.StrongRookIdx = 0;
    Ret.EvalEndgame.Locate.WeakPawnIdx = 0;
    Ret.EvalEndgame.Locate.WeakBishopIdx = 0;
    Ret.EvalEndgame.Locate.WeakKnightIdx = 0;
    Ret.EvalEndgame.Locate.WeakRookIdx = 0;
    EvalEndgame.Locate.SqIdx = 1;
    Repeat (64)
    {
        EvalEndgame.Locate.StrongViewPiece = (Board[EvalEndgame.Locate.SqIdx] * StrongSide);
        If (EvalEndgame.Locate.StrongViewPiece == GoK_OwnPawn)
        {
            If (Ret.EvalEndgame.Locate.StrongPawnIdx == 0)
            {
                Ret.EvalEndgame.Locate.StrongPawnIdx = EvalEndgame.Locate.SqIdx;
            }
            Else
            {
                Ret.EvalEndgame.Locate.SecondStrongPawnIdx = EvalEndgame.Locate.SqIdx;
            }
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_OwnBishop)
        {
            Ret.EvalEndgame.Locate.StrongBishopIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_OwnRook)
        {
            Ret.EvalEndgame.Locate.StrongRookIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_OppPawn)
        {
            Ret.EvalEndgame.Locate.WeakPawnIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_OppBishop)
        {
            Ret.EvalEndgame.Locate.WeakBishopIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_OppKnight)
        {
            Ret.EvalEndgame.Locate.WeakKnightIdx = EvalEndgame.Locate.SqIdx;
        }
        If (EvalEndgame.Locate.StrongViewPiece == GoK_OppRook)
        {
            Ret.EvalEndgame.Locate.WeakRookIdx = EvalEndgame.Locate.SqIdx;
        }
        EvalEndgame.Locate.SqIdx += 1;
    }
    If (StrongSide == 1)
    {
        Ret.EvalEndgame.Locate.StrongKingIdx = Glob.Board.OwnKingIdx;
        Ret.EvalEndgame.Locate.WeakKingIdx = Glob.Board.OppKingIdx;
        Ret.EvalEndgame.Locate.RelativeRankBase = -1;
        Ret.EvalEndgame.Locate.RelativeRankSign = 1;
        Ret.EvalEndgame.Locate.PawnPushIdxDelta = 8;
    }
    Else
    {
        Ret.EvalEndgame.Locate.StrongKingIdx = Glob.Board.OppKingIdx;
        Ret.EvalEndgame.Locate.WeakKingIdx = Glob.Board.OwnKingIdx;
        Ret.EvalEndgame.Locate.RelativeRankBase = 8;
        Ret.EvalEndgame.Locate.RelativeRankSign = -1;
        Ret.EvalEndgame.Locate.PawnPushIdxDelta = -8;
    }
}

Define EvalEndgame.Material(string StrongSide) (warp=true)
{
    If (StrongSide == 1)
    {
        EvalEndgame.Material.StrongQueenCount = Glob.Board.OwnQueenCount;
        EvalEndgame.Material.StrongRookCount = Glob.Board.OwnRookCount;
        EvalEndgame.Material.StrongBishopCount = Glob.Board.OwnBishopCount;
        EvalEndgame.Material.StrongMajorMinorCount = Glob.Board.OwnNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.StrongPawnCount = Glob.Board.OwnPawnCount;
        EvalEndgame.Material.WeakQueenCount = Glob.Board.OppQueenCount;
        Ret.EvalEndgame.Material.WeakRookCount = Glob.Board.OppRookCount;
        EvalEndgame.Material.WeakBishopCount = Glob.Board.OppBishopCount;
        EvalEndgame.Material.WeakMajorMinorCount = Glob.Board.OppNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.WeakPawnCount = Glob.Board.OppPawnCount;
    }
    Else
    {
        EvalEndgame.Material.StrongQueenCount = Glob.Board.OppQueenCount;
        EvalEndgame.Material.StrongRookCount = Glob.Board.OppRookCount;
        EvalEndgame.Material.StrongBishopCount = Glob.Board.OppBishopCount;
        EvalEndgame.Material.StrongMajorMinorCount = Glob.Board.OppNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.StrongPawnCount = Glob.Board.OppPawnCount;
        EvalEndgame.Material.WeakQueenCount = Glob.Board.OwnQueenCount;
        Ret.EvalEndgame.Material.WeakRookCount = Glob.Board.OwnRookCount;
        EvalEndgame.Material.WeakBishopCount = Glob.Board.OwnBishopCount;
        EvalEndgame.Material.WeakMajorMinorCount = Glob.Board.OwnNonQueenMajorMinorCount;
        Ret.EvalEndgame.Material.WeakPawnCount = Glob.Board.OwnPawnCount;
    }
    EvalEndgame.Material.StrongKnightCount = ((EvalEndgame.Material.StrongMajorMinorCount - EvalEndgame.Material.StrongRookCount) - EvalEndgame.Material.StrongBishopCount);
    EvalEndgame.Material.StrongPieceCount = (EvalEndgame.Material.StrongQueenCount + EvalEndgame.Material.StrongMajorMinorCount);
    EvalEndgame.Material.WeakKnightCount = ((EvalEndgame.Material.WeakMajorMinorCount - Ret.EvalEndgame.Material.WeakRookCount) - EvalEndgame.Material.WeakBishopCount);
    EvalEndgame.Material.WeakPieceCount = (EvalEndgame.Material.WeakQueenCount + EvalEndgame.Material.WeakMajorMinorCount);
    Ret.EvalEndgame.Material.StrongPiecesAreNone = 0;
    If (EvalEndgame.Material.StrongPieceCount == 0)
    {
        Ret.EvalEndgame.Material.StrongPiecesAreNone = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreRook = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 1) And (EvalEndgame.Material.StrongRookCount == 1))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreRook = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreQueen = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 1) And (EvalEndgame.Material.StrongQueenCount == 1))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreQueen = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreBishop = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 1) And (EvalEndgame.Material.StrongBishopCount == 1))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreBishop = 1;
    }
    Ret.EvalEndgame.Material.StrongPiecesAreTwoKnights = 0;
    If ((EvalEndgame.Material.StrongPieceCount == 2) And (EvalEndgame.Material.StrongKnightCount == 2))
    {
        Ret.EvalEndgame.Material.StrongPiecesAreTwoKnights = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreNone = 0;
    If (EvalEndgame.Material.WeakPieceCount == 0)
    {
        Ret.EvalEndgame.Material.WeakPiecesAreNone = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreRook = 0;
    If ((EvalEndgame.Material.WeakPieceCount == 1) And (Ret.EvalEndgame.Material.WeakRookCount == 1))
    {
        Ret.EvalEndgame.Material.WeakPiecesAreRook = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreBishop = 0;
    If ((EvalEndgame.Material.WeakPieceCount == 1) And (EvalEndgame.Material.WeakBishopCount == 1))
    {
        Ret.EvalEndgame.Material.WeakPiecesAreBishop = 1;
    }
    Ret.EvalEndgame.Material.WeakPiecesAreKnight = 0;
    If ((EvalEndgame.Material.WeakPieceCount == 1) And (EvalEndgame.Material.WeakKnightCount == 1))
    {
        Ret.EvalEndgame.Material.WeakPiecesAreKnight = 1;
    }
}

Define EvalEndgame.PawnScan(string StrongSide)(string WeakKingIdx)(string WeakRookIdx) (warp=true)
{
    Ret.EvalEndgame.PawnScan.StrongPawnCount = 0;
    Ret.EvalEndgame.PawnScan.StrongPawnOnFileACount = 0;
    Ret.EvalEndgame.PawnScan.StrongPawnOnFileHCount = 0;
    Ret.EvalEndgame.PawnScan.PawnCount = 0;
    Ret.EvalEndgame.PawnScan.PawnOnFileBCount = 0;
    Ret.EvalEndgame.PawnScan.PawnOnFileGCount = 0;
    Ret.EvalEndgame.PawnScan.StrongPawnInKingSpanCount = 0;
    Ret.EvalEndgame.PawnScan.HasRookFortressPawn = 0;
    Ret.EvalEndgame.PawnScan.WeakFrontPawnIdx = 0;
    EvalEndgame.PawnScan.RelativeRankBase = -1;
    EvalEndgame.PawnScan.RelativeRankSign = 1;
    If (StrongSide < 0)
    {
        EvalEndgame.PawnScan.RelativeRankBase = 8;
        EvalEndgame.PawnScan.RelativeRankSign = -1;
    }
    EvalEndgame.PawnScan.WeakKingRelativeRank = (EvalEndgame.PawnScan.RelativeRankBase + (EvalEndgame.PawnScan.RelativeRankSign * IdxToRank[WeakKingIdx]));
    EvalEndgame.PawnScan.WeakFrontPawnRelativeRank = -1;
    EvalEndgame.PawnScan.ListIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_Pawns))
    {
        EvalEndgame.PawnScan.SqIdx = EvalPiecesIdx_Pawns[EvalEndgame.PawnScan.ListIdx];
        EvalEndgame.PawnScan.File = IdxToFile[EvalEndgame.PawnScan.SqIdx];
        EvalEndgame.PawnScan.RelativeRank = (EvalEndgame.PawnScan.RelativeRankBase + (EvalEndgame.PawnScan.RelativeRankSign * IdxToRank[EvalEndgame.PawnScan.SqIdx]));
        Ret.EvalEndgame.PawnScan.PawnCount += 1;
        If (EvalEndgame.PawnScan.File == 2)
        {
            Ret.EvalEndgame.PawnScan.PawnOnFileBCount += 1;
        }
        If (EvalEndgame.PawnScan.File == 7)
        {
            Ret.EvalEndgame.PawnScan.PawnOnFileGCount += 1;
        }
        If ((Board[EvalEndgame.PawnScan.SqIdx] * StrongSide) > 0)
        {
            Ret.EvalEndgame.PawnScan.StrongPawnCount += 1;
            If (EvalEndgame.PawnScan.File == 1)
            {
                Ret.EvalEndgame.PawnScan.StrongPawnOnFileACount += 1;
            }
            If (EvalEndgame.PawnScan.File == 8)
            {
                Ret.EvalEndgame.PawnScan.StrongPawnOnFileHCount += 1;
            }
            EvalEndgame.PawnScan.KingFileDeltaAbs = abs((EvalEndgame.PawnScan.File - IdxToFile[WeakKingIdx]));
            If ((EvalEndgame.PawnScan.KingFileDeltaAbs < 2) And (EvalEndgame.PawnScan.RelativeRank < EvalEndgame.PawnScan.WeakKingRelativeRank))
            {
                Ret.EvalEndgame.PawnScan.StrongPawnInKingSpanCount += 1;
            }
        }
        Else
        {
            If (EvalEndgame.PawnScan.RelativeRank > EvalEndgame.PawnScan.WeakFrontPawnRelativeRank)
            {
                Ret.EvalEndgame.PawnScan.WeakFrontPawnIdx = EvalEndgame.PawnScan.SqIdx;
                EvalEndgame.PawnScan.WeakFrontPawnRelativeRank = EvalEndgame.PawnScan.RelativeRank;
            }
            If (WeakRookIdx > 0)
            {
                EvalEndgame.PawnScan.IsNextToWeakKing = 0;
                If (ChebyshevDistance[((EvalEndgame.PawnScan.SqIdx * 100) + WeakKingIdx)] == 1)
                {
                    EvalEndgame.PawnScan.IsNextToWeakKing = 1;
                }
                EvalEndgame.PawnScan.RookRelativeRank = (EvalEndgame.PawnScan.RelativeRankBase + (EvalEndgame.PawnScan.RelativeRankSign * IdxToRank[WeakRookIdx]));
                EvalEndgame.PawnScan.RookFileDeltaAbs = abs((EvalEndgame.PawnScan.File - IdxToFile[WeakRookIdx]));
                If (((EvalEndgame.PawnScan.IsNextToWeakKing == 1) And (EvalEndgame.PawnScan.RelativeRank == (EvalEndgame.PawnScan.RookRelativeRank + 1))) And (EvalEndgame.PawnScan.RookFileDeltaAbs == 1))
                {
                    Ret.EvalEndgame.PawnScan.HasRookFortressPawn = 1;
                }
            }
        }
        EvalEndgame.PawnScan.ListIdx += 1;
    }
}

Define EvalEndgame.PushToEdge(string SqIdx) (warp=true)
{
    EvalEndgame.PushToEdge.FileEdgeDistance = (IdxToFile[SqIdx] - 1);
    If (EvalEndgame.PushToEdge.FileEdgeDistance > 3)
    {
        EvalEndgame.PushToEdge.FileEdgeDistance = (7 - EvalEndgame.PushToEdge.FileEdgeDistance);
    }
    EvalEndgame.PushToEdge.RankEdgeDistance = (IdxToRank[SqIdx] - 1);
    If (EvalEndgame.PushToEdge.RankEdgeDistance > 3)
    {
        EvalEndgame.PushToEdge.RankEdgeDistance = (7 - EvalEndgame.PushToEdge.RankEdgeDistance);
    }
    EvalEndgame.PushToEdge.FilePenalty = floor(((7 * (EvalEndgame.PushToEdge.FileEdgeDistance * EvalEndgame.PushToEdge.FileEdgeDistance)) / 2));
    EvalEndgame.PushToEdge.RankPenalty = floor(((7 * (EvalEndgame.PushToEdge.RankEdgeDistance * EvalEndgame.PushToEdge.RankEdgeDistance)) / 2));
    Ret.EvalEndgame.PushToEdge.Score = (90 - (EvalEndgame.PushToEdge.FilePenalty + EvalEndgame.PushToEdge.RankPenalty));
}

Define EvalEndgame.Scale(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.Scale.Factor = Const.Null;
    Call EvalEndgame.Material((0 - StrongSide));
    EvalEndgame.Scale.IsOtherSideExactEndgame = 0;
    If ((Ret.EvalEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvalEndgame.Material.StrongPawnCount == 1))
    {
        If ((Ret.EvalEndgame.Material.WeakPawnCount == 0) And ((Ret.EvalEndgame.Material.WeakPiecesAreRook == 1) Or (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEndgame.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If ((Ret.EvalEndgame.Material.StrongPiecesAreBishop == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 0))
    {
        If (((Ret.EvalEndgame.Material.StrongPawnCount == 1) And ((Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1) Or (Ret.EvalEndgame.Material.WeakPiecesAreKnight == 1))) Or ((Ret.EvalEndgame.Material.StrongPawnCount == 2) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEndgame.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If (((Ret.EvalEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvalEndgame.Material.StrongPawnCount == 2)) And ((Ret.EvalEndgame.Material.WeakPiecesAreRook == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 1)))
    {
        EvalEndgame.Scale.IsOtherSideExactEndgame = 1;
    }
    If (EvalEndgame.Scale.IsOtherSideExactEndgame == 1)
    {
        Stop(this script);
    }
    Call EvalEndgame.Material(StrongSide);
    EvalEndgame.Scale.StrongPawnCount = Ret.EvalEndgame.Material.StrongPawnCount;
    EvalEndgame.Scale.WeakPawnCount = Ret.EvalEndgame.Material.WeakPawnCount;
    If (Ret.EvalEndgame.Material.StrongPiecesAreRook == 1)
    {
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvalEndgame.KRPKR(Ply)(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KRPKR.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvalEndgame.KRPKB(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KRPKB.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 2) And (EvalEndgame.Scale.WeakPawnCount == 1)) And (Ret.EvalEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvalEndgame.KRPPKRP(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KRPPKRP.Factor;
            Stop(this script);
        }
    }
    If (Ret.EvalEndgame.Material.StrongPiecesAreBishop == 1)
    {
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvalEndgame.KBPKB(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPKB.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreKnight == 1))
        {
            Call EvalEndgame.KBPKN(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPKN.Factor;
            Stop(this script);
        }
        If (((EvalEndgame.Scale.StrongPawnCount == 2) And (EvalEndgame.Scale.WeakPawnCount == 0)) And (Ret.EvalEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvalEndgame.KBPPKB(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPPKB.Factor;
            Stop(this script);
        }
        If (EvalEndgame.Scale.StrongPawnCount > 0)
        {
            Call EvalEndgame.KBPsK(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KBPsK.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvalEndgame.Material.StrongPiecesAreQueen == 1) And (EvalEndgame.Scale.StrongPawnCount == 0))
    {
        If ((Ret.EvalEndgame.Material.WeakRookCount == 1) And (EvalEndgame.Scale.WeakPawnCount > 0))
        {
            Call EvalEndgame.KQKRPs(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KQKRPs.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvalEndgame.Material.StrongPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPiecesAreNone == 1))
    {
        If ((EvalEndgame.Scale.StrongPawnCount > 1) And (EvalEndgame.Scale.WeakPawnCount == 0))
        {
            Call EvalEndgame.KPsK(StrongSide);
            Ret.EvalEndgame.Scale.Factor = Ret.EvalEndgame.KPsK.Factor;
        }
        If ((EvalEndgame.Scale.StrongPawnCount == 1) And (EvalEndgame.Scale.WeakPawnCount == 1))
        {
            Call EvalEndgame.KPK(Ply)(StrongSide);
            If (Not (((EvalEndgame.KPK.PawnRank > 3) And (EvalEndgame.KPK.PawnFile > 0))))
            {
                If (Ret.EvalEndgame.KPK.IsWin == 0)
                {
                    Ret.EvalEndgame.Scale.Factor = 0;
                }
            }
        }
    }
}

Define EvalEndgame.StrongToMove(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvalEndgame.StrongToMove.IsStrongToMove = PlyIsOwn[(Ply + 1)];
    If (StrongSide < 0)
    {
        Ret.EvalEndgame.StrongToMove.IsStrongToMove = (1 - Ret.EvalEndgame.StrongToMove.IsStrongToMove);
    }
}

Define Evaluate(string Ply)(bool FullEval) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(-1);
    }
    Ret.Evaluate.Score = Const.Null;
    If ((Glob.Board.OppKingIdx == Const.Null) And (Glob.Board.OwnKingIdx == Const.Null))
    {
        Ret.Evaluate.Score = 0;
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.Board.OppKingIdx == Const.Null)
    {
        Ret.Evaluate.Score = (100000 - (List.Length(BoardHistoryFiftyMoves) - 1));
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.Board.OwnKingIdx == Const.Null)
    {
        Ret.Evaluate.Score = (-100000 + (List.Length(BoardHistoryFiftyMoves) - 1));
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If (1 == 0)
    {
        Call EvaluateBoard;
        Eval.BoardScore = Ret.EvaluateBoard.Score;
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
        }
        Stop(this script);
    }
    If FullEval
    {
        Evaluate.PieceCount = ((Glob.Board.OwnQueenCount + Glob.Board.OwnNonQueenMajorMinorCount) + (Glob.Board.OppQueenCount + Glob.Board.OppNonQueenMajorMinorCount));
        If (Evaluate.PieceCount < 4)
        {
            Call EvalEndgame(Ply);
            If (Not ((Ret.EvalEndgame.Score == Const.Null)))
            {
                Ret.Evaluate.Score = Ret.EvalEndgame.Score;
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
                }
                Stop(this script);
            }
        }
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call Profile_MethodEnter(Ply);
    }
    If FullEval
    {
        Glob.Eval.MgTotal = 0;
        Glob.Eval.EgTotal = 0;
        Glob.Eval.PassedCount = 0;
        Glob.Eval.OwnPassedCount = 0;
        Glob.Eval.OppPassedCount = 0;
        Call EvaluateBoard;
        Eval.BoardScore = Ret.EvaluateBoard.Score;
        Evaluate.Key = ((((((((((((((((((((Glob.Board.OwnPawnCount * 11) + (Glob.Board.OwnNonQueenMajorMinorCount - (Glob.Board.OwnRookCount + Glob.Board.OwnBishopCount))) * 11) + Glob.Board.OwnBishopCount) * 11) + Glob.Board.OwnRookCount) * 11) + Glob.Board.OwnQueenCount) * 11) + Glob.Board.OppPawnCount) * 11) + (Glob.Board.OppNonQueenMajorMinorCount - (Glob.Board.OppRookCount + Glob.Board.OppBishopCount))) * 11) + Glob.Board.OppBishopCount) * 11) + Glob.Board.OppRookCount) * 11) + Glob.Board.OppQueenCount) * 4) + ((PlyIsOwn[1] * 2) + PlyIsOwn[2]));
        Evaluate.Idx_EvalMT = ((Evaluate.Key - (floor((Evaluate.Key / 4093)) * 4093)) + 1);
        If (EvalMT.Keys[Evaluate.Idx_EvalMT] == Evaluate.Key)
        {
            Eval.OwnImbalance = EvalMT.OwnMg[Evaluate.Idx_EvalMT];
            Eval.OwnImbalanceEg = EvalMT.OwnEg[Evaluate.Idx_EvalMT];
            Eval.OppImbalance = EvalMT.OppMg[Evaluate.Idx_EvalMT];
            Eval.OppImbalanceEg = EvalMT.OppEg[Evaluate.Idx_EvalMT];
        }
        Else
        {
            Call CalcMaterialImbalance(1);
            Eval.OwnImbalance = Ret.CalcMaterialImbalance.Score;
            Eval.OwnImbalanceEg = Ret.CalcMaterialImbalance.ScoreEg;
            Call CalcMaterialImbalance(2);
            Eval.OppImbalance = Ret.CalcMaterialImbalance.Score;
            Eval.OppImbalanceEg = Ret.CalcMaterialImbalance.ScoreEg;
            List.ReplaceItem(EvalMT.Keys, Evaluate.Idx_EvalMT, Evaluate.Key);
            List.ReplaceItem(EvalMT.OwnMg, Evaluate.Idx_EvalMT, Eval.OwnImbalance);
            List.ReplaceItem(EvalMT.OwnEg, Evaluate.Idx_EvalMT, Eval.OwnImbalanceEg);
            List.ReplaceItem(EvalMT.OppMg, Evaluate.Idx_EvalMT, Eval.OppImbalance);
            List.ReplaceItem(EvalMT.OppEg, Evaluate.Idx_EvalMT, Eval.OppImbalanceEg);
        }
        Call TaperedEval.Init;
        Eval.ImbalanceMgSf = ((Eval.OwnImbalance - Eval.OppImbalance) / 16);
        Eval.ImbalanceEgSf = ((Eval.OwnImbalanceEg - Eval.OppImbalanceEg) / 16);
        Call TaperedEval.Add(((((Eval.ImbalanceMgSf > 0) - (Eval.ImbalanceMgSf < 0)) * floor(abs(Eval.ImbalanceMgSf))) / 2))(((((Eval.ImbalanceEgSf > 0) - (Eval.ImbalanceEgSf < 0)) * floor(abs(Eval.ImbalanceEgSf))) / 2))("Eval.Imbalance")("")("")("");
        Call TaperedEval.Add(0)(0)("Eval.Contempt")("")("")("");
        Call TaperedEval.GetSum;
        Glob.Eval.MgTotal += Glob.Eval.TaperedMg;
        Glob.Eval.EgTotal += Glob.Eval.TaperedEg;
        Eval.ImbalanceScore = Ret.TaperedEval.GetSum.Score;
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_CountByHorizon(Const.Profile.LazyCalls)(HorizonAtPly[Ply])(Ply);
        }
        Eval.IsLazy = 0;
        If (Not ((Ret.SearchWrp.BestMoveEval == Const.Null)))
        {
            Eval.LazyMargin = (Const.LazyEvalBaseMargin + ((abs(Ret.SearchWrp.BestMoveEval) * Const.LazyEvalRootFactor) + ((Ret.TaperedEval.Init.OwnMaterial + Ret.TaperedEval.Init.OppMaterial) / Const.LazyEvalMaterialDivisor)));
            If (abs((Glob.Eval.MgTotal + Glob.Eval.EgTotal)) > Eval.LazyMargin)
            {
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.LazyHits)(HorizonAtPly[Ply])(Ply);
                }
                Eval.IsLazy = 1;
            }
        }
        Call PrepareEvalPiecesData(Ply)((Eval.IsLazy == 1));
        Eval.HasAttackTables = Ret.PrepareEvalPiecesData.HasAttackTables;
        Call EvaluatePawns(Ply)((Eval.HasAttackTables == 1));
        Eval.PawnsScore = Ret.EvaluatePawns.Score;
        If (Eval.IsLazy == 1)
        {
            Eval.MajorsMinorsScore = 0;
            Call EvaluateThreats(Ply)((1 == 0));
            Eval.ThreatsScore = Ret.EvaluateThreats.Score;
        }
        Else
        {
            If (Glob.Eval.DebugLog == 1)
            {
                Call Log("----------------------------------------")("")("")("")("")("")("")("");
            }
            Call EvaluatePieces(Ply)((Eval.HasAttackTables == 1));
            Eval.MajorsMinorsScore = Ret.EvaluatePieces.Score;
            If (Glob.Eval.DebugLog == 1)
            {
                Call Log("----------------------------------------")("")("")("")("")("")("")("");
            }
            Call EvaluateThreats(Ply)((Eval.HasAttackTables == 1));
            Eval.ThreatsScore = Ret.EvaluateThreats.Score;
            If (Glob.Eval.DebugLog == 1)
            {
                Call Log("----------------------------------------")("")("")("")("")("")("")("");
            }
        }
        Ret.Evaluate.Score = (Eval.BoardScore + ((Eval.PawnsScore + Eval.MajorsMinorsScore) + Eval.ThreatsScore));
        Ret.Evaluate.Score += Eval.ImbalanceScore;
        Evaluate.KingOutflanking = (abs((IdxToFile[Glob.Board.OwnKingIdx] - IdxToFile[Glob.Board.OppKingIdx])) + (IdxToRank[Glob.Board.OwnKingIdx] - IdxToRank[Glob.Board.OppKingIdx]));
        Evaluate.PawnsOnBothFlanks = ((((((((((PawnCount[1] + PawnCount[9]) + PawnCount[2]) + PawnCount[10]) + PawnCount[3]) + PawnCount[11]) + PawnCount[4]) + PawnCount[12]) > 0) And ((((((((PawnCount[5] + PawnCount[13]) + PawnCount[6]) + PawnCount[14]) + PawnCount[7]) + PawnCount[15]) + PawnCount[8]) + PawnCount[16]) > 0)) * 1);
        Evaluate.Complexity = (((((((((9 * Glob.Eval.PassedCount) + (12 * (Glob.Board.OwnPawnCount + Glob.Board.OppPawnCount))) + (9 * Evaluate.KingOutflanking)) + (21 * Evaluate.PawnsOnBothFlanks)) + (24 * ((Glob.Board.OwnKingIdx > 32) Or (Glob.Board.OppKingIdx < 33)))) + (51 * (((Glob.Board.OwnQueenCount + Glob.Board.OwnNonQueenMajorMinorCount) + (Glob.Board.OppQueenCount + Glob.Board.OppNonQueenMajorMinorCount)) == 0))) - (43 * ((Evaluate.KingOutflanking < 0) And (Evaluate.PawnsOnBothFlanks == 0)))) - 110) / 2);
        Evaluate.MgAdjust = (Evaluate.Complexity + 25);
        If (Evaluate.MgAdjust > 0)
        {
            Evaluate.MgAdjust = 0;
        }
        If (Evaluate.MgAdjust < (0 - abs(Glob.Eval.MgTotal)))
        {
            Evaluate.MgAdjust = (0 - abs(Glob.Eval.MgTotal));
        }
        Evaluate.MgAdjust = (Evaluate.MgAdjust * ((Glob.Eval.MgTotal > 0) - (Glob.Eval.MgTotal < 0)));
        Evaluate.EgAdjust = Evaluate.Complexity;
        If (Evaluate.EgAdjust < (0 - abs(Glob.Eval.EgTotal)))
        {
            Evaluate.EgAdjust = (0 - abs(Glob.Eval.EgTotal));
        }
        Evaluate.EgAdjust = (Evaluate.EgAdjust * ((Glob.Eval.EgTotal > 0) - (Glob.Eval.EgTotal < 0)));
        Ret.Evaluate.Score += Operator.Round((((Evaluate.MgAdjust * Glob.Eval.TaperedPhase) + (Evaluate.EgAdjust * (128 - Glob.Eval.TaperedPhase))) / 128));
        If (Glob.Eval.DebugLog == 1)
        {
            Call Log("Eval.Winnable.Complexity = ")(Evaluate.Complexity)(" MgAdjust = ")(Evaluate.MgAdjust)(" EgAdjust = ")(Evaluate.EgAdjust)("")("");
        }
        If (Glob.Eval.DebugLog == 1)
        {
            Call Log("Eval.MaterialCaptureList = ")(TargetPieces)("")("")("")("")("")("");
            Call Log("Eval.MaterialPromotionList = ")(PromotionPieces)("")("")("")("")("")("");
            Call Log("Eval.Pawns = ")(Eval.PawnsScore)("")("")("")("")("")("");
            Call Log("Eval.MajorsMinors = ")(Eval.MajorsMinorsScore)("")("")("")("")("")("");
            Call Log("Eval.Threats = ")(Eval.ThreatsScore)("")("")("")("")("")("");
            Call Log("Eval.Imbalance = ")(Operator.Round(((Eval.OwnImbalance - Eval.OppImbalance) / 1)))("")("")("")("")("")("");
            Call Log("Eval.Total (pre-DrawScale)= ")(Ret.Evaluate.Score)("")("")("")("")("")("");
        }
        Evaluate.Endgame.ScaleFactor = Const.Null;
        If (Evaluate.PieceCount < 4)
        {
            Evaluate.Endgame.StrongSide = (((Glob.Eval.EgTotal + Evaluate.EgAdjust) > 0) - ((Glob.Eval.EgTotal + Evaluate.EgAdjust) < 0));
            If (Not ((Evaluate.Endgame.StrongSide == 0)))
            {
                Call EvalEndgame.Scale(Ply)(Evaluate.Endgame.StrongSide);
                Evaluate.Endgame.ScaleFactor = Ret.EvalEndgame.Scale.Factor;
                If (Evaluate.Endgame.ScaleFactor == 64)
                {
                    Evaluate.Endgame.ScaleFactor = Const.Null;
                }
            }
        }
        If (Not ((Evaluate.Endgame.ScaleFactor == Const.Null)))
        {
            Ret.Evaluate.Score += Operator.Round(((((Glob.Eval.EgTotal + Evaluate.EgAdjust) * (128 - Glob.Eval.TaperedPhase)) * ((2 * Evaluate.Endgame.ScaleFactor) - 128)) / 16384));
        }
        Else
        {
            Evaluate.OppositeBishops.ScaleFactor = 128;
            If ((Glob.Board.OwnBishopCount == 1) And (Glob.Board.OppBishopCount == 1))
            {
                Evaluate.OwnBishopIdx = 0;
                Evaluate.OppBishopIdx = 0;
                Evaluate.OppositeBishops.Idx = 1;
                Repeat (64)
                {
                    If (Board[Evaluate.OppositeBishops.Idx] == GoK_OwnBishop)
                    {
                        Evaluate.OwnBishopIdx = Evaluate.OppositeBishops.Idx;
                    }
                    If (Board[Evaluate.OppositeBishops.Idx] == GoK_OppBishop)
                    {
                        Evaluate.OppBishopIdx = Evaluate.OppositeBishops.Idx;
                    }
                    Evaluate.OppositeBishops.Idx += 1;
                }
                If (Not ((((IdxToFile[Evaluate.OwnBishopIdx] + IdxToRank[Evaluate.OwnBishopIdx]) % 2) == ((IdxToFile[Evaluate.OppBishopIdx] + IdxToRank[Evaluate.OppBishopIdx]) % 2))))
                {
                    Evaluate.OppositeBishops.StrongSide = (((Glob.Eval.EgTotal + Evaluate.EgAdjust) > 0) - ((Glob.Eval.EgTotal + Evaluate.EgAdjust) < 0));
                    If ((Not ((Evaluate.OppositeBishops.StrongSide == 0))) And (Not ((((Evaluate.OppositeBishops.StrongSide == 1) And ((Glob.Board.OwnPawnCount == 0) And ((Ret.TaperedEval.Init.OwnMaterial - Ret.TaperedEval.Init.OppMaterial) < (GoK_OwnBishop + 1)))) Or ((Evaluate.OppositeBishops.StrongSide == -1) And ((Glob.Board.OppPawnCount == 0) And ((Ret.TaperedEval.Init.OppMaterial - Ret.TaperedEval.Init.OwnMaterial) < (GoK_OwnBishop + 1))))))))
                    {
                        If ((((Glob.Board.OwnQueenCount + Glob.Board.OppQueenCount) + (Glob.Board.OwnRookCount + Glob.Board.OppRookCount)) == 0) And ((Glob.Board.OwnNonQueenMajorMinorCount == 1) And (Glob.Board.OppNonQueenMajorMinorCount == 1)))
                        {
                            If (Evaluate.OppositeBishops.StrongSide == 1)
                            {
                                Evaluate.StrongPieceCount = Glob.Eval.OwnPassedCount;
                            }
                            Else
                            {
                                Evaluate.StrongPieceCount = Glob.Eval.OppPassedCount;
                            }
                            Evaluate.OppositeBishops.ScaleFactor = (36 + (8 * Evaluate.StrongPieceCount));
                        }
                        Else
                        {
                            If (Evaluate.OppositeBishops.StrongSide == 1)
                            {
                                Evaluate.StrongPieceCount = (1 + (Glob.Board.OwnPawnCount + (Glob.Board.OwnQueenCount + Glob.Board.OwnNonQueenMajorMinorCount)));
                            }
                            Else
                            {
                                Evaluate.StrongPieceCount = (1 + (Glob.Board.OppPawnCount + (Glob.Board.OppQueenCount + Glob.Board.OppNonQueenMajorMinorCount)));
                            }
                            Evaluate.OppositeBishops.ScaleFactor = (44 + (6 * Evaluate.StrongPieceCount));
                        }
                        If (Evaluate.PawnsOnBothFlanks == 0)
                        {
                            Evaluate.OppositeBishops.ScaleFactor += -8;
                        }
                        If (Evaluate.OppositeBishops.ScaleFactor > 128)
                        {
                            Evaluate.OppositeBishops.ScaleFactor = 128;
                        }
                        Ret.Evaluate.Score += Operator.Round(((((Glob.Eval.EgTotal + Evaluate.EgAdjust) * (128 - Glob.Eval.TaperedPhase)) * (Evaluate.OppositeBishops.ScaleFactor - 128)) / 16384));
                        If (Glob.Eval.DebugLog == 1)
                        {
                            Call Log("Eval.OppositeBishops.ScaleFactor = ")(Evaluate.OppositeBishops.ScaleFactor)("")("")("")("")("")("");
                        }
                    }
                }
            }
            If (Evaluate.OppositeBishops.ScaleFactor == 128)
            {
                Evaluate.ScaleFactor.StrongSide = (((Glob.Eval.EgTotal + Evaluate.EgAdjust) > 0) - ((Glob.Eval.EgTotal + Evaluate.EgAdjust) < 0));
                If (Not ((Evaluate.ScaleFactor.StrongSide == 0)))
                {
                    If (Evaluate.ScaleFactor.StrongSide == 1)
                    {
                        Evaluate.StrongPawnCount = Glob.Board.OwnPawnCount;
                        Evaluate.StrongMaterial = Ret.TaperedEval.Init.OwnMaterial;
                        Evaluate.WeakMaterial = Ret.TaperedEval.Init.OppMaterial;
                    }
                    Else
                    {
                        Evaluate.StrongPawnCount = Glob.Board.OppPawnCount;
                        Evaluate.StrongMaterial = Ret.TaperedEval.Init.OppMaterial;
                        Evaluate.WeakMaterial = Ret.TaperedEval.Init.OwnMaterial;
                    }
                    Evaluate.Value = 64;
                    If ((Evaluate.StrongPawnCount == 0) And ((Evaluate.StrongMaterial - Evaluate.WeakMaterial) < (GoK_OwnBishop + 1)))
                    {
                        If (Evaluate.StrongMaterial < GoK_OwnRook)
                        {
                            Evaluate.Value = 0;
                        }
                        Else
                        {
                            If (Evaluate.WeakMaterial < (GoK_OwnBishop + 1))
                            {
                                Evaluate.Value = 4;
                            }
                            Else
                            {
                                Evaluate.Value = 14;
                            }
                        }
                    }
                    Else
                    {
                        If (Evaluate.ScaleFactor.StrongSide == 1)
                        {
                            Evaluate.WeakPawnCount = Glob.Board.OppPawnCount;
                        }
                        Else
                        {
                            Evaluate.WeakPawnCount = Glob.Board.OwnPawnCount;
                        }
                        If (Evaluate.ScaleFactor.StrongSide == 1)
                        {
                            Evaluate.WeakKingIdx = Glob.Board.OppKingIdx;
                        }
                        Else
                        {
                            Evaluate.WeakKingIdx = Glob.Board.OwnKingIdx;
                        }
                        Evaluate.QueensidePawnCount = 0;
                        Evaluate.KingsidePawnCount = 0;
                        Evaluate.File = 1;
                        Repeat (4)
                        {
                            Evaluate.QueensidePawnCount += PawnCount[(Evaluate.File + (8 * (Not ((Evaluate.ScaleFactor.StrongSide == 1)))))];
                            Evaluate.KingsidePawnCount += PawnCount[((Evaluate.File + 4) + (8 * (Not ((Evaluate.ScaleFactor.StrongSide == 1)))))];
                            Evaluate.File += 1;
                        }
                        Evaluate.KingPawn = 0;
                        Evaluate.PawnListIdx = 1;
                        Repeat (List.Length(EvalPiecesIdx_Pawns))
                        {
                            If (((Board[EvalPiecesIdx_Pawns[Evaluate.PawnListIdx]] * Evaluate.ScaleFactor.StrongSide) == (0 - GoK_OwnPawn)) And (ChebyshevDistance[((EvalPiecesIdx_Pawns[Evaluate.PawnListIdx] * 100) + Evaluate.WeakKingIdx)] == 1))
                            {
                                Evaluate.KingPawn = 1;
                            }
                            Evaluate.PawnListIdx += 1;
                        }
                        If (((((Glob.Board.OwnRookCount == 1) And (Glob.Board.OwnNonQueenMajorMinorCount == 1)) And (Glob.Board.OwnQueenCount == 0)) And (((Glob.Board.OppRookCount == 1) And (Glob.Board.OppNonQueenMajorMinorCount == 1)) And (Glob.Board.OppQueenCount == 0))) And ((Not (((Evaluate.StrongPawnCount - Evaluate.WeakPawnCount) > 1))) And ((Not (((Evaluate.QueensidePawnCount > 0) == (Evaluate.KingsidePawnCount > 0)))) And (Evaluate.KingPawn == 1))))
                        {
                            Evaluate.Value = 36;
                        }
                        Else
                        {
                            If ((Glob.Board.OwnQueenCount + Glob.Board.OppQueenCount) == 1)
                            {
                                If (Glob.Board.OwnQueenCount == 1)
                                {
                                    Evaluate.Value = (37 + (3 * (Glob.Board.OppNonQueenMajorMinorCount - Glob.Board.OppRookCount)));
                                }
                                Else
                                {
                                    Evaluate.Value = (37 + (3 * (Glob.Board.OwnNonQueenMajorMinorCount - Glob.Board.OwnRookCount)));
                                }
                            }
                            Else
                            {
                                Evaluate.Value = (36 + (7 * Evaluate.StrongPawnCount));
                                If (Evaluate.Value > 64)
                                {
                                    Evaluate.Value = 64;
                                }
                                Evaluate.Value += (-4 * (Evaluate.PawnsOnBothFlanks == 0));
                            }
                        }
                        Evaluate.Value += (-4 * (Evaluate.PawnsOnBothFlanks == 0));
                    }
                    Ret.Evaluate.Score += Operator.Round(((((Glob.Eval.EgTotal + Evaluate.EgAdjust) * (128 - Glob.Eval.TaperedPhase)) * ((2 * Evaluate.Value) - 128)) / 16384));
                    If (Glob.Eval.DebugLog == 1)
                    {
                        Call Log("Eval.ScaleFactor = ")(Evaluate.Value)("")("")("")("")("")("");
                    }
                }
            }
        }
        Ret.Evaluate.Score = (((Ret.Evaluate.Score > 0) - (Ret.Evaluate.Score < 0)) * floor(abs(Ret.Evaluate.Score)));
        Ret.Evaluate.Score += (14 * PlySign[(Ply + 1)]);
        If (((((((Glob.Board.OwnQueenCount == 0) And (Glob.Board.OwnRookCount == 0)) And (Glob.Board.OwnBishopCount == 0)) And (Glob.Board.OwnNonQueenMajorMinorCount == 2)) And (Glob.Board.OwnPawnCount == 0)) And (((Glob.Board.OppQueenCount == 0) And (Glob.Board.OppNonQueenMajorMinorCount == 0)) And (Glob.Board.OppPawnCount == 0))) Or ((((((Glob.Board.OppQueenCount == 0) And (Glob.Board.OppRookCount == 0)) And (Glob.Board.OppBishopCount == 0)) And (Glob.Board.OppNonQueenMajorMinorCount == 2)) And (Glob.Board.OppPawnCount == 0)) And (((Glob.Board.OwnQueenCount == 0) And (Glob.Board.OwnNonQueenMajorMinorCount == 0)) And (Glob.Board.OwnPawnCount == 0))))
        {
            Ret.Evaluate.Score = 0;
        }
        If (Glob.Eval.DebugLog == 1)
        {
            Call Log("Eval.Total= ")(Ret.Evaluate.Score)("")("")("")("")("")("");
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call Profile_MethodExit(Ply);
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.EvaluateBaseIdx)(Ply)(1);
    }
}

Define EvaluateBoard (warp=true)
{
    Call TaperedEval.Init;
    Ret.EvaluateBoard.Score = 0;
    EvaluateBoard.Mg = 0;
    EvaluateBoard.Eg = 0;
    EvaluateBoard.SqIdx = 1;
    Repeat (64)
    {
        EvaluateBoard.CurrentPiece = (Board[EvaluateBoard.SqIdx] + 0);
        If (Not ((EvaluateBoard.CurrentPiece == 0)))
        {
            Ret.EvaluateBoard.Score += EvaluateBoard.CurrentPiece;
            Call TaperedEval.GetPiecePos(EvaluateBoard.CurrentPiece)(EvaluateBoard.SqIdx);
            Ret.EvaluateBoard.Score += Ret.TaperedEval.GetPiecePos.Score;
            EvaluateBoard.Mg += (EvaluateBoard.CurrentPiece + MovePosLookupMg[(Ret.TaperedEval.GetPiecePos.PieceSqKey + (100000 * (EvaluateBoard.CurrentPiece < 0)))]);
            EvaluateBoard.Eg += (EvaluateBoard.CurrentPiece + MovePosLookupEg[(Ret.TaperedEval.GetPiecePos.PieceSqKey + (100000 * (EvaluateBoard.CurrentPiece < 0)))]);
        }
        EvaluateBoard.SqIdx += 1;
    }
    Call TaperedEval.Add(0)((41 * Glob.Board.OwnPawnCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-41 * Glob.Board.OppPawnCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((36 * ((Glob.Board.OwnNonQueenMajorMinorCount - Glob.Board.OwnBishopCount) - Glob.Board.OwnRookCount)))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-36 * ((Glob.Board.OppNonQueenMajorMinorCount - Glob.Board.OppBishopCount) - Glob.Board.OppRookCount)))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((45 * Glob.Board.OwnBishopCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-45 * Glob.Board.OppBishopCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((52 * Glob.Board.OwnRookCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-52 * Glob.Board.OppRookCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.Add(0)((72 * Glob.Board.OwnQueenCount))("Eval.Board.MaterialEG")("")(1)("");
    Call TaperedEval.Add(0)((-72 * Glob.Board.OppQueenCount))("Eval.Board.MaterialEG")("")(2)("");
    Call TaperedEval.GetSum;
    Ret.EvaluateBoard.Score += Ret.TaperedEval.GetSum.Score;
    Glob.Eval.MgTotal += EvaluateBoard.Mg;
    Glob.Eval.EgTotal += (EvaluateBoard.Eg + Glob.Eval.TaperedEg);
}

Define EvaluatePawns(string Ply)(bool HasAttackTables) (warp=true)
{
    Call //("Positional evaluation: king and pawn structure");
    Call EvaluatePawnsImpl(Ply)(HasAttackTables);
    Ret.EvaluatePawns.Score = Ret.EvaluatePawnsImpl.Score;
}

Define EvaluatePawnsImpl(string Ply)(bool HasAttackTables) (warp=true)
{
    Ret.EvaluatePawnsImpl.Score = 0;
    Call TaperedEval.Init;
    If (((CastlingBit[((8 * CastlingState[(Ply + 1)]) + 1)] == 0) And (CastlingBit[((8 * CastlingState[(Ply + 1)]) + 2)] == 0)) And ((CastlingBit[((8 * CastlingState[(Ply + 1)]) + 3)] == 0) Or (CastlingBit[((8 * CastlingState[(Ply + 1)]) + 4)] == 0)))
    {
        EvaluatePawnsImpl.IsOwnSideCastlingPossible = 1;
    }
    Else
    {
        EvaluatePawnsImpl.IsOwnSideCastlingPossible = 0;
    }
    If (((CastlingBit[((8 * CastlingState[(Ply + 1)]) + 5)] == 0) And (CastlingBit[((8 * CastlingState[(Ply + 1)]) + 6)] == 0)) And ((CastlingBit[((8 * CastlingState[(Ply + 1)]) + 7)] == 0) Or (CastlingBit[((8 * CastlingState[(Ply + 1)]) + 8)] == 0)))
    {
        EvaluatePawnsImpl.IsOppSideCastlingPossible = 1;
    }
    Else
    {
        EvaluatePawnsImpl.IsOppSideCastlingPossible = 0;
    }
    EvaluatePawnsImpl.OwnKingMinDist = 6;
    EvaluatePawnsImpl.OppKingMinDist = 6;
    EvaluatePawnsImpl.EvalPieceIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_Pawns))
    {
        EvaluatePawnsImpl.Idx = (EvalPiecesIdx_Pawns[EvaluatePawnsImpl.EvalPieceIdx] + 0);
        EvaluatePawnsImpl.Piece = (Board[(EvaluatePawnsImpl.Idx + 0)] + 0);
        If (EvaluatePawnsImpl.Piece > 0)
        {
            If (ChebyshevDistance[((EvaluatePawnsImpl.Idx * 100) + Glob.Board.OwnKingIdx)] < EvaluatePawnsImpl.OwnKingMinDist)
            {
                EvaluatePawnsImpl.OwnKingMinDist = ChebyshevDistance[((EvaluatePawnsImpl.Idx * 100) + Glob.Board.OwnKingIdx)];
            }
        }
        Else
        {
            If (ChebyshevDistance[((EvaluatePawnsImpl.Idx * 100) + Glob.Board.OppKingIdx)] < EvaluatePawnsImpl.OppKingMinDist)
            {
                EvaluatePawnsImpl.OppKingMinDist = ChebyshevDistance[((EvaluatePawnsImpl.Idx * 100) + Glob.Board.OppKingIdx)];
            }
        }
        EvaluatePawnsImpl.EvalPieceIdx += 1;
    }
    Call TaperedEval.Add(0)((-8 * EvaluatePawnsImpl.OwnKingMinDist))("Eval.Pawns.PawnKingTropism")("")(1)("");
    Call TaperedEval.Add(0)((8 * EvaluatePawnsImpl.OppKingMinDist))("Eval.Pawns.PawnKingTropism")("")(2)("");
    Call //("Doubled pawns, passed pawns, open-file pawns");
    If (Not ((List.Length(EvalP.NormalizedRank) == 8)))
    {
        List.DeleteAll(EvalP.NormalizedRank);
        Repeat (8)
        {
            List.Add(EvalP.NormalizedRank, 0);
        }
    }
    Call GetPawnStructureScore;
    Glob.Eval.TaperedMg += Ret.GetPawnStructureScore.ScoreMg;
    Glob.Eval.TaperedEg += Ret.GetPawnStructureScore.ScoreEg;
    EvaluatePawnsImpl.Side = 1;
    Repeat (2)
    {
        If (EvaluatePawnsImpl.Side == 1)
        {
            EvaluatePawnsImpl.Forward = 8;
            EvaluatePawnsImpl.Backward = -8;
            EvaluatePawnsImpl.OurKingIdx = Glob.Board.OwnKingIdx;
            EvaluatePawnsImpl.TheirKingIdx = Glob.Board.OppKingIdx;
        }
        Else
        {
            EvaluatePawnsImpl.Forward = -8;
            EvaluatePawnsImpl.Backward = 8;
            EvaluatePawnsImpl.OurKingIdx = Glob.Board.OppKingIdx;
            EvaluatePawnsImpl.TheirKingIdx = Glob.Board.OwnKingIdx;
        }
        EvaluatePawnsImpl.Idx = 1;
        Repeat (8)
        {
            If (EvaluatePawnsImpl.Side == 1)
            {
                List.ReplaceItem(EvalP.NormalizedRank, EvaluatePawnsImpl.Idx, EvaluatePawnsImpl.Idx);
            }
            Else
            {
                List.ReplaceItem(EvalP.NormalizedRank, EvaluatePawnsImpl.Idx, (9 - EvaluatePawnsImpl.Idx));
            }
            EvaluatePawnsImpl.Idx += 1;
        }
        EvaluatePawnsImpl.File = 1;
        Repeat (8)
        {
            If (EvaluatePawnsImpl.Side == 1)
            {
                EvaluatePawnsImpl.OurForwardRank = (PawnAdvancePerFile[(EvaluatePawnsImpl.File + Const.PawnAdvance.OwnFront)] + 0);
            }
            Else
            {
                EvaluatePawnsImpl.OurForwardRank = (PawnAdvancePerFile[(EvaluatePawnsImpl.File + Const.PawnAdvance.OppFront)] + 0);
            }
            If (Not ((EvaluatePawnsImpl.OurForwardRank == 0)))
            {
                EvaluatePawnsImpl.Factor = (1 - (2 * (EvaluatePawnsImpl.Side == 2)));
                If (EvaluatePawnsImpl.Side == 1)
                {
                    EvaluatePawnsImpl.TheirBackwardRank = (PawnAdvancePerFile[EvaluatePawnsImpl.File] + 0);
                    EvaluatePawnsImpl.TheirPawnCount = (PawnCount[(EvaluatePawnsImpl.File + 8)] + 0);
                    If (EvaluatePawnsImpl.File > 1)
                    {
                        EvaluatePawnsImpl.LeftOurPawnRank = (PawnAdvancePerFile[((EvaluatePawnsImpl.File + Const.PawnAdvance.OwnFront) - 1)] + 0);
                        EvaluatePawnsImpl.LeftTheirPawnRank = (PawnAdvancePerFile[(EvaluatePawnsImpl.File - 1)] + 0);
                    }
                    Else
                    {
                        EvaluatePawnsImpl.LeftOurPawnRank = 0;
                        EvaluatePawnsImpl.LeftTheirPawnRank = 0;
                    }
                    If (EvaluatePawnsImpl.File < 8)
                    {
                        EvaluatePawnsImpl.RightOurPawnRank = (PawnAdvancePerFile[((EvaluatePawnsImpl.File + Const.PawnAdvance.OwnFront) + 1)] + 0);
                        EvaluatePawnsImpl.RightTheirPawnRank = (PawnAdvancePerFile[(EvaluatePawnsImpl.File + 1)] + 0);
                    }
                    Else
                    {
                        EvaluatePawnsImpl.RightOurPawnRank = 0;
                        EvaluatePawnsImpl.RightTheirPawnRank = 0;
                    }
                }
                Else
                {
                    EvaluatePawnsImpl.TheirBackwardRank = (PawnAdvancePerFile[(EvaluatePawnsImpl.File + Const.PawnAdvance.OwnRear)] + 0);
                    EvaluatePawnsImpl.TheirPawnCount = (PawnCount[EvaluatePawnsImpl.File] + 0);
                    If (EvaluatePawnsImpl.File > 1)
                    {
                        EvaluatePawnsImpl.LeftOurPawnRank = (PawnAdvancePerFile[((EvaluatePawnsImpl.File + Const.PawnAdvance.OppFront) - 1)] + 0);
                        EvaluatePawnsImpl.LeftTheirPawnRank = (PawnAdvancePerFile[((EvaluatePawnsImpl.File + Const.PawnAdvance.OwnRear) - 1)] + 0);
                    }
                    Else
                    {
                        EvaluatePawnsImpl.LeftOurPawnRank = 0;
                        EvaluatePawnsImpl.LeftTheirPawnRank = 0;
                    }
                    If (EvaluatePawnsImpl.File < 8)
                    {
                        EvaluatePawnsImpl.RightOurPawnRank = (PawnAdvancePerFile[((EvaluatePawnsImpl.File + Const.PawnAdvance.OppFront) + 1)] + 0);
                        EvaluatePawnsImpl.RightTheirPawnRank = (PawnAdvancePerFile[((EvaluatePawnsImpl.File + Const.PawnAdvance.OwnRear) + 1)] + 0);
                    }
                    Else
                    {
                        EvaluatePawnsImpl.RightOurPawnRank = 0;
                        EvaluatePawnsImpl.RightTheirPawnRank = 0;
                    }
                }
                EvaluatePawnsImpl.OurForwardIdx = (((EvaluatePawnsImpl.OurForwardRank - 1) * 8) + EvaluatePawnsImpl.File);
                EvaluatePawnsImpl.OurForwardRankNormalized = (EvalP.NormalizedRank[EvaluatePawnsImpl.OurForwardRank] + 0);
                EvaluatePawnsImpl.Opposed = (((Not ((EvaluatePawnsImpl.TheirBackwardRank == 0))) And (EvalP.NormalizedRank[EvaluatePawnsImpl.TheirBackwardRank] > EvaluatePawnsImpl.OurForwardRankNormalized)) + 0);
                EvaluatePawnsImpl.LeftTheirAhead = (((EvaluatePawnsImpl.LeftTheirPawnRank > 0) And (EvalP.NormalizedRank[EvaluatePawnsImpl.LeftTheirPawnRank] > EvaluatePawnsImpl.OurForwardRankNormalized)) + 0);
                EvaluatePawnsImpl.RightTheirAhead = (((EvaluatePawnsImpl.RightTheirPawnRank > 0) And (EvalP.NormalizedRank[EvaluatePawnsImpl.RightTheirPawnRank] > EvaluatePawnsImpl.OurForwardRankNormalized)) + 0);
                EvaluatePawnsImpl.PhalanxCount = (((EvaluatePawnsImpl.File > 1) And (Board[(EvaluatePawnsImpl.OurForwardIdx + -1)] == (GoK_OwnPawn * EvaluatePawnsImpl.Factor))) + ((EvaluatePawnsImpl.File < 8) And (Board[(EvaluatePawnsImpl.OurForwardIdx + 1)] == (GoK_OwnPawn * EvaluatePawnsImpl.Factor))));
                EvaluatePawnsImpl.LeverPushCount = (((EvaluatePawnsImpl.LeftTheirAhead == 1) And (EvalP.NormalizedRank[EvaluatePawnsImpl.LeftTheirPawnRank] == (EvaluatePawnsImpl.OurForwardRankNormalized + 2))) + ((EvaluatePawnsImpl.RightTheirAhead == 1) And (EvalP.NormalizedRank[EvaluatePawnsImpl.RightTheirPawnRank] == (EvaluatePawnsImpl.OurForwardRankNormalized + 2))));
                EvaluatePawnsImpl.Passed = 0;
                If (EvaluatePawnsImpl.Opposed == 0)
                {
                    If (((EvaluatePawnsImpl.LeftTheirAhead == 0) Or (EvalP.NormalizedRank[EvaluatePawnsImpl.LeftTheirPawnRank] == (EvaluatePawnsImpl.OurForwardRankNormalized + 1))) And ((EvaluatePawnsImpl.RightTheirAhead == 0) Or (EvalP.NormalizedRank[EvaluatePawnsImpl.RightTheirPawnRank] == (EvaluatePawnsImpl.OurForwardRankNormalized + 1))))
                    {
                        EvaluatePawnsImpl.Passed = 1;
                    }
                    If ((((EvaluatePawnsImpl.LeftTheirAhead == 0) Or (EvalP.NormalizedRank[EvaluatePawnsImpl.LeftTheirPawnRank] == (EvaluatePawnsImpl.OurForwardRankNormalized + 2))) And ((EvaluatePawnsImpl.RightTheirAhead == 0) Or (EvalP.NormalizedRank[EvaluatePawnsImpl.RightTheirPawnRank] == (EvaluatePawnsImpl.OurForwardRankNormalized + 2)))) And (Not ((EvaluatePawnsImpl.PhalanxCount < EvaluatePawnsImpl.LeverPushCount))))
                    {
                        EvaluatePawnsImpl.Passed = 1;
