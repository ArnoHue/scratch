Define InitMoveLookup (warp=true)
{
    List.DeleteItem(KnightMoveOffsets, all);
    List.DeleteItem(KingMoveOffsets, all);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, -2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, -1);
    List.Add(KnightMoveOffsets, 2);
    List.Add(KnightMoveOffsets, 1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, -1);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 0);
    List.Add(KingMoveOffsets, 1);
    List.Add(KingMoveOffsets, 1);
    List.DeleteItem(MoveLookupStraight, all);
    List.DeleteItem(MoveLookupCross, all);
    List.DeleteItem(MoveLookupOffsetsStraight, all);
    List.DeleteItem(MoveLookupOffsetsCross, all);
    List.DeleteItem(MoveLookupKnight, all);
    List.DeleteItem(MoveLookupKing, all);
    List.DeleteItem(MoveLookupIndexOffset, all);
    List.DeleteItem(MoveLookupLineIndexOffset, all);
    List.Add(MoveLookupOffsetsStraight, 1);
    List.Add(MoveLookupOffsetsStraight, 0);
    List.Add(MoveLookupOffsetsStraight, 0);
    List.Add(MoveLookupOffsetsStraight, 1);
    List.Add(MoveLookupOffsetsStraight, -1);
    List.Add(MoveLookupOffsetsStraight, 0);
    List.Add(MoveLookupOffsetsStraight, 0);
    List.Add(MoveLookupOffsetsStraight, -1);
    List.Add(MoveLookupOffsetsCross, 1);
    List.Add(MoveLookupOffsetsCross, 1);
    List.Add(MoveLookupOffsetsCross, 1);
    List.Add(MoveLookupOffsetsCross, -1);
    List.Add(MoveLookupOffsetsCross, -1);
    List.Add(MoveLookupOffsetsCross, 1);
    List.Add(MoveLookupOffsetsCross, -1);
    List.Add(MoveLookupOffsetsCross, -1);
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        Init.ML.ToSqIdx = 1;
        Repeat (4)
        {
            Init.ML.X = IdxToFile[Init.ML.FromSqIdx];
            Init.ML.Y = IdxToRank[Init.ML.FromSqIdx];
            Repeat (8)
            {
                Init.ML.X += MoveLookupOffsetsStraight[Init.ML.ToSqIdx];
                Init.ML.Y += MoveLookupOffsetsStraight[(Init.ML.ToSqIdx + 1)];
                List.Add(MoveLookupStraight, -1);
                If ((Init.ML.Y > 0) And (Init.ML.Y < 9))
                {
                    If ((Init.ML.X > 0) And (Init.ML.X < 9))
                    {
                        Init.ML.TargetIdx = (Init.ML.X + ((Init.ML.Y - 1) * 8));
                        List.ReplaceItem(MoveLookupStraight, List.Length(MoveLookupStraight), Init.ML.TargetIdx);
                    }
                }
            }
            Init.ML.ToSqIdx += 2;
        }
        Init.ML.ToSqIdx = 1;
        Repeat (4)
        {
            Init.ML.X = IdxToFile[Init.ML.FromSqIdx];
            Init.ML.Y = IdxToRank[Init.ML.FromSqIdx];
            Repeat (8)
            {
                Init.ML.X += MoveLookupOffsetsCross[Init.ML.ToSqIdx];
                Init.ML.Y += MoveLookupOffsetsCross[(Init.ML.ToSqIdx + 1)];
                List.Add(MoveLookupCross, -1);
                If ((Init.ML.Y > 0) And (Init.ML.Y < 9))
                {
                    If ((Init.ML.X > 0) And (Init.ML.X < 9))
                    {
                        Init.ML.TargetIdx = (Init.ML.X + ((Init.ML.Y - 1) * 8));
                        List.ReplaceItem(MoveLookupCross, List.Length(MoveLookupCross), Init.ML.TargetIdx);
                    }
                }
            }
            Init.ML.ToSqIdx += 2;
        }
        Init.ML.FromSqIdx += 1;
    }
    List.DeleteItem(MoveLookupRays, all);
    Init.ML.FromSqIdx = 1;
    Repeat (List.Length(MoveLookupStraight))
    {
        List.Add(MoveLookupRays, MoveLookupStraight[Init.ML.FromSqIdx]);
        Init.ML.FromSqIdx += 1;
    }
    Init.ML.FromSqIdx = 1;
    Repeat (List.Length(MoveLookupCross))
    {
        List.Add(MoveLookupRays, MoveLookupCross[Init.ML.FromSqIdx]);
        Init.ML.FromSqIdx += 1;
    }
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        List.InsertItem(MoveLookupIndexOffset, Init.ML.FromSqIdx, ((Init.ML.FromSqIdx - 1) * 8));
        List.InsertItem(MoveLookupLineIndexOffset, Init.ML.FromSqIdx, ((Init.ML.FromSqIdx - 1) * 32));
        Init.ML.FromSqIdx += 1;
    }
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        Init.ML.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(Init.ML.FromSqIdx)(KingMoveOffsets[Init.ML.ToSqIdx])(KingMoveOffsets[(Init.ML.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveLookupKing, Ret.GetTargetIdx.SqIdx);
            }
            Init.ML.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveLookupKing) == (Init.ML.FromSqIdx * 8))
        {
            List.Add(MoveLookupKing, -1);
        }
        Init.ML.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(Init.ML.FromSqIdx)(KnightMoveOffsets[Init.ML.ToSqIdx])(KnightMoveOffsets[(Init.ML.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveLookupKnight, Ret.GetTargetIdx.SqIdx);
            }
            Init.ML.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveLookupKnight) == (Init.ML.FromSqIdx * 8))
        {
            List.Add(MoveLookupKnight, -1);
        }
        Init.ML.FromSqIdx += 1;
    }
    List.DeleteItem(MoveToZeroPadStr, all);
    List.DeleteItem(MovePathDelta, all);
    List.DeleteItem(MovePathStepInc, all);
    Init.ML.FromSqIdx = 0;
    Repeat (10000)
    {
        If (Init.ML.FromSqIdx < 10)
        {
            List.Add(MoveToZeroPadStr, Operator.Join(000, Init.ML.FromSqIdx));
        }
        Else
        {
            If (Init.ML.FromSqIdx < 100)
            {
                List.Add(MoveToZeroPadStr, Operator.Join(00, Init.ML.FromSqIdx));
            }
            Else
            {
                If (Init.ML.FromSqIdx < 1000)
                {
                    List.Add(MoveToZeroPadStr, Operator.Join(0, Init.ML.FromSqIdx));
                }
                Else
                {
                    List.Add(MoveToZeroPadStr, Init.ML.FromSqIdx);
                }
            }
        }
        Init.ML.FromSqIdx += 1;
    }
    Repeat (10000)
    {
        List.Add(MovePathDelta, 0);
        List.Add(MovePathStepInc, 0);
    }
    Init.ML.FromSqIdx = 1;
    Repeat (64)
    {
        Init.ML.ToSqIdx = 1;
        Repeat (64)
        {
            Init.ML.X = (IdxToFile[Init.ML.ToSqIdx] - IdxToFile[Init.ML.FromSqIdx]);
            Init.ML.Y = (IdxToRank[Init.ML.ToSqIdx] - IdxToRank[Init.ML.FromSqIdx]);
            If ((Not ((Init.ML.FromSqIdx == Init.ML.ToSqIdx))) And (((Init.ML.X == 0) Or (Init.ML.Y == 0)) Or (abs(Init.ML.X) == abs(Init.ML.Y))))
            {
                If (abs(Init.ML.X) > abs(Init.ML.Y))
                {
                    Init.ML.Delta = abs(Init.ML.X);
                }
                Else
                {
                    Init.ML.Delta = abs(Init.ML.Y);
                }
                List.ReplaceItem(MovePathDelta, ((Init.ML.FromSqIdx * 100) + Init.ML.ToSqIdx), Init.ML.Delta);
                List.ReplaceItem(MovePathStepInc, ((Init.ML.FromSqIdx * 100) + Init.ML.ToSqIdx), ((8 * (Init.ML.Y / Init.ML.Delta)) + (Init.ML.X / Init.ML.Delta)));
            }
            Init.ML.ToSqIdx += 1;
        }
        Init.ML.FromSqIdx += 1;
    }
}

Define InitMovePosLookup (warp=true)
{
    List.DeleteAll(MovePosLookupMg);
    List.DeleteAll(MovePosLookupEg);
    List.DeleteAll(MoveHashLookup);
    List.DeleteAll(MovePosLookupLegal);
    Repeat (100000)
    {
        List.Add(MovePosLookupEg, 0);
        List.Add(MovePosLookupMg, 0);
        List.Add(MovePosLookupLegal, 0);
    }
    Repeat (100000)
    {
        List.Add(MovePosLookupEg, 0);
    }
    Repeat (100000)
    {
        List.Add(MovePosLookupMg, 0);
    }
    Repeat (100000)
    {
        List.Add(MovePosLookupLegal, 0);
    }
    Repeat (140000)
    {
        List.Add(MoveHashLookup, 0);
    }
    List.DeleteAll(Pieces);
    List.Add(Pieces, GoK_OwnKing);
    List.Add(Pieces, GoK_OwnQueen);
    List.Add(Pieces, GoK_OwnRook);
    List.Add(Pieces, GoK_OwnBishop);
    List.Add(Pieces, GoK_OwnKnight);
    List.Add(Pieces, GoK_OwnPawn);
    List.Add(Pieces, GoK_OppKing);
    List.Add(Pieces, GoK_OppQueen);
    List.Add(Pieces, GoK_OppRook);
    List.Add(Pieces, GoK_OppBishop);
    List.Add(Pieces, GoK_OppKnight);
    List.Add(Pieces, GoK_OppPawn);
    Init.MPL.PieceListIdx = 1;
    Repeat (List.Length(Pieces))
    {
        Init.MPL.SourcePiece = Pieces[Init.MPL.PieceListIdx];
        Init.MPL.IsSlidingPiece = 0;
        If (abs(Init.MPL.SourcePiece) == GoK_OwnBishop)
        {
            Init.MPL.IsSlidingPiece = 1;
        }
        If (abs(Init.MPL.SourcePiece) == GoK_OwnRook)
        {
            Init.MPL.IsSlidingPiece = 2;
        }
        If (abs(Init.MPL.SourcePiece) == GoK_OwnQueen)
        {
            Init.MPL.IsSlidingPiece = 3;
        }
        Init.MPL.SourceIdx = 0;
        Repeat (65)
        {
            If (Init.MPL.SourceIdx > 0)
            {
                Init.MPL.File = IdxToFile[Init.MPL.SourceIdx];
                Init.MPL.Rank = IdxToRank[Init.MPL.SourceIdx];
            }
            Else
            {
                Init.MPL.File = 0;
                Init.MPL.Rank = 0;
            }
            Call GetPiecePosScoreRaw(Init.MPL.SourcePiece)(Init.MPL.SourceIdx);
            Init.MPL.PosMg = Ret.GetPiecePosScoreRaw.Mg;
            Init.MPL.PosEg = Ret.GetPiecePosScoreRaw.Eg;
            Init.MPL.Mg = Init.MPL.PosMg;
            Init.MPL.Eg = Init.MPL.PosEg;
            Call GetPiecePosHash(Init.MPL.SourcePiece)(Init.MPL.SourceIdx);
            Init.MPL.SavedPiecePosHash = Ret.GetPiecePosHash.Hash;
            Init.MPL.TargetIdx = 0;
            Repeat (65)
            {
                Init.MPL.IsLegalMove = 0;
                If (((Not ((Init.MPL.SourceIdx == 0))) And (Not ((Init.MPL.TargetIdx == 0)))) And (Not ((Init.MPL.SourceIdx == Init.MPL.TargetIdx))))
                {
                    Init.MPL.X = abs((IdxToFile[Init.MPL.TargetIdx] - Init.MPL.File));
                    Init.MPL.Y = abs((IdxToRank[Init.MPL.TargetIdx] - Init.MPL.Rank));
                    If (Init.MPL.IsSlidingPiece == 0)
                    {
                        If (((Init.MPL.X < 2) And (Init.MPL.Y < 3)) Or ((Init.MPL.X < 3) And (Init.MPL.Y < 2)))
                        {
                            If (Init.MPL.SourcePiece == GoK_OwnPawn)
                            {
                                If (((IdxToRank[Init.MPL.TargetIdx] - Init.MPL.Rank) == 1) And (Init.MPL.X < 2))
                                {
                                    Init.MPL.IsLegalMove = 1;
                                }
                                Else
                                {
                                    If ((Init.MPL.Rank == 2) And ((Init.MPL.TargetIdx - Init.MPL.SourceIdx) == 16))
                                    {
                                        Init.MPL.IsLegalMove = 1;
                                    }
                                }
                            }
                            Else
                            {
                                If (Init.MPL.SourcePiece == GoK_OppPawn)
                                {
                                    If (((IdxToRank[Init.MPL.TargetIdx] - Init.MPL.Rank) == -1) And (Init.MPL.X < 2))
                                    {
                                        Init.MPL.IsLegalMove = 1;
                                    }
                                    Else
                                    {
                                        If ((Init.MPL.Rank == 7) And ((Init.MPL.TargetIdx - Init.MPL.SourceIdx) == -16))
                                        {
                                            Init.MPL.IsLegalMove = 1;
                                        }
                                    }
                                }
                                Else
                                {
                                    If (abs(Init.MPL.SourcePiece) == GoK_OwnKing)
                                    {
                                        If (((Init.MPL.X == 1) And (Init.MPL.Y < 2)) Or ((Init.MPL.Y == 1) And (Init.MPL.X < 2)))
                                        {
                                            Init.MPL.IsLegalMove = 1;
                                        }
                                    }
                                    Else
                                    {
                                        If (abs(Init.MPL.SourcePiece) == GoK_OwnKnight)
                                        {
                                            If (((Init.MPL.X == 1) And (Init.MPL.Y == 2)) Or ((Init.MPL.X == 2) And (Init.MPL.Y == 1)))
                                            {
                                                Init.MPL.IsLegalMove = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Else
                    {
                        If ((Init.MPL.X == 0) Or (Init.MPL.Y == 0))
                        {
                            If (Init.MPL.IsSlidingPiece > 1)
                            {
                                Init.MPL.IsLegalMove = 1;
                            }
                        }
                        Else
                        {
                            If (Init.MPL.X == Init.MPL.Y)
                            {
                                If (Not ((Init.MPL.IsSlidingPiece == 2)))
                                {
                                    Init.MPL.IsLegalMove = 1;
                                }
                            }
                        }
                    }
                }
                If ((Init.MPL.IsLegalMove == 1) Or ((Init.MPL.SourceIdx == 0) Or (Init.MPL.TargetIdx == 0)))
                {
                    Call GetPiecePosScoreRaw(Init.MPL.SourcePiece)(Init.MPL.TargetIdx);
                    Init.MPL.PosMg = Ret.GetPiecePosScoreRaw.Mg;
                    Init.MPL.PosEg = Ret.GetPiecePosScoreRaw.Eg;
                    Call GetPiecePosHash(Init.MPL.SourcePiece)(Init.MPL.TargetIdx);
                    If (Init.MPL.SourcePiece > 0)
                    {
                        Init.MPL.MoveKey = ((PieceIdxLookup[Init.MPL.SourcePiece] * 10000) + ((Init.MPL.SourceIdx * 100) + Init.MPL.TargetIdx));
                        List.ReplaceItem(MovePosLookupMg, Init.MPL.MoveKey, (Init.MPL.PosMg - Init.MPL.Mg));
                        List.ReplaceItem(MovePosLookupEg, Init.MPL.MoveKey, (Init.MPL.PosEg - Init.MPL.Eg));
                        List.ReplaceItem(MoveHashLookup, (Init.MPL.MoveKey + 60000), (Ret.GetPiecePosHash.Hash - Init.MPL.SavedPiecePosHash));
                        List.ReplaceItem(MovePosLookupLegal, Init.MPL.MoveKey, 1);
                    }
                    Else
                    {
                        Init.MPL.MoveKey = ((PieceIdxLookup[(0 - Init.MPL.SourcePiece)] * 10000) + ((Init.MPL.SourceIdx * 100) + Init.MPL.TargetIdx));
                        List.ReplaceItem(MovePosLookupMg, (Init.MPL.MoveKey + 100000), (Init.MPL.PosMg - Init.MPL.Mg));
                        List.ReplaceItem(MovePosLookupEg, (Init.MPL.MoveKey + 100000), (Init.MPL.PosEg - Init.MPL.Eg));
                        List.ReplaceItem(MoveHashLookup, Init.MPL.MoveKey, (Ret.GetPiecePosHash.Hash - Init.MPL.SavedPiecePosHash));
                        List.ReplaceItem(MovePosLookupLegal, (Init.MPL.MoveKey + 100000), 1);
                    }
                }
                Init.MPL.TargetIdx += 1;
            }
            Init.MPL.SourceIdx += 1;
        }
        Init.MPL.PieceListIdx += 1;
    }
}

