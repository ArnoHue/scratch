    Glob.ProfileReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(Ret.PS.Sum.Total)(14)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonHeader(bool WithTimes) (warp=true)
{
    Glob.ProfileReportLine = "";
    Call PS.Cell("Horizon")(9)((1 == 0));
    Call PS.Cell("Razor")(9)((1 == 1));
    Call PS.Cell("RFP")(9)((1 == 1));
    Call PS.Cell("NMP")(9)((1 == 1));
    Call PS.Cell("Futil")(9)((1 == 1));
    Call PS.Cell("Delta")(9)((1 == 1));
    Call PS.Cell("QSEE")(9)((1 == 1));
    Call PS.Cell("LMR")(9)((1 == 1));
    Call PS.Cell("PVS")(9)((1 == 1));
    Call PS.Cell("TTnode")(9)((1 == 1));
    Call PS.Cell("TThash")(9)((1 == 1));
    If WithTimes
    {
        Call PS.Cell("EvalS")(9)((1 == 1));
        Call PS.Cell("MgenS")(9)((1 == 1));
        Call PS.Cell("PickS")(9)((1 == 1));
    }
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonRow(string Horizon)(bool Ratios) (warp=true)
{
    If ((((((((((ProfileByHorizon[(Const.Profile.RazoringCalls + Horizon)] + ProfileByHorizon[(Const.Profile.RFPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.NMPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.FutilityCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.DeltaCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.QSEECalls + Horizon)]) + ProfileByHorizon[(Const.Profile.LMRCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.PVSCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.TTNodeProbe + Horizon)]) + ProfileByHorizon[(Const.Profile.TTMoveProbe + Horizon)]) > 0)
    {
        If (Horizon == 64)
        {
            PS.HorizonRow.Label = "Q";
        }
        Else
        {
            PS.HorizonRow.Label = (Horizon - 1);
        }
        Glob.ProfileReportLine = "";
        Call PS.Cell(PS.HorizonRow.Label)(9)((1 == 0));
        PS.HorizonRow.Idx = 1;
        If Ratios
        {
            Repeat (10)
            {
                Call PS.RatioCell(ProfileHorizonCols[(PS.HorizonRow.Idx + 1)])(ProfileHorizonCols[(PS.HorizonRow.Idx + 2)])(Horizon)((ProfileHorizonCols[(PS.HorizonRow.Idx + 3)] == 1));
                PS.HorizonRow.Idx += 4;
            }
        }
        Else
        {
            Repeat (10)
            {
                Call PS.Cell(ProfileByHorizon[(ProfileHorizonCols[PS.HorizonRow.Idx] + Horizon)])(9)((1 == 1));
                PS.HorizonRow.Idx += 4;
            }
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.EvaluateBaseIdx + Horizon)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * (ProfileTimeByHorizon[(Const.ProfileTime.MoveGenImplBaseIdx + Horizon)] + ProfileTimeByHorizon[(Const.ProfileTime.MoveGenBaseIdx + Horizon)]))) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.PickMoveBaseIdx + Horizon)])) / 100))(9)((1 == 1));
        }
        Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
    }
}

Define PS.RatioCell(string HitSlot)(string InvSlot)(string Horizon)(bool HitSlotCountsMisses) (warp=true)
{
    PS.RatioCell.CallCount = ProfileByHorizon[(InvSlot + Horizon)];
    PS.RatioCell.HitCount = ProfileByHorizon[(HitSlot + Horizon)];
    If HitSlotCountsMisses
    {
        PS.RatioCell.HitCount = (PS.RatioCell.CallCount - PS.RatioCell.HitCount);
    }
    Call PS.Cell(Operator.Join((floor(((1000 * PS.RatioCell.HitCount) / (PS.RatioCell.CallCount + (PS.RatioCell.CallCount == 0)))) / 10), "%"))(9)((1 == 1));
}

Define PS.Sum(string Slot) (warp=true)
{
    PS.Sum.Idx = 1;
    Ret.PS.Sum.Total = 0;
    Repeat (64)
    {
        Ret.PS.Sum.Total += ProfileByHorizon[(Slot + PS.Sum.Idx)];
        PS.Sum.Idx += 1;
    }
}

Define PS.SummaryRow(string Label)(string InvSlot)(string HitSlot)(bool HitSlotCountsMisses) (warp=true)
{
    Call PS.Sum(InvSlot);
    PS.SummaryRow.CallCount = Ret.PS.Sum.Total;
    Call PS.Sum(HitSlot);
    PS.SummaryRow.HitCount = Ret.PS.Sum.Total;
    If HitSlotCountsMisses
    {
        PS.SummaryRow.HitCount = (PS.SummaryRow.CallCount - PS.SummaryRow.HitCount);
    }
    Glob.ProfileReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(PS.SummaryRow.CallCount)(14)((1 == 1));
    Call PS.Cell(PS.SummaryRow.HitCount)(16)((1 == 1));
    Call PS.Cell(Operator.Join(floor(((100 * PS.SummaryRow.HitCount) / (PS.SummaryRow.CallCount + (PS.SummaryRow.CallCount == 0)))), "%"))(10)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define QuickSort (warp=true)
{
    List.DeleteAll(QSPartStack);
    Call QuickSortImpl(1)(List.Length(CalcMovesScoreList));
}

Define QuickSortImpl(string Lo)(string Hi) (warp=true)
{
    QSI.PivotScore = CalcMovesScoreList[floor(((Lo + Hi) / 2))];
    QSI.LowerIdx = Lo;
    QSI.UpperIdx = Hi;
    Repeat Until (QSI.LowerIdx > QSI.UpperIdx)
    {
        Repeat Until (Not ((CalcMovesScoreList[(QSI.LowerIdx + 0)] > QSI.PivotScore)))
        {
            QSI.LowerIdx += 1;
        }
        Repeat Until (Not ((CalcMovesScoreList[QSI.UpperIdx] < QSI.PivotScore)))
        {
            QSI.UpperIdx += -1;
        }
        If (Not ((QSI.LowerIdx > QSI.UpperIdx)))
        {
            QSI.SwapScore = CalcMovesScoreList[(QSI.LowerIdx + 0)];
            List.ReplaceItem(CalcMovesScoreList, (QSI.LowerIdx + 0), CalcMovesScoreList[QSI.UpperIdx]);
            List.ReplaceItem(CalcMovesScoreList, QSI.UpperIdx, QSI.SwapScore);
            QSI.SwapScore = CalcMovesMoveList[(QSI.LowerIdx + 0)];
            List.ReplaceItem(CalcMovesMoveList, (QSI.LowerIdx + 0), CalcMovesMoveList[QSI.UpperIdx]);
            List.ReplaceItem(CalcMovesMoveList, QSI.UpperIdx, QSI.SwapScore);
            QSI.LowerIdx += 1;
            QSI.UpperIdx += -1;
        }
    }
    If (Lo < QSI.UpperIdx)
    {
        List.Add(QSPartStack, QSI.LowerIdx);
        Call QuickSortImpl(Lo)(QSI.UpperIdx);
        QSI.LowerIdx = QSPartStack[(List.Length(QSPartStack) + 0)];
        List.DeleteItem(QSPartStack, (List.Length(QSPartStack) + 0));
    }
    If (QSI.LowerIdx < Hi)
    {
        Call QuickSortImpl(QSI.LowerIdx)(Hi);
    }
}

Define ResetSearchInfo (warp=true)
{
    Glob.InfoNodes = 0;
    Glob.InfoNodesQ = 0;
    Glob.InfoMoves = 0;
    Glob.InfoMovesQ = 0;
    Glob.InfoAdopted = 0;
    Glob.InfoLastDepth = Const.Null;
    If (Glob.ProfilerMode > Const.ProfilerMode.Off)
    {
        Call PrepStats;
        Glob.ProfBestMoveCount = 0;
        Glob.ProfBestMoveIdxSum = 0;
        Glob.ProfBestMoveCountQuiescence = 0;
        Glob.ProfBestMoveIdxSumQuiescence = 0;
        Glob.ProfBadOrderCount = 0;
    }
}

Define RevertMove(num Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.ReplaceItem(EnPassantTarget, 1, Glob.RootEnPassantTarget);
        List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    RM.Move = AppliedMove[Ply];
    RM.SourceIdx = floor((RM.Move / 100));
    If (RM.SourceIdx > 0)
    {
        RM.TargetIdx = floor((RM.Move % 100));
        List.ReplaceItem(Board, (RM.SourceIdx + 0), Board[(RM.TargetIdx + 0)]);
        List.ReplaceItem(Board, (RM.TargetIdx + 0), 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (PromotionPieces[Ply] > 0)
        {
            RM.PromotionCode = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
            If (RM.PromotionCode == 1)
            {
                Glob.OwnQueenCount += -1;
            }
            If (RM.PromotionCode == 2)
            {
                Glob.OwnRookCount += -1;
                Glob.OwnNonQueenMajorMinorCount += -1;
            }
            If (RM.PromotionCode == 3)
            {
                Glob.OwnBishopCount += -1;
                Glob.OwnNonQueenMajorMinorCount += -1;
            }
            If (RM.PromotionCode == 4)
            {
                Glob.OwnNonQueenMajorMinorCount += -1;
            }
            List.ReplaceItem(Board, RM.SourceIdx, GoK_OwnPawn);
            Glob.OwnPawnCount += 1;
        }
        Else
        {
            If (PromotionPieces[Ply] < 0)
            {
                RM.PromotionCode = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
                If (RM.PromotionCode == 1)
                {
                    Glob.OppQueenCount += -1;
                }
                If (RM.PromotionCode == 2)
                {
                    Glob.OppRookCount += -1;
                    Glob.OppNonQueenMajorMinorCount += -1;
                }
                If (RM.PromotionCode == 3)
                {
                    Glob.OppBishopCount += -1;
                    Glob.OppNonQueenMajorMinorCount += -1;
                }
                If (RM.PromotionCode == 4)
                {
                    Glob.OppNonQueenMajorMinorCount += -1;
                }
                List.ReplaceItem(Board, RM.SourceIdx, GoK_OppPawn);
                Glob.OppPawnCount += 1;
            }
        }
        If (Board[(RM.SourceIdx + 0)] == GoK_OwnKing)
        {
            Glob.OwnKingIdx = RM.SourceIdx;
        }
        If (Board[(RM.SourceIdx + 0)] == GoK_OppKing)
        {
            Glob.OppKingIdx = RM.SourceIdx;
        }
        RM.TargetPiece = TargetPieces[Ply];
        If (RM.TargetPiece > 0)
        {
            If (RM.TargetPiece == GoK_OwnPawn)
            {
                Glob.OwnPawnCount += 1;
            }
            Else
            {
                If (RM.TargetPiece < GoK_OwnQueen)
                {
                    Glob.OwnNonQueenMajorMinorCount += 1;
                    If (RM.TargetPiece == GoK_OwnRook)
                    {
                        Glob.OwnRookCount += 1;
                    }
                    If (RM.TargetPiece == GoK_OwnBishop)
                    {
                        Glob.OwnBishopCount += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_OwnQueen)
                    {
                        Glob.OwnQueenCount += 1;
                    }
                    Else
                    {
                        If (RM.TargetPiece == GoK_OwnKing)
                        {
                            Glob.OwnKingIdx = RM.TargetIdx;
                        }
                    }
                }
            }
        }
        If (RM.TargetPiece < 0)
        {
            If (RM.TargetPiece == GoK_OppPawn)
            {
                Glob.OppPawnCount += 1;
            }
            Else
            {
                If (RM.TargetPiece > GoK_OppQueen)
                {
                    Glob.OppNonQueenMajorMinorCount += 1;
                    If (RM.TargetPiece == GoK_OppRook)
                    {
                        Glob.OppRookCount += 1;
                    }
                    If (RM.TargetPiece == GoK_OppBishop)
                    {
                        Glob.OppBishopCount += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_OppQueen)
                    {
                        Glob.OppQueenCount += 1;
                    }
                    Else
                    {
                        If (RM.TargetPiece == GoK_OppKing)
                        {
                            Glob.OppKingIdx = RM.TargetIdx;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        If (RM.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(Board, 61, GoK_OppKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_OppRook);
            Glob.OppKingIdx = 61;
        }
        Else
        {
            If (RM.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(Board, 57, GoK_OppRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_OppKing);
                Glob.OppKingIdx = 61;
            }
            Else
            {
                If (RM.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(Board, 5, GoK_OwnKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_OwnRook);
                    Glob.OwnKingIdx = 5;
                }
                Else
                {
                    If (RM.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(Board, 1, GoK_OwnRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_OwnKing);
                        Glob.OwnKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
    Glob.KPHash = (PreviousBoardHash2[Ply] + 0);
    Glob.NonPawnHashOwn = PreviousNonPawnHashOwn[Ply];
    Glob.NonPawnHashOpp = PreviousNonPawnHashOpp[Ply];
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
}

Define RevertMoveLight(string Ply) (warp=true)
{
    RML.Move = AppliedMove[Ply];
    RML.SourceIdx = floor((RML.Move / 100));
    If (RML.SourceIdx > 0)
    {
        RML.TargetIdx = floor((RML.Move % 100));
        List.ReplaceItem(Board, RML.SourceIdx, Board[RML.TargetIdx]);
        List.ReplaceItem(Board, RML.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (Board[RML.SourceIdx] == GoK_OwnKing)
        {
            Glob.OwnKingIdx = RML.SourceIdx;
        }
        If (Board[RML.SourceIdx] == GoK_OppKing)
        {
            Glob.OppKingIdx = RML.SourceIdx;
        }
    }
    Else
    {
        If (RML.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(Board, 61, GoK_OppKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_OppRook);
            Glob.OppKingIdx = 61;
        }
        Else
        {
            If (RML.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(Board, 57, GoK_OppRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_OppKing);
                Glob.OppKingIdx = 61;
            }
            Else
            {
                If (RML.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(Board, 5, GoK_OwnKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_OwnRook);
                    Glob.OwnKingIdx = 5;
                }
                Else
                {
                    If (RML.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(Board, 1, GoK_OwnRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_OwnKing);
                        Glob.OwnKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
}

Define SayAsync(string Text)(num Duration) (warp=false)
{
    Glob.SayAsyncText = Text;
    Glob.SayAsyncDuration = Duration;
    Event.Broadcast("sayasyncmsg");
}

Define Search(string Alpha)(string Beta)(string Horizon)(string Ply)(bool InitialDeepening) (warp=true)
{
    Glob.IsInitialDeepening = (InitialDeepening + 0);
    Glob.SearchAlpha = Alpha;
    Glob.SearchBeta = Beta;
    Call Search_Init(Horizon);
    Glob.EvalDebugLog = 0;
    Glob.MoveCount = 0;
    Glob.MoveCountQuiescence = 0;
    Glob.NodeCount = 0;
    Glob.NodeCountQuiescence = 0;
    Search.Timer = (Sensing.DaysSince2000() * 86400);
    Call Search_Main(Alpha)(Beta)(Horizon)(Ply)((1 == 0))((1 == 0));
    Ret.Search.Eval = Ret.Search_Main.Eval;
    Ret.Search.Move = Ret.Search_Main.Move;
    Ret.Search.LegalMoveCount = PickedLegalMovesCount[Ply];
    Search.Timer = ((Sensing.DaysSince2000() * 86400) - Search.Timer);
    Call ExportBoardFEN(1);
    Glob.MPS = Operator.Round(((Glob.MoveCount + Glob.MoveCountQuiescence) / Search.Timer));
    Glob.NPS = Operator.Round(((Glob.NodeCount + Glob.NodeCountQuiescence) / Search.Timer));
    Glob.InfoNodes += Glob.NodeCount;
    Glob.InfoNodesQ += Glob.NodeCountQuiescence;
    Glob.InfoMoves += Glob.MoveCount;
    Glob.InfoMovesQ += Glob.MoveCountQuiescence;
    If (Not ((Ret.Search.Move == Const.Null)))
    {
        If ((Not ((Ret.Search.Eval == Const.Null))) And (Ret.Search.Eval > Alpha))
        {
            List.DeleteAll(PVStablePrev);
            Search.PVStableIdx = 1;
            Repeat (List.Length(PVStable))
            {
                List.Add(PVStablePrev, PVStable[Search.PVStableIdx]);
                Search.PVStableIdx += 1;
            }
        }
        Call IsQuietMove(Ret.Search.Move);
        If (Ret.IsQuietMove.IsQuiet == 1)
        {
            If (Not ((Ret.Search.Eval < Beta)))
            {
                Call StoreKillerMove(1)(Horizon)(Ret.Search.Move)((1 == 0))((1 == 0))((1 == 1));
            }
        }
    }
}

Define Search_CollectStats(string Horizon)(string Ply)(bool Quiescence)(string QSCode)(string FullCode) (warp=true)
{
    If Quiescence
    {
        Call Profile_CountByHorizon(QSCode)(Horizon)(Ply);
    }
    Else
    {
        Call Profile_CountByHorizon(FullCode)(Horizon)(Ply);
    }
}

Define Search_ComputeReduction(string Horizon)(string Ply)(bool Cutnode) (warp=true)
{
    If (ReductionBase[Ply] == Const.Null)
    {
        Call Search_ComputeReductionBase(Horizon)(Ply);
        If (Ret.Search_ComputeReductionBase.IsApplicable == 1)
        {
            List.ReplaceItem(ReductionBase, Ply, Ret.Search_ComputeReductionBase.Reduction);
        }
        Else
        {
            List.ReplaceItem(ReductionBase, Ply, Const.Null);
        }
    }
    Ret.Search_ComputeReduction.Reduction = 0;
    If (Not ((ReductionBase[Ply] == Const.Null)))
    {
        Ret.Search_ComputeReduction.Reduction = (floor((ReductionBase[Ply] / 128)) + Cutnode);
        If ((1 == 0) And (Ret.Search_ComputeReduction.Reduction > ((Horizon + PlyExtension[Ply]) - 2)))
        {
            Ret.Search_ComputeReduction.Reduction = ((Horizon + PlyExtension[Ply]) - 2);
        }
        If (Ret.Search_ComputeReduction.Reduction < 0)
        {
            Ret.Search_ComputeReduction.Reduction = 0;
        }
    }
}

Define Search_ComputeReductionBase(string Horizon)(string Ply) (warp=true)
{
    Search.CR.DangerousPush = 0;
    Ret.Search_ComputeReductionBase.IsApplicable = 0;
    Ret.Search_ComputeReductionBase.Reduction = 0;
    If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
    {
        Search.CR.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.CR.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.CR.PushRank < 4)))
        {
            Search.CR.DangerousPush = 1;
        }
    }
    If (Search.CR.DangerousPush == 1)
    {
        Stop(this script);
    }
    If ((((Horizon + PlyExtension[Ply]) > 2) And (CheckedState[Ply] == 0)) And ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0)))
    {
        Search.CR.MinMoveCount = (2 + (2 * (IsPvNode[Ply] == 1)));
        If (PickedLegalMovesCount[Ply] > Search.CR.MinMoveCount)
        {
            Ret.Search_ComputeReductionBase.IsApplicable = 1;
            Ret.Search_ComputeReductionBase.Reduction = floor(((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + PlyExtension[Ply]))) / 2.25)) * 128));
            If (IsPvNode[Ply] == 1)
            {
                Ret.Search_ComputeReductionBase.Reduction += -128;
            }
            If ((Ply > 1) And (PickedLegalMovesCount[(Ply - 1)] > 7))
            {
                Ret.Search_ComputeReductionBase.Reduction += -128;
            }
            If (PutsInCheck[Ply] == 1)
            {
                Ret.Search_ComputeReductionBase.Reduction += -64;
            }
            Search.CR.HistFrom = floor((AppliedMove[Ply] / 100));
            Search.CR.HistTo = floor((AppliedMove[Ply] % 100));
            If (Search.CR.HistFrom == 0)
            {
                If ((AppliedMove[Ply] == 65) Or (AppliedMove[Ply] == 66))
                {
                    Search.CR.HistFrom = 5;
                }
                Else
                {
                    Search.CR.HistFrom = 61;
                }
                If (AppliedMove[Ply] == 65)
                {
                    Search.CR.HistTo = 8;
                }
                Else
                {
                    If (AppliedMove[Ply] == 66)
                    {
                        Search.CR.HistTo = 1;
                    }
                    Else
                    {
                        If (AppliedMove[Ply] == 67)
                        {
                            Search.CR.HistTo = 64;
                        }
                        Else
                        {
                            Search.CR.HistTo = 57;
                        }
                    }
                }
            }
            Search.CR.KPHash = Glob.KPHash;
            If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
            {
                Glob.KPHash = PreviousBoardHash2[Ply];
            }
            Call GetHistoryStatScore(SourcePieces[Ply])(Search.CR.HistFrom)(Search.CR.HistTo)(AppliedMove[Ply])(Ply);
            Glob.KPHash = Search.CR.KPHash;
            Ret.Search_ComputeReductionBase.Reduction += (0 - Operator.Round(((Ret.GetHistoryStatScore.Score / 82000) * 128)));
            Call GetImproving(Ply);
            If (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))
            {
                Ret.Search_ComputeReductionBase.Reduction += -128;
            }
        }
    }
}

Define Search_DetectCheckmatesAndDraws(string Horizon)(string Ply)(bool Quiescence) (warp=true)
{
    If (Ply > 1)
    {
        Call //("Virtual king captures on previous ply => depth-corrected checkmate evaluation");
        If (abs(TargetPieces[(Ply - 1)]) == GoK_OwnKing)
        {
            List.ReplaceItem(SearchEval, Ply, (0 - (100000 - (List.Length(BoardHistoryFiftyMoves) - 1))));
            List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
            Stop(this script);
        }
    }
    If (ChebyshevDistance[((Glob.OppKingIdx * 100) + Glob.OwnKingIdx)] < 2)
    {
        List.ReplaceItem(SearchEval, Ply, (100000 - (List.Length(BoardHistoryFiftyMoves) - 0)));
        List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
        Stop(this script);
    }
    If (Ply > 1)
    {
        Call //("Rule of 50 moves");
        Call //("Draw-by-repetition detection. This happens on every ply and could be costly, so we check previous plies for pawn moves and captures, and the history tables for board hash. Only then we count hash occurrences for same side.");
        If ((BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 99) And (CheckedState[Ply] == 0))
        {
            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
            Stop(this script);
        }
        If (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 3)
        {
            Search.DCD.RepCount = 1;
            Search.DCD.RepHistCount = 0;
            If List.ContainsItem(PreviousBoardHash, Glob.CurrentBoardHash)
            {
                Search.DCD.SqIdx = (Ply - 2);
                Repeat Until ((Search.DCD.SqIdx < 2) Or (Search.DCD.RepCount > 2))
                {
                    If ((AppliedMove[Search.DCD.SqIdx] == 0) Or (AppliedMove[(Search.DCD.SqIdx + 1)] == 0))
                    {
                        Search.DCD.SqIdx = 0;
                    }
                    Else
                    {
                        If (((Glob.CurrentBoardHash == PreviousBoardHash[Search.DCD.SqIdx]) And (CastlingState[Ply] == CastlingState[(Search.DCD.SqIdx - 1)])) And (EnPassantTarget[Ply] == EnPassantTarget[(Search.DCD.SqIdx - 1)]))
                        {
                            Search.DCD.RepCount += 1;
                        }
                    }
                    Search.DCD.SqIdx += -2;
                }
            }
            If (Glob.IsInNullMove == 0)
            {
                If List.ContainsItem(BoardHistoryHash, Glob.CurrentBoardHash)
                {
                    Search.DCD.SqIdx = ((List.Length(BoardHistoryHash) - 1) + PlyIsOwn[Ply]);
                    Repeat Until ((Search.DCD.SqIdx < 1) Or (Search.DCD.RepHistCount > 2))
                    {
                        If ((Glob.CurrentBoardHash == BoardHistoryHash[Search.DCD.SqIdx]) And (CastlingState[Ply] == BoardHistoryMetaState[Search.DCD.SqIdx]))
                        {
                            Search.DCD.RepHistCount += 1;
                        }
                        Search.DCD.SqIdx += -2;
                    }
                }
            }
            If ((Search.DCD.RepCount > 1) Or (Search.DCD.RepHistCount > 1))
            {
                List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
                Stop(this script);
            }
        }
    }
    If (Ply > 1)
    {
        Call //("Draw-by-stalemate detection. This is expensive, and is only applied at low search depth or during late endgame stage (no minor pieces left)");
        If (Not (Quiescence))
        {
            If (Not ((CheckedState[Ply] == 1)))
            {
                If (PlyIsOwn[Ply] == 1)
                {
                    Search.DCD.QueenCount = Glob.OwnQueenCount;
                    Search.DCD.MinorMajorCount = Glob.OwnNonQueenMajorMinorCount;
                }
                Else
                {
                    Search.DCD.QueenCount = Glob.OppQueenCount;
                    Search.DCD.MinorMajorCount = Glob.OppNonQueenMajorMinorCount;
                }
                If ((Search.DCD.QueenCount == 0) And (Search.DCD.MinorMajorCount < 2))
                {
                    If (1 == 0)
                    {
                        Call IsDrawByStalemate((Ply + 2));
                        If (Ret.IsDrawByStalemate.IsDraw == 1)
                        {
                            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                            Stop(this script);
                        }
                    }
                }
            }
        }
        Call //("Fast draw-by-material verification");
        If (((Glob.OwnQueenCount == 0) And (Glob.OppQueenCount == 0)) And ((Glob.OwnPawnCount == 0) And (Glob.OppPawnCount == 0)))
        {
            If (((Glob.OwnRookCount == 0) And (Glob.OwnNonQueenMajorMinorCount < 2)) And ((Glob.OppRookCount == 0) And (Glob.OppNonQueenMajorMinorCount < 2)))
            {
                List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                Stop(this script);
            }
        }
        Call //("Special K-KP endgame draw detection, according to pawn and king position. Finds draws otherwise not visible within search horizon");
        If ((Ply > 1) And (Quiescence[(Ply - 1)] == 0))
        {
            If (((Glob.OppQueenCount + Glob.OppNonQueenMajorMinorCount) == 0) And ((Glob.OwnQueenCount + Glob.OwnNonQueenMajorMinorCount) == 0))
            {
                If ((Glob.OwnPawnCount + Glob.OppPawnCount) == 1)
                {
                    Search.DCD.SqIdx = 1;
                    Repeat (64)
                    {
                        Search.DCD.Piece = Board[(Search.DCD.SqIdx + 0)];
                        If ((Search.DCD.Piece == GoK_OppPawn) And (PlyIsOwn[Ply] == 0))
                        {
                            If ((IdxToFile[Search.DCD.SqIdx] == 1) Or (IdxToFile[Search.DCD.SqIdx] == 8))
                            {
                                If ((IdxToFile[Search.DCD.SqIdx] == IdxToFile[Glob.OwnKingIdx]) And (IdxToRank[Glob.OwnKingIdx] < IdxToRank[Search.DCD.SqIdx]))
                                {
                                    List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                                    Stop(this script);
                                }
                            }
                            Else
                            {
                                If (((Search.DCD.SqIdx - 8) == Glob.OwnKingIdx) Or ((Search.DCD.SqIdx - 16) == Glob.OwnKingIdx))
                                {
                                    If (Not ((((Search.DCD.SqIdx - 1) == Glob.OppKingIdx) Or ((Search.DCD.SqIdx + 1) == Glob.OppKingIdx))))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                                        Stop(this script);
                                    }
                                }
                                If ((Search.DCD.SqIdx - 24) == Glob.OwnKingIdx)
                                {
                                    If ((IdxToRank[Search.DCD.SqIdx] > 4) And ((Search.DCD.SqIdx - 8) == Glob.OppKingIdx))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                                        Stop(this script);
                                    }
                                }
                            }
                        }
                        Else
                        {
                            If ((Search.DCD.Piece == GoK_OwnPawn) And (PlyIsOwn[Ply] == 1))
                            {
                                If ((IdxToFile[Search.DCD.SqIdx] == 1) Or (IdxToFile[Search.DCD.SqIdx] == 8))
                                {
                                    If ((IdxToFile[Search.DCD.SqIdx] == IdxToFile[Glob.OppKingIdx]) And (IdxToRank[Glob.OppKingIdx] > IdxToRank[Search.DCD.SqIdx]))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                                        Stop(this script);
                                    }
                                }
                                Else
                                {
                                    If (((Search.DCD.SqIdx + 8) == Glob.OppKingIdx) Or ((Search.DCD.SqIdx + 16) == Glob.OppKingIdx))
                                    {
                                        If (Not ((((Search.DCD.SqIdx - 1) == Glob.OwnKingIdx) Or ((Search.DCD.SqIdx + 1) == Glob.OwnKingIdx))))
                                        {
                                            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                                            Stop(this script);
                                        }
                                    }
                                    If ((Search.DCD.SqIdx + 24) == Glob.OppKingIdx)
                                    {
                                        If ((IdxToRank[Search.DCD.SqIdx] < 5) And ((Search.DCD.SqIdx + 8) == Glob.OwnKingIdx))
                                        {
                                            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.NodeCount + Glob.NodeCountQuiescence) % 2)) - 1));
                                            Stop(this script);
                                        }
                                    }
                                }
                            }
                        }
                        Search.DCD.SqIdx += 1;
                    }
                }
            }
        }
    }
}

Define Search_DetectExtension(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    If (Not (Quiescence))
    {
        If (PlyExtension[Ply] == 0)
        {
            If ((Horizon > 1) And ((PutsInCheck[Ply] == 1) And ((StaticEval[Ply] == Const.Null) Or (abs(StaticEval[Ply]) > 35.5))))
            {
                List.ReplaceItem(PlyExtension, Ply, 1);
                If (Glob.ProfilerMode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_FutilityPruning(string Horizon)(string Ply)(bool Quiescence) (warp=true)
{
    Search.FP.DangerousPush = 0;
    Ret.Search_FutilityPruning.IsFutile = 0;
    If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
    {
        Search.FP.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search.FP.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search.FP.PushRank < 4)))
        {
            Search.FP.DangerousPush = 1;
        }
    }
    If ((Search.FP.DangerousPush == 1) And (Not (Quiescence)))
    {
        Stop(this script);
    }
    If (((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0)) And (PromotionPieces[Ply] == 0))
    {
        Call //("LMP");
        Search.FP.CanPrune = 0;
        If (PlyIsOwn[Ply] == 1)
        {
            Search.FP.PieceCount = (Glob.OwnQueenCount + Glob.OwnNonQueenMajorMinorCount);
        }
        Else
        {
            Search.FP.PieceCount = (Glob.OppQueenCount + Glob.OppNonQueenMajorMinorCount);
        }
        If (Not (Quiescence))
        {
            If (Not ((SearchEval[Ply] == Const.Null)))
            {
                If (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval))
                {
                    If (Search.FP.PieceCount > 0)
                    {
                        Search.FP.CanPrune = 1;
