                EvalP.Factor = (1 - (2 * (EvalP.Side == 2)));
                If (EvalP.Side == 1)
                {
                    EvalP.OurBackwardRank = (PawnAdvancePerFile[(EvalP.File + Const.PawnAdvance.OwnRear)] + 0);
                    EvalP.TheirBackwardRank = (PawnAdvancePerFile[EvalP.File] + 0);
