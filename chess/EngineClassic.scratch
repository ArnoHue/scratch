        Repeat (3)
        {
            If ((Init.KS.Rank > 0) And (Init.KS.Rank < 9))
            {
                Init.KS.File = (Init.KS.KingFile - 1);
                Repeat (3)
                {
                    If ((Not ((Init.KS.File == IdxToFile[Init.KS.KingIdx]))) Or (Not ((Init.KS.Rank == IdxToRank[Init.KS.KingIdx]))))
                    {
                        List.ReplaceItem(KingRings, Init.KS.KingRingIdx, (((Init.KS.Rank - 1) * 8) + Init.KS.File));
                        Init.KS.KingRingIdx += 1;
                    }
                    Init.KS.File += 1;
                }
            }
            Init.KS.Rank += 1;
        }
        Init.KS.KingIdx += 1;
    }
}

