            }
        }
        If (MovesIdxBestMove[Ply] > 0)
        {
            If Quiescence
            {
                Glob.Stats.BestMoveCountQuiescence += 1;
                Glob.Stats.BestMoveIdxSumQuiescence += MovesIdxBestMove[Ply];
            }
            Else
