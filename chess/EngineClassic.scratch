Define Log(string Txt1)(string Txt2)(string Txt3)(string Txt4)(string Txt5)(string Txt6)(string Txt7)(string Txt8) (warp=true)
{
    If (Glob.IsTestRunning == 1)
    {
        Stop(this script);
    }
    Log.ElapsedSec = (floor((((Sensing.DaysSince2000() * 86400) - Glob.ThinkTimeStart) * 1000)) / 1000);
    If Operator.Contains(Log.ElapsedSec, ".")
    {
        If ((Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 1)) == ".") Or (Operator.LetterOf(Log.ElapsedSec, (Variable.Length(Log.ElapsedSec) - 2)) == "."))
        {
            Log.ElapsedSec = Operator.Join(Log.ElapsedSec, 0);
        }
    }
    Else
    {
        Log.ElapsedSec = Operator.Join(Log.ElapsedSec, .000);
    }
    List.Add(Logfile, Operator.Join(Operator.Join(Log.ElapsedSec, ": "), Operator.Join(Txt1, Operator.Join(Txt2, Operator.Join(Txt3, Operator.Join(Txt4, Operator.Join(Txt5, Operator.Join(Txt6, Operator.Join(Txt7, Txt8)))))))));
}

Define LogEval (warp=true)
{
    Call CalcBoardStats;
    List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    Call ClearMoveList(1);
    Call AddMoveToList(0)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1);
    Call ClearMoveList(2);
    Call AddMoveToList(0)(2)(0);
    List.ReplaceItem(MovesIdx, 2, 1);
    Call ApplyMove(2);
    Call Log("========================================")("")("")("")("")("")("")("");
    Call LogEvalImpl(2)((1 == 1));
    Call Log("========================================")("")("")("")("")("")("")("");
    Call RevertMove(2);
    Call RevertMove(1);
}

Define LogEvalImpl(string Ply)(bool IsPlayerTurn) (warp=true)
{
    Call Log("Evaluation Analysis")("")("")("")("")("")("")("");
    Call ExportBoardFEN(IsPlayerTurn);
    Log.EvalI.FENLichess = Ret.ExportBoardFEN.FENLichess;
    Call Log(Ret.ExportBoardFEN.FEN)("")("")("")("")("")("")("");
    Call Log(Log.EvalI.FENLichess)("")("")("")("")("")("")("");
    Call Log("----------------------------------------")("")("")("")("")("")("")("");
    Call Log("    a   b   c   d   e   f   g   h")("")("")("")("")("")("")("");
    Call Log("  +---+---+---+---+---+---+---+---+")("")("")("")("")("")("")("");
    Log.EvalI.Rank = 8;
    Repeat (8)
    {
        Log.EvalI.ExportDataBoard = Operator.Join(Log.EvalI.Rank, " |");
        Log.EvalI.File = 1;
        Repeat (8)
        {
            Log.EvalI.SqIdx = ((((9 - Log.EvalI.Rank) - 1) * 8) + Log.EvalI.File);
            Log.EvalI.Piece = GoK_Board[Log.EvalI.SqIdx];
            Log.EvalI.PieceChar = " ";
            If (Log.EvalI.Piece == GoK_OwnPawn)
            {
                Log.EvalI.PieceChar = "p";
            }
            If (Log.EvalI.Piece == GoK_OwnKnight)
            {
                Log.EvalI.PieceChar = "n";
            }
            If (Log.EvalI.Piece == GoK_OwnBishop)
            {
                Log.EvalI.PieceChar = "b";
            }
            If (Log.EvalI.Piece == GoK_OwnRook)
            {
                Log.EvalI.PieceChar = "r";
            }
            If (Log.EvalI.Piece == GoK_OwnQueen)
            {
                Log.EvalI.PieceChar = "q";
            }
            If (Log.EvalI.Piece == GoK_OwnKing)
            {
                Log.EvalI.PieceChar = "k";
            }
            If (Log.EvalI.Piece == GoK_OppPawn)
            {
                Log.EvalI.PieceChar = "P";
            }
            If (Log.EvalI.Piece == GoK_OppKnight)
            {
                Log.EvalI.PieceChar = "N";
            }
            If (Log.EvalI.Piece == GoK_OppBishop)
            {
                Log.EvalI.PieceChar = "B";
            }
            If (Log.EvalI.Piece == GoK_OppRook)
            {
                Log.EvalI.PieceChar = "R";
            }
            If (Log.EvalI.Piece == GoK_OppQueen)
            {
                Log.EvalI.PieceChar = "Q";
            }
            If (Log.EvalI.Piece == GoK_OppKing)
            {
                Log.EvalI.PieceChar = "K";
            }
            Log.EvalI.ExportDataBoard = Operator.Join(Operator.Join(Operator.Join(Log.EvalI.ExportDataBoard, " "), Log.EvalI.PieceChar), " |");
            Log.EvalI.File += 1;
        }
        Call Log(Log.EvalI.ExportDataBoard)("")("")("")("")("")("")("");
        Call Log("  +---+---+---+---+---+---+---+---+")("")("")("")("")("")("")("");
        Log.EvalI.Rank += -1;
    }
    Call Log("----------------------------------------")("")("")("")("")("")("")("");
    Call TaperedEval.Init;
    Call Log("Eval.TaperedEval.ScaleFacor")(" = ")(Glob.TaperedEvalScaleFactor)("")("")("")("")("");
    Call Log("Eval.TaperedEval.Phase")(" = ")(Glob.TaperedEvalPhase)("")("")("")("")("");
    Call Log("----------------------------------------")("")("")("")("")("")("")("");
    Glob.EvalDebugLog = 1;
    Call Evaluate(Ply)((1 == 1));
    Glob.EvalDebugLog = 0;
}

Define LogPVEval (warp=true)
{
    If (List.Length(PVStable) > 1)
    {
        Call Log("========================================")("")("")("")("")("")("")("");
        Call Log("PV Leaf Evaluation Analysis")("")("")("")("")("")("")("");
        Call ExportBoardFEN((1 == 0));
        Call Log("PV: ")("[FEN "")(Ret.ExportBoardFEN.FEN)(""] ")(Glob.PV)("")("")("");
        Call Log("----------------------------------------")("")("")("")("")("")("")("");
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
        Log.PVE.Idx = 1;
        Repeat (List.Length(PVStable))
        {
            Call ClearMoveList(Log.PVE.Idx);
            Call AddMoveToList(PVStable[Log.PVE.Idx])(Log.PVE.Idx)(0);
            List.ReplaceItem(MovesIdx, Log.PVE.Idx, 1);
            Call ApplyMove(Log.PVE.Idx);
            Log.PVE.Idx += 1;
        }
        Call LogEvalImpl(List.Length(PVStable))((1 == 0));
        Call Log("========================================")("")("")("")("")("")("")("");
        Log.PVE.Idx = List.Length(PVStable);
        Repeat (List.Length(PVStable))
        {
            Call RevertMove(Log.PVE.Idx);
            Log.PVE.Idx += -1;
        }
    }
}

Define LogPVEvalLine(string Key)(string Val1)(string Val2)(string SquareIdx)(string Side)(string Move) (warp=true)
{
    If (Glob.EvalDebugLog == 1)
    {
        If ((Variable.Length(Key) > 0) And (Variable.Length(Val1) > 0))
        {
            Log.PVEL.ValuesStr = Operator.Join("(", Val1);
            If (Variable.Length(Val2) > 0)
            {
                Log.PVEL.ValuesStr = Operator.Join(Operator.Join(Log.PVEL.ValuesStr, ", "), Val2);
            }
            Log.PVEL.ValuesStr = Operator.Join(Log.PVEL.ValuesStr, ")");
            Log.PVEL.SquareStr = "[ ]";
            If (Variable.Length(SquareIdx) > 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    Log.PVEL.SqIdx = RankFlipIdx[SquareIdx];
                }
                Else
                {
                    Log.PVEL.SqIdx = SquareIdx;
                }
                Log.PVEL.SquareStr = Operator.Join(Operator.Join(" [", Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[Log.PVEL.SqIdx]), (9 - IdxToRank[Log.PVEL.SqIdx]))), "]");
            }
            Log.PVEL.SideStr = "[ ]";
            If (Side == 1)
            {
                Log.PVEL.SideStr = "[Engine]";
            }
            Else
            {
                If (Side == 2)
                {
                    Log.PVEL.SideStr = "[Player]";
                }
            }
            Log.PVEL.MoveStr = "[ ]";
            If (Variable.Length(Move) > 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    Log.PVEL.SourceIdx = RankFlipIdx[floor((Move / 100))];
                    Log.PVEL.TargetIdx = RankFlipIdx[floor((Move % 100))];
                }
                Else
                {
                    Log.PVEL.SourceIdx = floor((Move / 100));
                    Log.PVEL.TargetIdx = floor((Move % 100));
                }
                Log.PVEL.MoveStr = Operator.Join(Operator.Join(" [", Operator.Join(Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[Log.PVEL.SourceIdx]), (9 - IdxToRank[Log.PVEL.SourceIdx])), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[Log.PVEL.TargetIdx]), (9 - IdxToRank[Log.PVEL.TargetIdx])))), "]");
            }
            Call Log(Operator.Join(Key, " = "))(Log.PVEL.ValuesStr)(" ")(Log.PVEL.SquareStr)(" ")(Log.PVEL.MoveStr)(" ")(Log.PVEL.SideStr);
        }
    }
}

Define OnBestMoveChanged(string Move) (warp=true)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Move == Const.Null)
    {
        Stop(this script);
    }
    If (Move == GoK_OwnKingsideCastling)
    {
        Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
        Stg_BestMoveToIdx = GoK_ScreenIdx[7];
    }
    Else
    {
        If (Move == GoK_OwnQueensideCastling)
        {
            Stg_BestMoveFromIdx = GoK_ScreenIdx[5];
            Stg_BestMoveToIdx = GoK_ScreenIdx[3];
        }
        Else
        {
            Stg_BestMoveFromIdx = GoK_ScreenIdx[floor((Move / 100))];
            Stg_BestMoveToIdx = GoK_ScreenIdx[floor((Move % 100))];
        }
    }
    Event.Broadcast("showbestmove");
}

Define OnEvaluationChanged(string Eval) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Eval == Const.Null)
    {
        Stop(this script);
    }
    If (Glob.Level > 2)
    {
        If (Eval > 1000)
        {
            GoK_EvaluationValue = 100;
        }
        Else
        {
            If (Eval < -1000)
            {
                GoK_EvaluationValue = -100;
            }
            Else
            {
                GoK_EvaluationValue = (Eval / 10);
            }
        }
    }
    Else
    {
        GoK_EvaluationValue = 0;
    }
    Event.Broadcast("evaluationvaluechanged");
    Control.Wait(0);
}

Define OnProgressChanged(string Progress) (warp=false)
{
    If (Glob.IsDCI == 1)
    {
        Stop(this script);
    }
    If (Progress < 100)
    {
        GoK_ProgressValue = Progress;
    }
    Else
    {
        GoK_ProgressValue = 100;
    }
    Event.Broadcast("progressvaluechanged");
    Control.Wait(0);
}

Define OnRestart (warp=true)
{
    Const.ProfilerMode.Off = 0;
    Const.ProfilerMode.On = 1;
    Looks.Say("");
    List.DeleteAll(Logfile);
    List.Add(Logfile, Operator.Join("0.000: ", Glob.VersionString));
    List.Hide(BoardHistory);
    List.Hide(GameMovesAN);
    List.Hide(ExportData);
    List.Hide(ExportMoves);
    List.Hide(Logfile);
    List.Hide(Profile_Data);
    Variable.Hide(Glob.IdxDeepening);
    Variable.Hide(Glob.BestMoveEval);
    Variable.Hide(Glob.BestMove);
    Variable.Hide(Glob.NPS);
    Variable.Hide(Glob.MPS);
    Variable.Hide(Glob.PV);
    Variable.Hide(Glob.CustomThinkTime);
    Glob.ProfilerMode = Const.ProfilerMode.Off;
    Glob.DebugMode = 0;
    Glob.TimeControl = -1;
    Glob.IdxDeepening = Const.Null;
    Glob.BestMoveEval = Const.Null;
    Glob.NPS = Const.Null;
    Glob.MPS = Const.Null;
    Glob.CustomThinkTime = 0;
}

Define PadInto(string value)(string width)(bool rightJustify) (warp=true)
{
    Ret.PadInto.Padded = value;
    Repeat Until (Not ((Variable.Length(Ret.PadInto.Padded) < width)))
    {
        If rightJustify
        {
            Ret.PadInto.Padded = Operator.Join(" ", Ret.PadInto.Padded);
        }
        Else
        {
            Ret.PadInto.Padded = Operator.Join(Ret.PadInto.Padded, " ");
        }
    }
}

Define Perft(string PerftPly)(string PerftHorizon)(string PerftStaged) (warp=true)
{
    If (PerftHorizon == 0)
    {
        Glob.PerftNodes += 1;
        Stop(this script);
    }
    Call PerftPrepareNode(PerftPly)(PerftStaged);
    If (PerftStaged == 0)
    {
        List.ReplaceItem(MovesIdx, PerftPly, 1);
        Repeat (MovesCount[PerftPly])
        {
            Call ApplyMove(PerftPly);
            Call IsCheckedFast((PerftPly + 1));
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Call PerftValidateCheck(PerftPly);
                Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
            }
            Call RevertMove(PerftPly);
            List.ReplaceItem(MovesIdx, PerftPly, (MovesIdx[PerftPly] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, PerftPly, 1);
        List.ReplaceItem(PickMoveRes, PerftPly, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, PerftPly, 0);
        Repeat Until (PickMoveRes[PerftPly] == 0)
        {
            Call PickMove(PerftPly)((1 == 0));
            If (PickMoveRes[PerftPly] == 1)
            {
                Call IsCheckedFast((PerftPly + 1));
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Call PerftValidateCheck(PerftPly);
                    Call Perft((PerftPly + 1))((PerftHorizon - 1))(PerftStaged);
                }
                Call RevertMove(PerftPly);
            }
        }
    }
}

Define PerftDivide(string PerftDivHorizon)(string PerftDivStaged) (warp=true)
{
    List.DeleteAll(PerftDivideOut);
    Call PerftPrepareNode(1)(PerftDivStaged);
    If (PerftDivStaged == 0)
    {
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            Call ApplyMove(1);
            Call IsCheckedFast(2);
            If (Ret.IsCheckedFast.IsChecked == 0)
            {
                Glob.PerftNodes = 0;
                Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.PerftNodes));
            }
            Call RevertMove(1);
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
    Else
    {
        List.ReplaceItem(PickPhase, 1, 1);
        List.ReplaceItem(PickMoveRes, 1, 1);
        List.ReplaceItem(PickedPseudoLegalMovesCount, 1, 0);
        Repeat Until (PickMoveRes[1] == 0)
        {
            Call PickMove(1)((1 == 0));
            If (PickMoveRes[1] == 1)
            {
                Call IsCheckedFast(2);
                If (Ret.IsCheckedFast.IsChecked == 0)
                {
                    Glob.PerftNodes = 0;
                    Call Perft(2)((PerftDivHorizon - 1))(PerftDivStaged);
                    List.Add(PerftDivideOut, Operator.Join(Operator.Join(AppliedMove[1], ":"), Glob.PerftNodes));
                }
                Call RevertMove(1);
            }
        }
    }
}

Define PerftPrepareNode(string PerftPrepPly)(string PerftPrepStaged) (warp=true)
{
    If (PerftPrepPly == 1)
    {
        List.DeleteAll(PVStablePrev);
        List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
        Call SetInitialEnPassantTarget(1);
    }
    Else
    {
        List.ReplaceItem(CastlingState, PerftPrepPly, CastlingState[(PerftPrepPly - 1)]);
        List.ReplaceItem(EnPassantTarget, PerftPrepPly, EnPassantTarget[(PerftPrepPly - 1)]);
    }
    Call IsCheckedFast((PerftPrepPly + 1));
    List.ReplaceItem(CheckedState, PerftPrepPly, Ret.IsCheckedFast.IsChecked);
    List.ReplaceItem(BoardAttackedCalculated, PerftPrepPly, 0);
    Call PrepareCheckInfo(PerftPrepPly);
    If (PerftPrepStaged == 0)
    {
        Call CalcBoardAttackedOnDemand(PerftPrepPly)((1 == 0))((1 == 1))(99);
        Call GenerateMovesImplWrapper(PerftPrepPly)((1 == 0))((1 == 0));
    }
}

Define PerftValidateCheck(string ValPly) (warp=true)
{
    PVC.Source = floor((AppliedMove[ValPly] / 100));
    PVC.Target = floor((AppliedMove[ValPly] % 100));
    PVC.Fast = 0;
    Call IsCheckingPiece(PVC.Target);
    If (Ret.IsCheckingPiece.IsChecking == 1)
    {
        PVC.Fast = 1;
    }
    Call IsCheckingPieceDiscovery(PVC.Source)(PVC.Target)(ValPly);
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 1)
    {
        PVC.Fast = 1;
    }
    Call IsCheckedFast((ValPly + 2));
    PVC.Actual = Ret.IsCheckedFast.IsChecked;
    If (Not ((PVC.Fast == PVC.Actual)))
    {
        Glob.PerftCheckMismatches += 1;
        If (Glob.PerftCheckMismatches < 26)
        {
            PVC.Line = "";
            PVC.AppliedMoveIdx = 1;
            Repeat (ValPly)
            {
                PVC.Line = Operator.Join(PVC.Line, Operator.Join(AppliedMove[PVC.AppliedMoveIdx], " "));
                PVC.AppliedMoveIdx += 1;
            }
            Call TestLog("MISMATCH ply ")(ValPly)(" fast=")(PVC.Fast)(" actual=")(PVC.Actual)(" line: ")(PVC.Line);
        }
    }
}

Define PickMove(string Ply)(bool Quiescence) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.PickMoveBaseIdx)(Ply)(-1);
    }
    Call //("Staged move-generator implementation");
    If (PickPhase[Ply] == 1)
    {
        Call //("Phase 1: Look up hash-move from transposition table");
        List.ReplaceItem(HashMove, Ply, Const.Null);
        List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
        List.ReplaceItem(MovesCount, Ply, 0);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(MovesIdxBestMove, Ply, 0);
        Call ClearMoveList(Ply);
        If ((Ply > 1) Or (1 == 1))
        {
            PM.Move = Const.Null;
            PM.Found = 0;
            If (Not ((Ply > List.Length(PVStablePrev))))
            {
                PM.Found = 1;
                PM.CalcMovesScoreListIdx = 1;
                PM.PVStablePrevIdx = 1;
                Repeat Until ((PM.CalcMovesScoreListIdx == Ply) Or (PM.Found == 0))
                {
                    If (Not ((AppliedMove[PM.CalcMovesScoreListIdx] == PVStablePrev[(PM.PVStablePrevIdx + 0)])))
                    {
                        PM.Found = 0;
                    }
                    PM.CalcMovesScoreListIdx += 1;
                    PM.PVStablePrevIdx += 1;
                }
                If (PM.Found == 1)
                {
                    Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                    If List.ContainsItem(CalcMovesMoveList, PVStablePrev[Ply])
                    {
                        PM.Move = PVStablePrev[Ply];
                    }
                }
            }
            If ((Ply > 1) Or (1 == 1))
            {
                PM.TTQSMeta = NodeTTQSMeta[Ply];
                PM.TTHorizon = NodeTTHorizon[Ply];
                PM.TTHit = NodeTTHit[Ply];
                PM.HashMove = NodeTTMove[Ply];
                If (Glob.ProfilerMode == Const.ProfilerMode.On)
                {
                    Call Profile_CountByHorizon(Const.Profile.TTMoveProbe)(HorizonAtPly[Ply])(Ply);
                }
                If ((Not ((PM.TTHit == Const.Null))) And (PM.TTHit == 1))
                {
                    If ((PM.Move == Const.Null) And (Not ((PM.HashMove == Const.Null))))
                    {
                        Call IsQuiescentCheckCond(Ply);
                        If ((Not (Quiescence)) Or ((Quiescence And (PM.TTHorizon == -1)) And (Not (((PM.TTQSMeta == Const.Null) Or (PM.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue))))))
                        {
                            If (Not ((floor((PM.HashMove / 100)) == 0)))
                            {
                                PM.SourceIdx = floor((PM.HashMove / 100));
                                PM.TargetIdx = floor((PM.HashMove % 100));
                                PM.SourcePiece = Board[PM.SourceIdx];
                                PM.TargetPiece = Board[PM.TargetIdx];
                                PM.LegalMoveKey = ((PieceIdxLookup[abs(PM.SourcePiece)] * 10000) + PM.HashMove);
                                PM.HashMoveIsIllegalPawnCapture = 0;
                                If ((abs(PM.SourcePiece) == GoK_OwnPawn) And (PM.TargetPiece == 0))
                                {
                                    If (Not ((IdxToFile[PM.SourceIdx] == IdxToFile[PM.TargetIdx])))
                                    {
                                        PM.HashMoveIsIllegalPawnCapture = 1;
                                        If (Not ((EnPassantTarget[Ply] == Const.Null)))
                                        {
                                            If (PM.TargetIdx == (EnPassantTarget[Ply] + (8 * (((PM.SourcePiece > 0) * 2) - 1))))
                                            {
                                                PM.HashMoveIsIllegalPawnCapture = 0;
                                            }
                                        }
                                    }
                                }
                                If (((MovePosLookupLegal[(PM.LegalMoveKey + (Const.MovePosLookupOppBaseIdx * (PlyIsOwn[Ply] == 0)))] == 1) And (((PM.SourcePiece * PlySign[Ply]) > 0) And (Not (((PM.TargetPiece * PlySign[Ply]) > 0))))) And (PM.HashMoveIsIllegalPawnCapture == 0))
                                {
                                    PM.Move = PM.HashMove;
                                    If (Glob.ProfilerMode == Const.ProfilerMode.On)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                    }
                                }
                            }
                            Else
                            {
                                Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
                                If List.ContainsItem(CalcMovesMoveList, PM.HashMove)
                                {
                                    PM.Move = PM.HashMove;
                                    If (Glob.ProfilerMode == Const.ProfilerMode.On)
                                    {
                                        Call Profile_CountByHorizon(Const.Profile.TTMoveHit)(HorizonAtPly[Ply])(Ply);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            If (Not ((PM.Move == Const.Null)))
            {
                Call ClearMoveList(Ply);
                PM.MoveScore = 9100000;
                Call AddMoveToList(PM.Move)(Ply)(PM.MoveScore);
                List.ReplaceItem(MovesIdx, Ply, 0);
                List.ReplaceItem(PickPhase, Ply, 2);
                List.ReplaceItem(PickMoveRes, Ply, 0);
                Call PickMove.Iterate(Ply)(2);
                If (PickMoveRes[Ply] == 1)
                {
                    List.ReplaceItem(HashMove, Ply, AppliedMove[Ply]);
                    If (Glob.ProfilerMode == Const.ProfilerMode.On)
                    {
                        Call Profile_TimeByHorizon(Const.ProfileTime.PickMoveBaseIdx)(Ply)(1);
                    }
                    Stop(this script);
                }
            }
        }
        List.ReplaceItem(PickPhase, Ply, 2);
    }
    Call //("Phase 2: Search for MVV-LVA captures via attack tables (and from recently moved pieces when attack tables not up-to-date)");
    If (PickPhase[Ply] == 2)
    {
        If (Quiescence Or ((Ply < 4) Or (CheckedState[Ply] == 1)))
        {
            List.ReplaceItem(PickPhase, Ply, 6);
        }
        Else
        {
            Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 1));
            If (Not ((HashMove[Ply] == Const.Null)))
            {
                If (Not (List.ContainsItem(CalcMovesMoveList, HashMove[Ply])))
                {
                    List.Add(CalcMovesMoveList, HashMove[Ply]);
                    List.Add(CalcMovesScoreList, 9100000);
                }
            }
            PM.CalcMovesScoreListIdx = 1;
            Repeat (List.Length(CalcMovesScoreList))
            {
                If (CalcMovesScoreList[PM.CalcMovesScoreListIdx] < 7000000)
                {
                    List.DeleteItem(CalcMovesMoveList, PM.CalcMovesScoreListIdx);
                    List.DeleteItem(CalcMovesScoreList, PM.CalcMovesScoreListIdx);
                }
                Else
                {
                    PM.CalcMovesScoreListIdx += 1;
                }
            }
            Call SortMoveList(Ply);
            List.ReplaceItem(MovesIdx, Ply, 0);
            List.ReplaceItem(PickPhase, Ply, 3);
        }
    }
    Call //("Phase 3: Return moves found in phase 2 on subsequent PickMove() invocations");
    If (PickPhase[Ply] == 3)
    {
        Call PickMove.Iterate(Ply)(4);
    }
    If (PickPhase[Ply] == 4)
    {
        Call PrepareCurrentKillerMoves(Ply);
        PM.CounterMove = Const.Null;
        If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
        {
            PM.CounterMove = HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))];
        }
        Call PickMove.TryKCMove(CurrentKillerMoves[1])(Ply)(6000000);
        Call PickMove.TryKCMove(CurrentKillerMoves[2])(Ply)(5000000);
        If ((Not ((PM.CounterMove == Const.Null))) And ((Ply > 1) And ((Not (((Not ((CurrentKillerMoves[1] == Const.Null))) And (PM.CounterMove == CurrentKillerMoves[1])))) And (Not (((Not ((CurrentKillerMoves[2] == Const.Null))) And (PM.CounterMove == CurrentKillerMoves[2])))))))
        {
            Call PickMove.TryKCMove(HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))])(Ply)(4000000);
        }
        List.ReplaceItem(PickPhase, Ply, 5);
    }
    If (PickPhase[Ply] == 5)
    {
        Call PickMove.Iterate(Ply)(6);
    }
    Call //("Phase 6: Full move generator for all moves not found yet");
    If (PickPhase[Ply] == 6)
    {
        Call CalcBoardAttackedOnDemand(Ply)(Quiescence)((1 == 1))(4);
        Call GenerateMovesImplWrapper(Ply)((1 == 0))(Quiescence);
        List.ReplaceItem(MovesIdx, Ply, 0);
        List.ReplaceItem(PickPhase, Ply, 7);
    }
    Call //("Pick next move detected in phase 6, skip those applied in earlier stages");
    If (PickPhase[Ply] == 7)
    {
        Call PickMove.Iterate(Ply)(Const.PickPhase.Done);
    }
    If (PickPhase[Ply] == Const.PickPhase.Done)
    {
        List.ReplaceItem(PickMoveRes, Ply, 0);
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.PickMoveBaseIdx)(Ply)(1);
    }
}

Define PickMove.Iterate(string Ply)(string NextPhase) (warp=true)
{
    PMI.Picked = 1;
    Repeat Until ((PMI.Picked == 0) Or (Not ((MovesIdx[Ply] < MovesCount[Ply]))))
    {
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
        Call GetCurrentMove(Ply);
        PMI.Move = Ret.GetCurrentMove.Move;
        Call IsMovePicked(Ply)(PMI.Move);
        PMI.Picked = Ret.IsMovePicked.Picked;
        If (PMI.Picked == 0)
        {
            Call IsCastlingPathSafe(PMI.Move)(Ply);
            If (Ret.IsCastlingPathSafe.IsSafe == 0)
            {
                PMI.Picked = 1;
            }
            Else
            {
                List.ReplaceItem(PickedPseudoLegalMoves, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), PMI.Move);
                List.ReplaceItem(PickedPseudoLegalMovesScore, ((((Ply - 1) * Const.MaxMovesPerGeneration) + PickedPseudoLegalMovesCount[Ply]) + 1), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])]);
                List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, (PickedPseudoLegalMovesCount[Ply] + 1));
                Call ApplyMove(Ply);
                Call IsMoveLegalFast(Ply);
                If (Ret.IsMoveLegalFast.IsLegal == 1)
                {
                    Call RevertMove(Ply);
                    PMI.Picked = 1;
                }
            }
        }
    }
    If (PMI.Picked == 0)
    {
        List.ReplaceItem(PickMoveRes, Ply, 1);
        Stop(this script);
    }
    List.ReplaceItem(PickPhase, Ply, NextPhase);
}

Define PickMove.TryKCMove(string Move)(string Ply)(string Score) (warp=true)
{
    If (Move == Const.Null)
    {
        Stop(this script);
    }
    PMTKCM.SourceIdx = floor((Move / 100));
    If (PMTKCM.SourceIdx == 0)
    {
        Stop(this script);
    }
    If (((Board[PMTKCM.SourceIdx] * ((PlyIsOwn[Ply] * 2) - 1)) > 0) And (Board[floor((Move % 100))] == 0))
    {
        If (PlyIsOwn[Ply] == 1)
        {
            PMTKCM.IsLegal = MovePosLookupLegal[((PieceIdxLookup[abs(Board[PMTKCM.SourceIdx])] * 10000) + Move)];
        }
        Else
        {
            PMTKCM.IsLegal = MovePosLookupLegal[(((PieceIdxLookup[abs(Board[PMTKCM.SourceIdx])] * 10000) + Move) + Const.MovePosLookupOppBaseIdx)];
        }
        If (PMTKCM.IsLegal == 1)
        {
            Call IsMovePicked(Ply)(Move);
            If (Ret.IsMovePicked.Picked == 0)
            {
                List.DeleteAll(CalcMovesMoveList);
                List.DeleteAll(CalcMovesScoreList);
                Call GenerateMovesForSource(Ply)(PMTKCM.SourceIdx)((1 == 0))((1 == 0));
                If List.ContainsItem(CalcMovesMoveList, Move)
                {
                    PMTKCM.MoveScore = Score;
                    Call AddMoveToList(Move)(Ply)(PMTKCM.MoveScore);
                }
            }
        }
    }
}

Define PopulateAttackInfo(string Idx) (warp=true)
{
    PAI.DefenderIdx = 0;
    PAI.AttackerPiece = 0;
    PAI.DefenderPiece = 0;
    Ret.PopulateAttackInfo.Attacked = 0;
    Ret.PopulateAttackInfo.Defended = 0;
    Ret.PopulateAttackInfo.AttackerIdx = 0;
    Ret.PopulateAttackInfo.DefenderPieceAbs = 0;
    Ret.PopulateAttackInfo.AttackerPieceAbs = 0;
    If (Board[(Idx + 0)] > 0)
    {
        Ret.PopulateAttackInfo.Attacked = (BoardAttacked[(Idx + 64)] + 0);
        Ret.PopulateAttackInfo.Defended = (BoardAttacked[(Idx + 0)] + 0);
        If (Ret.PopulateAttackInfo.Attacked > 0)
        {
            Ret.PopulateAttackInfo.AttackerIdx = (BoardAttackedPiece[(Idx + 64)] + 0);
        }
        If (Ret.PopulateAttackInfo.Defended > 0)
        {
            PAI.DefenderIdx = (BoardAttackedPiece[(Idx + 0)] + 0);
        }
    }
    Else
    {
        If (Board[(Idx + 0)] < 0)
        {
            Ret.PopulateAttackInfo.Attacked = (BoardAttacked[(Idx + 0)] + 0);
            Ret.PopulateAttackInfo.Defended = (BoardAttacked[(Idx + 64)] + 0);
            If (Ret.PopulateAttackInfo.Attacked > 0)
            {
                Ret.PopulateAttackInfo.AttackerIdx = (BoardAttackedPiece[(Idx + 0)] + 0);
            }
            If (Ret.PopulateAttackInfo.Defended > 0)
            {
                PAI.DefenderIdx = (BoardAttackedPiece[(Idx + 64)] + 0);
            }
        }
    }
    If (Ret.PopulateAttackInfo.Attacked > 0)
    {
        PAI.AttackerPiece = (Board[(Ret.PopulateAttackInfo.AttackerIdx + 0)] + 0);
        Ret.PopulateAttackInfo.AttackerPieceAbs = abs(PAI.AttackerPiece);
    }
    If (Ret.PopulateAttackInfo.Defended > 0)
    {
        PAI.DefenderPiece = (Board[(PAI.DefenderIdx + 0)] + 0);
        Ret.PopulateAttackInfo.DefenderPieceAbs = abs(PAI.DefenderPiece);
    }
}

Define PrepareCheckInfo(string Ply) (warp=true)
{
    List.ReplaceItem(PinCount, Ply, 0);
    List.ReplaceItem(DiscoveryCount, Ply, 0);
    PCI.SideToMoveFactor = (((PlyIsOwn[Ply] == 1) * 2) - 1);
    If (PlyIsOwn[Ply] == 1)
    {
        PCI.OurKingIdx = Glob.OwnKingIdx;
        PCI.TheirKingIdx = Glob.OppKingIdx;
    }
    Else
    {
        PCI.OurKingIdx = Glob.OppKingIdx;
        PCI.TheirKingIdx = Glob.OwnKingIdx;
    }
    PCI.IsPin = 1;
    Repeat (2)
    {
        If (PCI.IsPin == 1)
        {
            PCI.KingIdx = PCI.OurKingIdx;
            PCI.SliderFactor = -1;
        }
        Else
        {
            PCI.KingIdx = PCI.TheirKingIdx;
            PCI.SliderFactor = 1;
        }
        PCI.LineBaseIdx = (MoveLookupLineIndexOffset[PCI.KingIdx] + 0);
        PCI.IsStraight = 1;
        Repeat (2)
        {
            If (PCI.IsStraight == 1)
            {
                PCI.SliderPiece = GoK_OwnRook;
                PCI.LookupBaseIdx = 0;
            }
            Else
            {
                PCI.SliderPiece = GoK_OwnBishop;
                PCI.LookupBaseIdx = List.Length(MoveLookupStraight);
            }
            PCI.DirIdx = 0;
            Repeat (4)
            {
                PCI.StepIdx = 1;
                PCI.BlockerIdx = 0;
                PCI.IsDone = 0;
                Repeat Until ((PCI.StepIdx > 8) Or (PCI.IsDone == 1))
                {
                    PCI.SqIdx = (MoveLookupRays[(PCI.LookupBaseIdx + ((PCI.LineBaseIdx + (PCI.DirIdx * 8)) + PCI.StepIdx))] + 0);
                    If (PCI.SqIdx == -1)
                    {
                        PCI.IsDone = 1;
                    }
                    Else
                    {
                        PCI.Piece = (Board[PCI.SqIdx] + 0);
                        If (Not ((PCI.Piece == 0)))
                        {
                            If (PCI.BlockerIdx == 0)
                            {
                                If ((PCI.Piece * PCI.SideToMoveFactor) > 0)
                                {
                                    PCI.BlockerIdx = PCI.SqIdx;
                                }
                                Else
                                {
                                    PCI.IsDone = 1;
                                }
                            }
                            Else
                            {
                                If ((((PCI.Piece * PCI.SideToMoveFactor) * PCI.SliderFactor) > 0) And ((abs(PCI.Piece) == GoK_OwnQueen) Or (abs(PCI.Piece) == PCI.SliderPiece)))
                                {
                                    If (PCI.IsPin == 1)
                                    {
                                        List.ReplaceItem(PinSq, (((Ply - 1) * Const.CheckInfoPlyStride) + (PinCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(PinRay, (((Ply - 1) * Const.CheckInfoPlyStride) + (PinCount[Ply] + 1)), abs(MovePathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(PinCount, Ply, (PinCount[Ply] + 1));
                                    }
                                    Else
                                    {
                                        List.ReplaceItem(DiscoverySq, (((Ply - 1) * Const.CheckInfoPlyStride) + (DiscoveryCount[Ply] + 1)), PCI.BlockerIdx);
                                        List.ReplaceItem(DiscoveryRay, (((Ply - 1) * Const.CheckInfoPlyStride) + (DiscoveryCount[Ply] + 1)), abs(MovePathStepInc[((PCI.KingIdx * 100) + PCI.BlockerIdx)]));
                                        List.ReplaceItem(DiscoveryCount, Ply, (DiscoveryCount[Ply] + 1));
                                    }
                                }
                                PCI.IsDone = 1;
                            }
                        }
                    }
                    PCI.StepIdx += 1;
                }
                PCI.DirIdx += 1;
            }
            PCI.IsStraight = 0;
        }
        PCI.IsPin = 0;
    }
}

Define PrepareCurrentKillerMoves(string Ply) (warp=true)
{
    List.DeleteAll(CurrentKillerMoves);
    PCKM.KillerMoveIdx = (((Ply - 1) * 2) + 1);
    List.Add(CurrentKillerMoves, KillerMoves[PCKM.KillerMoveIdx]);
    List.Add(CurrentKillerMoves, KillerMoves[(PCKM.KillerMoveIdx + 1)]);
}

Define PrepareEvalPiecesData(string Ply) (warp=true)
{
    Call GetEndgameLocal;
    If (Glob.IsScratch3 == 1)
    {
        Glob.IsExtendedEval = 0;
    }
    Else
    {
        Glob.IsExtendedEval = 1;
    }
    If (Glob.EvalDebugLog == 1)
    {
        Call Log("IsExtendedEvalLocal =")(Glob.IsExtendedEval)("")("")("")("")("")("");
    }
    List.DeleteAll(EvalPiecesIdx_All);
    List.DeleteAll(EvalPiecesIdx_Pawns);
    List.DeleteAll(EvalPiecesIdx_NonPawns);
    Glob.OppSingleBishopIdx = 0;
    Glob.OwnSingleBishopIdx = 0;
    PEPD.Idx = 1;
    Repeat (64)
    {
        PEPD.Piece = (Board[(PEPD.Idx + 0)] + 0);
        If (Not ((PEPD.Piece == 0)))
        {
            PEPD.PieceAbs = abs(PEPD.Piece);
            List.Add(EvalPiecesIdx_All, PEPD.Idx);
            If (PEPD.PieceAbs == GoK_OwnPawn)
            {
                List.Add(EvalPiecesIdx_Pawns, PEPD.Idx);
            }
            Else
            {
                List.Add(EvalPiecesIdx_NonPawns, PEPD.Idx);
                If (PEPD.PieceAbs == GoK_OwnRook)
                {
                }
                Else
                {
                    If (PEPD.Piece == GoK_OppBishop)
                    {
                        If (Glob.OppBishopCount == 1)
                        {
                            Glob.OppSingleBishopIdx = PEPD.Idx;
                        }
                    }
                    Else
                    {
                        If (PEPD.Piece == GoK_OwnBishop)
                        {
                            If (Glob.OwnBishopCount == 1)
                            {
                                Glob.OwnSingleBishopIdx = PEPD.Idx;
                            }
                        }
                    }
                }
            }
        }
        PEPD.Idx += 1;
    }
    List.DeleteItem(PawnCount, all);
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    Repeat (8)
    {
        List.Add(PawnCount, 0);
    }
    List.DeleteItem(PawnAdvancePerFile, all);
    Repeat (32)
    {
        List.Add(PawnAdvancePerFile, 0);
    }
    PEPD.EvalPieceIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_Pawns))
    {
        PEPD.Idx = (EvalPiecesIdx_Pawns[PEPD.EvalPieceIdx] + 0);
        PEPD.Piece = (Board[(PEPD.Idx + 0)] + 0);
        PEPD.File = (IdxToFile[(PEPD.Idx + 0)] + 0);
        PEPD.Rank = (IdxToRank[(PEPD.Idx + 0)] + 0);
        If (PEPD.Piece > 0)
        {
            List.ReplaceItem(PawnCount, (PEPD.File + 0), (PawnCount[(PEPD.File + 0)] + 1));
            If ((PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OwnRear)] == 0) Or (PEPD.Rank < PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OwnRear)]))
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OwnRear), PEPD.Rank);
            }
            If (PEPD.Rank > PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OwnFront)])
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OwnFront), PEPD.Rank);
            }
        }
        Else
        {
            List.ReplaceItem(PawnCount, ((PEPD.File + 0) + 8), (PawnCount[((PEPD.File + 0) + 8)] + 1));
            If (PEPD.Rank > PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OppRear)])
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OppRear), PEPD.Rank);
            }
            If ((PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OppFront)] == 0) Or (PEPD.Rank < PawnAdvancePerFile[(PEPD.File + Const.PawnAdvance.OppFront)]))
            {
                List.ReplaceItem(PawnAdvancePerFile, (PEPD.File + Const.PawnAdvance.OppFront), PEPD.Rank);
            }
        }
        PEPD.EvalPieceIdx += 1;
    }
    PEPD.Idx = 1;
    Repeat (64)
    {
        List.ReplaceItem(PieceMobility, (PEPD.Idx + 0), 0);
        List.ReplaceItem(PieceMobilityPrep, (((PEPD.Idx - 1) * 32) + 1), 0);
        PEPD.Idx += 1;
    }
    If (Glob.IsExtendedEval == 0)
    {
        Call ClearBoardAttackedByMove((Ply + 3));
        Call ClearBoardAttackedByMove((Ply + 2));
    }
    Else
    {
        Glob.CalcAttackStateWithMobility = 1;
        PEPD.Pin.Side = 1;
        Repeat (2)
        {
            If (PEPD.Pin.Side == 1)
            {
                PEPD.Pin.KingIdx = Glob.OwnKingIdx;
            }
            Else
            {
                PEPD.Pin.KingIdx = Glob.OppKingIdx;
            }
            PEPD.Pin.Sign = (1 - (2 * (PEPD.Pin.Side == 2)));
            PEPD.Pin.Dir = 1;
            Repeat (8)
            {
                PEPD.Pin.File = (IdxToFile[PEPD.Pin.KingIdx] + 0);
                PEPD.Pin.Rank = (IdxToRank[PEPD.Pin.KingIdx] + 0);
                PEPD.Pin.First = 0;
                PEPD.Pin.Done = 0;
                Repeat (7)
                {
                    If (PEPD.Pin.Done == 0)
                    {
                        PEPD.Pin.File += RayFileDelta[PEPD.Pin.Dir];
                        PEPD.Pin.Rank += RayRankDelta[PEPD.Pin.Dir];
                        If (((PEPD.Pin.File < 1) Or (PEPD.Pin.File > 8)) Or ((PEPD.Pin.Rank < 1) Or (PEPD.Pin.Rank > 8)))
                        {
                            PEPD.Pin.Done = 1;
                        }
                        Else
                        {
                            PEPD.Pin.Piece = (Board[(((PEPD.Pin.Rank - 1) * 8) + PEPD.Pin.File)] + 0);
                            If (Not ((PEPD.Pin.Piece == 0)))
                            {
                                If (PEPD.Pin.First == 0)
                                {
                                    If ((PEPD.Pin.Piece * PEPD.Pin.Sign) > 0)
                                    {
                                        PEPD.Pin.First = (((PEPD.Pin.Rank - 1) * 8) + PEPD.Pin.File);
                                    }
                                    Else
                                    {
                                        PEPD.Pin.Done = 1;
                                    }
                                }
                                Else
                                {
                                    If (((PEPD.Pin.Piece * PEPD.Pin.Sign) < 0) And ((abs(PEPD.Pin.Piece) == GoK_OwnQueen) Or (((PEPD.Pin.Dir < 5) And (abs(PEPD.Pin.Piece) == GoK_OwnRook)) Or ((PEPD.Pin.Dir > 4) And (abs(PEPD.Pin.Piece) == GoK_OwnBishop)))))
                                    {
                                        List.ReplaceItem(PinnedSquareDirection, PEPD.Pin.First, PEPD.Pin.Dir);
                                        List.Add(EvalPinnedSquares, PEPD.Pin.First);
                                    }
                                    PEPD.Pin.Done = 1;
                                }
                            }
                        }
                    }
                }
                PEPD.Pin.Dir += 1;
            }
            PEPD.Pin.Side += 1;
        }
        Call CalcBoardAttackedByMove((Ply + 3));
        Call CalcBoardAttackedByMove((Ply + 2));
        PEPD.Pin.ClearIdx = 1;
        Repeat (List.Length(EvalPinnedSquares))
        {
            List.ReplaceItem(PinnedSquareDirection, EvalPinnedSquares[PEPD.Pin.ClearIdx], 0);
            PEPD.Pin.ClearIdx += 1;
        }
        List.DeleteAll(EvalPinnedSquares);
        Glob.CalcAttackStateWithMobility = 0;
        PEPD.EvalPieceIdx = 1;
        Repeat (List.Length(EvalPiecesIdx_NonPawns))
        {
            PEPD.Idx = (EvalPiecesIdx_NonPawns[PEPD.EvalPieceIdx] + 0);
            PEPD.Piece = (Board[(PEPD.Idx + 0)] + 0);
            PEPD.SliceStart = (((PEPD.Idx - 1) * 32) + 1);
            PEPD.Mobility = (PieceMobilityPrep[(PEPD.SliceStart + 0)] + 0);
            PEPD.SliceStart += 1;
            Repeat (PEPD.Mobility)
            {
                PEPD.TargetIdx = (PieceMobilityPrep[(PEPD.SliceStart + 0)] + 0);
                If (PEPD.Piece > 0)
                {
                    If ((BoardAttackedTypeMask[((PEPD.TargetIdx + 0) + 64)] % 10) == 0)
                    {
                        PEPD.TargetPiece = (Board[(PEPD.TargetIdx + 0)] + 0);
                        PEPD.IsTargetCounted = 1;
                        If ((PEPD.TargetPiece == GoK_OwnKing) Or (PEPD.TargetPiece == GoK_OwnQueen))
                        {
                            PEPD.IsTargetCounted = 0;
                        }
                        If (PEPD.TargetPiece == GoK_OwnPawn)
                        {
                            If (IdxToRank[(PEPD.TargetIdx + 0)] < 4)
                            {
                                PEPD.IsTargetCounted = 0;
                            }
                            Else
                            {
                                If (Not ((Board[(PEPD.TargetIdx + 8)] == 0)))
                                {
                                    PEPD.IsTargetCounted = 0;
                                }
                            }
                        }
                        If (PEPD.IsTargetCounted == 1)
                        {
                            List.ReplaceItem(PieceMobility, (PEPD.Idx + 0), (PieceMobility[(PEPD.Idx + 0)] + 1));
                        }
                    }
                }
                Else
                {
                    If ((BoardAttackedTypeMask[(PEPD.TargetIdx + 0)] % 10) == 0)
                    {
                        PEPD.TargetPiece = (Board[(PEPD.TargetIdx + 0)] + 0);
                        PEPD.IsTargetCounted = 1;
                        If ((PEPD.TargetPiece == (0 - GoK_OwnKing)) Or (PEPD.TargetPiece == (0 - GoK_OwnQueen)))
                        {
                            PEPD.IsTargetCounted = 0;
                        }
                        If (PEPD.TargetPiece == (0 - GoK_OwnPawn))
                        {
                            If (IdxToRank[(PEPD.TargetIdx + 0)] > 5)
                            {
                                PEPD.IsTargetCounted = 0;
                            }
                            Else
                            {
                                If (Not ((Board[(PEPD.TargetIdx - 8)] == 0)))
                                {
                                    PEPD.IsTargetCounted = 0;
                                }
                            }
                        }
                        If (PEPD.IsTargetCounted == 1)
                        {
                            List.ReplaceItem(PieceMobility, (PEPD.Idx + 0), (PieceMobility[(PEPD.Idx + 0)] + 1));
                        }
                    }
                }
                PEPD.SliceStart += 1;
            }
            PEPD.EvalPieceIdx += 1;
        }
    }
    If (Glob.EvalDebugLog == 1)
    {
        Call Log("BoardAttacked = ")(BoardAttacked)("")("")("")("")("")("");
        Call Log("PieceMobility = ")(PieceMobility)("")("")("")("")("")("");
    }
}

Define PrepareEvasionMask(string Ply) (warp=true)
{
    PEM.BoardAttackedEvasionTargetIdx = 1;
    Repeat (64)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 0);
        PEM.BoardAttackedEvasionTargetIdx += 1;
    }
    Call IsCheckedFast((Ply + 1));
    If (Ret.IsCheckedFast.IsChecked == 1)
    {
        List.ReplaceItem(BoardAttackedEvasionTarget, Ret.IsCheckedFast.CheckedByIdx, 1);
        If (PlyIsOwn[Ply] == 1)
        {
            PEM.KingIdx = Glob.OwnKingIdx;
        }
        Else
        {
            PEM.KingIdx = Glob.OppKingIdx;
        }
        PEM.Move = ((Ret.IsCheckedFast.CheckedByIdx * 100) + PEM.KingIdx);
        PEM.BoardAttackedEvasionTargetIdx = Ret.IsCheckedFast.CheckedByIdx;
        Repeat ((MovePathDelta[PEM.Move] - 1))
        {
            PEM.BoardAttackedEvasionTargetIdx += MovePathStepInc[PEM.Move];
            List.ReplaceItem(BoardAttackedEvasionTarget, PEM.BoardAttackedEvasionTargetIdx, 1);
        }
    }
}

Define PrepStats (warp=true)
{
    List.DeleteAll(ProfileByHorizon);
    Repeat (1728)
    {
        List.Add(ProfileByHorizon, 0);
    }
    List.DeleteAll(HorizonAtPly);
    Repeat (64)
    {
        List.Add(HorizonAtPly, 0);
    }
    List.DeleteAll(ProfileTimeByHorizon);
    Repeat (576)
    {
        List.Add(ProfileTimeByHorizon, 0);
    }
}

Define PrintStats (warp=true)
{
    Call Log("============================================================")("")("")("")("")("")("")("");
    Glob.ProfileReportLine = "";
    Call PS.Cell("Function")(20)((1 == 0));
    Call PS.Cell("Invoked")(14)((1 == 1));
    Call PS.Cell("Hits/Pruned")(16)((1 == 1));
    Call PS.Cell("Ratio")(10)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call PS.SummaryRow("TT-static-eval")(Const.Profile.TTStaticProbe)(Const.Profile.TTStaticHit)((1 == 0));
    Call PS.SummaryRow("TT-node-eval")(Const.Profile.TTNodeProbe)(Const.Profile.TTNodeHit)((1 == 0));
    Call PS.SummaryRow("TT-hashmove")(Const.Profile.TTMoveProbe)(Const.Profile.TTMoveHit)((1 == 0));
    Call PS.SummaryRow("Razoring")(Const.Profile.RazoringTries)(Const.Profile.RazoringHits)((1 == 0));
    Call PS.SummaryRow("NMP")(Const.Profile.NMPTries)(Const.Profile.NMPHits)((1 == 0));
    Call PS.SummaryRow("RFP")(Const.Profile.RFPCalls)(Const.Profile.RFPHits)((1 == 0));
    Call PS.SummaryRow("Futility")(Const.Profile.FutilityCalls)(Const.Profile.FutilityHits)((1 == 0));
    Call PS.SummaryRow("Delta")(Const.Profile.DeltaCalls)(Const.Profile.DeltaHits)((1 == 0));
    Call PS.SummaryRow("QS-SEE")(Const.Profile.QSEECalls)(Const.Profile.QSEEHits)((1 == 0));
    Call PS.SummaryRow("LMR")(Const.Profile.LMRCalls)(Const.Profile.LMRHits)((1 == 0));
    Call PS.SummaryRow("Non-PV search")(Const.Profile.PVSCalls)(Const.Profile.PVSReSearches)((1 == 1));
    Call PS.CountRow("Full Search")(Const.Profile.FullCalls);
    Call PS.CountRow("Extensions")(Const.Profile.Ext);
    Call PS.CountRow("Singular extensions")(Const.Profile.ExtSingular);
    Call Log("============================================================")("")("")("")("")("")("")("");
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon invocations and runtime, s (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 1));
    PS.Horizon = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.Horizon)((1 == 0));
        PS.Horizon += 1;
    }
    Call Log("------------------------------------------------------------")("")("")("")("")("")("")("");
    Call Log("Per-horizon hit ratio (Q = quiescence)")("")("")("")("")("")("")("");
    Call PS.HorizonHeader((1 == 0));
    PS.Horizon = 1;
    Repeat (64)
    {
        Call PS.HorizonRow(PS.Horizon)((1 == 1));
        PS.Horizon += 1;
    }
}

Define Profile_CountByHorizon(string BaseIdx)(string Horizon)(string Ply) (warp=true)
{
    ProfCBH.Slot = (Horizon + 1);
    If (Quiescence[Ply] == 1)
    {
        ProfCBH.Slot = 64;
    }
    List.ReplaceItem(ProfileByHorizon, (BaseIdx + ProfCBH.Slot), (ProfileByHorizon[(BaseIdx + ProfCBH.Slot)] + 1));
}

Define Profile_MethodEnter(num Id) (warp=true)
{
    Repeat Until (Not ((List.Length(Profile_Data) < Id)))
    {
        List.Add(Profile_Data, 0);
    }
    List.ReplaceItem(Profile_Data, Id, (Profile_Data[Id] - ((Sensing.DaysSince2000() * 24) * 3600)));
}

Define Profile_MethodExit(num Id) (warp=false)
{
    List.ReplaceItem(Profile_Data, Id, (Profile_Data[Id] + ((Sensing.DaysSince2000() * 24) * 3600)));
}

Define Profile_Reset (warp=true)
{
    List.DeleteItem(Profile_Data, all);
}

Define Profile_TimeByHorizon(string BaseIdx)(string Ply)(string TimeSign) (warp=true)
{
    ProfTBH.Slot = (HorizonAtPly[Ply] + 1);
    If (Quiescence[Ply] == 1)
    {
        ProfTBH.Slot = 64;
    }
    List.ReplaceItem(ProfileTimeByHorizon, (BaseIdx + ProfTBH.Slot), (ProfileTimeByHorizon[(BaseIdx + ProfTBH.Slot)] + (TimeSign * ((Sensing.DaysSince2000() * 24) * 3600))));
}

Define PS.Cell(string Value)(string Width)(bool RightJustify) (warp=true)
{
    Call PadInto(Value)(Width)(RightJustify);
    Glob.ProfileReportLine = Operator.Join(Glob.ProfileReportLine, Ret.PadInto.Padded);
}

Define PS.CountRow(string Label)(string Slot) (warp=true)
{
    Call PS.Sum(Slot);
    Glob.ProfileReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(Ret.PS.Sum.Total)(14)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonHeader(bool WithTimes) (warp=true)
{
    Glob.ProfileReportLine = "";
    Call PS.Cell("Horizon")(9)((1 == 0));
    Call PS.Cell("Razor")(9)((1 == 1));
    Call PS.Cell("RFP")(9)((1 == 1));
    Call PS.Cell("NMP")(9)((1 == 1));
    Call PS.Cell("Futil")(9)((1 == 1));
    Call PS.Cell("Delta")(9)((1 == 1));
    Call PS.Cell("QSEE")(9)((1 == 1));
    Call PS.Cell("LMR")(9)((1 == 1));
    Call PS.Cell("PVS")(9)((1 == 1));
    Call PS.Cell("TTnode")(9)((1 == 1));
    Call PS.Cell("TThash")(9)((1 == 1));
    If WithTimes
    {
        Call PS.Cell("EvalS")(9)((1 == 1));
        Call PS.Cell("MgenS")(9)((1 == 1));
        Call PS.Cell("PickS")(9)((1 == 1));
    }
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonRow(string Horizon)(bool Ratios) (warp=true)
{
    If ((((((((((ProfileByHorizon[(Const.Profile.RazoringCalls + Horizon)] + ProfileByHorizon[(Const.Profile.RFPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.NMPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.FutilityCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.DeltaCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.QSEECalls + Horizon)]) + ProfileByHorizon[(Const.Profile.LMRCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.PVSCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.TTNodeProbe + Horizon)]) + ProfileByHorizon[(Const.Profile.TTMoveProbe + Horizon)]) > 0)
    {
        If (Horizon == 64)
        {
            PS.HorizonRow.Label = "Q";
        }
        Else
        {
            PS.HorizonRow.Label = (Horizon - 1);
        }
        Glob.ProfileReportLine = "";
        Call PS.Cell(PS.HorizonRow.Label)(9)((1 == 0));
        If Ratios
        {
            Call PS.RatioCell(Const.Profile.RazoringHits)(Const.Profile.RazoringCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.RFPHits)(Const.Profile.RFPCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.NMPHits)(Const.Profile.NMPCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.FutilityHits)(Const.Profile.FutilityCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.DeltaHits)(Const.Profile.DeltaCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.QSEEHits)(Const.Profile.QSEECalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.LMRHits)(Const.Profile.LMRCalls)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.PVSReSearches)(Const.Profile.PVSCalls)(Horizon)((1 == 1));
            Call PS.RatioCell(Const.Profile.TTNodeHit)(Const.Profile.TTNodeProbe)(Horizon)((1 == 0));
            Call PS.RatioCell(Const.Profile.TTMoveHit)(Const.Profile.TTMoveProbe)(Horizon)((1 == 0));
        }
        Else
        {
            Call PS.Cell(ProfileByHorizon[(Const.Profile.RazoringCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.RFPCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.NMPCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.FutilityCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.DeltaCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.QSEECalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.LMRCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.PVSCalls + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTNodeProbe + Horizon)])(9)((1 == 1));
            Call PS.Cell(ProfileByHorizon[(Const.Profile.TTMoveProbe + Horizon)])(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.EvaluateBaseIdx + Horizon)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * (ProfileTimeByHorizon[(Const.ProfileTime.MoveGenImplBaseIdx + Horizon)] + ProfileTimeByHorizon[(Const.ProfileTime.MoveGenBaseIdx + Horizon)]))) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.PickMoveBaseIdx + Horizon)])) / 100))(9)((1 == 1));
        }
        Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
    }
}

Define PS.RatioCell(string HitSlot)(string InvSlot)(string Horizon)(bool HitSlotCountsMisses) (warp=true)
{
    PS.RatioCell.CallCount = ProfileByHorizon[(InvSlot + Horizon)];
    PS.RatioCell.HitCount = ProfileByHorizon[(HitSlot + Horizon)];
    If HitSlotCountsMisses
    {
        PS.RatioCell.HitCount = (PS.RatioCell.CallCount - PS.RatioCell.HitCount);
    }
    Call PS.Cell(Operator.Join((floor(((1000 * PS.RatioCell.HitCount) / (PS.RatioCell.CallCount + (PS.RatioCell.CallCount == 0)))) / 10), "%"))(9)((1 == 1));
}

Define PS.Sum(string Slot) (warp=true)
{
    PS.Sum.Idx = 1;
    Ret.PS.Sum.Total = 0;
    Repeat (64)
    {
        Ret.PS.Sum.Total += ProfileByHorizon[(Slot + PS.Sum.Idx)];
        PS.Sum.Idx += 1;
    }
}

Define PS.SummaryRow(string Label)(string InvSlot)(string HitSlot)(bool HitSlotCountsMisses) (warp=true)
{
    Call PS.Sum(InvSlot);
    PS.SummaryRow.CallCount = Ret.PS.Sum.Total;
    Call PS.Sum(HitSlot);
    PS.SummaryRow.HitCount = Ret.PS.Sum.Total;
    If HitSlotCountsMisses
    {
        PS.SummaryRow.HitCount = (PS.SummaryRow.CallCount - PS.SummaryRow.HitCount);
    }
    Glob.ProfileReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(PS.SummaryRow.CallCount)(14)((1 == 1));
    Call PS.Cell(PS.SummaryRow.HitCount)(16)((1 == 1));
    Call PS.Cell(Operator.Join(floor(((100 * PS.SummaryRow.HitCount) / (PS.SummaryRow.CallCount + (PS.SummaryRow.CallCount == 0)))), "%"))(10)((1 == 1));
    Call Log(Glob.ProfileReportLine)("")("")("")("")("")("")("");
}

Define QuickSort (warp=true)
{
    List.DeleteAll(QSPartStack);
    Call QuickSortImpl(1)(List.Length(CalcMovesScoreList));
}

Define QuickSortImpl(string Lo)(string Hi) (warp=true)
{
    QSI.PivotScore = CalcMovesScoreList[floor(((Lo + Hi) / 2))];
    QSI.LowerIdx = Lo;
    QSI.UpperIdx = Hi;
    Repeat Until (QSI.LowerIdx > QSI.UpperIdx)
    {
        Repeat Until (Not ((CalcMovesScoreList[(QSI.LowerIdx + 0)] > QSI.PivotScore)))
        {
            QSI.LowerIdx += 1;
        }
        Repeat Until (Not ((CalcMovesScoreList[QSI.UpperIdx] < QSI.PivotScore)))
        {
            QSI.UpperIdx += -1;
        }
        If (Not ((QSI.LowerIdx > QSI.UpperIdx)))
        {
            QSI.SwapScore = CalcMovesScoreList[(QSI.LowerIdx + 0)];
            List.ReplaceItem(CalcMovesScoreList, (QSI.LowerIdx + 0), CalcMovesScoreList[QSI.UpperIdx]);
            List.ReplaceItem(CalcMovesScoreList, QSI.UpperIdx, QSI.SwapScore);
            QSI.SwapScore = CalcMovesMoveList[(QSI.LowerIdx + 0)];
            List.ReplaceItem(CalcMovesMoveList, (QSI.LowerIdx + 0), CalcMovesMoveList[QSI.UpperIdx]);
            List.ReplaceItem(CalcMovesMoveList, QSI.UpperIdx, QSI.SwapScore);
            QSI.LowerIdx += 1;
            QSI.UpperIdx += -1;
        }
    }
    If (Lo < QSI.UpperIdx)
    {
        List.Add(QSPartStack, QSI.LowerIdx);
        Call QuickSortImpl(Lo)(QSI.UpperIdx);
        QSI.LowerIdx = QSPartStack[(List.Length(QSPartStack) + 0)];
        List.DeleteItem(QSPartStack, (List.Length(QSPartStack) + 0));
    }
    If (QSI.LowerIdx < Hi)
    {
        Call QuickSortImpl(QSI.LowerIdx)(Hi);
    }
}

Define RevertMove(num Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.ReplaceItem(EnPassantTarget, 1, Glob.RootEnPassantTarget);
        List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    RM.Move = AppliedMove[Ply];
    RM.SourceIdx = floor((RM.Move / 100));
    If (RM.SourceIdx > 0)
    {
        RM.TargetIdx = floor((RM.Move % 100));
        List.ReplaceItem(Board, (RM.SourceIdx + 0), Board[(RM.TargetIdx + 0)]);
        List.ReplaceItem(Board, (RM.TargetIdx + 0), 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (PromotionPieces[Ply] > 0)
        {
            RM.PromotionCode = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
            If (RM.PromotionCode == 1)
            {
                Glob.OwnQueenCount += -1;
            }
            If (RM.PromotionCode == 2)
            {
                Glob.OwnRookCount += -1;
                Glob.OwnNonQueenMajorMinorCount += -1;
            }
            If (RM.PromotionCode == 3)
            {
                Glob.OwnBishopCount += -1;
                Glob.OwnNonQueenMajorMinorCount += -1;
            }
            If (RM.PromotionCode == 4)
            {
                Glob.OwnNonQueenMajorMinorCount += -1;
            }
            List.ReplaceItem(Board, RM.SourceIdx, GoK_OwnPawn);
            Glob.OwnPawnCount += 1;
        }
        Else
        {
            If (PromotionPieces[Ply] < 0)
            {
                RM.PromotionCode = (Operator.LetterOf(RM.Move, Variable.Length(RM.Move)) + 0);
                If (RM.PromotionCode == 1)
                {
                    Glob.OppQueenCount += -1;
                }
                If (RM.PromotionCode == 2)
                {
                    Glob.OppRookCount += -1;
                    Glob.OppNonQueenMajorMinorCount += -1;
                }
                If (RM.PromotionCode == 3)
                {
                    Glob.OppBishopCount += -1;
                    Glob.OppNonQueenMajorMinorCount += -1;
                }
                If (RM.PromotionCode == 4)
                {
                    Glob.OppNonQueenMajorMinorCount += -1;
                }
                List.ReplaceItem(Board, RM.SourceIdx, GoK_OppPawn);
                Glob.OppPawnCount += 1;
            }
        }
        If (Board[(RM.SourceIdx + 0)] == GoK_OwnKing)
        {
            Glob.OwnKingIdx = RM.SourceIdx;
        }
        If (Board[(RM.SourceIdx + 0)] == GoK_OppKing)
        {
            Glob.OppKingIdx = RM.SourceIdx;
        }
        RM.TargetPiece = TargetPieces[Ply];
        If (RM.TargetPiece > 0)
        {
            If (RM.TargetPiece == GoK_OwnPawn)
            {
                Glob.OwnPawnCount += 1;
            }
            Else
            {
                If (RM.TargetPiece < GoK_OwnQueen)
                {
                    Glob.OwnNonQueenMajorMinorCount += 1;
                    If (RM.TargetPiece == GoK_OwnRook)
                    {
                        Glob.OwnRookCount += 1;
                    }
                    If (RM.TargetPiece == GoK_OwnBishop)
                    {
                        Glob.OwnBishopCount += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_OwnQueen)
                    {
                        Glob.OwnQueenCount += 1;
                    }
                    Else
                    {
                        If (RM.TargetPiece == GoK_OwnKing)
                        {
                            Glob.OwnKingIdx = RM.TargetIdx;
                        }
                    }
                }
            }
        }
        If (RM.TargetPiece < 0)
        {
            If (RM.TargetPiece == GoK_OppPawn)
            {
                Glob.OppPawnCount += 1;
            }
            Else
            {
                If (RM.TargetPiece > GoK_OppQueen)
                {
                    Glob.OppNonQueenMajorMinorCount += 1;
                    If (RM.TargetPiece == GoK_OppRook)
                    {
                        Glob.OppRookCount += 1;
                    }
                    If (RM.TargetPiece == GoK_OppBishop)
                    {
                        Glob.OppBishopCount += 1;
                    }
                }
                Else
                {
                    If (RM.TargetPiece == GoK_OppQueen)
                    {
                        Glob.OppQueenCount += 1;
                    }
                    Else
                    {
                        If (RM.TargetPiece == GoK_OppKing)
                        {
                            Glob.OppKingIdx = RM.TargetIdx;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        If (RM.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(Board, 61, GoK_OppKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_OppRook);
            Glob.OppKingIdx = 61;
        }
        Else
        {
            If (RM.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(Board, 57, GoK_OppRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_OppKing);
                Glob.OppKingIdx = 61;
            }
            Else
            {
                If (RM.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(Board, 5, GoK_OwnKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_OwnRook);
                    Glob.OwnKingIdx = 5;
                }
                Else
                {
                    If (RM.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(Board, 1, GoK_OwnRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_OwnKing);
                        Glob.OwnKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.CurrentBoardHash = (PreviousBoardHash[Ply] + 0);
    Glob.KPHash = (PreviousBoardHash2[Ply] + 0);
    Glob.NonPawnHashOwn = PreviousNonPawnHashOwn[Ply];
    Glob.NonPawnHashOpp = PreviousNonPawnHashOpp[Ply];
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
}

Define RevertMoveLight(string Ply) (warp=true)
