        List.Add(NodeTTScore, Const.Null);
        List.Add(NodeTTHit, Const.Null);
        List.Add(ReductionBase, Const.Null);
        List.Add(Improving, Const.Null);
    }
    Init.Board.PlyIdx = 1;
    Repeat ((Const.MaxPlyStackFrames + 2))
    {
        List.Add(PlyHistoryBaseIdx, ((Init.Board.PlyIdx % 2) * 4200));
        List.Add(PlyIsOwn, (Init.Board.PlyIdx % 2));
        List.Add(PlySign, (((Init.Board.PlyIdx % 2) * 2) - 1));
        List.Add(PlyContinuationBaseIdx, (((Init.Board.PlyIdx + 1) % 2) * 200000));
        List.Add(PlyCounterMoveBaseIdx, ((Init.Board.PlyIdx % 2) * 1000));
        List.Add(PlyCorrectionBaseIdx, ((Init.Board.PlyIdx % 2) * 100000));
