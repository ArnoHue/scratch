                    If (EvalP.PStruct.Opposed == 1)
                    {
                        Call TaperedEval.Add((PawnPhalanxBonusOpposed[EvalP.PStruct.RankBonusIdx] * 1))((PawnPhalanxBonusOpposed[(EvalP.PStruct.RankBonusIdx + 1)] * 1))("Eval.Pawns.Phalanx.Opposed")(EvalP.PStruct.SqIdx)(1)("");
                    }
                    Else
                    {
                        Call TaperedEval.Add((PawnPhalanxBonus[EvalP.PStruct.RankBonusIdx] * 1))((PawnPhalanxBonus[(EvalP.PStruct.RankBonusIdx + 1)] * 1))("Eval.Pawns.Phalanx.Unopposed")(EvalP.PStruct.SqIdx)(1)("");
                    }
                }
                If (EvalP.PStruct.Support > 0)
                {
                    EvalP.PStruct.Bonus = Operator.Round(((PawnConnectedBonus[EvalP.PStruct.NormRank] * ((2 + (EvalP.PStruct.Phalanx > 0)) - EvalP.PStruct.Opposed)) + (11 * EvalP.PStruct.Support)));
                    Call TaperedEval.Add((EvalP.PStruct.Bonus * 1))((Operator.Round(((EvalP.PStruct.Bonus * (EvalP.PStruct.NormRank - 3)) / 4)) * 1))("Eval.Pawns.Connected")(EvalP.PStruct.SqIdx)(1)("");
                }
            }
            Else
            {
                If (EvalP.PStruct.Neigh == 0)
                {
                    If (EvalP.PStruct.Opposed == 1)
                    {
                        Call TaperedEval.Add(-2)(-16)("Eval.Pawns.Isolated.Opposed")(EvalP.PStruct.SqIdx)(1)("");
                    }
                    Else
                    {
                        Call TaperedEval.Add(-12)(-30)("Eval.Pawns.Isolated.Unopposed")(EvalP.PStruct.SqIdx)(1)("");
                    }
                }
                Else
                {
                    If (EvalP.PStruct.Backward == 1)
                    {
                        If (EvalP.PStruct.Opposed == 1)
                        {
                            Call TaperedEval.Add(-3)(-10)("Eval.Pawns.NonIsolated.Backward.Opposed")(EvalP.PStruct.SqIdx)(1)("");
                        }
                        Else
                        {
                            If ((EvalP.PStruct.File > 1) And (EvalP.PStruct.File < 8))
                            {
                                Call TaperedEval.Add(-11)(-19)("Eval.Pawns.NonIsolated.Backward.Unopposed")(EvalP.PStruct.SqIdx)(1)("");
                            }
                            Else
                            {
                                Call TaperedEval.Add(-3)(-10)("Eval.Pawns.NonIsolated.Backward.Unopposed.Edge")(EvalP.PStruct.SqIdx)(1)("");
                            }
                        }
                    }
                }
            }
            If ((EvalP.PStruct.Backward == 0) And (EvalP.PStruct.Lever > 0))
            {
                Call TaperedEval.Add((PawnLeverBonus[EvalP.PStruct.RankBonusIdx] * 1))((PawnLeverBonus[(EvalP.PStruct.RankBonusIdx + 1)] * 1))("Eval.Pawns.Lever")(EvalP.PStruct.SqIdx)(1)("");
            }
            If (EvalP.PStruct.Support == 0)
            {
