    Glob.HasOppRookKSMoved = 0;
    Glob.HasOppRookQSMoved = 0;
    Glob.HasOwnRookKSMoved = 0;
    Glob.HasOwnRookQSMoved = 0;
    List.DeleteAll(GameMoves);
    GoK_IsGameSuspended = 0;
    Glob.PrevProgressUpdate = 0;
    GoK_Empty = 0;
    GoK_OppKing = -50000;
    GoK_OppQueen = -1269;
    GoK_OppRook = -638;
    GoK_OppBishop = -413;
    GoK_OppKnight = -391;
    GoK_OppPawn = -63;
    GoK_OwnKing = 50000;
    GoK_OwnQueen = 1269;
    GoK_OwnRook = 638;
    GoK_OwnBishop = 413;
    GoK_OwnKnight = 391;
