//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Glob.VersionString = "Game of Kings Chess Classic Version 6.9248.1995 (30.09.2026) by ArnoHu";
    Glob.IsTestRunning = 0;
    Glob.IsDCI = 0;
    Glob.Level = 4;
    GoK_Level = 4;
    If is compiled?
    {
        Glob.IsScratch3 = 0;
    }
    Else
    {
        Glob.IsScratch3 = 1;
    }
    Call OnRestart;
}


//----- Key pressed events --------------------------------------------------------------------------------------------

WhenKeyPressed(l)
{
    List.Show(Logfile);
}

WhenKeyPressed(p)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.Off)
    {
        Glob.ProfilerMode = Const.ProfilerMode.On;
        Call SayAsync("Profiling On")(2);
        Call PrepStats;
    }
    Else
    {
        Call PrintStats;
        Glob.ProfilerMode = Const.ProfilerMode.Off;
        Call SayAsync("Profiling Off")(2);
    }
}

WhenKeyPressed(d)
{
    If (Glob.DebugMode == 0)
    {
        Glob.DebugMode = 1;
        Variable.Show(Glob.IdxDeepening);
        Variable.Show(Glob.BestMoveEval);
        Variable.Show(Glob.BestMove);
        Variable.Show(Glob.NPS);
        Variable.Show(Glob.MPS);
        Variable.Show(Glob.PV);
    }
    Else
    {
        Glob.DebugMode = 0;
        Variable.Hide(Glob.IdxDeepening);
        Variable.Hide(Glob.BestMoveEval);
        Variable.Hide(Glob.BestMove);
        Variable.Hide(Glob.NPS);
        Variable.Hide(Glob.MPS);
        Variable.Hide(Glob.PV);
    }
}

WhenKeyPressed(v)
{
    Call SayAsync(Glob.VersionString)(5);
}

WhenKeyPressed(r)
{
    List.Show(Profile_Data);
}

WhenKeyPressed(t)
{
    If (Glob.TimeControl == -1)
    {
        Stop(this script);
    }
    If (Glob.TimeControl == 0)
    {
        Glob.TimeControl = 1;
        Variable.Show(Glob.CustomThinkTime);
    }
    Else
    {
        Glob.TimeControl = 0;
        Variable.Hide(Glob.CustomThinkTime);
    }
}

WhenKeyPressed(e)
{
    Call LogEval;
    List.Show(Logfile);
}

WhenKeyPressed(u)
{
    List.DeleteAll(Logfile);
    Sensing.Ask("Perft depth? (1 - 4, blank to skip)");
    TST.Ask.PerftPly = Sensing.Answer();
    Sensing.Ask("How many search tests? (1 - 218, blank to skip)");
    TST.Ask.PositionCount = Sensing.Answer();
    Sensing.Ask("Think time per test, in seconds?");
    TST.Ask.ThinkTime = Sensing.Answer();
    List.Show(Logfile);
    Call EnterExecution;
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call TestPerft(TST.Ask.PerftPly);
    Call TestSuite(TST.Ask.PositionCount)(TST.Ask.ThinkTime);
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call DrawBoardAndWait;
    Call ExitExecution;
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived($gok_classic)
{
    Glob.IsDCI = 1;
    Call ​​log​​("$gok1");
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Call IsOppKingCheckMate;
    If (Ret.IsOppKingCheckMate.IsCheckMate == 1)
    {
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: invoked on opp mate");
        Stop(this script);
    }
    Else
    {
        Call GetRepetitionCount;
        If (Ret.GetRepetitionCount.Count > 2)
        {
            List.Add(_dci, "draw?");
            Event.Broadcast("dci message");
            Call ​​warn​​("$gok: invoked on draw-by-rep");
            Stop(this script);
        }
        Else
        {
            Call IsDrawByMaterial;
            If (Ret.IsDrawByMaterial.IsDraw == 1)
            {
                List.Add(_dci, "draw?");
                Event.Broadcast("dci message");
                Call ​​warn​​("$gok: invoked on draw-by-material");
                Stop(this script);
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    List.Add(_dci, "draw?");
                    Event.Broadcast("dci message");
                    Call ​​warn​​("$gok: invoked on draw-by-stalemate");
                    Stop(this script);
                }
            }
        }
    }
    Call ​​log​​("$gok2");
    DCI.Move = Const.Null;
    Call GetOpeningMoves;
    If (List.Length(OpeningMovesRes) > 0)
    {
        DCI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
        Glob.BestMoveEval = 0;
        Glob.PV = "book";
    }
    Else
    {
        Call GetBestMoveDCI;
        DCI.Move = Ret.GetBestMoveDCI.Move;
    }
    Call ​​log​​("$gok3");
    If (DCI.Move == Const.Null)
    {
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: search system error => resigning");
        Stop(this script);
    }
    Call ​​log​​("$gok4");
    Call ClearMoveList(1);
    Call AddMoveToList(DCI.Move)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1);
    Call AddBoardToHistory(1);
    List.ReplaceItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState), CastlingState[1]);
    Call RevertMove(1);
    Call GetMoveNotation(DCI.Move);
    If (Ret.GetMoveNotation.Notation == "O-O")
    {
        If (Glob.IsPlayerBlack == 0)
        {
            List.Add(_dci, "me8g8");
        }
        Else
        {
            List.Add(_dci, "me1g1");
        }
    }
    Else
    {
        If (Ret.GetMoveNotation.Notation == "O-O-O")
        {
            If (Glob.IsPlayerBlack == 0)
            {
                List.Add(_dci, "me8c8");
            }
            Else
            {
                List.Add(_dci, "me1c1");
            }
        }
        Else
        {
            List.Add(_dci, Operator.Join("m", Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join((9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove % 100))]), (9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove % 100))]))))));
        }
    }
    Call ​​log​​("$gok5");
    _dci pv = Glob.PV;
    If (Glob.PV == "book")
    {
        _dci search depth = "";
    }
    Else
    {
        _dci search depth = (Glob.IdxDeepening - Glob.IsSearchTimeout);
    }
    If (Not ((Glob.BestMoveEval == Const.Null)))
    {
        DCI.WhiteEval = (Glob.BestMoveEval * _dci turn);
        If (abs(Glob.BestMoveEval) > Const.AbsMinCheckmateEval)
        {
            _dci evaluation = Operator.Join("M", ceiling((((100000 - abs(Glob.BestMoveEval)) - List.Length(BoardHistoryFiftyMoves)) / 2)));
            If (DCI.WhiteEval < 0)
            {
                _dci evaluation = Operator.Join("-", _dci evaluation);
            }
        }
        Else
        {
            _dci evaluation = (DCI.WhiteEval / 100);
        }
    }
    Event.BroadcastAndWait("gui refresh stats");
    Event.Broadcast("dci message");
    Call ​​log​​("$gok6");
}

WhenBroadcastReceived($gok_classic draw?)
{
    Glob.IsDCI = 1;
    Call $gok_prepare;
    Glob.BestMoveEval = 0;
    Call GetBestMoveDCI;
    If (Glob.BestMoveEval == Const.Null)
    {
        List.Add(_dci, "decline");
    }
    Else
    {
        If (Glob.BestMoveEval < 0)
        {
            List.Add(_dci, "accept");
        }
        Else
        {
            List.Add(_dci, "decline");
        }
    }
    Event.Broadcast("dci message");
}

WhenBroadcastReceived($gok_classic stop)
{
    Glob.IsDCI = 1;
    Glob.IsSearchTimeout = 1;
}

WhenBroadcastReceived(advisor)
{
    If (Glob.IsExecutionRunning == 0)
    {
        If (Glob.IsAdvisorEnabled == 1)
        {
            Glob.IsAdvisorEnabled = 0;
            Call DrawBoardAndWait;
        }
        Else
        {
            Glob.IsAdvisorEnabled = 1;
            If (Not ((Stg_FromSquareIdx == -1)))
            {
                Event.BroadcastAndWait("fromsquareselected");
            }
        }
    }
}

WhenBroadcastReceived(dci new game)
{
    GoK_IsGameSuspended = 0;
    List.DeleteAll(BoardHistory);
    List.DeleteAll(BoardHistoryFiftyMoves);
    List.DeleteAll(BoardHistoryHash);
    List.DeleteAll(BoardHistoryMetaState);
    List.DeleteAll(BoardHistoryWasEngineMove);
    List.DeleteAll(GameMovesAN);
    List.DeleteAll(GameMoves);
    Glob.IsPlayerBlack = Const.Null;
}

WhenBroadcastReceived(dci register)
{
    List.Add(_dci engines, "gok_classic");
}

WhenBroadcastReceived(export)
{
    If (Glob.IsExecutionRunning == 0)
    {
        Call ExportBoardFEN((1 == 1));
        Exp.FENLichess = Ret.ExportBoardFEN.FENLichess;
        Exp.FEN = Ret.ExportBoardFEN.FEN;
        List.DeleteItem(ExportData, all);
        List.Add(ExportData, "DATA EXPORT");
        List.Add(ExportData, "Select data row by triple-clicking. You can then copy to");
        List.Add(ExportData, "clipboard by right-click / Copy or by pressing Ctrl-C.");
        List.Add(ExportData, "");
        List.Add(ExportData, "PGN (Game Protocol):");
        Call ExportMovesPGN;
        List.Add(ExportData, Ret.ExportMovesPGN.PGN);
        List.Add(ExportData, "");
        List.Add(ExportData, "FEN (Current Board):");
        List.Add(ExportData, Exp.FEN);
        List.Add(ExportData, "");
        List.Add(ExportData, "Board Analysis Link (lichess.org)");
        List.Add(ExportData, Exp.FENLichess);
        List.Show(ExportData);
        If (1 == 0)
        {
            Call SayAsync("You can copy FEN data, lichess.org URL or PGN data to your clipboard via Ctrl-C. Select data by triple-click.")(5);
        }
    }
}

WhenBroadcastReceived(fromsquareselected)
{
    If ((Glob.IsAdvisorEnabled == 1) And (Not ((Stg_FromSquareIdx == -1))))
    {
        Stg_BestMoveFromIdx = Stg_FromSquareIdx;
        List.DeleteAll(Selection_UserMoveTargets);
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            Call GetCurrentMove(2);
            FSS.Move = Ret.GetCurrentMove.Move;
            If (floor((FSS.Move / 100)) == GoK_ScreenIdx[Stg_FromSquareIdx])
            {
                Call ApplyMove(2);
                Call CalcBoardAttackedByMove(3);
                Call RevertMove(2);
                If (Glob.IsOppSideChecked == 0)
                {
                    List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[floor((FSS.Move % 100))]);
                }
            }
            Else
            {
                If (Board[GoK_ScreenIdx[Stg_FromSquareIdx]] == GoK_OppKing)
                {
                    If (FSS.Move == GoK_OppKingsideCastling)
                    {
                        List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[63]);
                    }
                    Else
                    {
                        If (FSS.Move == GoK_OppQueensideCastling)
                        {
                            List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[59]);
                        }
                    }
                }
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
        Call DrawBoardAndWait;
        Event.BroadcastAndWait("StampUserMoveTargets");
    }
}

WhenBroadcastReceived(import)
{
    If (Glob.IsExecutionRunning == 0)
    {
        Sensing.Ask("Board data import. Please paste FEN data from your clipboard into the text field by pressing Ctrl-V.");
        If (Variable.Length(Sensing.Answer()) > 0)
        {
            Call ImportBoard(Sensing.Answer());
        }
    }
}

WhenBroadcastReceived(levelchanged)
{
    Glob.Level = GoK_Level;
    Call DrawBoardAndWait;
}

WhenBroadcastReceived(sayasyncmsg)
{
    Looks.Say(Glob.SayAsyncText, Glob.SayAsyncDuration);
}

WhenBroadcastReceived(showmoves)
{
    Call ExportMovesPGN;
    List.DeleteItem(ExportMoves, all);
    List.Add(ExportMoves, Ret.ExportMovesPGN.PGN);
    List.Show(ExportMoves);
    Call SayAsync("You can copy PGN data to your clipboard via Ctrl-C")(5);
}

WhenBroadcastReceived(squareclicked)
{
    If ((Glob.IsExecutionRunning == 0) And (GoK_IsGameSuspended == 0))
    {
        Call EnterExecution;
        If (Board[GoK_ScreenIdx[Stg_SquareClickedIdx]] < 0)
        {
            Glob.MoveFromIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
            Stg_FromSquareIdx = Stg_SquareClickedIdx;
            Event.BroadcastAndWait("fromsquareselected");
        }
        Else
        {
            If ((Not ((Glob.MoveFromIdx == -1))) And (Not ((Stg_FromSquareIdx == -1))))
            {
                Glob.MoveToIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
                Stg_ToSquareIdx = Stg_SquareClickedIdx;
                Event.BroadcastAndWait("tosquareselected");
                If ((Board[Glob.MoveFromIdx] < 0) And (Not ((Glob.MoveFromIdx == Glob.MoveToIdx))))
                {
                    Glob.UserMove = "";
                    If ((Board[Glob.MoveFromIdx] == GoK_OppKing) And (Glob.MoveFromIdx == 61))
                    {
                        If ((Glob.MoveToIdx == 59) And (Board[57] == GoK_OppRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_OppQueensideCastling)
                            {
                                Glob.UserMove = GoK_OppQueensideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(61, 59);
                            }
                        }
                        If ((Glob.MoveToIdx == 63) And (Board[64] == GoK_OppRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_OppKingsideCastling)
                            {
                                Glob.UserMove = GoK_OppKingsideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(61, 63);
                            }
                        }
                    }
                    If (Glob.UserMove == "")
                    {
                        Glob.UserMove = ((Glob.MoveFromIdx * 100) + Glob.MoveToIdx);
                        If ((Board[Glob.MoveFromIdx] == GoK_OppPawn) And (Glob.MoveToIdx < 9))
                        {
                            Glob.UserMove = (Glob.UserMove + 0.1);
                        }
                    }
                }
                Call ExecuteUserMove(Glob.UserMove);
            }
        }
        Call ExitExecution;
    }
}

WhenBroadcastReceived(stageclicked)
{
    List.Hide(ExportData);
    List.Hide(ExportMoves);
    List.Hide(Logfile);
    List.Hide(Profile_Data);
    If (Glob.IsExecutionRunning == 0)
    {
        Looks.Say("");
    }
}

WhenBroadcastReceived(startgame)
{
    Motion.GoToXY(240, 80);
    Glob.ExecutionPly = 0;
    Glob.IsExecutionRunning = 0;
    Glob.IsPlayerBlack = GoK_IsPlayerBlack;
    Call EnterExecution;
    Call InitBoard;
    Call DrawBoardAndWait;
    Looks.Say("Initializing engine, please wait...");
    Control.Wait(0.1);
    Call InitBoardPhase2;
    Call ExitExecution;
    Call ExecuteInit;
    Looks.Say("");
    Looks.Show();
}

WhenBroadcastReceived(triggerrestart)
{
    Call OnRestart;
}

WhenBroadcastReceived(undo)
{
    If (Glob.IsExecutionRunning == 0)
    {
        Call UndoMove;
        Call OnEvaluationChanged(0);
        Looks.Say("");
    }
}


//----- Custom blocks -------------------------------------------------------------------------------------------------

Define $gok_prepare (warp=true)
{
    $gok_prepare.TargetIsPlayerBlack = 0;
    If Operator.Contains(_dci fen, " w")
    {
        $gok_prepare.TargetIsPlayerBlack = 1;
    }
    If (Not (($gok_prepare.TargetIsPlayerBlack == Glob.IsPlayerBlack)))
    {
        Glob.IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        GoK_IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        Glob.ExecutionPly = 0;
        Glob.IsExecutionRunning = 0;
        Glob.Level = 5;
        GoK_Level = 5;
        Call EnterExecution;
        Call InitBoard;
        Call InitBoardPhase2;
        Call ExitExecution;
        Call ​​warn​​("$gok_reinit");
    }
    Call ImportBoardFEN(_dci fen);
    $gok_prepare.CanOwnCastleKingside = 0;
    $gok_prepare.CanOwnCastleQueenside = 0;
    $gok_prepare.CanOppCastleKingside = 0;
    $gok_prepare.CanOppCastleQueenside = 0;
    $gok_prepare.CastlingCharIdx = 1;
    Repeat Until ((Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == " ") Or ($gok_prepare.CastlingCharIdx > Variable.Length(_dci fen)))
    {
        $gok_prepare.CastlingCharIdx += 1;
    }
    $gok_prepare.CastlingCharIdx += 3;
    Repeat Until (($gok_prepare.CastlingCharIdx > Variable.Length(_dci fen)) Or (Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == " "))
    {
        If (Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == "K")
        {
            Call IsLowerCase(Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx));
            If (Ret.IsLowerCase.IsLower == 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOwnCastleKingside = 1;
                }
                Else
                {
                    $gok_prepare.CanOppCastleKingside = 1;
                }
            }
            Else
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOppCastleKingside = 1;
                }
                Else
                {
                    $gok_prepare.CanOwnCastleKingside = 1;
                }
            }
        }
        If (Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx) == "Q")
        {
            Call IsLowerCase(Operator.LetterOf(_dci fen, $gok_prepare.CastlingCharIdx));
            If (Ret.IsLowerCase.IsLower == 0)
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOwnCastleQueenside = 1;
                }
                Else
                {
                    $gok_prepare.CanOppCastleQueenside = 1;
                }
            }
            Else
            {
                If (Glob.IsPlayerBlack == 1)
                {
                    $gok_prepare.CanOppCastleQueenside = 1;
                }
                Else
                {
                    $gok_prepare.CanOwnCastleQueenside = 1;
                }
            }
        }
        $gok_prepare.CastlingCharIdx += 1;
    }
    List.ReplaceItem(EnPassantTarget, 1, Const.Null);
    If ($gok_prepare.CastlingCharIdx < Variable.Length(_dci fen))
    {
        $gok_prepare.EnPassantCharIdx = ($gok_prepare.CastlingCharIdx + 1);
        If ((Not ((Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "-"))) And (Not ((Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == ""))))
        {
            $gok_prepare.EnPassantFile = 0;
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "a")
            {
                $gok_prepare.EnPassantFile = 1;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "b")
            {
                $gok_prepare.EnPassantFile = 2;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "c")
            {
                $gok_prepare.EnPassantFile = 3;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "d")
            {
                $gok_prepare.EnPassantFile = 4;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "e")
            {
                $gok_prepare.EnPassantFile = 5;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "f")
            {
                $gok_prepare.EnPassantFile = 6;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "g")
            {
                $gok_prepare.EnPassantFile = 7;
            }
            If (Operator.LetterOf(_dci fen, $gok_prepare.EnPassantCharIdx) == "h")
            {
                $gok_prepare.EnPassantFile = 8;
            }
            If ($gok_prepare.EnPassantFile > 0)
            {
                List.ReplaceItem(EnPassantTarget, 1, (32 + $gok_prepare.EnPassantFile));
            }
        }
    }
    List.DeleteAll(GameMoves);
    If (Not ((EnPassantTarget[1] == Const.Null)))
    {
        $gok_prepare.SynthTargetIdx = EnPassantTarget[1];
        If (Board[$gok_prepare.SynthTargetIdx] > 0)
        {
            $gok_prepare.SynthSourceIdx = ($gok_prepare.SynthTargetIdx - 16);
        }
        Else
        {
            $gok_prepare.SynthSourceIdx = ($gok_prepare.SynthTargetIdx + 16);
        }
        List.DeleteAll(GameMoves);
        List.Add(GameMoves, (($gok_prepare.SynthSourceIdx * 100) + $gok_prepare.SynthTargetIdx));
    }
    $gok_prepare.FullMoveCharIdx = 0;
    $gok_prepare.FullMoveToken = 0;
    $gok_prepare.FullMoveText = "";
    Repeat (Variable.Length(_dci fen))
    {
        $gok_prepare.FullMoveCharIdx += 1;
        $gok_prepare.FullMoveChar = Operator.LetterOf(_dci fen, $gok_prepare.FullMoveCharIdx);
        If ($gok_prepare.FullMoveChar == " ")
        {
            $gok_prepare.FullMoveToken += 1;
        }
        Else
        {
            If ($gok_prepare.FullMoveToken == 4)
            {
                $gok_prepare.FullMoveText = Operator.Join($gok_prepare.FullMoveText, $gok_prepare.FullMoveChar);
            }
        }
    }
    List.DeleteAll(BoardHistoryFiftyMoves);
    $gok_prepare.FullMoveCount = 0;
    Repeat ($gok_prepare.FullMoveText)
    {
        $gok_prepare.FullMoveCount += 1;
        List.Add(BoardHistoryFiftyMoves, $gok_prepare.FullMoveCount);
    }
    Glob.HasOwnRookQSMoved = 0;
    Glob.HasOwnKingMoved = 0;
    Glob.HasOwnCastled = 0;
    Glob.HasOwnRookKSMoved = 0;
    Glob.HasOppRookQSMoved = 0;
    Glob.HasOppKingMoved = 0;
    Glob.HasOppCastled = 0;
    Glob.HasOppRookKSMoved = 0;
    If (Not (($gok_prepare.CanOwnCastleQueenside == 1)))
    {
        Glob.HasOwnRookQSMoved = 1;
    }
    If (Not ((($gok_prepare.CanOwnCastleQueenside == 1) Or ($gok_prepare.CanOwnCastleKingside == 1))))
    {
        Glob.HasOwnKingMoved = 1;
        Glob.HasOwnCastled = 1;
    }
    If (Not (($gok_prepare.CanOwnCastleKingside == 1)))
    {
        Glob.HasOwnRookKSMoved = 1;
    }
    If (Not (($gok_prepare.CanOppCastleQueenside == 1)))
    {
        Glob.HasOppRookQSMoved = 1;
    }
    If (Not ((($gok_prepare.CanOppCastleQueenside == 1) Or ($gok_prepare.CanOppCastleKingside == 1))))
    {
        Glob.HasOppKingMoved = 1;
        Glob.HasOppCastled = 1;
    }
    If (Not (($gok_prepare.CanOppCastleKingside == 1)))
    {
        Glob.HasOppRookKSMoved = 1;
    }
    Call CalcBoardStats;
    If (_dci think time == "Infinity")
    {
        Glob.CustomThinkTime = 100000;
        Glob.CustomMaxDepth = _dci max depth;
    }
    Else
    {
        If (_dci think time > 0)
        {
            Glob.CustomThinkTime = _dci think time;
        }
        Else
        {
            Glob.CustomThinkTime = 1;
        }
        Glob.CustomMaxDepth = 0;
    }
    List.DeleteAll(GameMoves);
    If ((Not ((EnPassantTarget[1] == Const.Null))) And (EnPassantTarget[1] > 0))
    {
        If (Board[EnPassantTarget[1]] > 0)
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] - 16) * 100) + EnPassantTarget[1]));
        }
        Else
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] + 16) * 100) + EnPassantTarget[1]));
        }
    }
}

Define //(string Comment) (warp=true)
{
}

Define AddBoardToHistory(string WasEngineMove) (warp=true)
{
    Call GetBoardString;
    List.Add(BoardHistory, Ret.GetBoardString.BoardString);
    Call CreateCurrentBoardHash;
    List.Add(BoardHistoryHash, Glob.CurrentBoardHash);
    List.Add(BoardHistoryMetaState, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    List.Add(BoardHistoryWasEngineMove, WasEngineMove);
}

Define AddLookupMove(string SourceIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool LookupMoveTypeKing) (warp=true)
{
    AddMove.KingKnight.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddMove.KingKnight.Idx = (MoveLookupIndexOffset[(SourceIdx + 0)] + 0);
    AddMove.KingKnight.Count = 1;
    Repeat (8)
    {
        If LookupMoveTypeKing
        {
            AddMove.KingKnight.TargetIdx = (MoveLookupKing[(AddMove.KingKnight.Idx + AddMove.KingKnight.Count)] + 0);
        }
        Else
        {
            AddMove.KingKnight.TargetIdx = (MoveLookupKnight[(AddMove.KingKnight.Idx + AddMove.KingKnight.Count)] + 0);
        }
        If (AddMove.KingKnight.TargetIdx == -1)
        {
            Stop(this script);
        }
        If CalcAttackState
        {
            Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
        }
        Else
        {
            If (Board[(AddMove.KingKnight.TargetIdx + 0)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)(AddMove.KingKnight.TargetIdx)(AddMove.KingKnight.SourcePiece)(Ply);
                }
                Else
                {
                    Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                }
            }
            Else
            {
                If (AddMove.KingKnight.SourcePiece > 0)
                {
                    If (Board[(AddMove.KingKnight.TargetIdx + 0)] < 0)
                    {
                        Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                    }
                }
                Else
                {
                    If (Board[(AddMove.KingKnight.TargetIdx + 0)] > 0)
                    {
                        Call AddMoveImplLookup(SourceIdx)(AddMove.KingKnight.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing);
                    }
                }
            }
        }
        AddMove.KingKnight.Count += 1;
    }
}

Define AddMoveImpl(string SourceIdx)(string TargetIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly) (warp=true)
{
    If CalcAttackState
    {
        AddMove.Impl.PinAllowed = 1;
        If ((Not ((PinnedSquareDirection[SourceIdx] == 0))) And (Not ((abs(Board[SourceIdx]) == GoK_OwnPawn))))
        {
            AddMove.Impl.PinAllowed = 0;
            If (((IdxToFile[TargetIdx] - IdxToFile[SourceIdx]) * RayRankDelta[PinnedSquareDirection[SourceIdx]]) == ((IdxToRank[TargetIdx] - IdxToRank[SourceIdx]) * RayFileDelta[PinnedSquareDirection[SourceIdx]]))
            {
                AddMove.Impl.PinAllowed = 1;
            }
        }
        If (AddMove.Impl.PinAllowed == 1)
        {
            AddMove.Impl.SourcePiece = (Board[(SourceIdx + 0)] + 0);
            AddMove.Impl.TargetPiece = (Board[(TargetIdx + 0)] + 0);
            AddMove.Impl.KingPathClear = 1;
            If (abs(AddMove.Impl.TargetPiece) == GoK_OwnKing)
            {
                AddMove.Impl.FileDelta = (IdxToFile[TargetIdx] - IdxToFile[SourceIdx]);
                AddMove.Impl.RankDelta = (IdxToRank[TargetIdx] - IdxToRank[SourceIdx]);
                If (((AddMove.Impl.FileDelta == 0) Or (AddMove.Impl.RankDelta == 0)) Or (abs(AddMove.Impl.FileDelta) == abs(AddMove.Impl.RankDelta)))
                {
                    AddMove.Impl.PathStep = (((AddMove.Impl.FileDelta > 0) - (AddMove.Impl.FileDelta < 0)) + (8 * ((AddMove.Impl.RankDelta > 0) - (AddMove.Impl.RankDelta < 0))));
                    AddMove.Impl.PathIdx = ((SourceIdx + 0) + AddMove.Impl.PathStep);
                    Repeat (((((abs(AddMove.Impl.FileDelta) + abs(AddMove.Impl.RankDelta)) + abs((abs(AddMove.Impl.FileDelta) - abs(AddMove.Impl.RankDelta)))) / 2) - 1))
                    {
                        If (Not ((Board[AddMove.Impl.PathIdx] == 0)))
                        {
                            AddMove.Impl.KingPathClear = 0;
                        }
                        AddMove.Impl.PathIdx += AddMove.Impl.PathStep;
                    }
                }
            }
            If (Glob.CalcAttackStateWithMobility == 1)
            {
                AddMove.Impl.PieceMobilityPrepIdx = (((SourceIdx - 1) * 32) + 1);
                AddMove.Impl.Count = (PieceMobilityPrep[AddMove.Impl.PieceMobilityPrepIdx] + 1);
                List.ReplaceItem(PieceMobilityPrep, AddMove.Impl.PieceMobilityPrepIdx, AddMove.Impl.Count);
                List.ReplaceItem(PieceMobilityPrep, (AddMove.Impl.PieceMobilityPrepIdx + AddMove.Impl.Count), TargetIdx);
            }
            AddMove.Impl.AttackMask = 0;
            AddMove.Impl.PieceAbs = abs(AddMove.Impl.SourcePiece);
            AddMove.Impl.PieceIdx = (PieceIdxLookup[AddMove.Impl.PieceAbs] + 0);
            If ((AddMove.Impl.PieceAbs > 0) And (AddMove.Impl.PieceAbs < GoK_OwnKing))
            {
                AddMove.Impl.AttackMask = (AttackTypeMaskWeights[AddMove.Impl.PieceIdx] + 0);
            }
            If (AddMove.Impl.SourcePiece > 0)
            {
                AddMove.Impl.Attacked = (BoardAttacked[(TargetIdx + 0)] + 0);
                If ((AddMove.Impl.Attacked == 0) Or (Board[BoardAttackedPiece[(TargetIdx + 0)]] > AddMove.Impl.SourcePiece))
                {
                    List.ReplaceItem(BoardAttackedPiece, (TargetIdx + 0), SourceIdx);
                }
                If (BoardAttackerType[(((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx)] == 0)
                {
                    List.ReplaceItem(BoardAttackerType, (((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx), SourceIdx);
                }
                Else
                {
                    If (BoardAttackerType2[(((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx)] == 0)
                    {
                        List.ReplaceItem(BoardAttackerType2, (((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx), SourceIdx);
                    }
                }
                If (AddMove.Impl.Attacked < 9)
                {
                    List.ReplaceItem(BoardAttacked, (TargetIdx + 0), (AddMove.Impl.Attacked + 1));
                }
                If (AddMove.Impl.AttackMask > 0)
                {
                    List.ReplaceItem(BoardAttackedTypeMask, (TargetIdx + 0), (BoardAttackedTypeMask[(TargetIdx + 0)] + AddMove.Impl.AttackMask));
                }
                If ((AddMove.Impl.TargetPiece == GoK_OppKing) And (AddMove.Impl.KingPathClear == 1))
                {
                    Glob.IsOppSideChecked = 1;
                }
            }
            Else
            {
                If (AddMove.Impl.SourcePiece < 0)
                {
                    AddMove.Impl.Attacked = (BoardAttacked[(TargetIdx + 64)] + 0);
                    If ((AddMove.Impl.Attacked == 0) Or (Board[BoardAttackedPiece[(TargetIdx + 64)]] < AddMove.Impl.SourcePiece))
                    {
                        List.ReplaceItem(BoardAttackedPiece, (TargetIdx + 64), SourceIdx);
                    }
                    If (BoardAttackerType[((((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx) + 384)] == 0)
                    {
                        List.ReplaceItem(BoardAttackerType, ((((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx) + 384), SourceIdx);
                    }
                    Else
                    {
                        If (BoardAttackerType2[((((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx) + 384)] == 0)
                        {
                            List.ReplaceItem(BoardAttackerType2, ((((AddMove.Impl.PieceIdx - 1) * 64) + TargetIdx) + 384), SourceIdx);
                        }
                    }
                    If (AddMove.Impl.Attacked < 9)
                    {
                        List.ReplaceItem(BoardAttacked, (TargetIdx + 64), (AddMove.Impl.Attacked + 1));
                    }
                    If (AddMove.Impl.AttackMask > 0)
                    {
                        List.ReplaceItem(BoardAttackedTypeMask, (TargetIdx + 64), (BoardAttackedTypeMask[(TargetIdx + 64)] + AddMove.Impl.AttackMask));
                    }
                    If ((AddMove.Impl.TargetPiece == GoK_OwnKing) And (AddMove.Impl.KingPathClear == 1))
                    {
                        Glob.IsOwnSideChecked = 1;
                    }
                }
            }
        }
        Stop(this script);
    }
    If (CheckedState[Ply] == 1)
    {
        If (Not ((BoardAttackedEvasionTarget[(TargetIdx + 0)] == 1)))
        {
            If (Not ((abs(Board[(SourceIdx + 0)]) == GoK_OwnKing)))
            {
                If (EnPassantTarget[Ply] == Const.Null)
                {
                    Stop(this script);
                }
            }
        }
    }
    AddMove.Impl.Move = ((SourceIdx * 100) + TargetIdx);
    If (abs(Board[(SourceIdx + 0)]) == GoK_OwnPawn)
    {
        If (((IdxToRank[(TargetIdx + 0)] + 0) == 1) Or ((IdxToRank[(TargetIdx + 0)] + 0) == 8))
        {
            Call AddSpecialMove((AddMove.Impl.Move + 0.1))(Ply);
            If (Not (CapturesOnly))
            {
                Call AddSpecialMove((AddMove.Impl.Move + 0.2))(Ply);
                Call AddSpecialMove((AddMove.Impl.Move + 0.3))(Ply);
                Call AddSpecialMove((AddMove.Impl.Move + 0.4))(Ply);
            }
            Stop(this script);
        }
    }
    List.Add(CalcMovesMoveList, AddMove.Impl.Move);
    Call GetMoveScore(Board[(SourceIdx + 0)])(Board[(TargetIdx + 0)])(SourceIdx)(TargetIdx)(AddMove.Impl.Move)(Ply);
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddMoveImplLookup(string SourceIdx)(string TargetIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool IsKing) (warp=true)
{
    If IsKing
    {
        If (Not (CalcAttackState))
        {
            If ((BoardAttackedCalculated[Ply] == 1) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + TargetIdx)] > 0))
            {
                Stop(this script);
            }
            If (PlyIsOwn[Ply] == 1)
            {
                AddMove.ImplLookup.KingIdx = Glob.OppKingIdx;
            }
            Else
            {
                AddMove.ImplLookup.KingIdx = Glob.OwnKingIdx;
            }
            If (ChebyshevDistance[((AddMove.ImplLookup.KingIdx * 100) + TargetIdx)] < 2)
            {
                Stop(this script);
            }
        }
    }
    Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)(CalcAttackState)(CapturesOnly);
}

Define AddMoveToList(string Move)(string Ply)(string MoveScore) (warp=true)
{
    List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), Move);
    List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), MoveScore);
    List.ReplaceItem(MovesCount, Ply, (MovesCount[Ply] + 1));
    If (Ply == 1)
    {
        List.Add(Moves1, Move);
    }
    Else
    {
        If (Ply == 2)
        {
            List.Add(Moves2, Move);
        }
    }
}

Define AddPotentialQuiescenceMove(string SourceIdx)(string TargetIdx)(string Piece)(string Ply) (warp=true)
{
    Call //("Include move in quiescence search if it's a check or check evasion");
    If (CheckedState[Ply] == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        Stop(this script);
    }
    If (Piece == GoK_OwnPawn)
    {
        If (IdxToRank[TargetIdx] == 8)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
            Stop(this script);
        }
    }
    If (Piece == GoK_OppPawn)
    {
        If (IdxToRank[TargetIdx] == 1)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
            Stop(this script);
        }
    }
    If (Glob.IsPotentialNonCapQuiescMove == 0)
    {
        Stop(this script);
    }
    AddMove.PotQ.IsDiscovery = 0;
    AddMove.PotQ.DiscoveryIdx = 1;
    Repeat (DiscoveryCount[Ply])
    {
        If ((DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + AddMove.PotQ.DiscoveryIdx)] == SourceIdx) And (Not ((abs(MovePathStepInc[((SourceIdx * 100) + TargetIdx)]) == DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + AddMove.PotQ.DiscoveryIdx)]))))
        {
            AddMove.PotQ.IsDiscovery = 1;
        }
        AddMove.PotQ.DiscoveryIdx += 1;
    }
    If (AddMove.PotQ.IsDiscovery == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
        Stop(this script);
    }
    If (abs(Piece) == GoK_OwnKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.OppKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.OwnKingIdx);
    }
    If (Ret.IsReachableForAttack.IsReachable == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1));
    }
}

Define AddSlidingMove(string SourceIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool SlidingMoveTypeStraight) (warp=true)
{
    If CalcAttackState
    {
        Call ASMAttack(SourceIdx)(Ply)(SlidingMoveTypeStraight);
    }
    Else
    {
        Call ASM(SourceIdx)(Ply)(CapturesOnly)(SlidingMoveTypeStraight);
    }
}

Define AddSpecialMove(string Move)(string Ply) (warp=true)
{
    List.Add(CalcMovesMoveList, Move);
    AddMove.Special.SourcePiece = Const.Null;
    If (Not ((Move == floor(Move))))
    {
        AddMove.Special.SourcePiece = GoK_OwnPawn;
    }
    If (floor((Move / 100)) == 0)
    {
        AddMove.Special.SourcePiece = GoK_OwnKing;
    }
    AddMove.Special.CastleFrom = floor((Move / 100));
    AddMove.Special.CastleTo = floor((Move % 100));
    If (floor((Move / 100)) == 0)
    {
        If ((Move == 65) Or (Move == 66))
        {
            AddMove.Special.CastleFrom = 5;
        }
        Else
        {
            AddMove.Special.CastleFrom = 61;
        }
        If (Move == 65)
        {
            AddMove.Special.CastleTo = 8;
        }
        Else
        {
            If (Move == 66)
            {
                AddMove.Special.CastleTo = 1;
            }
            Else
            {
                If (Move == 67)
                {
                    AddMove.Special.CastleTo = 64;
                }
                Else
                {
                    AddMove.Special.CastleTo = 57;
                }
            }
        }
    }
    If (PlyIsOwn[Ply] == 1)
    {
        Call GetMoveScore(AddMove.Special.SourcePiece)(0)(AddMove.Special.CastleFrom)(AddMove.Special.CastleTo)(Move)(Ply);
    }
    Else
    {
        Call GetMoveScore((0 - AddMove.Special.SourcePiece))(0)(AddMove.Special.CastleFrom)(AddMove.Special.CastleTo)(Move)(Ply);
    }
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddTestCase(string FEN)(string AN1)(string AN2)(string AN3)(string AN4)(string AN5) (warp=true)
{
    List.Add(TestSuiteFEN, FEN);
    List.Add(TestSuiteAN, AN1);
    List.Add(TestSuiteAN, AN2);
    List.Add(TestSuiteAN, AN3);
    List.Add(TestSuiteAN, AN4);
    List.Add(TestSuiteAN, AN5);
}

Define AddToFiftyMoves(bool IsCaptureOrPawnMove) (warp=true)
{
    If IsCaptureOrPawnMove
    {
        List.Add(BoardHistoryFiftyMoves, 0);
    }
    Else
    {
        If (List.Length(BoardHistoryFiftyMoves) == 0)
        {
            List.Add(BoardHistoryFiftyMoves, 0);
        }
        List.Add(BoardHistoryFiftyMoves, (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] + 1));
    }
}

Define AdjustEvalScore(string Ply)(string RawEval) (warp=true)
{
    If (RawEval == Const.Null)
    {
        List.ReplaceItem(StaticEval, Ply, Const.Null);
    }
    Else
    {
        AES.Damped = ((RawEval * (195 - BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)])) / 211);
        List.ReplaceItem(StaticEval, Ply, ((((AES.Damped > 0) - (AES.Damped < 0)) * floor(abs(AES.Damped))) * PlySign[Ply]));
        Call GetCorrHistIndices(Ply);
        AES.CorrSum = 0;
        If (CorrHistKey[Ret.GetCorrHistIndices.CorrIdx] == Ret.GetCorrHistIndices.PawnKey)
        {
            AES.CorrSum += (53 * CorrHistVal[Ret.GetCorrHistIndices.CorrIdx]);
        }
        If (CorrHistNonPawnOwnKey[Ret.GetCorrHistIndices.NonPawnOwnIdx] == Ret.GetCorrHistIndices.NonPawnOwnKey)
        {
            AES.CorrSum += (65 * CorrHistNonPawnOwn[Ret.GetCorrHistIndices.NonPawnOwnIdx]);
        }
        If (CorrHistNonPawnOppKey[Ret.GetCorrHistIndices.NonPawnOppIdx] == Ret.GetCorrHistIndices.NonPawnOppKey)
        {
            AES.CorrSum += (65 * CorrHistNonPawnOpp[Ret.GetCorrHistIndices.NonPawnOppIdx]);
        }
        If (Not ((Ret.GetCorrHistIndices.ContIdx2 == Const.Null)))
        {
            AES.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx2]);
        }
        If (Not ((Ret.GetCorrHistIndices.ContIdx4 == Const.Null)))
        {
            AES.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx4]);
        }
        List.ReplaceItem(StaticEval, Ply, (StaticEval[Ply] + Operator.Round((AES.CorrSum / 512))));
    }
}

Define ApplyMove(num Ply) (warp=true)
{
    Call TaperedEval.Init;
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    If (Ply == 1)
    {
        Glob.RootEnPassantTarget = EnPassantTarget[1];
    }
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(PutsInCheck, Ply, 0);
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.CurrentBoardHash);
    List.ReplaceItem(PreviousBoardHash2, Ply, Glob.KPHash);
    List.ReplaceItem(PreviousNonPawnHashOwn, Ply, Glob.NonPawnHashOwn);
    List.ReplaceItem(PreviousNonPawnHashOpp, Ply, Glob.NonPawnHashOpp);
    Call GetCurrentMove(Ply);
    AM.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, AM.Move);
    Call AddToFiftyMoves((((Not ((AM.Move == 0))) And (Not ((floor((AM.Move / 100)) == 0)))) And ((abs(Board[floor((AM.Move / 100))]) == GoK_OwnPawn) Or (Not ((Board[floor((AM.Move % 100))] == 0))))));
    AM.SourceIdx = floor((AM.Move / 100));
    If (AM.SourceIdx > 0)
    {
        AM.TargetIdx = floor((AM.Move % 100));
        AM.SourcePiece = (Board[(AM.SourceIdx + 0)] + 0);
        AM.TargetPiece = (Board[(AM.TargetIdx + 0)] + 0);
        List.ReplaceItem(SourcePieces, Ply, AM.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, AM.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, AM.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, (AM.TargetIdx + 0), AM.SourcePiece);
        List.ReplaceItem(Board, (AM.SourceIdx + 0), 0);
        AM.Factor = (((AM.SourcePiece > 0) * 2) - 1);
        AM.MoveKey = (((PieceIdxLookup[abs(AM.SourcePiece)] * 10000) + ((AM.SourceIdx * 100) + AM.TargetIdx)) + ((AM.SourcePiece > 0) * 60000));
        Glob.CurrentBoardHash += MoveHashLookup[AM.MoveKey];
        If (Not ((abs(AM.SourcePiece) == GoK_OwnPawn)))
        {
            If (AM.SourcePiece > 0)
            {
                Glob.NonPawnHashOwn += MoveHashLookup[AM.MoveKey];
            }
            Else
            {
                Glob.NonPawnHashOpp += MoveHashLookup[AM.MoveKey];
            }
        }
        If (abs(AM.SourcePiece) == GoK_OwnPawn)
        {
            Glob.KPHash += MoveHashLookup[AM.MoveKey];
            If (Not ((IdxToFile[(AM.SourceIdx + 0)] == IdxToFile[(AM.TargetIdx + 0)])))
            {
                If (TargetPieces[Ply] == 0)
                {
                    AM.SqIdx = (AM.TargetIdx - (8 * AM.Factor));
                    List.ReplaceItem(TargetPiecesIdx, Ply, AM.SqIdx);
                    List.ReplaceItem(TargetPieces, Ply, Board[AM.SqIdx]);
                    AM.TargetPiece = (Board[AM.SqIdx] + 0);
                    List.ReplaceItem(Board, AM.SqIdx, 0);
                }
            }
            If ((AM.TargetIdx - AM.SourceIdx) == (16 * AM.Factor))
            {
                List.ReplaceItem(EnPassantTarget, Ply, AM.TargetIdx);
            }
            If ((AM.TargetIdx > 56) Or (AM.TargetIdx < 9))
            {
                AM.PromotionCode = (Operator.LetterOf(AM.Move, Variable.Length(AM.Move)) + 0);
                If (AM.Factor == 1)
                {
                    If (AM.PromotionCode == 1)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnQueen);
                        Glob.OwnQueenCount += 1;
                    }
                    If (AM.PromotionCode == 2)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnRook);
                        Glob.OwnRookCount += 1;
                        Glob.OwnNonQueenMajorMinorCount += 1;
                    }
                    If (AM.PromotionCode == 3)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnBishop);
                        Glob.OwnBishopCount += 1;
                        Glob.OwnNonQueenMajorMinorCount += 1;
                    }
                    If (AM.PromotionCode == 4)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnKnight);
                        Glob.OwnNonQueenMajorMinorCount += 1;
                    }
                    Glob.OwnPawnCount += -1;
                }
                Else
                {
                    If (AM.PromotionCode == 1)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppQueen);
                        Glob.OppQueenCount += 1;
                    }
                    If (AM.PromotionCode == 2)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppRook);
                        Glob.OppRookCount += 1;
                        Glob.OppNonQueenMajorMinorCount += 1;
                    }
                    If (AM.PromotionCode == 3)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppBishop);
                        Glob.OppBishopCount += 1;
                        Glob.OppNonQueenMajorMinorCount += 1;
                    }
                    If (AM.PromotionCode == 4)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppKnight);
                        Glob.OppNonQueenMajorMinorCount += 1;
                    }
                    Glob.OppPawnCount += -1;
                }
                Call GetPiecePosHash(AM.SourcePiece)(AM.TargetIdx);
                Glob.CurrentBoardHash = (Glob.CurrentBoardHash - Ret.GetPiecePosHash.Hash);
                If (Not ((abs(AM.SourcePiece) == GoK_OwnPawn)))
                {
                    If (AM.SourcePiece > 0)
                    {
                        Glob.NonPawnHashOwn = (Glob.NonPawnHashOwn - Ret.GetPiecePosHash.Hash);
                    }
                    Else
                    {
                        Glob.NonPawnHashOpp = (Glob.NonPawnHashOpp - Ret.GetPiecePosHash.Hash);
                    }
                }
                Glob.KPHash = (Glob.KPHash - Ret.GetPiecePosHash.Hash);
                List.ReplaceItem(Board, AM.TargetIdx, PromotionPieces[Ply]);
                Call GetPiecePosHash(PromotionPieces[Ply])(AM.TargetIdx);
                Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
                If (Not ((abs(PromotionPieces[Ply]) == GoK_OwnPawn)))
                {
                    If (PromotionPieces[Ply] > 0)
                    {
                        Glob.NonPawnHashOwn += Ret.GetPiecePosHash.Hash;
                    }
                    Else
                    {
                        Glob.NonPawnHashOpp += Ret.GetPiecePosHash.Hash;
                    }
                }
            }
        }
        Else
        {
            If (abs(AM.SourcePiece) == GoK_OwnKing)
            {
                If (AM.Factor == 1)
                {
                    Glob.OwnKingIdx = AM.TargetIdx;
                }
                Else
                {
                    Glob.OppKingIdx = AM.TargetIdx;
                }
                Glob.KPHash += MoveHashLookup[AM.MoveKey];
                Call SetCastlingStateFlag(Ply)((2 + ((AM.Factor == -1) * 4)))(1);
            }
            If (abs(AM.SourcePiece) == GoK_OwnRook)
            {
                If ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], (3 + ((AM.Factor == -1) * 4))) == 0))
                {
                    If (AM.SourceIdx == (8 + ((AM.Factor == -1) * 56)))
                    {
                        Call SetCastlingStateFlag(Ply)((3 + ((AM.Factor == -1) * 4)))(1);
                    }
                }
                If ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], (4 + ((AM.Factor == -1) * 4))) == 0))
                {
                    If (AM.SourceIdx == (1 + ((AM.Factor == -1) * 56)))
                    {
                        Call SetCastlingStateFlag(Ply)((4 + ((AM.Factor == -1) * 4)))(1);
                    }
                }
            }
        }
        If (Not ((AM.TargetPiece == 0)))
        {
            If (abs(AM.TargetPiece) == GoK_OwnRook)
            {
                If (AM.TargetIdx == (8 + ((AM.Factor == 1) * 56)))
                {
                    Call SetCastlingStateFlag(Ply)((3 + ((AM.Factor == 1) * 4)))(1);
                }
                If (AM.TargetIdx == (1 + ((AM.Factor == 1) * 56)))
                {
                    Call SetCastlingStateFlag(Ply)((4 + ((AM.Factor == 1) * 4)))(1);
                }
            }
            AM.MoveKey = (((PieceIdxLookup[abs(AM.TargetPiece)] * 10000) + (TargetPiecesIdx[Ply] * 100)) + ((AM.TargetPiece > 0) * 60000));
            Glob.CurrentBoardHash += MoveHashLookup[AM.MoveKey];
            If (Not ((abs(AM.TargetPiece) == GoK_OwnPawn)))
            {
                If (AM.TargetPiece > 0)
                {
                    Glob.NonPawnHashOwn += MoveHashLookup[AM.MoveKey];
                }
                Else
                {
                    Glob.NonPawnHashOpp += MoveHashLookup[AM.MoveKey];
                }
            }
            If ((abs(AM.TargetPiece) == GoK_OwnPawn) Or (abs(AM.TargetPiece) == GoK_OwnKing))
            {
                Glob.KPHash += MoveHashLookup[AM.MoveKey];
            }
            If (AM.TargetPiece > 0)
            {
                If (AM.TargetPiece == GoK_OwnPawn)
                {
                    Glob.OwnPawnCount += -1;
                }
                Else
                {
                    If (AM.TargetPiece < GoK_OwnQueen)
                    {
                        Glob.OwnNonQueenMajorMinorCount += -1;
                        If (AM.TargetPiece == GoK_OwnRook)
                        {
                            Glob.OwnRookCount += -1;
                        }
                        If (AM.TargetPiece == GoK_OwnBishop)
                        {
                            Glob.OwnBishopCount += -1;
                        }
                    }
                    Else
                    {
                        If (AM.TargetPiece == GoK_OwnQueen)
                        {
                            Glob.OwnQueenCount += -1;
                        }
                    }
                }
            }
            Else
            {
                If (AM.TargetPiece == GoK_OppPawn)
                {
                    Glob.OppPawnCount += -1;
                }
                Else
                {
                    If (AM.TargetPiece > GoK_OppQueen)
                    {
                        Glob.OppNonQueenMajorMinorCount += -1;
                        If (AM.TargetPiece == GoK_OppRook)
                        {
                            Glob.OppRookCount += -1;
                        }
                        If (AM.TargetPiece == GoK_OppBishop)
                        {
                            Glob.OppBishopCount += -1;
                        }
                    }
                    Else
                    {
                        If (AM.TargetPiece == GoK_OppQueen)
                        {
                            Glob.OppQueenCount += -1;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        If (AM.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_OppRook);
            List.ReplaceItem(Board, 63, GoK_OppKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.OppKingIdx = 63;
            Call UpdateMoveHashPosScore(GoK_OppKing)(61)(63)((1 == 0))(Ply);
            Call UpdateMoveHashPosScore(GoK_OppRook)(64)(62)((1 == 1))(Ply);
            Call SetCastlingStateFlag(Ply)(5)(1);
        }
        Else
        {
            If (AM.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_OppKing);
                List.ReplaceItem(Board, 60, GoK_OppRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.OppKingIdx = 59;
                Call UpdateMoveHashPosScore(GoK_OppKing)(61)(59)((1 == 0))(Ply);
                Call UpdateMoveHashPosScore(GoK_OppRook)(57)(60)((1 == 1))(Ply);
                Call SetCastlingStateFlag(Ply)(5)(1);
            }
            Else
            {
                If (AM.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_OwnRook);
                    List.ReplaceItem(Board, 7, GoK_OwnKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.OwnKingIdx = 7;
                    Call UpdateMoveHashPosScore(GoK_OwnKing)(5)(7)((1 == 0))(Ply);
                    Call UpdateMoveHashPosScore(GoK_OwnRook)(8)(6)((1 == 1))(Ply);
                    Call SetCastlingStateFlag(Ply)(1)(1);
                }
                Else
                {
                    If (AM.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_OwnKing);
                        List.ReplaceItem(Board, 4, GoK_OwnRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.OwnKingIdx = 3;
                        Call UpdateMoveHashPosScore(GoK_OwnKing)(5)(3)((1 == 0))(Ply);
                        Call UpdateMoveHashPosScore(GoK_OwnRook)(1)(4)((1 == 1))(Ply);
                        Call SetCastlingStateFlag(Ply)(1)(1);
                    }
                }
            }
        }
    }
    If (Not ((AppliedMove[Ply] == 0)))
    {
        If ((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 0))
        {
            Glob.NodeCount += 1;
        }
        Else
        {
            Glob.NodeCountQuiescence += 1;
        }
    }
}

Define ApplyMoveLight(string Ply) (warp=true)
{
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.CurrentBoardHash);
    Call GetCurrentMove(Ply);
    AML.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, AML.Move);
    AML.SourceIdx = floor((AML.Move / 100));
    If (AML.SourceIdx > 0)
    {
        AML.TargetIdx = floor((AML.Move % 100));
        AML.SourcePiece = (Board[AML.SourceIdx] + 0);
        AML.TargetPiece = (Board[AML.TargetIdx] + 0);
        List.ReplaceItem(SourcePieces, Ply, AML.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, AML.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, AML.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, AML.TargetIdx, AML.SourcePiece);
        List.ReplaceItem(Board, AML.SourceIdx, 0);
        If (AML.SourcePiece == GoK_OwnKing)
        {
            Glob.OwnKingIdx = AML.TargetIdx;
        }
        If (AML.SourcePiece == GoK_OppKing)
        {
            Glob.OppKingIdx = AML.TargetIdx;
        }
        Glob.CurrentBoardHash += MoveHashLookup[(((PieceIdxLookup[abs(AML.SourcePiece)] * 10000) + ((AML.SourceIdx * 100) + AML.TargetIdx)) + ((AML.SourcePiece > 0) * 60000))];
        If (Not ((AML.TargetPiece == 0)))
        {
            Glob.CurrentBoardHash += MoveHashLookup[(((PieceIdxLookup[abs(AML.TargetPiece)] * 10000) + (AML.TargetIdx * 100)) + ((AML.TargetPiece > 0) * 60000))];
        }
        If (((abs(AML.SourcePiece) == GoK_OwnPawn) And (AML.TargetPiece == 0)) And (Not ((IdxToFile[AML.SourceIdx] == IdxToFile[AML.TargetIdx]))))
        {
            AML.EnPassantSquare = (AML.TargetIdx - (8 * (((AML.SourcePiece > 0) * 2) - 1)));
            AML.EnPassantCaptured = (Board[AML.EnPassantSquare] + 0);
            List.ReplaceItem(TargetPiecesIdx, Ply, AML.EnPassantSquare);
            List.ReplaceItem(TargetPieces, Ply, AML.EnPassantCaptured);
            List.ReplaceItem(Board, AML.EnPassantSquare, 0);
            Glob.CurrentBoardHash = (Glob.CurrentBoardHash + MoveHashLookup[(((PieceIdxLookup[abs(AML.EnPassantCaptured)] * 10000) + (AML.EnPassantSquare * 100)) + ((AML.EnPassantCaptured > 0) * 60000))]);
        }
    }
    Else
    {
        List.ReplaceItem(SourcePieces, Ply, 0);
        List.ReplaceItem(TargetPiecesIdx, Ply, 0);
        List.ReplaceItem(TargetPieces, Ply, 0);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        If (AML.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_OppRook);
            List.ReplaceItem(Board, 63, GoK_OppKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.OppKingIdx = 63;
            Call UpdateMoveHash(GoK_OppKing)(61)(63)(Ply);
            Call UpdateMoveHash(GoK_OppRook)(64)(62)(Ply);
        }
        Else
        {
            If (AML.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_OppKing);
                List.ReplaceItem(Board, 60, GoK_OppRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.OppKingIdx = 59;
                Call UpdateMoveHash(GoK_OppKing)(61)(59)(Ply);
                Call UpdateMoveHash(GoK_OppRook)(57)(60)(Ply);
            }
            Else
            {
                If (AML.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_OwnRook);
                    List.ReplaceItem(Board, 7, GoK_OwnKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.OwnKingIdx = 7;
                    Call UpdateMoveHash(GoK_OwnKing)(5)(7)(Ply);
                    Call UpdateMoveHash(GoK_OwnRook)(8)(6)(Ply);
                }
                Else
                {
                    If (AML.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_OwnKing);
                        List.ReplaceItem(Board, 4, GoK_OwnRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.OwnKingIdx = 3;
                        Call UpdateMoveHash(GoK_OwnKing)(5)(3)(Ply);
                        Call UpdateMoveHash(GoK_OwnRook)(1)(4)(Ply);
                    }
                }
            }
        }
    }
}

Define ASM(string SourceIdx)(string Ply)(bool CapturesOnly)(bool SlidingMoveTypeStraight) (warp=true)
{
    ASM.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    ASM.Idx = (MoveLookupLineIndexOffset[(SourceIdx + 0)] + 0);
    ASM.Count = 1;
    ASM.InvIdx = 8;
    Repeat Until (ASM.Count > 32)
    {
        If SlidingMoveTypeStraight
        {
            ASM.TargetIdx = (MoveLookupStraight[(ASM.Idx + ASM.Count)] + 0);
        }
        Else
        {
            ASM.TargetIdx = (MoveLookupCross[(ASM.Idx + ASM.Count)] + 0);
        }
        If (ASM.TargetIdx == -1)
        {
            ASM.Count += ASM.InvIdx;
            ASM.InvIdx = 8;
        }
        Else
        {
            If (Board[(ASM.TargetIdx + 0)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)(ASM.TargetIdx)(ASM.SourcePiece)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)(ASM.TargetIdx)(Ply)((1 == 0))(CapturesOnly);
                }
                ASM.Count += 1;
                ASM.InvIdx += -1;
            }
            Else
            {
                If (ASM.SourcePiece > 0)
                {
                    If (Board[(ASM.TargetIdx + 0)] < 0)
                    {
                        Call AddMoveImpl(SourceIdx)(ASM.TargetIdx)(Ply)((1 == 0))(CapturesOnly);
                    }
                }
                Else
                {
                    If (Board[(ASM.TargetIdx + 0)] > 0)
                    {
                        Call AddMoveImpl(SourceIdx)(ASM.TargetIdx)(Ply)((1 == 0))(CapturesOnly);
                    }
                }
                ASM.Count += ASM.InvIdx;
                ASM.InvIdx = 8;
            }
        }
    }
}

Define ASMAttack(string SourceIdx)(string Ply)(bool SlidingMoveTypeStraight) (warp=true)
{
    ASMA.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    ASMA.Idx = (MoveLookupLineIndexOffset[(SourceIdx + 0)] + 0);
    ASMA.Count = 1;
    ASMA.InvIdx = 8;
    Repeat Until (ASMA.Count > 32)
    {
        If SlidingMoveTypeStraight
        {
            ASMA.TargetIdx = (MoveLookupStraight[(ASMA.Idx + ASMA.Count)] + 0);
        }
        Else
        {
            ASMA.TargetIdx = (MoveLookupCross[(ASMA.Idx + ASMA.Count)] + 0);
        }
        If (ASMA.TargetIdx == -1)
        {
            ASMA.Count += ASMA.InvIdx;
            ASMA.InvIdx = 8;
        }
        Else
        {
            Call AddMoveImpl(SourceIdx)(ASMA.TargetIdx)(Ply)((1 == 1))((1 == 0));
            ASMA.TargetPiece = (Board[(ASMA.TargetIdx + 0)] + 0);
            If (ASMA.TargetPiece == 0)
            {
                ASMA.Count += 1;
                ASMA.InvIdx += -1;
            }
            Else
            {
                ASMA.IsXRay = 0;
                ASMA.TargetPieceAbs = abs(ASMA.TargetPiece);
                If (Not ((ASMA.TargetPieceAbs == GoK_OwnKing)))
                {
                    If (ASMA.TargetPieceAbs > GoK_OwnKnight)
                    {
                        If (Not (((ASMA.SourcePiece == GoK_OwnQueen) Or (ASMA.SourcePiece == GoK_OppQueen))))
                        {
                            If SlidingMoveTypeStraight
                            {
                                If ((ASMA.TargetPieceAbs == GoK_OwnQueen) Or ((((ASMA.SourcePiece > 0) And (ASMA.TargetPiece > 0)) Or ((ASMA.SourcePiece < 0) And (ASMA.TargetPiece < 0))) And (ASMA.TargetPieceAbs == GoK_OwnRook)))
                                {
                                    ASMA.IsXRay = 1;
                                }
                            }
                            Else
                            {
                                If (ASMA.TargetPieceAbs == GoK_OwnQueen)
                                {
                                    ASMA.IsXRay = 1;
                                }
                            }
                        }
                    }
                }
                If (ASMA.IsXRay == 1)
                {
                    ASMA.Count += 1;
                    ASMA.InvIdx += -1;
                }
                Else
                {
                    ASMA.Count += ASMA.InvIdx;
                    ASMA.InvIdx = 8;
                }
            }
        }
    }
}

Define CalcBoardAttackedByMove(string Ply) (warp=true)
{
    Call ClearBoardAttackedByMove(Ply);
    Call GenerateMovesImplWrapper(Ply)((1 == 1))((1 == 0));
}

Define CalcBoardAttackedByMoveChecked(string CheckingPly) (warp=true)
{
    CBABMC.IsChecked = 0;
    CBABMC.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    If (CBABMC.Factor > 0)
    {
        CBABMC.SqIdx = Glob.OppKingIdx;
    }
    Else
    {
        CBABMC.SqIdx = Glob.OwnKingIdx;
    }
    CBABMC.KingFile = IdxToFile[CBABMC.SqIdx];
    CBABMC.KingRank = IdxToRank[CBABMC.SqIdx];
    If (CBABMC.IsChecked == 0)
    {
        CBABMC.File = (CBABMC.KingFile + 1);
        CBABMC.Rank = (CBABMC.KingRank + 2);
        If (((CBABMC.File > 0) And (CBABMC.File < 9)) And ((CBABMC.Rank > 0) And (CBABMC.Rank < 9)))
        {
            CBABMC.SqIdx = (CBABMC.File + ((CBABMC.Rank - 1) * 8));
            CBABMC.Piece = Board[CBABMC.SqIdx];
            If (((CBABMC.Piece * CBABMC.Factor) > 0) And (abs(CBABMC.Piece) == GoK_OwnKnight))
            {
                CBABMC.IsChecked = 1;
            }
        }
    }
    If (CBABMC.IsChecked == 0)
    {
        CBABMC.File = (CBABMC.KingFile + 2);
        CBABMC.Rank = (CBABMC.KingRank + 1);
        If (((CBABMC.File > 0) And (CBABMC.File < 9)) And ((CBABMC.Rank > 0) And (CBABMC.Rank < 9)))
        {
