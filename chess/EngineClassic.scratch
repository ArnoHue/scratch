        Call TaperedEval.GetSum;
        Glob.EvalMgTotal += (Glob.TaperedEvalMg * (((EvalT.Side == 1) * 2) - 1));
        Glob.EvalEgTotal += (Glob.TaperedEvalEg * (((EvalT.Side == 1) * 2) - 1));
        EvalT.SafeChecksPacked = (Operator.Round((Ret.TaperedEval.GetSum.Score * 1)) * (((EvalT.Side == 1) * 2) - 1));
        Ret.EvaluateThreatsImpl.Score += EvalT.SafeChecksPacked;
        EvalT.Side += 1;
    }
    If (Glob.EvalDebugLog == 1)
    {
        Call LogPVEvalLine("Eval.Threats.Total")(Ret.EvaluateThreatsImpl.Score)("")("")(EvalT.Side)("");
    }
}

Define ExecuteEngineMove (warp=false)
{
    Call EnterExecution;
    Call ExecuteEngineMoveImpl;
    Call ExitExecution;
}

Define ExecuteEngineMoveImpl (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Event.Broadcast("OpeningBookHide");
    EEMI.Move = Const.Null;
    If (Glob.Level > 2)
    {
        Call GetOpeningMoves;
        If (List.Length(OpeningMovesRes) > 0)
        {
            Event.Broadcast("OpeningBookShow");
            EEMI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
        }
    }
    Call IsEngineValidMove(EEMI.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Looks.Think("Thinking...");
        Control.Wait(0);
        If (Glob.Level > 2)
        {
            If (Glob.Level > 4)
            {
                Call GetBestMoveMedDiff;
                EEMI.Move = Ret.GetBestMoveMedDiff.Move;
            }
            Else
            {
                Call GetBestMoveBlitz;
                EEMI.Move = Ret.GetBestMoveBlitz.Move;
            }
        }
        Else
        {
            Call GetBestMoveEasy;
            EEMI.Move = Ret.GetBestMoveEasy.Move;
        }
    }
    Event.BroadcastAndWait("hidebestmove");
    Call OnProgressChanged(100);
    Control.Wait(0);
    Call IsEngineValidMove(EEMI.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Looks.Say(Operator.Join("Internal Error: No valid move found. Sorry, this should not happen. Maybe you cleared lookup lists in the editor? If you are running a normal game, please export board data and report bug via project comment", Operator.Join(" Move: ", EEMI.Move)), 10);
        GoK_IsGameSuspended = 1;
        Stop(this script);
    }
    Looks.Think("");
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((EEMI.Move / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((EEMI.Move % 100))];
    If (((EEMI.Move == GoK_OwnQueensideCastling) Or (EEMI.Move == GoK_OwnKingsideCastling)) Or ((EEMI.Move == GoK_OppQueensideCastling) Or (EEMI.Move == GoK_OppKingsideCastling)))
    {
        Pieces_MovePieceSpecial = EEMI.Move;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.BroadcastAndWait("movepiece");
    Event.Broadcast("SoundMove");
    List.Add(GameMoves, floor(EEMI.Move));
    Call GetMoveNotation(EEMI.Move);
    List.Add(GameMovesAN, Ret.GetMoveNotation.Notation);
    Call ClearMoveList(1);
    Call AddMoveToList(EEMI.Move)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1);
    Call DrawBoardAndWait;
    If (Not ((floor((EEMI.Move / 100)) == 0)))
    {
        If (Board[(EEMI.Move % 100)] == GoK_OwnKing)
        {
            Glob.HasOwnKingMoved = 1;
        }
        If (Board[(EEMI.Move % 100)] == GoK_OwnRook)
        {
            If (floor((EEMI.Move / 100)) == 1)
            {
                Glob.HasOwnRookQSMoved = 1;
            }
            If (floor((EEMI.Move / 100)) == 8)
            {
                Glob.HasOwnRookKSMoved = 1;
            }
        }
    }
    If ((EEMI.Move == GoK_OwnQueensideCastling) Or (EEMI.Move == GoK_OwnKingsideCastling))
    {
        Glob.HasOwnKingMoved = 1;
        Glob.HasOwnCastled = 1;
    }
    Call AddBoardToHistory(1);
    Call GetRepetitionCount;
    If (Ret.GetRepetitionCount.Count > 2)
    {
        Looks.Say("Draw!");
        Event.Broadcast("SoundDraw");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByMaterial;
        If (Ret.IsDrawByMaterial.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call IsOppKingCheckMate;
            If (Ret.IsOppKingCheckMate.IsCheckMate == 1)
            {
                Looks.Say("Checkmate!");
                Event.Broadcast("SoundCheckmate");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(2);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call CalcBoardAttackedByMove(1);
                    If (Glob.IsOppSideChecked == 1)
                    {
                        Call SayAsync("Check!")(2);
                        Event.Broadcast("SoundCheck");
                    }
                }
            }
        }
    }
}

Define ExecuteInit (warp=false)
{
    Glob.ExecutionPly = 0;
    Glob.IsExecutionRunning = 0;
    If (Glob.IsPlayerBlack == 1)
    {
        Call ExecuteEngineMove;
    }
}

Define ExecuteUserMove(string UserMove) (warp=false)
{
    Call EnterExecution;
    Call ExecuteUserMoveImpl(UserMove);
    Call ExitExecution;
}

Define ExecuteUserMoveImpl(string UserMoveParam) (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((UserMoveParam / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((UserMoveParam % 100))];
    If (((UserMoveParam == GoK_OwnQueensideCastling) Or (UserMoveParam == GoK_OwnKingsideCastling)) Or ((UserMoveParam == GoK_OppQueensideCastling) Or (UserMoveParam == GoK_OppKingsideCastling)))
    {
        Pieces_MovePieceSpecial = UserMoveParam;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.BroadcastAndWait("movepiece");
    Event.Broadcast("SoundMove");
    Stg_FromSquareIdx = -1;
    Stg_ToSquareIdx = -1;
    Event.BroadcastAndWait("fromsquareselected");
    Event.BroadcastAndWait("tosquareselected");
    Call GenerateMovesPublic(2);
    If (Not (List.ContainsItem(Moves2, UserMoveParam)))
    {
        Call ClearMoveList(2);
        Call AddMoveToList(UserMoveParam)(2)(0);
        List.ReplaceItem(MovesIdx, 2, 1);
        Call ApplyMove(2);
        Call CalcBoardAttackedByMove(3);
        If (Glob.IsOppSideChecked == 1)
        {
            Call SayAsync("Invalid move - Check!")(2);
            Event.Broadcast("SoundInvalidMoveCheck");
        }
        Else
        {
            Call SayAsync("Invalid move!")(2);
            Event.Broadcast("SoundInvalidMove");
        }
        Call RevertMove(2);
        Call DrawBoardAndWait;
        Stop(this script);
    }
    Glob.UserMove = UserMoveParam;
    If (Operator.LetterOf(Glob.UserMove, (Variable.Length(Glob.UserMove) - 1)) == ".")
    {
        Looks.Say("Please select promotion piece");
        Event.BroadcastAndWait("selectpromotionpiecewhite");
        Looks.Say("");
        If (Pieces_SelectedPromotionPiece == GoK_OppQueen)
        {
            Glob.UserMove = (floor(Glob.UserMove) + 0.1);
        }
        Else
        {
            If (Pieces_SelectedPromotionPiece == GoK_OppRook)
            {
                Glob.UserMove = (floor(Glob.UserMove) + 0.2);
            }
            Else
            {
                If (Pieces_SelectedPromotionPiece == GoK_OppBishop)
                {
                    Glob.UserMove = (floor(Glob.UserMove) + 0.3);
                }
                Else
                {
                    If (Pieces_SelectedPromotionPiece == GoK_OppKnight)
                    {
                        Glob.UserMove = (floor(Glob.UserMove) + 0.4);
                    }
                }
            }
        }
    }
    Call GetMoveNotation(Glob.UserMove);
    EUMI.Notation = Ret.GetMoveNotation.Notation;
    Call ClearMoveList(2);
    Call AddMoveToList(Glob.UserMove)(2)(0);
    List.ReplaceItem(MovesIdx, 2, 1);
    Call ApplyMove(2);
    Call DrawBoardAndWait;
    Call CalcBoardAttackedByMove(1);
    If (Glob.IsOppSideChecked == 1)
    {
        Call RevertMove(2);
        Call DrawBoardAndWait;
        Control.Wait(0);
        Call SayAsync("Invalid move - Check!")(2);
        Event.Broadcast("SoundInvalidMoveCheck");
        Stop(this script);
    }
    List.Add(GameMovesAN, EUMI.Notation);
    List.Add(GameMoves, floor(Glob.UserMove));
    Looks.Think("Thinking...");
    Call DrawBoardAndWait;
    Control.Wait(0);
    EUMI.SourceIdx = floor((Glob.UserMove / 100));
    EUMI.TargetIdx = floor((Glob.UserMove % 100));
    If (Board[EUMI.TargetIdx] == GoK_OppKing)
    {
        Glob.HasOppKingMoved = 1;
    }
    If (Board[EUMI.TargetIdx] == GoK_OppRook)
    {
        If (EUMI.SourceIdx == 57)
        {
            Glob.HasOppRookQSMoved = 1;
        }
        If (EUMI.SourceIdx == 64)
        {
            Glob.HasOppRookKSMoved = 1;
        }
    }
    If ((Glob.UserMove == GoK_OppQueensideCastling) Or (Glob.UserMove == GoK_OppKingsideCastling))
    {
        Glob.HasOppCastled = 1;
        Glob.HasOppKingMoved = 1;
    }
    Call AddBoardToHistory(0);
    Call IsOwnKingCheckMate;
    If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
    {
        Looks.Say("Checkmate!");
        Event.Broadcast("SoundCheckmate");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByStalemate(1);
        If (Ret.IsDrawByStalemate.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call GetRepetitionCount;
            If (Ret.GetRepetitionCount.Count > 2)
            {
                Looks.Say("Draw!");
                Event.Broadcast("SoundDraw");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByMaterial;
                If (Ret.IsDrawByMaterial.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
    }
}

Define ExitExecution (warp=false)
{
    Glob.ExecutionPly += -1;
    If (Glob.ExecutionPly == 0)
    {
        Glob.IsExecutionRunning = 0;
        Event.BroadcastAndWait("inputmode");
    }
}

Define ExportBoardFEN(bool IsPlayerTurn) (warp=true)
{
    Call StoreExternalBoard;
    EBFEN.SqIdx = 1;
    Ret.ExportBoardFEN.FEN = "";
    Ret.ExportBoardFEN.FENLichess = "https://lichess.org/analysis/";
    Repeat Until (EBFEN.SqIdx > 64)
    {
        EBFEN.Piece = GoK_Board[EBFEN.SqIdx];
        If (EBFEN.Piece == GoK_OwnPawn)
        {
            EBFEN.PieceChar = "p";
        }
        If (EBFEN.Piece == GoK_OwnKnight)
        {
            EBFEN.PieceChar = "n";
        }
        If (EBFEN.Piece == GoK_OwnBishop)
        {
            EBFEN.PieceChar = "b";
        }
        If (EBFEN.Piece == GoK_OwnRook)
        {
            EBFEN.PieceChar = "r";
        }
        If (EBFEN.Piece == GoK_OwnQueen)
        {
            EBFEN.PieceChar = "q";
        }
        If (EBFEN.Piece == GoK_OwnKing)
        {
            EBFEN.PieceChar = "k";
        }
        If (EBFEN.Piece == GoK_OppPawn)
        {
            EBFEN.PieceChar = "P";
        }
        If (EBFEN.Piece == GoK_OppKnight)
        {
            EBFEN.PieceChar = "N";
        }
        If (EBFEN.Piece == GoK_OppBishop)
        {
            EBFEN.PieceChar = "B";
        }
        If (EBFEN.Piece == GoK_OppRook)
        {
            EBFEN.PieceChar = "R";
        }
        If (EBFEN.Piece == GoK_OppQueen)
        {
            EBFEN.PieceChar = "Q";
        }
        If (EBFEN.Piece == GoK_OppKing)
        {
            EBFEN.PieceChar = "K";
        }
        If (EBFEN.Piece == 0)
        {
            EBFEN.ScanSqIdx = EBFEN.SqIdx;
            Repeat Until (((EBFEN.ScanSqIdx % 8) == 0) Or (Not ((GoK_Board[(EBFEN.ScanSqIdx + 1)] == 0))))
            {
                EBFEN.ScanSqIdx += 1;
            }
            EBFEN.PieceChar = ((EBFEN.ScanSqIdx - EBFEN.SqIdx) + 1);
            EBFEN.SqIdx += (EBFEN.ScanSqIdx - EBFEN.SqIdx);
        }
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, EBFEN.PieceChar);
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, EBFEN.PieceChar);
        If (((EBFEN.SqIdx % 8) == 0) And (EBFEN.SqIdx < 64))
        {
            Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, "/");
            Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "/");
        }
        EBFEN.SqIdx += 1;
    }
    If (((Glob.IsPlayerBlack == 1) And IsPlayerTurn) Or ((Not ((Glob.IsPlayerBlack == 1))) And (Not (IsPlayerTurn))))
    {
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, " b");
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "_b");
    }
    Else
    {
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, " w");
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "_w");
    }
}

Define ExportMovesPGN (warp=true)
{
    EMPGN.GameMovesANIdx = 1;
    Ret.ExportMovesPGN.PGN = "";
    Repeat (List.Length(GameMovesAN))
    {
        If ((EMPGN.GameMovesANIdx % 2) == 1)
        {
            Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join((((EMPGN.GameMovesANIdx - 1) / 2) + 1), ". "));
        }
        Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join(GameMovesAN[EMPGN.GameMovesANIdx], " "));
        EMPGN.GameMovesANIdx += 1;
    }
}

Define FillBoard (warp=true)
{
    List.DeleteAll(GoK_ScreenIdx);
    FB.ScreenSqIdx = 1;
    Repeat (64)
    {
        If (Glob.IsPlayerBlack == 1)
        {
            List.Add(GoK_ScreenIdx, (((IdxToRank[FB.ScreenSqIdx] - 1) * 8) + (9 - IdxToFile[FB.ScreenSqIdx])));
        }
        Else
        {
            List.Add(GoK_ScreenIdx, FB.ScreenSqIdx);
        }
        FB.ScreenSqIdx += 1;
    }
    List.DeleteItem(Board, all);
    Repeat (64)
    {
        List.Add(Board, 0);
    }
    List.ReplaceItem(Board, 1, GoK_OwnRook);
    List.ReplaceItem(Board, 2, GoK_OwnKnight);
    List.ReplaceItem(Board, 3, GoK_OwnBishop);
    List.ReplaceItem(Board, 4, GoK_OwnQueen);
    List.ReplaceItem(Board, 5, GoK_OwnKing);
    List.ReplaceItem(Board, 6, GoK_OwnBishop);
    List.ReplaceItem(Board, 7, GoK_OwnKnight);
    List.ReplaceItem(Board, 8, GoK_OwnRook);
    FB.SqIdx = 9;
    Repeat (8)
    {
        List.ReplaceItem(Board, FB.SqIdx, GoK_OwnPawn);
        FB.SqIdx += 1;
    }
    FB.SqIdx = 49;
    Repeat (8)
    {
        List.ReplaceItem(Board, FB.SqIdx, GoK_OppPawn);
        FB.SqIdx += 1;
    }
    List.ReplaceItem(Board, 57, GoK_OppRook);
    List.ReplaceItem(Board, 58, GoK_OppKnight);
    List.ReplaceItem(Board, 59, GoK_OppBishop);
    List.ReplaceItem(Board, 60, GoK_OppQueen);
    List.ReplaceItem(Board, 61, GoK_OppKing);
    List.ReplaceItem(Board, 62, GoK_OppBishop);
    List.ReplaceItem(Board, 63, GoK_OppKnight);
    List.ReplaceItem(Board, 64, GoK_OppRook);
}

Define FindAndAddSafePawnPush(string SourceIdx)(string TargetIdx)(string AttackedPiece)(string Factor) (warp=true)
{
    If ((TargetIdx > 8) And (TargetIdx < 57))
    {
        If ((Board[(SourceIdx + 0)] == (GoK_OppPawn * Factor)) And (Board[(TargetIdx + 0)] == 0))
        {
            If ((Not ((abs((TargetIdx - SourceIdx)) == 16))) Or (Board[((TargetIdx + SourceIdx) / 2)] == 0))
            {
                If (((AttackedPiece < 0) And ((BoardAttacked[(TargetIdx + 64)] == 0) Or (Board[BoardAttackedPiece[(TargetIdx + 64)]] < GoK_OppPawn))) Or ((AttackedPiece > 0) And ((BoardAttacked[(TargetIdx + 0)] == 0) Or (Board[BoardAttackedPiece[(TargetIdx + 0)]] > GoK_OwnPawn))))
                {
                    If (((AttackedPiece < 0) And ((BoardAttacked[(TargetIdx + 64)] == 0) Or (BoardAttacked[(TargetIdx + 0)] > 0))) Or ((AttackedPiece > 0) And ((BoardAttacked[(TargetIdx + 0)] == 0) Or (BoardAttacked[(TargetIdx + 64)] > 0))))
                    {
                        If (Glob.SafePawnPushCredited == 0)
                        {
                            Call TaperedEval.Add((-24 * Factor))((-20 * Factor))("Eval.Threats.SafePawnPush")("")("")(((SourceIdx * 100) + TargetIdx));
                            Glob.SafePawnPushCredited = 1;
                        }
                    }
                }
            }
        }
    }
}

Define GenerateMovesForSource(string Ply)(string SourceIdx)(bool CalcAttackState)(bool CapturesOnly) (warp=true)
{
    MoveGen.MFS.PieceType = (Board[(SourceIdx + 0)] + 0);
    MoveGen.MFS.File = (IdxToFile[(SourceIdx + 0)] + 0);
    MoveGen.MFS.Rank = (IdxToRank[(SourceIdx + 0)] + 0);
    Call //("Pawn moves (generated via code logic)");
    If (MoveGen.MFS.PieceType == GoK_OwnPawn)
    {
        If (MoveGen.MFS.File > 1)
        {
            If (CalcAttackState Or (Board[(SourceIdx + 7)] < 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx + 7))(Ply)(CalcAttackState)(CapturesOnly);
            }
        }
        If (MoveGen.MFS.File < 8)
        {
            If (CalcAttackState Or (Board[(SourceIdx + 9)] < 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx + 9))(Ply)(CalcAttackState)(CapturesOnly);
            }
        }
        If (Not (CalcAttackState))
        {
            If (Board[(SourceIdx + 8)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx + 8))(GoK_OwnPawn)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 8))(Ply)(CalcAttackState)(CapturesOnly);
                }
                If ((MoveGen.MFS.Rank == 2) And (Board[(SourceIdx + 16)] == 0))
                {
                    If CapturesOnly
                    {
                        Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx + 16))(GoK_OwnPawn)(Ply);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx + 16))(Ply)(CalcAttackState)(CapturesOnly);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            MoveGen.MFS.TargetIdx = EnPassantTarget[Ply];
            If ((Not (CalcAttackState)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[MoveGen.MFS.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[MoveGen.MFS.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((MoveGen.MFS.TargetIdx + 8))(Ply)(CalcAttackState)(CapturesOnly);
                }
            }
        }
        Stop(this script);
    }
    If (MoveGen.MFS.PieceType == GoK_OppPawn)
    {
        If (MoveGen.MFS.File > 1)
        {
            If (CalcAttackState Or (Board[(SourceIdx - 9)] > 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx - 9))(Ply)(CalcAttackState)(CapturesOnly);
            }
        }
        If (MoveGen.MFS.File < 8)
        {
            If (CalcAttackState Or (Board[(SourceIdx - 7)] > 0))
            {
                Call AddMoveImpl(SourceIdx)((SourceIdx - 7))(Ply)(CalcAttackState)(CapturesOnly);
            }
        }
        If (Not (CalcAttackState))
        {
            If (Board[(SourceIdx - 8)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx - 8))(GoK_OppPawn)(Ply);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 8))(Ply)(CalcAttackState)(CapturesOnly);
                }
                If ((MoveGen.MFS.Rank == 7) And (Board[(SourceIdx - 16)] == 0))
                {
                    If CapturesOnly
                    {
                        Call AddPotentialQuiescenceMove(SourceIdx)((SourceIdx - 16))(GoK_OppPawn)(Ply);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx - 16))(Ply)(CalcAttackState)(CapturesOnly);
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            MoveGen.MFS.TargetIdx = EnPassantTarget[Ply];
            If ((Not (CalcAttackState)) And (MoveGen.MFS.Rank == IdxToRank[(MoveGen.MFS.TargetIdx + 0)]))
            {
                If (abs((MoveGen.MFS.File - IdxToFile[(MoveGen.MFS.TargetIdx + 0)])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((MoveGen.MFS.TargetIdx - 8))(Ply)(CalcAttackState)(CapturesOnly);
                }
            }
        }
        Stop(this script);
    }
    Call //("Non-pawn moves (generated via lookup tables)");
    MoveGen.MFS.PieceType = abs(MoveGen.MFS.PieceType);
    If (MoveGen.MFS.PieceType == GoK_OwnRook)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 1));
        Stop(this script);
    }
    If (MoveGen.MFS.PieceType == GoK_OwnBishop)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 0));
        Stop(this script);
    }
    If (MoveGen.MFS.PieceType == GoK_OwnKnight)
    {
        Call AddLookupMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 0));
        Stop(this script);
    }
    If (MoveGen.MFS.PieceType == GoK_OwnKing)
    {
        Call AddLookupMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 1));
        Stop(this script);
    }
    If (MoveGen.MFS.PieceType == GoK_OwnQueen)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 1));
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 0));
        Stop(this script);
    }
}

Define GenerateMovesForSourceEx(string Ply)(string SourceIdx)(bool CalcAttackState)(bool CapturesOnly) (warp=true)
{
    List.DeleteAll(CalcMovesMoveList);
    List.DeleteAll(CalcMovesScoreList);
    Glob.IsPotentialNonCapQuiescMove = 0;
    If (((PlyIsOwn[Ply] == 1) And (Board[(SourceIdx + 0)] > 0)) Or ((PlyIsOwn[Ply] == 0) And (Board[(SourceIdx + 0)] < 0)))
    {
        If CapturesOnly
        {
            Call IsQuiescentCheckCond(Ply);
            Glob.IsPotentialNonCapQuiescMove = Ret.IsQuiescentCheckCond.IsTrue;
        }
        Call GenerateMovesForSource(Ply)(SourceIdx)(CalcAttackState)(CapturesOnly);
        Call SortMoveList(Ply);
    }
}

Define GenerateMovesImpl(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool IsBlackMove) (warp=true)
{
    If ((CheckedState[Ply] == 1) And (Not (CalcAttackState)))
    {
        Call PrepareEvasionMask(Ply);
    }
    MoveGen.MI.SkipIdx = -1;
    List.DeleteAll(CalcMovesScoreList);
    List.DeleteAll(CalcMovesMoveList);
    Call PrepareCurrentKillerMoves(Ply);
    Call ClearMoveList(Ply);
    MoveGen.MI.SourceSqIdx = 1;
    Repeat (64)
    {
        If (Not ((MoveGen.MI.SourceSqIdx == MoveGen.MI.SkipIdx)))
        {
            MoveGen.MI.Piece = (Board[MoveGen.MI.SourceSqIdx] + 0);
            If ((IsBlackMove And (MoveGen.MI.Piece > 0)) Or ((Not (IsBlackMove)) And (MoveGen.MI.Piece < 0)))
            {
                Call GenerateMovesForSource(Ply)(MoveGen.MI.SourceSqIdx)(CalcAttackState)(CapturesOnly);
            }
        }
        MoveGen.MI.SourceSqIdx += 1;
    }
    Call //("Castling moves");
    If ((Not (CalcAttackState)) And (Not (CapturesOnly)))
    {
        If IsBlackMove
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 1) == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 2) == 0)))
            {
                If (Operator.LetterOf(CastlingState[Ply], 4) == 0)
                {
                    If ((((Board[1] == GoK_OwnRook) And (Board[2] == 0)) And ((Board[3] == 0) And (Board[4] == 0))) And (Board[5] == GoK_OwnKing))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 3)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 4)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OwnQueensideCastling)(Ply);
                        }
                    }
                }
                If (Operator.LetterOf(CastlingState[Ply], 3) == 0)
                {
                    If (((Board[5] == GoK_OwnKing) And (Board[6] == 0)) And ((Board[7] == 0) And (Board[8] == GoK_OwnRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 6)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 7)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OwnKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
        Else
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 5) == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (Operator.LetterOf(CastlingState[Ply], 6) == 0)))
            {
                If (Operator.LetterOf(CastlingState[Ply], 8) == 0)
                {
                    If (((Board[57] == GoK_OppRook) And (Board[58] == 0)) And ((Board[59] == 0) And ((Board[60] == 0) And (Board[61] == GoK_OppKing))))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 59)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 60)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OppQueensideCastling)(Ply);
                        }
                    }
                }
                If (Operator.LetterOf(CastlingState[Ply], 7) == 0)
                {
                    If (((Board[62] == 0) And (Board[61] == GoK_OppKing)) And ((Board[63] == 0) And (Board[64] == GoK_OppRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 62)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 63)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OppKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
    }
    Call //("Move ordering");
    If (Not (CalcAttackState))
    {
        Call SortMoveList(Ply);
    }
}

Define GenerateMovesImplWrapper(string Ply)(bool CalcAttackState)(bool CapturesOnly) (warp=true)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.MoveGenBaseIdx)(Ply)(-1);
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_MethodEnter(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * CapturesOnly)) - ((2 * Const.MaxPlyStackFrames) * CalcAttackState)) + Ply));
    }
    Call TaperedEval.Init;
    Glob.IsPotentialNonCapQuiescMove = 0;
    If CapturesOnly
    {
        Call IsQuiescentCheckCond(Ply);
        Glob.IsPotentialNonCapQuiescMove = Ret.IsQuiescentCheckCond.IsTrue;
    }
    Call GenerateMovesImpl(Ply)(CalcAttackState)(CapturesOnly)((PlyIsOwn[Ply] == 1));
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_MethodExit(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * CapturesOnly)) - ((2 * Const.MaxPlyStackFrames) * CalcAttackState)) + Ply));
    }
    If (Glob.ProfilerMode == Const.ProfilerMode.On)
    {
        Call Profile_TimeByHorizon(Const.ProfileTime.MoveGenBaseIdx)(Ply)(1);
    }
}

Define GenerateMovesPublic(string Ply) (warp=true)
{
    MoveGen.MP.SqIdx = 1;
    Repeat (64)
    {
        If (Board[MoveGen.MP.SqIdx] == GoK_OppKing)
        {
            Glob.OppKingIdx = MoveGen.MP.SqIdx;
        }
        Else
        {
            If (Board[MoveGen.MP.SqIdx] == GoK_OwnKing)
            {
                Glob.OwnKingIdx = MoveGen.MP.SqIdx;
            }
        }
        MoveGen.MP.SqIdx += 1;
    }
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo((Ply + 1))(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call SetInitialEnPassantTarget(Ply);
    List.ReplaceItem(CastlingState, Ply, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0));
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    List.ReplaceItem(CastlingState, Ply, Const.Null);
}

Define GetAttackForce(bool Black) (warp=true)
{
    If Black
    {
        Ret.GetAttackForce.Force = ((Glob.OwnQueenCount * 14) + ((Glob.OwnRookCount * 6) + ((Glob.OwnNonQueenMajorMinorCount - Glob.OwnRookCount) * 3)));
    }
    Else
    {
        Ret.GetAttackForce.Force = ((Glob.OppQueenCount * 14) + ((Glob.OppRookCount * 6) + ((Glob.OppNonQueenMajorMinorCount - Glob.OppRookCount) * 3)));
    }
}

Define GetBestMoveBlitz (warp=false)
{
    Get.BMB.ThinkTimeLimit = ((Glob.Level - 2) * 2);
    Glob.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Glob.IsSearchTimeout = 0;
    Glob.IdxDeepening = 1;
    Ret.GetBestMoveBlitz.Move = Const.Null;
    Glob.BestMoveEval = Const.Null;
    Glob.ThinkTimeLimitSearch = Get.BMB.ThinkTimeLimit;
    Repeat ((((Glob.Level - 2) * 2) * (2 - Glob.IsScratch3)))
    {
        If ((Glob.IsSearchTimeout == 0) And ((Glob.IdxDeepening == 1) Or ((Glob.BestMoveEval == Const.Null) Or (abs(Glob.BestMoveEval) < Const.AbsMinCheckmateEval))))
        {
            Call Search(-100000)(100000)(Glob.IdxDeepening)(1)((Glob.IdxDeepening == 1));
            If (Not ((Ret.Search.Move == Const.Null)))
            {
                If ((Ret.GetBestMoveBlitz.Move == Const.Null) Or List.ContainsItem(SearchPly1EvalMoves, Ret.GetBestMoveBlitz.Move))
                {
                    Ret.GetBestMoveBlitz.Move = Ret.Search.Move;
                    Glob.BestMoveEval = Ret.Search.Eval;
                }
                Call OnEvaluationChanged(Glob.BestMoveEval);
                Call OnBestMoveChanged(Ret.GetBestMoveBlitz.Move);
            }
        }
        Glob.IdxDeepening += 1;
    }
}

Define GetBestMoveDCI (warp=true)
{
    Call GetBestMoveMedDiff.Prepare;
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveMedDiff.Iteration;
    }
    Ret.GetBestMoveDCI.Move = Glob.DeepeningBestMove;
}

Define GetBestMoveEasy (warp=false)
{
    Glob.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Glob.ThinkTimeLimitSearch = 10;
    Ret.GetBestMoveEasy.Move = Const.Null;
    If (Glob.Level == 1)
    {
        Get.BME.JuniorDistQuota = 100;
        Get.BME.JuniorSearchQuota = 0;
    }
    Else
    {
        If (Glob.Level == 2)
        {
            Get.BME.JuniorDistQuota = 40;
            Get.BME.JuniorSearchQuota = 20;
        }
    }
    Call Search(-100000)(100000)(1)(1)((1 == 0));
    Ret.GetBestMoveEasy.Move = Ret.Search.Move;
    Call OnEvaluationChanged(Ret.Search.Eval);
    Call OnBestMoveChanged(Ret.GetBestMoveEasy.Move);
    Get.BME.Rnd = Operator.Random(1 , 100);
    If (Not ((Ret.GetBestMoveEasy.Move == Const.Null)))
    {
        If ((Get.BME.Rnd > ((Get.BME.JuniorSearchQuota + 100) / 2)) Or (((BoardAttacked[(floor((Ret.GetBestMoveEasy.Move / 100)) + 64)] == 0) And (Board[floor((Ret.GetBestMoveEasy.Move % 100))] == 0)) And (Get.BME.Rnd > Get.BME.JuniorSearchQuota)))
        {
            Call GenerateMovesPublic(1);
            List.ReplaceItem(MovesIdx, 1, Operator.Random(1 , ceiling((List.Length(Moves1) * (Get.BME.JuniorDistQuota / 100)))));
            Call ApplyMove(1);
            Call CalcBoardAttackedByMove(2);
            Call RevertMove(1);
            Repeat Until (Glob.IsOwnSideChecked == 0)
            {
                List.ReplaceItem(MovesIdx, 1, Operator.Random(1 , List.Length(Moves1)));
                Call ApplyMove(1);
                Call CalcBoardAttackedByMove(2);
                Call RevertMove(1);
            }
            Ret.GetBestMoveEasy.Move = Moves1[MovesIdx[1]];
        }
    }
}

Define GetBestMoveMedDiff (warp=false)
{
    Call GetBestMoveMedDiff.Prepare;
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveMedDiff.Iteration;
        If (Not ((Glob.IsDCI == 1)))
        {
            If (Not ((Glob.BestMove == Const.Null)))
            {
                Call OnEvaluationChanged(Glob.BestMoveEval);
                Call OnBestMoveChanged(Glob.BestMove);
            }
            Get.BMMD.Now = (Sensing.DaysSince2000() * 86400);
            If (Get.BMMD.Now > (Glob.PrevProgressUpdate + 1))
            {
                Call OnProgressChanged((((Get.BMMD.Now - Glob.ThinkTimeStart) / Glob.ThinkTimeLimitSearch) * 100));
                Glob.PrevProgressUpdate = Get.BMMD.Now;
            }
        }
    }
    Ret.GetBestMoveMedDiff.Move = Glob.DeepeningBestMove;
}

Define GetBestMoveMedDiff.Iteration (warp=true)
{
    If (((Glob.IdxDeepening > 4) And (1 == 1)) And ((Not ((Glob.BestMoveEval == Const.Null))) And (abs(Glob.BestMoveEval) < Const.AbsMinCheckmateEval)))
    {
        Get.BMMDI.AspirationDelta = Operator.Round((28 + ((abs(Glob.BestMoveEval) * abs(Glob.BestMoveEval)) / 1651)));
        Get.BMMDI.AspirationAlpha = Operator.Round((Glob.BestMoveEval - Get.BMMDI.AspirationDelta));
        Get.BMMDI.AspirationBeta = Operator.Round((Glob.BestMoveEval + Get.BMMDI.AspirationDelta));
    }
    Else
    {
        Get.BMMDI.AspirationAlpha = -100000;
        Get.BMMDI.AspirationBeta = 100000;
    }
    Get.BMMDI.IsAspirationDone = 0;
    Repeat Until ((Get.BMMDI.IsAspirationDone == 1) Or (Glob.IsSearchTimeout == 1))
    {
        Glob.ThinkTimeLimitSearch = Glob.DeepeningThinkTimeLimit;
        Call Search(Get.BMMDI.AspirationAlpha)(Get.BMMDI.AspirationBeta)(Glob.IdxDeepening)(1)((Glob.IdxDeepening == 1));
        Get.BMMDI.SearchEval = Ret.Search.Eval;
        If ((Not ((Ret.Search.Move == Const.Null))) And (Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha))
        {
            If ((Glob.DeepeningBestMove == Const.Null) Or List.ContainsItem(SearchPly1EvalMoves, Glob.DeepeningBestMove))
            {
                Glob.DeepeningBestMove = Ret.Search.Move;
                Glob.BestMove = Glob.DeepeningBestMove;
                Glob.BestMoveEval = Get.BMMDI.SearchEval;
            }
        }
        Call Log(Glob.IdxDeepening)(" : AW : ")(Get.BMMDI.AspirationAlpha)(" : ")(Get.BMMDI.AspirationBeta)(" : ")(Get.BMMDI.SearchEval)(Operator.Join(" : ", ((Not ((Get.BMMDI.SearchEval == Const.Null))) And ((Not ((Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha))) Or (Not ((Get.BMMDI.SearchEval < Get.BMMDI.AspirationBeta)))))));
        If ((Glob.IsSearchTimeout == 0) And ((Not ((Get.BMMDI.SearchEval == Const.Null))) And ((Not ((Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha))) Or (Not ((Get.BMMDI.SearchEval < Get.BMMDI.AspirationBeta))))))
        {
            Glob.IsSearchTimeout = 0;
            Get.BMMDI.AspirationDelta = Operator.Round((Get.BMMDI.AspirationDelta * 1.5));
            If ((Get.BMMDI.AspirationDelta < 206) And (abs(Get.BMMDI.SearchEval) < Const.AbsMinCheckmateEval))
            {
                If (Not ((Get.BMMDI.SearchEval > Get.BMMDI.AspirationAlpha)))
                {
                    If (1 == 1)
                    {
                        Get.BMMDI.AspirationBeta = Operator.Round(((Get.BMMDI.AspirationAlpha + Get.BMMDI.AspirationBeta) / 2));
                    }
                    Get.BMMDI.AspirationAlpha = Operator.Round((Get.BMMDI.SearchEval - Get.BMMDI.AspirationDelta));
                }
                Else
                {
                    Get.BMMDI.AspirationBeta = Operator.Round((Get.BMMDI.SearchEval + Get.BMMDI.AspirationDelta));
                }
            }
            Else
            {
                Get.BMMDI.AspirationAlpha = -100000;
                Get.BMMDI.AspirationBeta = 100000;
            }
        }
        Else
        {
            Get.BMMDI.IsAspirationDone = 1;
        }
    }
    If ((((Glob.IsSearchTimeout == 1) Or (Glob.IdxDeepening == Glob.DeepeningMaxSearchPly)) Or ((Not ((Glob.BestMoveEval == Const.Null))) And (abs(Glob.BestMoveEval) > (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + Glob.IdxDeepening))))) Or ((Glob.CustomMaxDepth > 0) And (Not ((Glob.IdxDeepening < Glob.CustomMaxDepth)))))
    {
        Glob.IsDeepeningDone = 1;
    }
    Else
    {
        Glob.IdxDeepening += 1;
    }
}

Define GetBestMoveMedDiff.Prepare (warp=true)
{
    Glob.DeepeningMaxSearchPly = (Const.MaxPlyStackFrames - 30);
    If (Glob.Level == 5)
    {
        Glob.DeepeningThinkTimeLimit = 15;
    }
    Else
    {
        If (Glob.IsEndgame == 0)
        {
            Glob.DeepeningThinkTimeLimit = 25;
        }
        Else
        {
            If (Glob.IsLateEndgame == 0)
            {
                Glob.DeepeningThinkTimeLimit = 20;
            }
            Else
            {
                Glob.DeepeningThinkTimeLimit = 15;
            }
        }
    }
    If (Glob.CustomThinkTime > 0)
    {
        Glob.DeepeningThinkTimeLimit = Glob.CustomThinkTime;
    }
    Glob.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Glob.IsSearchTimeout = 0;
    Glob.IsDeepeningDone = 0;
    Glob.IdxDeepening = 1;
    Glob.DeepeningBestMove = Const.Null;
    Glob.BestMove = Glob.DeepeningBestMove;
    Glob.BestMoveEval = Const.Null;
}

