    }
    If ((Glob.IsSearchTimeout == 0) And (ExcludedMove == Const.Null))
    {
        If (PickedLegalMovesCount[Ply] == 0)
        {
            If (CheckedState[Ply] == 1)
            {
                If (((Not (Quiescence)) And (ExcludedMove == Const.Null)) Or Quiescence)
                {
                    Call Comment("Fast search checkmate detection (no check evasion found)");
                    List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
                    List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
                }
            }
            Else
            {
                Call Comment("Fast full search checkmate and stalemate detection");
                If ((Not (Quiescence)) And (ExcludedMove == Const.Null))
                {
                    List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
                    Call CalcBoardAttackedByMoveChecked((Ply + 1));
                    If (((PlyIsOwn[Ply] == 1) And (Glob.IsOwnSideChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsOppSideChecked == 1)))
                    {
                        List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
                    }
                    Else
                    {
                        List.ReplaceItem(SearchEval, Ply, 0);
                    }
                }
            }
        }
        If ((Not (Quiescence)) And (Not ((BestMoves[Ply] == Const.Null))))
        {
            Call StoreKillerMove(Ply)(Horizon)(BestMoves[Ply])((1 == 0))((1 == 0));
            If ((PickedPseudoLegalMovesCount[Ply] < MovesCount[Ply]) And (Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdxBestMove[Ply])] == BestMoves[Ply]))
            {
                Call StoreKillerMoveMalus(Ply)(Horizon)(MovesIdxBestMove[Ply]);
            }
        }
        If (((Glob.IsSearchTimeout == 0) And (Ply > 1)) And (ExcludedMove == Const.Null))
        {
            Call Comment("Store evaluations, hash moves, attack tables, check state, mobility, ... to transposition table");
            Search.Main.BestMoveStore = BestMoves[Ply];
            If (Search.Main.BestMoveStore == Const.Null)
            {
                Search.Main.BestMoveStore = Const.Null;
            }
            If Quiescence
            {
                Call IsQuiescentCheckCond(Ply);
                Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(SearchEval[Ply])(Search.Main.BestMoveStore)(ScoreTypes[Ply])(Const.Null)(-1)(Ret.IsQuiescentCheckCond.IsTrue)(NodeTTStaticEval[Ply]);
            }
            Else
            {
                If (Not ((StaticEval[Ply] == Const.Null)))
                {
                    Search.Main.CorrDelta = (SearchEval[Ply] - StaticEval[Ply]);
                    Search.Main.ImpVal = Search.Main.CorrDelta;
                    Search.Main.BM = BestMoves[Ply];
                    If ((CheckedState[Ply] == 0) And (((Search.Main.BM == Const.Null) And (Not ((Search.Main.ImpVal > 0)))) Or ((Not ((Search.Main.BM == Const.Null))) And (((floor((Search.Main.BM / 100)) == 0) Or (Board[floor((Search.Main.BM % 100))] == 0)) And (Search.Main.ImpVal > 0)))))
                    {
                        Call GetCorrHistIndices(Ply);
                        Search.Main.CorrBonus = ((Search.Main.CorrDelta * Horizon) / 4);
                        If (Search.Main.CorrBonus > 249)
                        {
                            Search.Main.CorrBonus = 249;
                        }
                        If (Search.Main.CorrBonus < -249)
                        {
                            Search.Main.CorrBonus = -249;
                        }
                        If (Not ((CorrHistKey[Ret.GetCorrHistIndices.CorrIdx] == Ret.GetCorrHistIndices.PawnKey)))
                        {
                            List.ReplaceItem(CorrHistVal, Ret.GetCorrHistIndices.CorrIdx, 0);
                            List.ReplaceItem(CorrHistKey, Ret.GetCorrHistIndices.CorrIdx, Ret.GetCorrHistIndices.PawnKey);
                        }
                        List.ReplaceItem(CorrHistVal, Ret.GetCorrHistIndices.CorrIdx, ((CorrHistVal[Ret.GetCorrHistIndices.CorrIdx] + Search.Main.CorrBonus) - floor(((CorrHistVal[Ret.GetCorrHistIndices.CorrIdx] * abs(Search.Main.CorrBonus)) / 1024))));
                        If (Not ((CorrHistNPKey[Ret.GetCorrHistIndices.NPIdx] == Ret.GetCorrHistIndices.NPKey)))
                        {
                            List.ReplaceItem(CorrHistNP, Ret.GetCorrHistIndices.NPIdx, 0);
                            List.ReplaceItem(CorrHistNPKey, Ret.GetCorrHistIndices.NPIdx, Ret.GetCorrHistIndices.NPKey);
                        }
                        List.ReplaceItem(CorrHistNP, Ret.GetCorrHistIndices.NPIdx, ((CorrHistNP[Ret.GetCorrHistIndices.NPIdx] + Search.Main.CorrBonus) - floor(((CorrHistNP[Ret.GetCorrHistIndices.NPIdx] * abs(Search.Main.CorrBonus)) / 1024))));
                    }
                }
                Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(SearchEval[Ply])(Search.Main.BestMoveStore)(ScoreTypes[Ply])(Const.Null)(Horizon)(Const.Null)(NodeTTStaticEval[Ply]);
            }
        }
        If (MovesIdxBestMove[Ply] > 0)
        {
            If Quiescence
            {
                Glob.ProfBestMoveCountQ += 1;
                Glob.ProfBestMoveIdxSumQ += MovesIdxBestMove[Ply];
            }
            Else
            {
                Glob.ProfBestMoveCount += 1;
                Glob.ProfBestMoveIdxSum += MovesIdxBestMove[Ply];
            }
            If ((Quiescence And (MovesIdxBestMove[Ply] > 1)) Or ((Not (Quiescence)) And (MovesIdxBestMove[Ply] > 2)))
            {
                If (Glob.ProfilerMode == 2)
                {
                    Call ExportBoardFEN((Glob.IsPlayerBlack == 1))((PlyIsOwn[Ply] == 0));
                    Search.Main.FEN = Ret.ExportBoardFEN.FEN;
                    Call GetMoveNotation(BestMoves[Ply]);
                    Search.Main.MOBestNotation = Ret.GetMoveNotation.Notation;
                    Call GetMoveNotation(Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + 1)]);
                    Search.Main.MOTopNotation = Ret.GetMoveNotation.Notation;
                    Call Log("MoveOrd warning:")(Operator.Join(Operator.Join(Operator.Join(" idx=", MovesIdxBestMove[Ply]), "/"), MovesCount[Ply]))(Operator.Join(" horizon=", Horizon))(Operator.Join(" ply=", Ply))(Operator.Join(Operator.Join(" ", Operator.LetterOf("FQ", (1 + Quiescence))), Operator.Join(" checked=", CheckedState[Ply])))(Operator.Join(Operator.Join(Operator.Join(Operator.Join(" ranked_best=", Search.Main.MOTopNotation), "("), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + 1)]), ")"))(Operator.Join(Operator.Join(Operator.Join(Operator.Join(" eval_best=", Search.Main.MOBestNotation), "("), MovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdxBestMove[Ply])]), ")"))(Operator.Join(" fen=", Search.Main.FEN));
                }
            }
        }
    }
    Call Comment("Collect statistics");
    If Quiescence
    {
        Glob.MoveCountQ += MovesCount[Ply];
    }
    Else
    {
        Glob.MoveCount += MovesCount[Ply];
    }
}

Define Search_NextPly(string Alpha)(string Beta)(string Horizon)(string Reduction)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    Search.NP.NextHorizon = (((Horizon + PlyExtension[Ply]) - Reduction) - 1);
    If (Search.NP.NextHorizon < 0)
    {
        Search.NP.NextHorizon = 0;
    }
    Call Search_Main(Alpha)(Beta)(Search.NP.NextHorizon)((Ply + 1))(Cutnode)((Quiescence Or (Search.NP.NextHorizon < 1)))(ExcludedMove);
}

Define Search_Pruning(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (((Not (Quiescence)) And ((Betas[Ply] - Alphas[Ply]) == 1)) And ((CheckedState[Ply] == 0) And (ExcludedMove == Const.Null)))
    {
        If (Horizon < 5)
        {
            Call Comment("Razoring");
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.Razoring_Inv)(Horizon)(Ply);
            }
            Call GetCalibratedEval(Ply);
            If (Not ((Ret.GetCalibratedEval.Score == Const.Null)))
            {
                If ((Ret.GetCalibratedEval.Score + (21 + (150 * Horizon))) < Alphas[Ply])
                {
                    Glob.IsInNullMove += 1;
                    If (Glob.ProfilerMode == 2)
                    {
                        Call Profile_CountByHorizon(Const.Profile.Razoring_Try)(Horizon)(Ply);
                    }
                    Call ClearMoveList(Ply);
                    Call AddMoveToList(0)(Ply)(0);
                    List.ReplaceItem(MovesIdx, Ply, 1);
                    Call ApplyMove(Ply);
                    Call SkipSearchFrameEnter((Ply + 1))((1 == 0));
                    Call Search_Main(Alphas[Ply])(Betas[Ply])(0)((Ply + 2))((1 == 1))((1 == 1))(Const.Null);
                    Call SkipSearchFrameExit((Ply + 1));
                    Call RevertMove(Ply);
                    Glob.IsInNullMove += -1;
                    If (Not ((SearchEval[(Ply + 2)] == Const.Null)))
                    {
                        If (Not ((abs(SearchEval[(Ply + 2)]) == abs(Const.DrawByRepetitionEval))))
                        {
                            If (SearchEval[(Ply + 2)] < Alphas[Ply])
                            {
                                List.ReplaceItem(SearchEval, Ply, SearchEval[(Ply + 2)]);
                                If (Glob.ProfilerMode == 2)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.Razoring_Hit)(Horizon)(Ply);
                                }
                                Stop(this script);
                            }
                        }
                    }
                }
            }
        }
        If (1 == 1)
        {
            Call Comment("Reverse futility pruning");
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.RFP_Inv)(Horizon)(Ply);
            }
            If (Horizon < 8)
            {
                If (abs(Betas[Ply]) < Const.AbsMinCheckmateEval)
                {
                    Call GetImproving(Ply);
                    Search.Pruning.IsImproving = Ret.GetImproving.IsImproving;
                    Search.Pruning.Margin = ((79 * Horizon) - (138 * (Search.Pruning.IsImproving == 1)));
                    If (Search.Pruning.Margin < 15)
                    {
                        Search.Pruning.Margin = 15;
                    }
                    Call GetCalibratedEval(Ply);
                    If (Not ((Ret.GetCalibratedEval.Score == Const.Null)))
                    {
                        If (Not (((Ret.GetCalibratedEval.Score - Search.Pruning.Margin) < Betas[Ply])))
                        {
                            List.ReplaceItem(SearchEval, Ply, Ret.GetCalibratedEval.Score);
                            If (Glob.ProfilerMode == 2)
                            {
                                Call Profile_CountByHorizon(Const.Profile.RFP_Hit)(Horizon)(Ply);
                            }
                            Stop(this script);
                        }
                    }
                }
            }
        }
        Call Comment("Null move pruning");
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_CountByHorizon(Const.Profile.NMP_Inv)(Horizon)(Ply);
        }
        Call GetCalibratedEval(Ply);
        Search.Pruning.Eval = Ret.GetCalibratedEval.Score;
        If (Not ((Search.Pruning.Eval == Const.Null)))
        {
            If ((Horizon > 2) And (Not ((AppliedMove[(Ply - 1)] == 0))))
            {
                If (Not ((Search.Pruning.Eval < Betas[Ply])))
                {
                    If (Not ((Search.Pruning.Eval < StaticEval[Ply])))
                    {
                        If (((PlyIsOwn[Ply] == 1) And ((Glob.OwnQueenCountLocal + Glob.OwnNonQueenMajorMinorCountLocal) > 0)) Or ((PlyIsOwn[Ply] == 0) And ((Glob.OppQueenCountLocal + Glob.OppNonQueenMajorMinorCountLocal) > 0)))
                        {
                            Search.Pruning.EvalDiff = (Search.Pruning.Eval - Betas[Ply]);
                            If (Search.Pruning.EvalDiff > 0)
                            {
                                Glob.IsInNullMove += 1;
                                If (Glob.ProfilerMode == 2)
                                {
                                    Call Profile_CountByHorizon(Const.Profile.NMP_Try)(Horizon)(Ply);
                                }
                                If (Search.Pruning.EvalDiff > 535)
                                {
                                    Search.Pruning.EvalDiff = 535;
                                }
                                Search.Pruning.Reduction = ((4 + floor((Horizon / 3))) + floor((Search.Pruning.EvalDiff / 107)));
                                Call ClearMoveList(Ply);
                                Call AddMoveToList(0)(Ply)(0);
                                List.ReplaceItem(MovesIdx, Ply, 1);
                                Call ApplyMove(Ply);
                                Call Search_NextPly((0 - Betas[Ply]))((0 - (Betas[Ply] - 1)))(Horizon)(Search.Pruning.Reduction)(Ply)((Not (Cutnode)))(Quiescence)(Const.Null);
                                Call RevertMove(Ply);
                                If (Not ((SearchEval[(Ply + 1)] == Const.Null)))
                                {
                                    If (Not ((abs((0 - SearchEval[(Ply + 1)])) > Const.AbsMinCheckmateEval)))
                                    {
                                        If (Not ((abs(SearchEval[(Ply + 1)]) == abs(Const.DrawByRepetitionEval))))
                                        {
                                            If (Not (((0 - SearchEval[(Ply + 1)]) < Betas[Ply])))
                                            {
                                                List.ReplaceItem(SearchEval, Ply, (0 - SearchEval[(Ply + 1)]));
                                                If (Glob.ProfilerMode == 2)
                                                {
                                                    Call Profile_CountByHorizon(Const.Profile.NMP_Hit)(Horizon)(Ply);
                                                }
                                                Glob.IsInNullMove += -1;
                                                Stop(this script);
                                            }
                                        }
                                    }
                                }
                                Glob.IsInNullMove += -1;
                            }
                        }
                    }
                }
            }
        }
        Call Comment("Probcut");
        If (1 == 0)
        {
            If ((Init.Search.IsInProbeCut == 0) And ((Horizon > 4) And ((Betas[Ply] - Alphas[Ply]) == 1)))
            {
                If (abs(Betas[Ply]) < Const.AbsMinCheckmateEval)
                {
                    If (Not ((StaticEval[Ply] == Const.Null)))
                    {
                        Init.Search.IsInProbeCut = 1;
                        Call GetImproving(Ply);
                        Search.Pruning.IsImproving = Ret.GetImproving.IsImproving;
                        If (Search.Pruning.IsImproving == Const.Null)
                        {
                            Search.Pruning.IsImproving = 0;
                        }
                        Search.Pruning.Margin = (122 - (Search.Pruning.IsImproving * 44));
                        Search.Pruning.RaisedAlphaBeta = (Betas[Ply] + Search.Pruning.Margin);
                        Search.Pruning.SEEThreshold = (Search.Pruning.RaisedAlphaBeta - StaticEval[Ply]);
                        Call TTProbeNode(Glob.CurrentBoardHash)(Ply);
                        If (Not ((((Ret.TTProbeNode.Hit == 1) And (Not ((Ret.TTProbeNode.Score == Const.Null)))) And (Ret.TTProbeNode.Score < Search.Pruning.RaisedAlphaBeta))))
                        {
                            Search.Pruning.Count = 0;
                            Call PrepareCheckInfo(Ply);
                            List.ReplaceItem(PickPhase, Ply, 1);
                            List.ReplaceItem(PickMoveRes, Ply, 1);
                            List.ReplaceItem(PickedPseudoLegalMovesCount, Ply, 0);
                            Repeat Until ((PickMoveRes[Ply] == 0) Or (Search.Pruning.Count > (1 + (2 * Cutnode))))
                            {
                                Call PickMove(Ply)((1 == 1));
                                If (PickMoveRes[Ply] == 1)
                                {
                                    If (Not ((AppliedMove[Ply] == ExcludedMove)))
                                    {
                                        Call SEE(Ply)((1 == 0));
                                        If (Not ((Ret.SEE.Gain < Search.Pruning.SEEThreshold)))
                                        {
                                            Search.Pruning.Count += 1;
                                            Call Search_Main((0 - (Search.Pruning.RaisedAlphaBeta + 0)))((0 - (Search.Pruning.RaisedAlphaBeta - 1)))(0)((Ply + 1))((1 == 1))((1 == 1))(Const.Null);
                                            Search.Pruning.Score = SearchEval[(Ply + 1)];
                                            If (Not ((Search.Pruning.Score == Const.Null)))
                                            {
                                                Search.Pruning.Score = (0 - Search.Pruning.Score);
                                            }
                                            If (Not ((Search.Pruning.Score < Search.Pruning.RaisedAlphaBeta)))
                                            {
                                                Call Search_NextPly((0 - (Search.Pruning.RaisedAlphaBeta + 0)))((0 - (Search.Pruning.RaisedAlphaBeta - 1)))(Horizon)((2 + (2 * Search.Pruning.IsImproving)))(Ply)((Not (Cutnode)))(Quiescence)(Const.Null);
                                                Search.Pruning.Score = SearchEval[(Ply + 1)];
                                                If (Not ((Search.Pruning.Score == Const.Null)))
                                                {
                                                    Search.Pruning.Score = (0 - Search.Pruning.Score);
                                                }
                                                If ((abs(Search.Pruning.Score) < Const.AbsMinCheckmateEval) And (Not ((abs(Search.Pruning.Score) == abs(Const.DrawByRepetitionEval)))))
                                                {
                                                    If (Not ((Search.Pruning.Score < Search.Pruning.RaisedAlphaBeta)))
                                                    {
                                                        List.ReplaceItem(SearchEval, Ply, (Search.Pruning.Score - Search.Pruning.Margin));
                                                        Call RevertMove(Ply);
                                                        Search.Pruning.NodeType = "B";
                                                        If (1 == 1)
                                                        {
                                                            Call TTStoreNode(Glob.CurrentBoardHash)(Ply)(SearchEval[Ply])(AppliedMove[Ply])(Search.Pruning.NodeType)(Const.Null)((Horizon - (2 + (2 * Search.Pruning.IsImproving))))(Const.Null)(NodeTTStaticEval[Ply]);
                                                        }
                                                        Init.Search.IsInProbeCut = 0;
                                                        Stop(this script);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Call RevertMove(Ply);
                                }
                            }
                        }
                        Init.Search.IsInProbeCut = 0;
                    }
                }
            }
        }
    }
}

Define Search_SearchCore(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    Ret.Search_SearchCore.NodeEval = Const.Null;
    Call Comment("Late move reduction preparation");
    Search.SC.IsReductionAndDone = 0;
    If ((Not (Quiescence)) And (Glob.IsSearchTimeout == 0))
    {
        Call Search_ComputeReduction(Horizon)(Ply)(Cutnode);
        Search.SC.Reduction = Ret.Search_ComputeReduction.Reduction;
        Call Comment("Late move reduction");
        If (Search.SC.Reduction > 0)
        {
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.LMR_Inv)(Horizon)(Ply);
            }
            Call Search_NextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(Search.SC.Reduction)(Ply)((1 == 1))(Quiescence)(Const.Null);
            Ret.Search_SearchCore.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_SearchCore.NodeEval == Const.Null)))
            {
                Ret.Search_SearchCore.NodeEval = (0 - Ret.Search_SearchCore.NodeEval);
            }
            Search.SC.IsReductionAndDone = 1;
            List.ReplaceItem(LMRState, Ply, 1);
            If (Not ((Ret.Search_SearchCore.NodeEval > Alphas[Ply])))
            {
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.LMR_Hit)(Horizon)(Ply);
                }
            }
        }
        Call Comment("Non-PV search");
        If ((((Search.SC.IsReductionAndDone == 1) And (Ret.Search_SearchCore.NodeEval > Alphas[Ply])) Or ((Search.SC.IsReductionAndDone == 0) And ((PickedLegalMovesCount[Ply] > 1) Or ((Betas[Ply] - Alphas[Ply]) == 1)))) And (Glob.IsSearchTimeout == 0))
        {
            If (Glob.ProfilerMode == 2)
            {
                If ((Betas[Ply] - Alphas[Ply]) > 1)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVS_Inv)(Horizon)(Ply);
                }
            }
            Call Search_NextPly((0 - (Alphas[Ply] + 1)))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((Not (Cutnode)))(Quiescence)(Const.Null);
            Ret.Search_SearchCore.NodeEval = SearchEval[(Ply + 1)];
            If (Not ((Ret.Search_SearchCore.NodeEval == Const.Null)))
            {
                Ret.Search_SearchCore.NodeEval = (0 - Ret.Search_SearchCore.NodeEval);
            }
            If (((Ret.Search_SearchCore.NodeEval > Alphas[Ply]) And (Ret.Search_SearchCore.NodeEval < Betas[Ply])) And ((Betas[Ply] - Alphas[Ply]) > 1))
            {
                Search.SC.IsReductionAndDone = 0;
                If (Glob.ProfilerMode == 2)
                {
                    Call Profile_CountByHorizon(Const.Profile.PVS_ReSearch)(Horizon)(Ply);
                }
            }
            Else
            {
                Search.SC.IsReductionAndDone = 1;
            }
        }
    }
    Call Comment("Move was not pruned upfront, enter standard search");
    If ((Search.SC.IsReductionAndDone == 0) And (Glob.IsSearchTimeout == 0))
    {
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_CountByHorizon(Const.Profile.Full_Inv)(Horizon)(Ply);
        }
        Call Search_NextPly((0 - Betas[Ply]))((0 - Alphas[Ply]))(Horizon)(0)(Ply)((1 == 0))(Quiescence)(Const.Null);
        Ret.Search_SearchCore.NodeEval = SearchEval[(Ply + 1)];
        If (Not ((Ret.Search_SearchCore.NodeEval == Const.Null)))
        {
            Ret.Search_SearchCore.NodeEval = (0 - Ret.Search_SearchCore.NodeEval);
        }
        If (LMRState[Ply] == 1)
        {
            If (Ret.Search_SearchCore.NodeEval > Alphas[Ply])
            {
                List.ReplaceItem(LMRState, Ply, 2);
            }
            Else
            {
                List.ReplaceItem(LMRState, Ply, 3);
            }
        }
    }
}

Define SEE(string MovePly)(bool WithPinFilter) (warp=true)
{
    SEE.Ply = MovePly;
    SEE.TargetIdx = floor((AppliedMove[SEE.Ply] % 100));
    If ((abs(SourcePieces[SEE.Ply]) == GoK_OwnPawn) And ((IdxToRank[SEE.TargetIdx] == 1) Or (IdxToRank[SEE.TargetIdx] == 8)))
    {
        Ret.SEE.Gain = 0;
        Stop(this script);
    }
    List.DeleteAll(SEE.TmpList3);
    List.DeleteAll(SEE.TmpList4);
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesMoveList))
    {
        List.Add(SEE.TmpList3, CalcMovesMoveList[(SEE.Idx + 0)]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(CalcMovesScoreList))
    {
        List.Add(SEE.TmpList4, CalcMovesScoreList[(SEE.Idx + 0)]);
        SEE.Idx += 1;
    }
    If (PlyIsOwn[MovePly] == 1)
    {
        SEE.Side = 2;
    }
    Else
    {
        SEE.Side = 1;
    }
    SEE.IsDone = 0;
    Repeat Until (SEE.IsDone == 1)
    {
        List.DeleteAll(CalcMovesMoveList);
        List.DeleteAll(CalcMovesScoreList);
        SEE.SourceIdx = 1;
        If WithPinFilter
        {
            SEE.Pin.QIdx = floor(PieceIdxLookup[GoK_OwnQueen]);
        }
        Repeat (64)
        {
            SEE.SourcePiece = floor(Board[(SEE.SourceIdx + 0)]);
            If (((SEE.Side == 1) And (SEE.SourcePiece > 0)) Or ((SEE.Side == 2) And (SEE.SourcePiece < 0)))
            {
                If ((Not ((abs(SEE.SourcePiece) == GoK_OwnPawn))) Or (Not (((IdxToFile[(SEE.SourceIdx + 0)] + 0) == (IdxToFile[SEE.TargetIdx] + 0)))))
                {
                    Call IsReachableForAttack(SEE.SourcePiece)(SEE.SourceIdx)(SEE.TargetIdx);
                    If (Ret.IsReachableForAttack.IsReachable == 1)
                    {
                        SEE.Pin.IsPinned = 0;
                        If WithPinFilter
                        {
                            SEE.Pin.AttackerPiece = SEE.SourcePiece;
                            If (SEE.Pin.AttackerPiece > 0)
                            {
                                SEE.Pin.King = Glob.OwnKingIdx;
                            }
                            Else
                            {
                                SEE.Pin.King = Glob.OppKingIdx;
                            }
                            SEE.Pin.Idx = (((SEE.Pin.QIdx * 10000) + (SEE.SourceIdx * 100)) + SEE.Pin.King);
                            Call IsLegalGeom(SEE.Pin.QIdx)(SEE.SourceIdx)(SEE.Pin.King)((0 + (SEE.Pin.AttackerPiece < 0)));
                            If (Ret.IsLegalGeom.IsLegal == 1)
                            {
                                SEE.Pin.Move = ((SEE.Pin.King * 100) + SEE.SourceIdx);
                                SEE.Pin.RayStep = MovePathStepInc[SEE.Pin.Move];
                                SEE.Pin.Walk = SEE.Pin.King;
                                SEE.Pin.PathClear = 1;
                                Repeat ((MovePathDelta[SEE.Pin.Move] - 1))
                                {
                                    SEE.Pin.Walk += SEE.Pin.RayStep;
                                    SEE.Pin.PathClear = (SEE.Pin.PathClear * (floor(Board[SEE.Pin.Walk]) == 0));
                                }
                                If (SEE.Pin.PathClear == 1)
                                {
                                    List.ReplaceItem(Board, SEE.SourceIdx, 0);
                                    SEE.Pin.Walk = (SEE.SourceIdx + SEE.Pin.RayStep);
                                    SEE.Pin.Idx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                    Call IsLegalGeom(SEE.Pin.QIdx)(SEE.Pin.Walk)(SEE.Pin.King)((0 + (SEE.Pin.AttackerPiece < 0)));
                                    SEE.Pin.OnLine = (0 + ((SEE.Pin.Walk > 0) And ((SEE.Pin.Walk < 65) And (Ret.IsLegalGeom.IsLegal == 1))));
                                    If (SEE.Pin.OnLine == 1)
                                    {
                                        SEE.Pin.BlockerPiece = floor(Board[SEE.Pin.Walk]);
                                    }
                                    Else
                                    {
                                        SEE.Pin.BlockerPiece = 0;
                                    }
                                    Repeat Until ((Not ((SEE.Pin.OnLine == 1))) Or (Not ((SEE.Pin.BlockerPiece == 0))))
                                    {
                                        SEE.Pin.Walk += SEE.Pin.RayStep;
                                        SEE.Pin.Idx = (((SEE.Pin.QIdx * 10000) + (SEE.Pin.Walk * 100)) + SEE.Pin.King);
                                        Call IsLegalGeom(SEE.Pin.QIdx)(SEE.Pin.Walk)(SEE.Pin.King)((0 + (SEE.Pin.AttackerPiece < 0)));
                                        SEE.Pin.OnLine = (0 + ((SEE.Pin.Walk > 0) And ((SEE.Pin.Walk < 65) And (Ret.IsLegalGeom.IsLegal == 1))));
                                        If (SEE.Pin.OnLine == 1)
                                        {
                                            SEE.Pin.BlockerPiece = floor(Board[SEE.Pin.Walk]);
                                        }
                                        Else
                                        {
                                            SEE.Pin.BlockerPiece = 0;
                                        }
                                    }
                                    If (((SEE.Pin.OnLine == 1) And ((SEE.Pin.AttackerPiece * SEE.Pin.BlockerPiece) < 0)) And (Not ((SEE.Pin.Walk == SEE.TargetIdx))))
                                    {
                                        Call IsCheckingPiece(SEE.Pin.Walk);
                                        If (Ret.IsCheckingPiece.IsChecking == 1)
                                        {
                                            SEE.Pin.IsPinned = 1;
                                        }
                                    }
                                    List.ReplaceItem(Board, SEE.SourceIdx, SEE.Pin.AttackerPiece);
                                }
                            }
                        }
                        If (SEE.Pin.IsPinned == 0)
                        {
                            List.Add(CalcMovesMoveList, SEE.SourceIdx);
                            List.Add(CalcMovesScoreList, (0 - abs(SEE.SourcePiece)));
                        }
                    }
                }
            }
            SEE.SourceIdx += 1;
        }
        If (List.Length(CalcMovesMoveList) == 0)
        {
            SEE.IsDone = 1;
        }
        Else
        {
            If ((Const.MaxPlyStackFrames % 2) == 1)
            {
                Call SortMoveList(((Const.MaxPlyStackFrames + 1) - SEE.Side));
            }
            Else
            {
                Call SortMoveList((Const.MaxPlyStackFrames - SEE.Side));
            }
            SEE.SourceIdx = CalcMovesMoveList[1];
            SEE.SourcePiece = floor(Board[(SEE.SourceIdx + 0)]);
            SEE.Move = ((SEE.SourceIdx * 100) + SEE.TargetIdx);
            SEE.Ply += 1;
            Call ClearMoveList(SEE.Ply);
            Call AddMoveToList(SEE.Move)(SEE.Ply)(0);
            List.ReplaceItem(MovesIdx, SEE.Ply, 1);
            Call ApplyMoveLight(SEE.Ply);
            If (abs(TargetPieces[SEE.Ply]) == GoK_OwnKing)
            {
                SEE.IsDone = 1;
            }
            Glob.MoveCountQ += 1;
            Glob.NodeCountQ += 1;
            If (SEE.Side == 1)
            {
                SEE.Side = 2;
            }
            Else
            {
                SEE.Side = 1;
            }
        }
    }
    SEE.RunningGain = 0;
    Repeat Until (SEE.Ply == MovePly)
    {
        SEE.GainIfCapture = (abs(TargetPieces[SEE.Ply]) - SEE.RunningGain);
        If (SEE.GainIfCapture > 0)
        {
            SEE.RunningGain = SEE.GainIfCapture;
        }
        Else
        {
            SEE.RunningGain = 0;
        }
        Call RevertMoveLight(SEE.Ply);
        SEE.Ply += -1;
    }
    SEE.SwapValue = (abs(TargetPieces[MovePly]) - SEE.RunningGain);
    Ret.SEE.Gain = SEE.SwapValue;
    List.DeleteAll(CalcMovesMoveList);
    List.DeleteAll(CalcMovesScoreList);
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList3))
    {
        List.Add(CalcMovesMoveList, SEE.TmpList3[(SEE.Idx + 0)]);
        SEE.Idx += 1;
    }
    SEE.Idx = 1;
    Repeat (List.Length(SEE.TmpList4))
    {
        List.Add(CalcMovesScoreList, SEE.TmpList4[(SEE.Idx + 0)]);
        SEE.Idx += 1;
    }
}

Define SetCastlingStateFlag(string Ply)(string Offset)(string Val) (warp=true)
{
    Set.CSF.CastlingState = CastlingState[Ply];
    If (Not ((Operator.LetterOf(Set.CSF.CastlingState, Offset) == Val)))
    {
        Set.CSF.Idx = (((((Operator.LetterOf(Set.CSF.CastlingState, 1) * 128) + (Operator.LetterOf(Set.CSF.CastlingState, 2) * 64)) + ((Operator.LetterOf(Set.CSF.CastlingState, 3) * 32) + (Operator.LetterOf(Set.CSF.CastlingState, 4) * 16))) + (((Operator.LetterOf(Set.CSF.CastlingState, 5) * 8) + (Operator.LetterOf(Set.CSF.CastlingState, 6) * 4)) + ((Operator.LetterOf(Set.CSF.CastlingState, 7) * 2) + Operator.LetterOf(Set.CSF.CastlingState, 8)))) + 1);
        If (Val == 1)
        {
            List.ReplaceItem(CastlingState, Ply, CastlingStateLookup[(Set.CSF.Idx + CastlingStatePow2[(Offset + 0)])]);
        }
        Else
        {
            List.ReplaceItem(CastlingState, Ply, CastlingStateLookup[(Set.CSF.Idx - CastlingStatePow2[(Offset + 0)])]);
        }
    }
}

Define SetInitialEnPassantTarget(string Ply) (warp=true)
{
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    Call GetSubstringRight(Glob.GameMoves)(4);
    Set.IEPT.SourceIdx = floor((Ret.GetSubstringRight.Substring / 100));
    Set.IEPT.TargetIdx = floor((Ret.GetSubstringRight.Substring % 100));
    If (Set.IEPT.TargetIdx > 0)
    {
        If ((abs(Board[Set.IEPT.TargetIdx]) == GoK_OwnPawn) And (abs((Set.IEPT.TargetIdx - Set.IEPT.SourceIdx)) == 16))
        {
            List.ReplaceItem(EnPassantTarget, Ply, Set.IEPT.TargetIdx);
        }
    }
}

Define SkipSearchFrameEnter(string Ply)(bool Quiescence) (warp=true)
{
    Call Search_InitStack(Ply)(Quiescence);
    Call ClearMoveList(Ply);
    Call AddMoveToList(0)(Ply)(0);
    List.ReplaceItem(MovesIdx, Ply, 1);
    Call ApplyMove(Ply);
}

Define SkipSearchFrameExit(string Ply) (warp=true)
{
    Call RevertMove(Ply);
}

Define SortMoveList(string Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
    }
    If (Ply == 2)
    {
        List.DeleteAll(Moves2);
    }
    If (List.Length(CalcMovesMoveList) > 1)
    {
        Call QuickSort;
    }
    SML.SliceStart = ((Ply - 1) * Const.MaxMovesPerGeneration);
    SML.Idx = 1;
    Repeat (List.Length(CalcMovesMoveList))
    {
        List.ReplaceItem(Moves, (SML.SliceStart + SML.Idx), CalcMovesMoveList[(SML.Idx + 0)]);
        List.ReplaceItem(MovesScore, (SML.SliceStart + SML.Idx), CalcMovesScoreList[(SML.Idx + 0)]);
        If (Ply == 1)
        {
            List.Add(Moves1, CalcMovesMoveList[(SML.Idx + 0)]);
        }
        If (Ply == 2)
        {
            List.Add(Moves2, CalcMovesMoveList[(SML.Idx + 0)]);
        }
        SML.Idx += 1;
    }
    List.ReplaceItem(MovesCount, Ply, List.Length(CalcMovesMoveList));
}

Define StoreAttackInfo(string Ply)(string StorePly) (warp=true)
{
    If (PlyIsOwn[Ply] == 1)
    {
        If (PlyIsOwn[StorePly] == 0)
        {
            SAI.SqIdx = 1;
            SAI.SliceStart = (((StorePly - 1) * 100) + 1);
            Repeat (64)
            {
                List.ReplaceItem(PersistedBoardAttackedSnapshot, SAI.SliceStart, BoardAttacked[SAI.SqIdx]);
                List.ReplaceItem(PersistedBoardAttackerSnapshot, SAI.SliceStart, BoardAttackedPiece[SAI.SqIdx]);
                SAI.SqIdx += 1;
                SAI.SliceStart += 1;
            }
            List.ReplaceItem(CheckedState, StorePly, Glob.IsOppSideChecked);
            Call TTStoreNode(Glob.CurrentBoardHash)(StorePly)(Const.Null)(Const.Null)(Const.TTType.None)(CheckedState[StorePly])(Const.Null)(Const.Null)(Const.Null);
        }
    }
    Else
    {
        If (PlyIsOwn[StorePly] == 1)
        {
            SAI.SqIdx = 1;
            SAI.SliceStart = (((StorePly - 1) * 100) + 1);
            Repeat (64)
            {
                List.ReplaceItem(PersistedBoardAttackedSnapshot, SAI.SliceStart, BoardAttacked[(SAI.SqIdx + 64)]);
                List.ReplaceItem(PersistedBoardAttackerSnapshot, SAI.SliceStart, BoardAttackedPiece[(SAI.SqIdx + 64)]);
                SAI.SqIdx += 1;
                SAI.SliceStart += 1;
            }
            List.ReplaceItem(CheckedState, StorePly, Glob.IsOwnSideChecked);
            Call TTStoreNode(Glob.CurrentBoardHash)(StorePly)(Const.Null)(Const.Null)(Const.TTType.None)(CheckedState[StorePly])(Const.Null)(Const.Null)(Const.Null);
        }
    }
}

Define StoreKillerMove(string Ply)(string Horizon)(string Move)(bool Malus)(bool ContinuationOnly) (warp=true)
{
    SKM.HistoryBonusA = ((190 * Horizon) - 108);
    SKM.HistoryBonus = ((((SKM.HistoryBonusA + 1596) - abs((SKM.HistoryBonusA - 1596))) / 2) * (1 - (2 * Malus)));
    If (floor((Move / 100)) == 0)
    {
        If ((((Move == GoK_OwnKingsideCastling) Or (Move == GoK_OwnQueensideCastling)) Or (Move == GoK_OppKingsideCastling)) Or (Move == GoK_OppQueensideCastling))
        {
            If ((Move == 65) Or (Move == 66))
            {
                SKM.CastleFrom = VirtualBoard[5];
            }
            Else
            {
                SKM.CastleFrom = VirtualBoard[61];
            }
            If (Move == 65)
            {
                SKM.CastleTo = VirtualBoard[8];
            }
            Else
            {
                If (Move == 66)
                {
                    SKM.CastleTo = VirtualBoard[1];
                }
                Else
                {
                    If (Move == 67)
                    {
                        SKM.CastleTo = VirtualBoard[64];
                    }
                    Else
                    {
                        SKM.CastleTo = VirtualBoard[57];
                    }
                }
            }
            If (Not (ContinuationOnly))
            {
                SKM.HistoryMoveScoreIdx = (PlyHistOffset[Ply] + ((SKM.CastleFrom * 64) + SKM.CastleTo));
                List.ReplaceItem(HistoryMoveScores, SKM.HistoryMoveScoreIdx, (HistoryMoveScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor((HistoryMoveScores[SKM.HistoryMoveScoreIdx] * (abs(SKM.HistoryBonus) / 7183))))));
            }
            If ((Not (ContinuationOnly)) And (Not (Malus)))
            {
                SKM.KillerSlot = (((Ply - 1) * 2) + 1);
                If (Not ((KillerMoves[SKM.KillerSlot] == Move)))
                {
                    List.ReplaceItem(KillerMoves, (SKM.KillerSlot + 1), KillerMoves[SKM.KillerSlot]);
                    List.ReplaceItem(KillerMoves, SKM.KillerSlot, Move);
                }
                If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
    }
    If ((((floor((Move / 100)) == 0) Or (Board[floor((Move % 100))] == 0)) And (Move == floor(Move))) And (Not ((((floor((Move / 100)) > 0) And (abs(Board[floor((Move / 100))]) == GoK_OwnPawn)) And (Not ((IdxToFile[floor((Move / 100))] == IdxToFile[floor((Move % 100))])))))))
    {
        If (Not (ContinuationOnly))
        {
            SKM.KillerSlot = (((Ply - 1) * 2) + 1);
            If ((Not (Malus)) And (Not ((KillerMoves[SKM.KillerSlot] == Move))))
            {
                List.ReplaceItem(KillerMoves, (SKM.KillerSlot + 1), KillerMoves[SKM.KillerSlot]);
                List.ReplaceItem(KillerMoves, SKM.KillerSlot, Move);
            }
            If (Not ((floor((Move / 100)) == 0)))
            {
                SKM.HistoryMoveScoreIdx = (PlyHistOffset[Ply] + ((floor((Move / 100)) * 64) + floor((Move % 100))));
                List.ReplaceItem(HistoryMoveScores, SKM.HistoryMoveScoreIdx, (HistoryMoveScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor((HistoryMoveScores[SKM.HistoryMoveScoreIdx] * (abs(SKM.HistoryBonus) / 7183))))));
            }
            If (Not (Malus))
            {
                If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
                {
                    List.ReplaceItem(HistoryCounterMoves, (PlyCMOffset[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100)))), Move);
                }
            }
        }
        If (floor((Move / 100)) == 0)
        {
            SKM.KillerSlot = ((PieceIdxLookup[GoK_OwnKing] * 68) + SKM.CastleTo);
        }
        Else
        {
            SKM.KillerSlot = ((PieceIdxLookup[abs(Board[floor((Move / 100))])] * 68) + floor((Move % 100)));
        }
        SKM.HistoryMoveScoreIdx = -1;
        If ((Ply > 1) And (Not ((AppliedMove[(Ply - 1)] == 0))))
        {
            SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + SKM.KillerSlot);
        }
        If (Not ((SKM.HistoryMoveScoreIdx == -1)))
        {
            List.ReplaceItem(HistoryContinuation, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
        }
        If (Ply > 2)
        {
            If (Not ((AppliedMove[(Ply - 2)] == 0)))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation2, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation2[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation2[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
            }
            If (((Ply > 4) And (CheckedState[Ply] == 0)) And (Not ((AppliedMove[(Ply - 4)] == 0))))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation3, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation3[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + ((SKM.HistoryBonus / 1) - floor((HistoryContinuation3[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs((SKM.HistoryBonus / 1)) / 29952))))));
            }
            If (((Ply > 6) And (CheckedState[Ply] == 0)) And (Not ((AppliedMove[(Ply - 6)] == 0))))
            {
                SKM.HistoryMoveScoreIdx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + SKM.KillerSlot);
                List.ReplaceItem(HistoryContinuation4, (PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx), (HistoryContinuation4[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] + (SKM.HistoryBonus - floor((HistoryContinuation4[(PlyContOffset[Ply] + SKM.HistoryMoveScoreIdx)] * (abs(SKM.HistoryBonus) / 29952))))));
            }
        }
    }
    If ((Not ((floor((Move / 100)) == 0))) And (Not ((Board[floor((Move % 100))] == 0))))
    {
        SKM.HistoryMoveScoreIdx = (((PieceIdxLookup[abs(Board[floor((Move / 100))])] - 1) * 384) + (((PieceIdxLookup[abs(Board[floor((Move % 100))])] - 1) * 64) + floor((Move % 100))));
        List.ReplaceItem(HistoryCaptureScores, SKM.HistoryMoveScoreIdx, (HistoryCaptureScores[SKM.HistoryMoveScoreIdx] + (SKM.HistoryBonus - floor(((HistoryCaptureScores[SKM.HistoryMoveScoreIdx] * abs(SKM.HistoryBonus)) / 10692)))));
    }
}

Define StoreKillerMoveMalus(string Ply)(string Horizon)(string KillerMoveIdx) (warp=true)
{
    SKMM.Move = Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + KillerMoveIdx)];
    If ((floor((SKMM.Move / 100)) == 0) Or (Board[floor((SKMM.Move % 100))] == 0))
    {
        SKMM.MoveIdx = 1;
        Repeat ((KillerMoveIdx - 1))
        {
            Call StoreKillerMove(Ply)(Horizon)(Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + SKMM.MoveIdx)])((1 == 1))((1 == 0));
            SKMM.MoveIdx += 1;
        }
    }
}

Define TaperedEval.Add(string Mg)(string Eg)(string LogKey)(string LogSquare)(string LogSide)(string LogMove) (warp=true)
{
    TaperedEval.Mg += Mg;
    TaperedEval.Eg += Eg;
    If (Eval.DebugLog == 1)
    {
        Call LogPVEvalLine(LogKey)(Mg)(Eg)(LogSquare)(LogSide)(LogMove);
    }
}

Define TaperedEval.AddIdentical(string Val)(string LogKey)(string LogSquare)(string LogSide)(string LogMove) (warp=true)
{
    TaperedEval.Mg += Val;
    TaperedEval.Eg += Val;
    If (Eval.DebugLog == 1)
    {
        Call LogPVEvalLine(LogKey)(Val)(Val)(LogSquare)(LogSide)(LogMove);
    }
}

Define TaperedEval.GetPiecePos(string Piece)(string Idx) (warp=true)
{
    Ret.TaperedEval.GetPiecePos.Score = 0;
    TEGPPR.PieceSqKey = ((PieceIdxLookup[abs(Piece)] * 10000) + Idx);
    If (Piece > 0)
    {
        Call TaperedEval.GetScalar(MovePosLookupMg[TEGPPR.PieceSqKey])(MovePosLookupEg[TEGPPR.PieceSqKey])(TaperedEval.ScaleFactor)(TaperedEval.Phase);
        Ret.TaperedEval.GetPiecePos.Score = Ret.TaperedEval.GetScalar.Score;
    }
    Else
    {
        If (Piece < 0)
        {
            Call TaperedEval.GetScalar(MovePosLookupMg[(TEGPPR.PieceSqKey + 100000)])(MovePosLookupEg[(TEGPPR.PieceSqKey + 100000)])(TaperedEval.ScaleFactor)(TaperedEval.Phase);
            Ret.TaperedEval.GetPiecePos.Score = Ret.TaperedEval.GetScalar.Score;
        }
    }
}

Define TaperedEval.GetScalar(string Mg)(string Eg)(string ScaleFactor)(string ScalePhase) (warp=true)
{
    Ret.TaperedEval.GetScalar.Score = Operator.Round((((Mg * ScalePhase) + (Eg * ((128 - ScalePhase) * (ScaleFactor / 128)))) / 128));
}

Define TaperedEval.GetSum (warp=true)
{
    Call TaperedEval.GetScalar(TaperedEval.Mg)(TaperedEval.Eg)(TaperedEval.ScaleFactor)(TaperedEval.Phase);
    Ret.TaperedEval.GetSum.Score = Ret.TaperedEval.GetScalar.Score;
}

Define TaperedEval.Init (warp=true)
{
    TaperedEval.Eg = 0;
    TaperedEval.Mg = 0;
    TEI.OwnMaterial = ((Glob.OwnQueenCountLocal * 14) + ((Glob.OwnRookCountLocal * 6) + ((Glob.OwnNonQueenMajorMinorCountLocal - Glob.OwnRookCountLocal) * 3)));
    TEI.OppMaterial = ((Glob.OppQueenCountLocal * 14) + ((Glob.OppRookCountLocal * 6) + ((Glob.OppNonQueenMajorMinorCountLocal - Glob.OppRookCountLocal) * 3)));
    TEI.Material = (TEI.OppMaterial + TEI.OwnMaterial);
    If (TEI.Material > 76)
    {
        TEI.Material = 76;
    }
    If (TEI.Material < 8)
    {
        TEI.Material = 8;
    }
    TaperedEval.Phase = Operator.Round((((TEI.Material - 8) * 128) / (76 - 8)));
    TaperedEval.ScaleFactor = 128;
}

Define TestLog(string TestLogTxt0)(string TestLogTxt1)(string TestLogTxt2)(string TestLogTxt3)(string TestLogTxt4)(string TestLogTxt5)(string TestLogTxt6)(string TestLogTxt7) (warp=true)
{
    List.Add(Logfile, Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join(Operator.Join("", TestLogTxt0), TestLogTxt1), TestLogTxt2), TestLogTxt3), TestLogTxt4), TestLogTxt5), TestLogTxt6), TestLogTxt7));
}

Define TestPad(string TestPadText)(string TestPadWidth) (warp=true)
{
    Ret.TestPad.PaddedText = TestPadText;
    Repeat Until (Not ((Variable.Length(Ret.TestPad.PaddedText) < TestPadWidth)))
    {
        Ret.TestPad.PaddedText = Operator.Join(Ret.TestPad.PaddedText, " ");
    }
}

Define TestPerft(string TestPerftPly) (warp=false)
{
    If (Not ((TestPerftPly > 0)))
    {
        Stop(this script);
    }
    Glob.IsTestRunning = 1;
    Glob.IsDCI = 1;
    Call InitTestSuite;
    TST.Passed = 0;
    Glob.PerftCheckMismatches = 0;
    TST.SearchCount = (List.Length(PerftSuiteFens) * TestPerftPly);
    Call TestLog("=== perft core vs staged movegen, depth 1 to ")(TestPerftPly)("")("")("")("")("")("");
    TST.Row = "";
    Call TestPad("Perft")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Core")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Staged")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    TST.Row = Operator.Join(TST.Row, "FEN");
    Call TestLog(TST.Row)("")("")("")("")("")("")("");
    TST.PosIdx = 1;
    Repeat (List.Length(PerftSuiteFens))
    {
        _dci fen = PerftSuiteFens[TST.PosIdx];
        _dci think time = 1;
        Call $gok_prepare;
        Call GetBestMoveMedDiff;
        TST.HorizonIdx = 1;
        Repeat (TestPerftPly)
        {
            Glob.PerftNodes = 0;
            Call Perft(1)(TST.HorizonIdx)(0);
            TST.Perft.CoreNodes = Glob.PerftNodes;
            Glob.PerftNodes = 0;
            Call Perft(1)(TST.HorizonIdx)(1);
            If ((TST.Perft.CoreNodes == PerftSuiteCounts[(((TST.PosIdx - 1) * 4) + TST.HorizonIdx)]) And (Glob.PerftNodes == PerftSuiteCounts[(((TST.PosIdx - 1) * 4) + TST.HorizonIdx)]))
            {
                TST.Passed += 1;
                TST.Perft.ResultTxt = "ok";
            }
            Else
            {
                TST.Perft.ResultTxt = "failed";
            }
            TST.Row = "";
            Call TestPad(Operator.Join(Operator.Join(TST.PosIdx, " / d="), TST.HorizonIdx))(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.Perft.ResultTxt)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(PerftSuiteCounts[(((TST.PosIdx - 1) * 4) + TST.HorizonIdx)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.Perft.CoreNodes)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(Glob.PerftNodes)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, PerftSuiteFens[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
            TST.HorizonIdx += 1;
        }
        TST.PosIdx += 1;
    }
    Call TestLog("=== ")(TST.Passed)(" / ")(TST.SearchCount)(" successful perft runs")("")("")("");
    Call TestLog("check-detection mismatches: ")(Glob.PerftCheckMismatches)("")("")("")("")("")("");
    Glob.IsDCI = 0;
    Glob.IsTestRunning = 0;
}

Define TestSearch(string SearchFen)(string SearchThinkTime) (warp=false)
{
    _dci fen = SearchFen;
    _dci think time = SearchThinkTime;
    Call $gok_prepare;
    Call GetBestMoveMedDiff;
    Ret.TestSearch.Move = Ret.GetBestMoveMedDiff.Move;
}

Define TestSuite(string TestCount)(string TestThinkTime) (warp=false)
{
    If (Not ((TestCount > 0)))
    {
        Stop(this script);
    }
    Glob.IsTestRunning = 1;
    Glob.IsDCI = 1;
    Call InitTestSuite;
    TST.Passed = 0;
    TST.SearchCount = TestCount;
    Call TestLog("=== search, ")(TST.SearchCount)(" positions at ")(TestThinkTime)("s each")("")("")("");
    TST.Row = "";
    Call TestPad("Test#")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Result")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Expect")(10);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    Call TestPad("Return")(9);
    TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
    TST.Row = Operator.Join(TST.Row, "FEN");
    Call TestLog(TST.Row)("")("")("")("")("")("")("");
    TST.PosIdx = 1;
    Repeat (TST.SearchCount)
    {
        Call TestSearch(TestSuiteFens[TST.PosIdx])(TestThinkTime);
        Call GetMoveNotation(Ret.TestSearch.Move);
        TST.ReturnedNotation = Ret.GetMoveNotation.Notation;
        TST.SlotHit = 0;
        TST.SlotIdx = 1;
        Repeat (5)
        {
            If (TST.ReturnedNotation == TestSuiteSan[(((TST.PosIdx - 1) * 5) + TST.SlotIdx)])
            {
                TST.SlotHit = 1;
            }
            TST.SlotIdx += 1;
        }
        If (TST.SlotHit == 1)
        {
            TST.Passed += 1;
            TST.Row = "";
            Call TestPad(TST.PosIdx)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad("ok")(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteSan[(((TST.PosIdx - 1) * 5) + 1)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.ReturnedNotation)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, TestSuiteFens[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
        }
        Else
        {
            TST.Row = "";
            Call TestPad(TST.PosIdx)(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad("failed")(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TestSuiteSan[(((TST.PosIdx - 1) * 5) + 1)])(10);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            Call TestPad(TST.ReturnedNotation)(9);
            TST.Row = Operator.Join(TST.Row, Ret.TestPad.PaddedText);
            TST.Row = Operator.Join(TST.Row, TestSuiteFens[TST.PosIdx]);
            Call TestLog(TST.Row)("")("")("")("")("")("")("");
        }
        TST.PosIdx += 1;
    }
    Call TestLog("=== ")(TST.Passed)(" / ")(TST.SearchCount)(" successful tests")("")("")("");
    Glob.IsDCI = 0;
    Glob.IsTestRunning = 0;
}

Define TTProbeNode(string BoardHash)(string Ply) (warp=true)
{
    Call GetTTNodeHash(BoardHash)(Ply);
    TTPN.NodeHash = Ret.GetTTNodeHash.Hash;
    TTPN.HashBucket = ((TTPN.NodeHash % (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)) - 5)) + 1);
    TTPN.HashBucket = (((TTPN.HashBucket - 1) * Const.TTNodeEntrySize) + 1);
    TTPN.ProbeFound = 0;
    TTPN.ProbeIdx = 0;
    Repeat Until ((TTPN.ProbeFound == 1) Or (TTPN.ProbeIdx == 5))
    {
        If (TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Hash)] == TTPN.NodeHash)
        {
            TTPN.ProbeFound = 1;
        }
        Else
        {
            TTPN.HashBucket += Const.TTNodeEntrySize;
            TTPN.ProbeIdx += 1;
        }
    }
    If (TTPN.ProbeFound == 0)
    {
        Ret.TTProbeNode.Hit = 0;
        Stop(this script);
    }
    Ret.TTProbeNode.Hit = 1;
    Ret.TTProbeNode.BestMove = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.BestMove)];
    Ret.TTProbeNode.Score = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Score)];
    Ret.TTProbeNode.Type = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Type)];
    Ret.TTProbeNode.Checked = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Checked)];
    Ret.TTProbeNode.Horizon = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.Horizon)];
    Ret.TTProbeNode.QSMeta = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.QSMeta)];
    Ret.TTProbeNode.StaticEval = TTNodeEntry[(TTPN.HashBucket + TTNodeColIdx.StaticEval)];
    List.ReplaceItem(TTNodeEntry, (TTPN.HashBucket + TTNodeColIdx.Age), Glob.TTCurrentAge);
}

Define TTProbeNodeAtPly(string Ply) (warp=true)
{
    List.ReplaceItem(NodeTTScore, Ply, Const.Null);
    List.ReplaceItem(NodeTTType, Ply, Const.Null);
    List.ReplaceItem(NodeTTHorizon, Ply, Const.Null);
    List.ReplaceItem(NodeTTQSMeta, Ply, Const.Null);
    List.ReplaceItem(NodeTTMove, Ply, Const.Null);
    List.ReplaceItem(NodeTTChecked, Ply, Const.Null);
    List.ReplaceItem(NodeTTStaticEval, Ply, Const.Null);
    Call TTProbeNode(Glob.CurrentBoardHash)(Ply);
    List.ReplaceItem(NodeTTHit, Ply, Ret.TTProbeNode.Hit);
    If (Ret.TTProbeNode.Hit == 1)
    {
        List.ReplaceItem(NodeTTScore, Ply, Ret.TTProbeNode.Score);
        List.ReplaceItem(NodeTTType, Ply, Ret.TTProbeNode.Type);
        List.ReplaceItem(NodeTTHorizon, Ply, Ret.TTProbeNode.Horizon);
        List.ReplaceItem(NodeTTQSMeta, Ply, Ret.TTProbeNode.QSMeta);
        List.ReplaceItem(NodeTTMove, Ply, Ret.TTProbeNode.BestMove);
        List.ReplaceItem(NodeTTChecked, Ply, Ret.TTProbeNode.Checked);
        If ((CheckedState[Ply] == Const.Null) And (Not ((NodeTTChecked[Ply] == Const.Null))))
        {
            List.ReplaceItem(CheckedState, Ply, NodeTTChecked[Ply]);
        }
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.TTProbeNode.StaticEval);
    }
}

Define TTStoreNode(string BoardHash)(string Ply)(string Score)(string BestMove)(string Type)(string Checked)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    If (Glob.IsSearchTimeout == 1)
    {
        Stop(this script);
    }
    If (abs(Score) == abs(Const.DrawByRepetitionEval))
    {
        Stop(this script);
    }
    Call GetTTNodeHash(BoardHash)(Ply);
    Call TTStoreNodeImpl(Ret.GetTTNodeHash.Hash)(Ply)(Score)(BestMove)(Type)(Checked)(Horizon)(QSMeta)(StaticEval);
}

Define TTStoreNodeImpl(string NodeHash)(string Ply)(string Score)(string BestMove)(string Type)(string Checked)(string Horizon)(string QSMeta)(string StaticEval) (warp=true)
{
    TTSNI.FirstBucket = ((NodeHash % (floor((List.Length(TTNodeEntry) / Const.TTNodeEntrySize)) - 5)) + 1);
    TTSNI.FirstBucket = (((TTSNI.FirstBucket - 1) * Const.TTNodeEntrySize) + 1);
    TTSNI.HashBucket = TTSNI.FirstBucket;
    TTSNI.UpdateIdx = 0;
    TTSNI.EmptySlot = 0;
    TTSNI.EvictionSlot = 0;
    Repeat (5)
    {
        TTSNI.Hash = TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Hash)];
        If (TTSNI.Hash == NodeHash)
        {
            TTSNI.UpdateIdx = TTSNI.HashBucket;
        }
        Else
        {
            If (TTSNI.Hash == 0)
            {
                TTSNI.EmptySlot = TTSNI.HashBucket;
            }
            Else
            {
                TTSNI.EntryValue = (TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Horizon)] - (Glob.TTCurrentAge - TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Age)]));
                If ((TTSNI.EvictionSlot == 0) Or (TTSNI.EntryValue < TTSNI.EvictionSlotValue))
                {
                    TTSNI.EvictionSlotValue = TTSNI.EntryValue;
                    TTSNI.EvictionSlot = TTSNI.HashBucket;
                }
            }
        }
        TTSNI.HashBucket += Const.TTNodeEntrySize;
    }
    If (TTSNI.UpdateIdx > 0)
    {
        TTSNI.HashBucket = TTSNI.UpdateIdx;
    }
    Else
    {
        If (TTSNI.EmptySlot > 0)
        {
            TTSNI.HashBucket = TTSNI.EmptySlot;
        }
        Else
        {
            TTSNI.HashBucket = TTSNI.EvictionSlot;
        }
    }
    If (TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Hash)] == NodeHash)
    {
        If (Not ((Checked == Const.Null)))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Checked), Checked);
        }
        If (Not ((StaticEval == Const.Null)))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.StaticEval), StaticEval);
        }
        TTSNI.HorizonLoc = TTNodeEntry[(TTSNI.HashBucket + TTNodeColIdx.Horizon)];
        If (((Not ((Score == Const.Null))) And (Not ((Horizon == Const.Null)))) And ((Type == Const.TTType.Exact) Or ((TTSNI.HorizonLoc == -1) Or (Not ((Horizon < TTSNI.HorizonLoc))))))
        {
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Type), Type);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Score), Score);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Horizon), Horizon);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Age), Glob.TTCurrentAge);
            List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.QSMeta), QSMeta);
            If (Not ((BestMove == Const.Null)))
            {
                List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.BestMove), BestMove);
            }
        }
    }
    Else
    {
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Hash), NodeHash);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Horizon), Horizon);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Type), Type);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Score), Score);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.BestMove), BestMove);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Checked), Checked);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.StaticEval), StaticEval);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.QSMeta), QSMeta);
        List.ReplaceItem(TTNodeEntry, (TTSNI.HashBucket + TTNodeColIdx.Age), Glob.TTCurrentAge);
    }
}

Define UndoMove (warp=false)
{
    Call EnterExecution;
    If ((Glob.IsInUndo == 0) And (List.Length(GameMovesAN) > 1))
    {
        Glob.IsInUndo = 1;
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("fromsquareselected");
        Event.BroadcastAndWait("tosquareselected");
        Call UndoPrevMove;
        If (BoardHistoryWasEngineMove[List.Length(BoardHistoryWasEngineMove)] == 0)
        {
            Call UndoPrevMove;
        }
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        Glob.IsInUndo = 0;
    }
    Call ExitExecution;
}

Define UndoPrevMove (warp=false)
{
    If (List.Length(GameMovesAN) > 0)
    {
        List.DeleteItem(BoardHistory, List.Length(BoardHistory));
        List.DeleteItem(BoardHistoryHash, List.Length(BoardHistoryHash));
        List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
        List.DeleteItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState));
        List.DeleteItem(BoardHistoryWasEngineMove, List.Length(BoardHistoryWasEngineMove));
        List.DeleteItem(GameMovesAN, List.Length(GameMovesAN));
        Call ImportBoardImpl(BoardHistory[List.Length(BoardHistory)]);
        Call GetSubstringLeft(Glob.GameMoves)((Variable.Length(Glob.GameMoves) - 4));
        Glob.GameMoves = Ret.GetSubstringLeft.Substring;
        Glob.HasOwnCastled = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 1);
        Glob.HasOwnKingMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 2);
        Glob.HasOwnRookKSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 3);
        Glob.HasOwnRookQSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 4);
        Glob.HasOppCastled = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 5);
        Glob.HasOppKingMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 6);
        Glob.HasOppRookKSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 7);
        Glob.HasOppRookQSMoved = Operator.LetterOf(BoardHistoryMetaState[List.Length(BoardHistoryMetaState)], 8);
        Call CalcBoardStats;
    }
}

Define UpdateMoveHash(string Piece)(string SourceIdx)(string TargetIdx)(string Ply) (warp=true)
{
    Call GetPiecePosHash(Piece)(SourceIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash - Ret.GetPiecePosHash.Hash);
    If ((abs(Piece) == GoK_OwnPawn) Or (abs(Piece) == GoK_OwnKing))
    {
        Glob.KPHash = (Glob.KPHash - Ret.GetPiecePosHash.Hash);
    }
    Call GetPiecePosHash(Piece)(TargetIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
    If ((abs(Piece) == GoK_OwnPawn) Or (abs(Piece) == GoK_OwnKing))
    {
        Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
    }
}

Define UpdateMoveHashPosScore(string Piece)(string SourceIdx)(string TargetIdx)(bool PosScoreUpdate)(string Ply) (warp=true)
{
    Call GetPiecePosHash(Piece)(SourceIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash - Ret.GetPiecePosHash.Hash);
    If ((abs(Piece) == GoK_OwnPawn) Or (abs(Piece) == GoK_OwnKing))
    {
        Glob.KPHash = (Glob.KPHash - Ret.GetPiecePosHash.Hash);
    }
    Call GetPiecePosHash(Piece)(TargetIdx);
    Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
    If ((abs(Piece) == GoK_OwnPawn) Or (abs(Piece) == GoK_OwnKing))
    {
        Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
    }
}

Define UpdateMoveNotationPV (warp=true)
{
    Glob.PV = "";
    UMNPV.PVIdx = 2;
    Repeat (PV[1])
    {
        Glob.PV = Operator.Join(Operator.Join(Glob.PV, PV[UMNPV.PVIdx]), " ");
        UMNPV.PVIdx += 1;
    }
}

Define UpdatePV(string Ply)(string BestMove) (warp=true)
{
    If ((Betas[Ply] - Alphas[Ply]) == 1)
    {
        Stop(this script);
    }
    If (Glob.IsInNullMove > 0)
    {
        Stop(this script);
    }
    UPV.Idx = (((Ply - 1) * Const.MaxPlyStackFrames) + 1);
    UPV.PVSliceStart = ((Ply * Const.MaxPlyStackFrames) + 1);
    UPV.Len = PV[UPV.PVSliceStart];
    List.ReplaceItem(PV, UPV.Idx, (UPV.Len + 1));
    List.ReplaceItem(PVRaw, UPV.Idx, (UPV.Len + 1));
    Call GetMoveNotation(BestMove);
    List.ReplaceItem(PV, (UPV.Idx + 1), Ret.GetMoveNotation.Notation);
    List.ReplaceItem(PVRaw, (UPV.Idx + 1), BestMove);
    UPV.Idx += 2;
    UPV.PVSliceStart += 1;
    Repeat (UPV.Len)
    {
        List.ReplaceItem(PV, UPV.Idx, PV[UPV.PVSliceStart]);
        List.ReplaceItem(PVRaw, UPV.Idx, PVRaw[UPV.PVSliceStart]);
        UPV.Idx += 1;
        UPV.PVSliceStart += 1;
    }
    If (Ply == 1)
    {
        If ((PV[1] > 0) Or (1 == 1))
        {
            Call UpdateMoveNotationPV;
            List.DeleteAll(PVStable);
            UPV.Idx = 2;
            Repeat (PVRaw[1])
            {
                List.Add(PVStable, PVRaw[UPV.Idx]);
                UPV.Idx += 1;
            }
        }
    }
}

