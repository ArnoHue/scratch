}

Define Search_Main(string Alpha)(string Beta)(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    List.ReplaceItem(Alphas, Ply, Alpha);
    List.ReplaceItem(Betas, Ply, Beta);
    If (Ply == 1)
    {
        Ret.Search_Main.Eval = Const.Null;
        Ret.Search_Main.Move = Const.Null;
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        List.ReplaceItem(HorizonAtPly, Ply, Horizon);
    }
    List.ReplaceItem(SearchEval, Ply, Const.Null);
    List.ReplaceItem(ScoreTypes, Ply, Const.TTType.None);
    List.ReplaceItem(BestMoves, Ply, Const.Null);
    List.ReplaceItem(IsBestMoveQuiet, Ply, 0);
    If (Glob.Search.IsTimeout == 1)
    {
        Stop(this script);
    }
    Call Search_InitStack(Ply)(Quiescence);
    List.ReplaceItem(PickedLegalMovesCountQuiet, Ply, 0);
    List.ReplaceItem(PickedLegalMovesCount, Ply, 0);
    Call Search_DetectCheckmatesAndDraws(Horizon)(Ply)(Quiescence)(ExcludedMove);
    If (Not ((SearchEval[Ply] == Const.Null)))
    {
        Stop(this script);
    }
    If ((Not (Quiescence)) And (Ply > 1))
    {
        Search_Main.GamePly = List.Length(BoardHistoryFiftyMoves);
        If (Not (((-100000 + Search_Main.GamePly) < Betas[Ply])))
        {
            List.ReplaceItem(SearchEval, Ply, (-100000 + Search_Main.GamePly));
            Stop(this script);
        }
        If (Not (((100000 - (Search_Main.GamePly + 1)) > Alphas[Ply])))
        {
            List.ReplaceItem(SearchEval, Ply, Alphas[Ply]);
            Stop(this script);
        }
    }
    Call TTProbeNodeAtPly(Ply);
    If (Not ((ExcludedMove == Const.Null)))
    {
        List.ReplaceItem(NodeTTHit, Ply, 0);
        List.ReplaceItem(NodeTTScore, Ply, Const.Null);
        List.ReplaceItem(NodeTTMove, Ply, Const.Null);
    }
    Search_Main.Rule50 = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
    If ((Ply > 1) And (ExcludedMove == Const.Null))
    {
        If (IsPvNode[Ply] == 0)
        {
            Call //("Probe transposition table for cached node evaluations");
            Search_Main.TTType = NodeTTType[Ply];
            Search_Main.TTScore = NodeTTScore[Ply];
            Search_Main.TTQSMeta = NodeTTQSMeta[Ply];
            Search_Main.TTHorizon = NodeTTHorizon[Ply];
            Search_Main.TTHit = NodeTTHit[Ply];
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.TTNodeProbe)(Horizon)(Ply);
            }
            If ((Search_Main.TTHit == 1) And ((Not ((Search_Main.TTScore == Const.Null))) And (Not ((Search_Main.TTHorizon == Const.Null)))))
            {
                Call IsQuiescentCheckCond(Ply);
                Search_Main.IsTTCutoffAllowed = 0;
                If Quiescence
                {
                    If (Search_Main.TTHorizon > -1)
                    {
                        Search_Main.IsTTCutoffAllowed = 1;
                    }
                    Else
                    {
                        If ((Search_Main.TTHorizon > -2) And ((Not ((Search_Main.TTQSMeta == Const.Null))) And (Not ((Search_Main.TTQSMeta < Ret.IsQuiescentCheckCond.IsTrue)))))
                        {
                            Search_Main.IsTTCutoffAllowed = 1;
                        }
                    }
                }
                Else
                {
                    If (((Not ((Search_Main.TTHorizon < (Horizon + 1)))) Or ((Search_Main.TTType == Const.TTType.Exact) And (Not ((Search_Main.TTHorizon < Horizon))))) And (Search_Main.Rule50 < 90))
                    {
                        If (1 == 1)
                        {
                            Search_Main.IsTTCutoffAllowed = 1;
                        }
                    }
                }
                If (Search_Main.IsTTCutoffAllowed == 1)
                {
                    Search_Main.IsTTCutoff = 0;
                    If (Search_Main.TTType == Const.TTType.Exact)
                    {
                        Search_Main.IsTTCutoff = 1;
                    }
                    Else
                    {
                        If (IsPvNode[Ply] == 0)
                        {
                            If (Search_Main.TTType == Const.TTType.HighBound)
                            {
                                If (Not ((Search_Main.TTScore > Alphas[Ply])))
                                {
                                    Search_Main.IsTTCutoff = 1;
                                }
                            }
                            Else
                            {
                                If (Search_Main.TTType == Const.TTType.LowBound)
                                {
                                    If (Not ((Search_Main.TTScore < Betas[Ply])))
                                    {
                                        Search_Main.IsTTCutoff = 1;
                                    }
                                }
                            }
                        }
                    }
                    If (Search_Main.IsTTCutoff == 1)
                    {
                        If (1 == 1)
                        {
                            Call IsQuietMove(NodeTTMove[Ply]);
                            If ((Not ((NodeTTMove[Ply] == Const.Null))) And (Not ((Search_Main.TTScore < Betas[Ply]))))
                            {
                                If (Ret.IsQuietMove.IsQuiet == 1)
                                {
                                    If (Not (Quiescence))
                                    {
                                        Call StoreKillerMove(Ply)(Horizon)(NodeTTMove[Ply])((1 == 0))((1 == 0))((1 == 1));
                                    }
                                }
                            }
                            If ((Not (Quiescence)) And (Not ((NodeTTMove[Ply] == Const.Null))))
                            {
                                If (Search_Main.TTScore < Betas[Ply])
                                {
                                    If (Ret.IsQuietMove.IsQuiet == 1)
                                    {
                                        Call StoreKillerMove(Ply)(Horizon)(NodeTTMove[Ply])((1 == 1))((1 == 0))((1 == 1));
                                    }
                                }
                            }
                            List.ReplaceItem(SearchEval, Ply, Search_Main.TTScore);
                            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                            {
                                Call Profile_CountByHorizon(Const.Profile.TTNodeHit)(Horizon)(Ply);
                            }
                            Stop(this script);
                        }
                    }
                }
            }
        }
    }
    Call //("Search tree leaf reached");
    If (Ply > (Const.MaxPlyStackFrames - 10))
    {
        Call Evaluate((Ply - 1))((1 == 1));
        Call AdjustEvalScore(Ply)(Ret.Evaluate.Score);
        List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
        Stop(this script);
    }
    If (CheckedState[Ply] == 0)
    {
        If (Glob.Profile.Mode > Const.ProfilerMode.Off)
        {
            Call Profile_CountByHorizon(Const.Profile.TTStaticProbe)(HorizonAtPly[Ply])(Ply);
        }
        If (Not ((NodeTTStaticEval[Ply] == Const.Null)))
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.TTStaticHit)(HorizonAtPly[Ply])(Ply);
            }
            Call AdjustEvalScore(Ply)(NodeTTStaticEval[Ply]);
        }
    }
    If Quiescence
    {
        If (CheckedState[Ply] == 1)
        {
            List.ReplaceItem(SearchEval, Ply, (-100000 + List.Length(BoardHistoryFiftyMoves)));
        }
        Else
        {
            Call //("Standing pat");
            Call GetStaticEval(Ply);
            List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
            If (Not ((StaticEval[Ply] < Betas[Ply])))
            {
                List.ReplaceItem(SearchEval, Ply, StaticEval[Ply]);
                If (Not ((NodeTTHit[Ply] == 1)))
                {
                    Call TTStoreNode(Glob.Board.CurrentHash)(Ply)(SearchEval[Ply])(Const.Null)(Const.TTType.LowBound)(-1)(0)(NodeTTStaticEval[Ply]);
                }
                Stop(this script);
            }
            If (StaticEval[Ply] > Alphas[Ply])
            {
                List.ReplaceItem(Alphas, Ply, StaticEval[Ply]);
            }
        }
    }
    If (Not (Quiescence))
    {
        If (CheckedState[Ply] == 0)
        {
            Call GetStaticEval(Ply);
            If ((Ply > 1) And ((RazorState[Ply] == 0) And (IIDState[Ply] == 0)))
            {
                If ((AppliedMove[(Ply - 1)] > 100) And ((TargetPieces[(Ply - 1)] == 0) And (CheckedState[(Ply - 1)] == 0)))
                {
                    If ((Not ((StaticEval[(Ply - 1)] == Const.Null))) And (Not ((StaticEval[Ply] == Const.Null))))
                    {
                        Search_Main.Bonus = (-32 * (StaticEval[(Ply - 1)] + StaticEval[Ply]));
                        If (Search_Main.Bonus > 2000)
                        {
                            Search_Main.Bonus = 2000;
                        }
                        If (Search_Main.Bonus < -2000)
                        {
                            Search_Main.Bonus = -2000;
                        }
                        Search_Main.Idx = (PlyHistoryBaseIdx[(Ply - 1)] + ((floor((AppliedMove[(Ply - 1)] / 100)) * 64) + floor((AppliedMove[(Ply - 1)] % 100))));
                        List.ReplaceItem(HistoryMoveScores, Search_Main.Idx, (HistoryMoveScores[Search_Main.Idx] + (Search_Main.Bonus - floor((HistoryMoveScores[Search_Main.Idx] * (abs(Search_Main.Bonus) / 7183))))));
                    }
                }
            }
            If (Ply > 1)
            {
                If (Not ((SingularState[Ply] == 1)))
                {
                    Call Search_Pruning(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
                }
                If (Not ((SearchEval[Ply] == Const.Null)))
                {
                    Stop(this script);
                }
                If (RazorState[Ply] == 1)
                {
