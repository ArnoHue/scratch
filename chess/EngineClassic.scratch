                    Stop(this script);
                }
            }
            Else
            {
                Call Search_DetectExtension(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
                If (PlyExtension[Ply] == "*")
                {
                    Call RevertMove(Ply);
                    List.ReplaceItem(PickPhase, Ply, "*");
                }
                Else
                {
                    Call Search_SearchCore(Horizon)(Ply)(Cutnode)(Quiescence)(ExcludedMove);
                    Search.Main.NodeEval = Ret.Search_SearchCore.NodeEval;
                    If (Glob.IsSearchTimeout == 0)
                    {
                        If (Ply == 1)
                        {
                            List.Add(SearchPly1EvalMoves, AppliedMove[Ply]);
                        }
                    }
                    Call Comment("Revert applied move, restore board to previous state");
                    Call RevertMove(Ply);
                    If (Glob.IsSearchTimeout == 1)
                    {
                        If (Quiescence[Ply] == 0)
                        {
                            Glob.MoveCount += MovesCount[Ply];
                        }
                        Else
                        {
                            Glob.MoveCountQ += MovesCount[Ply];
                        }
                        Stop(this script);
                    }
                    If (Not ((Search.Main.NodeEval == Const.Null)))
                    {
                        Call Comment("Compare node evaluation with search window, adapt node evaluation result and alpha/beta funnel accordingly");
                        If ((Search.Main.NodeEval > SearchEval[Ply]) Or (SearchEval[Ply] == Const.Null))
                        {
                            List.ReplaceItem(SearchEval, Ply, Search.Main.NodeEval);
                            If (((Ply == 1) And (Glob.IsSearchTimeout == 0)) And (Not ((Search.Main.NodeEval < (0 - (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + 1)))))))
                            {
                                Call GetCurrentMove(Ply);
                                Ret.Search_Main.Move = Ret.GetCurrentMove.Move;
                                Ret.Search_Main.Eval = Search.Main.NodeEval;
                            }
                            If (Search.Main.NodeEval > Alphas[Ply])
                            {
                                Call GetCurrentMove(Ply);
                                List.ReplaceItem(BestMoves, Ply, Ret.GetCurrentMove.Move);
                                List.ReplaceItem(MovesIdxBestMove, Ply, MovesIdx[Ply]);
                                Call UpdatePV(Ply)(Ret.GetCurrentMove.Move);
                                If Quiescence
                                {
                                    If ((Not (((Betas[Ply] - Alphas[Ply]) == 1))) And (Search.Main.NodeEval < Betas[Ply]))
                                    {
                                        List.ReplaceItem(Alphas, Ply, Search.Main.NodeEval);
                                    }
                                    Else
                                    {
                                        Call Comment("Cutoff");
                                        List.ReplaceItem(MovesIdx, Ply, (MovesCount[Ply] + 1));
                                        List.ReplaceItem(PickPhase, Ply, "*");
                                    }
                                }
                                Else
                                {
                                    List.ReplaceItem(Alphas, Ply, Search.Main.NodeEval);
                                    If ((Ply == 1) And (Glob.IsSearchTimeout == 0))
                                    {
                                        If (Not ((Search.Main.NodeEval < (0 - (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + 1))))))
                                        {
                                            If (1 == 1)
                                            {
                                                Call Log(((Ply + Horizon) - 1))(" : ")(Ret.Search_Main.Move)(" : ")(Ret.Search_Main.Eval)("")("")("");
                                            }
                                            If ((Search.Main.NodeEval > (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + Horizon))) And (Search.Main.NodeEval < Glob.SearchBeta))
                                            {
                                                Glob.IsSearchTimeout = 1;
                                                Stop(this script);
                                            }
                                            If (Not ((Search.Main.NodeEval < Glob.SearchBeta)))
                                            {
                                                Stop(this script);
                                            }
                                        }
                                    }
                                    If (Not ((Search.Main.NodeEval < Betas[Ply])))
                                    {
                                        If (Ply > 1)
                                        {
                                            Call Comment("Cutoff");
                                            List.ReplaceItem(MovesIdx, Ply, (MovesCount[Ply] + 1));
                                            List.ReplaceItem(PickPhase, Ply, "*");
                                        }
                                    }
                                }
                            }
                        }
                        If (Not (Quiescence))
                        {
                            If (((LMRState[Ply] == 2) Or (LMRState[Ply] == 3)) And (1 == 0))
                            {
                                Call GetCurrentMove(Ply);
                                Call StoreKillerMove(Ply)(Horizon)(Ret.GetCurrentMove.Move)((LMRState[Ply] == 3))((1 == 1));
                            }
                        }
                    }
                }
            }
        }
    }
    Call Comment("Evaluation alpha-bound, beta-bound or exact?");
    If (Not ((SearchEval[Ply] < Betas[Ply])))
    {
        List.ReplaceItem(ScoreTypes, Ply, Const.TTType.LowBound);
    }
    Else
    {
        If ((Not (((Betas[Ply] - Alphas[Ply]) == 1))) And (((Not (Quiescence)) Or (SearchEval[Ply] > AlphasOld[Ply])) And (Not ((BestMoves[Ply] == Const.Null)))))
        {
            List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
