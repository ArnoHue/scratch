                EvaluateThreatsImpl.BishopIdx = (EvalPiecesIdx_NonPawns[EvaluateThreatsImpl.NonPawnListIdx] + 0);
                If (Board[EvaluateThreatsImpl.BishopIdx] == EvaluateThreatsImpl.AttackerBishopPiece)
                {
                    EvaluateThreatsImpl.IsDirectRingAttack = 0;
                    EvaluateThreatsImpl.HasPawnRingHit = 0;
                    EvaluateThreatsImpl.DirectionIdx = 1;
                    Repeat (4)
                    {
                        EvaluateThreatsImpl.DiagonalStep = ((((EvaluateThreatsImpl.DirectionIdx == 1) * 9) + ((EvaluateThreatsImpl.DirectionIdx == 2) * 7)) - (((EvaluateThreatsImpl.DirectionIdx == 3) * 7) + ((EvaluateThreatsImpl.DirectionIdx == 4) * 9)));
                        EvaluateThreatsImpl.DiagonalSqIdx = EvaluateThreatsImpl.BishopIdx;
                        EvaluateThreatsImpl.IsWalkOpen = 1;
                        EvaluateThreatsImpl.IsPieceBlocked = 0;
                        Repeat (7)
                        {
                            If (EvaluateThreatsImpl.IsWalkOpen == 1)
                            {
                                If (((((EvaluateThreatsImpl.DiagonalStep == 9) Or (EvaluateThreatsImpl.DiagonalStep == -7)) And (IdxToFile[EvaluateThreatsImpl.DiagonalSqIdx] == 8)) Or (((EvaluateThreatsImpl.DiagonalStep == 7) Or (EvaluateThreatsImpl.DiagonalStep == -9)) And (IdxToFile[EvaluateThreatsImpl.DiagonalSqIdx] == 1))) Or (((EvaluateThreatsImpl.DiagonalSqIdx + EvaluateThreatsImpl.DiagonalStep) < 1) Or ((EvaluateThreatsImpl.DiagonalSqIdx + EvaluateThreatsImpl.DiagonalStep) > 64)))
                                {
                                    EvaluateThreatsImpl.IsWalkOpen = 0;
                                }
                                Else
                                {
                                    EvaluateThreatsImpl.DiagonalSqIdx += EvaluateThreatsImpl.DiagonalStep;
                                    If (((ChebyshevDistance[((EvaluateThreatsImpl.DiagonalSqIdx * 100) + EvaluateThreatsImpl.RingCenterIdx)] + 0) < 2) And (((((EvaluateThreatsImpl.Side == 1) * BoardAttackedTypeMask[EvaluateThreatsImpl.DiagonalSqIdx]) + ((EvaluateThreatsImpl.Side == 2) * BoardAttackedTypeMask[(EvaluateThreatsImpl.DiagonalSqIdx + 64)])) - (floor(((((EvaluateThreatsImpl.Side == 1) * BoardAttackedTypeMask[EvaluateThreatsImpl.DiagonalSqIdx]) + ((EvaluateThreatsImpl.Side == 2) * BoardAttackedTypeMask[(EvaluateThreatsImpl.DiagonalSqIdx + 64)])) / 10)) * 10)) < 2))
                                    {
                                        If ((EvaluateThreatsImpl.IsPieceBlocked == 0) And ((EvalPinDir[EvaluateThreatsImpl.BishopIdx] == 0) Or (((IdxToFile[EvaluateThreatsImpl.DiagonalSqIdx] - IdxToFile[EvaluateThreatsImpl.BishopIdx]) * RayRankDelta[EvalPinDir[EvaluateThreatsImpl.BishopIdx]]) == ((IdxToRank[EvaluateThreatsImpl.DiagonalSqIdx] - IdxToRank[EvaluateThreatsImpl.BishopIdx]) * RayFileDelta[EvalPinDir[EvaluateThreatsImpl.BishopIdx]]))))
                                        {
                                            EvaluateThreatsImpl.IsDirectRingAttack = 1;
                                        }
                                        EvaluateThreatsImpl.HasPawnRingHit = 1;
                                    }
                                    If (abs(Board[EvaluateThreatsImpl.DiagonalSqIdx]) == (GoK_OwnPawn + 0))
                                    {
                                        EvaluateThreatsImpl.IsWalkOpen = 0;
                                    }
                                    Else
                                    {
                                        If ((Not (((Board[EvaluateThreatsImpl.DiagonalSqIdx] + 0) == 0))) And (Not ((abs(Board[EvaluateThreatsImpl.DiagonalSqIdx]) == (GoK_OwnQueen + 0)))))
                                        {
                                            EvaluateThreatsImpl.IsPieceBlocked = 1;
                                        }
                                    }
                                }
                            }
                        }
                        EvaluateThreatsImpl.DirectionIdx += 1;
                    }
                    If ((EvaluateThreatsImpl.IsDirectRingAttack == 0) And (EvaluateThreatsImpl.HasPawnRingHit == 1))
                    {
                        EvaluateThreatsImpl.RingBishopCount += 1;
                    }
                }
                EvaluateThreatsImpl.NonPawnListIdx += 1;
            }
            Call TaperedEval.Add((-12 * EvaluateThreatsImpl.RingBishopCount))(0)("Eval.Threats.BishopOnKingRing")("")(EvaluateThreatsImpl.Side)("");
            Call TaperedEval.Add((-4 * EvaluateThreatsImpl.KingFlankAttacks))(0)("Eval.Threats.KingFlankAttacks")("")(EvaluateThreatsImpl.Side)("");
            Call TaperedEval.Add((-9.5 * EvaluateThreatsImpl.KingPawnlessFlank))((-48.5 * EvaluateThreatsImpl.KingPawnlessFlank))("Eval.Threats.KingPawnlessFlank")("")(EvaluateThreatsImpl.Side)("");
        }
        Call TaperedEval.Add(KingPawnProtection[EvaluateThreatsImpl.Side])(KingPawnProtectionEg[EvaluateThreatsImpl.Side])("Eval.Threats.KingDanger.PawnProtection")("")(EvaluateThreatsImpl.Side)("");
        If (Glob.Eval.DebugLog == 1)
        {
            Call LogPVEvalLine("Eval.Threats.KingDanger.Extended")(Glob.Eval.TaperedMg)(Glob.Eval.TaperedEg)("")(EvaluateThreatsImpl.Side)("");
        }
        Call TaperedEval.GetSum;
        Glob.Eval.MgTotal += (Glob.Eval.TaperedMg * (((EvaluateThreatsImpl.Side == 1) * 2) - 1));
        Glob.Eval.EgTotal += (Glob.Eval.TaperedEg * (((EvaluateThreatsImpl.Side == 1) * 2) - 1));
        EvaluateThreatsImpl.SafeChecksPacked = (Operator.Round((Ret.TaperedEval.GetSum.Score * 1)) * (((EvaluateThreatsImpl.Side == 1) * 2) - 1));
        Ret.EvaluateThreatsImpl.Score += EvaluateThreatsImpl.SafeChecksPacked;
        EvaluateThreatsImpl.Side += 1;
    }
    If (Glob.Eval.DebugLog == 1)
    {
        Call LogPVEvalLine("Eval.Threats.Total")(Ret.EvaluateThreatsImpl.Score)("")("")(EvaluateThreatsImpl.Side)("");
    }
}

Define ExecuteEngineMove (warp=false)
{
    Call EnterExecution;
    Call ExecuteEngineMoveImpl;
    Call ExitExecution;
}

Define ExecuteEngineMoveImpl (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Event.Broadcast("OpeningBookHide");
    ExecuteEngineMoveImpl.Move = Const.Null;
    If (Glob.Config.Level > 2)
    {
        Call GetOpeningMoves;
        If (List.Length(OpeningMovesRes) > 0)
        {
            Event.Broadcast("OpeningBookShow");
            ExecuteEngineMoveImpl.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
            If (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0))
            {
                Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.TimeInc);
                Glob.Clock.MoveCount += 1;
                If ((Glob.Clock.StageMoves > 0) And (Glob.Clock.MoveCount == Glob.Clock.StageMoves))
                {
                    Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.StageTime);
                }
            }
        }
    }
    Call IsEngineValidMove(ExecuteEngineMoveImpl.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Looks.Think("Thinking...");
        Control.Wait(0);
        If (Glob.Config.Level > 2)
        {
            If (Glob.Config.Level > 4)
            {
                Call SearchWrp;
                ExecuteEngineMoveImpl.Move = Ret.SearchWrp.Move;
            }
            Else
            {
                Call SearchWrp.Blitz;
                ExecuteEngineMoveImpl.Move = Ret.SearchWrp.Blitz.Move;
            }
        }
        Else
        {
            Call SearchWrp.Easy;
            ExecuteEngineMoveImpl.Move = Ret.SearchWrp.Easy.Move;
        }
    }
    Event.BroadcastAndWait("hidebestmove");
    Call OnProgressChanged(100);
    Control.Wait(0);
    Call IsEngineValidMove(ExecuteEngineMoveImpl.Move);
    If (Ret.IsEngineValidMove.IsValid == 0)
    {
        Looks.Say(Operator.Join("Internal Error: No valid move found. Sorry, this should not happen. Maybe you cleared lookup lists in the editor? If you are running a normal game, please export board data and report bug via project comment", Operator.Join(" Move: ", ExecuteEngineMoveImpl.Move)), 10);
        GoK_IsGameSuspended = 1;
        Stop(this script);
    }
    Looks.Think("");
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((ExecuteEngineMoveImpl.Move / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((ExecuteEngineMoveImpl.Move % 100))];
    If (((ExecuteEngineMoveImpl.Move == GoK_OwnQueensideCastling) Or (ExecuteEngineMoveImpl.Move == GoK_OwnKingsideCastling)) Or ((ExecuteEngineMoveImpl.Move == GoK_OppQueensideCastling) Or (ExecuteEngineMoveImpl.Move == GoK_OppKingsideCastling)))
    {
        Pieces_MovePieceSpecial = ExecuteEngineMoveImpl.Move;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.BroadcastAndWait("movepiece");
    Event.Broadcast("SoundMove");
    List.Add(GameMoves, floor(ExecuteEngineMoveImpl.Move));
    Call GetMoveNotation(ExecuteEngineMoveImpl.Move);
    List.Add(GameMovesAN, Ret.GetMoveNotation.Notation);
    Call ClearMoveList(1);
    Call AddMoveToList((ExecuteEngineMoveImpl.Move + 0))(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    If ((Not ((floor((ExecuteEngineMoveImpl.Move / 100)) == 0))) And (Board[floor((ExecuteEngineMoveImpl.Move % 100))] == GoK_OppRook))
    {
        If (floor((ExecuteEngineMoveImpl.Move % 100)) == 57)
        {
            Glob.Board.HasOppRookQSMoved = 1;
        }
        If (floor((ExecuteEngineMoveImpl.Move % 100)) == 64)
        {
            Glob.Board.HasOppRookKSMoved = 1;
        }
    }
    Call ApplyMove(1);
    Call DrawBoardAndWait;
    If (Not ((floor((ExecuteEngineMoveImpl.Move / 100)) == 0)))
    {
        If (Board[(ExecuteEngineMoveImpl.Move % 100)] == GoK_OwnKing)
        {
            Glob.Board.HasOwnKingMoved = 1;
        }
        If (Board[(ExecuteEngineMoveImpl.Move % 100)] == GoK_OwnRook)
        {
            If (floor((ExecuteEngineMoveImpl.Move / 100)) == 1)
            {
                Glob.Board.HasOwnRookQSMoved = 1;
            }
            If (floor((ExecuteEngineMoveImpl.Move / 100)) == 8)
            {
                Glob.Board.HasOwnRookKSMoved = 1;
            }
        }
    }
    If ((ExecuteEngineMoveImpl.Move == GoK_OwnQueensideCastling) Or (ExecuteEngineMoveImpl.Move == GoK_OwnKingsideCastling))
    {
        Glob.Board.HasOwnKingMoved = 1;
        Glob.Board.HasOwnCastled = 1;
    }
    Call AddBoardToHistory(1);
    Call GetRepetitionCount;
    If (Ret.GetRepetitionCount.Count > 2)
    {
        Looks.Say("Draw!");
        Event.Broadcast("SoundDraw");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByMaterial;
        If (Ret.IsDrawByMaterial.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call IsOppKingCheckMate;
            If (Ret.IsOppKingCheckMate.IsCheckMate == 1)
            {
                Looks.Say("Checkmate!");
                Event.Broadcast("SoundCheckmate");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(2);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call CalcBoardAttackedByMove(1)((1 == 0));
                    If (Glob.Board.IsOppSideChecked == 1)
                    {
                        Call SayAsync("Check!")(2);
                        Event.Broadcast("SoundCheck");
                    }
                }
            }
        }
    }
}

Define ExecuteInit (warp=false)
{
    Glob.Game.ExecutionPly = 0;
    Glob.Game.IsExecutionRunning = 0;
    If (Glob.Game.IsPlayerBlack == 1)
    {
        Call ExecuteEngineMove;
    }
}

Define ExecuteUserMove(string UserMove) (warp=false)
{
    Call EnterExecution;
    Call ExecuteUserMoveImpl(UserMove);
    Call ExitExecution;
}

Define ExecuteUserMoveImpl(string UserMoveParam) (warp=false)
{
    If (GoK_IsGameSuspended == 1)
    {
        Stop(this script);
    }
    Pieces_MovePieceFromIdx = GoK_ScreenIdx[floor((UserMoveParam / 100))];
    Pieces_MovePieceToIdx = GoK_ScreenIdx[floor((UserMoveParam % 100))];
    If (((UserMoveParam == GoK_OwnQueensideCastling) Or (UserMoveParam == GoK_OwnKingsideCastling)) Or ((UserMoveParam == GoK_OppQueensideCastling) Or (UserMoveParam == GoK_OppKingsideCastling)))
    {
        Pieces_MovePieceSpecial = UserMoveParam;
    }
    Else
    {
        Pieces_MovePieceSpecial = "";
    }
    Event.BroadcastAndWait("movepiece");
    Event.Broadcast("SoundMove");
    Stg_FromSquareIdx = -1;
    Stg_ToSquareIdx = -1;
    Event.BroadcastAndWait("fromsquareselected");
    Event.BroadcastAndWait("tosquareselected");
    Call GenerateMovesPublic(2);
    If (Not (List.ContainsItem(Moves2, UserMoveParam)))
    {
        Call ClearMoveList(2);
        Call AddMoveToList((UserMoveParam + 0))(2)(0);
        List.ReplaceItem(MovesIdx, 2, 1);
        Call ApplyMove(2);
        Call CalcBoardAttackedByMove(3)((1 == 0));
        If (Glob.Board.IsOppSideChecked == 1)
        {
            Call SayAsync("Invalid move - Check!")(2);
            Event.Broadcast("SoundInvalidMoveCheck");
        }
        Else
        {
            Call SayAsync("Invalid move!")(2);
            Event.Broadcast("SoundInvalidMove");
        }
        Call RevertMove(2);
        Call DrawBoardAndWait;
        Stop(this script);
    }
    Glob.Game.UserMove = UserMoveParam;
    If (Operator.LetterOf(Glob.Game.UserMove, (Variable.Length(Glob.Game.UserMove) - 1)) == ".")
    {
        Looks.Say("Please select promotion piece");
        Event.BroadcastAndWait("selectpromotionpiecewhite");
        Looks.Say("");
        If (Pieces_SelectedPromotionPiece == GoK_OppQueen)
        {
            Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.1);
        }
        Else
        {
            If (Pieces_SelectedPromotionPiece == GoK_OppRook)
            {
                Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.2);
            }
            Else
            {
                If (Pieces_SelectedPromotionPiece == GoK_OppBishop)
                {
                    Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.3);
                }
                Else
                {
                    If (Pieces_SelectedPromotionPiece == GoK_OppKnight)
                    {
                        Glob.Game.UserMove = (floor(Glob.Game.UserMove) + 0.4);
                    }
                }
            }
        }
    }
    Call GetMoveNotation(Glob.Game.UserMove);
    ExecuteUserMoveImpl.Notation = Ret.GetMoveNotation.Notation;
    Call ClearMoveList(2);
    Call AddMoveToList((Glob.Game.UserMove + 0))(2)(0);
    List.ReplaceItem(MovesIdx, 2, 1);
    If ((Not ((floor((Glob.Game.UserMove / 100)) == 0))) And (Board[floor((Glob.Game.UserMove % 100))] == GoK_OwnRook))
    {
        If (floor((Glob.Game.UserMove % 100)) == 1)
        {
            Glob.Board.HasOwnRookQSMoved = 1;
        }
        If (floor((Glob.Game.UserMove % 100)) == 8)
        {
            Glob.Board.HasOwnRookKSMoved = 1;
        }
    }
    Call ApplyMove(2);
    Call DrawBoardAndWait;
    Call CalcBoardAttackedByMove(1)((1 == 0));
    If (Glob.Board.IsOppSideChecked == 1)
    {
        Call RevertMove(2);
        Call DrawBoardAndWait;
        Control.Wait(0);
        Call SayAsync("Invalid move - Check!")(2);
        Event.Broadcast("SoundInvalidMoveCheck");
        Stop(this script);
    }
    List.Add(GameMovesAN, ExecuteUserMoveImpl.Notation);
    List.Add(GameMoves, floor(Glob.Game.UserMove));
    Looks.Think("Thinking...");
    Call DrawBoardAndWait;
    Control.Wait(0);
    ExecuteUserMoveImpl.SourceIdx = floor((Glob.Game.UserMove / 100));
    ExecuteUserMoveImpl.TargetIdx = floor((Glob.Game.UserMove % 100));
    If (Board[ExecuteUserMoveImpl.TargetIdx] == GoK_OppKing)
    {
        Glob.Board.HasOppKingMoved = 1;
    }
    If (Board[ExecuteUserMoveImpl.TargetIdx] == GoK_OppRook)
    {
        If (ExecuteUserMoveImpl.SourceIdx == 57)
        {
            Glob.Board.HasOppRookQSMoved = 1;
        }
        If (ExecuteUserMoveImpl.SourceIdx == 64)
        {
            Glob.Board.HasOppRookKSMoved = 1;
        }
    }
    If ((Glob.Game.UserMove == GoK_OppQueensideCastling) Or (Glob.Game.UserMove == GoK_OppKingsideCastling))
    {
        Glob.Board.HasOppCastled = 1;
        Glob.Board.HasOppKingMoved = 1;
    }
    Call AddBoardToHistory(0);
    Call IsOwnKingCheckMate;
    If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
    {
        Looks.Say("Checkmate!");
        Event.Broadcast("SoundCheckmate");
        GoK_IsGameSuspended = 1;
    }
    Else
    {
        Call IsDrawByStalemate(1);
        If (Ret.IsDrawByStalemate.IsDraw == 1)
        {
            Looks.Say("Draw!");
            Event.Broadcast("SoundDraw");
            GoK_IsGameSuspended = 1;
        }
        Else
        {
            Call GetRepetitionCount;
            If (Ret.GetRepetitionCount.Count > 2)
            {
                Looks.Say("Draw!");
                Event.Broadcast("SoundDraw");
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByMaterial;
                If (Ret.IsDrawByMaterial.IsDraw == 1)
                {
                    Looks.Say("Draw!");
                    Event.Broadcast("SoundDraw");
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
    }
}

Define ExitExecution (warp=false)
{
    Glob.Game.ExecutionPly += -1;
    If (Glob.Game.ExecutionPly == 0)
    {
        Glob.Game.IsExecutionRunning = 0;
        Event.BroadcastAndWait("inputmode");
    }
}

Define ExportBoardFEN(string Ply) (warp=true)
{
    ExportBoardFEN.IsPlayerTurn = (((Ply % 2) == 0) + 0);
    ExportBoardFEN.StateIdx = Ply;
    If (Ply < 1)
    {
        ExportBoardFEN.StateIdx = 1;
    }
    Call StoreExternalBoard;
    ExportBoardFEN.SqIdx = 1;
    Ret.ExportBoardFEN.FEN = "";
    Ret.ExportBoardFEN.FENLichess = "https://lichess.org/analysis/";
    Repeat Until (ExportBoardFEN.SqIdx > 64)
    {
        ExportBoardFEN.Piece = GoK_Board[ExportBoardFEN.SqIdx];
        If (ExportBoardFEN.Piece == GoK_OwnPawn)
        {
            ExportBoardFEN.PieceChar = "p";
        }
        If (ExportBoardFEN.Piece == GoK_OwnKnight)
        {
            ExportBoardFEN.PieceChar = "n";
        }
        If (ExportBoardFEN.Piece == GoK_OwnBishop)
        {
            ExportBoardFEN.PieceChar = "b";
        }
        If (ExportBoardFEN.Piece == GoK_OwnRook)
        {
            ExportBoardFEN.PieceChar = "r";
        }
        If (ExportBoardFEN.Piece == GoK_OwnQueen)
        {
            ExportBoardFEN.PieceChar = "q";
        }
        If (ExportBoardFEN.Piece == GoK_OwnKing)
        {
            ExportBoardFEN.PieceChar = "k";
        }
        If (ExportBoardFEN.Piece == GoK_OppPawn)
        {
            ExportBoardFEN.PieceChar = "P";
        }
        If (ExportBoardFEN.Piece == GoK_OppKnight)
        {
            ExportBoardFEN.PieceChar = "N";
        }
        If (ExportBoardFEN.Piece == GoK_OppBishop)
        {
            ExportBoardFEN.PieceChar = "B";
        }
        If (ExportBoardFEN.Piece == GoK_OppRook)
        {
            ExportBoardFEN.PieceChar = "R";
        }
        If (ExportBoardFEN.Piece == GoK_OppQueen)
        {
            ExportBoardFEN.PieceChar = "Q";
        }
        If (ExportBoardFEN.Piece == GoK_OppKing)
        {
            ExportBoardFEN.PieceChar = "K";
        }
        If (ExportBoardFEN.Piece == 0)
        {
            ExportBoardFEN.ScanSqIdx = ExportBoardFEN.SqIdx;
            Repeat Until (((ExportBoardFEN.ScanSqIdx % 8) == 0) Or (Not ((GoK_Board[(ExportBoardFEN.ScanSqIdx + 1)] == 0))))
            {
                ExportBoardFEN.ScanSqIdx += 1;
            }
            ExportBoardFEN.PieceChar = ((ExportBoardFEN.ScanSqIdx - ExportBoardFEN.SqIdx) + 1);
            ExportBoardFEN.SqIdx += (ExportBoardFEN.ScanSqIdx - ExportBoardFEN.SqIdx);
        }
        Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, ExportBoardFEN.PieceChar);
        Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, ExportBoardFEN.PieceChar);
        If (((ExportBoardFEN.SqIdx % 8) == 0) And (ExportBoardFEN.SqIdx < 64))
        {
            Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, "/");
            Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, "/");
        }
        ExportBoardFEN.SqIdx += 1;
    }
    If (((Glob.Game.IsPlayerBlack == 1) And (ExportBoardFEN.IsPlayerTurn == 1)) Or ((Not ((Glob.Game.IsPlayerBlack == 1))) And (Not ((ExportBoardFEN.IsPlayerTurn == 1)))))
    {
        Call EBFEN.AppendField("b");
        ExportBoardFEN.BlackToMove = 1;
    }
    Else
    {
        Call EBFEN.AppendField("w");
        ExportBoardFEN.BlackToMove = 0;
    }
    Ret.ExportBoardFEN.IsWhite = (1 - ExportBoardFEN.BlackToMove);
    ExportBoardFEN.CS = CastlingState[ExportBoardFEN.StateIdx];
    If (ExportBoardFEN.CS == Const.Null)
    {
        ExportBoardFEN.CS = ((((Glob.Board.HasOwnCastled * CastlingStatePow2[1]) + (Glob.Board.HasOwnKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasOwnRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasOwnRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasOppCastled * CastlingStatePow2[5]) + (Glob.Board.HasOppKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasOppRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasOppRookQSMoved * CastlingStatePow2[8]))));
    }
    ExportBoardFEN.WhiteOff = 4;
    ExportBoardFEN.BlackOff = 0;
    If (Glob.Game.IsPlayerBlack == 1)
    {
        ExportBoardFEN.WhiteOff = 0;
        ExportBoardFEN.BlackOff = 4;
    }
    ExportBoardFEN.Castling = "";
    Call EBFEN.AddCastling(ExportBoardFEN.CS)(ExportBoardFEN.WhiteOff)(61)(GoK_OppKing)(GoK_OppRook)(64)(57)("K")("Q");
    ExportBoardFEN.Castling = Operator.Join(ExportBoardFEN.Castling, Ret.EBFEN.AddCastling.Text);
    Call EBFEN.AddCastling(ExportBoardFEN.CS)(ExportBoardFEN.BlackOff)(5)(GoK_OwnKing)(GoK_OwnRook)(8)(1)("k")("q");
    ExportBoardFEN.Castling = Operator.Join(ExportBoardFEN.Castling, Ret.EBFEN.AddCastling.Text);
    If (Variable.Length(ExportBoardFEN.Castling) == 0)
    {
        ExportBoardFEN.Castling = "-";
    }
    Call EBFEN.AppendField(ExportBoardFEN.Castling);
    ExportBoardFEN.EPText = "-";
    ExportBoardFEN.EPSq = 0;
    ExportBoardFEN.EPX = 0;
    ExportBoardFEN.EP = EnPassantTarget[ExportBoardFEN.StateIdx];
    If ((Not ((ExportBoardFEN.EP == Const.Null))) And (ExportBoardFEN.EP > 0))
    {
        ExportBoardFEN.EPX = ExportBoardFEN.EP;
        If (Glob.Game.IsPlayerBlack == 1)
        {
            ExportBoardFEN.EPX = RankFlipIdx[ExportBoardFEN.EP];
        }
        If ((ExportBoardFEN.EPX > 32) And (ExportBoardFEN.EPX < 41))
        {
            If (ExportBoardFEN.BlackToMove == 1)
            {
                ExportBoardFEN.EPSq = (ExportBoardFEN.EPX + 8);
            }
        }
        If ((ExportBoardFEN.EPX > 24) And (ExportBoardFEN.EPX < 33))
        {
            If (ExportBoardFEN.BlackToMove == 0)
            {
                ExportBoardFEN.EPSq = (ExportBoardFEN.EPX - 8);
            }
        }
    }
    If (ExportBoardFEN.EPSq > 0)
    {
        ExportBoardFEN.EPText = Operator.Join(Operator.LetterOf("abcdefgh", (((ExportBoardFEN.EPSq - 1) % 8) + 1)), (9 - ceiling((ExportBoardFEN.EPSq / 8))));
    }
    Call EBFEN.AppendField(ExportBoardFEN.EPText);
    ExportBoardFEN.Halfmove = 0;
    If (List.Length(BoardHistoryFiftyMoves) > 0)
    {
        ExportBoardFEN.Halfmove = BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)];
    }
    Call EBFEN.AppendField(ExportBoardFEN.Halfmove);
    ExportBoardFEN.F0 = (Glob.Game.FenFullMove + floor((((List.Length(GameMovesAN) - Glob.Game.FenPlyBase) + Glob.Game.FenBlackToMove) / 2)));
    ExportBoardFEN.Fullmove = ExportBoardFEN.F0;
    If (Ply > 1)
    {
        ExportBoardFEN.R = 0;
        If (Not ((Glob.Game.IsPlayerBlack == 1)))
        {
            ExportBoardFEN.R = 1;
        }
        ExportBoardFEN.Fullmove = (ExportBoardFEN.F0 + floor((((Ply - 1) + ExportBoardFEN.R) / 2)));
    }
    Call EBFEN.AppendField(ExportBoardFEN.Fullmove);
}

Define ExportMovesPGN (warp=true)
{
    ExportMovesPGN.GameMovesANIdx = 1;
    Ret.ExportMovesPGN.PGN = "";
    Repeat (List.Length(GameMovesAN))
    {
        If ((ExportMovesPGN.GameMovesANIdx % 2) == 1)
        {
            Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join((((ExportMovesPGN.GameMovesANIdx - 1) / 2) + 1), ". "));
        }
        Ret.ExportMovesPGN.PGN = Operator.Join(Ret.ExportMovesPGN.PGN, Operator.Join(GameMovesAN[ExportMovesPGN.GameMovesANIdx], " "));
        ExportMovesPGN.GameMovesANIdx += 1;
    }
}

Define FillBoard (warp=true)
{
    List.DeleteAll(GoK_ScreenIdx);
    FillBoard.ScreenSqIdx = 1;
    Repeat (64)
    {
        If (Glob.Game.IsPlayerBlack == 1)
        {
            List.Add(GoK_ScreenIdx, (((IdxToRank[FillBoard.ScreenSqIdx] - 1) * 8) + (9 - IdxToFile[FillBoard.ScreenSqIdx])));
        }
        Else
        {
            List.Add(GoK_ScreenIdx, FillBoard.ScreenSqIdx);
        }
        FillBoard.ScreenSqIdx += 1;
    }
    List.DeleteItem(Board, all);
    Repeat (64)
    {
        List.Add(Board, 0);
    }
    List.ReplaceItem(Board, 1, GoK_OwnRook);
    List.ReplaceItem(Board, 2, GoK_OwnKnight);
    List.ReplaceItem(Board, 3, GoK_OwnBishop);
    List.ReplaceItem(Board, 4, GoK_OwnQueen);
    List.ReplaceItem(Board, 5, GoK_OwnKing);
    List.ReplaceItem(Board, 6, GoK_OwnBishop);
    List.ReplaceItem(Board, 7, GoK_OwnKnight);
    List.ReplaceItem(Board, 8, GoK_OwnRook);
    FillBoard.SqIdx = 9;
    Repeat (8)
    {
        List.ReplaceItem(Board, FillBoard.SqIdx, GoK_OwnPawn);
        FillBoard.SqIdx += 1;
    }
    FillBoard.SqIdx = 49;
    Repeat (8)
    {
        List.ReplaceItem(Board, FillBoard.SqIdx, GoK_OppPawn);
        FillBoard.SqIdx += 1;
    }
    List.ReplaceItem(Board, 57, GoK_OppRook);
    List.ReplaceItem(Board, 58, GoK_OppKnight);
    List.ReplaceItem(Board, 59, GoK_OppBishop);
    List.ReplaceItem(Board, 60, GoK_OppQueen);
    List.ReplaceItem(Board, 61, GoK_OppKing);
    List.ReplaceItem(Board, 62, GoK_OppBishop);
    List.ReplaceItem(Board, 63, GoK_OppKnight);
    List.ReplaceItem(Board, 64, GoK_OppRook);
}

Define FindAndAddSafePawnPush(string SourceIdx)(string TargetIdx)(string AttackedPiece)(string Factor) (warp=true)
{
    If ((TargetIdx > 8) And (TargetIdx < 57))
    {
        If ((Board[(SourceIdx + 0)] == (GoK_OppPawn * Factor)) And (Board[(TargetIdx + 0)] == 0))
        {
            If ((Not ((abs((TargetIdx - SourceIdx)) == 16))) Or (Board[((TargetIdx + SourceIdx) / 2)] == 0))
            {
                If (((AttackedPiece < 0) And ((BoardAttacked[(TargetIdx + 64)] == 0) Or (Board[BoardAttackedPiece[(TargetIdx + 64)]] < GoK_OppPawn))) Or ((AttackedPiece > 0) And ((BoardAttacked[(TargetIdx + 0)] == 0) Or (Board[BoardAttackedPiece[(TargetIdx + 0)]] > GoK_OwnPawn))))
                {
                    If (((AttackedPiece < 0) And ((BoardAttacked[(TargetIdx + 64)] == 0) Or (BoardAttacked[(TargetIdx + 0)] > 0))) Or ((AttackedPiece > 0) And ((BoardAttacked[(TargetIdx + 0)] == 0) Or (BoardAttacked[(TargetIdx + 64)] > 0))))
                    {
                        If (Glob.Eval.SafePawnPushCredited == 0)
                        {
                            Call TaperedEval.Add((-24 * Factor))((-19.5 * Factor))("Eval.Threats.SafePawnPush")("")("")(((SourceIdx * 100) + TargetIdx));
                            Glob.Eval.SafePawnPushCredited = 1;
                        }
                    }
                }
            }
        }
    }
}

Define GenerateMovesForSource(string Ply)(string SourceIdx)(bool CalcAttackState)(bool CapturesOnly)(bool QuietsOnly)(bool QuietChecks)(bool WithMobility) (warp=true)
{
    GenerateMovesForSource.PieceType = (Board[(SourceIdx + 0)] + 0);
    GenerateMovesForSource.File = (IdxToFile[(SourceIdx + 0)] + 0);
    GenerateMovesForSource.Rank = (IdxToRank[(SourceIdx + 0)] + 0);
    Call //("Pawn moves (generated via code logic)");
    If (GenerateMovesForSource.PieceType == GoK_OwnPawn)
    {
        If (GenerateMovesForSource.File > 1)
        {
            If (CalcAttackState Or (Board[(SourceIdx + 7)] < 0))
            {
                If ((Not (QuietsOnly)) Or (GenerateMovesForSource.Rank == 7))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 7))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
            }
        }
        If (GenerateMovesForSource.File < 8)
        {
            If (CalcAttackState Or (Board[(SourceIdx + 9)] < 0))
            {
                If ((Not (QuietsOnly)) Or (GenerateMovesForSource.Rank == 7))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 9))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
            }
        }
        If (Not (CalcAttackState))
        {
            If (Board[(SourceIdx + 8)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQMove(SourceIdx)((SourceIdx + 8))(GoK_OwnPawn)(Ply)(QuietChecks);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx + 8))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
                If ((GenerateMovesForSource.Rank == 2) And (Board[(SourceIdx + 16)] == 0))
                {
                    If CapturesOnly
                    {
                        Call AddPotentialQMove(SourceIdx)((SourceIdx + 16))(GoK_OwnPawn)(Ply)(QuietChecks);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx + 16))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            GenerateMovesForSource.TargetIdx = EnPassantTarget[Ply];
            If ((Not (CalcAttackState)) And (IdxToRank[(SourceIdx + 0)] == IdxToRank[GenerateMovesForSource.TargetIdx]))
            {
                If (abs((IdxToFile[(SourceIdx + 0)] - IdxToFile[GenerateMovesForSource.TargetIdx])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((GenerateMovesForSource.TargetIdx + 8))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
            }
        }
        Stop(this script);
    }
    If (GenerateMovesForSource.PieceType == GoK_OppPawn)
    {
        If (GenerateMovesForSource.File > 1)
        {
            If (CalcAttackState Or (Board[(SourceIdx - 9)] > 0))
            {
                If ((Not (QuietsOnly)) Or (GenerateMovesForSource.Rank == 2))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 9))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
            }
        }
        If (GenerateMovesForSource.File < 8)
        {
            If (CalcAttackState Or (Board[(SourceIdx - 7)] > 0))
            {
                If ((Not (QuietsOnly)) Or (GenerateMovesForSource.Rank == 2))
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 7))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
            }
        }
        If (Not (CalcAttackState))
        {
            If (Board[(SourceIdx - 8)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQMove(SourceIdx)((SourceIdx - 8))(GoK_OppPawn)(Ply)(QuietChecks);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)((SourceIdx - 8))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
                If ((GenerateMovesForSource.Rank == 7) And (Board[(SourceIdx - 16)] == 0))
                {
                    If CapturesOnly
                    {
                        Call AddPotentialQMove(SourceIdx)((SourceIdx - 16))(GoK_OppPawn)(Ply)(QuietChecks);
                    }
                    Else
                    {
                        Call AddMoveImpl(SourceIdx)((SourceIdx - 16))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                    }
                }
            }
        }
        If (Not ((EnPassantTarget[Ply] == Const.Null)))
        {
            GenerateMovesForSource.TargetIdx = EnPassantTarget[Ply];
            If ((Not (CalcAttackState)) And (GenerateMovesForSource.Rank == IdxToRank[(GenerateMovesForSource.TargetIdx + 0)]))
            {
                If (abs((GenerateMovesForSource.File - IdxToFile[(GenerateMovesForSource.TargetIdx + 0)])) == 1)
                {
                    Call AddMoveImpl(SourceIdx)((GenerateMovesForSource.TargetIdx - 8))(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
                }
            }
        }
        Stop(this script);
    }
    Call //("Non-pawn moves (generated via lookup tables)");
    GenerateMovesForSource.PieceType = abs(GenerateMovesForSource.PieceType);
    If (GenerateMovesForSource.PieceType == GoK_OwnRook)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 1))(QuietsOnly)(QuietChecks)(WithMobility);
        Stop(this script);
    }
    If (GenerateMovesForSource.PieceType == GoK_OwnBishop)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 0))(QuietsOnly)(QuietChecks)(WithMobility);
        Stop(this script);
    }
    If (GenerateMovesForSource.PieceType == GoK_OwnKnight)
    {
        Call AddLookupMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 0))(QuietsOnly)(QuietChecks)(WithMobility);
        Stop(this script);
    }
    If (GenerateMovesForSource.PieceType == GoK_OwnKing)
    {
        Call AddLookupMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 1))(QuietsOnly)(QuietChecks)(WithMobility);
        Stop(this script);
    }
    If (GenerateMovesForSource.PieceType == GoK_OwnQueen)
    {
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 1))(QuietsOnly)(QuietChecks)(WithMobility);
        Call AddSlidingMove(SourceIdx)(Ply)(CalcAttackState)(CapturesOnly)((1 == 0))(QuietsOnly)(QuietChecks)(WithMobility);
        Stop(this script);
    }
}

Define GenerateMovesForSourceEx(string Ply)(string SourceIdx)(bool CalcAttackState)(bool CapturesOnly) (warp=true)
{
    List.DeleteAll(CalcMovesMoveList);
    List.DeleteAll(CalcMovesScoreList);
    GenerateMovesForSourceEx.QuietChecks = 0;
    If (((PlyIsOwn[Ply] == 1) And (Board[(SourceIdx + 0)] > 0)) Or ((PlyIsOwn[Ply] == 0) And (Board[(SourceIdx + 0)] < 0)))
    {
        If CapturesOnly
        {
            Call IsQuiescentCheckCond(Ply);
            GenerateMovesForSourceEx.QuietChecks = Ret.IsQuiescentCheckCond.IsTrue;
        }
        Call GenerateMovesForSource(Ply)(SourceIdx)(CalcAttackState)(CapturesOnly)((1 == 0))((GenerateMovesForSourceEx.QuietChecks == 1))((1 == 0));
        Call SortMoveList(Ply);
    }
}

Define GenerateMovesImpl(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool IsBlackMove)(bool QuietsOnly)(bool QuietChecks)(bool WithMobility) (warp=true)
{
    If ((CheckedState[Ply] == 1) And (Not (CalcAttackState)))
    {
        Call PrepareEvasionMask(Ply);
    }
    GenerateMovesImpl.SkipIdx = -1;
    List.DeleteAll(CalcMovesScoreList);
    List.DeleteAll(CalcMovesMoveList);
    Call PrepareKillers(Ply);
    Call ClearMoveList(Ply);
    GenerateMovesImpl.SourceSqIdx = 1;
    Repeat (64)
    {
        If (Not ((GenerateMovesImpl.SourceSqIdx == GenerateMovesImpl.SkipIdx)))
        {
            GenerateMovesImpl.Piece = (Board[GenerateMovesImpl.SourceSqIdx] + 0);
            If ((IsBlackMove And (GenerateMovesImpl.Piece > 0)) Or ((Not (IsBlackMove)) And (GenerateMovesImpl.Piece < 0)))
            {
                Call GenerateMovesForSource(Ply)(GenerateMovesImpl.SourceSqIdx)(CalcAttackState)(CapturesOnly)(QuietsOnly)(QuietChecks)(WithMobility);
            }
        }
        GenerateMovesImpl.SourceSqIdx += 1;
    }
    Call //("Castling moves");
    If ((Not (CalcAttackState)) And (Not (CapturesOnly)))
    {
        If IsBlackMove
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 1)] == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 2)] == 0)))
            {
                If (CastlingBit[((8 * CastlingState[Ply]) + 4)] == 0)
                {
                    If ((((Board[1] == GoK_OwnRook) And (Board[2] == 0)) And ((Board[3] == 0) And (Board[4] == 0))) And (Board[5] == GoK_OwnKing))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 3)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 4)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OwnQueensideCastling)(Ply);
                        }
                    }
                }
                If (CastlingBit[((8 * CastlingState[Ply]) + 3)] == 0)
                {
                    If (((Board[5] == GoK_OwnKing) And (Board[6] == 0)) And ((Board[7] == 0) And (Board[8] == GoK_OwnRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 5)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 6)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 7)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OwnKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
        Else
        {
            If (((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 5)] == 0)) And ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + 6)] == 0)))
            {
                If (CastlingBit[((8 * CastlingState[Ply]) + 8)] == 0)
                {
                    If (((Board[57] == GoK_OppRook) And (Board[58] == 0)) And ((Board[59] == 0) And ((Board[60] == 0) And (Board[61] == GoK_OppKing))))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 59)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 60)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OppQueensideCastling)(Ply);
                        }
                    }
                }
                If (CastlingBit[((8 * CastlingState[Ply]) + 7)] == 0)
                {
                    If (((Board[62] == 0) And (Board[61] == GoK_OppKing)) And ((Board[63] == 0) And (Board[64] == GoK_OppRook)))
                    {
                        If ((BoardAttackedCalculated[Ply] == 0) Or ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 61)] == 0) And ((PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 62)] == 0) And (PersistedBoardAttackedSnapshot[(((Ply - 1) * Const.SnapshotPlyStride) + 63)] == 0))))
                        {
                            Call AddSpecialMove(GoK_OppKingsideCastling)(Ply);
                        }
                    }
                }
            }
        }
    }
    Call //("Move ordering");
    If ((Not (CalcAttackState)) And (Not (QuietsOnly)))
    {
        Call SortMoveList(Ply);
    }
}

Define GenerateMovesImplWrapper(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool QuietsOnly)(bool WithMobility) (warp=true)
{
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        If CalcAttackState
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.AttackGenBaseIdx)(Ply)(-1);
        }
        Else
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.MoveGenBaseIdx)(Ply)(-1);
        }
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call Profile_MethodEnter(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * CapturesOnly)) - ((2 * Const.MaxPlyStackFrames) * CalcAttackState)) + Ply));
    }
    Call TaperedEval.Init;
    GenerateMovesImplWrapper.QuietChecks = 0;
    If CapturesOnly
    {
        Call IsQuiescentCheckCond(Ply);
        GenerateMovesImplWrapper.QuietChecks = Ret.IsQuiescentCheckCond.IsTrue;
    }
    Call GenerateMovesImpl(Ply)(CalcAttackState)(CapturesOnly)((PlyIsOwn[Ply] == 1))(QuietsOnly)((GenerateMovesImplWrapper.QuietChecks == 1))(WithMobility);
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call Profile_MethodExit(((((3 * Const.MaxPlyStackFrames) - (Const.MaxPlyStackFrames * CapturesOnly)) - ((2 * Const.MaxPlyStackFrames) * CalcAttackState)) + Ply));
    }
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        If CalcAttackState
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.AttackGenBaseIdx)(Ply)(1);
        }
        Else
        {
            Call Profile_TimeByHorizon(Const.ProfileTime.MoveGenBaseIdx)(Ply)(1);
        }
    }
}

Define GenerateMovesPublic(string Ply) (warp=true)
{
    GenerateMovesPublic.SqIdx = 1;
    Repeat (64)
    {
        If (Board[GenerateMovesPublic.SqIdx] == GoK_OppKing)
        {
            Glob.Board.OppKingIdx = GenerateMovesPublic.SqIdx;
        }
        Else
        {
            If (Board[GenerateMovesPublic.SqIdx] == GoK_OwnKing)
            {
                Glob.Board.OwnKingIdx = GenerateMovesPublic.SqIdx;
            }
        }
        GenerateMovesPublic.SqIdx += 1;
    }
    Call CalcBoardAttackedByMove((Ply + 1))((1 == 0));
    Call StoreAttackInfo((Ply + 1))(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call SetInitialEP(Ply);
    List.ReplaceItem(CastlingState, Ply, ((((Glob.Board.HasOwnCastled * CastlingStatePow2[1]) + (Glob.Board.HasOwnKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasOwnRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasOwnRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasOppCastled * CastlingStatePow2[5]) + (Glob.Board.HasOppKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasOppRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasOppRookQSMoved * CastlingStatePow2[8])))));
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0))((1 == 0))((1 == 0));
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    List.ReplaceItem(CastlingState, Ply, Const.Null);
}

Define GetAttackForce(bool Black) (warp=true)
{
    If Black
    {
        Ret.GetAttackForce.Force = ((Glob.Board.OwnQueenCount * 14) + ((Glob.Board.OwnRookCount * 6) + ((Glob.Board.OwnNonQueenMajorMinorCount - Glob.Board.OwnRookCount) * 3)));
    }
    Else
    {
        Ret.GetAttackForce.Force = ((Glob.Board.OppQueenCount * 14) + ((Glob.Board.OppRookCount * 6) + ((Glob.Board.OppNonQueenMajorMinorCount - Glob.Board.OppRookCount) * 3)));
    }
}

Define GetBoardString (warp=true)
{
    GetBoardString.SqIdx = 1;
    Ret.GetBoardString.BoardString = "";
    Repeat (64)
    {
        Ret.GetBoardString.BoardString = Operator.Join(Ret.GetBoardString.BoardString, Operator.Join(Board[GetBoardString.SqIdx], ","));
        GetBoardString.SqIdx += 1;
    }
}

Define GetCalibratedEval(string Ply) (warp=true)
{
    Ret.GetCalibratedEval.Score = Const.Null;
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        Ret.GetCalibratedEval.Score = StaticEval[Ply];
        If ((NodeTTHit[Ply] == 1) And (Not ((NodeTTScore[Ply] == Const.Null))))
        {
            GetCalibratedEval.TTType = NodeTTType[Ply];
            GetCalibratedEval.TTScore = NodeTTScore[Ply];
            GetCalibratedEval.StaticEval = StaticEval[Ply];
            GetCalibratedEval.IsTTScoreUsable = 0;
            If (GetCalibratedEval.TTType == Const.TTType.Exact)
            {
                GetCalibratedEval.IsTTScoreUsable = 1;
            }
            Else
            {
                If (GetCalibratedEval.TTType == Const.TTType.HighBound)
                {
                    If (GetCalibratedEval.TTScore < GetCalibratedEval.StaticEval)
                    {
                        GetCalibratedEval.IsTTScoreUsable = 1;
                    }
                }
                Else
                {
                    If (GetCalibratedEval.TTType == Const.TTType.LowBound)
                    {
                        If (GetCalibratedEval.TTScore > GetCalibratedEval.StaticEval)
                        {
                            GetCalibratedEval.IsTTScoreUsable = 1;
                        }
                    }
                }
            }
            If (GetCalibratedEval.IsTTScoreUsable == 1)
            {
                If (Not ((abs(NodeTTScore[Ply]) > Const.AbsMinCheckmateEval)))
                {
                    Ret.GetCalibratedEval.Score = NodeTTScore[Ply];
                }
            }
        }
    }
}

Define GetCorrHistIndices(string Ply) (warp=true)
{
    Ret.GetCorrHistIndices.PawnKey = Glob.Board.KPHash;
    Call GetPiecePosHash(GoK_OwnKing)(Glob.Board.OwnKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Call GetPiecePosHash(GoK_OppKing)(Glob.Board.OppKingIdx);
    Ret.GetCorrHistIndices.PawnKey = (Ret.GetCorrHistIndices.PawnKey - Ret.GetPiecePosHash.Hash);
    Ret.GetCorrHistIndices.CorrIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.PawnKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnOwnKey = Glob.Board.NonPawnHashOwn;
    Ret.GetCorrHistIndices.NonPawnOwnIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnOwnKey % 100000)) + 1);
    Ret.GetCorrHistIndices.NonPawnOppKey = Glob.Board.NonPawnHashOpp;
    Ret.GetCorrHistIndices.NonPawnOppIdx = ((PlyCorrectionBaseIdx[Ply] + (Ret.GetCorrHistIndices.NonPawnOppKey % 100000)) + 1);
    Ret.GetCorrHistIndices.ContIdx2 = Const.Null;
    Ret.GetCorrHistIndices.ContIdx4 = Const.Null;
    If ((Ply > 2) And (Glob.Config.IsScratch3 == 0))
    {
        If ((Not ((AppliedMove[(Ply - 1)] == 0))) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            GetCorrHistIndices.PieceTo1 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] - 1) + (6 * (SourcePieces[(Ply - 1)] < 0))) * 64) + floor((AppliedMove[(Ply - 1)] % 100)));
            GetCorrHistIndices.PieceTo2 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] - 1) + (6 * (SourcePieces[(Ply - 2)] < 0))) * 64) + floor((AppliedMove[(Ply - 2)] % 100)));
            Ret.GetCorrHistIndices.ContIdx2 = ((((PlyIsOwn[Ply] * 646416) + (GetCorrHistIndices.PieceTo1 * 804)) + GetCorrHistIndices.PieceTo2) + 1);
            If (Ply > 4)
            {
                If (Not ((AppliedMove[(Ply - 4)] == 0)))
                {
                    GetCorrHistIndices.PieceTo4 = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] - 1) + (6 * (SourcePieces[(Ply - 4)] < 0))) * 64) + floor((AppliedMove[(Ply - 4)] % 100)));
                    Ret.GetCorrHistIndices.ContIdx4 = ((((PlyIsOwn[Ply] * 646416) + (GetCorrHistIndices.PieceTo1 * 804)) + GetCorrHistIndices.PieceTo4) + 1);
                }
            }
        }
    }
}

Define GetCurrentMove(num Ply) (warp=true)
{
    Ret.GetCurrentMove.Move = Moves[(((Ply - 1) * Const.MaxMovesPerGeneration) + MovesIdx[Ply])];
}

Define GetEndgameLocal (warp=true)
{
    Call GetAttackForce((1 == 0));
    Call GetAttackForce((1 == 1));
}

Define GetHashfull(string Age) (warp=true)
{
    Ret.GetHashfull.Permill = 0;
    GetHashfull.Span = (Age - (floor((Age / 100)) * 100));
    GetHashfull.AgeNow = (Age % 131072);
    GetHashfull.Idx = 1;
    Repeat (1000)
    {
        If (Not ((TTNodeEntry[(GetHashfull.Idx + Const.TTNodeCol.HashIdx)] == Const.Null)))
        {
            GetHashfull.Diff = (GetHashfull.AgeNow - floor((TTNodeEntry[(GetHashfull.Idx + Const.TTNodeCol.MetaIdx)] / 16384)));
            If ((Not ((GetHashfull.Diff < 0))) And (Not ((GetHashfull.Diff > GetHashfull.Span))))
            {
                Ret.GetHashfull.Permill += 1;
            }
        }
        GetHashfull.Idx += Const.TTNodeEntrySize;
    }
}

Define GetHistoryStatScore(string SourcePieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply)(string KPHash) (warp=true)
{
    GetHistoryStatScore.PieceToKey = 0;
    Ret.GetHistoryStatScore.Score = 0;
    Ret.GetHistoryStatScore.MainScore = 0;
    Ret.GetHistoryStatScore.Cont1Score = 0;
    Ret.GetHistoryStatScore.Cont2Score = 0;
    Ret.GetHistoryStatScore.Cont4Score = 0;
    If (floor((Move / 100)) == 0)
    {
        Ret.GetHistoryStatScore.MainScore = HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))];
        Ret.GetHistoryStatScore.Score += (2 * Ret.GetHistoryStatScore.MainScore);
        GetHistoryStatScore.PieceToKey = ((PieceIdxLookup[GoK_OwnKing] * 68) + ToIdx);
    }
    Else
    {
        If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
        {
            Ret.GetHistoryStatScore.MainScore = HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))];
            Ret.GetHistoryStatScore.Score += (2 * Ret.GetHistoryStatScore.MainScore);
            GetHistoryStatScore.PieceToKey = ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx);
        }
    }
    GetHistoryStatScore.Idx = -1;
    If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
    {
        If (1 == 1)
        {
            GetHistoryStatScore.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + GetHistoryStatScore.PieceToKey);
        }
    }
    If (Not ((GetHistoryStatScore.Idx == -1)))
    {
        Ret.GetHistoryStatScore.Cont1Score = HistoryContinuation[(PlyContinuationBaseIdx[Ply] + (GetHistoryStatScore.Idx + 0))];
        Ret.GetHistoryStatScore.Score += (Ret.GetHistoryStatScore.Cont1Score * 2);
    }
    If (1 == 1)
    {
        If ((Ply > 2) And (Not ((AppliedMove[(Ply - 2)] == 0))))
        {
            If (1 == 1)
            {
                GetHistoryStatScore.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 2)])] * 68) + floor((AppliedMove[(Ply - 2)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                Ret.GetHistoryStatScore.Cont2Score = HistoryContinuation2[(PlyContinuationBaseIdx[Ply] + (GetHistoryStatScore.Idx + 0))];
                Ret.GetHistoryStatScore.Score += (Ret.GetHistoryStatScore.Cont2Score * 1);
            }
        }
    }
    If ((Ply > 4) And (Not ((AppliedMove[(Ply - 4)] == 0))))
    {
        Ret.GetHistoryStatScore.Cont4Score = HistoryContinuation3[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 4)])] * 68) + floor((AppliedMove[(Ply - 4)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))];
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * Ret.GetHistoryStatScore.Cont4Score));
    }
    If ((Ply > 6) And (Not ((AppliedMove[(Ply - 6)] == 0))))
    {
        Ret.GetHistoryStatScore.Score = (Ret.GetHistoryStatScore.Score + (1 * HistoryContinuation4[(PlyContinuationBaseIdx[Ply] + ((((PieceIdxLookup[abs(SourcePieces[(Ply - 6)])] * 68) + floor((AppliedMove[(Ply - 6)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx)))]));
    }
    Call ProbePawnHist(SourcePieceParam)(ToIdx)(KPHash);
    Ret.GetHistoryStatScore.Score += (HistoryPawnHist[Ret.ProbePawnHist.Idx] * 2);
}

Define GetImproving(string Ply) (warp=true)
{
    If (Improving[Ply] == Const.Null)
    {
        Call GetImprovingImpl(Ply);
        List.ReplaceItem(Improving, Ply, Ret.GetImprovingImpl.IsImproving);
    }
    Ret.GetImproving.IsImproving = Improving[Ply];
}

Define GetImprovingImpl(string Ply) (warp=true)
{
    If (CheckedState[Ply] == 1)
    {
        Ret.GetImprovingImpl.IsImproving = 0;
        Stop(this script);
    }
    If (Ply > 1)
    {
        If (AppliedMove[(Ply - 1)] == 0)
        {
            Ret.GetImprovingImpl.IsImproving = 0;
            Stop(this script);
        }
    }
    Ret.GetImprovingImpl.IsImproving = Const.Null;
    If (Not ((StaticEval[Ply] == Const.Null)))
    {
        GetImprovingImpl.StaticEvalIdx = (Ply - 2);
        If (GetImprovingImpl.StaticEvalIdx > 0)
        {
            If (StaticEval[GetImprovingImpl.StaticEvalIdx] == Const.Null)
            {
                GetImprovingImpl.StaticEvalIdx = (GetImprovingImpl.StaticEvalIdx - 2);
            }
        }
        If ((GetImprovingImpl.StaticEvalIdx > 0) And (Not ((StaticEval[GetImprovingImpl.StaticEvalIdx] == Const.Null))))
        {
            If (StaticEval[Ply] > StaticEval[GetImprovingImpl.StaticEvalIdx])
            {
                Ret.GetImprovingImpl.IsImproving = 1;
            }
            Else
            {
                Ret.GetImprovingImpl.IsImproving = 0;
            }
        }
    }
}

Define GetKingShelterStorm(string KingIdx)(bool IsBlack)(string ShelterFactor) (warp=true)
{
    GetKingShelterStorm.KingRank = (IdxToRank[(KingIdx + 0)] + 0);
    GetKingShelterStorm.KingFile = (IdxToFile[(KingIdx + 0)] + 0);
    Ret.GetKingShelterStorm.Score = 2.5;
    Ret.GetKingShelterStorm.ScoreEg = 2.5;
    If IsBlack
    {
        GetKingShelterStorm.OurSemi = ((PawnAdvancePerFile[(GetKingShelterStorm.KingFile + Const.PawnAdvance.OwnRear)] == 0) + 0);
        GetKingShelterStorm.TheirSemi = ((PawnAdvancePerFile[(GetKingShelterStorm.KingFile + Const.PawnAdvance.OppFront)] == 0) + 0);
    }
    Else
    {
        GetKingShelterStorm.OurSemi = ((PawnAdvancePerFile[(GetKingShelterStorm.KingFile + Const.PawnAdvance.OppRear)] == 0) + 0);
        GetKingShelterStorm.TheirSemi = ((PawnAdvancePerFile[(GetKingShelterStorm.KingFile + Const.PawnAdvance.OwnFront)] == 0) + 0);
    }
    Ret.GetKingShelterStorm.Score += ((0 - KingOnFile[(((GetKingShelterStorm.OurSemi * 2) + GetKingShelterStorm.TheirSemi) + 1)]) * ShelterFactor);
    Ret.GetKingShelterStorm.ScoreEg += ((0 - KingOnFileEg[(((GetKingShelterStorm.OurSemi * 2) + GetKingShelterStorm.TheirSemi) + 1)]) * ShelterFactor);
    If (GetKingShelterStorm.KingFile == 1)
    {
        GetKingShelterStorm.KingFile = 2;
    }
    Else
    {
        If (GetKingShelterStorm.KingFile == 8)
        {
            GetKingShelterStorm.KingFile = 7;
        }
    }
    If IsBlack
    {
        GetKingShelterStorm.File = (GetKingShelterStorm.KingFile - 1);
        Repeat (3)
        {
            GetKingShelterStorm.OppPawnForwardRank = (PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OppFront)] + 0);
            GetKingShelterStorm.OwnPawnBackwardRank = (PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OwnRear)] + 0);
            If ((GetKingShelterStorm.OwnPawnBackwardRank > 0) And ((GetKingShelterStorm.KingRank > GetKingShelterStorm.OwnPawnBackwardRank) Or ((GetKingShelterStorm.OwnPawnBackwardRank < 8) And (((GetKingShelterStorm.File > 1) And (Board[((GetKingShelterStorm.OwnPawnBackwardRank * 8) + (GetKingShelterStorm.File + -1))] == GoK_OppPawn)) Or ((GetKingShelterStorm.File < 8) And (Board[((GetKingShelterStorm.OwnPawnBackwardRank * 8) + (GetKingShelterStorm.File + 1))] == GoK_OppPawn))))))
            {
                GetKingShelterStorm.OwnPawnBackwardRank = 0;
            }
            If ((GetKingShelterStorm.OwnPawnBackwardRank == 0) And (PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OwnFront)] > PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OwnRear)]))
            {
                GetKingShelterStorm.OwnPawnBackwardRank = PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OwnFront)];
                If ((GetKingShelterStorm.OwnPawnBackwardRank > 0) And ((GetKingShelterStorm.KingRank > GetKingShelterStorm.OwnPawnBackwardRank) Or ((GetKingShelterStorm.OwnPawnBackwardRank < 8) And (((GetKingShelterStorm.File > 1) And (Board[((GetKingShelterStorm.OwnPawnBackwardRank * 8) + (GetKingShelterStorm.File + -1))] == GoK_OppPawn)) Or ((GetKingShelterStorm.File < 8) And (Board[((GetKingShelterStorm.OwnPawnBackwardRank * 8) + (GetKingShelterStorm.File + 1))] == GoK_OppPawn))))))
                {
                    GetKingShelterStorm.OwnPawnBackwardRank = 0;
                }
            }
            If ((GetKingShelterStorm.OwnPawnBackwardRank > 0) And (Not ((GetKingShelterStorm.KingRank > GetKingShelterStorm.OwnPawnBackwardRank))))
            {
                Ret.GetKingShelterStorm.Score += (PawnShelter[(((GetKingShelterStorm.File - 1) * 8) + GetKingShelterStorm.OwnPawnBackwardRank)] * ShelterFactor);
            }
            Else
            {
                Ret.GetKingShelterStorm.Score += (PawnShelter[(((GetKingShelterStorm.File - 1) * 8) + 1)] * ShelterFactor);
            }
            If (1 == 1)
            {
                If (((GetKingShelterStorm.OppPawnForwardRank > 0) And (GetKingShelterStorm.KingRank > GetKingShelterStorm.OppPawnForwardRank)) And (Not ((GetKingShelterStorm.KingRank > PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OppRear)]))))
                {
                    GetKingShelterStorm.OppPawnForwardRank = PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OppRear)];
                }
                If ((GetKingShelterStorm.OppPawnForwardRank > 0) And (Not ((GetKingShelterStorm.KingRank > GetKingShelterStorm.OppPawnForwardRank))))
                {
                    If ((GetKingShelterStorm.OwnPawnBackwardRank > 0) And (GetKingShelterStorm.OwnPawnBackwardRank == (GetKingShelterStorm.OppPawnForwardRank - 1)))
                    {
                        Ret.GetKingShelterStorm.Score += (0 - BlockedStorm[GetKingShelterStorm.OppPawnForwardRank]);
                        Ret.GetKingShelterStorm.ScoreEg += (0 - BlockedStormEg[GetKingShelterStorm.OppPawnForwardRank]);
                    }
                    Else
                    {
                        Ret.GetKingShelterStorm.Score += (0 - PawnStorm[(((GetKingShelterStorm.File - 1) * 8) + GetKingShelterStorm.OppPawnForwardRank)]);
                    }
                }
                Else
                {
                    Ret.GetKingShelterStorm.Score += (0 - PawnStorm[(((GetKingShelterStorm.File - 1) * 8) + 1)]);
                }
            }
            GetKingShelterStorm.File += 1;
        }
    }
    Else
    {
        GetKingShelterStorm.File = (GetKingShelterStorm.KingFile - 1);
        Repeat (3)
        {
            GetKingShelterStorm.OppPawnBackwardRank = (PawnAdvancePerFile[GetKingShelterStorm.File] + 0);
            If ((GetKingShelterStorm.OppPawnBackwardRank > 0) And ((GetKingShelterStorm.KingRank < GetKingShelterStorm.OppPawnBackwardRank) Or ((GetKingShelterStorm.OppPawnBackwardRank > 1) And (((GetKingShelterStorm.File > 1) And (Board[(((GetKingShelterStorm.OppPawnBackwardRank - 2) * 8) + (GetKingShelterStorm.File + -1))] == GoK_OwnPawn)) Or ((GetKingShelterStorm.File < 8) And (Board[(((GetKingShelterStorm.OppPawnBackwardRank - 2) * 8) + (GetKingShelterStorm.File + 1))] == GoK_OwnPawn))))))
            {
                GetKingShelterStorm.OppPawnBackwardRank = 0;
            }
            If ((GetKingShelterStorm.OppPawnBackwardRank == 0) And (PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OppFront)] < PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OppRear)]))
            {
                GetKingShelterStorm.OppPawnBackwardRank = PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OppFront)];
                If ((GetKingShelterStorm.OppPawnBackwardRank > 0) And ((GetKingShelterStorm.KingRank < GetKingShelterStorm.OppPawnBackwardRank) Or ((GetKingShelterStorm.OppPawnBackwardRank > 1) And (((GetKingShelterStorm.File > 1) And (Board[(((GetKingShelterStorm.OppPawnBackwardRank - 2) * 8) + (GetKingShelterStorm.File + -1))] == GoK_OwnPawn)) Or ((GetKingShelterStorm.File < 8) And (Board[(((GetKingShelterStorm.OppPawnBackwardRank - 2) * 8) + (GetKingShelterStorm.File + 1))] == GoK_OwnPawn))))))
                {
                    GetKingShelterStorm.OppPawnBackwardRank = 0;
                }
            }
            GetKingShelterStorm.OwnPawnForwardRank = (PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OwnFront)] + 0);
            If ((GetKingShelterStorm.OppPawnBackwardRank > 0) And (Not ((GetKingShelterStorm.KingRank < GetKingShelterStorm.OppPawnBackwardRank))))
            {
                Ret.GetKingShelterStorm.Score += (PawnShelter[((((9 - GetKingShelterStorm.File) - 1) * 8) + (9 - GetKingShelterStorm.OppPawnBackwardRank))] * ShelterFactor);
            }
            Else
            {
                Ret.GetKingShelterStorm.Score += (PawnShelter[((((9 - GetKingShelterStorm.File) - 1) * 8) + 1)] * ShelterFactor);
            }
            If (1 == 1)
            {
                If (((GetKingShelterStorm.OwnPawnForwardRank > 0) And (GetKingShelterStorm.KingRank < GetKingShelterStorm.OwnPawnForwardRank)) And (Not ((GetKingShelterStorm.KingRank < PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OwnRear)]))))
                {
                    GetKingShelterStorm.OwnPawnForwardRank = PawnAdvancePerFile[(GetKingShelterStorm.File + Const.PawnAdvance.OwnRear)];
                }
                If ((GetKingShelterStorm.OwnPawnForwardRank > 0) And (Not ((GetKingShelterStorm.KingRank < GetKingShelterStorm.OwnPawnForwardRank))))
                {
                    If ((GetKingShelterStorm.OppPawnBackwardRank > 0) And (GetKingShelterStorm.OppPawnBackwardRank == (GetKingShelterStorm.OwnPawnForwardRank + 1)))
                    {
                        Ret.GetKingShelterStorm.Score += (0 - BlockedStorm[(9 - GetKingShelterStorm.OwnPawnForwardRank)]);
                        Ret.GetKingShelterStorm.ScoreEg += (0 - BlockedStormEg[(9 - GetKingShelterStorm.OwnPawnForwardRank)]);
                    }
                    Else
                    {
                        Ret.GetKingShelterStorm.Score += (0 - PawnStorm[((((9 - GetKingShelterStorm.File) - 1) * 8) + (9 - GetKingShelterStorm.OwnPawnForwardRank))]);
                    }
                }
                Else
                {
                    Ret.GetKingShelterStorm.Score += (0 - PawnStorm[((((9 - GetKingShelterStorm.File) - 1) * 8) + 1)]);
                }
            }
            GetKingShelterStorm.File += 1;
        }
    }
}

Define GetMoveNotation(num Move) (warp=true)
{
    If (Move == Const.Null)
    {
        Ret.GetMoveNotation.VirtualMove = Const.Null;
        Ret.GetMoveNotation.Notation = "";
        Stop(this script);
    }
    Call GetPhysicalMove(Move);
    Ret.GetMoveNotation.VirtualMove = Ret.GetPhysicalMove.Move;
    Ret.GetMoveNotation.Notation = "";
    If ((Ret.GetPhysicalMove.Move == GoK_OwnKingsideCastling) Or (Ret.GetPhysicalMove.Move == GoK_OppKingsideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O";
        Stop(this script);
    }
    If ((Ret.GetPhysicalMove.Move == GoK_OwnQueensideCastling) Or (Ret.GetPhysicalMove.Move == GoK_OppQueensideCastling))
    {
        Ret.GetMoveNotation.Notation = "O-O-O";
        Stop(this script);
    }
    GetMoveNotation.SourceIdx = floor((Ret.GetPhysicalMove.Move / 100));
    GetMoveNotation.TargetIdx = floor((Ret.GetPhysicalMove.Move % 100));
    GetMoveNotation.Piece = Board[floor((Move / 100))];
    If ((GetMoveNotation.Piece == GoK_OwnBishop) Or (GetMoveNotation.Piece == GoK_OppBishop))
    {
        Ret.GetMoveNotation.Notation = "B";
    }
    If ((GetMoveNotation.Piece == GoK_OwnKing) Or (GetMoveNotation.Piece == GoK_OppKing))
    {
        Ret.GetMoveNotation.Notation = "K";
    }
    If ((GetMoveNotation.Piece == GoK_OwnRook) Or (GetMoveNotation.Piece == GoK_OppRook))
    {
        Ret.GetMoveNotation.Notation = "R";
    }
    If ((GetMoveNotation.Piece == GoK_OwnKnight) Or (GetMoveNotation.Piece == GoK_OppKnight))
    {
        Ret.GetMoveNotation.Notation = "N";
    }
    If ((GetMoveNotation.Piece == GoK_OppQueen) Or (GetMoveNotation.Piece == GoK_OwnQueen))
    {
        Ret.GetMoveNotation.Notation = "Q";
    }
    GetMoveNotation.File = IdxToFile[GetMoveNotation.SourceIdx];
    GetMoveNotation.NotationRank = (9 - IdxToRank[GetMoveNotation.SourceIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", GetMoveNotation.File), GetMoveNotation.NotationRank));
    If (Not ((Board[floor((Move % 100))] == 0)))
    {
        Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "x");
    }
    GetMoveNotation.File = IdxToFile[GetMoveNotation.TargetIdx];
    GetMoveNotation.NotationRank = (9 - IdxToRank[GetMoveNotation.TargetIdx]);
    Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, Operator.Join(Operator.LetterOf("abcdefgh", GetMoveNotation.File), GetMoveNotation.NotationRank));
    If (Operator.LetterOf(Ret.GetPhysicalMove.Move, (Variable.Length(Ret.GetPhysicalMove.Move) - 1)) == ".")
    {
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 1)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=Q");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 2)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=R");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 3)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=B");
        }
        If (Operator.LetterOf(Ret.GetPhysicalMove.Move, Variable.Length(Ret.GetPhysicalMove.Move)) == 4)
        {
            Ret.GetMoveNotation.Notation = Operator.Join(Ret.GetMoveNotation.Notation, "=N");
        }
    }
}

Define GetMoveScore(string SourcePieceParam)(string TargetPieceParam)(string FromIdx)(string ToIdx)(string Move)(string Ply) (warp=true)
{
    Ret.GetMoveScore.Score = 0;
    Call IsMovePicked(Ply)(Move);
    If (Ret.IsMovePicked.Picked == 1)
    {
        Ret.GetMoveScore.Score = Ret.IsMovePicked.Score;
        Stop(this script);
    }
    Call //("1: Hash moves, handled by staged move generator / PickMove()");
    If (CheckedState[Ply] == 1)
    {
        If ((abs(SourcePieceParam) == GoK_OwnKing) Or (BoardAttackedEvasionTarget[ToIdx] == 1))
        {
            Ret.GetMoveScore.Score = 8000000;
            If ((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0))))
            {
                Ret.GetMoveScore.Score += (100000 + ((PieceIdxLookup[abs(TargetPieceParam)] * 100) + (7 - PieceIdxLookup[abs(SourcePieceParam)])));
            }
            Else
            {
                GetMoveScore.ContMoveScore = 0;
                If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
                {
                    GetMoveScore.Idx = ((((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 68) + floor((AppliedMove[(Ply - 1)] % 100))) * 408) + ((PieceIdxLookup[abs(SourcePieceParam)] * 68) + ToIdx));
                    GetMoveScore.ContMoveScore = (2 * HistoryContinuation[(PlyContinuationBaseIdx[Ply] + GetMoveScore.Idx)]);
                }
                Ret.GetMoveScore.Score += ((2 * HistoryMoveScores[(PlyHistoryBaseIdx[Ply] + ((FromIdx * 64) + ToIdx))]) + GetMoveScore.ContMoveScore);
            }
            Stop(this script);
        }
    }
    If (Not ((Move == floor(Move))))
    {
        Call //("Promotions");
        If (((Move * 10) % 10) == 1)
        {
            If (Board[floor((Move % 100))] == 0)
            {
                Ret.GetMoveScore.Score = 7000000;
            }
            Else
            {
                GetMoveScore.PieceIdx = PieceIdxLookup[abs(Board[floor((Move % 100))])];
                GetMoveScore.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((GetMoveScore.PieceIdx - 1) * 64) + floor((Move % 100)))) + (2304 * (SourcePieceParam < 0)));
                Ret.GetMoveScore.Score = ((7000000 + (100000 * GetMoveScore.PieceIdx)) + HistoryCaptureScores[GetMoveScore.BaseIdx]);
            }
            Stop(this script);
        }
        Else
        {
            Call GetHistoryStatScore(SourcePieceParam)(floor((floor(Move) / 100)))(floor((Move % 100)))(floor(Move))(Ply)(Glob.Board.KPHash);
            Ret.GetMoveScore.Score = (2100000 + Ret.GetHistoryStatScore.Score);
            Stop(this script);
        }
    }
    If (((Not ((TargetPieceParam == Const.Null))) And (Not ((TargetPieceParam == 0)))) Or (((abs(SourcePieceParam) == GoK_OwnPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx]))))))
    {
        GetMoveScore.TargetPiece = TargetPieceParam;
        If (((abs(SourcePieceParam) == GoK_OwnPawn) And (TargetPieceParam == 0)) And ((Not ((FromIdx == Const.Null))) And (Not ((IdxToFile[FromIdx] == IdxToFile[ToIdx])))))
        {
            GetMoveScore.TargetPiece = (0 - SourcePieceParam);
        }
        GetMoveScore.BaseIdx = ((((PieceIdxLookup[abs(SourcePieceParam)] - 1) * 384) + (((PieceIdxLookup[abs(GetMoveScore.TargetPiece)] - 1) * 64) + ToIdx)) + (2304 * (SourcePieceParam < 0)));
        GetMoveScore.BaseScore = Const.CaptureGoodBaseScore;
        If ((Not (((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 1)))) And (Not ((PickCaptureStageDone[Ply] == 1))))
        {
            Call IsLosingCapture(Ply)(Move)(SourcePieceParam)(GetMoveScore.TargetPiece);
            If (Ret.IsLosingCapture.IsLosing == 1)
            {
                GetMoveScore.BaseScore = Const.CaptureBadBaseScore;
            }
        }
        Ret.GetMoveScore.Score = ((GetMoveScore.BaseScore + (6 * abs(GetMoveScore.TargetPiece))) + HistoryCaptureScores[GetMoveScore.BaseIdx]);
        Stop(this script);
    }
    Call //("4: Killer moves");
    Call PrepareKillers(Ply);
    If ((Not ((CurrentKillerMoves[1] == Const.Null))) And (CurrentKillerMoves[1] == Move))
    {
        Ret.GetMoveScore.Score = 6000000;
        Stop(this script);
    }
    Else
    {
        If ((Not ((CurrentKillerMoves[2] == Const.Null))) And (CurrentKillerMoves[2] == Move))
        {
            Ret.GetMoveScore.Score = 5000000;
            Stop(this script);
        }
    }
    Call //("5. Counter Moves");
    If ((Ply > 1) And (Not (((AppliedMove[(Ply - 1)] == Const.Null) Or (AppliedMove[(Ply - 1)] == 0)))))
    {
        If (HistoryCounterMoves[(PlyCounterMoveBaseIdx[Ply] + ((PieceIdxLookup[abs(SourcePieces[(Ply - 1)])] * 100) + floor((AppliedMove[(Ply - 1)] % 100))))] == Move)
        {
            Ret.GetMoveScore.Score = 4000000;
            Stop(this script);
        }
    }
    Call //("6: Quiets with high history score");
    Ret.GetMoveScore.Score = 2100000;
    Call GetHistoryStatScore(SourcePieceParam)(FromIdx)(ToIdx)(Move)(Ply)(Glob.Board.KPHash);
    Ret.GetMoveScore.Score += Ret.GetHistoryStatScore.Score;
    If ((Not ((SourcePieceParam == Const.Null))) And (Not ((SourcePieceParam == 0))))
    {
        If (BoardAttackedCalculated[Ply] == 1)
        {
            GetMoveScore.PieceAbs = abs(SourcePieceParam);
            If ((GetMoveScore.PieceAbs > GoK_OwnPawn) And (GetMoveScore.PieceAbs < GoK_OwnKing))
            {
                GetMoveScore.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + FromIdx);
                If (PersistedBoardAttackedSnapshot[GetMoveScore.AttackIdx] > 0)
                {
                    GetMoveScore.ThreatenedByPieceAbs = abs(Board[PersistedBoardAttackerSnapshot[GetMoveScore.AttackIdx]]);
                    If (((GetMoveScore.PieceAbs == GoK_OwnQueen) And (GetMoveScore.ThreatenedByPieceAbs < GoK_OwnQueen)) Or (((GetMoveScore.PieceAbs == GoK_OwnRook) And (GetMoveScore.ThreatenedByPieceAbs < GoK_OwnRook)) Or (((GetMoveScore.PieceAbs == GoK_OwnKnight) Or (GetMoveScore.PieceAbs == GoK_OwnBishop)) And (GetMoveScore.ThreatenedByPieceAbs == GoK_OwnPawn))))
                    {
                        GetMoveScore.ThreatenedByPieceAbs = 0;
                        GetMoveScore.AttackIdx = (((Ply - 1) * Const.SnapshotPlyStride) + ToIdx);
                        If (PersistedBoardAttackedSnapshot[GetMoveScore.AttackIdx] > 0)
                        {
                            GetMoveScore.ThreatenedByPieceAbs = abs(Board[PersistedBoardAttackerSnapshot[GetMoveScore.AttackIdx]]);
                        }
                        If (GetMoveScore.ThreatenedByPieceAbs < GoK_OwnKing)
                        {
                            If ((GetMoveScore.PieceAbs == GoK_OwnQueen) And ((GetMoveScore.ThreatenedByPieceAbs == 0) Or (GetMoveScore.ThreatenedByPieceAbs == GoK_OwnQueen)))
                            {
                                Ret.GetMoveScore.Score += 50000;
                            }
                            Else
                            {
                                If ((GetMoveScore.PieceAbs == GoK_OwnRook) And ((GetMoveScore.ThreatenedByPieceAbs == 0) Or (GetMoveScore.ThreatenedByPieceAbs > GoK_OwnBishop)))
                                {
                                    Ret.GetMoveScore.Score += 25000;
                                }
                                Else
                                {
                                    If ((GetMoveScore.ThreatenedByPieceAbs == 0) Or (GetMoveScore.ThreatenedByPieceAbs > GoK_OwnPawn))
                                    {
                                        Ret.GetMoveScore.Score += 15000;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    If (((abs(SourcePieceParam) == GoK_OwnKnight) Or (abs(SourcePieceParam) == GoK_OwnBishop)) And (BoardAttackedCalculated[Ply] == 0))
    {
        GetMoveScore.PawnThreatFactor = ((PlyIsOwn[Ply] * 2) - 1);
        GetMoveScore.PawnThreatPiece = (GoK_OppPawn * GetMoveScore.PawnThreatFactor);
        GetMoveScore.PawnThreatBaseIdx = (FromIdx + (8 * GetMoveScore.PawnThreatFactor));
        If ((GetMoveScore.PawnThreatBaseIdx > 0) And (GetMoveScore.PawnThreatBaseIdx < 65))
        {
            If (((IdxToFile[FromIdx] > 1) And (Board[(GetMoveScore.PawnThreatBaseIdx - 1)] == GetMoveScore.PawnThreatPiece)) Or ((IdxToFile[FromIdx] < 8) And (Board[(GetMoveScore.PawnThreatBaseIdx + 1)] == GetMoveScore.PawnThreatPiece)))
            {
                Ret.GetMoveScore.Score += 15000;
            }
        }
        GetMoveScore.PawnThreatBaseIdx = (ToIdx + (8 * GetMoveScore.PawnThreatFactor));
        If ((GetMoveScore.PawnThreatBaseIdx > 0) And (GetMoveScore.PawnThreatBaseIdx < 65))
        {
            If (((IdxToFile[ToIdx] > 1) And (Board[(GetMoveScore.PawnThreatBaseIdx - 1)] == GetMoveScore.PawnThreatPiece)) Or ((IdxToFile[ToIdx] < 8) And (Board[(GetMoveScore.PawnThreatBaseIdx + 1)] == GetMoveScore.PawnThreatPiece)))
            {
                Ret.GetMoveScore.Score += -15000;
            }
        }
    }
}

Define GetMoveUci(string Move)(string IsWhite) (warp=true)
{
    Ret.GetMoveUci.Uci = "";
    Call GetPhysicalMove(Move);
    GetMoveUci.IsCastle = 0;
    GetMoveUci.Rank = 8;
    If (IsWhite == 1)
    {
        GetMoveUci.Rank = 1;
    }
    If ((Ret.GetPhysicalMove.Move == GoK_OwnKingsideCastling) Or (Ret.GetPhysicalMove.Move == GoK_OppKingsideCastling))
    {
        GetMoveUci.IsCastle = 1;
        Ret.GetMoveUci.Uci = Operator.Join("e", Operator.Join(GetMoveUci.Rank, Operator.Join("g", GetMoveUci.Rank)));
    }
    If ((Ret.GetPhysicalMove.Move == GoK_OwnQueensideCastling) Or (Ret.GetPhysicalMove.Move == GoK_OppQueensideCastling))
    {
        GetMoveUci.IsCastle = 1;
        Ret.GetMoveUci.Uci = Operator.Join("e", Operator.Join(GetMoveUci.Rank, Operator.Join("c", GetMoveUci.Rank)));
    }
    If (GetMoveUci.IsCastle == 0)
    {
        GetMoveUci.From = floor((Ret.GetPhysicalMove.Move / 100));
        GetMoveUci.To = floor((Ret.GetPhysicalMove.Move % 100));
        Ret.GetMoveUci.Uci = Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[GetMoveUci.From]), Operator.Join((9 - IdxToRank[GetMoveUci.From]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[GetMoveUci.To]), (9 - IdxToRank[GetMoveUci.To]))));
        If (Operator.LetterOf(Move, (Variable.Length(Move) - 1)) == ".")
        {
            Ret.GetMoveUci.Uci = Operator.Join(Ret.GetMoveUci.Uci, Operator.LetterOf("qrbn", Operator.LetterOf(Move, Variable.Length(Move))));
        }
    }
}

Define GetNormalizedMove(string Move) (warp=true)
{
    If (Move == floor(Move))
    {
        Ret.GetNormalizedMove.Move = MoveToZeroPadStr[(Move + 1)];
    }
    Else
    {
        Ret.GetNormalizedMove.Move = Operator.Join(MoveToZeroPadStr[(floor(Move) + 1)], Operator.Join(".", Operator.LetterOf(Move, Variable.Length(Move))));
    }
}

Define GetOpeningMoves (warp=true)
{
    List.DeleteItem(OpeningMovesRes, all);
    If (1 == 0)
    {
        If (List.Length(BoardHistoryHash) > 13)
        {
            If (Operator.Random(1 , 4) == 4)
            {
                Stop(this script);
            }
        }
    }
    Call GenerateMovesPublic(1);
    Call CreateCurrentBoardHash;
    GetOpeningMoves.MapIdx = 1;
    Repeat (List.Length(OpeningMovesMapHash))
    {
        If (OpeningMovesMapHash[GetOpeningMoves.MapIdx] == Glob.Board.CurrentHash)
        {
            If List.ContainsItem(Moves1, OpeningMovesMapMove[GetOpeningMoves.MapIdx])
            {
                List.Add(OpeningMovesRes, OpeningMovesMapMove[GetOpeningMoves.MapIdx]);
            }
        }
        GetOpeningMoves.MapIdx += 1;
    }
}

Define GetPawnStructureScore (warp=true)
{
    GetPawnStructureScore.PawnHash = ((Glob.Board.KPHash - PosPieceHashLookup[((64 * (PieceIdxLookup[GoK_OwnKing] - 1)) + Glob.Board.OwnKingIdx)]) - PosPieceHashLookup[(384 + ((64 * (PieceIdxLookup[(0 - GoK_OppKing)] - 1)) + Glob.Board.OppKingIdx))]);
    GetPawnStructureScore.SlotIdx = ((GetPawnStructureScore.PawnHash % Const.PawnHashEntryCount) + 1);
    If (Glob.Eval.DebugLog == 1)
    {
        List.ReplaceItem(PawnHash.Keys, GetPawnStructureScore.SlotIdx, -1);
    }
    If (PawnHash.Keys[GetPawnStructureScore.SlotIdx] == GetPawnStructureScore.PawnHash)
    {
        Ret.GetPawnStructureScore.ScoreMg = PawnHash.StructureMg[GetPawnStructureScore.SlotIdx];
        Ret.GetPawnStructureScore.ScoreEg = PawnHash.StructureEg[GetPawnStructureScore.SlotIdx];
    }
    Else
    {
        Call EvaluatePawnStructure;
        Ret.GetPawnStructureScore.ScoreMg = Ret.EvaluatePawnStructure.ScoreMg;
        Ret.GetPawnStructureScore.ScoreEg = Ret.EvaluatePawnStructure.ScoreEg;
        List.ReplaceItem(PawnHash.Keys, GetPawnStructureScore.SlotIdx, GetPawnStructureScore.PawnHash);
        List.ReplaceItem(PawnHash.StructureMg, GetPawnStructureScore.SlotIdx, Ret.EvaluatePawnStructure.ScoreMg);
        List.ReplaceItem(PawnHash.StructureEg, GetPawnStructureScore.SlotIdx, Ret.EvaluatePawnStructure.ScoreEg);
    }
}

Define GetPhysicalMove(num Move) (warp=true)
{
    If (Move == Const.Null)
    {
        Ret.GetPhysicalMove.Move = Const.Null;
        Stop(this script);
    }
    If (Glob.Game.IsPlayerBlack == 0)
    {
        Ret.GetPhysicalMove.Move = Move;
    }
    Else
    {
        If (Not ((floor((Move / 100)) == 0)))
        {
            Ret.GetPhysicalMove.Move = ((RankFlipIdx[floor((Move / 100))] * 100) + RankFlipIdx[floor((Move % 100))]);
            If (Operator.LetterOf(Move, (Variable.Length(Move) - 1)) == ".")
            {
                Ret.GetPhysicalMove.Move = (Ret.GetPhysicalMove.Move + (0.1 * Operator.LetterOf(Move, Variable.Length(Move))));
            }
        }
        Else
        {
            If (Move == GoK_OwnKingsideCastling)
            {
                Ret.GetPhysicalMove.Move = GoK_OppKingsideCastling;
            }
            Else
            {
                If (Move == GoK_OwnQueensideCastling)
                {
                    Ret.GetPhysicalMove.Move = GoK_OppQueensideCastling;
                }
                Else
                {
                    If (Move == GoK_OppKingsideCastling)
                    {
                        Ret.GetPhysicalMove.Move = GoK_OwnKingsideCastling;
                    }
                    Else
                    {
                        If (Move == GoK_OppQueensideCastling)
                        {
                            Ret.GetPhysicalMove.Move = GoK_OwnQueensideCastling;
                        }
                    }
                }
            }
        }
    }
}

Define GetPiecePosHash(string Piece)(string Pos) (warp=true)
{
    Ret.GetPiecePosHash.Hash = 0;
    If ((Not ((Pos > 0))) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[((64 * (PieceIdxLookup[(Piece + 0)] - 1)) + Pos)] + 0);
    }
    Else
    {
        Ret.GetPiecePosHash.Hash = (PosPieceHashLookup[(384 + ((64 * (PieceIdxLookup[abs(Piece)] - 1)) + Pos))] + 0);
    }
}

Define GetPiecePosScoreRaw(string Piece)(string Idx) (warp=true)
{
    Ret.GetPiecePosScoreRaw.Mg = 0;
    Ret.GetPiecePosScoreRaw.Eg = 0;
    If ((Idx == 0) Or (Piece == 0))
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        If (Piece == GoK_OwnPawn)
        {
            Ret.GetPiecePosScoreRaw.Mg = (PawnPieceSquare[(Idx + 0)] + 0);
            Ret.GetPiecePosScoreRaw.Eg = (PawnPieceSquareEndgame[(Idx + 0)] + 0);
            Stop(this script);
        }
        If (Piece == GoK_OwnKnight)
        {
            Ret.GetPiecePosScoreRaw.Mg = (KnightPieceSquare[(Idx + 0)] + 0);
            Ret.GetPiecePosScoreRaw.Eg = (KnightPieceSquareEndgame[(Idx + 0)] + 0);
            Stop(this script);
        }
        If (Piece == GoK_OwnBishop)
        {
            Ret.GetPiecePosScoreRaw.Mg = (BishopPieceSquare[(Idx + 0)] + 0);
            Ret.GetPiecePosScoreRaw.Eg = (BishopPieceSquareEndgame[(Idx + 0)] + 0);
            Stop(this script);
        }
        If (Piece == GoK_OwnRook)
        {
            Ret.GetPiecePosScoreRaw.Mg = (RookPieceSquare[(Idx + 0)] + 0);
            Ret.GetPiecePosScoreRaw.Eg = (RookPieceSquareEndgame[(Idx + 0)] + 0);
            Stop(this script);
        }
        If (Piece == GoK_OwnQueen)
        {
            Ret.GetPiecePosScoreRaw.Mg = (QueenPieceSquare[(Idx + 0)] + 0);
            Ret.GetPiecePosScoreRaw.Eg = (QueenPieceSquareEndgame[(Idx + 0)] + 0);
            Stop(this script);
        }
        If (Piece == GoK_OwnKing)
        {
            Ret.GetPiecePosScoreRaw.Mg = (KingPieceSquare[(Idx + 0)] + 0);
            Ret.GetPiecePosScoreRaw.Eg = (KingPieceSquareEndgame[(Idx + 0)] + 0);
            Stop(this script);
        }
    }
    Else
    {
        If (Piece == GoK_OppPawn)
        {
            Ret.GetPiecePosScoreRaw.Mg = (0 - PawnPieceSquare[RankFlipIdx[Idx]]);
            Ret.GetPiecePosScoreRaw.Eg = (0 - PawnPieceSquareEndgame[RankFlipIdx[Idx]]);
            Stop(this script);
        }
        If (Piece == GoK_OppKnight)
        {
            Ret.GetPiecePosScoreRaw.Mg = (0 - KnightPieceSquare[RankFlipIdx[Idx]]);
            Ret.GetPiecePosScoreRaw.Eg = (0 - KnightPieceSquareEndgame[RankFlipIdx[Idx]]);
            Stop(this script);
        }
        If (Piece == GoK_OppBishop)
        {
            Ret.GetPiecePosScoreRaw.Mg = (0 - BishopPieceSquare[RankFlipIdx[Idx]]);
            Ret.GetPiecePosScoreRaw.Eg = (0 - BishopPieceSquareEndgame[RankFlipIdx[Idx]]);
            Stop(this script);
        }
        If (Piece == GoK_OppRook)
        {
            Ret.GetPiecePosScoreRaw.Mg = (0 - RookPieceSquare[RankFlipIdx[Idx]]);
            Ret.GetPiecePosScoreRaw.Eg = (0 - RookPieceSquareEndgame[RankFlipIdx[Idx]]);
            Stop(this script);
        }
        If (Piece == GoK_OppQueen)
        {
            Ret.GetPiecePosScoreRaw.Mg = (0 - QueenPieceSquare[RankFlipIdx[Idx]]);
            Ret.GetPiecePosScoreRaw.Eg = (0 - QueenPieceSquareEndgame[RankFlipIdx[Idx]]);
            Stop(this script);
        }
        If (Piece == GoK_OppKing)
        {
            Ret.GetPiecePosScoreRaw.Mg = (0 - KingPieceSquare[RankFlipIdx[Idx]]);
            Ret.GetPiecePosScoreRaw.Eg = (0 - KingPieceSquareEndgame[RankFlipIdx[Idx]]);
            Stop(this script);
        }
    }
}

Define GetPvUci(string RootMove)(string IsWhite) (warp=true)
{
    Ret.GetPvUci.Text = "";
    Ret.GetPvUci.First = RootMove;
    Ret.GetPvUci.Ponder = Const.Null;
    GetPvUci.Len = PV[1];
    If (GetPvUci.Len < 1)
    {
        Call GetMoveUci(RootMove)(IsWhite);
        Ret.GetPvUci.Text = Ret.GetMoveUci.Uci;
    }
    If (Not ((GetPvUci.Len < 1)))
    {
        GetPvUci.Idx = 1;
        GetPvUci.Side = IsWhite;
        Repeat (GetPvUci.Len)
        {
            Call GetMoveUci(PVRaw[(GetPvUci.Idx + 1)])(GetPvUci.Side);
            If (GetPvUci.Idx == 1)
            {
                Ret.GetPvUci.Text = Ret.GetMoveUci.Uci;
                Ret.GetPvUci.First = PVRaw[2];
            }
            If (GetPvUci.Idx > 1)
            {
                Ret.GetPvUci.Text = Operator.Join(Ret.GetPvUci.Text, Operator.Join(" ", Ret.GetMoveUci.Uci));
            }
            If (GetPvUci.Idx == 2)
            {
                Ret.GetPvUci.Ponder = Ret.GetMoveUci.Uci;
            }
            GetPvUci.Side = (1 - GetPvUci.Side);
            GetPvUci.Idx += 1;
        }
    }
}

Define GetRepetitionCount (warp=true)
{
    GetRepetitionCount.BoardHistoryIdx = (List.Length(BoardHistory) - 2);
    Ret.GetRepetitionCount.Count = 1;
    Repeat Until (GetRepetitionCount.BoardHistoryIdx < 1)
    {
        If ((BoardHistory[GetRepetitionCount.BoardHistoryIdx] == BoardHistory[List.Length(BoardHistory)]) And (BoardHistoryMetaState[GetRepetitionCount.BoardHistoryIdx] == BoardHistoryMetaState[List.Length(BoardHistoryMetaState)]))
        {
            Ret.GetRepetitionCount.Count += 1;
        }
        GetRepetitionCount.BoardHistoryIdx += -2;
    }
}

Define GetSliderBlockerCount(string FromIdx)(string ToIdx) (warp=true)
{
    GetSliderBlockerCount.Piece = (Board[(FromIdx + 0)] + 0);
    Ret.GetSliderBlockerCount.Count = 0;
    If ((abs(GetSliderBlockerCount.Piece) < GoK_OwnBishop) Or (abs(GetSliderBlockerCount.Piece) > GoK_OwnQueen))
    {
        Ret.GetSliderBlockerCount.Count = 99;
        Stop(this script);
    }
    GetSliderBlockerCount.Move = ((FromIdx * 100) + ToIdx);
    GetSliderBlockerCount.LegalMoveKey = ((PieceIdxLookup[abs(GetSliderBlockerCount.Piece)] * 10000) + GetSliderBlockerCount.Move);
    If ((Not ((GetSliderBlockerCount.Piece == 0))) And (MovePosLookupLegal[(GetSliderBlockerCount.LegalMoveKey + (Const.MovePosLookupOppBaseIdx * (GetSliderBlockerCount.Piece < 0)))] == 0))
    {
        Ret.GetSliderBlockerCount.Count = 99;
        Stop(this script);
    }
    GetSliderBlockerCount.SourceIdx = FromIdx;
    GetSliderBlockerCount.RayStep = MovePathStepInc[(GetSliderBlockerCount.Move + 0)];
    Repeat ((MovePathDelta[(GetSliderBlockerCount.Move + 0)] - 1))
    {
        GetSliderBlockerCount.SourceIdx += GetSliderBlockerCount.RayStep;
        If (Not ((Board[GetSliderBlockerCount.SourceIdx] == 0)))
        {
            Ret.GetSliderBlockerCount.Count += 1;
        }
    }
}

Define GetStaticEval(string Ply) (warp=true)
{
    If (StaticEval[Ply] == Const.Null)
    {
        If ((((Ply > 1) And (AppliedMove[(Ply - 1)] == 0)) And (Not ((NodeTTStaticEval[(Ply - 1)] == Const.Null)))) And (((Glob.Board.OwnQueenCount + Glob.Board.OwnNonQueenMajorMinorCount) + (Glob.Board.OppQueenCount + Glob.Board.OppNonQueenMajorMinorCount)) > 3))
        {
            Ret.Evaluate.Score = NodeTTStaticEval[(Ply - 1)];
        }
        Else
        {
            Call Evaluate((Ply - 1))((1 == 1));
        }
        Call AdjustEvalScore(Ply)(Ret.Evaluate.Score);
        List.ReplaceItem(NodeTTStaticEval, Ply, Ret.Evaluate.Score);
        Call TTStoreNode(Glob.Board.CurrentHash)(Ply)(Const.Null)(Const.Null)(Const.TTType.None)(Const.Null)(Const.Null)(Ret.Evaluate.Score);
    }
}

Define GetSubstring(string Text)(num FromIdx)(num ToIdx) (warp=true)
{
    GetSubstring.CharIdx = FromIdx;
    Ret.GetSubstring.Substring = "";
    Repeat (((ToIdx - FromIdx) + 1))
    {
        Ret.GetSubstring.Substring = Operator.Join(Ret.GetSubstring.Substring, Operator.LetterOf(Text, GetSubstring.CharIdx));
        GetSubstring.CharIdx += 1;
    }
}

Define GetSubstringLeft(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(1)(Count);
    Ret.GetSubstringLeft.Substring = Ret.GetSubstring.Substring;
}

Define GetSubstringRight(string Text)(num Count) (warp=true)
{
    Call GetSubstring(Text)(((Variable.Length(Text) - Count) + 1))(Variable.Length(Text));
    Ret.GetSubstringRight.Substring = Ret.GetSubstring.Substring;
}

Define GetTargetIdx(num SourceIdx)(num DeltaX)(num DeltaY) (warp=true)
{
    GetTargetIdx.File = (IdxToFile[SourceIdx] + DeltaX);
    Ret.GetTargetIdx.SqIdx = -1;
    If ((GetTargetIdx.File > 0) And (GetTargetIdx.File < 9))
    {
        GetTargetIdx.Rank = (IdxToRank[SourceIdx] + DeltaY);
        If ((GetTargetIdx.Rank > 0) And (GetTargetIdx.Rank < 9))
        {
            Ret.GetTargetIdx.SqIdx = (GetTargetIdx.File + ((GetTargetIdx.Rank - 1) * 8));
        }
    }
}

Define GetTTNodeHash(string BoardHash)(string Ply) (warp=true)
{
    Ret.GetTTNodeHash.Hash = (PlyIsOwn[Ply] + 1);
    If (EnPassantTarget[Ply] == Const.Null)
    {
        GetTTNodeHash.EnPassantIdx = 0;
    }
    Else
    {
        GetTTNodeHash.EnPassantIdx = EnPassantTarget[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 67) + (GetTTNodeHash.EnPassantIdx + 1));
    If (CastlingState[Ply] == Const.Null)
    {
        GetTTNodeHash.Castling = 0;
    }
    Else
    {
        GetTTNodeHash.Castling = CastlingState[Ply];
    }
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 11111117) + (GetTTNodeHash.Castling + 1));
    Ret.GetTTNodeHash.Hash = ((Ret.GetTTNodeHash.Hash * 97) + BoardHash);
}

Define GivesCheckFast(string Ply) (warp=true)
{
    GivesCheckFast.IsDiscovery = 0;
    If (floor((AppliedMove[Ply] / 100)) == 0)
    {
        Call IsCheckedFast((Ply + 2));
        Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        GivesCheckFast.FromIdx = floor((AppliedMove[Ply] / 100));
        GivesCheckFast.ToIdx = floor((AppliedMove[Ply] % 100));
        If (Not ((TargetPiecesIdx[Ply] == GivesCheckFast.ToIdx)))
        {
            Call IsCheckedFast((Ply + 2));
            Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            If (PlyIsOwn[Ply] == 1)
            {
                GivesCheckFast.TheirKingIdx = Glob.Board.OppKingIdx;
            }
            Else
            {
                GivesCheckFast.TheirKingIdx = Glob.Board.OwnKingIdx;
            }
            Ret.GivesCheckFast.GivesCheck = 0;
            If (Not ((abs(Board[GivesCheckFast.ToIdx]) == GoK_OwnKing)))
            {
                Call IsReachableForAttack(Board[GivesCheckFast.ToIdx])(GivesCheckFast.ToIdx)(GivesCheckFast.TheirKingIdx);
                GivesCheckFast.IsReachable = Ret.IsReachableForAttack.IsReachable;
                Ret.GivesCheckFast.GivesCheck = GivesCheckFast.IsReachable;
            }
            If (Ret.GivesCheckFast.GivesCheck == 0)
            {
                GivesCheckFast.DiscoveryIdx = 1;
                Repeat (DiscoveryCount[Ply])
                {
                    If (DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + GivesCheckFast.DiscoveryIdx)] == GivesCheckFast.FromIdx)
                    {
                        If (Not ((abs(MovePathStepInc[((GivesCheckFast.FromIdx * 100) + GivesCheckFast.ToIdx)]) == DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + GivesCheckFast.DiscoveryIdx)])))
                        {
                            Ret.GivesCheckFast.GivesCheck = 1;
                            GivesCheckFast.IsDiscovery = 1;
                        }
                    }
                    GivesCheckFast.DiscoveryIdx += 1;
                }
            }
            If (Glob.Profile.Mode == Const.ProfilerMode.Full)
            {
                GivesCheckFast.IsChecked = Ret.GivesCheckFast.GivesCheck;
                Call IsCheckedFast((Ply + 2));
                Ret.GivesCheckFast.GivesCheck = Ret.IsCheckedFast.IsChecked;
                If (Not ((GivesCheckFast.IsChecked == Ret.GivesCheckFast.GivesCheck)))
                {
                    Call Log("CheckInfoMismatch check depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(GivesCheckFast.IsChecked)(" old=")(Ret.GivesCheckFast.GivesCheck);
                    Call Log("  detail pieceAtTo=")(Board[GivesCheckFast.ToIdx])(" enemyK=")(GivesCheckFast.TheirKingIdx)(" ira=")(GivesCheckFast.IsReachable)(" discCount=")(DiscoveryCount[Ply]);
                    Call Log("  disc1=")(DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])(" ray1=")(DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + 1)])("")("")("")("");
                    Call Log("  board=")(Board)("")("")("")("")("")("");
                }
            }
        }
    }
}

Define ImportBoard(string ImpBoard) (warp=false)
{
    Call EnterExecution;
    Call ExportBoardFEN(0);
    ImportBoard.FEN = Ret.ExportBoardFEN.FEN;
    Call ImportBoardFEN(ImpBoard);
    Call CalcBoardStats;
    If ((Glob.Board.OwnKingIdx == Const.Null) Or (Glob.Board.OppKingIdx == Const.Null))
    {
        Call SayAsync("Invalid FEN data")(5);
        Call ImportBoardFEN(ImportBoard.FEN);
        Call CalcBoardStats;
    }
    Else
    {
        Call ImportFEN(ImpBoard);
        Call CalcBoardStats;
        Stg_FromSquareIdx = -1;
        Stg_ToSquareIdx = -1;
        Event.BroadcastAndWait("fromsquareselected");
        Event.BroadcastAndWait("tosquareselected");
        List.DeleteItem(BoardHistory, all);
        List.DeleteItem(BoardHistoryHash, all);
        List.DeleteItem(BoardHistoryMetaState, all);
        List.DeleteItem(BoardHistoryWasEngineMove, all);
        List.DeleteItem(GameMovesAN, all);
        Glob.Game.FenPlyBase = 0;
        Call AddBoardToHistory("");
        Call DrawBoardAndWait;
        GoK_IsGameSuspended = 0;
        Call CalcBoardAttacked(1);
        Call CalcBoardAttacked(2);
        If (((Ret.ImportFEN.IsWhiteToMove == 0) And (Glob.Game.IsPlayerBlack == 0)) Or ((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.Game.IsPlayerBlack == 1)))
        {
            Call IsOppKingCheckMate;
            If (Ret.IsOppKingCheckMate.IsCheckMate == 1)
            {
                Call SayAsync("Checkmate!")(5);
                GoK_IsGameSuspended = 1;
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    Call SayAsync("Draw!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call ExecuteEngineMove;
                }
            }
        }
        Else
        {
            If (((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.Game.IsPlayerBlack == 0)) Or ((Ret.ImportFEN.IsWhiteToMove == 0) And (Glob.Game.IsPlayerBlack == 1)))
            {
                Call IsOwnKingCheckMate;
                If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
                {
                    Call SayAsync("Checkmate!")(5);
                    GoK_IsGameSuspended = 1;
                }
                Else
                {
                    Call IsDrawByStalemate(2);
                    If (Ret.IsDrawByStalemate.IsDraw == 1)
                    {
                        Call SayAsync("Draw!")(5);
                        GoK_IsGameSuspended = 1;
                    }
                }
            }
        }
    }
    Call ExitExecution;
}

Define ImportBoardFEN(string ImpBoard) (warp=false)
{
    List.DeleteAll(GoK_Board);
    ImportBoardFEN.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_Board, 0);
        ImportBoardFEN.SqIdx += 1;
    }
    ImportBoardFEN.SqIdx = 1;
    Ret.ImportBoardFEN.CharIdx = 1;
    Repeat Until (((ImportBoardFEN.SqIdx > 64) Or (ImportBoardFEN.SqIdx < 1)) Or (Ret.ImportBoardFEN.CharIdx > Variable.Length(ImpBoard)))
    {
        ImportBoardFEN.Char = Operator.LetterOf(ImpBoard, Ret.ImportBoardFEN.CharIdx);
        If ((Not ((ImportBoardFEN.Char < "A"))) And (Not ((ImportBoardFEN.Char > "Z"))))
        {
            ImportBoardFEN.Piece = 0;
            If (ImportBoardFEN.Char == "P")
            {
                ImportBoardFEN.Piece = GoK_OwnPawn;
            }
            If (ImportBoardFEN.Char == "N")
            {
                ImportBoardFEN.Piece = GoK_OwnKnight;
            }
            If (ImportBoardFEN.Char == "B")
            {
                ImportBoardFEN.Piece = GoK_OwnBishop;
            }
            If (ImportBoardFEN.Char == "R")
            {
                ImportBoardFEN.Piece = GoK_OwnRook;
            }
            If (ImportBoardFEN.Char == "Q")
            {
                ImportBoardFEN.Piece = GoK_OwnQueen;
            }
            If (ImportBoardFEN.Char == "K")
            {
                ImportBoardFEN.Piece = GoK_OwnKing;
            }
            Call IsLowerCase(ImportBoardFEN.Char);
            If (Ret.IsLowerCase.IsLower == 0)
            {
                ImportBoardFEN.Piece = (ImportBoardFEN.Piece * -1);
            }
            List.ReplaceItem(GoK_Board, ImportBoardFEN.SqIdx, ImportBoardFEN.Piece);
            ImportBoardFEN.SqIdx += 1;
        }
        Else
        {
            If ((Not ((ImportBoardFEN.Char < 0))) And (Not ((ImportBoardFEN.Char > 9))))
            {
                Repeat (ImportBoardFEN.Char)
                {
                    List.ReplaceItem(GoK_Board, ImportBoardFEN.SqIdx, 0);
                    ImportBoardFEN.SqIdx += 1;
                }
            }
            Else
            {
                If (ImportBoardFEN.Char == "/")
                {
                    Repeat Until ((ImportBoardFEN.SqIdx % 8) == 1)
                    {
                        List.ReplaceItem(GoK_Board, ImportBoardFEN.SqIdx, 0);
                        ImportBoardFEN.SqIdx += 1;
                    }
                }
            }
        }
        Ret.ImportBoardFEN.CharIdx += 1;
    }
    Call LoadInternalBoard;
}

Define ImportBoardImpl(string ImpBoard) (warp=true)
{
    ImportBoardImpl.SqIdx = 1;
    ImportBoardImpl.CharIdx = 1;
    ImportBoardImpl.Piece = "";
    Repeat Until (ImportBoardImpl.CharIdx > Variable.Length(ImpBoard))
    {
        If (Operator.LetterOf(ImpBoard, ImportBoardImpl.CharIdx) == ",")
        {
            List.ReplaceItem(Board, ImportBoardImpl.SqIdx, (ImportBoardImpl.Piece + 0));
            ImportBoardImpl.SqIdx += 1;
            ImportBoardImpl.Piece = "";
        }
        Else
        {
            ImportBoardImpl.Piece = Operator.Join(ImportBoardImpl.Piece, Operator.LetterOf(ImpBoard, ImportBoardImpl.CharIdx));
        }
        ImportBoardImpl.CharIdx += 1;
    }
}

Define ImportFEN(string FenText) (warp=true)
{
    Call ImportBoardFEN(FenText);
    ImportFEN.CharIdx = Ret.ImportBoardFEN.CharIdx;
    ImportFEN.Side = "";
    ImportFEN.Castling = "";
    ImportFEN.EP = "";
    ImportFEN.Half = "";
    ImportFEN.Full = "";
    ImportFEN.Token = 0;
    Repeat (((Variable.Length(FenText) - ImportFEN.CharIdx) + 1))
    {
        ImportFEN.Char = Operator.LetterOf(FenText, ImportFEN.CharIdx);
        If (ImportFEN.Char == " ")
        {
            ImportFEN.Token += 1;
        }
        Else
        {
            If (ImportFEN.Token == 1)
            {
                ImportFEN.Side = Operator.Join(ImportFEN.Side, ImportFEN.Char);
            }
            If (ImportFEN.Token == 2)
            {
                ImportFEN.Castling = Operator.Join(ImportFEN.Castling, ImportFEN.Char);
            }
            If (ImportFEN.Token == 3)
            {
                ImportFEN.EP = Operator.Join(ImportFEN.EP, ImportFEN.Char);
            }
            If (ImportFEN.Token == 4)
            {
                ImportFEN.Half = Operator.Join(ImportFEN.Half, ImportFEN.Char);
            }
            If (ImportFEN.Token == 5)
            {
                If ((Not ((ImportFEN.Char < 0))) And (Not ((ImportFEN.Char > 9))))
                {
                    ImportFEN.Full = Operator.Join(ImportFEN.Full, ImportFEN.Char);
                }
            }
        }
        ImportFEN.CharIdx += 1;
    }
    Ret.ImportFEN.IsWhiteToMove = 0;
    If (ImportFEN.Side == "w")
    {
        Ret.ImportFEN.IsWhiteToMove = 1;
    }
    Glob.Game.FenBlackToMove = (1 - Ret.ImportFEN.IsWhiteToMove);
    Glob.Game.FenFullMove = 1;
    If (Variable.Length(ImportFEN.Full) > 0)
    {
        Glob.Game.FenFullMove = (ImportFEN.Full + 0);
    }
    Glob.Game.FenPlyBase = List.Length(GameMovesAN);
    If (Variable.Length(ImportFEN.Castling) > 0)
    {
        ImportFEN.CanOwnCastleKingside = 0;
        ImportFEN.CanOwnCastleQueenside = 0;
        ImportFEN.CanOppCastleKingside = 0;
        ImportFEN.CanOppCastleQueenside = 0;
        ImportFEN.CastlingCharIdx = 1;
        Repeat Until ((ImportFEN.CastlingCharIdx > Variable.Length(ImportFEN.Castling)) Or (Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx) == " "))
        {
            If (Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx) == "K")
            {
                Call IsLowerCase(Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx));
                If (Ret.IsLowerCase.IsLower == 0)
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOwnCastleKingside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOppCastleKingside = 1;
                    }
                }
                Else
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOppCastleKingside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOwnCastleKingside = 1;
                    }
                }
            }
            If (Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx) == "Q")
            {
                Call IsLowerCase(Operator.LetterOf(ImportFEN.Castling, ImportFEN.CastlingCharIdx));
                If (Ret.IsLowerCase.IsLower == 0)
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOwnCastleQueenside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOppCastleQueenside = 1;
                    }
                }
                Else
                {
                    If (Glob.Game.IsPlayerBlack == 1)
                    {
                        ImportFEN.CanOppCastleQueenside = 1;
                    }
                    Else
                    {
                        ImportFEN.CanOwnCastleQueenside = 1;
                    }
                }
            }
            ImportFEN.CastlingCharIdx += 1;
        }
        Glob.Board.HasOwnRookQSMoved = 0;
        Glob.Board.HasOwnKingMoved = 0;
        Glob.Board.HasOwnCastled = 0;
        Glob.Board.HasOwnRookKSMoved = 0;
        Glob.Board.HasOppRookQSMoved = 0;
        Glob.Board.HasOppKingMoved = 0;
        Glob.Board.HasOppCastled = 0;
        Glob.Board.HasOppRookKSMoved = 0;
        If (Not ((ImportFEN.CanOwnCastleQueenside == 1)))
        {
            Glob.Board.HasOwnRookQSMoved = 1;
        }
        If (Not (((ImportFEN.CanOwnCastleQueenside == 1) Or (ImportFEN.CanOwnCastleKingside == 1))))
        {
            Glob.Board.HasOwnKingMoved = 1;
            Glob.Board.HasOwnCastled = 1;
        }
        If (Not ((ImportFEN.CanOwnCastleKingside == 1)))
        {
            Glob.Board.HasOwnRookKSMoved = 1;
        }
        If (Not ((ImportFEN.CanOppCastleQueenside == 1)))
        {
            Glob.Board.HasOppRookQSMoved = 1;
        }
        If (Not (((ImportFEN.CanOppCastleQueenside == 1) Or (ImportFEN.CanOppCastleKingside == 1))))
        {
            Glob.Board.HasOppKingMoved = 1;
            Glob.Board.HasOppCastled = 1;
        }
        If (Not ((ImportFEN.CanOppCastleKingside == 1)))
        {
            Glob.Board.HasOppRookKSMoved = 1;
        }
    }
    Else
    {
        Glob.Board.HasOppKingMoved = 0;
        Glob.Board.HasOwnKingMoved = 0;
        Glob.Board.HasOppCastled = 0;
        Glob.Board.HasOwnCastled = 0;
        Glob.Board.HasOppRookKSMoved = 0;
        Glob.Board.HasOppRookQSMoved = 0;
        Glob.Board.HasOwnRookKSMoved = 0;
        Glob.Board.HasOwnRookQSMoved = 0;
        If (Not ((Board[1] == GoK_OwnRook)))
        {
            Glob.Board.HasOwnRookQSMoved = 1;
        }
        If (Not ((Board[5] == GoK_OwnKing)))
        {
            Glob.Board.HasOwnKingMoved = 1;
            Glob.Board.HasOwnCastled = 1;
        }
        If (Not ((Board[8] == GoK_OwnRook)))
        {
            Glob.Board.HasOwnRookKSMoved = 1;
        }
        If (Not ((Board[57] == GoK_OppRook)))
        {
            Glob.Board.HasOppRookQSMoved = 1;
        }
        If (Not ((Board[61] == GoK_OppKing)))
        {
            Glob.Board.HasOppKingMoved = 1;
            Glob.Board.HasOppCastled = 1;
        }
        If (Not ((Board[64] == GoK_OppRook)))
        {
            Glob.Board.HasOppRookKSMoved = 1;
        }
    }
    List.ReplaceItem(EnPassantTarget, 1, Const.Null);
    ImportFEN.EnPassantFile = 0;
    If (Operator.LetterOf(ImportFEN.EP, 1) == "a")
    {
        ImportFEN.EnPassantFile = 1;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "b")
    {
        ImportFEN.EnPassantFile = 2;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "c")
    {
        ImportFEN.EnPassantFile = 3;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "d")
    {
        ImportFEN.EnPassantFile = 4;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "e")
    {
        ImportFEN.EnPassantFile = 5;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "f")
    {
        ImportFEN.EnPassantFile = 6;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "g")
    {
        ImportFEN.EnPassantFile = 7;
    }
    If (Operator.LetterOf(ImportFEN.EP, 1) == "h")
    {
        ImportFEN.EnPassantFile = 8;
    }
    If (ImportFEN.EnPassantFile > 0)
    {
        If (((Ret.ImportFEN.IsWhiteToMove == 1) And (Glob.Game.IsPlayerBlack == 1)) Or ((Not ((Ret.ImportFEN.IsWhiteToMove == 1))) And (Not ((Glob.Game.IsPlayerBlack == 1)))))
        {
            List.ReplaceItem(EnPassantTarget, 1, (32 + ImportFEN.EnPassantFile));
        }
        Else
        {
            List.ReplaceItem(EnPassantTarget, 1, (24 + ImportFEN.EnPassantFile));
        }
    }
    List.DeleteAll(GameMoves);
    If (Not ((EnPassantTarget[1] == Const.Null)))
    {
        ImportFEN.SynthTargetIdx = EnPassantTarget[1];
        If (Board[ImportFEN.SynthTargetIdx] > 0)
        {
            ImportFEN.SynthSourceIdx = (ImportFEN.SynthTargetIdx - 16);
        }
        Else
        {
            ImportFEN.SynthSourceIdx = (ImportFEN.SynthTargetIdx + 16);
        }
        List.DeleteAll(GameMoves);
        List.Add(GameMoves, ((ImportFEN.SynthSourceIdx * 100) + ImportFEN.SynthTargetIdx));
    }
    List.DeleteAll(BoardHistoryFiftyMoves);
    ImportFEN.HalfCount = 0;
    Repeat (ImportFEN.Half)
    {
        ImportFEN.HalfCount += 1;
        List.Add(BoardHistoryFiftyMoves, ImportFEN.HalfCount);
    }
}

Define InitBoard (warp=true)
{
    List.DeleteAll(EvalMT.Keys);
    Repeat (4093)
    {
        List.Add(EvalMT.Keys, 0);
    }
    List.DeleteAll(EvalMT.OwnMg);
    Repeat (4093)
    {
        List.Add(EvalMT.OwnMg, 0);
    }
    List.DeleteAll(EvalMT.OwnEg);
    Repeat (4093)
    {
        List.Add(EvalMT.OwnEg, 0);
    }
    List.DeleteAll(EvalMT.OppMg);
    Repeat (4093)
    {
        List.Add(EvalMT.OppMg, 0);
    }
    List.DeleteAll(EvalMT.OppEg);
    Repeat (4093)
    {
        List.Add(EvalMT.OppEg, 0);
    }
    List.DeleteAll(EvalPinDir);
    Repeat (64)
    {
        List.Add(EvalPinDir, 0);
