            EvalP.PStruct.Support = (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + -9)] == GoK_OwnPawn)) + ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + -7)] == GoK_OwnPawn)));
            EvalP.PStruct.Phalanx = (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + -1)] == GoK_OwnPawn)) + ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + 1)] == GoK_OwnPawn)));
            EvalP.PStruct.Lever = (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + 7)] == GoK_OppPawn)) + ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + 9)] == GoK_OppPawn)));
            EvalP.PStruct.LeverPush = 0;
