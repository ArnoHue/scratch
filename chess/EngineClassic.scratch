                CBABMC.IsRayDone = 1;
            }
        }
    }
    If (CBABMC.IsChecked == 0)
    {
        CBABMC.File = CBABMC.KingFile;
        CBABMC.Rank = CBABMC.KingRank;
        CBABMC.IsRayDone = 0;
        Repeat Until ((CBABMC.IsRayDone == 1) Or (CBABMC.IsChecked == 1))
        {
            CBABMC.Rank = (CBABMC.Rank + -1);
            If (((CBABMC.File > 0) And (CBABMC.File < 9)) And ((CBABMC.Rank > 0) And (CBABMC.Rank < 9)))
