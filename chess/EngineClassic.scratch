    Const.Profile.QSEEHits = 960;
    Const.Profile.LMRCalls = 1024;
    Const.Profile.LMRHits = 1088;
    Const.Profile.PVSCalls = 1152;
    Const.Profile.PVSReSearches = 1216;
    Const.Profile.FullCalls = 1280;
    Const.Profile.Ext = 1344;
    Const.Profile.TTStaticProbe = 1472;
    Const.Profile.TTStaticHit = 1536;
    Const.Profile.TTMoveProbe = 1600;
    Const.Profile.TTMoveHit = 1664;
    Const.Profile.LazyCalls = 1728;
    Const.Profile.LazyHits = 1792;
    Const.MaxMovesPerGeneration = 300;
    Const.LmrStatScoreOffset = 4334;
    Const.LmrStatScoreDivisor = 15914;
    Const.PawnHashEntryCount = 65536;
    Const.LazyEvalBaseMargin = 1815.5;
    Const.LazyEvalRootFactor = 1.25;
    Const.LazyEvalMaterialDivisor = 32;
    Const.PickGoodCaptureMinScore = 7000000;
    Const.QuietMoveBaseScore = 2100000;
    Const.QuietSortDepthFactor = 3000;
    Call InitCoordLookup;
    Call FillBoard;
    List.DeleteAll(PieceIdxLookup);
    List.DeleteAll(SafeCheckPieceOrder);
    InitBoard.Idx = 1;
    Repeat (GoK_OwnKing)
    {
        List.Add(PieceIdxLookup, 0);
        InitBoard.Idx += 1;
    }
    List.Add(SafeCheckPieceOrder, GoK_OwnRook);
    List.Add(SafeCheckPieceOrder, GoK_OwnQueen);
    List.Add(SafeCheckPieceOrder, GoK_OwnBishop);
    List.Add(SafeCheckPieceOrder, GoK_OwnKnight);
    List.ReplaceItem(PieceIdxLookup, GoK_OwnPawn, 1);
    List.ReplaceItem(PieceIdxLookup, GoK_OwnKnight, 2);
    List.ReplaceItem(PieceIdxLookup, GoK_OwnBishop, 3);
    List.ReplaceItem(PieceIdxLookup, GoK_OwnRook, 4);
    List.ReplaceItem(PieceIdxLookup, GoK_OwnQueen, 5);
    List.ReplaceItem(PieceIdxLookup, GoK_OwnKing, 6);
    List.DeleteItem(AttackTypeMaskWeights, all);
    List.Add(AttackTypeMaskWeights, 1);
    List.Add(AttackTypeMaskWeights, 10);
    List.Add(AttackTypeMaskWeights, 100);
    List.Add(AttackTypeMaskWeights, 1000);
    List.Add(AttackTypeMaskWeights, 10000);
    List.Add(AttackTypeMaskWeights, 0);
    Const.CharsUpperCase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    List.DeleteItem(CharsUpperCaseList, all);
    InitBoard.Idx = 1;
    Repeat (List.Length(CharsUpperCaseList))
    {
        List.Add(CharsUpperCaseList, Operator.LetterOf(Const.CharsUpperCase, InitBoard.Idx));
        InitBoard.Idx += 1;
    }
    List.DeleteItem(KillerMoves, all);
    Repeat ((2 * Const.MaxPlyStackFrames))
    {
        List.Add(KillerMoves, Const.Null);
    }
    List.DeleteAll(PinSq);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(PinSq, 0);
    }
    List.DeleteAll(PinRay);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(PinRay, 0);
    }
    List.DeleteAll(PinCount);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(PinCount, 0);
    }
    List.DeleteAll(DiscoverySq);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(DiscoverySq, 0);
    }
    List.DeleteAll(DiscoveryRay);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(DiscoveryRay, 0);
