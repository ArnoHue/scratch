Define IsCastlingPathSafe(string Move)(string Ply) (warp=true)
{
    Ret.IsCastlingPathSafe.IsSafe = 1;
    If (floor((Move / 100)) == 0)
    {
        IsCastlingPathSafe.FirstIdx = 0;
        If (Move == GoK_OwnQueensideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 3;
        }
        If (Move == GoK_OwnKingsideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 5;
        }
        If (Move == GoK_OppQueensideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 59;
        }
        If (Move == GoK_OppKingsideCastling)
        {
            IsCastlingPathSafe.FirstIdx = 61;
        }
        If (IsCastlingPathSafe.FirstIdx > 0)
        {
            Call CalcBoardAttackedOnDemand(Ply)((1 == 0))((1 == 1))(99);
            IsCastlingPathSafe.BaseIdx = ((Ply - 1) * Const.SnapshotPlyStride);
            If (Not (((PersistedBoardAttackedSnapshot[(IsCastlingPathSafe.BaseIdx + IsCastlingPathSafe.FirstIdx)] == 0) And ((PersistedBoardAttackedSnapshot[(IsCastlingPathSafe.BaseIdx + (IsCastlingPathSafe.FirstIdx + 1))] == 0) And (PersistedBoardAttackedSnapshot[(IsCastlingPathSafe.BaseIdx + (IsCastlingPathSafe.FirstIdx + 2))] == 0)))))
            {
                Ret.IsCastlingPathSafe.IsSafe = 0;
            }
        }
    }
}

Define IsCheckedFast(string CheckingPly) (warp=true)
{
    Ret.IsCheckedFast.IsChecked = 0;
    If (ChebyshevDistance[((Glob.Board.OwnKingIdx * 100) + Glob.Board.OppKingIdx)] < 2)
    {
        Ret.IsCheckedFast.IsChecked = 1;
        Stop(this script);
    }
    IsCheckedFast.Factor = (1 - (2 * (PlyIsOwn[CheckingPly] == 0)));
    If (IsCheckedFast.Factor > 0)
    {
        IsCheckedFast.KingIdx = Glob.Board.OppKingIdx;
    }
    Else
    {
        IsCheckedFast.KingIdx = Glob.Board.OwnKingIdx;
    }
    IsCheckedFast.KingFile = IdxToFile[IsCheckedFast.KingIdx];
    IsCheckedFast.KingRank = IdxToRank[IsCheckedFast.KingIdx];
    IsCheckedFast.File = (IsCheckedFast.KingFile + 1);
    IsCheckedFast.Rank = (IsCheckedFast.KingRank + 2);
    If (((IsCheckedFast.File > 0) And (IsCheckedFast.File < 9)) And ((IsCheckedFast.Rank > 0) And (IsCheckedFast.Rank < 9)))
    {
        IsCheckedFast.SqIdx = (IsCheckedFast.File + ((IsCheckedFast.Rank - 1) * 8));
        IsCheckedFast.Piece = Board[IsCheckedFast.SqIdx];
        If (((IsCheckedFast.Piece * IsCheckedFast.Factor) > 0) And (abs(IsCheckedFast.Piece) == GoK_OwnKnight))
        {
            If ((Ret.IsCheckedFast.IsChecked == 0) Or (IsCheckedFast.SqIdx < Ret.IsCheckedFast.CheckedByIdx))
            {
                Ret.IsCheckedFast.CheckedByIdx = IsCheckedFast.SqIdx;
            }
            Ret.IsCheckedFast.IsChecked = 1;
        }
    }
    IsCheckedFast.File = (IsCheckedFast.KingFile + 2);
    IsCheckedFast.Rank = (IsCheckedFast.KingRank + 1);
    If (((IsCheckedFast.File > 0) And (IsCheckedFast.File < 9)) And ((IsCheckedFast.Rank > 0) And (IsCheckedFast.Rank < 9)))
    {
