            Init.OB.Line = OpeningMoves[Init.OB.OpeningMoveIdx];
            Init.OB.LineMoves = "";
            Init.OB.CharIdx = 1;
            Repeat ((Variable.Length(Init.OB.Line) / 4))
            {
                Init.OB.MoveStr = Operator.Join(Operator.Join(Operator.LetterOf(Init.OB.Line, Init.OB.CharIdx), Operator.LetterOf(Init.OB.Line, (Init.OB.CharIdx + 1))), Operator.Join(Operator.LetterOf(Init.OB.Line, (Init.OB.CharIdx + 2)), Operator.LetterOf(Init.OB.Line, (Init.OB.CharIdx + 3))));
                Call GetPhysicalMove(Init.OB.MoveStr);
                Init.OB.LineMoves = Operator.Join(Init.OB.LineMoves, MoveToZeroPadStr[(floor(Ret.GetPhysicalMove.Move) + 1)]);
                Init.OB.CharIdx += 4;
            }
            If ((Operator.Join(Operator.LetterOf(Init.OB.LineMoves, 1), Operator.LetterOf(Init.OB.LineMoves, 2)) == 9) Or (Operator.Join(Operator.LetterOf(Init.OB.LineMoves, 1), Operator.LetterOf(Init.OB.LineMoves, 2)) == 16))
            {
                List.ReplaceItem(OpeningMoves, Init.OB.OpeningMoveIdx, "");
            }
            Else
            {
                List.ReplaceItem(OpeningMoves, Init.OB.OpeningMoveIdx, Init.OB.LineMoves);
            }
            Init.OB.OpeningMoveIdx += 1;
        }
    }
}

Define InitOpeningMovesMap (warp=true)
{
    List.DeleteAll(OpeningMovesMapHash);
    List.DeleteAll(OpeningMovesMapMove);
    List.DeleteAll(OpeningMovesMapStack);
    Repeat (List.Length(OpeningMoves))
    {
        List.Add(OpeningMovesMapStack, 1);
    }
    Call CreateCurrentBoardHash;
    Call InitOpeningMovesMapImpl((1 + Glob.IsPlayerBlack))(0)("")((1 == 1));
}

Define InitOpeningMovesMapImpl(string Ply)(string GameMovesLen)(string Move)(bool Init) (warp=true)
{
    List.DeleteAll(OpeningMovesRes);
    Init.OMMI.OpeningMovesMapStackIdx = 1;
    Repeat (List.Length(OpeningMovesMapStack))
    {
        Init.OMMI.IsEqual = 0;
        Init.OMMI.Line = OpeningMoves[Init.OMMI.OpeningMovesMapStackIdx];
        If ((OpeningMovesMapStack[Init.OMMI.OpeningMovesMapStackIdx] % 2) == 1)
        {
            Init.OMMI.IsEqual = 1;
            Init.OMMI.CharIdx = 1;
            If (Not (Init))
            {
                Repeat Until ((Init.OMMI.IsEqual == 0) Or (Init.OMMI.CharIdx > 4))
                {
                    If (Not ((Operator.LetterOf(Move, Init.OMMI.CharIdx) == Operator.LetterOf(Init.OMMI.Line, (GameMovesLen + Init.OMMI.CharIdx)))))
                    {
                        Init.OMMI.IsEqual = 0;
                    }
                    Init.OMMI.CharIdx += 1;
                }
            }
        }
        If (Init.OMMI.IsEqual == 1)
        {
            Init.OMMI.MoveStr = Operator.Join(Operator.Join(Operator.LetterOf(Init.OMMI.Line, (GameMovesLen + Init.OMMI.CharIdx)), Operator.LetterOf(Init.OMMI.Line, ((GameMovesLen + Init.OMMI.CharIdx) + 1))), Operator.Join(Operator.LetterOf(Init.OMMI.Line, ((GameMovesLen + Init.OMMI.CharIdx) + 2)), Operator.LetterOf(Init.OMMI.Line, ((GameMovesLen + Init.OMMI.CharIdx) + 3))));
            If (Not ((Init.OMMI.MoveStr == "")))
            {
                List.Add(OpeningMovesRes, (Init.OMMI.MoveStr + 0));
            }
            List.ReplaceItem(OpeningMovesMapStack, Init.OMMI.OpeningMovesMapStackIdx, ((OpeningMovesMapStack[Init.OMMI.OpeningMovesMapStackIdx] * 2) + 1));
        }
        Else
        {
            List.ReplaceItem(OpeningMovesMapStack, Init.OMMI.OpeningMovesMapStackIdx, (OpeningMovesMapStack[Init.OMMI.OpeningMovesMapStackIdx] * 2));
        }
        Init.OMMI.OpeningMovesMapStackIdx += 1;
    }
    If (List.Length(OpeningMovesRes) > 0)
    {
        List.DeleteAll(TmpList1);
        Call ClearMoveList(Ply);
        Init.OMMI.ResIdx = 1;
        Repeat (List.Length(OpeningMovesRes))
        {
            Init.OMMI.MoveStr = OpeningMovesRes[Init.OMMI.ResIdx];
            List.Add(OpeningMovesMapHash, Glob.CurrentBoardHash);
            List.Add(OpeningMovesMapMove, Init.OMMI.MoveStr);
            If (Not (List.ContainsItem(TmpList1, Init.OMMI.MoveStr)))
            {
                Call AddMoveToList(Init.OMMI.MoveStr)(Ply)(0);
                List.Add(TmpList1, Init.OMMI.MoveStr);
            }
            Init.OMMI.ResIdx += 1;
        }
        List.ReplaceItem(MovesIdx, Ply, 1);
        Repeat (MovesCount[Ply])
        {
            Call ApplyMoveLight(Ply);
            Call GetCurrentMove(Ply);
            If Init
            {
                Call GetNormalizedMove(AppliedMove[Ply]);
                Call InitOpeningMovesMapImpl((Ply + 1))(0)(Ret.GetNormalizedMove.Move)((1 == 0));
            }
            Else
            {
                Call GetNormalizedMove(AppliedMove[Ply]);
                Call InitOpeningMovesMapImpl((Ply + 1))((GameMovesLen + 4))(Ret.GetNormalizedMove.Move)((1 == 0));
            }
            Call RevertMoveLight(Ply);
            List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
        }
    }
    Init.OMMI.OpeningMovesMapStackIdx = 1;
    Repeat (List.Length(OpeningMovesMapStack))
    {
        List.ReplaceItem(OpeningMovesMapStack, Init.OMMI.OpeningMovesMapStackIdx, floor((OpeningMovesMapStack[Init.OMMI.OpeningMovesMapStackIdx] / 2)));
        Init.OMMI.OpeningMovesMapStackIdx += 1;
    }
}

