                        }
                        If (PMH.Bonus < -2000)
                        {
                            PMH.Bonus = -2000;
                        }
                        PMH.Idx = (PlyHistoryBaseIdx[(Ply - 1)] + ((floor((AppliedMove[(Ply - 1)] / 100)) * 64) + floor((AppliedMove[(Ply - 1)] % 100))));
                        List.ReplaceItem(HistoryMoveScores, PMH.Idx, (HistoryMoveScores[PMH.Idx] + (PMH.Bonus - floor((HistoryMoveScores[PMH.Idx] * (abs(PMH.Bonus) / 7183))))));
                    }
