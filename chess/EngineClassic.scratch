Define IsCheckingPiece(string Idx) (warp=true)
{
    Call IsCheckingPieceImpl(Idx)(Board[(Idx + 0)]);
    Ret.IsCheckingPiece.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
}

Define IsCheckingPieceDiscovery(string SourceIdx)(string TargetIdx)(string Ply) (warp=true)
{
    Call IsCheckingPieceImpl(SourceIdx)((GoK_OwnQueen * ((PlyIsOwn[Ply] * 2) - 1)));
    Ret.IsCheckingPieceDiscovery.IsChecking = Ret.IsCheckingPieceImpl.IsChecking;
    If (Ret.IsCheckingPieceDiscovery.IsChecking == 0)
    {
        Stop(this script);
    }
    Call CalcBoardAttackedByMoveChecked((Ply + 2));
    If (((PlyIsOwn[Ply] == 1) And (Glob.IsOppSideChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsOwnSideChecked == 1)))
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 1;
    }
    Else
    {
        Ret.IsCheckingPieceDiscovery.IsChecking = 0;
    }
}

Define IsCheckingPieceImpl(string Idx)(string Piece) (warp=true)
{
    Ret.IsCheckingPieceImpl.IsChecking = 0;
    If (abs(Piece) == GoK_OwnKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.OppKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(Idx)(Glob.OwnKingIdx);
    }
    Ret.IsCheckingPieceImpl.IsChecking = Ret.IsReachableForAttack.IsReachable;
}

Define IsDrawByMaterial (warp=true)
{
    Ret.IsDrawByMaterial.IsDraw = 0;
    IDBM.OwnMinorCnt = 0;
    IDBM.OppMinorCnt = 0;
    IDBM.SqIdx = 1;
    Repeat (64)
    {
        IDBM.Piece = Board[IDBM.SqIdx];
        If (Not ((IDBM.Piece == 0)))
        {
            If ((IDBM.Piece == GoK_OwnBishop) Or (IDBM.Piece == GoK_OwnKnight))
            {
                IDBM.OwnMinorCnt += 1;
            }
            Else
            {
                If ((IDBM.Piece == GoK_OppBishop) Or (IDBM.Piece == GoK_OppKnight))
                {
                    IDBM.OppMinorCnt += 1;
                }
                Else
                {
                    If (Not ((abs(IDBM.Piece) == GoK_OwnKing)))
                    {
                        Stop(this script);
                    }
                }
            }
        }
        IDBM.SqIdx += 1;
    }
    If ((IDBM.OwnMinorCnt + IDBM.OppMinorCnt) < 2)
    {
        Ret.IsDrawByMaterial.IsDraw = 1;
    }
}

Define IsDrawByStalemate(string Ply) (warp=true)
{
    Call CalcBoardAttackedByMoveChecked((Ply + 1));
    If (((PlyIsOwn[Ply] == 1) And (Glob.IsOwnSideChecked == 1)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsOppSideChecked == 1)))
    {
        Ret.IsDrawByStalemate.IsDraw = 0;
        Stop(this script);
    }
    List.ReplaceItem(Quiescence, Ply, 0);
    Call CalcBoardAttackedByMove((Ply + 1));
    Call StoreAttackInfo((Ply + 1))(Ply);
    List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
    Call GenerateMovesImplWrapper(Ply)((1 == 0))((1 == 0));
    List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
    If (Quiescence[Ply] == 0)
    {
        Glob.MoveCount += MovesCount[Ply];
    }
    Else
    {
        Glob.MoveCountQ += MovesCount[Ply];
    }
    List.ReplaceItem(MovesIdx, Ply, 1);
    Ret.IsDrawByStalemate.IsDraw = 1;
    Repeat (MovesCount[Ply])
    {
        Call ApplyMove(Ply);
        Call CalcBoardAttackedByMoveChecked((Ply + 1));
        If (((PlyIsOwn[Ply] == 1) And (Glob.IsOwnSideChecked == 0)) Or ((PlyIsOwn[Ply] == 0) And (Glob.IsOppSideChecked == 0)))
        {
            Ret.IsDrawByStalemate.IsDraw = 0;
            Call RevertMove(Ply);
            Stop(this script);
        }
        Call RevertMove(Ply);
        List.ReplaceItem(MovesIdx, Ply, (MovesIdx[Ply] + 1));
    }
}

Define IsEngineValidMove(string Move) (warp=true)
{
    Call GenerateMovesPublic(1);
    If List.ContainsItem(Moves1, Move)
    {
        Ret.IsEngineValidMove.IsValid = 1;
    }
    Else
    {
        Ret.IsEngineValidMove.IsValid = 0;
    }
    If (Ret.IsEngineValidMove.IsValid == 1)
    {
        Call ClearMoveList(1);
        Call AddMoveToList(Move)(1)(0);
        List.ReplaceItem(MovesIdx, 1, 1);
        Glob.IsOwnSideChecked = 0;
        Glob.IsOppSideChecked = 0;
        Call ApplyMove(1);
        Call CalcBoardAttackedByMove(2);
        If (Glob.IsOwnSideChecked == 1)
        {
            Ret.IsEngineValidMove.IsValid = 0;
        }
        Call RevertMove(1);
    }
}

Define IsLegalGeom(string PieceIdx)(string FromIdx)(string ToIdx)(string IsOpp) (warp=true)
{
    Ret.IsLegalGeom.IsLegal = 0;
    If ((FromIdx == 0) Or (ToIdx == 0))
    {
        Ret.IsLegalGeom.IsLegal = 1;
    }
    If (((FromIdx < 65) And (ToIdx < 65)) And ((FromIdx > 0) And ((ToIdx > 0) And (Not ((FromIdx == ToIdx))))))
    {
        ILG.DF = (IdxToFile[(ToIdx + 0)] - IdxToFile[(FromIdx + 0)]);
        ILG.DR = (IdxToRank[(ToIdx + 0)] - IdxToRank[(FromIdx + 0)]);
        ILG.AF = abs(ILG.DF);
        ILG.AR = abs(ILG.DR);
        If (PieceIdx == 1)
        {
            If ((ILG.AF < 2) And (((IsOpp == 0) And (ILG.DR == 1)) Or ((IsOpp == 1) And (ILG.DR == -1))))
            {
                Ret.IsLegalGeom.IsLegal = 1;
            }
            If ((ILG.AF == 0) And (((IdxToRank[(FromIdx + 0)] == 2) And ((IsOpp == 0) And (ILG.DR == 2))) Or ((IdxToRank[(FromIdx + 0)] == 7) And ((IsOpp == 1) And (ILG.DR == -2)))))
            {
                Ret.IsLegalGeom.IsLegal = 1;
            }
        }
        If (PieceIdx == 2)
        {
            If (((ILG.AF == 1) And (ILG.AR == 2)) Or ((ILG.AF == 2) And (ILG.AR == 1)))
            {
                Ret.IsLegalGeom.IsLegal = 1;
            }
        }
        If (PieceIdx == 3)
        {
            If (ILG.AF == ILG.AR)
            {
                Ret.IsLegalGeom.IsLegal = 1;
            }
        }
        If (PieceIdx == 4)
        {
            If ((ILG.AF == 0) Or (ILG.AR == 0))
            {
                Ret.IsLegalGeom.IsLegal = 1;
            }
        }
        If (PieceIdx == 5)
        {
            If ((ILG.AF == ILG.AR) Or ((ILG.AF == 0) Or (ILG.AR == 0)))
            {
                Ret.IsLegalGeom.IsLegal = 1;
            }
        }
        If (PieceIdx == 6)
        {
            If ((ILG.AF < 2) And (ILG.AR < 2))
            {
                Ret.IsLegalGeom.IsLegal = 1;
            }
        }
    }
}

Define IsLowerCase(string Char) (warp=true)
{
    ILC.Chars = "";
    ILC.CharsIdx = 1;
    Repeat (Variable.Length(Const.CharsUpperCase))
    {
        If (Operator.LetterOf(Const.CharsUpperCase, ILC.CharsIdx) == Char)
        {
            ILC.Chars = Operator.Join(ILC.Chars, Char);
        }
        Else
        {
            ILC.Chars = Operator.Join(ILC.Chars, Operator.LetterOf(Const.CharsUpperCase, ILC.CharsIdx));
        }
        ILC.CharsIdx += 1;
    }
    Looks.SwitchCostumeTo(_ABCDEFGHIJKLMNOPQRSTUVWXYZ);
    Looks.SwitchCostumeTo(ILC.Chars);
    If (Costume.GetNumberName(number) == 1)
    {
        Ret.IsLowerCase.IsLower = 0;
    }
    Else
    {
        Ret.IsLowerCase.IsLower = 1;
    }
}

Define IsMoveLegalFast(string Ply) (warp=true)
{
    If ((CheckedState[Ply] == 1) Or (floor((AppliedMove[Ply] / 100)) == 0))
    {
        Call IsCheckedFast((Ply + 1));
        Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
    }
    Else
    {
        IMLF.FromIdx = floor((AppliedMove[Ply] / 100));
        IMLF.ToIdx = floor((AppliedMove[Ply] % 100));
        If ((abs(SourcePieces[Ply]) == GoK_OwnKing) Or (Not ((TargetPiecesIdx[Ply] == IMLF.ToIdx))))
        {
            Call IsCheckedFast((Ply + 1));
            Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
        }
        Else
        {
            Ret.IsMoveLegalFast.IsLegal = 0;
            IMLF.PinIdx = 1;
            Repeat (PinCount[Ply])
            {
                If (PinSq[(((Ply - 1) * 8) + IMLF.PinIdx)] == IMLF.FromIdx)
                {
                    If (Not ((abs(MovePathStepInc[((IMLF.FromIdx * 100) + IMLF.ToIdx)]) == PinRay[(((Ply - 1) * 8) + IMLF.PinIdx)])))
                    {
                        Ret.IsMoveLegalFast.IsLegal = 1;
                    }
                }
                IMLF.PinIdx += 1;
            }
            If (Glob.ProfilerMode == 2)
            {
                IMLF.IsChecked = Ret.IsMoveLegalFast.IsLegal;
                Call IsCheckedFast((Ply + 1));
                Ret.IsMoveLegalFast.IsLegal = Ret.IsCheckedFast.IsChecked;
                If (Not ((IMLF.IsChecked == Ret.IsMoveLegalFast.IsLegal)))
                {
                    Call Log("CheckInfoMismatch legal depth=")(Ply)(" move=")(AppliedMove[Ply])(" new=")(IMLF.IsChecked)(" old=")(Ret.IsMoveLegalFast.IsLegal);
                }
            }
        }
    }
}

Define IsMovePicked(string Ply)(string Move) (warp=true)
{
    Ret.IsMovePicked.Picked = 0;
    IMP.MPScanIdx = 1;
    Repeat Until (IMP.MPScanIdx > PickedPseudoLegalMovesCount[Ply])
    {
        If (PickedPseudoLegalMoves[(((Ply - 1) * Const.MaxMovesPerGeneration) + IMP.MPScanIdx)] == Move)
        {
            Ret.IsMovePicked.Picked = 1;
            Ret.IsMovePicked.Score = PickedPseudoLegalMovesScore[(((Ply - 1) * Const.MaxMovesPerGeneration) + IMP.MPScanIdx)];
            Stop(this script);
        }
        IMP.MPScanIdx += 1;
    }
}

Define IsOppKingCheckMate (warp=true)
{
    Ret.IsOppKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(1);
    If (Glob.IsOppSideChecked == 1)
    {
        Ret.IsOppKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            If (Ret.IsOppKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(2);
                Call CalcBoardAttackedByMove(1);
                If (Glob.IsOppSideChecked == 0)
                {
                    Ret.IsOppKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(2);
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
    }
}

Define IsOwnKingCheckMate (warp=true)
{
    Ret.IsOwnKingCheckMate.IsCheckMate = 0;
    Call CalcBoardAttackedByMove(2);
    If (Glob.IsOwnSideChecked == 1)
    {
        Ret.IsOwnKingCheckMate.IsCheckMate = 1;
        Call GenerateMovesPublic(1);
        List.ReplaceItem(MovesIdx, 1, 1);
        Repeat (MovesCount[1])
        {
            If (Ret.IsOwnKingCheckMate.IsCheckMate == 1)
            {
                Call ApplyMove(1);
                Call CalcBoardAttackedByMove(2);
                If (Glob.IsOwnSideChecked == 0)
                {
                    Ret.IsOwnKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(1);
            }
            List.ReplaceItem(MovesIdx, 1, (MovesIdx[1] + 1));
        }
    }
}

Define IsQuiescentCheckCond(string Ply) (warp=true)
{
    Call Comment("Quiescence search extension for checking moves, esp. check sequences. Return value defined whether check sequences should pursued at this point");
    Ret.IsQuiescentCheckCond.IsTrue = 0;
    If (1 == 1)
    {
        If (Glob.IsScratch3 == 0)
        {
            If ((Quiescence[Ply] == 1) And (Quiescence[(Ply - 1)] == 0))
            {
                Ret.IsQuiescentCheckCond.IsTrue = 1;
            }
        }
    }
}

Define IsReachableForAttack(string Piece)(string FromIdx)(string ToIdx) (warp=true)
{
    Ret.IsReachableForAttack.IsReachable = 0;
    If (Piece == 0)
    {
        Stop(this script);
    }
    IRFA.A = abs(Piece);
    IRFA.AF = abs((IdxToFile[ToIdx] - IdxToFile[FromIdx]));
    IRFA.DR = (IdxToRank[ToIdx] - IdxToRank[FromIdx]);
    IRFA.AR = abs(IRFA.DR);
    If (Not ((((((IRFA.A == GoK_OwnPawn) And ((IRFA.AF == 1) And (((Piece > 0) And (IRFA.DR == 1)) Or ((Piece < 0) And (IRFA.DR == -1))))) Or ((IRFA.A == GoK_OwnKing) And (((IRFA.AF < 2) And (IRFA.AR < 2)) And ((IRFA.AF + IRFA.AR) > 0)))) Or (((IRFA.A == GoK_OwnKnight) And (((IRFA.AF == 1) And (IRFA.AR == 2)) Or ((IRFA.AF == 2) And (IRFA.AR == 1)))) Or ((IRFA.A == GoK_OwnBishop) And ((IRFA.AF == IRFA.AR) And (IRFA.AF > 0))))) Or (((IRFA.A == GoK_OwnRook) And (((IRFA.AF == 0) Or (IRFA.AR == 0)) And ((IRFA.AF + IRFA.AR) > 0))) Or ((IRFA.A == GoK_OwnQueen) And (((IRFA.AF == IRFA.AR) Or ((IRFA.AF == 0) Or (IRFA.AR == 0))) And ((IRFA.AF + IRFA.AR) > 0)))))))
    {
        Stop(this script);
    }
    If ((abs(Piece) == GoK_OwnKing) Or (abs(Piece) == GoK_OwnKnight))
    {
        Ret.IsReachableForAttack.IsReachable = 1;
        Stop(this script);
    }
    If (abs(Piece) == GoK_OwnPawn)
    {
        If (Not ((IdxToFile[(FromIdx + 0)] == IdxToFile[(ToIdx + 0)])))
        {
            Ret.IsReachableForAttack.IsReachable = 1;
        }
        Stop(this script);
    }
    IRFA.Idx = ((FromIdx * 100) + ToIdx);
    IRFA.SourceIdx = FromIdx;
    Repeat ((MovePathDelta[IRFA.Idx] - 1))
    {
        IRFA.SourceIdx += MovePathStepInc[IRFA.Idx];
        If (Not ((Board[IRFA.SourceIdx] == 0)))
        {
            Stop(this script);
        }
    }
    Ret.IsReachableForAttack.IsReachable = 1;
}

Define KingSafeChecks(string KSCSide)(string KSCTargetIdx)(string KSCFoundMask)(string KSCAttacked)(string KSCDefended)(string KSCDefenderPieceAbs) (warp=true)
{
    KSC.Mask = KSCFoundMask;
    KSC.RookFired = 0;
    KSC.QueenFired = 0;
    KSC.OrderIdx = 0;
    Repeat (4)
    {
        KSC.OrderIdx += 1;
        KSC.PieceIdxLookup = (KSC.PieceOrder[KSC.OrderIdx] + 0);
        If (Not ((((KSC.PieceIdxLookup == 5) And (KSC.RookFired == 1)) Or ((KSC.PieceIdxLookup == 3) And (KSC.QueenFired == 1)))))
        {
            KSC.QRBN = (AttackTypeMaskWeights[(KSC.PieceIdxLookup - 1)] + 0);
            KSC.AttackWeight = (AttackTypeMaskWeights[KSC.PieceIdxLookup] + 0);
            If ((floor((KSC.Mask / KSC.AttackWeight)) - (10 * floor((KSC.Mask / (KSC.AttackWeight * 10))))) > 0)
            {
                If (KSCSide == 1)
                {
                    KSC.KingIdx = Glob.OwnKingIdx;
                }
                Else
                {
                    KSC.KingIdx = Glob.OppKingIdx;
                }
                KSC.IsSlider = (KSC.PieceIdxLookup > 2);
                KSC.IsUnsafe = (KSC.PieceIdxLookup < 5);
                KSC.Move = ((KSCTargetIdx * 100) + KSC.KingIdx);
                KSC.MoveKey = ((KSC.PieceIdxLookup * 10000) + KSC.Move);
                Call IsLegalGeom(KSC.PieceIdxLookup)(KSCTargetIdx)(KSC.KingIdx)((0 + (KSCSide == 1)));
                If (((KSCSide == 1) And (Ret.IsLegalGeom.IsLegal == 1)) Or ((KSCSide == 2) And (Ret.IsLegalGeom.IsLegal == 1)))
                {
                    KSC.TargetPiece = (Board[(KSCTargetIdx + 0)] + 0);
                    If (((KSCSide == 1) And (Not ((KSC.TargetPiece < 0)))) Or ((KSCSide == 2) And (Not ((KSC.TargetPiece > 0)))))
                    {
                        KSC.Found = 1;
                        If (KSC.IsSlider == 1)
                        {
                            KSC.SourceIdx = KSCTargetIdx;
                            KSC.RayStep = MovePathStepInc[KSC.Move];
                            Repeat Until ((KSC.Found == 0) Or ((KSC.SourceIdx + KSC.RayStep) == KSC.KingIdx))
                            {
                                KSC.SourceIdx += KSC.RayStep;
                                If (Not ((Board[KSC.SourceIdx] == 0)))
                                {
                                    If (Not ((((KSCSide == 1) And (Board[KSC.SourceIdx] == GoK_OwnQueen)) Or ((KSCSide == 2) And (Board[KSC.SourceIdx] == GoK_OppQueen)))))
                                    {
                                        KSC.Found = 0;
                                    }
                                }
                            }
                        }
                        If (KSC.Found == 1)
                        {
                            KSC.IsWeak = ((KSCDefended == 0) Or ((KSCDefended < 2) And (KSCDefenderPieceAbs > GoK_OwnRook)));
                            If (((KSCDefended == 0) Or ((KSC.IsWeak == 1) And (KSCAttacked > 1))) And (Not (((KSC.PieceIdxLookup == 5) And (KSCDefenderPieceAbs == GoK_OwnQueen)))))
                            {
                                List.ReplaceItem(KingAttackSafeChecks, (KSCSide + 0), (KingAttackSafeChecks[(KSCSide + 0)] + KSC.QRBN));
                                If (KSC.PieceIdxLookup == 4)
                                {
                                    KSC.RookFired = 1;
                                }
                                If (KSC.PieceIdxLookup == 5)
                                {
                                    KSC.QueenFired = 1;
                                }
                            }
                            Else
                            {
                                If (KSC.IsUnsafe == 1)
                                {
                                    If ((KSCDefended == 0) Or (KSCDefenderPieceAbs > GoK_OwnPawn))
                                    {
                                        List.ReplaceItem(KingAttackUnsafeChecks, (KSCSide + 0), (KingAttackUnsafeChecks[(KSCSide + 0)] + 1));
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Define LoadList(string Data)(string ListName) (warp=true)
{
    LL.CharIdx = 1;
    LL.Token = "";
    Repeat Until (LL.CharIdx > Variable.Length(Data))
    {
        If ((Not ((Operator.LetterOf(Data, LL.CharIdx) == " "))) And (Not ((Operator.LetterOf(Data, LL.CharIdx) == ","))))
        {
            LL.Token = Operator.Join(LL.Token, Operator.LetterOf(Data, LL.CharIdx));
        }
        If ((Operator.LetterOf(Data, LL.CharIdx) == ",") Or (LL.CharIdx == Variable.Length(Data)))
        {
            If (ListName == "PawnPieceSquare")
            {
                List.Add(PawnPieceSquare, Operator.Round((LL.Token * 2)));
            }
            If (ListName == "PawnPieceSquareEndgame")
