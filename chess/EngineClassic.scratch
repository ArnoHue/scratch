    Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
}

Define PS.HorizonRow(string Horizon)(bool Ratios) (warp=true)
{
    If ((((((((((ProfileByHorizon[(Const.Profile.RazoringCalls + Horizon)] + ProfileByHorizon[(Const.Profile.RFPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.NMPCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.FutilityCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.DeltaCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.QSEECalls + Horizon)]) + ProfileByHorizon[(Const.Profile.LMRCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.PVSCalls + Horizon)]) + ProfileByHorizon[(Const.Profile.TTNodeProbe + Horizon)]) + ProfileByHorizon[(Const.Profile.TTMoveProbe + Horizon)]) > 0)
    {
        If (Horizon == 64)
        {
            PS.HorizonRow.Label = "Q";
        }
        Else
        {
            PS.HorizonRow.Label = (Horizon - 1);
        }
        Glob.Profile.ReportLine = "";
        Call PS.Cell(PS.HorizonRow.Label)(9)((1 == 0));
        PS.HorizonRow.Idx = 1;
        If Ratios
        {
            Repeat (11)
            {
                Call PS.RatioCell(ProfileHorizonCols[(PS.HorizonRow.Idx + 1)])(ProfileHorizonCols[(PS.HorizonRow.Idx + 2)])(Horizon)((ProfileHorizonCols[(PS.HorizonRow.Idx + 3)] == 1));
                PS.HorizonRow.Idx += 4;
            }
        }
        Else
        {
            Repeat (11)
            {
                Call PS.Cell(ProfileByHorizon[(ProfileHorizonCols[PS.HorizonRow.Idx] + Horizon)])(9)((1 == 1));
                PS.HorizonRow.Idx += 4;
            }
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.EvaluateBaseIdx + Horizon)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.AttackGenBaseIdx + Horizon)])) / 100))(10)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.MoveGenBaseIdx + Horizon)])) / 100))(9)((1 == 1));
            Call PS.Cell((floor((100 * ProfileTimeByHorizon[(Const.ProfileTime.PickMoveBaseIdx + Horizon)])) / 100))(9)((1 == 1));
        }
        Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
    }
}

Define PS.RatioCell(string HitSlot)(string InvSlot)(string Horizon)(bool HitSlotCountsMisses) (warp=true)
{
    PS.RatioCell.CallCount = ProfileByHorizon[(InvSlot + Horizon)];
    PS.RatioCell.HitCount = ProfileByHorizon[(HitSlot + Horizon)];
    If HitSlotCountsMisses
    {
        PS.RatioCell.HitCount = (PS.RatioCell.CallCount - PS.RatioCell.HitCount);
    }
    Call PS.Cell(Operator.Join((floor(((1000 * PS.RatioCell.HitCount) / (PS.RatioCell.CallCount + (PS.RatioCell.CallCount == 0)))) / 10), "%"))(9)((1 == 1));
}

Define PS.Sum(string Slot) (warp=true)
{
    PS.Sum.Idx = 1;
    Ret.PS.Sum.Total = 0;
    Repeat (64)
    {
        Ret.PS.Sum.Total += ProfileByHorizon[(Slot + PS.Sum.Idx)];
        PS.Sum.Idx += 1;
    }
}

Define PS.SummaryRow(string Label)(string InvSlot)(string HitSlot)(bool HitSlotCountsMisses) (warp=true)
{
    Call PS.Sum(InvSlot);
    PS.SummaryRow.CallCount = Ret.PS.Sum.Total;
    Call PS.Sum(HitSlot);
    PS.SummaryRow.HitCount = Ret.PS.Sum.Total;
    If HitSlotCountsMisses
    {
        PS.SummaryRow.HitCount = (PS.SummaryRow.CallCount - PS.SummaryRow.HitCount);
    }
    Glob.Profile.ReportLine = "";
    Call PS.Cell(Label)(20)((1 == 0));
    Call PS.Cell(PS.SummaryRow.CallCount)(14)((1 == 1));
    Call PS.Cell(PS.SummaryRow.HitCount)(16)((1 == 1));
    Call PS.Cell(Operator.Join(floor(((100 * PS.SummaryRow.HitCount) / (PS.SummaryRow.CallCount + (PS.SummaryRow.CallCount == 0)))), "%"))(10)((1 == 1));
    Call Log(Glob.Profile.ReportLine)("")("")("")("")("")("")("");
}

Define QuickSort (warp=true)
{
    List.DeleteAll(QSPartStack);
    Call QuickSortImpl(1)(List.Length(CalcMovesScoreList));
}

Define QuickSortImpl(string Lo)(string Hi) (warp=true)
{
    QuickSortImpl.PivotScore = CalcMovesScoreList[floor(((Lo + Hi) / 2))];
    QuickSortImpl.LowerIdx = Lo;
    QuickSortImpl.UpperIdx = Hi;
    Repeat Until (QuickSortImpl.LowerIdx > QuickSortImpl.UpperIdx)
    {
        Repeat Until (Not ((CalcMovesScoreList[(QuickSortImpl.LowerIdx + 0)] > QuickSortImpl.PivotScore)))
        {
            QuickSortImpl.LowerIdx += 1;
        }
        Repeat Until (Not ((CalcMovesScoreList[QuickSortImpl.UpperIdx] < QuickSortImpl.PivotScore)))
        {
            QuickSortImpl.UpperIdx += -1;
        }
        If (Not ((QuickSortImpl.LowerIdx > QuickSortImpl.UpperIdx)))
        {
            QuickSortImpl.SwapScore = CalcMovesScoreList[(QuickSortImpl.LowerIdx + 0)];
            List.ReplaceItem(CalcMovesScoreList, (QuickSortImpl.LowerIdx + 0), CalcMovesScoreList[QuickSortImpl.UpperIdx]);
            List.ReplaceItem(CalcMovesScoreList, QuickSortImpl.UpperIdx, QuickSortImpl.SwapScore);
            QuickSortImpl.SwapScore = CalcMovesMoveList[(QuickSortImpl.LowerIdx + 0)];
            List.ReplaceItem(CalcMovesMoveList, (QuickSortImpl.LowerIdx + 0), CalcMovesMoveList[QuickSortImpl.UpperIdx]);
            List.ReplaceItem(CalcMovesMoveList, QuickSortImpl.UpperIdx, QuickSortImpl.SwapScore);
            QuickSortImpl.LowerIdx += 1;
            QuickSortImpl.UpperIdx += -1;
        }
    }
    If (Lo < QuickSortImpl.UpperIdx)
    {
        List.Add(QSPartStack, QuickSortImpl.LowerIdx);
        Call QuickSortImpl(Lo)(QuickSortImpl.UpperIdx);
        QuickSortImpl.LowerIdx = QSPartStack[(List.Length(QSPartStack) + 0)];
        List.DeleteItem(QSPartStack, (List.Length(QSPartStack) + 0));
    }
    If (QuickSortImpl.LowerIdx < Hi)
    {
        Call QuickSortImpl(QuickSortImpl.LowerIdx)(Hi);
    }
}

Define ResetSearchInfo (warp=true)
{
    Glob.Info.Nodes = 0;
    Glob.Info.NodesQ = 0;
    Glob.Info.Moves = 0;
    Glob.Info.MovesQ = 0;
    Glob.Info.Adopted = 0;
    Glob.Info.LastDepth = Const.Null;
    If (Glob.Profile.Mode > Const.ProfilerMode.Off)
    {
        Call PrepStats;
        Glob.Stats.BestMoveCount = 0;
        Glob.Stats.BestMoveIdxSum = 0;
        Glob.Stats.BestMoveCountQuiescence = 0;
        Glob.Stats.BestMoveIdxSumQuiescence = 0;
        Glob.Stats.BadOrderCount = 0;
    }
}

Define ResizeTT (warp=true)
{
    Call //("Doubles the TT and keeps all entries: needs a power-of-two cluster count; cluster c goes to c (key bit = 0) or c + clusters (bit = 1), compacted in order (TTFindSlot stops at the first empty entry)");
    ResizeTT.OldLen = List.Length(TTNodeEntry);
    ResizeTT.OldClusters = (ResizeTT.OldLen / (Const.TTNodeEntrySize * 4));
    Repeat (ResizeTT.OldLen)
    {
        List.Add(TTNodeEntry, Const.Null);
    }
    ResizeTT.C = 1;
    Repeat (ResizeTT.OldClusters)
    {
        ResizeTT.Lo = ResizeTT.C;
        ResizeTT.Hi = (ResizeTT.C + ResizeTT.OldLen);
        ResizeTT.Idx = ResizeTT.C;
        Repeat (4)
        {
            ResizeTT.Hash = TTNodeEntry[(ResizeTT.Idx + Const.TTNodeCol.HashIdx)];
            If (Not ((ResizeTT.Hash == Const.Null)))
            {
                If ((floor((ResizeTT.Hash / ResizeTT.OldClusters)) % 2) == 1)
                {
                    ResizeTT.Dst = ResizeTT.Hi;
                    ResizeTT.Hi += Const.TTNodeEntrySize;
                }
                Else
                {
                    ResizeTT.Dst = ResizeTT.Lo;
                    ResizeTT.Lo += Const.TTNodeEntrySize;
                }
                If (Not ((ResizeTT.Dst == ResizeTT.Idx)))
                {
                    ResizeTT.K = 0;
                    Repeat (Const.TTNodeEntrySize)
                    {
                        List.ReplaceItem(TTNodeEntry, (ResizeTT.Dst + ResizeTT.K), TTNodeEntry[(ResizeTT.Idx + ResizeTT.K)]);
                        List.ReplaceItem(TTNodeEntry, (ResizeTT.Idx + ResizeTT.K), Const.Null);
                        ResizeTT.K += 1;
                    }
                }
            }
            ResizeTT.Idx += Const.TTNodeEntrySize;
        }
        ResizeTT.C += (Const.TTNodeEntrySize * 4);
    }
    Call TTResetSlots;
    Call Log("info string tt resize ")((ResizeTT.OldLen / Const.TTNodeEntrySize))(" -> ")((List.Length(TTNodeEntry) / Const.TTNodeEntrySize))(" entries, last hashfull ")(Ret.GetHashfull.Permill)(Operator.Join(", time ", Operator.Round((1000 * ((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart)))))(Operator.Join(", nodes ", ((Glob.Info.Nodes + Glob.Info.NodesQ) + (Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence))));
}

Define RevertMove(num Ply) (warp=true)
{
    If (Ply == 1)
    {
        List.ReplaceItem(EnPassantTarget, 1, Glob.Board.RootEnPassantTarget);
        List.ReplaceItem(CastlingState, Ply, ((((Glob.Board.HasOwnCastled * CastlingStatePow2[1]) + (Glob.Board.HasOwnKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasOwnRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasOwnRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasOppCastled * CastlingStatePow2[5]) + (Glob.Board.HasOppKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasOppRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasOppRookQSMoved * CastlingStatePow2[8])))));
    }
    Else
    {
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    RevertMove.Move = AppliedMove[Ply];
    RevertMove.SourceIdx = floor((RevertMove.Move / 100));
    If (RevertMove.SourceIdx > 0)
    {
        RevertMove.TargetIdx = floor((RevertMove.Move % 100));
        List.ReplaceItem(Board, (RevertMove.SourceIdx + 0), Board[(RevertMove.TargetIdx + 0)]);
        List.ReplaceItem(Board, (RevertMove.TargetIdx + 0), 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (PromotionPieces[Ply] > 0)
        {
            RevertMove.PromotionCode = (Operator.LetterOf(RevertMove.Move, Variable.Length(RevertMove.Move)) + 0);
            If (RevertMove.PromotionCode == 1)
            {
                Glob.Board.OwnQueenCount += -1;
            }
            If (RevertMove.PromotionCode == 2)
            {
                Glob.Board.OwnRookCount += -1;
                Glob.Board.OwnNonQueenMajorMinorCount += -1;
            }
            If (RevertMove.PromotionCode == 3)
            {
                Glob.Board.OwnBishopCount += -1;
                Glob.Board.OwnNonQueenMajorMinorCount += -1;
            }
            If (RevertMove.PromotionCode == 4)
            {
                Glob.Board.OwnNonQueenMajorMinorCount += -1;
            }
            List.ReplaceItem(Board, RevertMove.SourceIdx, GoK_OwnPawn);
            Glob.Board.OwnPawnCount += 1;
        }
        Else
        {
            If (PromotionPieces[Ply] < 0)
            {
                RevertMove.PromotionCode = (Operator.LetterOf(RevertMove.Move, Variable.Length(RevertMove.Move)) + 0);
                If (RevertMove.PromotionCode == 1)
                {
                    Glob.Board.OppQueenCount += -1;
                }
                If (RevertMove.PromotionCode == 2)
                {
                    Glob.Board.OppRookCount += -1;
                    Glob.Board.OppNonQueenMajorMinorCount += -1;
                }
                If (RevertMove.PromotionCode == 3)
                {
                    Glob.Board.OppBishopCount += -1;
                    Glob.Board.OppNonQueenMajorMinorCount += -1;
                }
                If (RevertMove.PromotionCode == 4)
                {
                    Glob.Board.OppNonQueenMajorMinorCount += -1;
                }
                List.ReplaceItem(Board, RevertMove.SourceIdx, GoK_OppPawn);
                Glob.Board.OppPawnCount += 1;
            }
        }
        If (Board[(RevertMove.SourceIdx + 0)] == GoK_OwnKing)
        {
            Glob.Board.OwnKingIdx = RevertMove.SourceIdx;
        }
        If (Board[(RevertMove.SourceIdx + 0)] == GoK_OppKing)
        {
            Glob.Board.OppKingIdx = RevertMove.SourceIdx;
        }
        RevertMove.TargetPiece = TargetPieces[Ply];
        If (RevertMove.TargetPiece > 0)
        {
            If (RevertMove.TargetPiece == GoK_OwnPawn)
            {
                Glob.Board.OwnPawnCount += 1;
            }
            Else
            {
                If (RevertMove.TargetPiece < GoK_OwnQueen)
                {
                    Glob.Board.OwnNonQueenMajorMinorCount += 1;
                    If (RevertMove.TargetPiece == GoK_OwnRook)
                    {
                        Glob.Board.OwnRookCount += 1;
                    }
                    If (RevertMove.TargetPiece == GoK_OwnBishop)
                    {
                        Glob.Board.OwnBishopCount += 1;
                    }
                }
                Else
                {
                    If (RevertMove.TargetPiece == GoK_OwnQueen)
                    {
                        Glob.Board.OwnQueenCount += 1;
                    }
                    Else
                    {
                        If (RevertMove.TargetPiece == GoK_OwnKing)
                        {
                            Glob.Board.OwnKingIdx = RevertMove.TargetIdx;
                        }
                    }
                }
            }
        }
        If (RevertMove.TargetPiece < 0)
        {
            If (RevertMove.TargetPiece == GoK_OppPawn)
            {
                Glob.Board.OppPawnCount += 1;
            }
            Else
            {
                If (RevertMove.TargetPiece > GoK_OppQueen)
                {
                    Glob.Board.OppNonQueenMajorMinorCount += 1;
                    If (RevertMove.TargetPiece == GoK_OppRook)
                    {
                        Glob.Board.OppRookCount += 1;
                    }
                    If (RevertMove.TargetPiece == GoK_OppBishop)
                    {
                        Glob.Board.OppBishopCount += 1;
                    }
                }
                Else
                {
                    If (RevertMove.TargetPiece == GoK_OppQueen)
                    {
                        Glob.Board.OppQueenCount += 1;
                    }
                    Else
                    {
                        If (RevertMove.TargetPiece == GoK_OppKing)
                        {
                            Glob.Board.OppKingIdx = RevertMove.TargetIdx;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        If (RevertMove.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(Board, 61, GoK_OppKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_OppRook);
            Glob.Board.OppKingIdx = 61;
        }
        Else
        {
            If (RevertMove.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(Board, 57, GoK_OppRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_OppKing);
                Glob.Board.OppKingIdx = 61;
            }
            Else
            {
                If (RevertMove.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(Board, 5, GoK_OwnKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_OwnRook);
                    Glob.Board.OwnKingIdx = 5;
                }
                Else
                {
                    If (RevertMove.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(Board, 1, GoK_OwnRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_OwnKing);
                        Glob.Board.OwnKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.Board.CurrentHash = (PreviousBoardHash[Ply] + 0);
    Glob.Board.KPHash = (PreviousBoardHash2[Ply] + 0);
    Glob.Board.NonPawnHashOwn = PreviousNonPawnHashOwn[Ply];
    Glob.Board.NonPawnHashOpp = PreviousNonPawnHashOpp[Ply];
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    List.DeleteItem(BoardHistoryFiftyMoves, List.Length(BoardHistoryFiftyMoves));
}

Define RevertMoveLight(string Ply) (warp=true)
{
    RevertMoveLight.Move = AppliedMove[Ply];
    RevertMoveLight.SourceIdx = floor((RevertMoveLight.Move / 100));
    If (RevertMoveLight.SourceIdx > 0)
    {
        RevertMoveLight.TargetIdx = floor((RevertMoveLight.Move % 100));
        List.ReplaceItem(Board, RevertMoveLight.SourceIdx, Board[RevertMoveLight.TargetIdx]);
        List.ReplaceItem(Board, RevertMoveLight.TargetIdx, 0);
        List.ReplaceItem(Board, TargetPiecesIdx[Ply], TargetPieces[Ply]);
        If (Board[RevertMoveLight.SourceIdx] == GoK_OwnKing)
        {
            Glob.Board.OwnKingIdx = RevertMoveLight.SourceIdx;
        }
        If (Board[RevertMoveLight.SourceIdx] == GoK_OppKing)
        {
            Glob.Board.OppKingIdx = RevertMoveLight.SourceIdx;
        }
    }
    Else
    {
        If (RevertMoveLight.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(Board, 61, GoK_OppKing);
            List.ReplaceItem(Board, 62, 0);
            List.ReplaceItem(Board, 63, 0);
            List.ReplaceItem(Board, 64, GoK_OppRook);
            Glob.Board.OppKingIdx = 61;
        }
        Else
        {
            If (RevertMoveLight.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(Board, 57, GoK_OppRook);
                List.ReplaceItem(Board, 59, 0);
                List.ReplaceItem(Board, 60, 0);
                List.ReplaceItem(Board, 61, GoK_OppKing);
                Glob.Board.OppKingIdx = 61;
            }
            Else
            {
                If (RevertMoveLight.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(Board, 5, GoK_OwnKing);
                    List.ReplaceItem(Board, 6, 0);
                    List.ReplaceItem(Board, 7, 0);
                    List.ReplaceItem(Board, 8, GoK_OwnRook);
                    Glob.Board.OwnKingIdx = 5;
                }
                Else
                {
                    If (RevertMoveLight.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(Board, 1, GoK_OwnRook);
                        List.ReplaceItem(Board, 4, 0);
                        List.ReplaceItem(Board, 3, 0);
                        List.ReplaceItem(Board, 5, GoK_OwnKing);
                        Glob.Board.OwnKingIdx = 5;
                    }
                }
            }
        }
    }
    Glob.Board.CurrentHash = (PreviousBoardHash[Ply] + 0);
    List.ReplaceItem(AppliedMove, Ply, Const.Null);
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
}

Define SayAsync(string Text)(num Duration) (warp=false)
{
    Glob.UI.SayAsyncText = Text;
    Glob.UI.SayAsyncDuration = Duration;
    Event.Broadcast("sayasyncmsg");
}

Define Search(string Alpha)(string Beta)(string Horizon)(string Ply)(bool InitialDeepening) (warp=true)
{
    Glob.Search.IsInitialDeepening = (InitialDeepening + 0);
    Glob.Search.Alpha = Alpha;
    Glob.Search.Beta = Beta;
    Call Search_Init(Horizon);
    Glob.Eval.DebugLog = 0;
    Glob.Stats.MoveCount = 0;
    Glob.Stats.MoveCountQuiescence = 0;
    Glob.Stats.NodeCount = 0;
    Glob.Stats.NodeCountQuiescence = 0;
    Search.Timer = (Sensing.DaysSince2000() * 86400);
    Call Search_Main(Alpha)(Beta)(Horizon)(Ply)((1 == 0))((1 == 0))(Const.Null);
    Ret.Search.Eval = Ret.Search_Main.Eval;
    Ret.Search.Move = Ret.Search_Main.Move;
    Ret.Search.LegalMoveCount = PickedLegalMovesCount[Ply];
    Search.Timer = ((Sensing.DaysSince2000() * 86400) - Search.Timer);
    Call ExportBoardFEN(1);
    Ret.Search.MPS = Operator.Round(((Glob.Stats.MoveCount + Glob.Stats.MoveCountQuiescence) / Search.Timer));
    If (Ret.Search.MPS == Const.Null)
    {
        Glob.UI.MPS = "kMPS: 0";
    }
    Else
    {
        Glob.UI.MPS = Operator.Join("kMPS: ", Operator.Round((Ret.Search.MPS / 1000)));
    }
    Ret.Search.NPS = Operator.Round(((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) / Search.Timer));
    If (Ret.Search.NPS == Const.Null)
    {
        Glob.UI.NPS = "kNPS: 0";
    }
    Else
    {
        Glob.UI.NPS = Operator.Join("kNPS: ", Operator.Round((Ret.Search.NPS / 1000)));
    }
    Glob.Info.Nodes += Glob.Stats.NodeCount;
    Glob.Info.NodesQ += Glob.Stats.NodeCountQuiescence;
    Glob.Info.Moves += Glob.Stats.MoveCount;
    Glob.Info.MovesQ += Glob.Stats.MoveCountQuiescence;
    If (Not ((Ret.Search.Move == Const.Null)))
    {
        If ((Not ((Ret.Search.Eval == Const.Null))) And (Ret.Search.Eval > Alpha))
        {
            List.DeleteAll(PVStablePrev);
            Search.PVStableIdx = 1;
            Repeat (List.Length(PVStable))
            {
                List.Add(PVStablePrev, PVStable[Search.PVStableIdx]);
                Search.PVStableIdx += 1;
            }
        }
        Call IsQuietMove(Ret.Search.Move);
        If (Ret.IsQuietMove.IsQuiet == 1)
        {
            If (Not ((Ret.Search.Eval < Beta)))
            {
                Call StoreKillerMove(1)(Horizon)(Ret.Search.Move)((1 == 0))((1 == 0))((1 == 1));
            }
        }
    }
}

Define SearchWrp (warp=false)
{
    Call SearchWrp.Prepare;
    Repeat Until (Ret.SearchWrp.IsDone == 1)
    {
        Call SearchWrp.Iteration;
        If (Not ((Glob.Config.IsDCI == 1)))
        {
            If (((Sensing.DaysSince2000() * 86400) > SearchWrp.NextUIUpdate) Or (Ret.SearchWrp.IsDone == 1))
            {
                If (Not ((Ret.SearchWrp.BestMove == Const.Null)))
                {
                    Call OnEvaluationChanged(Ret.SearchWrp.BestMoveEval);
                    Call OnBestMoveChanged(Ret.SearchWrp.BestMove);
                }
                SearchWrp.Now = (Sensing.DaysSince2000() * 86400);
                Call OnProgressChanged((((SearchWrp.Now - Glob.Search.ThinkTimeStart) / SearchWrp.ProgressLimit) * 100));
                SearchWrp.NextUIUpdate = (SearchWrp.Now + SearchWrp.UIUpdateStep);
                SearchWrp.UIUpdateStep = ((SearchWrp.UIUpdateStep * 2) + ((1 - (SearchWrp.UIUpdateStep * 2)) * (SearchWrp.UIUpdateStep > 0.5)));
            }
        }
    }
    Ret.SearchWrp.Move = Glob.Search.IterationBestMove;
    Call LogSearchEnd(Glob.Search.IterationBestMove);
}

Define SearchWrp.Blitz (warp=false)
{
    If (List.Length(TTNodeEntry) == 0)
    {
        Call ClearTT;
    }
    SearchWrp.Blitz.ThinkTimeLimit = ((Glob.Config.Level - 2) * 2);
    Glob.Search.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Call ResetSearchInfo;
    Glob.Search.IsTimeout = 0;
    Glob.Search.IterationIdx = 1;
    If (Glob.Search.IterationIdx == Const.Null)
    {
        Glob.UI.Depth = "D: 0";
    }
    Else
    {
        Glob.UI.Depth = Operator.Join("D: ", Glob.Search.IterationIdx);
    }
    Ret.SearchWrp.Blitz.Move = Const.Null;
    Ret.SearchWrp.BestMoveEval = Const.Null;
    If (Ret.SearchWrp.BestMoveEval == Const.Null)
    {
        Glob.UI.Eval = "EV: 0";
    }
    Else
    {
        Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
    }
    Glob.Search.ThinkTimeLimit = SearchWrp.Blitz.ThinkTimeLimit;
    Repeat ((((Glob.Config.Level - 2) * 2) * (2 - Glob.Config.IsScratch3)))
    {
        If ((Glob.Search.IterationIdx > 3) And (Not ((Ret.SearchWrp.BestMoveEval == Const.Null))))
        {
            SearchWrp.Blitz.ContemptRatio = ((81 * (2 * Ret.SearchWrp.BestMoveEval)) / (abs((2 * Ret.SearchWrp.BestMoveEval)) + 149));
            SearchWrp.ContemptMg = (49 + (((SearchWrp.Blitz.ContemptRatio > 0) - (SearchWrp.Blitz.ContemptRatio < 0)) * floor(abs(SearchWrp.Blitz.ContemptRatio))));
        }
        Else
        {
            SearchWrp.ContemptMg = 49;
        }
        SearchWrp.ContemptEg = (((SearchWrp.ContemptMg > 0) - (SearchWrp.ContemptMg < 0)) * floor((abs(SearchWrp.ContemptMg) / 2)));
        If ((Glob.Search.IsTimeout == 0) And ((Glob.Search.IterationIdx == 1) Or ((Ret.SearchWrp.BestMoveEval == Const.Null) Or (abs(Ret.SearchWrp.BestMoveEval) < Const.AbsMinCheckmateEval))))
        {
            Glob.Search.SelDepth = 0;
            Call Search(-100000)(100000)(Glob.Search.IterationIdx)(1)((Glob.Search.IterationIdx == 1));
            If (Glob.Search.IsTimeout == 0)
            {
                Call LogSearchInfo(Glob.Search.IterationIdx)(1)(Ret.Search.Eval)(-100000)(100000)(Ret.Search.Move)(1);
            }
            If (Not ((Ret.Search.Move == Const.Null)))
            {
                If ((Ret.SearchWrp.Blitz.Move == Const.Null) Or List.ContainsItem(SearchPly1EvalMoves, Ret.SearchWrp.Blitz.Move))
                {
                    Ret.SearchWrp.Blitz.Move = Ret.Search.Move;
                    Ret.SearchWrp.BestMoveEval = Ret.Search.Eval;
                    If (Ret.SearchWrp.BestMoveEval == Const.Null)
                    {
                        Glob.UI.Eval = "EV: 0";
                    }
                    Else
                    {
                        Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
                    }
                }
                Call OnEvaluationChanged(Ret.SearchWrp.BestMoveEval);
                Call OnBestMoveChanged(Ret.SearchWrp.Blitz.Move);
            }
        }
        Glob.Search.IterationIdx += 1;
        If (Glob.Search.IterationIdx == Const.Null)
        {
            Glob.UI.Depth = "D: 0";
        }
        Else
        {
            Glob.UI.Depth = Operator.Join("D: ", Glob.Search.IterationIdx);
        }
    }
    Call LogSearchEnd(Ret.SearchWrp.Blitz.Move);
}

Define SearchWrp.DCI (warp=true)
{
    Call SearchWrp.Prepare;
    Repeat Until (Ret.SearchWrp.IsDone == 1)
    {
        Call SearchWrp.Iteration;
    }
    Ret.SearchWrp.DCI.Move = Glob.Search.IterationBestMove;
    Call LogSearchEnd(Glob.Search.IterationBestMove);
}

Define SearchWrp.DCISlice (warp=true)
{
    Glob.UI.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Repeat Until ((Ret.SearchWrp.IsDone == 1) Or ((Sensing.DaysSince2000() * 86400) > (Glob.UI.PrevProgressUpdate + 1)))
    {
        Call SearchWrp.Iteration;
    }
    Glob.UI.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Ret.SearchWrp.DCI.Move = Glob.Search.IterationBestMove;
    If (Ret.SearchWrp.IsDone == 1)
    {
        Call LogSearchEnd(Glob.Search.IterationBestMove);
    }
}

Define SearchWrp.Easy (warp=false)
{
    If (List.Length(TTNodeEntry) == 0)
    {
        Call ClearTT;
    }
    Glob.Search.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Call ResetSearchInfo;
    Glob.Search.ThinkTimeLimit = 10;
    Ret.SearchWrp.Easy.Move = Const.Null;
    If (Glob.Config.Level == 1)
    {
        SearchWrp.Easy.JuniorDistQuota = 100;
        SearchWrp.Easy.JuniorSearchQuota = 0;
    }
    Else
    {
        If (Glob.Config.Level == 2)
        {
            SearchWrp.Easy.JuniorDistQuota = 40;
            SearchWrp.Easy.JuniorSearchQuota = 20;
        }
    }
    Call Search(-100000)(100000)(1)(1)((1 == 0));
    Ret.SearchWrp.Easy.Move = Ret.Search.Move;
    Call OnEvaluationChanged(Ret.Search.Eval);
    Call OnBestMoveChanged(Ret.SearchWrp.Easy.Move);
    SearchWrp.Easy.Rnd = Operator.Random(1 , 100);
    If (Not ((Ret.SearchWrp.Easy.Move == Const.Null)))
    {
        If ((SearchWrp.Easy.Rnd > ((SearchWrp.Easy.JuniorSearchQuota + 100) / 2)) Or (((BoardAttacked[(floor((Ret.SearchWrp.Easy.Move / 100)) + 64)] == 0) And (Board[floor((Ret.SearchWrp.Easy.Move % 100))] == 0)) And (SearchWrp.Easy.Rnd > SearchWrp.Easy.JuniorSearchQuota)))
        {
            Call GenerateMovesPublic(1);
            List.ReplaceItem(MovesIdx, 1, Operator.Random(1 , ceiling((List.Length(Moves1) * (SearchWrp.Easy.JuniorDistQuota / 100)))));
            Call ApplyMove(1);
            Call CalcBoardAttackedByMove(2)((1 == 0));
            Call RevertMove(1);
            Repeat Until (Glob.Board.IsOwnSideChecked == 0)
            {
                List.ReplaceItem(MovesIdx, 1, Operator.Random(1 , List.Length(Moves1)));
                Call ApplyMove(1);
                Call CalcBoardAttackedByMove(2)((1 == 0));
                Call RevertMove(1);
            }
            Ret.SearchWrp.Easy.Move = Moves1[MovesIdx[1]];
        }
    }
    Call LogSearchEnd(Ret.SearchWrp.Easy.Move);
}

Define SearchWrp.Iteration (warp=true)
{
    If ((Glob.Search.IterationIdx > 3) And (Not ((Ret.SearchWrp.BestMoveEval == Const.Null))))
    {
        SearchWrp.Iteration.ContemptRatio = ((81 * (2 * Ret.SearchWrp.BestMoveEval)) / (abs((2 * Ret.SearchWrp.BestMoveEval)) + 149));
        SearchWrp.ContemptMg = (49 + (((SearchWrp.Iteration.ContemptRatio > 0) - (SearchWrp.Iteration.ContemptRatio < 0)) * floor(abs(SearchWrp.Iteration.ContemptRatio))));
    }
    Else
    {
        SearchWrp.ContemptMg = 49;
    }
    SearchWrp.ContemptEg = (((SearchWrp.ContemptMg > 0) - (SearchWrp.ContemptMg < 0)) * floor((abs(SearchWrp.ContemptMg) / 2)));
    If (((Glob.Search.IterationIdx > 4) And (1 == 1)) And ((Not ((Ret.SearchWrp.BestMoveEval == Const.Null))) And (abs(Ret.SearchWrp.BestMoveEval) < Const.AbsMinCheckmateEval)))
    {
        SearchWrp.Iteration.AspirationDelta = Operator.Round((22 + (abs(Ret.SearchWrp.BestMoveEval) / 10)));
        SearchWrp.Iteration.AspirationAlpha = Operator.Round((Ret.SearchWrp.BestMoveEval - SearchWrp.Iteration.AspirationDelta));
        SearchWrp.Iteration.AspirationBeta = Operator.Round((Ret.SearchWrp.BestMoveEval + SearchWrp.Iteration.AspirationDelta));
    }
    Else
    {
        SearchWrp.Iteration.AspirationAlpha = -100000;
        SearchWrp.Iteration.AspirationBeta = 100000;
    }
    Glob.Search.SelDepth = 0;
    SearchWrp.Iteration.IsAspirationDone = 0;
    SearchWrp.Iteration.FailedHighCount = 0;
    SearchWrp.Iteration.SavedLimit = SearchWrp.ThinkTimeLimit;
    Repeat Until ((SearchWrp.Iteration.IsAspirationDone == 1) Or (Glob.Search.IsTimeout == 1))
    {
        Glob.Search.ThinkTimeLimit = SearchWrp.ThinkTimeLimit;
        SearchWrp.Iteration.SearchDepth = (Glob.Search.IterationIdx - SearchWrp.Iteration.FailedHighCount);
        If (SearchWrp.Iteration.SearchDepth < 1)
        {
            SearchWrp.Iteration.SearchDepth = 1;
        }
        Call Search(SearchWrp.Iteration.AspirationAlpha)(SearchWrp.Iteration.AspirationBeta)(SearchWrp.Iteration.SearchDepth)(1)((Glob.Search.IterationIdx == 1));
        SearchWrp.Iteration.SearchEval = Ret.Search.Eval;
        If ((Not ((Ret.Search.Move == Const.Null))) And (SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha))
        {
            If ((Glob.Search.IterationBestMove == Const.Null) Or List.ContainsItem(SearchPly1EvalMoves, Glob.Search.IterationBestMove))
            {
                Glob.Search.IterationBestMove = Ret.Search.Move;
                Ret.SearchWrp.BestMove = Glob.Search.IterationBestMove;
                Ret.SearchWrp.BestMoveEval = SearchWrp.Iteration.SearchEval;
                If (Ret.SearchWrp.BestMoveEval == Const.Null)
                {
                    Glob.UI.Eval = "EV: 0";
                }
                Else
                {
                    Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
                }
                If (Glob.Search.IsTimeout == 1)
                {
                    Glob.Info.Adopted = 1;
                }
            }
        }
        SearchWrp.Iteration.IsAspirationFail = 0;
        If (Not ((SearchWrp.Iteration.SearchEval == Const.Null)))
        {
            If ((Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha))) Or (Not ((SearchWrp.Iteration.SearchEval < SearchWrp.Iteration.AspirationBeta))))
            {
                SearchWrp.Iteration.IsAspirationFail = 1;
            }
        }
        SearchWrp.Iteration.InfoMove = Glob.Search.IterationBestMove;
        If (Not ((Ret.Search.Move == Const.Null)))
        {
            SearchWrp.Iteration.InfoMove = Ret.Search.Move;
        }
        If (Glob.Search.IsTimeout == 0)
        {
            Call LogSearchInfo(Glob.Search.IterationIdx)(1)(SearchWrp.Iteration.SearchEval)(SearchWrp.Iteration.AspirationAlpha)(SearchWrp.Iteration.AspirationBeta)(SearchWrp.Iteration.InfoMove)(1);
        }
        If ((Glob.Search.IsTimeout == 1) And (Glob.Info.Adopted == 1))
        {
            Call LogSearchInfo(Glob.Search.IterationIdx)(1)(SearchWrp.Iteration.SearchEval)(SearchWrp.Iteration.AspirationAlpha)(SearchWrp.Iteration.AspirationBeta)(SearchWrp.Iteration.InfoMove)(0);
        }
        If ((Glob.Search.IsTimeout == 0) And (SearchWrp.Iteration.IsAspirationFail == 1))
        {
            If ((((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0)) And (Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha))))
            {
                SearchWrp.ThinkTimeLimit = SearchWrp.MaxThinkTime;
            }
            Glob.Search.IsTimeout = 0;
            SearchWrp.Iteration.AspirationDelta = Operator.Round((SearchWrp.Iteration.AspirationDelta * 1.5));
            If (Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha)))
            {
                SearchWrp.Iteration.FailedHighCount = 0;
            }
            Else
            {
                SearchWrp.Iteration.FailedHighCount += 1;
            }
            If ((SearchWrp.Iteration.AspirationDelta < 206) And (abs(SearchWrp.Iteration.SearchEval) < Const.AbsMinCheckmateEval))
            {
                If (Not ((SearchWrp.Iteration.SearchEval > SearchWrp.Iteration.AspirationAlpha)))
                {
                    If (1 == 1)
                    {
                        SearchWrp.Iteration.AspirationBeta = Operator.Round(((SearchWrp.Iteration.AspirationAlpha + SearchWrp.Iteration.AspirationBeta) / 2));
                    }
                    SearchWrp.Iteration.AspirationAlpha = Operator.Round((SearchWrp.Iteration.SearchEval - SearchWrp.Iteration.AspirationDelta));
                }
                Else
                {
                    SearchWrp.Iteration.AspirationBeta = Operator.Round((SearchWrp.Iteration.SearchEval + SearchWrp.Iteration.AspirationDelta));
                }
            }
            Else
            {
                SearchWrp.Iteration.AspirationAlpha = -100000;
                SearchWrp.Iteration.AspirationBeta = 100000;
            }
        }
        Else
        {
            SearchWrp.Iteration.IsAspirationDone = 1;
        }
    }
    SearchWrp.ThinkTimeLimit = SearchWrp.Iteration.SavedLimit;
    SearchWrp.Iteration.IsDeepeningDone = 0;
    If (Glob.Search.IsTimeout == 1)
    {
        SearchWrp.Iteration.IsDeepeningDone = 1;
    }
    Else
    {
        If (Glob.Search.IterationIdx == SearchWrp.MaxSearchPly)
        {
            SearchWrp.Iteration.IsDeepeningDone = 1;
        }
        Else
        {
            If ((Glob.Config.CustomMaxDepth > 0) And (Not ((Glob.Search.IterationIdx < Glob.Config.CustomMaxDepth))))
            {
                SearchWrp.Iteration.IsDeepeningDone = 1;
            }
            Else
            {
                If (Not ((Ret.SearchWrp.BestMoveEval == Const.Null)))
                {
                    If (abs(Ret.SearchWrp.BestMoveEval) > (Const.AbsMaxCheckmateEval - (List.Length(BoardHistoryFiftyMoves) + Glob.Search.IterationIdx)))
                    {
                        SearchWrp.Iteration.IsDeepeningDone = 1;
                    }
                }
            }
        }
    }
    If (((Glob.Search.IterationIdx == 1) And (Ret.Search.LegalMoveCount == 1)) And (1 == 0))
    {
        SearchWrp.Iteration.IsDeepeningDone = 1;
    }
    If (SearchWrp.Iteration.IsDeepeningDone == 1)
    {
        Ret.SearchWrp.IsDone = 1;
    }
    Else
    {
        If ((((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0)) And (Glob.Search.IterationIdx > 4))
        {
            SearchWrp.BestMoveChanges = (SearchWrp.BestMoveChanges / 2);
            If (Glob.Search.IterationBestMove == SearchWrp.StableBestMove)
            {
                SearchWrp.StableBestMoveCount += 1;
            }
            Else
            {
                SearchWrp.StableBestMoveCount = 0;
                If (Not ((SearchWrp.StableBestMove == Const.Null)))
                {
                    SearchWrp.BestMoveChanges += 1;
                }
            }
            SearchWrp.StableBestMove = Glob.Search.IterationBestMove;
            If (SearchWrp.StableBestMoveCount > 5)
            {
                SearchWrp.Iteration.SoftThinkTime = (SearchWrp.OptimumThinkTime * 0.6);
            }
            Else
            {
                SearchWrp.Iteration.SoftThinkTime = (SearchWrp.OptimumThinkTime * (1.3 - (0.14 * SearchWrp.StableBestMoveCount)));
            }
            SearchWrp.Iteration.BestMoveInstability = (1 + (1.88 * SearchWrp.BestMoveChanges));
            SearchWrp.Iteration.SoftThinkTime = (SearchWrp.Iteration.SoftThinkTime * SearchWrp.Iteration.BestMoveInstability);
            If ((SearchWrp.PrevMoveEval == Const.Null) Or ((SearchWrp.PrevIterEval == Const.Null) Or (Ret.SearchWrp.BestMoveEval == Const.Null)))
            {
                SearchWrp.Iteration.FallingEval = 1;
            }
            Else
            {
                SearchWrp.Iteration.FallingEval = ((69 + ((24 * (SearchWrp.PrevMoveEval - Ret.SearchWrp.BestMoveEval)) + (12 * (SearchWrp.PrevIterEval - Ret.SearchWrp.BestMoveEval)))) / 781.4);
                If (SearchWrp.Iteration.FallingEval < 0.5)
                {
                    SearchWrp.Iteration.FallingEval = 0.5;
                }
                If (SearchWrp.Iteration.FallingEval > 1.5)
                {
                    SearchWrp.Iteration.FallingEval = 1.5;
                }
            }
            SearchWrp.Iteration.SoftThinkTime = (SearchWrp.Iteration.SoftThinkTime * (SearchWrp.Iteration.FallingEval / 0.5));
            If (SearchWrp.Iteration.SoftThinkTime > SearchWrp.ThinkTimeLimit)
            {
                SearchWrp.Iteration.SoftThinkTime = SearchWrp.ThinkTimeLimit;
            }
            SearchWrp.Iteration.DepthTimeGrowth = 1.65;
            If ((((((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart) * SearchWrp.Iteration.DepthTimeGrowth) > SearchWrp.Iteration.SoftThinkTime) And (Not ((Glob.Search.IterationIdx < SearchWrp.MinThinkDepth)))) Or ((((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart) * 2.1) > SearchWrp.ThinkTimeLimit))
            {
                Ret.SearchWrp.IsDone = 1;
            }
            SearchWrp.PrevIterEval = Ret.SearchWrp.BestMoveEval;
        }
        If (Ret.SearchWrp.IsDone == 0)
        {
            Glob.Search.IterationIdx += 1;
            If (Glob.Search.IterationIdx == Const.Null)
            {
                Glob.UI.Depth = "D: 0";
            }
            Else
            {
                Glob.UI.Depth = Operator.Join("D: ", Glob.Search.IterationIdx);
            }
        }
    }
    If ((Ret.SearchWrp.IsDone == 1) And (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0)))
    {
        SearchWrp.PrevMoveEval = Ret.SearchWrp.BestMoveEval;
        Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + (Glob.Clock.TimeInc - ((Sensing.DaysSince2000() * 86400) - Glob.Search.ThinkTimeStart)));
        Glob.Clock.MoveCount += 1;
        If ((Glob.Clock.StageMoves > 0) And (Glob.Clock.MoveCount == Glob.Clock.StageMoves))
        {
            Glob.Clock.CurrentTime = (Glob.Clock.CurrentTime + Glob.Clock.StageTime);
        }
        If (SearchWrp.AvgCompletedDepth == Const.Null)
        {
            SearchWrp.AvgCompletedDepth = (Glob.Search.IterationIdx - Glob.Search.IsTimeout);
        }
        Else
        {
            SearchWrp.AvgCompletedDepth = ((0.8 * SearchWrp.AvgCompletedDepth) + (0.2 * (Glob.Search.IterationIdx - Glob.Search.IsTimeout)));
        }
    }
}

Define SearchWrp.Prepare (warp=true)
{
    SearchWrp.Prepare.HistIdx = 1;
    Repeat (List.Length(HistoryMoveScores))
    {
        List.ReplaceItem(HistoryMoveScores, SearchWrp.Prepare.HistIdx, (HistoryMoveScores[SearchWrp.Prepare.HistIdx] / 2));
        SearchWrp.Prepare.HistIdx += 1;
    }
    SearchWrp.Prepare.HistIdx = 1;
    Repeat (List.Length(HistoryCaptureScores))
    {
        List.ReplaceItem(HistoryCaptureScores, SearchWrp.Prepare.HistIdx, (HistoryCaptureScores[SearchWrp.Prepare.HistIdx] / 2));
        SearchWrp.Prepare.HistIdx += 1;
    }
    If (Glob.Config.IsScratch3 == 0)
    {
        SearchWrp.Prepare.HistIdx = 1;
        Repeat (List.Length(HistoryContinuation))
        {
            List.ReplaceItem(HistoryContinuation, SearchWrp.Prepare.HistIdx, (HistoryContinuation[SearchWrp.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation2, SearchWrp.Prepare.HistIdx, (HistoryContinuation2[SearchWrp.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation3, SearchWrp.Prepare.HistIdx, (HistoryContinuation3[SearchWrp.Prepare.HistIdx] / 2));
            List.ReplaceItem(HistoryContinuation4, SearchWrp.Prepare.HistIdx, (HistoryContinuation4[SearchWrp.Prepare.HistIdx] / 2));
            SearchWrp.Prepare.HistIdx += 1;
        }
    }
    If (List.Length(TTNodeEntry) == 0)
    {
        Call ClearTT;
    }
    SearchWrp.MaxSearchPly = (Const.MaxPlyStackFrames - 30);
    If (Glob.Config.Level == 5)
    {
        SearchWrp.ThinkTimeLimit = 10;
    }
    Else
    {
        SearchWrp.ThinkTimeLimit = 20;
    }
    If (Glob.Config.CustomThinkTime > 0)
    {
        SearchWrp.ThinkTimeLimit = Glob.Config.CustomThinkTime;
    }
    If ((Glob.Config.IsDCI == 0) And (Glob.Clock.TimeControl == 0))
    {
        Glob.Clock.InitialTime = 0;
        If (Glob.Config.CustomThinkTime == 0)
        {
            Glob.Clock.TimeInc = SearchWrp.ThinkTimeLimit;
        }
        Else
        {
            Glob.Clock.TimeInc = 0;
        }
        Glob.Clock.CurrentTime = 0;
    }
    If (((Glob.Clock.TimeInc > 0) Or (Glob.Clock.InitialTime > 0)) And (Glob.Config.CustomMaxDepth == 0))
    {
        SearchWrp.Prepare.RemainingTime = (Glob.Clock.CurrentTime + Glob.Clock.TimeInc);
        If (Glob.Clock.StageMoves > Glob.Clock.MoveCount)
        {
            SearchWrp.Prepare.MovesToGo = (Glob.Clock.StageMoves - Glob.Clock.MoveCount);
            If (SearchWrp.Prepare.MovesToGo > 50)
            {
                SearchWrp.Prepare.MovesToGo = 50;
            }
            SearchWrp.Prepare.MaxScale = (1.5 + (0.11 * SearchWrp.Prepare.MovesToGo));
            If (SearchWrp.Prepare.MaxScale > 6.3)
            {
                SearchWrp.Prepare.MaxScale = 6.3;
            }
        }
        Else
        {
            If (Glob.Clock.TimeInc == 0)
            {
                SearchWrp.Prepare.MovesToGo = 40;
            }
            Else
            {
                SearchWrp.Prepare.MovesToGo = 19;
            }
            SearchWrp.Prepare.MaxScale = 4.5;
        }
        SearchWrp.OptimumThinkTime = ((SearchWrp.Prepare.RemainingTime / SearchWrp.Prepare.MovesToGo) + Glob.Clock.TimeInc);
        SearchWrp.MaxThinkTime = (0.8 * SearchWrp.Prepare.RemainingTime);
        If (Glob.Clock.TimeControl == 1)
        {
            SearchWrp.MaxThinkTime = (0.8 * Glob.Clock.CurrentTime);
        }
        If (Glob.Clock.StageMoves > Glob.Clock.MoveCount)
        {
            If (SearchWrp.MaxThinkTime > (SearchWrp.Prepare.RemainingTime - ((SearchWrp.Prepare.MovesToGo - 1) * (0.75 * SearchWrp.OptimumThinkTime))))
            {
                SearchWrp.MaxThinkTime = (SearchWrp.Prepare.RemainingTime - ((SearchWrp.Prepare.MovesToGo - 1) * (0.75 * SearchWrp.OptimumThinkTime)));
            }
        }
        Else
        {
            If (Glob.Clock.TimeInc == 0)
            {
                If (SearchWrp.MaxThinkTime > (SearchWrp.Prepare.MaxScale * SearchWrp.OptimumThinkTime))
                {
                    SearchWrp.MaxThinkTime = (SearchWrp.Prepare.MaxScale * SearchWrp.OptimumThinkTime);
                }
            }
        }
        SearchWrp.ThinkTimeLimit = (SearchWrp.Prepare.MaxScale * SearchWrp.OptimumThinkTime);
        If (SearchWrp.ThinkTimeLimit > SearchWrp.MaxThinkTime)
        {
            SearchWrp.ThinkTimeLimit = SearchWrp.MaxThinkTime;
        }
        If (Glob.Clock.TimeControl == 1)
        {
            If (SearchWrp.MaxThinkTime < 0.05)
            {
                SearchWrp.MaxThinkTime = 0.05;
            }
            If (SearchWrp.ThinkTimeLimit < 0.05)
            {
                SearchWrp.ThinkTimeLimit = 0.05;
            }
        }
        SearchWrp.BestMoveChanges = 0;
        If (Glob.Clock.TimeInc > 0)
        {
            SearchWrp.MinThinkDepth = (floor((9.5 + (1.66 * ln(Glob.Clock.TimeInc)))) - 1);
        }
        Else
        {
            SearchWrp.MinThinkDepth = 0;
        }
        If ((Not ((SearchWrp.AvgCompletedDepth == Const.Null))) And (SearchWrp.AvgCompletedDepth < SearchWrp.MinThinkDepth))
        {
            SearchWrp.MinThinkDepth = floor(SearchWrp.AvgCompletedDepth);
        }
        SearchWrp.StableBestMoveCount = 0;
        SearchWrp.StableBestMove = Const.Null;
        SearchWrp.PrevIterEval = SearchWrp.PrevMoveEval;
    }
    If ((Glob.Config.IsDCI == 0) And (Glob.Config.CustomThinkTime == 0))
    {
        If (SearchWrp.ThinkTimeLimit > 20)
        {
            SearchWrp.ThinkTimeLimit = 20;
        }
        If (SearchWrp.MaxThinkTime > 20)
        {
            SearchWrp.MaxThinkTime = 20;
        }
    }
    SearchWrp.ProgressLimit = SearchWrp.ThinkTimeLimit;
    If ((Glob.Clock.TimeControl == 1) And (SearchWrp.OptimumThinkTime > 0.05))
    {
        SearchWrp.ProgressLimit = SearchWrp.OptimumThinkTime;
    }
    Glob.Search.ThinkTimeStart = (Sensing.DaysSince2000() * 86400);
    Call ResetSearchInfo;
    SearchWrp.NextUIUpdate = (Glob.Search.ThinkTimeStart + 0.1);
    SearchWrp.UIUpdateStep = 0;
    If (Glob.Config.IsTimeModelLogged == 0)
    {
        Glob.Config.IsTimeModelLogged = 1;
    }
    Glob.Search.IsTimeout = 0;
    Ret.SearchWrp.IsDone = 0;
    Glob.Search.IterationIdx = 1;
    If (Glob.Search.IterationIdx == Const.Null)
    {
        Glob.UI.Depth = "D: 0";
    }
    Else
    {
        Glob.UI.Depth = Operator.Join("D: ", Glob.Search.IterationIdx);
    }
    Glob.Search.IterationBestMove = Const.Null;
    Ret.SearchWrp.BestMove = Glob.Search.IterationBestMove;
    Ret.SearchWrp.BestMoveEval = Const.Null;
    If (Ret.SearchWrp.BestMoveEval == Const.Null)
    {
        Glob.UI.Eval = "EV: 0";
    }
    Else
    {
        Glob.UI.Eval = Operator.Join("EV: ", Ret.SearchWrp.BestMoveEval);
    }
}

Define Search_CollectStats(string Horizon)(string Ply)(bool Quiescence)(string QSCode)(string FullCode) (warp=true)
{
    If Quiescence
    {
        Call Profile_CountByHorizon(QSCode)(Horizon)(Ply);
    }
    Else
    {
        Call Profile_CountByHorizon(FullCode)(Horizon)(Ply);
    }
}

Define Search_ComputeReduction(string Horizon)(string Ply)(bool Cutnode) (warp=true)
{
    If (ReductionBase[Ply] == Const.Null)
    {
        Call Search_ComputeReductionBase(Horizon)(Ply);
        If (Ret.Search_ComputeReductionBase.IsApplicable == 1)
        {
            List.ReplaceItem(ReductionBase, Ply, Ret.Search_ComputeReductionBase.Reduction);
        }
        Else
        {
            List.ReplaceItem(ReductionBase, Ply, Const.Null);
        }
    }
    Ret.Search_ComputeReduction.Reduction = 0;
    If (Not ((ReductionBase[Ply] == Const.Null)))
    {
        Ret.Search_ComputeReduction.Reduction = ((floor((ReductionBase[Ply] / 128)) + Cutnode) - (SingularQuietLMR[Ply] * (SingularState[Ply] == 1)));
        Call //("agreed gok engines twins diff: lmr clamp off in classic, on in nnue");
        If ((1 == 0) And (Ret.Search_ComputeReduction.Reduction > ((Horizon + PlyExtension[Ply]) - 2)))
        {
            Ret.Search_ComputeReduction.Reduction = ((Horizon + PlyExtension[Ply]) - 2);
        }
        If (Ret.Search_ComputeReduction.Reduction < 0)
        {
            Ret.Search_ComputeReduction.Reduction = 0;
        }
    }
}

Define Search_ComputeReductionBase(string Horizon)(string Ply) (warp=true)
{
    Search_ComputeReductionBase.DangerousPush = 0;
    Ret.Search_ComputeReductionBase.IsApplicable = 0;
    Ret.Search_ComputeReductionBase.Reduction = 0;
    If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
    {
        Search_ComputeReductionBase.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search_ComputeReductionBase.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search_ComputeReductionBase.PushRank < 4)))
        {
            Search_ComputeReductionBase.DangerousPush = 1;
        }
    }
    If (Search_ComputeReductionBase.DangerousPush == 1)
    {
        Stop(this script);
    }
    If ((((Horizon + PlyExtension[Ply]) > 2) And (CheckedState[Ply] == 0)) And ((TargetPieces[Ply] == 0) And (PromotionPieces[Ply] == 0)))
    {
        Search_ComputeReductionBase.MinMoveCount = (2 + (2 * (IsPvNode[Ply] == 1)));
        If (PickedLegalMovesCount[Ply] > Search_ComputeReductionBase.MinMoveCount)
        {
            Ret.Search_ComputeReductionBase.IsApplicable = 1;
            Ret.Search_ComputeReductionBase.Reduction = floor(((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + PlyExtension[Ply]))) / 2.25)) * 128));
            If (IsPvNode[Ply] == 1)
            {
                Ret.Search_ComputeReductionBase.Reduction += -128;
            }
            If ((Ply > 1) And (PickedLegalMovesCount[(Ply - 1)] > 7))
            {
                Ret.Search_ComputeReductionBase.Reduction += -128;
            }
            If (PutsInCheck[Ply] == 1)
            {
                Ret.Search_ComputeReductionBase.Reduction += -64;
            }
            Search_ComputeReductionBase.HistFrom = floor((AppliedMove[Ply] / 100));
            Search_ComputeReductionBase.HistTo = floor((AppliedMove[Ply] % 100));
            If (Search_ComputeReductionBase.HistFrom == 0)
            {
                If ((AppliedMove[Ply] == 65) Or (AppliedMove[Ply] == 66))
                {
                    Search_ComputeReductionBase.HistFrom = 5;
                }
                Else
                {
                    Search_ComputeReductionBase.HistFrom = 61;
                }
                If (AppliedMove[Ply] == 65)
                {
                    Search_ComputeReductionBase.HistTo = 8;
                }
                Else
                {
                    If (AppliedMove[Ply] == 66)
                    {
                        Search_ComputeReductionBase.HistTo = 1;
                    }
                    Else
                    {
                        If (AppliedMove[Ply] == 67)
                        {
                            Search_ComputeReductionBase.HistTo = 64;
                        }
                        Else
                        {
                            Search_ComputeReductionBase.HistTo = 57;
                        }
                    }
                }
            }
            Search_ComputeReductionBase.KPHash = Glob.Board.KPHash;
            If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
            {
                Search_ComputeReductionBase.KPHash = PreviousBoardHash2[Ply];
            }
            Call GetHistoryStatScore(SourcePieces[Ply])(Search_ComputeReductionBase.HistFrom)(Search_ComputeReductionBase.HistTo)(AppliedMove[Ply])(Ply)(Search_ComputeReductionBase.KPHash);
            Search_ComputeReductionBase.StatScore = (((((2 * Ret.GetHistoryStatScore.MainScore) + Ret.GetHistoryStatScore.Cont1Score) + Ret.GetHistoryStatScore.Cont2Score) + Ret.GetHistoryStatScore.Cont4Score) - Const.LmrStatScoreOffset);
            Ret.Search_ComputeReductionBase.Reduction += (0 - Operator.Round(((Search_ComputeReductionBase.StatScore / Const.LmrStatScoreDivisor) * 128)));
            Call GetImproving(Ply);
            If (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))
            {
                Ret.Search_ComputeReductionBase.Reduction += -128;
            }
        }
    }
}

Define Search_DetectCheckmatesAndDraws(string Horizon)(string Ply)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Ply > 1)
    {
        Call //("Virtual king captures on previous ply => depth-corrected checkmate evaluation");
        If (abs(TargetPieces[(Ply - 1)]) == GoK_OwnKing)
        {
            List.ReplaceItem(SearchEval, Ply, (0 - (100000 - (List.Length(BoardHistoryFiftyMoves) - 1))));
            List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
            Stop(this script);
        }
    }
    If (ChebyshevDistance[((Glob.Board.OppKingIdx * 100) + Glob.Board.OwnKingIdx)] < 2)
    {
        List.ReplaceItem(SearchEval, Ply, (100000 - (List.Length(BoardHistoryFiftyMoves) - 0)));
        List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
        Stop(this script);
    }
    If (Ply > 1)
    {
        Call //("Rule of 50 moves");
        Call //("Draw-by-repetition detection. This happens on every ply and could be costly, so we check previous plies for pawn moves and captures, and the history tables for board hash. Only then we count hash occurrences for same side.");
        If ((BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 99) And (CheckedState[Ply] == 0))
        {
            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
            Stop(this script);
        }
        If (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] > 3)
        {
            Search_DetectCheckmatesAndDraws.RepCount = 1;
            Search_DetectCheckmatesAndDraws.RepHistCount = 0;
            If List.ContainsItem(PreviousBoardHash, Glob.Board.CurrentHash)
            {
                Search_DetectCheckmatesAndDraws.SqIdx = (Ply - 2);
                Repeat Until ((Search_DetectCheckmatesAndDraws.SqIdx < 2) Or (Search_DetectCheckmatesAndDraws.RepCount > 2))
                {
                    If ((AppliedMove[Search_DetectCheckmatesAndDraws.SqIdx] == 0) Or (AppliedMove[(Search_DetectCheckmatesAndDraws.SqIdx + 1)] == 0))
                    {
                        Search_DetectCheckmatesAndDraws.SqIdx = 0;
                    }
                    Else
                    {
                        If (((Glob.Board.CurrentHash == PreviousBoardHash[Search_DetectCheckmatesAndDraws.SqIdx]) And (CastlingState[Ply] == CastlingState[(Search_DetectCheckmatesAndDraws.SqIdx - 1)])) And (EnPassantTarget[Ply] == EnPassantTarget[(Search_DetectCheckmatesAndDraws.SqIdx - 1)]))
                        {
                            Search_DetectCheckmatesAndDraws.RepCount += 1;
                        }
                    }
                    Search_DetectCheckmatesAndDraws.SqIdx += -2;
                }
            }
            If (Glob.Search.IsInNullMove == 0)
            {
                If List.ContainsItem(BoardHistoryHash, Glob.Board.CurrentHash)
                {
                    Search_DetectCheckmatesAndDraws.SqIdx = ((List.Length(BoardHistoryHash) - 1) + PlyIsOwn[Ply]);
                    Repeat Until ((Search_DetectCheckmatesAndDraws.SqIdx < 1) Or (Search_DetectCheckmatesAndDraws.RepHistCount > 2))
                    {
                        If ((Glob.Board.CurrentHash == BoardHistoryHash[Search_DetectCheckmatesAndDraws.SqIdx]) And (CastlingState[Ply] == BoardHistoryMetaState[Search_DetectCheckmatesAndDraws.SqIdx]))
                        {
                            Search_DetectCheckmatesAndDraws.RepHistCount += 1;
                        }
                        Search_DetectCheckmatesAndDraws.SqIdx += -2;
                    }
                }
            }
            If ((Search_DetectCheckmatesAndDraws.RepCount > 1) Or (Search_DetectCheckmatesAndDraws.RepHistCount > 1))
            {
                List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                List.ReplaceItem(ScoreTypes, Ply, Const.TTType.Exact);
                Stop(this script);
            }
        }
    }
    If (Ply > 1)
    {
        Call //("Draw-by-stalemate detection. This is expensive, and is only applied at low search depth or during late endgame stage (no minor pieces left)");
        If (Not (Quiescence))
        {
            If (Not ((CheckedState[Ply] == 1)))
            {
                If (PlyIsOwn[Ply] == 1)
                {
                    Search_DetectCheckmatesAndDraws.QueenCount = Glob.Board.OwnQueenCount;
                    Search_DetectCheckmatesAndDraws.MinorMajorCount = Glob.Board.OwnNonQueenMajorMinorCount;
                }
                Else
                {
                    Search_DetectCheckmatesAndDraws.QueenCount = Glob.Board.OppQueenCount;
                    Search_DetectCheckmatesAndDraws.MinorMajorCount = Glob.Board.OppNonQueenMajorMinorCount;
                }
                If ((Search_DetectCheckmatesAndDraws.QueenCount == 0) And (Search_DetectCheckmatesAndDraws.MinorMajorCount < 2))
                {
                    If (1 == 0)
                    {
                        Call IsDrawByStalemate((Ply + 2));
                        If (Ret.IsDrawByStalemate.IsDraw == 1)
                        {
                            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                            Stop(this script);
                        }
                    }
                }
            }
        }
        Call //("Fast draw-by-material verification");
        If (((Glob.Board.OwnQueenCount == 0) And (Glob.Board.OppQueenCount == 0)) And ((Glob.Board.OwnPawnCount == 0) And (Glob.Board.OppPawnCount == 0)))
        {
            If (((Glob.Board.OwnRookCount == 0) And (Glob.Board.OwnNonQueenMajorMinorCount < 2)) And ((Glob.Board.OppRookCount == 0) And (Glob.Board.OppNonQueenMajorMinorCount < 2)))
            {
                List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                Stop(this script);
            }
        }
        Call //("Special K-KP endgame draw detection, according to pawn and king position. Finds draws otherwise not visible within search horizon");
        If ((Ply > 1) And (Quiescence[(Ply - 1)] == 0))
        {
            If (((Glob.Board.OppQueenCount + Glob.Board.OppNonQueenMajorMinorCount) == 0) And ((Glob.Board.OwnQueenCount + Glob.Board.OwnNonQueenMajorMinorCount) == 0))
            {
                If ((Glob.Board.OwnPawnCount + Glob.Board.OppPawnCount) == 1)
                {
                    Search_DetectCheckmatesAndDraws.SqIdx = 1;
                    Repeat (64)
                    {
                        Search_DetectCheckmatesAndDraws.Piece = Board[(Search_DetectCheckmatesAndDraws.SqIdx + 0)];
                        If ((Search_DetectCheckmatesAndDraws.Piece == GoK_OppPawn) And (PlyIsOwn[Ply] == 0))
                        {
                            If ((IdxToFile[Search_DetectCheckmatesAndDraws.SqIdx] == 1) Or (IdxToFile[Search_DetectCheckmatesAndDraws.SqIdx] == 8))
                            {
                                If ((IdxToFile[Search_DetectCheckmatesAndDraws.SqIdx] == IdxToFile[Glob.Board.OwnKingIdx]) And (IdxToRank[Glob.Board.OwnKingIdx] < IdxToRank[Search_DetectCheckmatesAndDraws.SqIdx]))
                                {
                                    List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                                    Stop(this script);
                                }
                            }
                            Else
                            {
                                If (((Search_DetectCheckmatesAndDraws.SqIdx - 8) == Glob.Board.OwnKingIdx) Or ((Search_DetectCheckmatesAndDraws.SqIdx - 16) == Glob.Board.OwnKingIdx))
                                {
                                    If (Not ((((Search_DetectCheckmatesAndDraws.SqIdx - 1) == Glob.Board.OppKingIdx) Or ((Search_DetectCheckmatesAndDraws.SqIdx + 1) == Glob.Board.OppKingIdx))))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                                        Stop(this script);
                                    }
                                }
                                If ((Search_DetectCheckmatesAndDraws.SqIdx - 24) == Glob.Board.OwnKingIdx)
                                {
                                    If ((IdxToRank[Search_DetectCheckmatesAndDraws.SqIdx] > 4) And ((Search_DetectCheckmatesAndDraws.SqIdx - 8) == Glob.Board.OppKingIdx))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                                        Stop(this script);
                                    }
                                }
                            }
                        }
                        Else
                        {
                            If ((Search_DetectCheckmatesAndDraws.Piece == GoK_OwnPawn) And (PlyIsOwn[Ply] == 1))
                            {
                                If ((IdxToFile[Search_DetectCheckmatesAndDraws.SqIdx] == 1) Or (IdxToFile[Search_DetectCheckmatesAndDraws.SqIdx] == 8))
                                {
                                    If ((IdxToFile[Search_DetectCheckmatesAndDraws.SqIdx] == IdxToFile[Glob.Board.OppKingIdx]) And (IdxToRank[Glob.Board.OppKingIdx] > IdxToRank[Search_DetectCheckmatesAndDraws.SqIdx]))
                                    {
                                        List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                                        Stop(this script);
                                    }
                                }
                                Else
                                {
                                    If (((Search_DetectCheckmatesAndDraws.SqIdx + 8) == Glob.Board.OppKingIdx) Or ((Search_DetectCheckmatesAndDraws.SqIdx + 16) == Glob.Board.OppKingIdx))
                                    {
                                        If (Not ((((Search_DetectCheckmatesAndDraws.SqIdx - 1) == Glob.Board.OwnKingIdx) Or ((Search_DetectCheckmatesAndDraws.SqIdx + 1) == Glob.Board.OwnKingIdx))))
                                        {
                                            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                                            Stop(this script);
                                        }
                                    }
                                    If ((Search_DetectCheckmatesAndDraws.SqIdx + 24) == Glob.Board.OppKingIdx)
                                    {
                                        If ((IdxToRank[Search_DetectCheckmatesAndDraws.SqIdx] < 5) And ((Search_DetectCheckmatesAndDraws.SqIdx + 8) == Glob.Board.OwnKingIdx))
                                        {
                                            List.ReplaceItem(SearchEval, Ply, ((2 * ((Glob.Stats.NodeCount + Glob.Stats.NodeCountQuiescence) % 2)) - 1));
                                            Stop(this script);
                                        }
                                    }
                                }
                            }
                        }
                        Search_DetectCheckmatesAndDraws.SqIdx += 1;
                    }
                }
            }
        }
    }
}

Define Search_DetectExtension(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence)(string ExcludedMove) (warp=true)
{
    If (Not (Quiescence))
    {
        If ((SingularState[Ply] == 1) And (AppliedMove[Ply] == SingularMove[Ply]))
        {
            List.ReplaceItem(PlyExtension, Ply, SingularExtension[Ply]);
            Stop(this script);
        }
        If (PlyExtension[Ply] == 0)
        {
            Call //("agreed gok engines twins diff: classic check extension gate > 35.5, nnue > -1");
            If (PutsInCheck[Ply] == 1)
            {
                List.ReplaceItem(PlyExtension, Ply, 1);
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.Ext)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_FutilityPruning(string Horizon)(string Ply)(bool Quiescence) (warp=true)
{
    Search_FutilityPruning.DangerousPush = 0;
    Ret.Search_FutilityPruning.IsFutile = 0;
    If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
    {
        Search_FutilityPruning.PushRank = IdxToRank[floor((AppliedMove[Ply] % 100))];
        If (((SourcePieces[Ply] > 0) And (Search_FutilityPruning.PushRank > 5)) Or ((SourcePieces[Ply] < 0) And (Search_FutilityPruning.PushRank < 4)))
        {
            Search_FutilityPruning.DangerousPush = 1;
        }
    }
    If ((Search_FutilityPruning.DangerousPush == 1) And (Not (Quiescence)))
    {
        Stop(this script);
    }
    If (((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0)) And (PromotionPieces[Ply] == 0))
    {
        Call //("LMP");
        Search_FutilityPruning.CanPrune = 0;
        If (PlyIsOwn[Ply] == 1)
        {
            Search_FutilityPruning.PieceCount = (Glob.Board.OwnQueenCount + Glob.Board.OwnNonQueenMajorMinorCount);
        }
        Else
        {
            Search_FutilityPruning.PieceCount = (Glob.Board.OppQueenCount + Glob.Board.OppNonQueenMajorMinorCount);
        }
        If (Not (Quiescence))
        {
            If (Not ((SearchEval[Ply] == Const.Null)))
            {
                If (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval))
                {
                    If (Search_FutilityPruning.PieceCount > 0)
                    {
                        Search_FutilityPruning.CanPrune = 1;
                    }
                }
            }
        }
        If (Search_FutilityPruning.CanPrune == 1)
        {
            If (((Not (Quiescence)) And (IsPvNode[Ply] == 0)) And (TargetPieces[Ply] == 0))
            {
                Call GetImproving(Ply);
                If (PickedLegalMovesCountQuiet[Ply] > (3 + ((Horizon * Horizon) / (2 - (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))))))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                    Stop(this script);
                }
            }
        }
        Search_FutilityPruning.Eval = Const.Null;
        Search_FutilityPruning.SEEGain = Const.Null;
        Search_FutilityPruning.FutilityMargin = Const.Null;
        If Quiescence
        {
            If ((Not ((TargetPieces[Ply] == 0))) And (Search_FutilityPruning.PieceCount > 0))
            {
                Search_FutilityPruning.FutilityMargin = 175;
            }
        }
        Else
        {
            If (Search_FutilityPruning.CanPrune == 1)
            {
                If ((Ply > 1) And (Horizon < 6))
                {
                    If (((TargetPieces[Ply] == 0) And (PickedLegalMovesCount[Ply] > 1)) And (IsPvNode[Ply] == 0))
                    {
                        If (Not ((floor((AppliedMove[Ply] / 100)) == 0)))
                        {
                        }
                        Else
                        {
                        }
                        Search_FutilityPruning.Reduction = 0;
                        If (((Horizon + PlyExtension[Ply]) > 2) And (PickedLegalMovesCount[Ply] > 2))
                        {
                            Search_FutilityPruning.Reduction = floor((1.5 + ((ln(PickedLegalMovesCount[Ply]) * ln((Horizon + PlyExtension[Ply]))) / 2.25)));
                            Call GetImproving(Ply);
                            If (Not (((Not ((Ret.GetImproving.IsImproving == Const.Null))) And (Ret.GetImproving.IsImproving == 0))))
                            {
                                Search_FutilityPruning.Reduction += -1;
                            }
                        }
                        If (Search_FutilityPruning.Reduction > (Horizon - 1))
                        {
                            Search_FutilityPruning.Reduction = (Horizon - 1);
                        }
                        Search_FutilityPruning.FutilityMargin = (103 + ((Horizon - Search_FutilityPruning.Reduction) * 127));
                        If (Not ((floor((AppliedMove[Ply] / 100)) == 0)))
                        {
                            Search_FutilityPruning.KPHash = Glob.Board.KPHash;
                            If (abs(SourcePieces[Ply]) == GoK_OwnPawn)
                            {
                                Search_FutilityPruning.KPHash = PreviousBoardHash2[Ply];
                            }
                            Call GetHistoryStatScore(SourcePieces[Ply])(floor((AppliedMove[Ply] / 100)))(floor((AppliedMove[Ply] % 100)))(AppliedMove[Ply])(Ply)(Search_FutilityPruning.KPHash);
                            Search_FutilityPruning.FutilityMargin += floor((Ret.GetHistoryStatScore.Score / 120));
                        }
                    }
                }
            }
        }
        If (Not ((Search_FutilityPruning.FutilityMargin == Const.Null)))
        {
            If (Not ((StaticEval[Ply] == Const.Null)))
            {
                Search_FutilityPruning.StaticEval = StaticEval[Ply];
                Search_FutilityPruning.Eval = (((Search_FutilityPruning.StaticEval + 0) - (TargetPieces[Ply] * PlySign[Ply])) + Search_FutilityPruning.FutilityMargin);
                If (Not ((Search_FutilityPruning.Eval > Alphas[Ply])))
                {
                    Ret.Search_FutilityPruning.IsFutile = 1;
                }
                Else
                {
                    If Quiescence
                    {
                        Search_FutilityPruning.Eval = (Search_FutilityPruning.StaticEval + Search_FutilityPruning.FutilityMargin);
                        If ((Not ((Search_FutilityPruning.Eval > Alphas[Ply]))) And (Not (((abs(TargetPieces[Ply]) > abs(SourcePieces[Ply])) And (PromotionPieces[Ply] == 0)))))
                        {
                            Call SEE(Ply)((Glob.Config.IsScratch3 == 0));
                            Search_FutilityPruning.SEEGain = Ret.SEE.Gain;
                            If (Not ((Search_FutilityPruning.SEEGain > 0)))
                            {
                                Ret.Search_FutilityPruning.IsFutile = 1;
                            }
                        }
                    }
                }
                If (Ret.Search_FutilityPruning.IsFutile == 1)
                {
                    If Quiescence
                    {
                        If (Search_FutilityPruning.Eval > SearchEval[Ply])
                        {
                            List.ReplaceItem(SearchEval, Ply, Search_FutilityPruning.Eval);
                        }
                    }
                }
            }
        }
        If (1 == 0)
        {
            If (Ret.Search_FutilityPruning.IsFutile == 0)
            {
                If ((Not (Quiescence)) And ((Ply > 1) And (Horizon < 6)))
                {
                    If ((CheckedState[Ply] == 0) And (PutsInCheck[Ply] == 0))
                    {
                        If (Search_FutilityPruning.SEEGain == Const.Null)
                        {
                            Call SEE(Ply)((Glob.Config.IsScratch3 == 0));
                            Search_FutilityPruning.SEEGain = Ret.SEE.Gain;
                        }
                        If (Search_FutilityPruning.SEEGain < (Horizon * -125))
                        {
                            Ret.Search_FutilityPruning.IsFutile = 1;
                        }
                    }
                }
            }
        }
        If (((((Quiescence And (Ret.Search_FutilityPruning.IsFutile == 0)) And (Not ((TargetPieces[Ply] == 0)))) And (abs(TargetPieces[Ply]) < abs(SourcePieces[Ply]))) And (Not (((CheckedState[Ply] == 0) And (((StaticEval[Ply] - abs(TargetPieces[Ply])) + 175) > Alphas[Ply]))))) And (SearchEval[Ply] > (0 - Const.AbsMinCheckmateEval)))
        {
            If (Glob.Profile.Mode > Const.ProfilerMode.Off)
            {
                Call Profile_CountByHorizon(Const.Profile.QSEECalls)(Horizon)(Ply);
            }
            If (Search_FutilityPruning.SEEGain == Const.Null)
            {
                Call SEE(Ply)((Glob.Config.IsScratch3 == 0));
                Search_FutilityPruning.SEEGain = Ret.SEE.Gain;
            }
            If (Search_FutilityPruning.SEEGain < 0)
            {
                Ret.Search_FutilityPruning.IsFutile = 1;
                If (Glob.Profile.Mode > Const.ProfilerMode.Off)
                {
                    Call Profile_CountByHorizon(Const.Profile.QSEEHits)(Horizon)(Ply);
                }
            }
        }
    }
}

Define Search_Init(string Horizon) (warp=true)
{
    Glob.Search.IsInNullMove = 0;
    If (List.Length(BoardHistoryFiftyMoves) == 0)
    {
        List.Add(BoardHistoryFiftyMoves, 0);
    }
    Glob.Search.IsTimeout = 0;
    If (Glob.Search.IsInitialDeepening == 1)
    {
        Ret.Search.PV = "";
        Call UI.FormatPV;
        List.DeleteAll(PVStable);
        List.DeleteAll(PVStablePrev);
        Call Profile_Reset;
        Glob.TT.CurrentAge = ((floor((Glob.TT.CurrentAge / 100)) + 1) * 100);
        Search_Init.KillerIdx = 1;
        Repeat (List.Length(KillerMoves))
        {
            List.ReplaceItem(KillerMoves, Search_Init.KillerIdx, Const.Null);
            Search_Init.KillerIdx += 1;
        }
    }
    Call SetInitialEP(1);
    List.DeleteItem(SearchPly1EvalMoves, all);
    Glob.TT.CurrentAge += 1;
    Call CalcBoardStats;
    Call CreateCurrentBoardHash;
}

Define Search_InitStack(string Ply)(bool Quiescence) (warp=true)
{
    If (Not (Quiescence))
    {
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 1), Const.Null);
        List.ReplaceItem(KillerMoves, (((Ply + 1) * 2) + 2), Const.Null);
    }
    Call //("Search function (minimax / alpha-beta pruning)");
    Call //("Required for early TT access and draw detection");
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, 1, ((((Glob.Board.HasOwnCastled * CastlingStatePow2[1]) + (Glob.Board.HasOwnKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasOwnRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasOwnRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasOppCastled * CastlingStatePow2[5]) + (Glob.Board.HasOppKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasOppRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasOppRookQSMoved * CastlingStatePow2[8])))));
        If (Not ((CastlingState[1] == Const.Null)))
        {
            If ((CastlingBit[((8 * CastlingState[1]) + 1)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 2)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 3)] == 1) And (CastlingBit[((8 * CastlingState[1]) + 4)] == 1))))
            {
                Call SetCastlingStateFlag(1)(1)(1);
                Call SetCastlingStateFlag(1)(2)(1);
                Call SetCastlingStateFlag(1)(3)(1);
                Call SetCastlingStateFlag(1)(4)(1);
            }
            If ((CastlingBit[((8 * CastlingState[1]) + 5)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 6)] == 1) Or ((CastlingBit[((8 * CastlingState[1]) + 7)] == 1) And (CastlingBit[((8 * CastlingState[1]) + 8)] == 1))))
            {
                Call SetCastlingStateFlag(1)(5)(1);
                Call SetCastlingStateFlag(1)(6)(1);
                Call SetCastlingStateFlag(1)(7)(1);
                Call SetCastlingStateFlag(1)(8)(1);
            }
        }
        Call SetInitialEP(1);
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
        List.ReplaceItem(EnPassantTarget, Ply, EnPassantTarget[(Ply - 1)]);
        List.ReplaceItem(CheckedState, Ply, PutsInCheck[(Ply - 1)]);
    }
    List.ReplaceItem(StaticEval, Ply, Const.Null);
    List.ReplaceItem(Improving, Ply, Const.Null);
    List.ReplaceItem(LMRState, Ply, 0);
    List.ReplaceItem(PlyExtension, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(DoubleExtensions, Ply, 0);
    }
    Else
    {
        List.ReplaceItem(DoubleExtensions, Ply, (DoubleExtensions[(Ply - 1)] + (PlyExtension[(Ply - 1)] == 2)));
    }
    List.ReplaceItem(PV, (((Ply - 1) * Const.MaxPlyStackFrames) + 1), 0);
    List.ReplaceItem(AlphasOld, Ply, Alphas[Ply]);
    If ((Betas[Ply] - Alphas[Ply]) > 1)
    {
        List.ReplaceItem(IsPvNode, Ply, 1);
        If ((Not (Quiescence)) And (Ply > Glob.Search.SelDepth))
        {
            Glob.Search.SelDepth = Ply;
        }
    }
    Else
    {
        List.ReplaceItem(IsPvNode, Ply, 0);
    }
    List.ReplaceItem(LMRState, Ply, 0);
    List.ReplaceItem(QuietsSearchedCount, Ply, 0);
    List.ReplaceItem(CapturesSearchedCount, Ply, 0);
    If Quiescence
    {
        List.ReplaceItem(Quiescence, Ply, 1);
    }
    Else
    {
        List.ReplaceItem(Quiescence, Ply, 0);
    }
    Call //("Initialize local variables or forward state from previous ply");
    If (Ply == 1)
    {
        Call CalcBoardAttackedByMove(2)((1 == 0));
        Call StoreAttackInfo(2)(1);
        List.ReplaceItem(BoardAttackedCalculated, 1, 1);
    }
    Else
    {
        List.ReplaceItem(BoardAttackedCalculated, Ply, 0);
        If (Ply == 2)
        {
            Call CalcBoardAttackedByMove(3)((1 == 0));
            Call StoreAttackInfo(3)(2);
            List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
        }
    }
}

Define Search_InternalIterative_Deepening(string Horizon)(string Ply)(bool Cutnode)(bool Quiescence) (warp=true)
{
    If ((IIDState[Ply] == 0) And (Not (Quiescence)))
    {
        If (Horizon > 5)
