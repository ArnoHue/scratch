Define EvaluatePawns(string Ply) (warp=true)
{
    Call //("Positional evaluation: king and pawn structure");
    Call EvaluatePawnsImpl(Ply);
    Ret.EvaluatePawns.Score = Ret.EvaluatePawnsImpl.Score;
}

Define EvaluatePawnsImpl(string Ply) (warp=true)
{
    Ret.EvaluatePawnsImpl.Score = 0;
    Call TaperedEval.Init;
    If (((Operator.LetterOf(CastlingState[(Ply + 1)], 1) == 0) And (Operator.LetterOf(CastlingState[(Ply + 1)], 2) == 0)) And ((Operator.LetterOf(CastlingState[(Ply + 1)], 3) == 0) Or (Operator.LetterOf(CastlingState[(Ply + 1)], 4) == 0)))
