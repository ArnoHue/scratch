        {
            TCA.F = (TCA.F + -1);
            TCA.R = (TCA.R + 1);
            If (((TCA.F > 0) And (TCA.F < 9)) And ((TCA.R > 0) And (TCA.R < 9)))
            {
                TCA.Sq = (TCA.F + ((TCA.R - 1) * 8));
                TCA.P = Board[TCA.Sq];
                If (Not ((TCA.P == 0)))
                {
                    TCA.Done = 1;
                    If (((TCA.P * CBABMC.Factor) > 0) And ((abs(TCA.P) == GoK_OwnQueen) Or (abs(TCA.P) == GoK_OwnBishop)))
                    {
                        CBABMC.IsChecked = 1;
                    }
                }
            }
            Else
            {
                TCA.Done = 1;
            }
        }
    }
    If (CBABMC.IsChecked == 0)
    {
        TCA.F = TCA.F0;
        TCA.R = TCA.R0;
        TCA.Done = 0;
        Repeat Until ((TCA.Done == 1) Or (CBABMC.IsChecked == 1))
        {
            TCA.F = (TCA.F + 1);
            TCA.R = (TCA.R + -1);
            If (((TCA.F > 0) And (TCA.F < 9)) And ((TCA.R > 0) And (TCA.R < 9)))
            {
                TCA.Sq = (TCA.F + ((TCA.R - 1) * 8));
                TCA.P = Board[TCA.Sq];
                If (Not ((TCA.P == 0)))
                {
                    TCA.Done = 1;
                    If (((TCA.P * CBABMC.Factor) > 0) And ((abs(TCA.P) == GoK_OwnQueen) Or (abs(TCA.P) == GoK_OwnBishop)))
                    {
                        CBABMC.IsChecked = 1;
                    }
                }
            }
            Else
            {
                TCA.Done = 1;
            }
        }
    }
    If (CBABMC.IsChecked == 0)
    {
        TCA.F = TCA.F0;
        TCA.R = TCA.R0;
        TCA.Done = 0;
        Repeat Until ((TCA.Done == 1) Or (CBABMC.IsChecked == 1))
        {
            TCA.F = (TCA.F + -1);
            TCA.R = (TCA.R + -1);
            If (((TCA.F > 0) And (TCA.F < 9)) And ((TCA.R > 0) And (TCA.R < 9)))
            {
                TCA.Sq = (TCA.F + ((TCA.R - 1) * 8));
                TCA.P = Board[TCA.Sq];
                If (Not ((TCA.P == 0)))
                {
                    TCA.Done = 1;
                    If (((TCA.P * CBABMC.Factor) > 0) And ((abs(TCA.P) == GoK_OwnQueen) Or (abs(TCA.P) == GoK_OwnBishop)))
                    {
                        CBABMC.IsChecked = 1;
                    }
                }
            }
            Else
            {
                TCA.Done = 1;
            }
        }
    }
    If (PlyIsOwn[CheckingPly] == 1)
    {
        Glob.IsOppSideChecked = CBABMC.IsChecked;
    }
    Else
    {
        Glob.IsOwnSideChecked = CBABMC.IsChecked;
    }
}

Define CalcBoardAttackedOnDemand(string Ply)(bool Quiescence)(bool ForceOnCheck)(string Horizon) (warp=true)
{
    If (BoardAttackedCalculated[Ply] == 0)
    {
        If ((ForceOnCheck And (CheckedState[Ply] == 1)) Or ((Not ((Ply > Horizon))) And (Not (Quiescence))))
        {
            Call CalcBoardAttackedByMove((Ply + 1));
            Call StoreAttackInfo((Ply + 1))(Ply);
            List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
        }
    }
}

Define CalcBoardStats (warp=true)
{
    Glob.OwnKingIdx = "";
    Glob.OppKingIdx = "";
    Glob.CurrentBoardHash = 0;
    Glob.KPHash = 0;
    CBS.SqIdx = 1;
    Repeat (8)
    {
        List.ReplaceItem(PawnCount, CBS.SqIdx, 0);
        List.ReplaceItem(PawnCount, (CBS.SqIdx + 8), 0);
        CBS.SqIdx += 1;
    }
    CBS.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CBS.SqIdx] == GoK_OppPawn)
        {
            List.ReplaceItem(PawnCount, (IdxToFile[CBS.SqIdx] + 8), (PawnCount[(IdxToFile[CBS.SqIdx] + 8)] + 1));
        }
        Else
        {
            If (Board[CBS.SqIdx] == GoK_OwnPawn)
            {
                List.ReplaceItem(PawnCount, IdxToFile[CBS.SqIdx], (PawnCount[IdxToFile[CBS.SqIdx]] + 1));
            }
            Else
            {
                If (Board[CBS.SqIdx] == GoK_OppKing)
                {
                    Glob.OppKingIdx = CBS.SqIdx;
                }
                Else
                {
                    If (Board[CBS.SqIdx] == GoK_OwnKing)
                    {
                        Glob.OwnKingIdx = CBS.SqIdx;
                    }
                }
            }
        }
        Call GetPiecePosHash(Board[CBS.SqIdx])(CBS.SqIdx);
        Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
        If ((abs(Board[CBS.SqIdx]) == GoK_OwnPawn) Or (abs(Board[CBS.SqIdx]) == GoK_OwnKing))
        {
            Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CBS.SqIdx += 1;
    }
    CBS.OwnNonQueenMajorMinorCount = 0;
    CBS.OwnQueenCount = 0;
    CBS.OwnPawnCount = 0;
    CBS.OwnRookCount = 0;
    CBS.OwnBishopCount = 0;
    CBS.OppQueenCount = 0;
    CBS.OppNonQueenMajorMinorCount = 0;
    CBS.OppPawnCount = 0;
    CBS.OppRookCount = 0;
    CBS.OppBishopCount = 0;
    CBS.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CBS.SqIdx] == GoK_OppQueen)
        {
            CBS.OppQueenCount += 1;
        }
        If (Board[CBS.SqIdx] == GoK_OwnQueen)
        {
            CBS.OwnQueenCount += 1;
        }
        If ((Board[CBS.SqIdx] == GoK_OppKnight) Or ((Board[CBS.SqIdx] == GoK_OppBishop) Or (Board[CBS.SqIdx] == GoK_OppRook)))
        {
            CBS.OppNonQueenMajorMinorCount += 1;
            If (Board[CBS.SqIdx] == GoK_OppRook)
            {
                CBS.OppRookCount += 1;
            }
            If (Board[CBS.SqIdx] == GoK_OppBishop)
            {
                CBS.OppBishopCount += 1;
            }
        }
        If ((Board[CBS.SqIdx] == GoK_OwnKnight) Or ((Board[CBS.SqIdx] == GoK_OwnBishop) Or (Board[CBS.SqIdx] == GoK_OwnRook)))
        {
            CBS.OwnNonQueenMajorMinorCount += 1;
            If (Board[CBS.SqIdx] == GoK_OwnRook)
            {
                CBS.OwnRookCount += 1;
            }
            If (Board[CBS.SqIdx] == GoK_OwnBishop)
            {
                CBS.OwnBishopCount += 1;
            }
        }
        If (Board[CBS.SqIdx] == GoK_OppPawn)
        {
            CBS.OppPawnCount += 1;
        }
        If (Board[CBS.SqIdx] == GoK_OwnPawn)
        {
            CBS.OwnPawnCount += 1;
        }
        CBS.SqIdx += 1;
    }
    If ((((CBS.OppQueenCount + CBS.OppNonQueenMajorMinorCount) + (CBS.OwnQueenCount + CBS.OwnNonQueenMajorMinorCount)) < 3) And ((CBS.OppQueenCount == 0) Or (CBS.OwnQueenCount == 0)))
    {
        Glob.IsLateEndgame = 1;
        Glob.IsEndgame = 1;
    }
    Else
    {
        Glob.IsLateEndgame = 0;
        Glob.IsEndgame = 0;
        Call GetAttackForce((1 == 0));
        If (Ret.GetAttackForce.Force < 13)
        {
            Glob.IsEndgame = 1;
        }
        Call GetAttackForce((1 == 1));
        If (Ret.GetAttackForce.Force < 13)
        {
            Glob.IsEndgame = 1;
        }
    }
    Glob.OppQueenCountLocal = CBS.OppQueenCount;
    Glob.OppNonQueenMajorMinorCountLocal = CBS.OppNonQueenMajorMinorCount;
    Glob.OwnQueenCountLocal = CBS.OwnQueenCount;
    Glob.OwnNonQueenMajorMinorCountLocal = CBS.OwnNonQueenMajorMinorCount;
    Glob.OppRookCountLocal = CBS.OppRookCount;
    Glob.OwnRookCountLocal = CBS.OwnRookCount;
    Glob.OppPawnCountLocal = CBS.OppPawnCount;
    Glob.OwnPawnCountLocal = CBS.OwnPawnCount;
    Glob.OppBishopCountLocal = CBS.OppBishopCount;
    Glob.OwnBishopCountLocal = CBS.OwnBishopCount;
    List.ReplaceItem(CastlingState, 1, Operator.Join(Operator.Join(Operator.Join(Glob.HasOwnCastled, Glob.HasOwnKingMoved), Operator.Join(Glob.HasOwnRookKSMoved, Glob.HasOwnRookQSMoved)), Operator.Join(Operator.Join(Glob.HasOppCastled, Glob.HasOppKingMoved), Operator.Join(Glob.HasOppRookKSMoved, Glob.HasOppRookQSMoved))));
    List.ReplaceItem(CastlingState, 2, CastlingState[1]);
}

Define CalculateMaterialImbalance(string Ply) (warp=true)
{
    Ret.CalculateMaterialImbalance.Score = 0;
    List.DeleteAll(TmpList1);
    List.DeleteAll(TmpList2);
    If (Glob.OwnBishopCountLocal == 2)
    {
        List.Add(TmpList1, 1);
    }
    Else
    {
        List.Add(TmpList1, 0);
    }
    List.Add(TmpList1, Glob.OwnPawnCountLocal);
    List.Add(TmpList1, (Glob.OwnNonQueenMajorMinorCountLocal - (Glob.OwnRookCountLocal + Glob.OwnBishopCountLocal)));
    List.Add(TmpList1, Glob.OwnBishopCountLocal);
    List.Add(TmpList1, Glob.OwnRookCountLocal);
    List.Add(TmpList1, Glob.OwnQueenCountLocal);
    If (Glob.OppBishopCountLocal == 2)
    {
        List.Add(TmpList2, 1);
    }
    Else
    {
        List.Add(TmpList2, 0);
    }
    List.Add(TmpList2, Glob.OppPawnCountLocal);
    List.Add(TmpList2, (Glob.OppNonQueenMajorMinorCountLocal - (Glob.OppRookCountLocal + Glob.OppBishopCountLocal)));
    List.Add(TmpList2, Glob.OppBishopCountLocal);
    List.Add(TmpList2, Glob.OppRookCountLocal);
    List.Add(TmpList2, Glob.OppQueenCountLocal);
    CMI.Idx = 1;
    Repeat (6)
    {
        CMI.ImbalanceSum = 0;
        If (((PlyIsOwn[Ply] == 1) And (TmpList1[CMI.Idx] > 0)) Or ((PlyIsOwn[Ply] == 0) And (TmpList2[CMI.Idx] > 0)))
        {
            CMI.OtherPieceTypeIdx = 1;
            Repeat Until (CMI.OtherPieceTypeIdx > CMI.Idx)
            {
                If (PlyIsOwn[Ply] == 1)
                {
                    CMI.ImbalanceSum += ((ImbalanceSameSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList1[CMI.OtherPieceTypeIdx]) + (ImbalanceOppSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList2[CMI.OtherPieceTypeIdx]));
                }
                Else
                {
                    CMI.ImbalanceSum += ((ImbalanceSameSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList2[CMI.OtherPieceTypeIdx]) + (ImbalanceOppSide[(((CMI.Idx - 1) * 6) + CMI.OtherPieceTypeIdx)] * TmpList1[CMI.OtherPieceTypeIdx]));
                }
                CMI.OtherPieceTypeIdx += 1;
            }
            If (PlyIsOwn[Ply] == 1)
            {
                Ret.CalculateMaterialImbalance.Score += (TmpList1[CMI.Idx] * CMI.ImbalanceSum);
            }
            Else
            {
                Ret.CalculateMaterialImbalance.Score += (TmpList2[CMI.Idx] * CMI.ImbalanceSum);
            }
        }
        CMI.Idx += 1;
    }
}

Define ClearBoardAttackedByMove(num Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 1)
    {
        CBABM.SqIdx = 1;
        Repeat (64)
        {
            List.ReplaceItem(BoardAttacked, CBABM.SqIdx, 0);
            List.ReplaceItem(BoardAttackedPiece, CBABM.SqIdx, 0);
            List.ReplaceItem(BoardAttackedTypeMask, CBABM.SqIdx, 0);
            CBABM.SqIdx += 1;
        }
        CBABM.SqIdx = 1;
        Repeat (384)
        {
            List.ReplaceItem(BoardAttackerType, CBABM.SqIdx, 0);
            List.ReplaceItem(BoardAttackerType2, CBABM.SqIdx, 0);
            CBABM.SqIdx += 1;
        }
        Glob.IsOppSideChecked = 0;
    }
    Else
    {
        CBABM.SqIdx = 1;
        Repeat (64)
        {
            List.ReplaceItem(BoardAttacked, (CBABM.SqIdx + 64), 0);
            List.ReplaceItem(BoardAttackedPiece, (CBABM.SqIdx + 64), 0);
            List.ReplaceItem(BoardAttackedTypeMask, (CBABM.SqIdx + 64), 0);
            CBABM.SqIdx += 1;
        }
        CBABM.SqIdx = 1;
        Repeat (384)
        {
            List.ReplaceItem(BoardAttackerType, (CBABM.SqIdx + 384), 0);
            List.ReplaceItem(BoardAttackerType2, (CBABM.SqIdx + 384), 0);
            CBABM.SqIdx += 1;
        }
        Glob.IsOwnSideChecked = 0;
    }
}

Define ClearMoveList(num Ply) (warp=true)
{
    List.ReplaceItem(MovesCount, Ply, 0);
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
    }
    Else
    {
        If (Ply == 2)
        {
            List.DeleteAll(Moves2);
        }
    }
}

Define ClearTT (warp=true)
{
    If (Glob.IsScratch3 == 1)
    {
        Call ClearTTImpl(65536);
    }
    Else
    {
        Call ClearTTImpl(524288);
    }
}

Define ClearTTImpl(string Size) (warp=true)
{
    List.DeleteItem(TTNodeEntry, all);
    Repeat (Size)
    {
        List.Add(TTNodeEntry, 0);
        List.Add(TTNodeEntry, 0);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
        List.Add(TTNodeEntry, Const.Null);
    }
}

Define Comment(string Comment) (warp=true)
{
}

Define CreateCurrentBoardHash (warp=true)
{
    Glob.CurrentBoardHash = 0;
    Glob.KPHash = 0;
    CCBH.SqIdx = 1;
    Repeat (64)
    {
        Call GetPiecePosHash(Board[CCBH.SqIdx])(CCBH.SqIdx);
        Glob.CurrentBoardHash = (Glob.CurrentBoardHash + Ret.GetPiecePosHash.Hash);
        If ((abs(Board[CCBH.SqIdx]) == GoK_OwnPawn) Or (abs(Board[CCBH.SqIdx]) == GoK_OwnKing))
        {
            Glob.KPHash = (Glob.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CCBH.SqIdx += 1;
    }
}

Define DrawBoardAndWait (warp=false)
{
    List.DeleteAll(GoK_Board);
    List.DeleteAll(GoK_VirtualBoard);
    DBW.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_Board, Board[DBW.SqIdx]);
        List.Add(GoK_VirtualBoard, VirtualBoard[DBW.SqIdx]);
        DBW.SqIdx += 1;
    }
    If (Glob.IsDCI == 0)
    {
        GoK_ProgressValue = 0;
        Event.BroadcastAndWait("drawboard");
        Event.BroadcastAndWait("progressvaluechanged");
        Event.BroadcastAndWait("evaluationvaluechanged");
    }
}

Define EnterExecution (warp=false)
{
    Glob.ExecutionPly += 1;
    If (Glob.ExecutionPly == 1)
    {
        Glob.IsExecutionRunning = 1;
        Event.BroadcastAndWait("calcmode");
    }
}

Define Evaluate(string Ply)(bool FullEval) (warp=true)
{
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_TimeByHorizon(0)(Ply)(-1);
    }
    Ret.Evaluate.Score = "";
    If ((Glob.OppKingIdx == "") And (Glob.OwnKingIdx == ""))
    {
        Ret.Evaluate.Score = 0;
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_TimeByHorizon(0)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.OppKingIdx == "")
    {
        Ret.Evaluate.Score = (100000 - (List.Length(BoardHistoryFiftyMoves) - 1));
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_TimeByHorizon(0)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.OwnKingIdx == "")
    {
        Ret.Evaluate.Score = (-100000 + (List.Length(BoardHistoryFiftyMoves) - 1));
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_TimeByHorizon(0)(Ply)(1);
        }
        Stop(this script);
    }
    If (Ply == 0)
    {
        Call EvaluateBoard;
        Eval.BoardScore = Ret.EvaluateBoard.Score;
        If (Glob.ProfilerMode == 2)
        {
            Call Profile_TimeByHorizon(0)(Ply)(1);
        }
        Stop(this script);
    }
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_MethodEnter(Ply);
    }
    If FullEval
    {
        If (Eval.DebugLog == 0)
        {
            If (Glob.ProfilerMode == 2)
            {
                Call Profile_CountByHorizon(Const.Profile.TTStaticProbe)(HorizonAtPly[Ply])(Ply);
            }
        }
        Eval.MgTotal = 0;
        Eval.EgTotal = 0;
        Eval.PassedCount = 0;
        Call EvaluateBoard;
        Eval.BoardScore = Ret.EvaluateBoard.Score;
        Call PrepareEvalPiecesData(Ply);
        Call EvaluatePawns(Ply);
        Eval.PawnsScore = Ret.EvaluatePawns.Score;
        If (Eval.DebugLog == 1)
        {
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
        Call EvaluateMajorsMinors(Ply);
        Eval.MajorsMinorsScore = Ret.EvaluateMajorsMinors.Score;
        If (Eval.DebugLog == 1)
        {
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
        Call EvaluateThreats(Ply);
        Eval.ThreatsScore = Ret.EvaluateThreats.Score;
        If (Eval.DebugLog == 1)
        {
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
        Ret.Evaluate.Score = (Eval.BoardScore + ((Eval.PawnsScore + Eval.MajorsMinorsScore) + Eval.ThreatsScore));
        Call Comment("Tempo");
        Ret.Evaluate.Score += (14 * PlySign[(Ply + 1)]);
        Call CalculateMaterialImbalance(1);
        Eval.OwnImbalance = Ret.CalculateMaterialImbalance.Score;
        Call CalculateMaterialImbalance(2);
        Eval.OppImbalance = Ret.CalculateMaterialImbalance.Score;
        Call TaperedEval.Init;
        Call TaperedEval.AddIdentical((Eval.OwnImbalance - Eval.OppImbalance))("Eval.Imbalance")(Ply)("")("");
        Call TaperedEval.GetSum;
        Eval.MgTotal += TaperedEval.Mg;
        Eval.EgTotal += TaperedEval.Eg;
        Ret.Evaluate.Score += Ret.TaperedEval.GetSum.Score;
        Eval.Winnable.KingOutflanking = (abs((IdxToFile[Glob.OwnKingIdx] - IdxToFile[Glob.OppKingIdx])) - abs((IdxToRank[Glob.OwnKingIdx] - IdxToRank[Glob.OppKingIdx])));
        Eval.Winnable.PawnsOnBothFlanks = ((((((((((PawnCount[1] + PawnCount[9]) + PawnCount[2]) + PawnCount[10]) + PawnCount[3]) + PawnCount[11]) + PawnCount[4]) + PawnCount[12]) > 0) And ((((((((PawnCount[5] + PawnCount[13]) + PawnCount[6]) + PawnCount[14]) + PawnCount[7]) + PawnCount[15]) + PawnCount[8]) + PawnCount[16]) > 0)) * 1);
        Eval.Winnable.Complexity = (((((((((9 * Eval.PassedCount) + (12 * (Glob.OwnPawnCountLocal + Glob.OppPawnCountLocal))) + (9 * Eval.Winnable.KingOutflanking)) + (21 * Eval.Winnable.PawnsOnBothFlanks)) + (24 * ((Glob.OwnKingIdx > 32) Or (Glob.OppKingIdx < 33)))) + (51 * (((Glob.OwnQueenCountLocal + Glob.OwnNonQueenMajorMinorCountLocal) + (Glob.OppQueenCountLocal + Glob.OppNonQueenMajorMinorCountLocal)) == 0))) - (43 * ((Eval.Winnable.KingOutflanking < 0) And (Eval.Winnable.PawnsOnBothFlanks == 0)))) - 110) / 2);
        Eval.Winnable.MgAdjust = (Eval.Winnable.Complexity + 25);
        If (Eval.Winnable.MgAdjust > 0)
        {
            Eval.Winnable.MgAdjust = 0;
        }
        If (Eval.Winnable.MgAdjust < (0 - abs(Eval.MgTotal)))
        {
            Eval.Winnable.MgAdjust = (0 - abs(Eval.MgTotal));
        }
        Eval.Winnable.MgAdjust = (Eval.Winnable.MgAdjust * ((Eval.MgTotal > 0) - (Eval.MgTotal < 0)));
        Eval.Winnable.EgAdjust = Eval.Winnable.Complexity;
        If (Eval.Winnable.EgAdjust < (0 - abs(Eval.EgTotal)))
        {
            Eval.Winnable.EgAdjust = (0 - abs(Eval.EgTotal));
        }
        Eval.Winnable.EgAdjust = (Eval.Winnable.EgAdjust * ((Eval.EgTotal > 0) - (Eval.EgTotal < 0)));
        Ret.Evaluate.Score += Operator.Round((((Eval.Winnable.MgAdjust * TaperedEval.Phase) + (Eval.Winnable.EgAdjust * (128 - TaperedEval.Phase))) / 128));
        If (Eval.DebugLog == 1)
        {
            Call Log("Eval.Winnable.Complexity = ")(Eval.Winnable.Complexity)(" MgAdjust = ")(Eval.Winnable.MgAdjust)(" EgAdjust = ")(Eval.Winnable.EgAdjust)("")("");
        }
        If (Eval.DebugLog == 1)
        {
            Call Log("Eval.MaterialCaptureList = ")(TargetPieces)("")("")("")("")("")("");
            Call Log("Eval.MaterialPromotionList = ")(PromotionPieces)("")("")("")("")("")("");
            Call Log("Eval.Pawns = ")(Eval.PawnsScore)("")("")("")("")("")("");
            Call Log("Eval.MajorsMinors = ")(Eval.MajorsMinorsScore)("")("")("")("")("")("");
            Call Log("Eval.Threats = ")(Eval.ThreatsScore)("")("")("")("")("")("");
            Call Log("Eval.Imbalance = ")(Operator.Round(((Eval.OwnImbalance - Eval.OppImbalance) / 1)))("")("")("")("")("")("");
            Call Log("Eval.Total (pre-DrawScale)= ")(Ret.Evaluate.Score)("")("")("")("")("")("");
        }
        If (1 == 1)
        {
            Call EvaluateDrawScaling(Ply)(Ret.Evaluate.Score);
            Ret.Evaluate.Score = Ret.EvaluateDrawScaling.Score;
        }
        Eval.OppositeBishops.ScaleFactor = 128;
        If ((Glob.OwnBishopCountLocal == 1) And (Glob.OppBishopCountLocal == 1))
        {
            Eval.OppositeBishops.OwnBishopIdx = 0;
            Eval.OppositeBishops.OppBishopIdx = 0;
            Eval.OppositeBishops.Idx = 1;
            Repeat (64)
            {
                If (Board[Eval.OppositeBishops.Idx] == GoK_OwnBishop)
                {
                    Eval.OppositeBishops.OwnBishopIdx = Eval.OppositeBishops.Idx;
                }
                If (Board[Eval.OppositeBishops.Idx] == GoK_OppBishop)
                {
                    Eval.OppositeBishops.OppBishopIdx = Eval.OppositeBishops.Idx;
                }
                Eval.OppositeBishops.Idx += 1;
            }
            If (Not ((((IdxToFile[Eval.OppositeBishops.OwnBishopIdx] + IdxToRank[Eval.OppositeBishops.OwnBishopIdx]) % 2) == ((IdxToFile[Eval.OppositeBishops.OppBishopIdx] + IdxToRank[Eval.OppositeBishops.OppBishopIdx]) % 2))))
            {
                Eval.OppositeBishops.StrongSide = ((Eval.EgTotal > 0) - (Eval.EgTotal < 0));
                If (Not ((Eval.OppositeBishops.StrongSide == 0)))
                {
                    If ((((Glob.OwnQueenCountLocal + Glob.OppQueenCountLocal) + (Glob.OwnRookCountLocal + Glob.OppRookCountLocal)) == 0) And ((Glob.OwnNonQueenMajorMinorCountLocal == 1) And (Glob.OppNonQueenMajorMinorCountLocal == 1)))
                    {
                        If (Eval.OppositeBishops.StrongSide == 1)
                        {
                            Eval.OppositeBishops.StrongPieceCount = Eval.DS.OwnPasserCount;
                        }
                        Else
                        {
                            Eval.OppositeBishops.StrongPieceCount = Eval.DS.OppPasserCount;
                        }
                        Eval.OppositeBishops.ScaleFactor = (36 + (8 * Eval.OppositeBishops.StrongPieceCount));
                    }
                    Else
                    {
                        If (Eval.OppositeBishops.StrongSide == 1)
                        {
                            Eval.OppositeBishops.StrongPieceCount = (1 + (Glob.OwnPawnCountLocal + (Glob.OwnQueenCountLocal + Glob.OwnNonQueenMajorMinorCountLocal)));
                        }
                        Else
                        {
                            Eval.OppositeBishops.StrongPieceCount = (1 + (Glob.OppPawnCountLocal + (Glob.OppQueenCountLocal + Glob.OppNonQueenMajorMinorCountLocal)));
                        }
                        Eval.OppositeBishops.ScaleFactor = (44 + (6 * Eval.OppositeBishops.StrongPieceCount));
                    }
                    If (Eval.Winnable.PawnsOnBothFlanks == 0)
                    {
                        Eval.OppositeBishops.ScaleFactor += -8;
                    }
                    If (Eval.OppositeBishops.ScaleFactor > 128)
                    {
                        Eval.OppositeBishops.ScaleFactor = 128;
                    }
                    Ret.Evaluate.Score += Operator.Round((((Eval.EgTotal * (128 - TaperedEval.Phase)) * (Eval.OppositeBishops.ScaleFactor - 128)) / 16384));
                    If (Eval.DebugLog == 1)
                    {
                        Call Log("Eval.OppositeBishops.ScaleFactor = ")(Eval.OppositeBishops.ScaleFactor)("")("")("")("")("")("");
                    }
                }
            }
        }
        If (Eval.DebugLog == 1)
        {
            Call Log("Eval.Total= ")(Ret.Evaluate.Score)("")("")("")("")("")("");
            Call Log("----------------------------------------")("")("")("")("")("")("")("");
        }
    }
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_MethodExit(Ply);
    }
    If (Glob.ProfilerMode == 2)
    {
        Call Profile_TimeByHorizon(0)(Ply)(1);
    }
}

Define EvaluateBoard (warp=true)
{
    Call TaperedEval.Init;
    Ret.EvaluateBoard.Score = 0;
    Eval.Board.SqIdx = 1;
    Repeat (64)
    {
        Eval.Board.CurrentPiece = (Board[Eval.Board.SqIdx] + 0);
        If (Not ((Eval.Board.CurrentPiece == 0)))
        {
            Ret.EvaluateBoard.Score += Eval.Board.CurrentPiece;
            Call TaperedEval.GetPiecePos(Eval.Board.CurrentPiece)(Eval.Board.SqIdx);
            Ret.EvaluateBoard.Score += Ret.TaperedEval.GetPiecePos.Score;
        }
        Eval.Board.SqIdx += 1;
    }
    Eval.MgTotal += Ret.EvaluateBoard.Score;
    Eval.EgTotal += Ret.EvaluateBoard.Score;
}

Define EvaluateDrawScaling(string Ply)(string Score) (warp=true)
{
    Ret.EvaluateDrawScaling.Score = Score;
    Eval.DS.NonPawnMat = ((Glob.OwnQueenCountLocal * 1000) + ((Glob.OwnRookCountLocal * 525) + (((Glob.OwnNonQueenMajorMinorCountLocal - Glob.OwnRookCountLocal) * 350) + ((Glob.OppQueenCountLocal * 1000) + ((Glob.OppRookCountLocal * 525) + ((Glob.OppNonQueenMajorMinorCountLocal - Glob.OppRookCountLocal) * 350))))));
    Eval.DS.TotalNonPawnPieces = ((Glob.OwnNonQueenMajorMinorCountLocal + Glob.OwnQueenCountLocal) + (Glob.OppNonQueenMajorMinorCountLocal + Glob.OppQueenCountLocal));
    If ((Eval.DS.NonPawnMat > 3450) And (Eval.DS.TotalNonPawnPieces > 6))
    {
        Stop(this script);
    }
    Eval.DS.PreDrawScaleEval = Ret.EvaluateDrawScaling.Score;
    Eval.DS.DrawDelta = 0;
    Eval.DS.CannotWinLoserPawns = 0;
    Eval.DS.WinDelta = 0;
    Eval.DS.OwnMinorCount = (Glob.OwnNonQueenMajorMinorCountLocal - Glob.OwnRookCountLocal);
    Eval.DS.OppMinorCount = (Glob.OppNonQueenMajorMinorCountLocal - Glob.OppRookCountLocal);
    Eval.DS.PawnDiff = abs((Glob.OwnPawnCountLocal - Glob.OppPawnCountLocal));
    Eval.DS.OwnPiecesNP = (Glob.OwnQueenCountLocal + (Glob.OwnRookCountLocal + Eval.DS.OwnMinorCount));
    Eval.DS.OppPiecesNP = (Glob.OppQueenCountLocal + (Glob.OppRookCountLocal + Eval.DS.OppMinorCount));
    Eval.DS.FiftyMoveCount = (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] + 0);
    Eval.DS.OwnPasserCount = 0;
    Eval.DS.OppPasserCount = 0;
    Eval.DS.OwnIsolatedCount = 0;
    Eval.DS.OppIsolatedCount = 0;
    Eval.DS.Side = 1;
    Repeat (2)
    {
        If (Eval.DS.Side == 1)
        {
            Eval.DS.FwdOff = Const.PawnAdvance.OwnFront;
            Eval.DS.AdjOff = Const.PawnAdvance.OppRear;
            Eval.DS.Dir = 1;
        }
        Else
        {
            Eval.DS.FwdOff = Const.PawnAdvance.OppFront;
            Eval.DS.AdjOff = Const.PawnAdvance.OwnRear;
            Eval.DS.Dir = -1;
        }
        Eval.DS.PasserCount = 0;
        Eval.DS.IsoCount = 0;
        Eval.DS.File = 1;
        Repeat (8)
        {
            Eval.DS.Fwd = (PawnAdvancePerFile[(Eval.DS.File + Eval.DS.FwdOff)] + 0);
            If (Not ((Eval.DS.Fwd == 0)))
            {
                Eval.DS.Blocked = 0;
                Eval.DS.AdjRank = (PawnAdvancePerFile[(Eval.DS.File + Eval.DS.AdjOff)] + 0);
                If ((Not ((Eval.DS.AdjRank == 0))) And (((Eval.DS.AdjRank - Eval.DS.Fwd) * Eval.DS.Dir) > 0))
                {
                    Eval.DS.Blocked = 1;
                }
                If (Eval.DS.File > 1)
                {
                    Eval.DS.AdjRank = (PawnAdvancePerFile[((Eval.DS.File - 1) + Eval.DS.AdjOff)] + 0);
                    If ((Not ((Eval.DS.AdjRank == 0))) And (((Eval.DS.AdjRank - Eval.DS.Fwd) * Eval.DS.Dir) > 0))
                    {
                        Eval.DS.Blocked = 1;
                    }
                }
                If (Eval.DS.File < 8)
                {
                    Eval.DS.AdjRank = (PawnAdvancePerFile[((Eval.DS.File + 1) + Eval.DS.AdjOff)] + 0);
                    If ((Not ((Eval.DS.AdjRank == 0))) And (((Eval.DS.AdjRank - Eval.DS.Fwd) * Eval.DS.Dir) > 0))
                    {
                        Eval.DS.Blocked = 1;
                    }
                }
                If (Eval.DS.Blocked == 0)
                {
                    Eval.DS.PasserCount += 1;
                }
                Eval.DS.LeftPawnCount = 0;
                Eval.DS.RightPawnCount = 0;
                If (Eval.DS.File > 1)
                {
                    If (Eval.DS.Side == 1)
                    {
                        Eval.DS.LeftPawnCount = (PawnCount[(Eval.DS.File - 1)] + 0);
                    }
                    Else
                    {
                        Eval.DS.LeftPawnCount = (PawnCount[((Eval.DS.File - 1) + 8)] + 0);
                    }
                }
                If (Eval.DS.File < 8)
                {
                    If (Eval.DS.Side == 1)
                    {
                        Eval.DS.RightPawnCount = (PawnCount[(Eval.DS.File + 1)] + 0);
                    }
                    Else
                    {
                        Eval.DS.RightPawnCount = (PawnCount[((Eval.DS.File + 1) + 8)] + 0);
                    }
                }
                If ((Eval.DS.LeftPawnCount == 0) And (Eval.DS.RightPawnCount == 0))
                {
                    Eval.DS.IsoCount += 1;
                }
            }
            Eval.DS.File += 1;
        }
        If (Eval.DS.Side == 1)
        {
            Eval.DS.OwnPasserCount = Eval.DS.PasserCount;
            Eval.DS.OwnIsolatedCount = Eval.DS.IsoCount;
        }
        Else
        {
            Eval.DS.OppPasserCount = Eval.DS.PasserCount;
            Eval.DS.OppIsolatedCount = Eval.DS.IsoCount;
        }
        Eval.DS.Side += 1;
    }
    If (((Eval.DS.OwnPiecesNP + Glob.OwnPawnCountLocal) == 0) And (Eval.DS.NonPawnMat > 450))
    {
        Stop(this script);
    }
    If (((Eval.DS.OppPiecesNP + Glob.OppPawnCountLocal) == 0) And (Eval.DS.NonPawnMat > 450))
    {
        Stop(this script);
    }
    If (Ret.EvaluateDrawScaling.Score == 0)
    {
        Stop(this script);
    }
    If (Ret.EvaluateDrawScaling.Score > 0)
    {
        Eval.DS.EvalSign = -1;
        Eval.DS.WinQueenCount = Glob.OwnQueenCountLocal;
        Eval.DS.WinRookCount = Glob.OwnRookCountLocal;
        Eval.DS.WinMinorCount = Eval.DS.OwnMinorCount;
        Eval.DS.WinPawnCount = Glob.OwnPawnCountLocal;
        Eval.DS.WinPasserCount = Eval.DS.OwnPasserCount;
        Eval.DS.WinIsolatedCount = Eval.DS.OwnIsolatedCount;
        Eval.DS.LosePasserCount = Eval.DS.OppPasserCount;
        Eval.DS.LoseIsolatedCount = Eval.DS.OppIsolatedCount;
        Eval.DS.LosePawnCount = Glob.OppPawnCountLocal;
        Eval.DS.WinBishopCount = Glob.OwnBishopCountLocal;
        Eval.DS.LoseQueenCount = Glob.OppQueenCountLocal;
        Eval.DS.LoseRookCount = Glob.OppRookCountLocal;
        Eval.DS.LoseMinorCount = Eval.DS.OppMinorCount;
    }
    Else
    {
        Eval.DS.EvalSign = 1;
        Eval.DS.WinQueenCount = Glob.OppQueenCountLocal;
        Eval.DS.WinRookCount = Glob.OppRookCountLocal;
        Eval.DS.WinMinorCount = Eval.DS.OppMinorCount;
        Eval.DS.WinPawnCount = Glob.OppPawnCountLocal;
        Eval.DS.WinPasserCount = Eval.DS.OppPasserCount;
        Eval.DS.WinIsolatedCount = Eval.DS.OppIsolatedCount;
        Eval.DS.LosePasserCount = Eval.DS.OwnPasserCount;
        Eval.DS.LoseIsolatedCount = Eval.DS.OwnIsolatedCount;
        Eval.DS.LosePawnCount = Glob.OwnPawnCountLocal;
        Eval.DS.WinBishopCount = Glob.OppBishopCountLocal;
        Eval.DS.LoseQueenCount = Glob.OwnQueenCountLocal;
        Eval.DS.LoseRookCount = Glob.OwnRookCountLocal;
        Eval.DS.LoseMinorCount = Eval.DS.OwnMinorCount;
    }
    If (((Eval.DS.WinQueenCount == 0) And (Eval.DS.WinRookCount == 0)) And (((Eval.DS.WinMinorCount < 2) Or (((Eval.DS.WinMinorCount == 2) And (Eval.DS.WinBishopCount == 0)) And (((Eval.DS.LoseQueenCount == 0) And (Eval.DS.LoseRookCount == 0)) And ((Eval.DS.LoseMinorCount == 0) And (Eval.DS.LosePawnCount == 0))))) And (Eval.DS.WinPawnCount == 0)))
    {
        Eval.DS.DrawDelta = (Eval.DS.EvalSign * 999);
        Eval.DS.CannotWinLoserPawns = Eval.DS.LosePawnCount;
    }
    If ((Eval.DS.DrawDelta == 0) And (Eval.DS.TotalNonPawnPieces > 0))
    {
        Eval.DS.OwnMat = ((Glob.OwnQueenCountLocal * 1000) + ((Glob.OwnRookCountLocal * 525) + (Eval.DS.OwnMinorCount * 350)));
        Eval.DS.OppMat = ((Glob.OppQueenCountLocal * 1000) + ((Glob.OppRookCountLocal * 525) + (Eval.DS.OppMinorCount * 350)));
        Eval.DS.MatDiff = ((Eval.DS.OwnMat - Eval.DS.OppMat) * (0 - Eval.DS.EvalSign));
        If ((Eval.DS.MatDiff > 50) And (Eval.DS.MatDiff < 525))
        {
            If (Eval.DS.WinPawnCount == 0)
            {
                Eval.DS.DrawDelta = (Eval.DS.EvalSign * 350);
            }
            Else
            {
                If (((Eval.DS.WinPasserCount == 0) And (Eval.DS.WinIsolatedCount == Eval.DS.WinPawnCount)) And (Eval.DS.LosePasserCount < 2))
                {
                    Eval.DS.DrawDelta = (Eval.DS.EvalSign * 50);
                }
                Else
                {
                    If (Not ((Eval.DS.WinPasserCount > Eval.DS.LosePasserCount)))
                    {
                        Eval.DS.DrawDelta = (Eval.DS.EvalSign * 30);
                    }
                }
            }
        }
    }
    If ((Eval.DS.DrawDelta == 0) And ((Glob.OwnQueenCountLocal + Glob.OppQueenCountLocal) == 0))
    {
        If (((Glob.OwnRookCountLocal > 0) And (Glob.OppRookCountLocal > 0)) And ((Eval.DS.OwnMinorCount + Eval.DS.OppMinorCount) == 0))
        {
            If (Eval.DS.PawnDiff < 2)
            {
                If ((Eval.DS.OwnIsolatedCount + Eval.DS.OppIsolatedCount) == 0)
                {
                    Eval.DS.DrawDelta = (Eval.DS.EvalSign * 100);
                }
                Else
                {
                    If ((Eval.DS.LoseIsolatedCount < 2) And (Eval.DS.WinPasserCount < 2))
                    {
                        Eval.DS.DrawDelta = (Eval.DS.EvalSign * 50);
                    }
                }
            }
        }
    }
    If ((Eval.DS.DrawDelta == 0) And ((Glob.OwnQueenCountLocal + Glob.OppQueenCountLocal) == 0))
    {
        If (((Glob.OwnRookCountLocal + Glob.OppRookCountLocal) == 0) And ((Glob.OwnPawnCountLocal + Glob.OppPawnCountLocal) < 7))
        {
            If ((Eval.DS.OwnMinorCount == 1) And (Eval.DS.OppMinorCount == 1))
            {
                If (Eval.DS.PawnDiff < 2)
                {
                    If ((Eval.DS.OwnPasserCount + Eval.DS.OppPasserCount) == 0)
                    {
                        Eval.DS.DrawDelta = (Eval.DS.EvalSign * 50);
                    }
                    Else
                    {
                        If (Eval.DS.WinPasserCount == 0)
                        {
                            Eval.DS.DrawDelta = (Eval.DS.EvalSign * 35);
                        }
                    }
                }
            }
        }
    }
    If ((Eval.DS.DrawDelta == 0) And ((Glob.OwnPawnCountLocal + Glob.OppPawnCountLocal) < 8))
    {
        If (Eval.DS.NonPawnMat < 3451)
        {
            If ((((Eval.DS.OwnPasserCount + Eval.DS.OppPasserCount) + (Eval.DS.OwnIsolatedCount + Eval.DS.OppIsolatedCount)) == 0) And (abs(Ret.EvaluateDrawScaling.Score) < 60))
            {
                Eval.DS.DrawDelta = (Eval.DS.EvalSign * 45);
            }
        }
    }
    If (Eval.DS.NonPawnMat == 0)
    {
        Eval.DS.WinDelta += ((0 - Eval.DS.EvalSign) * (85 * (Eval.DS.WinPawnCount - Eval.DS.LosePawnCount)));
        If ((Eval.DS.WinPasserCount > 0) And (Eval.DS.LosePasserCount == 0))
        {
            Eval.DS.WinDelta += ((0 - Eval.DS.EvalSign) * 35);
        }
        Eval.DS.WinDelta += ((0 - Eval.DS.EvalSign) * (25 * Eval.DS.LoseIsolatedCount));
    }
    If ((Eval.DS.NonPawnMat > 0) And ((Eval.DS.OwnMinorCount + Eval.DS.OppMinorCount) == 0))
    {
        If ((Eval.DS.WinPawnCount > Eval.DS.LosePawnCount) And (Eval.DS.WinPasserCount > (Eval.DS.LosePasserCount + 1)))
        {
            Eval.DS.WinDelta += ((0 - Eval.DS.EvalSign) * 85);
        }
    }
    If (Not ((Eval.DS.WinDelta == 0)))
    {
        Eval.DS.PreWinEval = Ret.EvaluateDrawScaling.Score;
        Ret.EvaluateDrawScaling.Score += Eval.DS.WinDelta;
        If (((Eval.DS.PreWinEval > 0) And (Ret.EvaluateDrawScaling.Score < 0)) Or ((Eval.DS.PreWinEval < 0) And (Ret.EvaluateDrawScaling.Score > 0)))
        {
            Ret.EvaluateDrawScaling.Score = 0;
        }
    }
    If (Not ((Eval.DS.DrawDelta == 0)))
    {
        Ret.EvaluateDrawScaling.Score += Eval.DS.DrawDelta;
        If (((Eval.DS.PreDrawScaleEval > 0) And (Ret.EvaluateDrawScaling.Score < 0)) Or ((Eval.DS.PreDrawScaleEval < 0) And (Ret.EvaluateDrawScaling.Score > 0)))
        {
            Ret.EvaluateDrawScaling.Score = 0;
        }
    }
    If (Eval.DS.CannotWinLoserPawns > 0)
    {
        Ret.EvaluateDrawScaling.Score += (Eval.DS.EvalSign * (85 * Eval.DS.CannotWinLoserPawns));
    }
    If (Eval.DebugLog == 1)
    {
        Call Log("Eval.DrawScale.NonPawnMat = ")(Eval.DS.NonPawnMat)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.50MR = ")(Eval.DS.FiftyMoveCount)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.PassersOwn = ")(Eval.DS.OwnPasserCount)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.PassersOpp = ")(Eval.DS.OppPasserCount)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.IsolatedOwn = ")(Eval.DS.OwnIsolatedCount)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.IsolatedOpp = ")(Eval.DS.OppIsolatedCount)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.WinDelta = ")(Eval.DS.WinDelta)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.DrawDelta = ")(Eval.DS.DrawDelta)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.PreScaleEval = ")(Eval.DS.PreDrawScaleEval)("")("")("")("")("")("");
        Call Log("Eval.DrawScale.PostScaleEval = ")(Ret.EvaluateDrawScaling.Score)("")("")("")("")("")("");
    }
}

Define EvaluateMajorsMinors(string Ply) (warp=true)
{
    Ret.EvaluateMajorsMinors.Score = 0;
    Call Comment("Tapered evaluation, interpolating between midgame and game");
    Call EvaluateMajorsMinorsImpl(Ply);
    Ret.EvaluateMajorsMinors.Score = Ret.EvaluateMajorsMinorsImpl.Score;
}

Define EvaluateMajorsMinorsImpl(string Ply) (warp=true)
{
    Ret.EvaluateMajorsMinorsImpl.Score = 0;
    Call TaperedEval.Init;
    If (1 == 0)
    {
        Call TaperedEval.Add(0)((65 * Glob.OwnNonQueenMajorMinorCountLocal))("")("")("")("");
        Call TaperedEval.Add(0)((-65 * Glob.OppNonQueenMajorMinorCountLocal))("")("")("")("");
        Call TaperedEval.Add(0)((105 * Glob.OwnQueenCountLocal))("")("")("")("");
        Call TaperedEval.Add(0)((-105 * Glob.OppQueenCountLocal))("")("")("")("");
    }
    EvalMM.EvalPieceIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_NonPawns))
    {
        EvalMM.PieceSqIdx = (EvalPiecesIdx_NonPawns[EvalMM.EvalPieceIdx] + 0);
        EvalMM.Piece = (Board[(EvalMM.PieceSqIdx + 0)] + 0);
        EvalMM.Factor = (((EvalMM.Piece > 0) * 2) - 1);
        EvalMM.Side = (2 - (EvalMM.Piece > 0));
        EvalMM.PieceAbs = abs(EvalMM.Piece);
        If (EvalMM.Piece > 0)
        {
            EvalMM.KingIdx = Glob.OwnKingIdx;
        }
        Else
        {
            EvalMM.KingIdx = Glob.OppKingIdx;
        }
        If (Glob.IsExtendedEvalLocal == 1)
        {
            EvalMM.MobilityIdx = ((PieceMobility[(EvalMM.PieceSqIdx + 0)] * 2) + 1);
            If (EvalMM.PieceAbs == GoK_OwnRook)
            {
                Call TaperedEval.Add((RookMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((RookMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
            }
            Else
            {
                If (EvalMM.PieceAbs == GoK_OwnBishop)
                {
                    Call TaperedEval.Add((BishopMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((BishopMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                }
                Else
                {
                    If (EvalMM.PieceAbs == GoK_OwnKnight)
                    {
                        Call TaperedEval.Add((KnightMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((KnightMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                    }
                    Else
                    {
                        If (EvalMM.PieceAbs == GoK_OwnQueen)
                        {
                            Call TaperedEval.Add((QueenMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((QueenMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                        }
                    }
                }
            }
        }
        If ((EvalMM.PieceAbs == GoK_OwnKnight) Or (EvalMM.PieceAbs == GoK_OwnBishop))
        {
            EvalMM.Rank = (IdxToRank[(EvalMM.PieceSqIdx + 0)] + 0);
            EvalMM.File = (IdxToFile[(EvalMM.PieceSqIdx + 0)] + 0);
            If (Glob.IsExtendedEvalLocal == 1)
            {
                EvalMM.OnOutpost = 0;
                If ((EvalMM.Rank > (2 + (EvalMM.Piece > 0))) And (EvalMM.Rank < (6 + (EvalMM.Piece > 0))))
                {
                    Call PopulateAttackInfo((EvalMM.PieceSqIdx + 0));
                    EvalMM.Attacked = Ret.PopulateAttackInfo.Attacked;
                    EvalMM.Defended = Ret.PopulateAttackInfo.Defended;
                    EvalMM.AttackerPieceAbs = Ret.PopulateAttackInfo.AttackerPieceAbs;
                    EvalMM.DefenderPieceAbs = Ret.PopulateAttackInfo.DefenderPieceAbs;
                    If ((EvalMM.Defended > 0) And (EvalMM.DefenderPieceAbs == GoK_OwnPawn))
                    {
                        If ((EvalMM.Attacked == 0) Or (EvalMM.AttackerPieceAbs > GoK_OwnPawn))
                        {
                            Call Comment("Outposts");
                            If (EvalMM.Side == 1)
                            {
                                EvalMM.TheirPawnOffset = Const.PawnAdvance.OppRear;
                            }
                            Else
                            {
                                EvalMM.TheirPawnOffset = Const.PawnAdvance.OwnRear;
                            }
                            EvalMM.TheirPawnRankLeft = 0;
                            If (EvalMM.File > 1)
                            {
                                EvalMM.TheirPawnRankLeft = (PawnAdvancePerFile[(EvalMM.TheirPawnOffset + (EvalMM.File - 1))] + 0);
                            }
                            EvalMM.TheirPawnRankRight = 0;
                            EvalMM.OnOutpost = 1;
                            If (EvalMM.File < 8)
                            {
                                EvalMM.TheirPawnRankRight = (PawnAdvancePerFile[(EvalMM.TheirPawnOffset + (EvalMM.File + 1))] + 0);
                            }
                            If (((EvalMM.TheirPawnRankLeft > 0) And (((EvalMM.TheirPawnRankLeft - EvalMM.Rank) * EvalMM.Factor) > 0)) Or ((EvalMM.TheirPawnRankRight > 0) And (((EvalMM.TheirPawnRankRight - EvalMM.Rank) * EvalMM.Factor) > 0)))
                            {
                                EvalMM.OutpostFactor = 1;
                            }
                            Else
                            {
                                EvalMM.OutpostFactor = 2;
                            }
                            If (EvalMM.PieceAbs == GoK_OwnKnight)
                            {
                                Call TaperedEval.Add((14 * (EvalMM.OutpostFactor * EvalMM.Factor)))((9 * (EvalMM.OutpostFactor * EvalMM.Factor)))("Eval.MajorsMinors.KnightOutpost")(EvalMM.PieceSqIdx)("")("");
                            }
                            Else
                            {
                                Call TaperedEval.Add((8 * (EvalMM.OutpostFactor * EvalMM.Factor)))((7 * (EvalMM.OutpostFactor * EvalMM.Factor)))("Eval.MajorsMinors.BishopOutpost")(EvalMM.PieceSqIdx)("")("");
                            }
                        }
                    }
                }
                If (EvalMM.PieceAbs == GoK_OwnKnight)
                {
                    EvalMM.ReachFound = 0;
                    EvalMM.ROi = 1;
                    Repeat (List.Length(EvalPiecesIdx_Pawns))
                    {
                        EvalMM.ROp = (EvalPiecesIdx_Pawns[EvalMM.ROi] + 0);
                        If (Board[EvalMM.ROp] == (GoK_OwnPawn * EvalMM.Factor))
                        {
                            EvalMM.ROd = (EvalMM.ROp + (7 * EvalMM.Factor));
                            If ((EvalMM.ROd > 0) And (EvalMM.ROd < 65))
                            {
                                If (abs((IdxToFile[EvalMM.ROd] - IdxToFile[EvalMM.ROp])) == 1)
                                {
                                    If (Board[EvalMM.ROd] == 0)
                                    {
                                        If ((IdxToRank[EvalMM.ROd] > (2 + (EvalMM.Piece > 0))) And (IdxToRank[EvalMM.ROd] < (6 + (EvalMM.Piece > 0))))
                                        {
                                            Call IsLegalGeom(PieceIdxLookup[EvalMM.PieceAbs])(EvalMM.PieceSqIdx)(EvalMM.ROd)((0 + (EvalMM.Piece < 0)));
                                            If (((EvalMM.Piece > 0) And (Ret.IsLegalGeom.IsLegal == 1)) Or ((EvalMM.Piece < 0) And (Ret.IsLegalGeom.IsLegal == 1)))
                                            {
                                                If (Not ((((EvalMM.Piece > 0) And ((BoardAttackedTypeMask[(EvalMM.ROd + 64)] % 10) > 0)) Or ((EvalMM.Piece < 0) And ((BoardAttackedTypeMask[EvalMM.ROd] % 10) > 0)))))
                                                {
                                                    EvalMM.ReachFound = 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            EvalMM.ROd = (EvalMM.ROp + (9 * EvalMM.Factor));
                            If ((EvalMM.ROd > 0) And (EvalMM.ROd < 65))
                            {
                                If (abs((IdxToFile[EvalMM.ROd] - IdxToFile[EvalMM.ROp])) == 1)
                                {
                                    If (Board[EvalMM.ROd] == 0)
                                    {
