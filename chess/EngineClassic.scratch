            EvaluatePawnStructure.Support = (((EvaluatePawnStructure.File > 1) And (Board[(EvaluatePawnStructure.SqIdx + 7)] == GoK_OppPawn)) + ((EvaluatePawnStructure.File < 8) And (Board[(EvaluatePawnStructure.SqIdx + 9)] == GoK_OppPawn)));
            EvaluatePawnStructure.Phalanx = (((EvaluatePawnStructure.File > 1) And (Board[(EvaluatePawnStructure.SqIdx + -1)] == GoK_OppPawn)) + ((EvaluatePawnStructure.File < 8) And (Board[(EvaluatePawnStructure.SqIdx + 1)] == GoK_OppPawn)));
            EvaluatePawnStructure.Lever = (((EvaluatePawnStructure.File > 1) And (Board[(EvaluatePawnStructure.SqIdx + -9)] == GoK_OwnPawn)) + ((EvaluatePawnStructure.File < 8) And (Board[(EvaluatePawnStructure.SqIdx + -7)] == GoK_OwnPawn)));
