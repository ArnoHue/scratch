                Call ApplyMove(2);
                Call CalcBoardAttackedByMove(1);
                If (Glob.IsOppSideChecked == 0)
                {
                    Ret.IsOppKingCheckMate.IsCheckMate = 0;
                }
                Call RevertMove(2);
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
    }
}

Define IsOwnKingCheckMate (warp=true)
{
    Ret.IsOwnKingCheckMate.IsCheckMate = 0;
