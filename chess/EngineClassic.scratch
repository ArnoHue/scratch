1132257603811443712065153070850340102,6346072251351127524402195843132155470613625512283528212844362736463604185345006500671936453606044333182633432618605303215945010357592139,634612285236072259380330513513215843283553452228623528384538111935443044604406205547021200670065576104254337203461570604494134136261122237521523";
        InitOpeningBook.Tok = "";
        InitOpeningBook.I = 1;
        Repeat (Variable.Length(InitOpeningBook.Str))
        {
            If (Operator.LetterOf(InitOpeningBook.Str, InitOpeningBook.I) == ",")
            {
                List.Add(OpeningMovesOwn, InitOpeningBook.Tok);
                InitOpeningBook.Tok = "";
            }
            Else
            {
                InitOpeningBook.Tok = Operator.Join(InitOpeningBook.Tok, Operator.LetterOf(InitOpeningBook.Str, InitOpeningBook.I));
            }
            InitOpeningBook.I += 1;
        }
        List.Add(OpeningMovesOwn, InitOpeningBook.Tok);
        Call //("Sicilian");
        Call //("French");
        Call //("Caro-Kann");
        Call //("Scandinavian");
        Call //("Queen's Gambit");
        Call //("Queen's Gambit: 2.c4 c6");
        Call //("Queen's Gambit: 2.Nf3 Nf6");
        Call //("Indian");
        Call //("Indian: 2.c4 e6");
        Call //("other 1.d4");
        Call //("English");
        Call //("Reti");
        Call //("other first moves");
    }
    List.DeleteItem(OpeningMoves, all);
    InitOpeningBook.OpeningMoveIdx = 1;
    Repeat (List.Length(OpeningMovesNeutral))
    {
        List.Add(OpeningMoves, OpeningMovesNeutral[InitOpeningBook.OpeningMoveIdx]);
        InitOpeningBook.OpeningMoveIdx += 1;
    }
    If (Glob.Game.IsPlayerBlack == 1)
    {
        InitOpeningBook.OpeningMoveIdx = 1;
        Repeat (List.Length(OpeningMovesOpp))
        {
            List.Add(OpeningMoves, OpeningMovesOpp[InitOpeningBook.OpeningMoveIdx]);
            InitOpeningBook.OpeningMoveIdx += 1;
        }
    }
    Else
    {
        InitOpeningBook.OpeningMoveIdx = 1;
        Repeat (List.Length(OpeningMovesOwn))
        {
            List.Add(OpeningMoves, OpeningMovesOwn[InitOpeningBook.OpeningMoveIdx]);
            InitOpeningBook.OpeningMoveIdx += 1;
        }
    }
    If (Glob.Game.IsPlayerBlack == 1)
    {
        InitOpeningBook.OpeningMoveIdx = 1;
        Repeat (List.Length(OpeningMoves))
        {
            InitOpeningBook.Line = OpeningMoves[InitOpeningBook.OpeningMoveIdx];
            InitOpeningBook.LineMoves = "";
            InitOpeningBook.CharIdx = 1;
            Repeat ((Variable.Length(InitOpeningBook.Line) / 4))
            {
                InitOpeningBook.MoveStr = Operator.Join(Operator.Join(Operator.LetterOf(InitOpeningBook.Line, InitOpeningBook.CharIdx), Operator.LetterOf(InitOpeningBook.Line, (InitOpeningBook.CharIdx + 1))), Operator.Join(Operator.LetterOf(InitOpeningBook.Line, (InitOpeningBook.CharIdx + 2)), Operator.LetterOf(InitOpeningBook.Line, (InitOpeningBook.CharIdx + 3))));
                Call GetPhysicalMove(InitOpeningBook.MoveStr);
                InitOpeningBook.LineMoves = Operator.Join(InitOpeningBook.LineMoves, MoveToZeroPadStr[(floor(Ret.GetPhysicalMove.Move) + 1)]);
                InitOpeningBook.CharIdx += 4;
            }
            If ((Operator.Join(Operator.LetterOf(InitOpeningBook.LineMoves, 1), Operator.LetterOf(InitOpeningBook.LineMoves, 2)) == 9) Or (Operator.Join(Operator.LetterOf(InitOpeningBook.LineMoves, 1), Operator.LetterOf(InitOpeningBook.LineMoves, 2)) == 16))
            {
                List.ReplaceItem(OpeningMoves, InitOpeningBook.OpeningMoveIdx, "");
            }
            Else
            {
                List.ReplaceItem(OpeningMoves, InitOpeningBook.OpeningMoveIdx, InitOpeningBook.LineMoves);
            }
            InitOpeningBook.OpeningMoveIdx += 1;
        }
    }
}

