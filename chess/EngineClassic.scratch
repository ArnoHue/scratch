    {
        If (((EvalEG.KQKP.PawnFile == 1) Or (EvalEG.KQKP.PawnFile == 3)) Or ((EvalEG.KQKP.PawnFile == 6) Or (EvalEG.KQKP.PawnFile == 8)))
