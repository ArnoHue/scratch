Define EvaluateEndgame.KRKP(string Ply)(string StrongSide) (warp=true)
{
    Call EvaluateEndgame.Locate(StrongSide);
    Call EvaluateEndgame.StrongToMove(Ply)(StrongSide);
    EvalEG.KRKP.IsStrongToMove = Ret.EvaluateEndgame.StrongToMove.IsStrongToMove;
    EvalEG.KRKP.StrongKingIdx = Ret.EvaluateEndgame.Locate.StrongKingIdx;
    EvalEG.KRKP.WeakKingIdx = Ret.EvaluateEndgame.Locate.WeakKingIdx;
    EvalEG.KRKP.StrongRookIdx = Ret.EvaluateEndgame.Locate.StrongRookIdx;
    EvalEG.KRKP.WeakPawnIdx = Ret.EvaluateEndgame.Locate.WeakPawnIdx;
    EvalEG.KRKP.RelativeRankBase = Ret.EvaluateEndgame.Locate.RelativeRankBase;
    EvalEG.KRKP.RelativeRankSign = Ret.EvaluateEndgame.Locate.RelativeRankSign;
    EvalEG.KRKP.StrongKingRelativeRank = (EvalEG.KRKP.RelativeRankBase + (EvalEG.KRKP.RelativeRankSign * IdxToRank[EvalEG.KRKP.StrongKingIdx]));
    EvalEG.KRKP.WeakKingRelativeRank = (EvalEG.KRKP.RelativeRankBase + (EvalEG.KRKP.RelativeRankSign * IdxToRank[EvalEG.KRKP.WeakKingIdx]));
    EvalEG.KRKP.WeakPawnRelativeRank = (EvalEG.KRKP.RelativeRankBase + (EvalEG.KRKP.RelativeRankSign * IdxToRank[EvalEG.KRKP.WeakPawnIdx]));
    EvalEG.KRKP.StrongKingPawnDistance = ChebyshevDistance[((EvalEG.KRKP.StrongKingIdx * 100) + EvalEG.KRKP.WeakPawnIdx)];
    EvalEG.KRKP.WeakKingPawnDistance = ChebyshevDistance[((EvalEG.KRKP.WeakKingIdx * 100) + EvalEG.KRKP.WeakPawnIdx)];
    EvalEG.KRKP.WeakKingRookDistance = ChebyshevDistance[((EvalEG.KRKP.WeakKingIdx * 100) + EvalEG.KRKP.StrongRookIdx)];
    EvalEG.KRKP.IsStrongKingInFrontOfPawn = 0;
    If ((IdxToFile[EvalEG.KRKP.WeakPawnIdx] == IdxToFile[EvalEG.KRKP.StrongKingIdx]) And (EvalEG.KRKP.WeakPawnRelativeRank > EvalEG.KRKP.StrongKingRelativeRank))
    {
        EvalEG.KRKP.IsStrongKingInFrontOfPawn = 1;
    }
    EvalEG.KRKP.IsWeakKingTooFar = 0;
    If ((Not (((EvalEG.KRKP.WeakKingPawnDistance + EvalEG.KRKP.IsStrongToMove) < 4))) And (Not ((EvalEG.KRKP.WeakKingRookDistance < 3))))
    {
        EvalEG.KRKP.IsWeakKingTooFar = 1;
    }
    EvalEG.KRKP.IsPawnSupportedFarAdvanced = 0;
    If ((EvalEG.KRKP.WeakKingRelativeRank < 3) And (EvalEG.KRKP.WeakKingPawnDistance == 1))
    {
        If ((EvalEG.KRKP.StrongKingRelativeRank > 2) And ((EvalEG.KRKP.StrongKingPawnDistance - EvalEG.KRKP.IsStrongToMove) > 2))
        {
            EvalEG.KRKP.IsPawnSupportedFarAdvanced = 1;
        }
    }
    If ((EvalEG.KRKP.IsStrongKingInFrontOfPawn == 1) Or (EvalEG.KRKP.IsWeakKingTooFar == 1))
    {
        Ret.EvaluateEndgame.KRKP.Score = (1380 - EvalEG.KRKP.StrongKingPawnDistance);
    }
    Else
    {
        If (EvalEG.KRKP.IsPawnSupportedFarAdvanced == 1)
        {
            Ret.EvaluateEndgame.KRKP.Score = (80 - (8 * EvalEG.KRKP.StrongKingPawnDistance));
        }
        Else
        {
            EvalEG.KRKP.PushSqIdx = (EvalEG.KRKP.WeakPawnIdx - Ret.EvaluateEndgame.Locate.PawnPushIdxDelta);
            EvalEG.KRKP.QueeningSqIdx = (EvalEG.KRKP.WeakPawnIdx - (Ret.EvaluateEndgame.Locate.PawnPushIdxDelta * EvalEG.KRKP.WeakPawnRelativeRank));
            EvalEG.KRKP.StrongKingPushDistance = ChebyshevDistance[((EvalEG.KRKP.StrongKingIdx * 100) + EvalEG.KRKP.PushSqIdx)];
            EvalEG.KRKP.WeakKingPushDistance = ChebyshevDistance[((EvalEG.KRKP.WeakKingIdx * 100) + EvalEG.KRKP.PushSqIdx)];
            EvalEG.KRKP.PawnQueeningDistance = ChebyshevDistance[((EvalEG.KRKP.WeakPawnIdx * 100) + EvalEG.KRKP.QueeningSqIdx)];
            Ret.EvaluateEndgame.KRKP.Score = (200 - (8 * ((EvalEG.KRKP.StrongKingPushDistance - EvalEG.KRKP.WeakKingPushDistance) - EvalEG.KRKP.PawnQueeningDistance)));
        }
    }
}

Define EvaluateEndgame.KRPKR(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.KRPKR.Factor = Const.Null;
    Call EvaluateEndgame.Locate(StrongSide);
    Call EvaluateEndgame.StrongToMove(Ply)(StrongSide);
    EvalEG.KRPKR.IsStrongToMove = Ret.EvaluateEndgame.StrongToMove.IsStrongToMove;
    EvalEG.KRPKR.StrongKingIdx = Ret.EvaluateEndgame.Locate.StrongKingIdx;
    EvalEG.KRPKR.WeakKingIdx = Ret.EvaluateEndgame.Locate.WeakKingIdx;
    EvalEG.KRPKR.StrongRookIdx = Ret.EvaluateEndgame.Locate.StrongRookIdx;
    EvalEG.KRPKR.WeakRookIdx = Ret.EvaluateEndgame.Locate.WeakRookIdx;
    EvalEG.KRPKR.PawnIdx = Ret.EvaluateEndgame.Locate.StrongPawnIdx;
    EvalEG.KRPKR.RankBase = Ret.EvaluateEndgame.Locate.RelativeRankBase;
    EvalEG.KRPKR.RankSign = Ret.EvaluateEndgame.Locate.RelativeRankSign;
    EvalEG.KRPKR.FileBase = -1;
    EvalEG.KRPKR.FileSign = 1;
    If (IdxToFile[EvalEG.KRPKR.PawnIdx] > 4)
    {
        EvalEG.KRPKR.FileBase = 8;
        EvalEG.KRPKR.FileSign = -1;
    }
    EvalEG.KRPKR.PawnFile = (EvalEG.KRPKR.FileBase + (EvalEG.KRPKR.FileSign * IdxToFile[EvalEG.KRPKR.PawnIdx]));
    EvalEG.KRPKR.PawnRank = (EvalEG.KRPKR.RankBase + (EvalEG.KRPKR.RankSign * IdxToRank[EvalEG.KRPKR.PawnIdx]));
    EvalEG.KRPKR.StrongKingFile = (EvalEG.KRPKR.FileBase + (EvalEG.KRPKR.FileSign * IdxToFile[EvalEG.KRPKR.StrongKingIdx]));
    EvalEG.KRPKR.StrongKingRank = (EvalEG.KRPKR.RankBase + (EvalEG.KRPKR.RankSign * IdxToRank[EvalEG.KRPKR.StrongKingIdx]));
    EvalEG.KRPKR.StrongRookFile = (EvalEG.KRPKR.FileBase + (EvalEG.KRPKR.FileSign * IdxToFile[EvalEG.KRPKR.StrongRookIdx]));
    EvalEG.KRPKR.StrongRookRank = (EvalEG.KRPKR.RankBase + (EvalEG.KRPKR.RankSign * IdxToRank[EvalEG.KRPKR.StrongRookIdx]));
    EvalEG.KRPKR.WeakKingFile = (EvalEG.KRPKR.FileBase + (EvalEG.KRPKR.FileSign * IdxToFile[EvalEG.KRPKR.WeakKingIdx]));
    EvalEG.KRPKR.WeakKingRank = (EvalEG.KRPKR.RankBase + (EvalEG.KRPKR.RankSign * IdxToRank[EvalEG.KRPKR.WeakKingIdx]));
    EvalEG.KRPKR.WeakRookFile = (EvalEG.KRPKR.FileBase + (EvalEG.KRPKR.FileSign * IdxToFile[EvalEG.KRPKR.WeakRookIdx]));
    EvalEG.KRPKR.WeakRookRank = (EvalEG.KRPKR.RankBase + (EvalEG.KRPKR.RankSign * IdxToRank[EvalEG.KRPKR.WeakRookIdx]));
    EvalEG.KRPKR.QueeningSqIdx = (EvalEG.KRPKR.PawnIdx + (Ret.EvaluateEndgame.Locate.PawnPushIdxDelta * (7 - EvalEG.KRPKR.PawnRank)));
    EvalEG.KRPKR.PushSqIdx = (EvalEG.KRPKR.PawnIdx + Ret.EvaluateEndgame.Locate.PawnPushIdxDelta);
    EvalEG.KRPKR.WeakKingQueeningDistance = ChebyshevDistance[((EvalEG.KRPKR.WeakKingIdx * 100) + EvalEG.KRPKR.QueeningSqIdx)];
    EvalEG.KRPKR.StrongKingQueeningDistance = ChebyshevDistance[((EvalEG.KRPKR.StrongKingIdx * 100) + EvalEG.KRPKR.QueeningSqIdx)];
    EvalEG.KRPKR.StrongKingPawnDistance = ChebyshevDistance[((EvalEG.KRPKR.StrongKingIdx * 100) + EvalEG.KRPKR.PawnIdx)];
    EvalEG.KRPKR.WeakKingStrongRookDistance = ChebyshevDistance[((EvalEG.KRPKR.WeakKingIdx * 100) + EvalEG.KRPKR.StrongRookIdx)];
    EvalEG.KRPKR.IsWeakKingAtQueening = 0;
    If (EvalEG.KRPKR.WeakKingQueeningDistance < 2)
    {
        EvalEG.KRPKR.IsWeakKingAtQueening = 1;
    }
    If (((EvalEG.KRPKR.PawnRank < 5) And (EvalEG.KRPKR.IsWeakKingAtQueening == 1)) And (EvalEG.KRPKR.StrongKingRank < 5))
    {
        If ((EvalEG.KRPKR.WeakRookRank == 5) Or ((EvalEG.KRPKR.PawnRank < 3) And (Not ((EvalEG.KRPKR.StrongRookRank == 5)))))
        {
            Ret.EvaluateEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    If (((EvalEG.KRPKR.PawnRank == 5) And (EvalEG.KRPKR.IsWeakKingAtQueening == 1)) And ((EvalEG.KRPKR.StrongKingRank + EvalEG.KRPKR.IsStrongToMove) < 6))
    {
        If ((EvalEG.KRPKR.WeakRookRank == 0) Or ((EvalEG.KRPKR.IsStrongToMove == 0) And (abs((EvalEG.KRPKR.WeakRookFile - EvalEG.KRPKR.PawnFile)) > 2)))
        {
            Ret.EvaluateEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    If (((EvalEG.KRPKR.PawnRank > 4) And (EvalEG.KRPKR.WeakKingIdx == EvalEG.KRPKR.QueeningSqIdx)) And (EvalEG.KRPKR.WeakRookRank == 0))
    {
        If ((EvalEG.KRPKR.IsStrongToMove == 0) Or (EvalEG.KRPKR.StrongKingPawnDistance > 1))
        {
            Ret.EvaluateEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    EvalEG.KRPKR.IsPawnA7RookA8 = 0;
    If (((EvalEG.KRPKR.PawnFile == 0) And (EvalEG.KRPKR.PawnRank == 6)) And ((EvalEG.KRPKR.StrongRookFile == 0) And (EvalEG.KRPKR.StrongRookRank == 7)))
    {
        EvalEG.KRPKR.IsPawnA7RookA8 = 1;
    }
    If (((EvalEG.KRPKR.IsPawnA7RookA8 == 1) And (EvalEG.KRPKR.WeakKingRank == 6)) And ((EvalEG.KRPKR.WeakKingFile > 5) And (EvalEG.KRPKR.WeakRookFile == 0)))
    {
        If (((EvalEG.KRPKR.WeakRookRank < 3) Or (EvalEG.KRPKR.StrongKingFile > 2)) Or (EvalEG.KRPKR.StrongKingRank < 5))
        {
            Ret.EvaluateEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    If (((EvalEG.KRPKR.PawnRank < 5) And (EvalEG.KRPKR.WeakKingIdx == EvalEG.KRPKR.PushSqIdx)) And ((EvalEG.KRPKR.StrongKingPawnDistance - EvalEG.KRPKR.IsStrongToMove) > 1))
    {
        If ((ChebyshevDistance[((EvalEG.KRPKR.StrongKingIdx * 100) + EvalEG.KRPKR.WeakRookIdx)] - EvalEG.KRPKR.IsStrongToMove) > 1)
        {
            Ret.EvaluateEndgame.KRPKR.Factor = 0;
            Stop(this script);
        }
    }
    EvalEG.KRPKR.IsRookBehindPawn = 0;
    If (((Not ((EvalEG.KRPKR.PawnFile == 0))) And (EvalEG.KRPKR.StrongRookFile == EvalEG.KRPKR.PawnFile)) And (EvalEG.KRPKR.StrongRookRank < EvalEG.KRPKR.PawnRank))
    {
        EvalEG.KRPKR.IsRookBehindPawn = 1;
    }
    EvalEG.KRPKR.IsStrongKingCloserToQueening = 0;
    If (EvalEG.KRPKR.StrongKingQueeningDistance < ((EvalEG.KRPKR.WeakKingQueeningDistance - 2) + EvalEG.KRPKR.IsStrongToMove))
    {
        EvalEG.KRPKR.IsStrongKingCloserToQueening = 1;
    }
    If ((((EvalEG.KRPKR.PawnRank == 6) And (Not ((EvalEG.KRPKR.PawnFile == 0)))) And ((EvalEG.KRPKR.StrongRookFile == EvalEG.KRPKR.PawnFile) And (Not ((EvalEG.KRPKR.StrongRookIdx == EvalEG.KRPKR.QueeningSqIdx))))) And (EvalEG.KRPKR.IsStrongKingCloserToQueening == 1))
    {
        If (EvalEG.KRPKR.StrongKingQueeningDistance < (EvalEG.KRPKR.WeakKingStrongRookDistance + EvalEG.KRPKR.IsStrongToMove))
        {
            Ret.EvaluateEndgame.KRPKR.Factor = (128 - (2 * EvalEG.KRPKR.StrongKingQueeningDistance));
            Stop(this script);
        }
    }
    If ((EvalEG.KRPKR.IsRookBehindPawn == 1) And (EvalEG.KRPKR.IsStrongKingCloserToQueening == 1))
    {
        EvalEG.KRPKR.StrongKingPushDistance = ChebyshevDistance[((EvalEG.KRPKR.StrongKingIdx * 100) + EvalEG.KRPKR.PushSqIdx)];
        EvalEG.KRPKR.WeakKingPushDistance = ChebyshevDistance[((EvalEG.KRPKR.WeakKingIdx * 100) + EvalEG.KRPKR.PushSqIdx)];
        If (EvalEG.KRPKR.StrongKingPushDistance < ((EvalEG.KRPKR.WeakKingPushDistance - 2) + EvalEG.KRPKR.IsStrongToMove))
        {
            EvalEG.KRPKR.IsWeakKingAwayFromRook = 0;
            If (Not (((EvalEG.KRPKR.WeakKingStrongRookDistance + EvalEG.KRPKR.IsStrongToMove) < 3)))
            {
                EvalEG.KRPKR.IsWeakKingAwayFromRook = 1;
            }
            If ((EvalEG.KRPKR.StrongKingQueeningDistance < (EvalEG.KRPKR.WeakKingStrongRookDistance + EvalEG.KRPKR.IsStrongToMove)) And (EvalEG.KRPKR.StrongKingPushDistance < (ChebyshevDistance[((EvalEG.KRPKR.WeakKingIdx * 100) + EvalEG.KRPKR.PawnIdx)] + EvalEG.KRPKR.IsStrongToMove)))
            {
                EvalEG.KRPKR.IsWeakKingAwayFromRook = 1;
            }
            If (EvalEG.KRPKR.IsWeakKingAwayFromRook == 1)
            {
                EvalEG.KRPKR.PawnQueeningDistance = ChebyshevDistance[((EvalEG.KRPKR.PawnIdx * 100) + EvalEG.KRPKR.QueeningSqIdx)];
                Ret.EvaluateEndgame.KRPKR.Factor = ((128 - (8 * EvalEG.KRPKR.PawnQueeningDistance)) - (2 * EvalEG.KRPKR.StrongKingQueeningDistance));
                Stop(this script);
            }
        }
    }
    EvalEG.KRPKR.WeakKingSqNumber = ((EvalEG.KRPKR.WeakKingRank * 8) + EvalEG.KRPKR.WeakKingFile);
    EvalEG.KRPKR.PawnSqNumber = ((EvalEG.KRPKR.PawnRank * 8) + EvalEG.KRPKR.PawnFile);
    If ((EvalEG.KRPKR.PawnRank < 4) And (EvalEG.KRPKR.WeakKingSqNumber > EvalEG.KRPKR.PawnSqNumber))
    {
        If (EvalEG.KRPKR.WeakKingFile == EvalEG.KRPKR.PawnFile)
        {
            Ret.EvaluateEndgame.KRPKR.Factor = 10;
            Stop(this script);
        }
        EvalEG.KRPKR.KingDistance = ChebyshevDistance[((EvalEG.KRPKR.StrongKingIdx * 100) + EvalEG.KRPKR.WeakKingIdx)];
        If ((abs((EvalEG.KRPKR.WeakKingFile - EvalEG.KRPKR.PawnFile)) == 1) And (EvalEG.KRPKR.KingDistance > 2))
        {
            Ret.EvaluateEndgame.KRPKR.Factor = (24 - (2 * EvalEG.KRPKR.KingDistance));
        }
    }
}

Define EvaluateEndgame.KRPPKRP(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.KRPPKRP.Factor = Const.Null;
    Call EvaluateEndgame.Locate(StrongSide);
    EvalEG.KRPPKRP.RankBase = Ret.EvaluateEndgame.Locate.RelativeRankBase;
    EvalEG.KRPPKRP.RankSign = Ret.EvaluateEndgame.Locate.RelativeRankSign;
    EvalEG.KRPPKRP.PawnIdx = Ret.EvaluateEndgame.Locate.StrongPawnIdx;
    EvalEG.KRPPKRP.SecondPawnIdx = Ret.EvaluateEndgame.Locate.SecondStrongPawnIdx;
    EvalEG.KRPPKRP.WeakPawnIdx = Ret.EvaluateEndgame.Locate.WeakPawnIdx;
    EvalEG.KRPPKRP.WeakKingIdx = Ret.EvaluateEndgame.Locate.WeakKingIdx;
    EvalEG.KRPPKRP.PawnRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.PawnIdx]));
    EvalEG.KRPPKRP.SecondPawnRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.SecondPawnIdx]));
    EvalEG.KRPPKRP.WeakPawnRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.WeakPawnIdx]));
    EvalEG.KRPPKRP.WeakPawnFile = IdxToFile[EvalEG.KRPPKRP.WeakPawnIdx];
    EvalEG.KRPPKRP.IsPawnBlocked = 0;
    If ((abs((EvalEG.KRPPKRP.WeakPawnFile - IdxToFile[EvalEG.KRPPKRP.PawnIdx])) < 2) And (EvalEG.KRPPKRP.WeakPawnRank > EvalEG.KRPPKRP.PawnRank))
    {
        EvalEG.KRPPKRP.IsPawnBlocked = 1;
    }
    EvalEG.KRPPKRP.IsSecondPawnBlocked = 0;
    If ((abs((EvalEG.KRPPKRP.WeakPawnFile - IdxToFile[EvalEG.KRPPKRP.SecondPawnIdx])) < 2) And (EvalEG.KRPPKRP.WeakPawnRank > EvalEG.KRPPKRP.SecondPawnRank))
    {
        EvalEG.KRPPKRP.IsSecondPawnBlocked = 1;
    }
    If ((EvalEG.KRPPKRP.IsPawnBlocked == 0) Or (EvalEG.KRPPKRP.IsSecondPawnBlocked == 0))
    {
        Stop(this script);
    }
    EvalEG.KRPPKRP.FrontPawnRank = EvalEG.KRPPKRP.PawnRank;
    If (EvalEG.KRPPKRP.SecondPawnRank > EvalEG.KRPPKRP.FrontPawnRank)
    {
        EvalEG.KRPPKRP.FrontPawnRank = EvalEG.KRPPKRP.SecondPawnRank;
    }
    EvalEG.KRPPKRP.WeakKingFile = IdxToFile[EvalEG.KRPPKRP.WeakKingIdx];
    EvalEG.KRPPKRP.WeakKingRank = (EvalEG.KRPPKRP.RankBase + (EvalEG.KRPPKRP.RankSign * IdxToRank[EvalEG.KRPPKRP.WeakKingIdx]));
    If ((abs((EvalEG.KRPPKRP.WeakKingFile - IdxToFile[EvalEG.KRPPKRP.PawnIdx])) < 2) And (abs((EvalEG.KRPPKRP.WeakKingFile - IdxToFile[EvalEG.KRPPKRP.SecondPawnIdx])) < 2))
    {
        If (EvalEG.KRPPKRP.WeakKingRank > EvalEG.KRPPKRP.FrontPawnRank)
        {
            Ret.EvaluateEndgame.KRPPKRP.Factor = (7 * EvalEG.KRPPKRP.FrontPawnRank);
        }
    }
}

Define EvaluateEndgame.Locate(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.Locate.StrongPawnIdx = 0;
    Ret.EvaluateEndgame.Locate.SecondStrongPawnIdx = 0;
    Ret.EvaluateEndgame.Locate.StrongBishopIdx = 0;
    Ret.EvaluateEndgame.Locate.StrongRookIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakPawnIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakBishopIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakKnightIdx = 0;
    Ret.EvaluateEndgame.Locate.WeakRookIdx = 0;
    EvalEG.Locate.SqIdx = 1;
    Repeat (64)
    {
        EvalEG.Locate.StrongViewPiece = (Board[EvalEG.Locate.SqIdx] * StrongSide);
        If (EvalEG.Locate.StrongViewPiece == GoK_OwnPawn)
        {
            If (Ret.EvaluateEndgame.Locate.StrongPawnIdx == 0)
            {
                Ret.EvaluateEndgame.Locate.StrongPawnIdx = EvalEG.Locate.SqIdx;
            }
            Else
            {
                Ret.EvaluateEndgame.Locate.SecondStrongPawnIdx = EvalEG.Locate.SqIdx;
            }
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_OwnBishop)
        {
            Ret.EvaluateEndgame.Locate.StrongBishopIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_OwnRook)
        {
            Ret.EvaluateEndgame.Locate.StrongRookIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_OppPawn)
        {
            Ret.EvaluateEndgame.Locate.WeakPawnIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_OppBishop)
        {
            Ret.EvaluateEndgame.Locate.WeakBishopIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_OppKnight)
        {
            Ret.EvaluateEndgame.Locate.WeakKnightIdx = EvalEG.Locate.SqIdx;
        }
        If (EvalEG.Locate.StrongViewPiece == GoK_OppRook)
        {
            Ret.EvaluateEndgame.Locate.WeakRookIdx = EvalEG.Locate.SqIdx;
        }
        EvalEG.Locate.SqIdx += 1;
    }
    If (StrongSide == 1)
    {
        Ret.EvaluateEndgame.Locate.StrongKingIdx = Glob.OwnKingIdx;
        Ret.EvaluateEndgame.Locate.WeakKingIdx = Glob.OppKingIdx;
        Ret.EvaluateEndgame.Locate.RelativeRankBase = -1;
        Ret.EvaluateEndgame.Locate.RelativeRankSign = 1;
        Ret.EvaluateEndgame.Locate.PawnPushIdxDelta = 8;
    }
    Else
    {
        Ret.EvaluateEndgame.Locate.StrongKingIdx = Glob.OppKingIdx;
        Ret.EvaluateEndgame.Locate.WeakKingIdx = Glob.OwnKingIdx;
        Ret.EvaluateEndgame.Locate.RelativeRankBase = 8;
        Ret.EvaluateEndgame.Locate.RelativeRankSign = -1;
        Ret.EvaluateEndgame.Locate.PawnPushIdxDelta = -8;
    }
}

Define EvaluateEndgame.Material(string StrongSide) (warp=true)
{
    If (StrongSide == 1)
    {
        EvalEG.Material.StrongQueenCount = Glob.OwnQueenCount;
        EvalEG.Material.StrongRookCount = Glob.OwnRookCount;
        EvalEG.Material.StrongBishopCount = Glob.OwnBishopCount;
        EvalEG.Material.StrongMajorMinorCount = Glob.OwnNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.StrongPawnCount = Glob.OwnPawnCount;
        EvalEG.Material.WeakQueenCount = Glob.OppQueenCount;
        Ret.EvaluateEndgame.Material.WeakRookCount = Glob.OppRookCount;
        EvalEG.Material.WeakBishopCount = Glob.OppBishopCount;
        EvalEG.Material.WeakMajorMinorCount = Glob.OppNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.WeakPawnCount = Glob.OppPawnCount;
    }
    Else
    {
        EvalEG.Material.StrongQueenCount = Glob.OppQueenCount;
        EvalEG.Material.StrongRookCount = Glob.OppRookCount;
        EvalEG.Material.StrongBishopCount = Glob.OppBishopCount;
        EvalEG.Material.StrongMajorMinorCount = Glob.OppNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.StrongPawnCount = Glob.OppPawnCount;
        EvalEG.Material.WeakQueenCount = Glob.OwnQueenCount;
        Ret.EvaluateEndgame.Material.WeakRookCount = Glob.OwnRookCount;
        EvalEG.Material.WeakBishopCount = Glob.OwnBishopCount;
        EvalEG.Material.WeakMajorMinorCount = Glob.OwnNonQueenMajorMinorCount;
        Ret.EvaluateEndgame.Material.WeakPawnCount = Glob.OwnPawnCount;
    }
    EvalEG.Material.StrongKnightCount = ((EvalEG.Material.StrongMajorMinorCount - EvalEG.Material.StrongRookCount) - EvalEG.Material.StrongBishopCount);
    EvalEG.Material.StrongPieceCount = (EvalEG.Material.StrongQueenCount + EvalEG.Material.StrongMajorMinorCount);
    EvalEG.Material.WeakKnightCount = ((EvalEG.Material.WeakMajorMinorCount - Ret.EvaluateEndgame.Material.WeakRookCount) - EvalEG.Material.WeakBishopCount);
    EvalEG.Material.WeakPieceCount = (EvalEG.Material.WeakQueenCount + EvalEG.Material.WeakMajorMinorCount);
    Ret.EvaluateEndgame.Material.StrongPiecesAreNone = 0;
    If (EvalEG.Material.StrongPieceCount == 0)
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreNone = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreRook = 0;
    If ((EvalEG.Material.StrongPieceCount == 1) And (EvalEG.Material.StrongRookCount == 1))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreRook = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreQueen = 0;
    If ((EvalEG.Material.StrongPieceCount == 1) And (EvalEG.Material.StrongQueenCount == 1))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreQueen = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreBishop = 0;
    If ((EvalEG.Material.StrongPieceCount == 1) And (EvalEG.Material.StrongBishopCount == 1))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreBishop = 1;
    }
    Ret.EvaluateEndgame.Material.StrongPiecesAreTwoKnights = 0;
    If ((EvalEG.Material.StrongPieceCount == 2) And (EvalEG.Material.StrongKnightCount == 2))
    {
        Ret.EvaluateEndgame.Material.StrongPiecesAreTwoKnights = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreNone = 0;
    If (EvalEG.Material.WeakPieceCount == 0)
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreNone = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreRook = 0;
    If ((EvalEG.Material.WeakPieceCount == 1) And (Ret.EvaluateEndgame.Material.WeakRookCount == 1))
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreRook = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreBishop = 0;
    If ((EvalEG.Material.WeakPieceCount == 1) And (EvalEG.Material.WeakBishopCount == 1))
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreBishop = 1;
    }
    Ret.EvaluateEndgame.Material.WeakPiecesAreKnight = 0;
    If ((EvalEG.Material.WeakPieceCount == 1) And (EvalEG.Material.WeakKnightCount == 1))
    {
        Ret.EvaluateEndgame.Material.WeakPiecesAreKnight = 1;
    }
}

Define EvaluateEndgame.PawnScan(string StrongSide)(string WeakKingIdx)(string WeakRookIdx) (warp=true)
{
    Ret.EvaluateEndgame.PawnScan.StrongPawnCount = 0;
    Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileACount = 0;
    Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileHCount = 0;
    Ret.EvaluateEndgame.PawnScan.PawnCount = 0;
    Ret.EvaluateEndgame.PawnScan.PawnOnFileBCount = 0;
    Ret.EvaluateEndgame.PawnScan.PawnOnFileGCount = 0;
    Ret.EvaluateEndgame.PawnScan.StrongPawnInKingSpanCount = 0;
    Ret.EvaluateEndgame.PawnScan.HasRookFortressPawn = 0;
    Ret.EvaluateEndgame.PawnScan.WeakFrontPawnIdx = 0;
    EvalEG.PawnScan.RelativeRankBase = -1;
    EvalEG.PawnScan.RelativeRankSign = 1;
    If (StrongSide < 0)
    {
        EvalEG.PawnScan.RelativeRankBase = 8;
        EvalEG.PawnScan.RelativeRankSign = -1;
    }
    EvalEG.PawnScan.WeakKingRelativeRank = (EvalEG.PawnScan.RelativeRankBase + (EvalEG.PawnScan.RelativeRankSign * IdxToRank[WeakKingIdx]));
    EvalEG.PawnScan.WeakFrontPawnRelativeRank = -1;
    EvalEG.PawnScan.ListIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_Pawns))
    {
        EvalEG.PawnScan.SqIdx = EvalPiecesIdx_Pawns[EvalEG.PawnScan.ListIdx];
        EvalEG.PawnScan.File = IdxToFile[EvalEG.PawnScan.SqIdx];
        EvalEG.PawnScan.RelativeRank = (EvalEG.PawnScan.RelativeRankBase + (EvalEG.PawnScan.RelativeRankSign * IdxToRank[EvalEG.PawnScan.SqIdx]));
        Ret.EvaluateEndgame.PawnScan.PawnCount += 1;
        If (EvalEG.PawnScan.File == 2)
        {
            Ret.EvaluateEndgame.PawnScan.PawnOnFileBCount += 1;
        }
        If (EvalEG.PawnScan.File == 7)
        {
            Ret.EvaluateEndgame.PawnScan.PawnOnFileGCount += 1;
        }
        If ((Board[EvalEG.PawnScan.SqIdx] * StrongSide) > 0)
        {
            Ret.EvaluateEndgame.PawnScan.StrongPawnCount += 1;
            If (EvalEG.PawnScan.File == 1)
            {
                Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileACount += 1;
            }
            If (EvalEG.PawnScan.File == 8)
            {
                Ret.EvaluateEndgame.PawnScan.StrongPawnOnFileHCount += 1;
            }
            EvalEG.PawnScan.KingFileDeltaAbs = abs((EvalEG.PawnScan.File - IdxToFile[WeakKingIdx]));
            If ((EvalEG.PawnScan.KingFileDeltaAbs < 2) And (EvalEG.PawnScan.RelativeRank < EvalEG.PawnScan.WeakKingRelativeRank))
            {
                Ret.EvaluateEndgame.PawnScan.StrongPawnInKingSpanCount += 1;
            }
        }
        Else
        {
            If (EvalEG.PawnScan.RelativeRank > EvalEG.PawnScan.WeakFrontPawnRelativeRank)
            {
                Ret.EvaluateEndgame.PawnScan.WeakFrontPawnIdx = EvalEG.PawnScan.SqIdx;
                EvalEG.PawnScan.WeakFrontPawnRelativeRank = EvalEG.PawnScan.RelativeRank;
            }
            If (WeakRookIdx > 0)
            {
                EvalEG.PawnScan.IsNextToWeakKing = 0;
                If (ChebyshevDistance[((EvalEG.PawnScan.SqIdx * 100) + WeakKingIdx)] == 1)
                {
                    EvalEG.PawnScan.IsNextToWeakKing = 1;
                }
                EvalEG.PawnScan.RookRelativeRank = (EvalEG.PawnScan.RelativeRankBase + (EvalEG.PawnScan.RelativeRankSign * IdxToRank[WeakRookIdx]));
                EvalEG.PawnScan.RookFileDeltaAbs = abs((EvalEG.PawnScan.File - IdxToFile[WeakRookIdx]));
                If (((EvalEG.PawnScan.IsNextToWeakKing == 1) And (EvalEG.PawnScan.RelativeRank == (EvalEG.PawnScan.RookRelativeRank + 1))) And (EvalEG.PawnScan.RookFileDeltaAbs == 1))
                {
                    Ret.EvaluateEndgame.PawnScan.HasRookFortressPawn = 1;
                }
            }
        }
        EvalEG.PawnScan.ListIdx += 1;
    }
}

Define EvaluateEndgame.PushToEdge(string SqIdx) (warp=true)
{
    EvalEG.PushToEdge.FileEdgeDistance = (IdxToFile[SqIdx] - 1);
    If (EvalEG.PushToEdge.FileEdgeDistance > 3)
    {
        EvalEG.PushToEdge.FileEdgeDistance = (7 - EvalEG.PushToEdge.FileEdgeDistance);
    }
    EvalEG.PushToEdge.RankEdgeDistance = (IdxToRank[SqIdx] - 1);
    If (EvalEG.PushToEdge.RankEdgeDistance > 3)
    {
        EvalEG.PushToEdge.RankEdgeDistance = (7 - EvalEG.PushToEdge.RankEdgeDistance);
    }
    EvalEG.PushToEdge.FilePenalty = floor(((7 * (EvalEG.PushToEdge.FileEdgeDistance * EvalEG.PushToEdge.FileEdgeDistance)) / 2));
    EvalEG.PushToEdge.RankPenalty = floor(((7 * (EvalEG.PushToEdge.RankEdgeDistance * EvalEG.PushToEdge.RankEdgeDistance)) / 2));
    Ret.EvaluateEndgame.PushToEdge.Score = (90 - (EvalEG.PushToEdge.FilePenalty + EvalEG.PushToEdge.RankPenalty));
}

Define EvaluateEndgame.Scale(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.Scale.Factor = Const.Null;
    Call EvaluateEndgame.Material((0 - StrongSide));
    EvalEG.Scale.IsOtherSideExactEndgame = 0;
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvaluateEndgame.Material.StrongPawnCount == 1))
    {
        If ((Ret.EvaluateEndgame.Material.WeakPawnCount == 0) And ((Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1) Or (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEG.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreBishop == 1) And (Ret.EvaluateEndgame.Material.WeakPawnCount == 0))
    {
        If (((Ret.EvaluateEndgame.Material.StrongPawnCount == 1) And ((Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1) Or (Ret.EvaluateEndgame.Material.WeakPiecesAreKnight == 1))) Or ((Ret.EvaluateEndgame.Material.StrongPawnCount == 2) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1)))
        {
            EvalEG.Scale.IsOtherSideExactEndgame = 1;
        }
    }
    If (((Ret.EvaluateEndgame.Material.StrongPiecesAreRook == 1) And (Ret.EvaluateEndgame.Material.StrongPawnCount == 2)) And ((Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1) And (Ret.EvaluateEndgame.Material.WeakPawnCount == 1)))
    {
        EvalEG.Scale.IsOtherSideExactEndgame = 1;
    }
    If (EvalEG.Scale.IsOtherSideExactEndgame == 1)
    {
        Stop(this script);
    }
    Call EvaluateEndgame.Material(StrongSide);
    EvalEG.Scale.StrongPawnCount = Ret.EvaluateEndgame.Material.StrongPawnCount;
    EvalEG.Scale.WeakPawnCount = Ret.EvaluateEndgame.Material.WeakPawnCount;
    If (Ret.EvaluateEndgame.Material.StrongPiecesAreRook == 1)
    {
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvaluateEndgame.KRPKR(Ply)(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KRPKR.Factor;
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 2) And (EvalEG.Scale.WeakPawnCount == 1)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreRook == 1))
        {
            Call EvaluateEndgame.KRPPKRP(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KRPPKRP.Factor;
            Stop(this script);
        }
    }
    If (Ret.EvaluateEndgame.Material.StrongPiecesAreBishop == 1)
    {
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Call EvaluateEndgame.KBPKB(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KBPKB.Factor;
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 1) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreKnight == 1))
        {
            Call EvaluateEndgame.KBPKN(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KBPKN.Factor;
            Stop(this script);
        }
        If (((EvalEG.Scale.StrongPawnCount == 2) And (EvalEG.Scale.WeakPawnCount == 0)) And (Ret.EvaluateEndgame.Material.WeakPiecesAreBishop == 1))
        {
            Stop(this script);
        }
        If (EvalEG.Scale.StrongPawnCount > 0)
        {
            Call EvaluateEndgame.KBPsK(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KBPsK.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreQueen == 1) And (EvalEG.Scale.StrongPawnCount == 0))
    {
        If ((Ret.EvaluateEndgame.Material.WeakRookCount == 1) And (EvalEG.Scale.WeakPawnCount > 0))
        {
            Call EvaluateEndgame.KQKRPs(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KQKRPs.Factor;
            Stop(this script);
        }
    }
    If ((Ret.EvaluateEndgame.Material.StrongPiecesAreNone == 1) And (Ret.EvaluateEndgame.Material.WeakPiecesAreNone == 1))
    {
        If ((EvalEG.Scale.StrongPawnCount > 1) And (EvalEG.Scale.WeakPawnCount == 0))
        {
            Call EvaluateEndgame.KPsK(StrongSide);
            Ret.EvaluateEndgame.Scale.Factor = Ret.EvaluateEndgame.KPsK.Factor;
        }
    }
}

Define EvaluateEndgame.StrongToMove(string Ply)(string StrongSide) (warp=true)
{
    Ret.EvaluateEndgame.StrongToMove.IsStrongToMove = PlyIsOwn[(Ply + 1)];
    If (StrongSide < 0)
    {
        Ret.EvaluateEndgame.StrongToMove.IsStrongToMove = (1 - Ret.EvaluateEndgame.StrongToMove.IsStrongToMove);
    }
}

Define EvaluateMajorsMinors(string Ply) (warp=true)
{
    Call //("Tapered evaluation, interpolating between midgame and game");
    Call EvaluateMajorsMinorsImpl(Ply);
    Ret.EvaluateMajorsMinors.Score = Ret.EvaluateMajorsMinorsImpl.Score;
}

Define EvaluateMajorsMinorsImpl(string Ply) (warp=true)
{
    Ret.EvaluateMajorsMinorsImpl.Score = 0;
    Call TaperedEval.Init;
    EvalMM.EvalPieceIdx = 1;
    Repeat (List.Length(EvalPiecesIdx_NonPawns))
    {
        EvalMM.PieceSqIdx = (EvalPiecesIdx_NonPawns[EvalMM.EvalPieceIdx] + 0);
        EvalMM.Piece = (Board[(EvalMM.PieceSqIdx + 0)] + 0);
        EvalMM.Factor = (((EvalMM.Piece > 0) * 2) - 1);
        EvalMM.Side = (2 - (EvalMM.Piece > 0));
        EvalMM.PieceAbs = abs(EvalMM.Piece);
        If (EvalMM.Piece > 0)
        {
            EvalMM.KingIdx = Glob.OwnKingIdx;
        }
        Else
        {
            EvalMM.KingIdx = Glob.OppKingIdx;
        }
        If (Glob.IsExtendedEval == 1)
        {
            EvalMM.MobilityIdx = ((PieceMobility[(EvalMM.PieceSqIdx + 0)] * 2) + 1);
            If (EvalMM.PieceAbs == GoK_OwnRook)
            {
                Call TaperedEval.Add((RookMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((RookMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
            }
            Else
            {
                If (EvalMM.PieceAbs == GoK_OwnBishop)
                {
                    Call TaperedEval.Add((BishopMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((BishopMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                }
                Else
                {
                    If (EvalMM.PieceAbs == GoK_OwnKnight)
                    {
                        Call TaperedEval.Add((KnightMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((KnightMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                    }
                    Else
                    {
                        If (EvalMM.PieceAbs == GoK_OwnQueen)
                        {
                            Call TaperedEval.Add((QueenMobilityBonus[(EvalMM.MobilityIdx + 0)] * EvalMM.Factor))((QueenMobilityBonus[(EvalMM.MobilityIdx + 1)] * EvalMM.Factor))("")("")("")("");
                        }
                    }
                }
            }
        }
        If ((EvalMM.PieceAbs == GoK_OwnKnight) Or (EvalMM.PieceAbs == GoK_OwnBishop))
        {
            EvalMM.Rank = (IdxToRank[(EvalMM.PieceSqIdx + 0)] + 0);
            EvalMM.File = (IdxToFile[(EvalMM.PieceSqIdx + 0)] + 0);
            If (Glob.IsExtendedEval == 1)
            {
                EvalMM.OP.KnightStepIdx = 0;
                EvalMM.OP.OnOutpost = 0;
                EvalMM.OP.IsOutpostReachable = 0;
                Repeat ((1 + (8 * (EvalMM.PieceAbs == GoK_OwnKnight))))
                {
                    If (EvalMM.OP.KnightStepIdx == 0)
                    {
                        EvalMM.OP.SquareFile = EvalMM.File;
                        EvalMM.OP.SquareRank = EvalMM.Rank;
                    }
                    Else
                    {
                        EvalMM.OP.SquareFile = (EvalMM.File + KnightFileDelta[EvalMM.OP.KnightStepIdx]);
                        EvalMM.OP.SquareRank = (EvalMM.Rank + KnightRankDelta[EvalMM.OP.KnightStepIdx]);
                    }
                    EvalMM.OP.IsOnBoard = (((EvalMM.OP.SquareFile > 0) And (EvalMM.OP.SquareFile < 9)) And ((EvalMM.OP.SquareRank > 0) And (EvalMM.OP.SquareRank < 9)));
                    EvalMM.OP.SquareIdx = (((EvalMM.OP.SquareRank - 1) * 8) + EvalMM.OP.SquareFile);
                    EvalMM.OP.IsOutpost = 0;
                    If ((EvalMM.OP.IsOnBoard == 1) And ((EvalMM.OP.SquareRank > (2 + (EvalMM.Factor > 0))) And (EvalMM.OP.SquareRank < (6 + (EvalMM.Factor > 0)))))
                    {
                        If (((((EvalMM.OP.SquareFile > 1) And ((((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + -1) > 0) And (((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + -1) < 65))) And (Board[((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + -1)] == (GoK_OwnPawn * EvalMM.Factor))) Or (((EvalMM.OP.SquareFile < 8) And ((((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + 1) > 0) And (((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + 1) < 65))) And (Board[((EvalMM.OP.SquareIdx - (8 * EvalMM.Factor)) + 1)] == (GoK_OwnPawn * EvalMM.Factor)))) Or ((((EvalMM.OP.SquareIdx + (8 * EvalMM.Factor)) > 0) And ((EvalMM.OP.SquareIdx + (8 * EvalMM.Factor)) < 65)) And (abs(Board[(EvalMM.OP.SquareIdx + (8 * EvalMM.Factor))]) == GoK_OwnPawn)))
                        {
                            EvalMM.OP.IsPawnAttackable = 0;
                            EvalMM.OP.PawnListIdx = 1;
                            Repeat (List.Length(EvalPiecesIdx_Pawns))
                            {
                                EvalMM.OP.PawnIdx = (EvalPiecesIdx_Pawns[EvalMM.OP.PawnListIdx] + 0);
                                If ((EvalMM.OP.IsPawnAttackable == 0) And (Board[EvalMM.OP.PawnIdx] == (GoK_OppPawn * EvalMM.Factor)))
                                {
                                    EvalMM.OP.RankDelta = ((IdxToRank[EvalMM.OP.PawnIdx] - EvalMM.OP.SquareRank) * EvalMM.Factor);
                                    If ((abs((IdxToFile[EvalMM.OP.PawnIdx] - EvalMM.OP.SquareFile)) == 1) And (EvalMM.OP.RankDelta > 0))
                                    {
                                        If (EvalMM.OP.RankDelta == 1)
                                        {
                                            EvalMM.OP.IsPawnAttackable = 1;
                                        }
                                        Else
                                        {
                                            EvalMM.OP.Blocked = (Board[(EvalMM.OP.PawnIdx - (8 * EvalMM.Factor))] == (GoK_OwnPawn * EvalMM.Factor));
                                            EvalMM.OP.Lever = ((((IdxToFile[EvalMM.OP.PawnIdx] > 1) And (((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + -1) > 0) And ((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + -1) < 65))) And (Board[(((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + -1)] == (GoK_OwnPawn * EvalMM.Factor))) Or (((IdxToFile[EvalMM.OP.PawnIdx] < 8) And (((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + 1) > 0) And ((((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + 1) < 65))) And (Board[(((EvalMM.OP.PawnIdx - (8 * EvalMM.Factor)) - (8 * EvalMM.Factor)) + 1)] == (GoK_OwnPawn * EvalMM.Factor))));
                                            EvalMM.OP.Supported = 0;
                                            EvalMM.OP.NeighbourListIdx = 1;
                                            Repeat (List.Length(EvalPiecesIdx_Pawns))
                                            {
                                                EvalMM.OP.NeighbourIdx = (EvalPiecesIdx_Pawns[EvalMM.OP.NeighbourListIdx] + 0);
                                                If (((Board[EvalMM.OP.NeighbourIdx] == (GoK_OppPawn * EvalMM.Factor)) And (abs((IdxToFile[EvalMM.OP.NeighbourIdx] - IdxToFile[EvalMM.OP.PawnIdx])) == 1)) And (Not ((((IdxToRank[EvalMM.OP.NeighbourIdx] - IdxToRank[EvalMM.OP.PawnIdx]) * EvalMM.Factor) < 0))))
                                                {
                                                    EvalMM.OP.Supported = 1;
                                                }
                                                EvalMM.OP.NeighbourListIdx += 1;
                                            }
                                            If ((EvalMM.OP.Blocked == 0) And (Not (((EvalMM.OP.Supported == 0) And ((EvalMM.OP.Lever == 1) Or (EvalMM.OP.Blocked == 1))))))
                                            {
                                                EvalMM.OP.IsPawnAttackable = 1;
                                            }
                                        }
                                    }
                                }
                                EvalMM.OP.PawnListIdx += 1;
                            }
                            If (EvalMM.OP.IsPawnAttackable == 0)
                            {
                                EvalMM.OP.IsOutpost = 1;
                            }
                        }
                    }
                    If (EvalMM.OP.KnightStepIdx == 0)
                    {
                        EvalMM.OP.OnOutpost = EvalMM.OP.IsOutpost;
                    }
                    Else
                    {
                        If ((EvalMM.OP.IsOutpost == 1) And (Not (((Board[EvalMM.OP.SquareIdx] * EvalMM.Factor) > 0))))
                        {
                            EvalMM.OP.IsOutpostReachable = 1;
                        }
                    }
                    EvalMM.OP.KnightStepIdx += 1;
                }
                EvalMM.OP.IsAttackingPiece = 1;
                EvalMM.OP.WingTargetCount = 2;
                If ((EvalMM.PieceAbs == GoK_OwnKnight) And ((EvalMM.OP.OnOutpost == 1) And ((EvalMM.File < 3) Or (EvalMM.File > 6))))
                {
                    EvalMM.OP.IsAttackingPiece = 0;
                    EvalMM.OP.KnightStepListIdx = 1;
                    Repeat (8)
                    {
                        EvalMM.OP.SquareFile = (EvalMM.File + KnightFileDelta[EvalMM.OP.KnightStepListIdx]);
                        EvalMM.OP.SquareRank = (EvalMM.Rank + KnightRankDelta[EvalMM.OP.KnightStepListIdx]);
                        If (((EvalMM.OP.SquareFile > 0) And (EvalMM.OP.SquareFile < 9)) And ((EvalMM.OP.SquareRank > 0) And (EvalMM.OP.SquareRank < 9)))
                        {
                            EvalMM.OP.TargetIdx = (((EvalMM.OP.SquareRank - 1) * 8) + EvalMM.OP.SquareFile);
                            If (((Board[EvalMM.OP.TargetIdx] * EvalMM.Factor) < 0) And (abs(Board[EvalMM.OP.TargetIdx]) > GoK_OwnPawn))
                            {
                                EvalMM.OP.IsAttackingPiece = 1;
                            }
                        }
                        EvalMM.OP.KnightStepListIdx += 1;
                    }
                    EvalMM.OP.WingTargetCount = 0;
                    EvalMM.OP.TargetListIdx = 1;
                    Repeat (List.Length(EvalPiecesIdx_NonPawns))
                    {
                        EvalMM.OP.TargetIdx = (EvalPiecesIdx_NonPawns[EvalMM.OP.TargetListIdx] + 0);
                        If ((((Board[EvalMM.OP.TargetIdx] * EvalMM.Factor) < 0) And (abs(Board[EvalMM.OP.TargetIdx]) > GoK_OwnPawn)) And ((IdxToFile[EvalMM.OP.TargetIdx] > 4) == (EvalMM.File > 4)))
                        {
                            EvalMM.OP.WingTargetCount += 1;
                        }
                        EvalMM.OP.TargetListIdx += 1;
                    }
                }
                If ((EvalMM.OP.IsAttackingPiece == 0) And (EvalMM.OP.WingTargetCount < 2))
                {
                    EvalMM.OP.WingPawnCount = 0;
                    EvalMM.OP.WingFile = (1 + (4 * (EvalMM.File > 4)));
                    Repeat (4)
                    {
                        EvalMM.OP.WingPawnCount += (PawnCount[EvalMM.OP.WingFile] + PawnCount[(EvalMM.OP.WingFile + 8)]);
                        EvalMM.OP.WingFile += 1;
                    }
                    Call TaperedEval.Add(0)(((5 * EvalMM.OP.WingPawnCount) * EvalMM.Factor))("Eval.MajorsMinors.KnightUncontestedOutpost")(EvalMM.PieceSqIdx)("")("");
                }
                Else
                {
                    If (EvalMM.OP.OnOutpost == 1)
                    {
                        If (EvalMM.PieceAbs == GoK_OwnKnight)
                        {
                            Call TaperedEval.Add((27 * EvalMM.Factor))((17 * EvalMM.Factor))("Eval.MajorsMinors.KnightOutpost")(EvalMM.PieceSqIdx)("")("");
                        }
                        Else
                        {
                            Call TaperedEval.Add((15.5 * EvalMM.Factor))((12.5 * EvalMM.Factor))("Eval.MajorsMinors.BishopOutpost")(EvalMM.PieceSqIdx)("")("");
                        }
                    }
                    Else
                    {
                        If ((EvalMM.PieceAbs == GoK_OwnKnight) And (EvalMM.OP.IsOutpostReachable == 1))
                        {
                            Call TaperedEval.Add((16.5 * EvalMM.Factor))((9.5 * EvalMM.Factor))("Eval.MajorsMinors.KnightReachableOutpost")(EvalMM.PieceSqIdx)("")("");
                        }
                    }
                }
            }
            If (((EvalMM.PieceSqIdx + (8 * EvalMM.Factor)) > 0) And ((EvalMM.PieceSqIdx + (8 * EvalMM.Factor)) < 65))
            {
                If (abs(Board[(EvalMM.PieceSqIdx + (8 * EvalMM.Factor))]) == GoK_OwnPawn)
                {
                    Call TaperedEval.Add((9 * EvalMM.Factor))((2 * EvalMM.Factor))("Eval.MajorsMinors.MnorBehindFriendlyPawn")(EvalMM.PieceSqIdx)("")("");
                }
            }
            EvalMM.KingCentreDist = (ChebyshevDistance[((EvalMM.PieceSqIdx * 100) + EvalMM.KingIdx)] + 0);
            Call TaperedEval.Add((((-3 - (EvalMM.PieceAbs == GoK_OwnKnight)) * EvalMM.KingCentreDist) * EvalMM.Factor))(((-4 * EvalMM.KingCentreDist) * EvalMM.Factor))("Eval.MajorsMinors.KingTropism")(EvalMM.PieceSqIdx)("")("");
            If (EvalMM.PieceAbs == GoK_OwnBishop)
            {
                EvalMM.PawnCnt = 0;
                EvalMM.BlockedCentral = 0;
                EvalMM.OtherPieceListIdx = 1;
                Repeat (List.Length(EvalPiecesIdx_Pawns))
                {
                    EvalMM.MobilityIdx = (EvalPiecesIdx_Pawns[EvalMM.OtherPieceListIdx] + 0);
                    If ((((Board[EvalMM.MobilityIdx] * EvalMM.Factor) > 0) And ((IdxToFile[EvalMM.MobilityIdx] > 2) And (IdxToFile[EvalMM.MobilityIdx] < 7))) And (Not ((Board[(EvalMM.MobilityIdx + (8 * EvalMM.Factor))] == 0))))
                    {
                        EvalMM.BlockedCentral += 1;
                    }
                    If (((IdxToFile[(EvalMM.MobilityIdx + 0)] + IdxToRank[(EvalMM.MobilityIdx + 0)]) % 2) == ((IdxToFile[(EvalMM.PieceSqIdx + 0)] + IdxToRank[(EvalMM.PieceSqIdx + 0)]) % 2))
                    {
                        If (((EvalMM.Piece > 0) And (Board[(EvalMM.MobilityIdx + 0)] > 0)) Or ((EvalMM.Piece < 0) And (Board[(EvalMM.MobilityIdx + 0)] < 0)))
                        {
                            EvalMM.File = (IdxToFile[(EvalMM.MobilityIdx + 0)] + 0);
                            EvalMM.Rank = (IdxToRank[(EvalMM.MobilityIdx + 0)] + 0);
                            EvalMM.PawnCnt += 1;
                        }
                    }
                    EvalMM.OtherPieceListIdx += 1;
                }
                EvalMM.BishopProtected = 0;
                If (((IdxToFile[EvalMM.PieceSqIdx] > 1) And ((((EvalMM.PieceSqIdx - (8 * EvalMM.Factor)) + -1) > 0) And (((EvalMM.PieceSqIdx - (8 * EvalMM.Factor)) + -1) < 65))) And (Board[((EvalMM.PieceSqIdx - (8 * EvalMM.Factor)) + -1)] == (GoK_OwnPawn * EvalMM.Factor)))
                {
                    EvalMM.BishopProtected = 1;
                }
                If (((IdxToFile[EvalMM.PieceSqIdx] < 8) And ((((EvalMM.PieceSqIdx - (8 * EvalMM.Factor)) + 1) > 0) And (((EvalMM.PieceSqIdx - (8 * EvalMM.Factor)) + 1) < 65))) And (Board[((EvalMM.PieceSqIdx - (8 * EvalMM.Factor)) + 1)] == (GoK_OwnPawn * EvalMM.Factor)))
                {
                    EvalMM.BishopProtected = 1;
                }
                EvalMM.EdgeDist = (IdxToFile[EvalMM.PieceSqIdx] - 1);
                If ((8 - IdxToFile[EvalMM.PieceSqIdx]) < EvalMM.EdgeDist)
                {
                    EvalMM.EdgeDist = (8 - IdxToFile[EvalMM.PieceSqIdx]);
                }
                Call TaperedEval.Add((0 - (BishopPawnsMg[(EvalMM.EdgeDist + 1)] * ((EvalMM.PawnCnt * ((1 - EvalMM.BishopProtected) + EvalMM.BlockedCentral)) * EvalMM.Factor))))((0 - (BishopPawnsEg[(EvalMM.EdgeDist + 1)] * ((EvalMM.PawnCnt * ((1 - EvalMM.BishopProtected) + EvalMM.BlockedCentral)) * EvalMM.Factor))))("Eval.MajorsMinors.Bishop.SameColorPawns")(EvalMM.PieceSqIdx)("")("");
                EvalMM.DiagonalStep = 0;
                EvalMM.CenterSquareCount = 0;
                If ((EvalMM.PieceSqIdx % 9) == 1)
                {
                    If (EvalMM.PieceSqIdx < 28)
                    {
                        EvalMM.DiagonalStep = 9;
                    }
                    If (EvalMM.PieceSqIdx > 37)
                    {
                        EvalMM.DiagonalStep = -9;
                    }
                }
                If (((EvalMM.PieceSqIdx % 7) == 1) And ((EvalMM.PieceSqIdx > 1) And (EvalMM.PieceSqIdx < 64)))
                {
                    If (EvalMM.PieceSqIdx < 29)
                    {
                        EvalMM.DiagonalStep = 7;
                    }
                    If (EvalMM.PieceSqIdx > 36)
                    {
                        EvalMM.DiagonalStep = -7;
                    }
                }
                If (Not ((EvalMM.DiagonalStep == 0)))
                {
                    EvalMM.DiagonalSqIdx = EvalMM.PieceSqIdx;
                    EvalMM.IsWalkOpen = 1;
                    Repeat (7)
                    {
                        If (EvalMM.IsWalkOpen == 1)
                        {
                            If (((EvalMM.DiagonalSqIdx + EvalMM.DiagonalStep) < 1) Or ((EvalMM.DiagonalSqIdx + EvalMM.DiagonalStep) > 64))
                            {
                                EvalMM.IsWalkOpen = 0;
                            }
                            Else
                            {
                                EvalMM.DiagonalSqIdx += EvalMM.DiagonalStep;
                                If (((EvalMM.DiagonalSqIdx == 28) Or (EvalMM.DiagonalSqIdx == 29)) Or ((EvalMM.DiagonalSqIdx == 36) Or (EvalMM.DiagonalSqIdx == 37)))
                                {
                                    EvalMM.CenterSquareCount += 1;
                                }
                                If (abs(Board[EvalMM.DiagonalSqIdx]) == GoK_OwnPawn)
                                {
                                    EvalMM.IsWalkOpen = 0;
                                }
                            }
                        }
                    }
                    If (EvalMM.CenterSquareCount == 2)
                    {
                        Call TaperedEval.Add((22.5 * EvalMM.Factor))(0)("Eval.MajorsMinors.Bishop.AttacksCentralSquares")(EvalMM.PieceSqIdx)("")("");
                    }
                }
                EvalMM.Rank = (IdxToRank[EvalMM.PieceSqIdx] + 0);
                EvalMM.File = (IdxToFile[EvalMM.PieceSqIdx] + 0);
                EvalMM.XRayCount = 0;
