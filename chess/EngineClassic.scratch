                    EvalT.KingDanger += 492;
                }
                Else
                {
                    If (EvalT.BishopChecks == 1)
                    {
                        EvalT.KingDanger += 325;
                    }
                }
            }
            If (EvalT.KnightChecks > 1)
            {
                EvalT.KingDanger += 646;
            }
            Else
            {
                If (EvalT.KnightChecks == 1)
                {
                    EvalT.KingDanger += 402;
                }
            }
            If (EvalT.Side == 1)
            {
                If (Glob.OppQueenCountLocal == 0)
                {
                    EvalT.KingDanger += -410;
                }
                If (1 == 1)
                {
                    EvalT.KingDanger += (0 - EvalT.MobilityEval);
                }
            }
            Else
            {
                If (Glob.OwnQueenCountLocal == 0)
                {
                    EvalT.KingDanger += -410;
                }
                If (1 == 1)
                {
                    EvalT.KingDanger += EvalT.MobilityEval;
                }
            }
            If (Eval.DebugLog == 1)
            {
                Call LogPVEvalLine("Eval.Threats.KingDanger.FlankAttacks.PreScale")(floor(((3 * (EvalT.KingFlankAttacks * EvalT.KingFlankAttacks)) / 16)))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.PawnProtection.PreScale")(Operator.Round((-0.66 * KingPawnProtection[EvalT.Side])))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.AttacksWeightTimesAttackerCount.PreScale")((KingRingAttacksWeight[EvalT.Side] * KingRingAttackersCount[EvalT.Side]))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.AttackCount.PreScale")((32 * KingRingAttacksCount[EvalT.Side]))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.AttacksOnWeakSquareCount .PreScale")((86 * KingRingAttacksOnWeakCount[EvalT.Side]))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.KnightDefenders.PreScale")((-47 * (KingRingAttacksKnightDefenders[EvalT.Side] > 0)))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.BishopDefenders.PreScale")((-18 * KingRingAttacksBishopDefenders[EvalT.Side]))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.UnsafeChecks.PreScale")((74 * KingAttackUnsafeChecks[EvalT.Side]))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.SliderBlockers.PreScale")((49 * KingSliderBlockers[EvalT.Side]))("")("")(EvalT.Side)("");
                Call LogPVEvalLine("Eval.Threats.KingDanger.SafeChecks.MetaData.QRBK")(MoveToZeroPadStr[(KingAttackSafeChecks[EvalT.Side] + 1)])("")("")(EvalT.Side)("");
            }
            If (EvalT.KingDanger > 50)
            {
                Call TaperedEval.Add((0 - Operator.Round(((EvalT.KingDanger * EvalT.KingDanger) / 2048))))((0 - Operator.Round((EvalT.KingDanger / 16))))("Eval.Threats.KingDanger")("")(EvalT.Side)("");
            }
            EvalT.cf = (IdxToFile[EvalT.KingIdx] + 0);
            If (EvalT.cf < 2)
            {
                EvalT.cf = 2;
            }
            If (EvalT.cf > 7)
            {
                EvalT.cf = 7;
            }
            EvalT.rookval = (GoK_OwnRook * (1 - (2 * (EvalT.Side == 1))));
            EvalT.count = 0;
            EvalT.pi = 1;
            Repeat (List.Length(EvalPiecesIdx_NonPawns))
            {
                EvalT.ridx = (EvalPiecesIdx_NonPawns[EvalT.pi] + 0);
                If (Board[EvalT.ridx] == EvalT.rookval)
                {
                    If (abs((IdxToFile[EvalT.ridx] - EvalT.cf)) < 2)
                    {
                        EvalT.direct = 0;
                        EvalT.ri = 1;
                        Repeat (9)
                        {
                            EvalT.rs = (KingRings[(((EvalT.KingIdx - 1) * 10) + EvalT.ri)] + 0);
                            If (Not ((EvalT.rs == -1)))
                            {
                                EvalT.sh = (((EvalT.Side == 1) * BoardAttackerType[((192 + EvalT.rs) + 384)]) + ((EvalT.Side == 2) * BoardAttackerType[(192 + EvalT.rs)]));
                                If ((EvalT.sh == EvalT.ridx) Or ((EvalT.sh > 0) And (IdxToFile[EvalT.sh] == IdxToFile[EvalT.ridx])))
                                {
                                    EvalT.direct = 1;
                                }
                            }
                            EvalT.ri += 1;
                        }
                        If (EvalT.direct == 0)
                        {
                            EvalT.count += 1;
                        }
                    }
                }
                EvalT.pi += 1;
            }
            Call TaperedEval.Add((-8 * EvalT.count))(0)("Eval.Threats.RookOnKingRing")("")(EvalT.Side)("");
            Call TaperedEval.Add((-4 * EvalT.KingFlankAttacks))(0)("Eval.Threats.KingFlankAttacks")("")(EvalT.Side)("");
