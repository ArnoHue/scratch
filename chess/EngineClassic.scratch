Define AddBoardToHistory(string WasEngineMove) (warp=true)
{
    Call GetBoardString;
    List.Add(BoardHistory, Ret.GetBoardString.BoardString);
    Call CreateCurrentBoardHash;
    List.Add(BoardHistoryHash, Glob.Board.CurrentHash);
    If ((Glob.Board.HasOwnCastled == 1) Or ((Glob.Board.HasOwnKingMoved == 1) Or ((Glob.Board.HasOwnRookKSMoved == 1) And (Glob.Board.HasOwnRookQSMoved == 1))))
    {
        Glob.Board.HasOwnCastled = 1;
        Glob.Board.HasOwnKingMoved = 1;
        Glob.Board.HasOwnRookKSMoved = 1;
        Glob.Board.HasOwnRookQSMoved = 1;
    }
    If ((Glob.Board.HasOppCastled == 1) Or ((Glob.Board.HasOppKingMoved == 1) Or ((Glob.Board.HasOppRookKSMoved == 1) And (Glob.Board.HasOppRookQSMoved == 1))))
    {
        Glob.Board.HasOppCastled = 1;
        Glob.Board.HasOppKingMoved = 1;
        Glob.Board.HasOppRookKSMoved = 1;
        Glob.Board.HasOppRookQSMoved = 1;
    }
    List.Add(BoardHistoryMetaState, ((((Glob.Board.HasOwnCastled * CastlingStatePow2[1]) + (Glob.Board.HasOwnKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasOwnRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasOwnRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasOppCastled * CastlingStatePow2[5]) + (Glob.Board.HasOppKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasOppRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasOppRookQSMoved * CastlingStatePow2[8])))));
    List.Add(BoardHistoryWasEngineMove, WasEngineMove);
}

Define AddLookupMove(string SourceIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool LookupMoveTypeKing)(bool QuietsOnly)(bool QuietChecks)(bool WithMobility) (warp=true)
{
    AddLookupMove.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddLookupMove.Idx = (MoveLookupIndexOffset[(SourceIdx + 0)] + 0);
    AddLookupMove.Count = 1;
    Repeat (8)
    {
        If LookupMoveTypeKing
        {
            AddLookupMove.TargetIdx = (MoveLookupKing[(AddLookupMove.Idx + AddLookupMove.Count)] + 0);
        }
        Else
        {
            AddLookupMove.TargetIdx = (MoveLookupKnight[(AddLookupMove.Idx + AddLookupMove.Count)] + 0);
        }
        If (AddLookupMove.TargetIdx == -1)
        {
            Stop(this script);
        }
        If CalcAttackState
        {
            Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing)(WithMobility);
        }
        Else
        {
            If (Board[(AddLookupMove.TargetIdx + 0)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQMove(SourceIdx)(AddLookupMove.TargetIdx)(AddLookupMove.SourcePiece)(Ply)(QuietChecks);
                }
                Else
                {
                    Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing)(WithMobility);
                }
            }
            Else
            {
                If (Not (QuietsOnly))
                {
                    If (AddLookupMove.SourcePiece > 0)
                    {
                        If (Board[(AddLookupMove.TargetIdx + 0)] < 0)
                        {
                            Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing)(WithMobility);
                        }
                    }
                    Else
                    {
                        If (Board[(AddLookupMove.TargetIdx + 0)] > 0)
                        {
                            Call AddMoveImplLookup(SourceIdx)(AddLookupMove.TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(LookupMoveTypeKing)(WithMobility);
                        }
                    }
                }
            }
        }
        AddLookupMove.Count += 1;
    }
}

Define AddMoveImpl(string SourceIdx)(string TargetIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool WithMobility)(bool IsXRay) (warp=true)
{
    If CalcAttackState
    {
        AddMoveImpl.PinAllowed = 1;
        If ((Not (((PinnedSquareDirection[SourceIdx] + 0) == 0))) And (Not ((abs(Board[SourceIdx]) == (GoK_OwnPawn + 0)))))
        {
            AddMoveImpl.PinAllowed = 0;
            If (((IdxToFile[TargetIdx] - IdxToFile[SourceIdx]) * RayRankDelta[PinnedSquareDirection[SourceIdx]]) == ((IdxToRank[TargetIdx] - IdxToRank[SourceIdx]) * RayFileDelta[PinnedSquareDirection[SourceIdx]]))
            {
                AddMoveImpl.PinAllowed = 1;
            }
        }
        If (AddMoveImpl.PinAllowed == 1)
        {
            AddMoveImpl.SourcePiece = (Board[(SourceIdx + 0)] + 0);
            AddMoveImpl.TargetPiece = (Board[(TargetIdx + 0)] + 0);
            AddMoveImpl.KingPathClear = 1;
            If (abs(AddMoveImpl.TargetPiece) == (GoK_OwnKing + 0))
            {
                AddMoveImpl.FileDelta = (IdxToFile[TargetIdx] - IdxToFile[SourceIdx]);
                AddMoveImpl.RankDelta = (IdxToRank[TargetIdx] - IdxToRank[SourceIdx]);
                If (((AddMoveImpl.FileDelta == 0) Or (AddMoveImpl.RankDelta == 0)) Or (abs(AddMoveImpl.FileDelta) == abs(AddMoveImpl.RankDelta)))
                {
                    AddMoveImpl.PathStep = (((AddMoveImpl.FileDelta > 0) - (AddMoveImpl.FileDelta < 0)) + (8 * ((AddMoveImpl.RankDelta > 0) - (AddMoveImpl.RankDelta < 0))));
                    AddMoveImpl.PathIdx = ((SourceIdx + 0) + AddMoveImpl.PathStep);
                    Repeat (((((abs(AddMoveImpl.FileDelta) + abs(AddMoveImpl.RankDelta)) + abs((abs(AddMoveImpl.FileDelta) - abs(AddMoveImpl.RankDelta)))) / 2) - 1))
                    {
                        If (Not (((Board[AddMoveImpl.PathIdx] + 0) == 0)))
                        {
                            AddMoveImpl.KingPathClear = 0;
                        }
                        AddMoveImpl.PathIdx += AddMoveImpl.PathStep;
                    }
                }
            }
            If WithMobility
            {
                AddMoveImpl.PieceMobilityPrepIdx = (((SourceIdx - 1) * 32) + 1);
                AddMoveImpl.Count = (PieceMobilityPrep[AddMoveImpl.PieceMobilityPrepIdx] + 1);
                List.ReplaceItem(PieceMobilityPrep, AddMoveImpl.PieceMobilityPrepIdx, AddMoveImpl.Count);
                List.ReplaceItem(PieceMobilityPrep, (AddMoveImpl.PieceMobilityPrepIdx + AddMoveImpl.Count), TargetIdx);
            }
            AddMoveImpl.AttackMask = 0;
            AddMoveImpl.PieceAbs = abs(AddMoveImpl.SourcePiece);
            AddMoveImpl.PieceIdx = (PieceIdxLookup[AddMoveImpl.PieceAbs] + 0);
            If ((AddMoveImpl.PieceAbs > 0) And ((AddMoveImpl.PieceAbs + 0) < (GoK_OwnKing + 0)))
            {
                AddMoveImpl.AttackMask = (AttackTypeMaskWeights[AddMoveImpl.PieceIdx] + 0);
            }
            If (AddMoveImpl.SourcePiece > 0)
            {
                AddMoveImpl.Attacked = (BoardAttacked[(TargetIdx + 0)] + 0);
                If (AddMoveImpl.Attacked == 0)
                {
                    List.Add(AttackDirtySq1, (TargetIdx + 0));
                }
                If (Not (IsXRay))
                {
                    If (((AddMoveImpl.Attacked - BoardAttackedXRay[(TargetIdx + 0)]) == 0) Or ((Board[BoardAttackedPiece[(TargetIdx + 0)]] + 0) > (AddMoveImpl.SourcePiece + 0)))
                    {
                        List.ReplaceItem(BoardAttackedPiece, (TargetIdx + 0), SourceIdx);
                    }
                }
                Else
                {
                    If (AddMoveImpl.Attacked == 0)
                    {
                        List.ReplaceItem(BoardAttackedPiece, (TargetIdx + 0), SourceIdx);
                    }
                }
                If ((BoardAttackerType[(((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx)] + 0) == 0)
                {
                    List.ReplaceItem(BoardAttackerType, (((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx), SourceIdx);
                    List.Add(AttackDirtyType1, (((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx));
                }
                Else
                {
                    If ((BoardAttackerType2[(((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx)] + 0) == 0)
                    {
                        List.ReplaceItem(BoardAttackerType2, (((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx), SourceIdx);
                    }
                }
                If (AddMoveImpl.Attacked < 9)
                {
                    List.ReplaceItem(BoardAttacked, (TargetIdx + 0), (AddMoveImpl.Attacked + 1));
                    If IsXRay
                    {
                        List.ReplaceItem(BoardAttackedXRay, (TargetIdx + 0), (BoardAttackedXRay[(TargetIdx + 0)] + 1));
                    }
                }
                If (AddMoveImpl.AttackMask > 0)
                {
                    List.ReplaceItem(BoardAttackedTypeMask, (TargetIdx + 0), (BoardAttackedTypeMask[(TargetIdx + 0)] + AddMoveImpl.AttackMask));
                }
                If (((AddMoveImpl.TargetPiece + 0) == (GoK_OppKing + 0)) And (AddMoveImpl.KingPathClear == 1))
                {
                    Glob.Board.IsOppSideChecked = 1;
                }
            }
            Else
            {
                If (AddMoveImpl.SourcePiece < 0)
                {
                    AddMoveImpl.Attacked = (BoardAttacked[(TargetIdx + 64)] + 0);
                    If (AddMoveImpl.Attacked == 0)
                    {
                        List.Add(AttackDirtySq2, (TargetIdx + 64));
                    }
                    If (Not (IsXRay))
                    {
                        If (((AddMoveImpl.Attacked - BoardAttackedXRay[(TargetIdx + 64)]) == 0) Or ((Board[BoardAttackedPiece[(TargetIdx + 64)]] + 0) < (AddMoveImpl.SourcePiece + 0)))
                        {
                            List.ReplaceItem(BoardAttackedPiece, (TargetIdx + 64), SourceIdx);
                        }
                    }
                    Else
                    {
                        If (AddMoveImpl.Attacked == 0)
                        {
                            List.ReplaceItem(BoardAttackedPiece, (TargetIdx + 64), SourceIdx);
                        }
                    }
                    If ((BoardAttackerType[((((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx) + 384)] + 0) == 0)
                    {
                        List.ReplaceItem(BoardAttackerType, ((((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx) + 384), SourceIdx);
                        List.Add(AttackDirtyType2, ((((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx) + 384));
                    }
                    Else
                    {
                        If ((BoardAttackerType2[((((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx) + 384)] + 0) == 0)
                        {
                            List.ReplaceItem(BoardAttackerType2, ((((AddMoveImpl.PieceIdx - 1) * 64) + TargetIdx) + 384), SourceIdx);
                        }
                    }
                    If (AddMoveImpl.Attacked < 9)
                    {
                        List.ReplaceItem(BoardAttacked, (TargetIdx + 64), (AddMoveImpl.Attacked + 1));
                        If IsXRay
                        {
                            List.ReplaceItem(BoardAttackedXRay, (TargetIdx + 64), (BoardAttackedXRay[(TargetIdx + 64)] + 1));
                        }
                    }
                    If (AddMoveImpl.AttackMask > 0)
                    {
                        List.ReplaceItem(BoardAttackedTypeMask, (TargetIdx + 64), (BoardAttackedTypeMask[(TargetIdx + 64)] + AddMoveImpl.AttackMask));
                    }
                    If (((AddMoveImpl.TargetPiece + 0) == (GoK_OwnKing + 0)) And (AddMoveImpl.KingPathClear == 1))
                    {
                        Glob.Board.IsOwnSideChecked = 1;
                    }
                }
            }
        }
        Stop(this script);
    }
    If ((CheckedState[Ply] + 0) == 1)
    {
        If (Not (((BoardAttackedEvasionTarget[(TargetIdx + 0)] + 0) == 1)))
        {
            If (Not ((abs(Board[(SourceIdx + 0)]) == (GoK_OwnKing + 0))))
            {
                If ((EnPassantTarget[Ply] + 0) == (Const.Null + 0))
                {
                    Stop(this script);
                }
            }
        }
    }
    AddMoveImpl.Move = ((SourceIdx * 100) + TargetIdx);
    If (abs(Board[(SourceIdx + 0)]) == (GoK_OwnPawn + 0))
    {
        If (((IdxToRank[(TargetIdx + 0)] + 0) == 1) Or ((IdxToRank[(TargetIdx + 0)] + 0) == 8))
        {
            Call AddSpecialMove((AddMoveImpl.Move + 0.1))(Ply);
            If (Not (CapturesOnly))
            {
                Call AddSpecialMove((AddMoveImpl.Move + 0.2))(Ply);
                Call AddSpecialMove((AddMoveImpl.Move + 0.3))(Ply);
                Call AddSpecialMove((AddMoveImpl.Move + 0.4))(Ply);
            }
            Stop(this script);
        }
    }
    List.Add(CalcMovesMoveList, AddMoveImpl.Move);
    Call GetMoveScore(Board[(SourceIdx + 0)])(Board[(TargetIdx + 0)])(SourceIdx)(TargetIdx)(AddMoveImpl.Move)(Ply);
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddMoveImplLookup(string SourceIdx)(string TargetIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool IsKing)(bool WithMobility) (warp=true)
{
    If IsKing
    {
        If (Not (CalcAttackState))
        {
            If (PlyIsOwn[Ply] == 1)
            {
                AddMoveImplLookup.KingIdx = Glob.Board.OppKingIdx;
            }
            Else
            {
                AddMoveImplLookup.KingIdx = Glob.Board.OwnKingIdx;
            }
            If (ChebyshevDistance[((AddMoveImplLookup.KingIdx * 100) + TargetIdx)] < 2)
            {
                Stop(this script);
            }
        }
    }
    Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)(CalcAttackState)(CapturesOnly)(WithMobility)((1 == 0));
}

Define AddMoveToList(string Move)(string Ply)(string MoveScore) (warp=true)
{
    List.ReplaceItem(Moves, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), Move);
    List.ReplaceItem(MovesScore, (((Ply - 1) * Const.MaxMovesPerGeneration) + (MovesCount[Ply] + 1)), MoveScore);
    List.ReplaceItem(MovesCount, Ply, (MovesCount[Ply] + 1));
    If (Ply == 1)
    {
        List.Add(Moves1, Move);
    }
    Else
    {
        If (Ply == 2)
        {
            List.Add(Moves2, Move);
        }
    }
}

Define AddPotentialQMove(string SourceIdx)(string TargetIdx)(string Piece)(string Ply)(bool QuietChecks) (warp=true)
{
    Call //("Include move in quiescence search if it's a check or check evasion");
    If (CheckedState[Ply] == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1))((1 == 0))((1 == 0));
        Stop(this script);
    }
    If (Piece == GoK_OwnPawn)
    {
        If (IdxToRank[TargetIdx] == 8)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1))((1 == 0))((1 == 0));
            Stop(this script);
        }
    }
    If (Piece == GoK_OppPawn)
    {
        If (IdxToRank[TargetIdx] == 1)
        {
            Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1))((1 == 0))((1 == 0));
            Stop(this script);
        }
    }
    If (Not (QuietChecks))
    {
        Stop(this script);
    }
    AddPotentialQMove.IsDiscovery = 0;
    AddPotentialQMove.DiscoveryIdx = 1;
    Repeat (DiscoveryCount[Ply])
    {
        If ((DiscoverySq[(((Ply - 1) * Const.CheckInfoPlyStride) + AddPotentialQMove.DiscoveryIdx)] == SourceIdx) And (Not ((abs(MovePathStepInc[((SourceIdx * 100) + TargetIdx)]) == DiscoveryRay[(((Ply - 1) * Const.CheckInfoPlyStride) + AddPotentialQMove.DiscoveryIdx)]))))
        {
            AddPotentialQMove.IsDiscovery = 1;
        }
        AddPotentialQMove.DiscoveryIdx += 1;
    }
    If (AddPotentialQMove.IsDiscovery == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1))((1 == 0))((1 == 0));
        Stop(this script);
    }
    If (abs(Piece) == GoK_OwnKing)
    {
        Stop(this script);
    }
    If (Piece > 0)
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.Board.OppKingIdx);
    }
    Else
    {
        Call IsReachableForAttack(Piece)(TargetIdx)(Glob.Board.OwnKingIdx);
    }
    If (Ret.IsReachableForAttack.IsReachable == 1)
    {
        Call AddMoveImpl(SourceIdx)(TargetIdx)(Ply)((1 == 0))((1 == 1))((1 == 0))((1 == 0));
    }
}

Define AddSlidingMove(string SourceIdx)(string Ply)(bool CalcAttackState)(bool CapturesOnly)(bool SlidingStraight)(bool QuietsOnly)(bool QuietChecks)(bool WithMobility) (warp=true)
{
    If CalcAttackState
    {
        Call AddSlidingMoveForAT(SourceIdx)(Ply)(SlidingStraight)(WithMobility);
    }
    Else
    {
        Call AddSlidingMoveRays(SourceIdx)(Ply)(CapturesOnly)(SlidingStraight)(QuietsOnly)(QuietChecks);
    }
}

Define AddSlidingMoveForAT(string SourceIdx)(string Ply)(bool SlidingStraight)(bool WithMobility) (warp=true)
{
    AddSlidingMoveForAT.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddSlidingMoveForAT.BehindXRay = 0;
    AddSlidingMoveForAT.RayOffset = (MoveLookupLineIndexOffset[(SourceIdx + 0)] + 0);
    AddSlidingMoveForAT.RaySlot = 1;
    AddSlidingMoveForAT.RaySqLeft = 8;
    Repeat Until (AddSlidingMoveForAT.RaySlot > 32)
    {
        If SlidingStraight
        {
            AddSlidingMoveForAT.TargetIdx = (MoveLookupStraight[(AddSlidingMoveForAT.RayOffset + AddSlidingMoveForAT.RaySlot)] + 0);
        }
        Else
        {
            AddSlidingMoveForAT.TargetIdx = (MoveLookupCross[(AddSlidingMoveForAT.RayOffset + AddSlidingMoveForAT.RaySlot)] + 0);
        }
        If (AddSlidingMoveForAT.TargetIdx == -1)
        {
            AddSlidingMoveForAT.RaySlot += AddSlidingMoveForAT.RaySqLeft;
            AddSlidingMoveForAT.RaySqLeft = 8;
            AddSlidingMoveForAT.BehindXRay = 0;
        }
        Else
        {
            Call AddMoveImpl(SourceIdx)(AddSlidingMoveForAT.TargetIdx)(Ply)((1 == 1))((1 == 0))(WithMobility)((AddSlidingMoveForAT.BehindXRay == 1));
            AddSlidingMoveForAT.TargetPiece = (Board[(AddSlidingMoveForAT.TargetIdx + 0)] + 0);
            If (AddSlidingMoveForAT.TargetPiece == 0)
            {
                AddSlidingMoveForAT.RaySlot += 1;
                AddSlidingMoveForAT.RaySqLeft += -1;
            }
            Else
            {
                AddSlidingMoveForAT.IsXRay = 0;
                AddSlidingMoveForAT.TargetPieceAbs = abs(AddSlidingMoveForAT.TargetPiece);
                If (Not (((AddSlidingMoveForAT.TargetPieceAbs + 0) == (GoK_OwnKing + 0))))
                {
                    If ((AddSlidingMoveForAT.TargetPieceAbs + 0) > (GoK_OwnKnight + 0))
                    {
                        If (Not ((((AddSlidingMoveForAT.SourcePiece + 0) == (GoK_OwnQueen + 0)) Or ((AddSlidingMoveForAT.SourcePiece + 0) == (GoK_OppQueen + 0)))))
                        {
                            If SlidingStraight
                            {
                                If (((AddSlidingMoveForAT.TargetPieceAbs + 0) == (GoK_OwnQueen + 0)) Or ((((AddSlidingMoveForAT.SourcePiece > 0) And (AddSlidingMoveForAT.TargetPiece > 0)) Or ((AddSlidingMoveForAT.SourcePiece < 0) And (AddSlidingMoveForAT.TargetPiece < 0))) And ((AddSlidingMoveForAT.TargetPieceAbs + 0) == (GoK_OwnRook + 0))))
                                {
                                    AddSlidingMoveForAT.IsXRay = 1;
                                }
                            }
                            Else
                            {
                                If ((AddSlidingMoveForAT.TargetPieceAbs + 0) == (GoK_OwnQueen + 0))
                                {
                                    AddSlidingMoveForAT.IsXRay = 1;
                                }
                            }
                        }
                    }
                }
                If (AddSlidingMoveForAT.IsXRay == 1)
                {
                    AddSlidingMoveForAT.RaySlot += 1;
                    AddSlidingMoveForAT.RaySqLeft += -1;
                    AddSlidingMoveForAT.BehindXRay = 1;
                }
                Else
                {
                    AddSlidingMoveForAT.RaySlot += AddSlidingMoveForAT.RaySqLeft;
                    AddSlidingMoveForAT.RaySqLeft = 8;
                    AddSlidingMoveForAT.BehindXRay = 0;
                }
            }
        }
    }
}

Define AddSlidingMoveRays(string SourceIdx)(string Ply)(bool CapturesOnly)(bool SlidingStraight)(bool QuietsOnly)(bool QuietChecks) (warp=true)
{
    AddSlidingMoveRays.SourcePiece = (Board[(SourceIdx + 0)] + 0);
    AddSlidingMoveRays.RayOffset = (MoveLookupLineIndexOffset[(SourceIdx + 0)] + 0);
    AddSlidingMoveRays.RaySlot = 1;
    AddSlidingMoveRays.RaySqLeft = 8;
    Repeat Until (AddSlidingMoveRays.RaySlot > 32)
    {
        If SlidingStraight
        {
            AddSlidingMoveRays.TargetIdx = (MoveLookupStraight[(AddSlidingMoveRays.RayOffset + AddSlidingMoveRays.RaySlot)] + 0);
        }
        Else
        {
            AddSlidingMoveRays.TargetIdx = (MoveLookupCross[(AddSlidingMoveRays.RayOffset + AddSlidingMoveRays.RaySlot)] + 0);
        }
        If (AddSlidingMoveRays.TargetIdx == -1)
        {
            AddSlidingMoveRays.RaySlot += AddSlidingMoveRays.RaySqLeft;
            AddSlidingMoveRays.RaySqLeft = 8;
        }
        Else
        {
            If (Board[(AddSlidingMoveRays.TargetIdx + 0)] == 0)
            {
                If CapturesOnly
                {
                    Call AddPotentialQMove(SourceIdx)(AddSlidingMoveRays.TargetIdx)(AddSlidingMoveRays.SourcePiece)(Ply)(QuietChecks);
                }
                Else
                {
                    Call AddMoveImpl(SourceIdx)(AddSlidingMoveRays.TargetIdx)(Ply)((1 == 0))(CapturesOnly)((1 == 0))((1 == 0));
                }
                AddSlidingMoveRays.RaySlot += 1;
                AddSlidingMoveRays.RaySqLeft += -1;
            }
            Else
            {
                If (Not (QuietsOnly))
                {
                    If (AddSlidingMoveRays.SourcePiece > 0)
                    {
                        If (Board[(AddSlidingMoveRays.TargetIdx + 0)] < 0)
                        {
                            Call AddMoveImpl(SourceIdx)(AddSlidingMoveRays.TargetIdx)(Ply)((1 == 0))(CapturesOnly)((1 == 0))((1 == 0));
                        }
                    }
                    Else
                    {
                        If (Board[(AddSlidingMoveRays.TargetIdx + 0)] > 0)
                        {
                            Call AddMoveImpl(SourceIdx)(AddSlidingMoveRays.TargetIdx)(Ply)((1 == 0))(CapturesOnly)((1 == 0))((1 == 0));
                        }
                    }
                }
                AddSlidingMoveRays.RaySlot += AddSlidingMoveRays.RaySqLeft;
                AddSlidingMoveRays.RaySqLeft = 8;
            }
        }
    }
}

Define AddSpecialMove(string Move)(string Ply) (warp=true)
{
    List.Add(CalcMovesMoveList, Move);
    AddSpecialMove.SourcePiece = Const.Null;
    If (Not ((Move == floor(Move))))
    {
        AddSpecialMove.SourcePiece = GoK_OwnPawn;
    }
    If (floor((Move / 100)) == 0)
    {
        AddSpecialMove.SourcePiece = GoK_OwnKing;
    }
    AddSpecialMove.CastleFrom = floor((Move / 100));
    AddSpecialMove.CastleTo = floor((Move % 100));
    If (floor((Move / 100)) == 0)
    {
        If ((Move == 65) Or (Move == 66))
        {
            AddSpecialMove.CastleFrom = 5;
        }
        Else
        {
            AddSpecialMove.CastleFrom = 61;
        }
        If (Move == 65)
        {
            AddSpecialMove.CastleTo = 8;
        }
        Else
        {
            If (Move == 66)
            {
                AddSpecialMove.CastleTo = 1;
            }
            Else
            {
                If (Move == 67)
                {
                    AddSpecialMove.CastleTo = 64;
                }
                Else
                {
                    AddSpecialMove.CastleTo = 57;
                }
            }
        }
    }
    If (PlyIsOwn[Ply] == 1)
    {
        Call GetMoveScore(AddSpecialMove.SourcePiece)(0)(AddSpecialMove.CastleFrom)(AddSpecialMove.CastleTo)(Move)(Ply);
    }
    Else
    {
        Call GetMoveScore((0 - AddSpecialMove.SourcePiece))(0)(AddSpecialMove.CastleFrom)(AddSpecialMove.CastleTo)(Move)(Ply);
    }
    List.Add(CalcMovesScoreList, Ret.GetMoveScore.Score);
}

Define AddTestCase(string FEN)(string AN1)(string AN2)(string AN3)(string AN4)(string AN5) (warp=true)
{
    List.Add(TestSuiteFEN, FEN);
    List.Add(TestSuiteAN, AN1);
    List.Add(TestSuiteAN, AN2);
    List.Add(TestSuiteAN, AN3);
    List.Add(TestSuiteAN, AN4);
    List.Add(TestSuiteAN, AN5);
}

Define AddToFiftyMoves(bool IsCaptureOrPawnMove) (warp=true)
{
    If IsCaptureOrPawnMove
    {
        List.Add(BoardHistoryFiftyMoves, 0);
    }
    Else
    {
        If (List.Length(BoardHistoryFiftyMoves) == 0)
        {
            List.Add(BoardHistoryFiftyMoves, 0);
        }
        List.Add(BoardHistoryFiftyMoves, (BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)] + 1));
    }
}

Define AdjustEvalScore(string Ply)(string RawEval) (warp=true)
{
    If (RawEval == Const.Null)
    {
        List.ReplaceItem(StaticEval, Ply, Const.Null);
    }
    Else
    {
        AdjustEvalScore.KW = 0;
        If (RawEval > 4000)
        {
            AdjustEvalScore.KW = 5000;
        }
        If (RawEval < -4000)
        {
            AdjustEvalScore.KW = -5000;
        }
        AdjustEvalScore.Damped = ((((RawEval - AdjustEvalScore.KW) * (195 - BoardHistoryFiftyMoves[List.Length(BoardHistoryFiftyMoves)])) / 211) + AdjustEvalScore.KW);
        List.ReplaceItem(StaticEval, Ply, ((((AdjustEvalScore.Damped > 0) - (AdjustEvalScore.Damped < 0)) * floor(abs(AdjustEvalScore.Damped))) * PlySign[Ply]));
        Call GetCorrHistIndices(Ply);
        AdjustEvalScore.CorrSum = 0;
        If (CorrHistKey[Ret.GetCorrHistIndices.CorrIdx] == (floor((Ret.GetCorrHistIndices.PawnKey / 100000)) % 1073741824))
        {
            AdjustEvalScore.CorrSum += (53 * CorrHistVal[Ret.GetCorrHistIndices.CorrIdx]);
        }
        If (CorrHistNonPawnOwnKey[Ret.GetCorrHistIndices.NonPawnOwnIdx] == (floor((Ret.GetCorrHistIndices.NonPawnOwnKey / 100000)) % 1073741824))
        {
            AdjustEvalScore.CorrSum += (65 * CorrHistNonPawnOwn[Ret.GetCorrHistIndices.NonPawnOwnIdx]);
        }
        If (CorrHistNonPawnOppKey[Ret.GetCorrHistIndices.NonPawnOppIdx] == (floor((Ret.GetCorrHistIndices.NonPawnOppKey / 100000)) % 1073741824))
        {
            AdjustEvalScore.CorrSum += (65 * CorrHistNonPawnOpp[Ret.GetCorrHistIndices.NonPawnOppIdx]);
        }
        If (Not ((Ret.GetCorrHistIndices.ContIdx2 == Const.Null)))
        {
            AdjustEvalScore.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx2]);
        }
        If (Not ((Ret.GetCorrHistIndices.ContIdx4 == Const.Null)))
        {
            AdjustEvalScore.CorrSum += (76 * CorrHistCont[Ret.GetCorrHistIndices.ContIdx4]);
        }
        List.ReplaceItem(StaticEval, Ply, (StaticEval[Ply] + Operator.Round((AdjustEvalScore.CorrSum / 512))));
    }
}

Define ApplyMove(num Ply) (warp=true)
{
    Call TaperedEval.Init;
    List.ReplaceItem(SourcePieces, Ply, 0);
    List.ReplaceItem(TargetPiecesIdx, Ply, 0);
    List.ReplaceItem(TargetPieces, Ply, 0);
    List.ReplaceItem(PromotionPieces, Ply, 0);
    If (Ply == 1)
    {
        List.ReplaceItem(CastlingState, Ply, ((((Glob.Board.HasOwnCastled * CastlingStatePow2[1]) + (Glob.Board.HasOwnKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasOwnRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasOwnRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasOppCastled * CastlingStatePow2[5]) + (Glob.Board.HasOppKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasOppRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasOppRookQSMoved * CastlingStatePow2[8])))));
    }
    Else
    {
        List.ReplaceItem(CastlingState, Ply, CastlingState[(Ply - 1)]);
    }
    If (Ply == 1)
    {
        Glob.Board.RootEnPassantTarget = EnPassantTarget[1];
    }
    List.ReplaceItem(EnPassantTarget, Ply, Const.Null);
    List.ReplaceItem(PutsInCheck, Ply, 0);
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.Board.CurrentHash);
    List.ReplaceItem(PreviousBoardHash2, Ply, Glob.Board.KPHash);
    List.ReplaceItem(PreviousNonPawnHashOwn, Ply, Glob.Board.NonPawnHashOwn);
    List.ReplaceItem(PreviousNonPawnHashOpp, Ply, Glob.Board.NonPawnHashOpp);
    Call GetCurrentMove(Ply);
    ApplyMove.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, ApplyMove.Move);
    Call AddToFiftyMoves((((Not ((ApplyMove.Move == 0))) And (Not ((floor((ApplyMove.Move / 100)) == 0)))) And ((abs(Board[floor((ApplyMove.Move / 100))]) == GoK_OwnPawn) Or (Not ((Board[floor((ApplyMove.Move % 100))] == 0))))));
    ApplyMove.SourceIdx = floor((ApplyMove.Move / 100));
    If (ApplyMove.SourceIdx > 0)
    {
        ApplyMove.TargetIdx = floor((ApplyMove.Move % 100));
        ApplyMove.SourcePiece = (Board[(ApplyMove.SourceIdx + 0)] + 0);
        ApplyMove.TargetPiece = (Board[(ApplyMove.TargetIdx + 0)] + 0);
        List.ReplaceItem(SourcePieces, Ply, ApplyMove.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMove.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, ApplyMove.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, (ApplyMove.TargetIdx + 0), ApplyMove.SourcePiece);
        List.ReplaceItem(Board, (ApplyMove.SourceIdx + 0), 0);
        ApplyMove.Factor = (((ApplyMove.SourcePiece > 0) * 2) - 1);
        ApplyMove.MoveKey = (((PieceIdxLookup[abs(ApplyMove.SourcePiece)] * 10000) + ((ApplyMove.SourceIdx * 100) + ApplyMove.TargetIdx)) + ((ApplyMove.SourcePiece > 0) * 60000));
        Glob.Board.CurrentHash += MoveHashLookup[ApplyMove.MoveKey];
        If (Not ((abs(ApplyMove.SourcePiece) == GoK_OwnPawn)))
        {
            If (ApplyMove.SourcePiece > 0)
            {
                Glob.Board.NonPawnHashOwn += MoveHashLookup[ApplyMove.MoveKey];
            }
            Else
            {
                Glob.Board.NonPawnHashOpp += MoveHashLookup[ApplyMove.MoveKey];
            }
        }
        If (abs(ApplyMove.SourcePiece) == GoK_OwnPawn)
        {
            Glob.Board.KPHash += MoveHashLookup[ApplyMove.MoveKey];
            If (Not ((IdxToFile[(ApplyMove.SourceIdx + 0)] == IdxToFile[(ApplyMove.TargetIdx + 0)])))
            {
                If (TargetPieces[Ply] == 0)
                {
                    ApplyMove.SqIdx = (ApplyMove.TargetIdx - (8 * ApplyMove.Factor));
                    List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMove.SqIdx);
                    List.ReplaceItem(TargetPieces, Ply, Board[ApplyMove.SqIdx]);
                    ApplyMove.TargetPiece = (Board[ApplyMove.SqIdx] + 0);
                    List.ReplaceItem(Board, ApplyMove.SqIdx, 0);
                }
            }
            If (((ApplyMove.TargetIdx - ApplyMove.SourceIdx) == (16 * ApplyMove.Factor)) And (((IdxToFile[ApplyMove.TargetIdx] > 1) And (Board[(ApplyMove.TargetIdx - 1)] == (GoK_OppPawn * ApplyMove.Factor))) Or ((IdxToFile[ApplyMove.TargetIdx] < 8) And (Board[(ApplyMove.TargetIdx + 1)] == (GoK_OppPawn * ApplyMove.Factor)))))
            {
                List.ReplaceItem(EnPassantTarget, Ply, ApplyMove.TargetIdx);
            }
            If ((ApplyMove.TargetIdx > 56) Or (ApplyMove.TargetIdx < 9))
            {
                ApplyMove.PromotionCode = (Operator.LetterOf(ApplyMove.Move, Variable.Length(ApplyMove.Move)) + 0);
                If (ApplyMove.Factor == 1)
                {
                    If (ApplyMove.PromotionCode == 1)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnQueen);
                        Glob.Board.OwnQueenCount += 1;
                    }
                    If (ApplyMove.PromotionCode == 2)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnRook);
                        Glob.Board.OwnRookCount += 1;
                        Glob.Board.OwnNonQueenMajorMinorCount += 1;
                    }
                    If (ApplyMove.PromotionCode == 3)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnBishop);
                        Glob.Board.OwnBishopCount += 1;
                        Glob.Board.OwnNonQueenMajorMinorCount += 1;
                    }
                    If (ApplyMove.PromotionCode == 4)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OwnKnight);
                        Glob.Board.OwnNonQueenMajorMinorCount += 1;
                    }
                    Glob.Board.OwnPawnCount += -1;
                }
                Else
                {
                    If (ApplyMove.PromotionCode == 1)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppQueen);
                        Glob.Board.OppQueenCount += 1;
                    }
                    If (ApplyMove.PromotionCode == 2)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppRook);
                        Glob.Board.OppRookCount += 1;
                        Glob.Board.OppNonQueenMajorMinorCount += 1;
                    }
                    If (ApplyMove.PromotionCode == 3)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppBishop);
                        Glob.Board.OppBishopCount += 1;
                        Glob.Board.OppNonQueenMajorMinorCount += 1;
                    }
                    If (ApplyMove.PromotionCode == 4)
                    {
                        List.ReplaceItem(PromotionPieces, Ply, GoK_OppKnight);
                        Glob.Board.OppNonQueenMajorMinorCount += 1;
                    }
                    Glob.Board.OppPawnCount += -1;
                }
                Call GetPiecePosHash(ApplyMove.SourcePiece)(ApplyMove.TargetIdx);
                Glob.Board.CurrentHash = (Glob.Board.CurrentHash - Ret.GetPiecePosHash.Hash);
                If (Not ((abs(ApplyMove.SourcePiece) == GoK_OwnPawn)))
                {
                    If (ApplyMove.SourcePiece > 0)
                    {
                        Glob.Board.NonPawnHashOwn = (Glob.Board.NonPawnHashOwn - Ret.GetPiecePosHash.Hash);
                    }
                    Else
                    {
                        Glob.Board.NonPawnHashOpp = (Glob.Board.NonPawnHashOpp - Ret.GetPiecePosHash.Hash);
                    }
                }
                Glob.Board.KPHash = (Glob.Board.KPHash - Ret.GetPiecePosHash.Hash);
                List.ReplaceItem(Board, ApplyMove.TargetIdx, PromotionPieces[Ply]);
                Call GetPiecePosHash(PromotionPieces[Ply])(ApplyMove.TargetIdx);
                Glob.Board.CurrentHash = (Glob.Board.CurrentHash + Ret.GetPiecePosHash.Hash);
                If (Not ((abs(PromotionPieces[Ply]) == GoK_OwnPawn)))
                {
                    If (PromotionPieces[Ply] > 0)
                    {
                        Glob.Board.NonPawnHashOwn += Ret.GetPiecePosHash.Hash;
                    }
                    Else
                    {
                        Glob.Board.NonPawnHashOpp += Ret.GetPiecePosHash.Hash;
                    }
                }
            }
        }
        Else
        {
            If (abs(ApplyMove.SourcePiece) == GoK_OwnKing)
            {
                If (ApplyMove.Factor == 1)
                {
                    Glob.Board.OwnKingIdx = ApplyMove.TargetIdx;
                }
                Else
                {
                    Glob.Board.OppKingIdx = ApplyMove.TargetIdx;
                }
                Glob.Board.KPHash += MoveHashLookup[ApplyMove.MoveKey];
                Call SetCastlingStateFlag(Ply)((2 + ((ApplyMove.Factor == -1) * 4)))(1);
            }
            If (abs(ApplyMove.SourcePiece) == GoK_OwnRook)
            {
                If ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + (3 + ((ApplyMove.Factor == -1) * 4)))] == 0))
                {
                    If (ApplyMove.SourceIdx == (8 + ((ApplyMove.Factor == -1) * 56)))
                    {
                        Call SetCastlingStateFlag(Ply)((3 + ((ApplyMove.Factor == -1) * 4)))(1);
                    }
                }
                If ((Not ((CastlingState[Ply] == Const.Null))) And (CastlingBit[((8 * CastlingState[Ply]) + (4 + ((ApplyMove.Factor == -1) * 4)))] == 0))
                {
                    If (ApplyMove.SourceIdx == (1 + ((ApplyMove.Factor == -1) * 56)))
                    {
                        Call SetCastlingStateFlag(Ply)((4 + ((ApplyMove.Factor == -1) * 4)))(1);
                    }
                }
            }
        }
        If (Not ((ApplyMove.TargetPiece == 0)))
        {
            If (abs(ApplyMove.TargetPiece) == GoK_OwnRook)
            {
                If (ApplyMove.TargetIdx == (8 + ((ApplyMove.Factor == 1) * 56)))
                {
                    Call SetCastlingStateFlag(Ply)((3 + ((ApplyMove.Factor == 1) * 4)))(1);
                }
                If (ApplyMove.TargetIdx == (1 + ((ApplyMove.Factor == 1) * 56)))
                {
                    Call SetCastlingStateFlag(Ply)((4 + ((ApplyMove.Factor == 1) * 4)))(1);
                }
            }
            ApplyMove.MoveKey = (((PieceIdxLookup[abs(ApplyMove.TargetPiece)] * 10000) + (TargetPiecesIdx[Ply] * 100)) + ((ApplyMove.TargetPiece > 0) * 60000));
            Glob.Board.CurrentHash += MoveHashLookup[ApplyMove.MoveKey];
            If (Not ((abs(ApplyMove.TargetPiece) == GoK_OwnPawn)))
            {
                If (ApplyMove.TargetPiece > 0)
                {
                    Glob.Board.NonPawnHashOwn += MoveHashLookup[ApplyMove.MoveKey];
                }
                Else
                {
                    Glob.Board.NonPawnHashOpp += MoveHashLookup[ApplyMove.MoveKey];
                }
            }
            If ((abs(ApplyMove.TargetPiece) == GoK_OwnPawn) Or (abs(ApplyMove.TargetPiece) == GoK_OwnKing))
            {
                Glob.Board.KPHash += MoveHashLookup[ApplyMove.MoveKey];
            }
            If (ApplyMove.TargetPiece > 0)
            {
                If (ApplyMove.TargetPiece == GoK_OwnPawn)
                {
                    Glob.Board.OwnPawnCount += -1;
                }
                Else
                {
                    If (ApplyMove.TargetPiece < GoK_OwnQueen)
                    {
                        Glob.Board.OwnNonQueenMajorMinorCount += -1;
                        If (ApplyMove.TargetPiece == GoK_OwnRook)
                        {
                            Glob.Board.OwnRookCount += -1;
                        }
                        If (ApplyMove.TargetPiece == GoK_OwnBishop)
                        {
                            Glob.Board.OwnBishopCount += -1;
                        }
                    }
                    Else
                    {
                        If (ApplyMove.TargetPiece == GoK_OwnQueen)
                        {
                            Glob.Board.OwnQueenCount += -1;
                        }
                    }
                }
            }
            Else
            {
                If (ApplyMove.TargetPiece == GoK_OppPawn)
                {
                    Glob.Board.OppPawnCount += -1;
                }
                Else
                {
                    If (ApplyMove.TargetPiece > GoK_OppQueen)
                    {
                        Glob.Board.OppNonQueenMajorMinorCount += -1;
                        If (ApplyMove.TargetPiece == GoK_OppRook)
                        {
                            Glob.Board.OppRookCount += -1;
                        }
                        If (ApplyMove.TargetPiece == GoK_OppBishop)
                        {
                            Glob.Board.OppBishopCount += -1;
                        }
                    }
                    Else
                    {
                        If (ApplyMove.TargetPiece == GoK_OppQueen)
                        {
                            Glob.Board.OppQueenCount += -1;
                        }
                    }
                }
            }
        }
    }
    Else
    {
        If (ApplyMove.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_OppRook);
            List.ReplaceItem(Board, 63, GoK_OppKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.Board.OppKingIdx = 63;
            Call UpdateMoveHashPosScore(GoK_OppKing)(61)(63)((1 == 0))(Ply);
            Call UpdateMoveHashPosScore(GoK_OppRook)(64)(62)((1 == 1))(Ply);
            Call SetCastlingStateFlag(Ply)(5)(1);
        }
        Else
        {
            If (ApplyMove.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_OppKing);
                List.ReplaceItem(Board, 60, GoK_OppRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.Board.OppKingIdx = 59;
                Call UpdateMoveHashPosScore(GoK_OppKing)(61)(59)((1 == 0))(Ply);
                Call UpdateMoveHashPosScore(GoK_OppRook)(57)(60)((1 == 1))(Ply);
                Call SetCastlingStateFlag(Ply)(5)(1);
            }
            Else
            {
                If (ApplyMove.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_OwnRook);
                    List.ReplaceItem(Board, 7, GoK_OwnKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.Board.OwnKingIdx = 7;
                    Call UpdateMoveHashPosScore(GoK_OwnKing)(5)(7)((1 == 0))(Ply);
                    Call UpdateMoveHashPosScore(GoK_OwnRook)(8)(6)((1 == 1))(Ply);
                    Call SetCastlingStateFlag(Ply)(1)(1);
                }
                Else
                {
                    If (ApplyMove.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_OwnKing);
                        List.ReplaceItem(Board, 4, GoK_OwnRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.Board.OwnKingIdx = 3;
                        Call UpdateMoveHashPosScore(GoK_OwnKing)(5)(3)((1 == 0))(Ply);
                        Call UpdateMoveHashPosScore(GoK_OwnRook)(1)(4)((1 == 1))(Ply);
                        Call SetCastlingStateFlag(Ply)(1)(1);
                    }
                }
            }
        }
    }
    If (Not ((AppliedMove[Ply] == 0)))
    {
        If ((Not ((Quiescence[Ply] == Const.Null))) And (Quiescence[Ply] == 0))
        {
            Glob.Stats.NodeCount += 1;
        }
        Else
        {
            Glob.Stats.NodeCountQuiescence += 1;
        }
    }
    If (Not ((CastlingState[Ply] == Const.Null)))
    {
        If ((CastlingBit[((8 * CastlingState[Ply]) + 1)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 2)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 3)] == 1) And (CastlingBit[((8 * CastlingState[Ply]) + 4)] == 1))))
        {
            Call SetCastlingStateFlag(Ply)(1)(1);
            Call SetCastlingStateFlag(Ply)(2)(1);
            Call SetCastlingStateFlag(Ply)(3)(1);
            Call SetCastlingStateFlag(Ply)(4)(1);
        }
        If ((CastlingBit[((8 * CastlingState[Ply]) + 5)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 6)] == 1) Or ((CastlingBit[((8 * CastlingState[Ply]) + 7)] == 1) And (CastlingBit[((8 * CastlingState[Ply]) + 8)] == 1))))
        {
            Call SetCastlingStateFlag(Ply)(5)(1);
            Call SetCastlingStateFlag(Ply)(6)(1);
            Call SetCastlingStateFlag(Ply)(7)(1);
            Call SetCastlingStateFlag(Ply)(8)(1);
        }
    }
}

Define ApplyMoveLight(string Ply) (warp=true)
{
    List.ReplaceItem(PreviousBoardHash, Ply, Glob.Board.CurrentHash);
    Call GetCurrentMove(Ply);
    ApplyMoveLight.Move = Ret.GetCurrentMove.Move;
    List.ReplaceItem(AppliedMove, Ply, ApplyMoveLight.Move);
    ApplyMoveLight.SourceIdx = floor((ApplyMoveLight.Move / 100));
    If (ApplyMoveLight.SourceIdx > 0)
    {
        ApplyMoveLight.TargetIdx = floor((ApplyMoveLight.Move % 100));
        ApplyMoveLight.SourcePiece = (Board[ApplyMoveLight.SourceIdx] + 0);
        ApplyMoveLight.TargetPiece = (Board[ApplyMoveLight.TargetIdx] + 0);
        List.ReplaceItem(SourcePieces, Ply, ApplyMoveLight.SourcePiece);
        List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMoveLight.TargetIdx);
        List.ReplaceItem(TargetPieces, Ply, ApplyMoveLight.TargetPiece);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        List.ReplaceItem(Board, ApplyMoveLight.TargetIdx, ApplyMoveLight.SourcePiece);
        List.ReplaceItem(Board, ApplyMoveLight.SourceIdx, 0);
        If (ApplyMoveLight.SourcePiece == GoK_OwnKing)
        {
            Glob.Board.OwnKingIdx = ApplyMoveLight.TargetIdx;
        }
        If (ApplyMoveLight.SourcePiece == GoK_OppKing)
        {
            Glob.Board.OppKingIdx = ApplyMoveLight.TargetIdx;
        }
        Glob.Board.CurrentHash += MoveHashLookup[(((PieceIdxLookup[abs(ApplyMoveLight.SourcePiece)] * 10000) + ((ApplyMoveLight.SourceIdx * 100) + ApplyMoveLight.TargetIdx)) + ((ApplyMoveLight.SourcePiece > 0) * 60000))];
        If (Not ((ApplyMoveLight.TargetPiece == 0)))
        {
            Glob.Board.CurrentHash += MoveHashLookup[(((PieceIdxLookup[abs(ApplyMoveLight.TargetPiece)] * 10000) + (ApplyMoveLight.TargetIdx * 100)) + ((ApplyMoveLight.TargetPiece > 0) * 60000))];
        }
        If (((abs(ApplyMoveLight.SourcePiece) == GoK_OwnPawn) And (ApplyMoveLight.TargetPiece == 0)) And (Not ((IdxToFile[ApplyMoveLight.SourceIdx] == IdxToFile[ApplyMoveLight.TargetIdx]))))
        {
            ApplyMoveLight.EnPassantSquare = (ApplyMoveLight.TargetIdx - (8 * (((ApplyMoveLight.SourcePiece > 0) * 2) - 1)));
            ApplyMoveLight.EnPassantCaptured = (Board[ApplyMoveLight.EnPassantSquare] + 0);
            List.ReplaceItem(TargetPiecesIdx, Ply, ApplyMoveLight.EnPassantSquare);
            List.ReplaceItem(TargetPieces, Ply, ApplyMoveLight.EnPassantCaptured);
            List.ReplaceItem(Board, ApplyMoveLight.EnPassantSquare, 0);
            Glob.Board.CurrentHash = (Glob.Board.CurrentHash + MoveHashLookup[(((PieceIdxLookup[abs(ApplyMoveLight.EnPassantCaptured)] * 10000) + (ApplyMoveLight.EnPassantSquare * 100)) + ((ApplyMoveLight.EnPassantCaptured > 0) * 60000))]);
        }
    }
    Else
    {
        List.ReplaceItem(SourcePieces, Ply, 0);
        List.ReplaceItem(TargetPiecesIdx, Ply, 0);
        List.ReplaceItem(TargetPieces, Ply, 0);
        List.ReplaceItem(PromotionPieces, Ply, 0);
        If (ApplyMoveLight.Move == GoK_OppKingsideCastling)
        {
            List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
            List.ReplaceItem(Board, 61, 0);
            List.ReplaceItem(Board, 62, GoK_OppRook);
            List.ReplaceItem(Board, 63, GoK_OppKing);
            List.ReplaceItem(Board, 64, 0);
            Glob.Board.OppKingIdx = 63;
            Call UpdateMoveHash(GoK_OppKing)(61)(63)(Ply);
            Call UpdateMoveHash(GoK_OppRook)(64)(62)(Ply);
        }
        Else
        {
            If (ApplyMoveLight.Move == GoK_OppQueensideCastling)
            {
                List.ReplaceItem(SourcePieces, Ply, GoK_OppKing);
                List.ReplaceItem(Board, 57, 0);
                List.ReplaceItem(Board, 59, GoK_OppKing);
                List.ReplaceItem(Board, 60, GoK_OppRook);
                List.ReplaceItem(Board, 61, 0);
                Glob.Board.OppKingIdx = 59;
                Call UpdateMoveHash(GoK_OppKing)(61)(59)(Ply);
                Call UpdateMoveHash(GoK_OppRook)(57)(60)(Ply);
            }
            Else
            {
                If (ApplyMoveLight.Move == GoK_OwnKingsideCastling)
                {
                    List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                    List.ReplaceItem(Board, 5, 0);
                    List.ReplaceItem(Board, 6, GoK_OwnRook);
                    List.ReplaceItem(Board, 7, GoK_OwnKing);
                    List.ReplaceItem(Board, 8, 0);
                    Glob.Board.OwnKingIdx = 7;
                    Call UpdateMoveHash(GoK_OwnKing)(5)(7)(Ply);
                    Call UpdateMoveHash(GoK_OwnRook)(8)(6)(Ply);
                }
                Else
                {
                    If (ApplyMoveLight.Move == GoK_OwnQueensideCastling)
                    {
                        List.ReplaceItem(SourcePieces, Ply, GoK_OwnKing);
                        List.ReplaceItem(Board, 1, 0);
                        List.ReplaceItem(Board, 3, GoK_OwnKing);
                        List.ReplaceItem(Board, 4, GoK_OwnRook);
                        List.ReplaceItem(Board, 5, 0);
                        Glob.Board.OwnKingIdx = 3;
                        Call UpdateMoveHash(GoK_OwnKing)(5)(3)(Ply);
                        Call UpdateMoveHash(GoK_OwnRook)(1)(4)(Ply);
                    }
                }
            }
        }
    }
}

