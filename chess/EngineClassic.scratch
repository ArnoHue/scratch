    Call LoadList("0, 0, 0, 0, 0, 0, 0, 0, 7, 6, 13, 13, 0, 0, 0, 0")("PawnLeverBonus");
    List.DeleteItem(MinorAttackWeight, all);
    Call LoadList("3, 19, 32, 25, 41, 29, 52, 65, 41, 82, 0, 0")("MinorAttackWeight");
    List.DeleteItem(RookAttackWeight, all);
    Call LoadList("2, 22, 18, 36, 22, 30, 0, 20, 30, 20, 0, 0")("RookAttackWeight");
    List.DeleteItem(PassedPawnCandidateBonus, all);
    Call LoadList("0, 0, 0, 0, 5, 15, 10, 30, 20, 45, 30, 50, 40, 60, 0, 0")("PassedPawnCandidateBonus");
    List.DeleteAll(KingOnFile);
    Call LoadList("-9, -3, 0, 2.5")("KingOnFile");
    List.DeleteAll(KingRings);
    Repeat (640)
    {
        List.Add(KingRings, -1);
    }
    Init.KS.KingIdx = 1;
    Repeat (64)
    {
        Init.KS.KingRingIdx = (((Init.KS.KingIdx - 1) * 10) + 1);
        Init.KS.KingRank = IdxToRank[Init.KS.KingIdx];
        Init.KS.KingFile = IdxToFile[Init.KS.KingIdx];
        If (Init.KS.KingFile < 2)
        {
            Init.KS.KingFile = 2;
        }
        Else
        {
            If (Init.KS.KingFile > 7)
            {
                Init.KS.KingFile = 7;
            }
        }
        If (1 == 1)
        {
            If (Init.KS.KingRank < 2)
            {
                Init.KS.KingRank = 2;
            }
            Else
            {
                If (Init.KS.KingRank > 7)
                {
                    Init.KS.KingRank = 7;
                }
            }
        }
        Init.KS.Rank = (Init.KS.KingRank - 1);
        Repeat (3)
        {
            If ((Init.KS.Rank > 0) And (Init.KS.Rank < 9))
            {
                Init.KS.File = (Init.KS.KingFile - 1);
                Repeat (3)
                {
                    If ((Not ((Init.KS.File == IdxToFile[Init.KS.KingIdx]))) Or (Not ((Init.KS.Rank == IdxToRank[Init.KS.KingIdx]))))
                    {
                        List.ReplaceItem(KingRings, Init.KS.KingRingIdx, (((Init.KS.Rank - 1) * 8) + Init.KS.File));
                        Init.KS.KingRingIdx += 1;
                    }
                    Init.KS.File += 1;
                }
            }
            Init.KS.Rank += 1;
        }
        Init.KS.KingIdx += 1;
    }
}

