Define InitChebyshev (warp=true)
{
    List.DeleteAll(ChebyshevDistance);
    Repeat (6500)
    {
        List.Add(ChebyshevDistance, 0);
    }
    Init.Chebyshev.FromSqIdx = 1;
    Repeat (64)
    {
        Init.Chebyshev.ToSqIdx = 1;
        Repeat (64)
        {
            Init.Chebyshev.RankDist = abs((IdxToRank[Init.Chebyshev.FromSqIdx] - IdxToRank[Init.Chebyshev.ToSqIdx]));
            Init.Chebyshev.FileDist = abs((IdxToFile[Init.Chebyshev.FromSqIdx] - IdxToFile[Init.Chebyshev.ToSqIdx]));
            If (Init.Chebyshev.RankDist > Init.Chebyshev.FileDist)
            {
                List.ReplaceItem(ChebyshevDistance, ((Init.Chebyshev.FromSqIdx * 100) + Init.Chebyshev.ToSqIdx), Init.Chebyshev.RankDist);
            }
            Else
            {
                List.ReplaceItem(ChebyshevDistance, ((Init.Chebyshev.FromSqIdx * 100) + Init.Chebyshev.ToSqIdx), Init.Chebyshev.FileDist);
            }
            Init.Chebyshev.ToSqIdx += 1;
        }
        Init.Chebyshev.FromSqIdx += 1;
    }
}

Define InitCoordLookup (warp=true)
{
    List.DeleteItem(IdxToFile, all);
    List.DeleteItem(IdxToRank, all);
    Init.CL.Idx = 1;
    Repeat (64)
    {
        List.Add(IdxToFile, (((Init.CL.Idx - 1) % 8) + 1));
        List.Add(IdxToRank, ceiling((Init.CL.Idx / 8)));
        Init.CL.Idx += 1;
    }
}

Define InitHashLookup (warp=true)
{
    Glob.TTCurrentAge = 0;
    List.DeleteItem(PosPieceHashLookup, all);
    Repeat (1024)
    {
        List.Add(PosPieceHashLookup, Operator.Random(1 , ((65536 * 65536) * 16384)));
    }
    Call ClearTT;
}

