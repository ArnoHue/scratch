    List.DeleteAll(DiscoveryRay);
    Repeat ((8 * Const.MaxPlyStackFrames))
    {
        List.Add(DiscoveryRay, 0);
    }
    List.DeleteAll(DiscoveryCount);
    Repeat (Const.MaxPlyStackFrames)
    {
        List.Add(DiscoveryCount, 0);
    }
    List.DeleteItem(HistoryMoveScores, all);
    Repeat (8400)
    {
        List.Add(HistoryMoveScores, 0);
    }
    If (List.Length(HistoryPawnHist) == 393216)
    {
        Init.Board.ListIdx = 1;
        Repeat (393216)
        {
            List.ReplaceItem(HistoryPawnHist, Init.Board.ListIdx, -1188);
            Init.Board.ListIdx += 1;
        }
    }
    Else
    {
        List.DeleteItem(HistoryPawnHist, all);
        Repeat (393216)
        {
            List.Add(HistoryPawnHist, -1188);
        }
    }
    List.DeleteAll(HistoryCaptureScores);
    Repeat (4700)
    {
        List.Add(HistoryCaptureScores, 0);
    }
    If (List.Length(CorrHistVal) == 200000)
    {
        Init.Board.ListIdx = 1;
        Repeat (200000)
        {
            List.ReplaceItem(CorrHistVal, Init.Board.ListIdx, 0);
            Init.Board.ListIdx += 1;
        }
    }
    Else
    {
        List.DeleteAll(CorrHistVal);
        Repeat (200000)
        {
            List.Add(CorrHistVal, 0);
        }
    }
    If (List.Length(CorrHistKey) == 200000)
    {
        Init.Board.ListIdx = 1;
        Repeat (200000)
        {
            List.ReplaceItem(CorrHistKey, Init.Board.ListIdx, 0);
            Init.Board.ListIdx += 1;
        }
    }
    Else
    {
        List.DeleteAll(CorrHistKey);
        Repeat (200000)
        {
            List.Add(CorrHistKey, 0);
        }
    }
    If (List.Length(CorrHistNonPawnOwn) == 200000)
    {
        Init.Board.ListIdx = 1;
        Repeat (200000)
        {
            List.ReplaceItem(CorrHistNonPawnOwn, Init.Board.ListIdx, 0);
            Init.Board.ListIdx += 1;
        }
    }
    Else
    {
        List.DeleteAll(CorrHistNonPawnOwn);
        Repeat (200000)
        {
            List.Add(CorrHistNonPawnOwn, 0);
        }
    }
    If (List.Length(CorrHistNonPawnOwnKey) == 200000)
    {
        Init.Board.ListIdx = 1;
        Repeat (200000)
        {
            List.ReplaceItem(CorrHistNonPawnOwnKey, Init.Board.ListIdx, 0);
            Init.Board.ListIdx += 1;
        }
    }
    Else
    {
        List.DeleteAll(CorrHistNonPawnOwnKey);
        Repeat (200000)
        {
            List.Add(CorrHistNonPawnOwnKey, 0);
        }
    }
    If (List.Length(CorrHistNonPawnOpp) == 200000)
    {
        Init.Board.ListIdx = 1;
        Repeat (200000)
        {
            List.ReplaceItem(CorrHistNonPawnOpp, Init.Board.ListIdx, 0);
            Init.Board.ListIdx += 1;
        }
    }
    Else
    {
        List.DeleteAll(CorrHistNonPawnOpp);
