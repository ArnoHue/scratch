                    If (((CalcBoardAttacked.Piece * CalcBoardAttacked.Factor) > 0) And ((abs(CalcBoardAttacked.Piece) == GoK_OwnQueen) Or (abs(CalcBoardAttacked.Piece) == GoK_OwnBishop)))
                    {
                        CalcBoardAttacked.IsChecked = 1;
                    }
                }
            }
            Else
            {
                CalcBoardAttacked.IsRayDone = 1;
            }
        }
    }
    If (CalcBoardAttacked.IsChecked == 0)
    {
        CalcBoardAttacked.File = CalcBoardAttacked.KingFile;
        CalcBoardAttacked.Rank = CalcBoardAttacked.KingRank;
        CalcBoardAttacked.IsRayDone = 0;
        Repeat Until ((CalcBoardAttacked.IsRayDone == 1) Or (CalcBoardAttacked.IsChecked == 1))
        {
            CalcBoardAttacked.File = (CalcBoardAttacked.File + -1);
            CalcBoardAttacked.Rank = (CalcBoardAttacked.Rank + -1);
            If (((CalcBoardAttacked.File > 0) And (CalcBoardAttacked.File < 9)) And ((CalcBoardAttacked.Rank > 0) And (CalcBoardAttacked.Rank < 9)))
            {
                CalcBoardAttacked.SqIdx = (CalcBoardAttacked.File + ((CalcBoardAttacked.Rank - 1) * 8));
                CalcBoardAttacked.Piece = Board[CalcBoardAttacked.SqIdx];
                If (Not ((CalcBoardAttacked.Piece == 0)))
                {
                    CalcBoardAttacked.IsRayDone = 1;
                    If (((CalcBoardAttacked.Piece * CalcBoardAttacked.Factor) > 0) And ((abs(CalcBoardAttacked.Piece) == GoK_OwnQueen) Or (abs(CalcBoardAttacked.Piece) == GoK_OwnBishop)))
                    {
                        CalcBoardAttacked.IsChecked = 1;
                    }
                }
            }
            Else
            {
                CalcBoardAttacked.IsRayDone = 1;
            }
        }
    }
    If (PlyIsOwn[CheckingPly] == 1)
    {
        Glob.Board.IsOppSideChecked = CalcBoardAttacked.IsChecked;
    }
    Else
    {
        Glob.Board.IsOwnSideChecked = CalcBoardAttacked.IsChecked;
    }
}

Define CalcBoardAttackedByMove(string Ply)(bool WithMobility) (warp=true)
{
    Call ClearBoardAttacked(Ply);
    Call GenerateMovesImplWrapper(Ply)((1 == 1))((1 == 0))((1 == 0))(WithMobility);
}

Define CalcBoardAttackedOnDemand(string Ply)(bool Quiescence)(bool ForceOnCheck)(string Horizon) (warp=true)
{
    If (BoardAttackedCalculated[Ply] == 0)
    {
        If ((ForceOnCheck And (CheckedState[Ply] == 1)) Or ((Not ((Ply > Horizon))) And (Not (Quiescence))))
        {
            Call CalcBoardAttackedByMove((Ply + 1))((1 == 0));
            Call StoreAttackInfo((Ply + 1))(Ply);
            List.ReplaceItem(BoardAttackedCalculated, Ply, 1);
        }
    }
}

Define CalcBoardStats (warp=true)
{
    Glob.Board.OwnKingIdx = Const.Null;
    Glob.Board.OppKingIdx = Const.Null;
    Glob.Board.CurrentHash = 0;
    Glob.Board.NonPawnHashOwn = 0;
    Glob.Board.NonPawnHashOpp = 0;
    Glob.Board.KPHash = 0;
    CalcBoardStats.SqIdx = 1;
    Repeat (8)
    {
        List.ReplaceItem(PawnCount, CalcBoardStats.SqIdx, 0);
        List.ReplaceItem(PawnCount, (CalcBoardStats.SqIdx + 8), 0);
        CalcBoardStats.SqIdx += 1;
    }
    CalcBoardStats.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CalcBoardStats.SqIdx] == GoK_OppPawn)
        {
            List.ReplaceItem(PawnCount, (IdxToFile[CalcBoardStats.SqIdx] + 8), (PawnCount[(IdxToFile[CalcBoardStats.SqIdx] + 8)] + 1));
        }
        Else
        {
            If (Board[CalcBoardStats.SqIdx] == GoK_OwnPawn)
            {
                List.ReplaceItem(PawnCount, IdxToFile[CalcBoardStats.SqIdx], (PawnCount[IdxToFile[CalcBoardStats.SqIdx]] + 1));
            }
            Else
            {
                If (Board[CalcBoardStats.SqIdx] == GoK_OppKing)
                {
                    Glob.Board.OppKingIdx = CalcBoardStats.SqIdx;
                }
                Else
                {
                    If (Board[CalcBoardStats.SqIdx] == GoK_OwnKing)
                    {
                        Glob.Board.OwnKingIdx = CalcBoardStats.SqIdx;
                    }
                }
            }
        }
        Call GetPiecePosHash(Board[CalcBoardStats.SqIdx])(CalcBoardStats.SqIdx);
        Glob.Board.CurrentHash = (Glob.Board.CurrentHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CalcBoardStats.SqIdx]) == GoK_OwnPawn)))
        {
            If (Board[CalcBoardStats.SqIdx] > 0)
            {
                Glob.Board.NonPawnHashOwn += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.Board.NonPawnHashOpp += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CalcBoardStats.SqIdx]) == GoK_OwnPawn) Or (abs(Board[CalcBoardStats.SqIdx]) == GoK_OwnKing))
        {
            Glob.Board.KPHash = (Glob.Board.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CalcBoardStats.SqIdx += 1;
    }
    CalcBoardStats.OwnNonQueenMajorMinorCount = 0;
    CalcBoardStats.OwnQueenCount = 0;
    CalcBoardStats.OwnPawnCount = 0;
    CalcBoardStats.OwnRookCount = 0;
    CalcBoardStats.OwnBishopCount = 0;
    CalcBoardStats.OppQueenCount = 0;
    CalcBoardStats.OppNonQueenMajorMinorCount = 0;
    CalcBoardStats.OppPawnCount = 0;
    CalcBoardStats.OppRookCount = 0;
    CalcBoardStats.OppBishopCount = 0;
    CalcBoardStats.SqIdx = 1;
    Repeat (64)
    {
        If (Board[CalcBoardStats.SqIdx] == GoK_OppQueen)
        {
            CalcBoardStats.OppQueenCount += 1;
        }
        If (Board[CalcBoardStats.SqIdx] == GoK_OwnQueen)
        {
            CalcBoardStats.OwnQueenCount += 1;
        }
        If ((Board[CalcBoardStats.SqIdx] == GoK_OppKnight) Or ((Board[CalcBoardStats.SqIdx] == GoK_OppBishop) Or (Board[CalcBoardStats.SqIdx] == GoK_OppRook)))
        {
            CalcBoardStats.OppNonQueenMajorMinorCount += 1;
            If (Board[CalcBoardStats.SqIdx] == GoK_OppRook)
            {
                CalcBoardStats.OppRookCount += 1;
            }
            If (Board[CalcBoardStats.SqIdx] == GoK_OppBishop)
            {
                CalcBoardStats.OppBishopCount += 1;
            }
        }
        If ((Board[CalcBoardStats.SqIdx] == GoK_OwnKnight) Or ((Board[CalcBoardStats.SqIdx] == GoK_OwnBishop) Or (Board[CalcBoardStats.SqIdx] == GoK_OwnRook)))
        {
            CalcBoardStats.OwnNonQueenMajorMinorCount += 1;
            If (Board[CalcBoardStats.SqIdx] == GoK_OwnRook)
            {
                CalcBoardStats.OwnRookCount += 1;
            }
            If (Board[CalcBoardStats.SqIdx] == GoK_OwnBishop)
            {
                CalcBoardStats.OwnBishopCount += 1;
            }
        }
        If (Board[CalcBoardStats.SqIdx] == GoK_OppPawn)
        {
            CalcBoardStats.OppPawnCount += 1;
        }
        If (Board[CalcBoardStats.SqIdx] == GoK_OwnPawn)
        {
            CalcBoardStats.OwnPawnCount += 1;
        }
        CalcBoardStats.SqIdx += 1;
    }
    Glob.Board.OppQueenCount = CalcBoardStats.OppQueenCount;
    Glob.Board.OppNonQueenMajorMinorCount = CalcBoardStats.OppNonQueenMajorMinorCount;
    Glob.Board.OwnQueenCount = CalcBoardStats.OwnQueenCount;
    Glob.Board.OwnNonQueenMajorMinorCount = CalcBoardStats.OwnNonQueenMajorMinorCount;
    Glob.Board.OppRookCount = CalcBoardStats.OppRookCount;
    Glob.Board.OwnRookCount = CalcBoardStats.OwnRookCount;
    Glob.Board.OppPawnCount = CalcBoardStats.OppPawnCount;
    Glob.Board.OwnPawnCount = CalcBoardStats.OwnPawnCount;
    Glob.Board.OppBishopCount = CalcBoardStats.OppBishopCount;
    Glob.Board.OwnBishopCount = CalcBoardStats.OwnBishopCount;
    List.ReplaceItem(CastlingState, 1, ((((Glob.Board.HasOwnCastled * CastlingStatePow2[1]) + (Glob.Board.HasOwnKingMoved * CastlingStatePow2[2])) + ((Glob.Board.HasOwnRookKSMoved * CastlingStatePow2[3]) + (Glob.Board.HasOwnRookQSMoved * CastlingStatePow2[4]))) + (((Glob.Board.HasOppCastled * CastlingStatePow2[5]) + (Glob.Board.HasOppKingMoved * CastlingStatePow2[6])) + ((Glob.Board.HasOppRookKSMoved * CastlingStatePow2[7]) + (Glob.Board.HasOppRookQSMoved * CastlingStatePow2[8])))));
    List.ReplaceItem(CastlingState, 2, CastlingState[1]);
}

Define CalcMaterialImbalance(string Ply) (warp=true)
{
    Ret.CalcMaterialImbalance.Score = 0;
    Ret.CalcMaterialImbalance.ScoreEg = 0;
    List.DeleteAll(TmpList1);
    List.DeleteAll(TmpList2);
    If (Glob.Board.OwnBishopCount > 1)
    {
        List.Add(TmpList1, 1);
    }
    Else
    {
        List.Add(TmpList1, 0);
    }
    List.Add(TmpList1, Glob.Board.OwnPawnCount);
    List.Add(TmpList1, (Glob.Board.OwnNonQueenMajorMinorCount - (Glob.Board.OwnRookCount + Glob.Board.OwnBishopCount)));
    List.Add(TmpList1, Glob.Board.OwnBishopCount);
    List.Add(TmpList1, Glob.Board.OwnRookCount);
    List.Add(TmpList1, Glob.Board.OwnQueenCount);
    If (Glob.Board.OppBishopCount > 1)
    {
        List.Add(TmpList2, 1);
    }
    Else
    {
        List.Add(TmpList2, 0);
    }
    List.Add(TmpList2, Glob.Board.OppPawnCount);
    List.Add(TmpList2, (Glob.Board.OppNonQueenMajorMinorCount - (Glob.Board.OppRookCount + Glob.Board.OppBishopCount)));
    List.Add(TmpList2, Glob.Board.OppBishopCount);
    List.Add(TmpList2, Glob.Board.OppRookCount);
    List.Add(TmpList2, Glob.Board.OppQueenCount);
    CalcMaterialImbalance.Idx = 1;
    Repeat (6)
    {
        CalcMaterialImbalance.ImbalanceSum = 0;
        CalcMaterialImbalance.ImbalanceSumEg = 0;
        If (((PlyIsOwn[Ply] == 1) And (TmpList1[CalcMaterialImbalance.Idx] > 0)) Or ((PlyIsOwn[Ply] == 0) And (TmpList2[CalcMaterialImbalance.Idx] > 0)))
        {
            CalcMaterialImbalance.OtherPieceTypeIdx = 1;
            Repeat Until (CalcMaterialImbalance.OtherPieceTypeIdx > CalcMaterialImbalance.Idx)
            {
                If (PlyIsOwn[Ply] == 1)
                {
                    CalcMaterialImbalance.ImbalanceSum += ((ImbalanceSameSide[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList1[CalcMaterialImbalance.OtherPieceTypeIdx]) + (ImbalanceOppSide[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList2[CalcMaterialImbalance.OtherPieceTypeIdx]));
                    CalcMaterialImbalance.ImbalanceSumEg += ((ImbalanceSameSideEg[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList1[CalcMaterialImbalance.OtherPieceTypeIdx]) + (ImbalanceOppSideEg[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList2[CalcMaterialImbalance.OtherPieceTypeIdx]));
                }
                Else
                {
                    CalcMaterialImbalance.ImbalanceSum += ((ImbalanceSameSide[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList2[CalcMaterialImbalance.OtherPieceTypeIdx]) + (ImbalanceOppSide[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList1[CalcMaterialImbalance.OtherPieceTypeIdx]));
                    CalcMaterialImbalance.ImbalanceSumEg += ((ImbalanceSameSideEg[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList2[CalcMaterialImbalance.OtherPieceTypeIdx]) + (ImbalanceOppSideEg[(((CalcMaterialImbalance.Idx - 1) * 6) + CalcMaterialImbalance.OtherPieceTypeIdx)] * TmpList1[CalcMaterialImbalance.OtherPieceTypeIdx]));
                }
                CalcMaterialImbalance.OtherPieceTypeIdx += 1;
            }
            If (PlyIsOwn[Ply] == 1)
            {
                Ret.CalcMaterialImbalance.Score += (TmpList1[CalcMaterialImbalance.Idx] * CalcMaterialImbalance.ImbalanceSum);
                Ret.CalcMaterialImbalance.ScoreEg += (TmpList1[CalcMaterialImbalance.Idx] * CalcMaterialImbalance.ImbalanceSumEg);
            }
            Else
            {
                Ret.CalcMaterialImbalance.Score += (TmpList2[CalcMaterialImbalance.Idx] * CalcMaterialImbalance.ImbalanceSum);
                Ret.CalcMaterialImbalance.ScoreEg += (TmpList2[CalcMaterialImbalance.Idx] * CalcMaterialImbalance.ImbalanceSumEg);
            }
        }
        CalcMaterialImbalance.Idx += 1;
    }
}

Define ClearBoardAttacked(num Ply) (warp=true)
{
    If (PlyIsOwn[Ply] == 1)
    {
        ClearBoardAttacked.SqIdx = 1;
        Repeat (List.Length(AttackDirtySq1))
        {
            List.ReplaceItem(BoardAttacked, AttackDirtySq1[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackedXRay, AttackDirtySq1[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackedPiece, AttackDirtySq1[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackedTypeMask, AttackDirtySq1[ClearBoardAttacked.SqIdx], 0);
            ClearBoardAttacked.SqIdx += 1;
        }
        List.DeleteAll(AttackDirtySq1);
        ClearBoardAttacked.SqIdx = 1;
        Repeat (List.Length(AttackDirtyType1))
        {
            List.ReplaceItem(BoardAttackerType, AttackDirtyType1[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackerType2, AttackDirtyType1[ClearBoardAttacked.SqIdx], 0);
            ClearBoardAttacked.SqIdx += 1;
        }
        List.DeleteAll(AttackDirtyType1);
        Glob.Board.IsOppSideChecked = 0;
    }
    Else
    {
        ClearBoardAttacked.SqIdx = 1;
        Repeat (List.Length(AttackDirtySq2))
        {
            List.ReplaceItem(BoardAttacked, AttackDirtySq2[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackedXRay, AttackDirtySq2[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackedPiece, AttackDirtySq2[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackedTypeMask, AttackDirtySq2[ClearBoardAttacked.SqIdx], 0);
            ClearBoardAttacked.SqIdx += 1;
        }
        List.DeleteAll(AttackDirtySq2);
        ClearBoardAttacked.SqIdx = 1;
        Repeat (List.Length(AttackDirtyType2))
        {
            List.ReplaceItem(BoardAttackerType, AttackDirtyType2[ClearBoardAttacked.SqIdx], 0);
            List.ReplaceItem(BoardAttackerType2, AttackDirtyType2[ClearBoardAttacked.SqIdx], 0);
            ClearBoardAttacked.SqIdx += 1;
        }
        List.DeleteAll(AttackDirtyType2);
        Glob.Board.IsOwnSideChecked = 0;
    }
}

Define ClearMoveList(num Ply) (warp=true)
{
    List.ReplaceItem(MovesCount, Ply, 0);
    If (Ply == 1)
    {
        List.DeleteAll(Moves1);
    }
    Else
    {
        If (Ply == 2)
        {
            List.DeleteAll(Moves2);
        }
    }
}

Define ClearTT (warp=true)
{
    Call //("TT sizes must be powers of two (entries, hence clusters of 4): ResizeTT moves cluster c to c or c + clusters by one bit of the stored key. Scratch 3 (40000) is never resized");
    If (Glob.Config.IsScratch3 == 1)
    {
        Call ClearTTImpl(40000);
    }
    Else
    {
        Call ClearTTImpl(262144);
    }
}

Define ClearTTImpl(string Size) (warp=true)
{
    Call //("Size must be a power of two (entries) for ResizeTT to keep the entries; only the Scratch 3 size 40000 is not, and it is never resized");
    If (List.Length(TTNodeEntry) == (Size * 5))
    {
        ClearTTImpl.EntryIdx = 1;
        Repeat (List.Length(TTNodeEntry))
        {
            List.ReplaceItem(TTNodeEntry, ClearTTImpl.EntryIdx, Const.Null);
            ClearTTImpl.EntryIdx += 1;
        }
    }
    Else
    {
        List.DeleteItem(TTNodeEntry, all);
        Repeat (Size)
        {
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
            List.Add(TTNodeEntry, Const.Null);
        }
    }
    Call TTResetSlots;
}

Define CreateCurrentBoardHash (warp=true)
{
    Glob.Board.CurrentHash = 0;
    Glob.Board.NonPawnHashOwn = 0;
    Glob.Board.NonPawnHashOpp = 0;
    Glob.Board.KPHash = 0;
    CreateCurrentBoardHash.SqIdx = 1;
    Repeat (64)
    {
        Call GetPiecePosHash(Board[CreateCurrentBoardHash.SqIdx])(CreateCurrentBoardHash.SqIdx);
        Glob.Board.CurrentHash = (Glob.Board.CurrentHash + Ret.GetPiecePosHash.Hash);
        If (Not ((abs(Board[CreateCurrentBoardHash.SqIdx]) == GoK_OwnPawn)))
        {
            If (Board[CreateCurrentBoardHash.SqIdx] > 0)
            {
                Glob.Board.NonPawnHashOwn += Ret.GetPiecePosHash.Hash;
            }
            Else
            {
                Glob.Board.NonPawnHashOpp += Ret.GetPiecePosHash.Hash;
            }
        }
        If ((abs(Board[CreateCurrentBoardHash.SqIdx]) == GoK_OwnPawn) Or (abs(Board[CreateCurrentBoardHash.SqIdx]) == GoK_OwnKing))
        {
            Glob.Board.KPHash = (Glob.Board.KPHash + Ret.GetPiecePosHash.Hash);
        }
        CreateCurrentBoardHash.SqIdx += 1;
    }
}

Define DrawBoardAndWait (warp=false)
{
    Call StoreExternalBoard;
    List.DeleteAll(GoK_ScreenBoard);
    DrawBoardAndWait.SqIdx = 1;
    Repeat (64)
    {
        List.Add(GoK_ScreenBoard, Board[GoK_ScreenIdx[DrawBoardAndWait.SqIdx]]);
        DrawBoardAndWait.SqIdx += 1;
    }
    If (Glob.Config.IsDCI == 0)
    {
        GoK_ProgressValue = 0;
        Event.BroadcastAndWait("drawboard");
        Event.BroadcastAndWait("progressvaluechanged");
        Event.BroadcastAndWait("evaluationvaluechanged");
    }
}

Define EBFEN.AddCastling(string CS)(string Off)(string KingSq)(string King)(string Rook)(string KSRookSq)(string QSRookSq)(string KSChar)(string QSChar) (warp=true)
{
    Ret.EBFEN.AddCastling.Text = "";
    If (((CastlingBit[((8 * CS) + (Off + 1))] == 0) And (CastlingBit[((8 * CS) + (Off + 2))] == 0)) And (GoK_Board[KingSq] == King))
    {
        If ((CastlingBit[((8 * CS) + (Off + 3))] == 0) And (GoK_Board[KSRookSq] == Rook))
        {
            Ret.EBFEN.AddCastling.Text = Operator.Join(Ret.EBFEN.AddCastling.Text, KSChar);
        }
        If ((CastlingBit[((8 * CS) + (Off + 4))] == 0) And (GoK_Board[QSRookSq] == Rook))
        {
            Ret.EBFEN.AddCastling.Text = Operator.Join(Ret.EBFEN.AddCastling.Text, QSChar);
        }
    }
}

Define EBFEN.AppendField(string Text) (warp=true)
{
    Ret.ExportBoardFEN.FEN = Operator.Join(Ret.ExportBoardFEN.FEN, Operator.Join(" ", Text));
    Ret.ExportBoardFEN.FENLichess = Operator.Join(Ret.ExportBoardFEN.FENLichess, Operator.Join("_", Text));
}

Define EnterExecution (warp=false)
{
    Glob.Game.ExecutionPly += 1;
    If (Glob.Game.ExecutionPly == 1)
    {
        Glob.Game.IsExecutionRunning = 1;
        Event.BroadcastAndWait("calcmode");
    }
}

Define EvalEndgame(string Ply) (warp=true)
{
    Ret.EvalEndgame.Score = Const.Null;
    EvalEndgame.StrongSide = 1;
    Repeat (2)
    {
        If (Ret.EvalEndgame.Score == Const.Null)
        {
            Call EvalEndgame.Material(EvalEndgame.StrongSide);
            EvalEndgame.StrongScore = Const.Null;
            If (((Ret.EvalEndgame.Material.WeakPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 0)) And ((EvalEndgame.Material.StrongQueenCount + EvalEndgame.Material.StrongRookCount) > 0))
            {
                Call EvalEndgame.Locate(EvalEndgame.StrongSide);
                Call EvalEndgame.PushToEdge(Ret.EvalEndgame.Locate.WeakKingIdx);
                EvalEndgame.Score = ((((((EvalEndgame.Material.StrongQueenCount * 2538) + (EvalEndgame.Material.StrongRookCount * 1276)) + ((EvalEndgame.Material.StrongBishopCount * 825) + (EvalEndgame.Material.StrongKnightCount * 781))) + (Ret.EvalEndgame.Material.StrongPawnCount * 208)) + (Ret.EvalEndgame.PushToEdge.Score + (140 - (20 * ChebyshevDistance[((Ret.EvalEndgame.Locate.StrongKingIdx * 100) + Ret.EvalEndgame.Locate.WeakKingIdx)])))) + 10000);
                Call EvalEndgame.StrongToMove(Ply)(EvalEndgame.StrongSide);
                If (Ret.EvalEndgame.StrongToMove.IsStrongToMove == 0)
                {
                    EvalEndgame.Weak = Board[Ret.EvalEndgame.Locate.WeakKingIdx];
                    List.ReplaceItem(Board, Ret.EvalEndgame.Locate.WeakKingIdx, 0);
                    EvalEndgame.Mobile = 0;
                    EvalEndgame.InCheck = 0;
                    EvalEndgame.Dir = 0;
                    Repeat (9)
                    {
                        EvalEndgame.Dx = ((EvalEndgame.Dir % 3) - 1);
                        EvalEndgame.Dy = (floor((EvalEndgame.Dir / 3)) - 1);
                        EvalEndgame.To = ((Ret.EvalEndgame.Locate.WeakKingIdx + (EvalEndgame.Dy * 8)) + EvalEndgame.Dx);
                        If (((EvalEndgame.To > 0) And (EvalEndgame.To < 65)) And ((IdxToFile[EvalEndgame.To] - IdxToFile[Ret.EvalEndgame.Locate.WeakKingIdx]) == EvalEndgame.Dx))
                        {
                            EvalEndgame.Att = 0;
                            If (ChebyshevDistance[((Ret.EvalEndgame.Locate.StrongKingIdx * 100) + EvalEndgame.To)] < 2)
                            {
                                EvalEndgame.Att = 1;
                            }
                            EvalEndgame.Sq = 1;
                            Repeat Until ((EvalEndgame.Att == 1) Or (EvalEndgame.Sq > 64))
                            {
                                If ((((Board[EvalEndgame.Sq] * EvalEndgame.StrongSide) > 0) And (Not ((EvalEndgame.Sq == EvalEndgame.To)))) And (Not ((EvalEndgame.Sq == Ret.EvalEndgame.Locate.StrongKingIdx))))
                                {
                                    Call IsReachableForAttack(Board[EvalEndgame.Sq])(EvalEndgame.Sq)(EvalEndgame.To);
                                    If (Ret.IsReachableForAttack.IsReachable == 1)
                                    {
                                        EvalEndgame.Att = 1;
                                    }
                                }
                                EvalEndgame.Sq += 1;
                            }
                            If (EvalEndgame.Dir == 4)
                            {
                                EvalEndgame.InCheck = EvalEndgame.Att;
                            }
                            Else
                            {
                                If (EvalEndgame.Att == 0)
                                {
                                    EvalEndgame.Mobile = 1;
                                }
                            }
                        }
                        EvalEndgame.Dir += 1;
                    }
                    List.ReplaceItem(Board, Ret.EvalEndgame.Locate.WeakKingIdx, EvalEndgame.Weak);
                    If ((EvalEndgame.InCheck == 0) And (EvalEndgame.Mobile == 0))
                    {
                        EvalEndgame.Score = 0;
                    }
                }
                EvalEndgame.StrongScore = EvalEndgame.Score;
            }
            If (Ret.EvalEndgame.Material.StrongPawnCount == 0)
            {
                If ((Ret.EvalEndgame.Material.WeakPiecesAreNone == 1) And (Ret.EvalEndgame.Material.WeakPawnCount == 1))
                {
                    If (Ret.EvalEndgame.Material.StrongPiecesAreRook == 1)
                    {
                        Call EvalEndgame.KRKP(Ply)(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KRKP.Score;
                    }
                    If (Ret.EvalEndgame.Material.StrongPiecesAreQueen == 1)
                    {
                        Call EvalEndgame.KQKP(EvalEndgame.StrongSide);
                        EvalEndgame.StrongScore = Ret.EvalEndgame.KQKP.Score;
                    }
                    If (Ret.EvalEndgame.Material.StrongPiecesAreTwoKnights == 1)
