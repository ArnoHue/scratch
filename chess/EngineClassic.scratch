            EvalT.RookChecks = (floor((EvalT.SafeChecksPacked / 100)) % 10);
            EvalT.QueenChecks = (floor((EvalT.SafeChecksPacked / 1000)) % 10);
            If (EvalT.RookChecks == 0)
