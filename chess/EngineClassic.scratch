        {
            EvalP.PStruct.NormRank = (9 - EvalP.PStruct.Rank);
            If ((Board[(EvalP.PStruct.SqIdx + -8)] == GoK_OwnPawn) Or ((EvalP.PStruct.NormRank < 7) And (((EvalP.PStruct.File > 1) And (Board[(EvalP.PStruct.SqIdx + -17)] == GoK_OwnPawn)) Or ((EvalP.PStruct.File < 8) And (Board[(EvalP.PStruct.SqIdx + -15)] == GoK_OwnPawn)))))
            {
