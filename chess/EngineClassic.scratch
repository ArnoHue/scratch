//----- Green flag events ---------------------------------------------------------------------------------------------

WhenGreenFlagClicked()
{
    Glob.VersionString = "Game of Kings Chess Classic Version 6.9248.2608 (24.10.2026) by ArnoHu";
    Glob.IsTestRunning = 0;
    Glob.IsDCI = 0;
    Glob.Level = 4;
    GoK_Level = 4;
    If is compiled?
    {
        Glob.IsScratch3 = 0;
    }
    Else
    {
        Glob.IsScratch3 = 1;
    }
    Call OnRestart;
}


//----- Key pressed events --------------------------------------------------------------------------------------------

WhenKeyPressed(l)
{
    List.Show(Logfile);
}

WhenKeyPressed(p)
{
    If (Glob.ProfilerMode == Const.ProfilerMode.Off)
    {
        Glob.ProfilerMode = Const.ProfilerMode.Std;
        Call SayAsync("Profiling Standard")(2);
        Call PrepStats;
    }
    Else
    {
        If (Glob.ProfilerMode == Const.ProfilerMode.Std)
        {
            Glob.ProfilerMode = Const.ProfilerMode.Full;
            Call SayAsync("Profiling Full")(2);
        }
        Else
        {
            If (Glob.ProfilerMode == Const.ProfilerMode.Full)
            {
                Glob.ProfilerMode = Const.ProfilerMode.Off;
                Call SayAsync("Profiling Off")(2);
            }
        }
    }
}

WhenKeyPressed(d)
{
    If (Glob.DebugMode == 0)
    {
        Glob.DebugMode = 1;
        Variable.Show(Glob.IdxDeepening);
        Variable.Show(Glob.BestMoveEval);
        Variable.Show(Glob.BestMove);
        Variable.Show(Glob.NPS);
        Variable.Show(Glob.MPS);
        Variable.Show(Glob.PV);
    }
    Else
    {
        Glob.DebugMode = 0;
        Variable.Hide(Glob.IdxDeepening);
        Variable.Hide(Glob.BestMoveEval);
        Variable.Hide(Glob.BestMove);
        Variable.Hide(Glob.NPS);
        Variable.Hide(Glob.MPS);
        Variable.Hide(Glob.PV);
    }
}

WhenKeyPressed(v)
{
    Call SayAsync(Glob.VersionString)(5);
}

WhenKeyPressed(r)
{
    List.Show(Profile_Data);
}

WhenKeyPressed(t)
{
    If (Glob.TimeControl == -1)
    {
        Stop(this script);
    }
    Event.BroadcastAndWait("GoK_AskTime");
    TimeKey.Answer = Sensing.Answer();
    If (Operator.LetterOf(TimeKey.Answer, 1) == "d")
    {
        TimeKey.Part = "";
        TimeKey.CharIdx = 2;
        Repeat ((Variable.Length(TimeKey.Answer) - 1))
        {
            TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
            TimeKey.CharIdx += 1;
        }
        If (TimeKey.Part > 0)
        {
            Glob.CustomMaxDepth = TimeKey.Part;
            Glob.CustomThinkTime = 100000;
            Glob.InitialClockTime = 0;
            Glob.ClockTimeInc = 0;
            Glob.ClockStageMoves = 0;
            Glob.ClockStageTime = 0;
            Glob.TimeControl = 1;
        }
    }
    Else
    {
        TimeKey.SlashIdx = 0;
        TimeKey.PlusIdx = 0;
        TimeKey.CharIdx = 1;
        Repeat (Variable.Length(TimeKey.Answer))
        {
            If (Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx) == "/")
            {
                TimeKey.SlashIdx = TimeKey.CharIdx;
            }
            If (Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx) == "+")
            {
                TimeKey.PlusIdx = TimeKey.CharIdx;
            }
            TimeKey.CharIdx += 1;
        }
        If (TimeKey.SlashIdx > 0)
        {
            TimeKey.Part = "";
            TimeKey.CharIdx = 1;
            Repeat ((TimeKey.SlashIdx - 1))
            {
                TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                TimeKey.CharIdx += 1;
            }
            If (TimeKey.Part == "")
            {
                Glob.InitialClockTime = 0;
            }
            Else
            {
                Glob.InitialClockTime = TimeKey.Part;
            }
            If (TimeKey.PlusIdx > TimeKey.SlashIdx)
            {
                TimeKey.Part = "";
                TimeKey.CharIdx = (TimeKey.SlashIdx + 1);
                Repeat (((TimeKey.PlusIdx - TimeKey.SlashIdx) - 1))
                {
                    TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                    TimeKey.CharIdx += 1;
                }
                If (TimeKey.Part == "")
                {
                    Glob.ClockStageMoves = 0;
                }
                Else
                {
                    Glob.ClockStageMoves = TimeKey.Part;
                }
                TimeKey.Part = "";
                TimeKey.CharIdx = (TimeKey.PlusIdx + 1);
                Repeat ((Variable.Length(TimeKey.Answer) - TimeKey.PlusIdx))
                {
                    TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                    TimeKey.CharIdx += 1;
                }
                If (TimeKey.Part == "")
                {
                    Glob.ClockStageTime = 0;
                }
                Else
                {
                    Glob.ClockStageTime = TimeKey.Part;
                }
                Glob.ClockTimeInc = 0;
            }
            Else
            {
                TimeKey.Part = "";
                TimeKey.CharIdx = (TimeKey.SlashIdx + 1);
                Repeat ((Variable.Length(TimeKey.Answer) - TimeKey.SlashIdx))
                {
                    TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                    TimeKey.CharIdx += 1;
                }
                If (TimeKey.Part == "")
                {
                    Glob.ClockTimeInc = 0;
                }
                Else
                {
                    Glob.ClockTimeInc = TimeKey.Part;
                }
                Glob.ClockStageMoves = 0;
                Glob.ClockStageTime = 0;
            }
            Glob.CurrentClockTime = Glob.InitialClockTime;
            Glob.CustomThinkTime = 0;
            Glob.CustomMaxDepth = 0;
            Glob.TimeControl = 1;
            Glob.ClockMoveCount = 0;
        }
        Else
        {
            TimeKey.Part = TimeKey.Answer;
            If (Operator.LetterOf(TimeKey.Answer, 1) == "e")
            {
                TimeKey.Part = "";
                TimeKey.CharIdx = 2;
                Repeat ((Variable.Length(TimeKey.Answer) - 1))
                {
                    TimeKey.Part = Operator.Join(TimeKey.Part, Operator.LetterOf(TimeKey.Answer, TimeKey.CharIdx));
                    TimeKey.CharIdx += 1;
                }
            }
            If ((TimeKey.Part + 0) > 0)
            {
                Glob.CustomThinkTime = (TimeKey.Part + 0);
                Glob.InitialClockTime = 0;
                Glob.ClockTimeInc = 0;
                Glob.ClockStageMoves = 0;
                Glob.ClockStageTime = 0;
                Glob.CustomMaxDepth = 0;
                Glob.TimeControl = 1;
            }
            Else
            {
                If (Not ((TimeKey.Answer == "")))
                {
                    Call SayAsync("Invalid clock format")(2);
                }
            }
        }
    }
}

WhenKeyPressed(e)
{
    Call LogEval;
    List.Show(Logfile);
}

WhenKeyPressed(u)
{
    List.DeleteAll(Logfile);
    Sensing.Ask("Perft depth? (1 - 4, blank to skip)");
    TST.Ask.PerftPly = Sensing.Answer();
    Sensing.Ask("How many search tests? (1 - 218, blank to skip)");
    TST.Ask.PositionCount = Sensing.Answer();
    Sensing.Ask("Think time per test, in seconds?");
    TST.Ask.ThinkTime = Sensing.Answer();
    List.Show(Logfile);
    Call EnterExecution;
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call TestPerft(TST.Ask.PerftPly);
    Call TestSuite(TST.Ask.PositionCount)(TST.Ask.ThinkTime);
    Call InitBoard;
    Call InitBoardPhase2;
    Call ExecuteInit;
    Call DrawBoardAndWait;
    Call ExitExecution;
}


//----- Broadcast received events -------------------------------------------------------------------------------------

WhenBroadcastReceived($gok_classic)
{
    Glob.IsDCI = 1;
    Call ​​log​​("$gok1");
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Call IsOppKingCheckMate;
    If (Ret.IsOppKingCheckMate.IsCheckMate == 1)
    {
        If (_dci turn == 1)
        {
            _dci evaluation = "-M0";
        }
        Else
        {
            _dci evaluation = "M0";
        }
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: invoked on opp mate");
        Stop(this script);
    }
    Else
    {
        DCI.IsClaimAllowed = 1;
        If (Not ((Glob.PrevMoveEval == Const.Null)))
        {
            If (Glob.PrevMoveEval > 0)
            {
                DCI.IsClaimAllowed = 0;
            }
        }
        Call GetRepetitionCount;
        If ((Ret.GetRepetitionCount.Count > 2) And (DCI.IsClaimAllowed == 1))
        {
            List.Add(_dci, "draw?");
            Event.Broadcast("dci message");
            Call ​​warn​​("$gok: invoked on draw-by-rep");
            Stop(this script);
        }
        Else
        {
            Call IsDrawByMaterial;
            If (Ret.IsDrawByMaterial.IsDraw == 1)
            {
                List.Add(_dci, "draw?");
                Event.Broadcast("dci message");
                Call ​​warn​​("$gok: invoked on draw-by-material");
                Stop(this script);
            }
            Else
            {
                Call IsDrawByStalemate(1);
                If (Ret.IsDrawByStalemate.IsDraw == 1)
                {
                    List.Add(_dci, "draw?");
                    Event.Broadcast("dci message");
                    Call ​​warn​​("$gok: invoked on draw-by-stalemate");
                    Stop(this script);
                }
            }
        }
    }
    Call ​​log​​("$gok2");
    DCI.Move = Const.Null;
    Call GetOpeningMoves;
    If (List.Length(OpeningMovesRes) > 0)
    {
        DCI.Move = OpeningMovesRes[Operator.Random(1 , List.Length(OpeningMovesRes))];
        Glob.BestMoveEval = 0;
        Glob.PV = "book";
        If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
        {
            Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockTimeInc);
            Glob.ClockMoveCount += 1;
            If ((Glob.ClockStageMoves > 0) And (Glob.ClockMoveCount == Glob.ClockStageMoves))
            {
                Glob.CurrentClockTime = (Glob.CurrentClockTime + Glob.ClockStageTime);
            }
        }
    }
    Else
    {
        Call GetBestMoveDeepening.Prepare;
        Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
        Repeat Until (Glob.IsDeepeningDone == 1)
        {
            Call GetBestMoveDCI.Slice;
            If ((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0))
            {
                Event.Broadcast("gui clock refresh");
            }
        }
        DCI.Move = Ret.GetBestMoveDCI.Move;
    }
    Call ​​log​​("$gok3");
    If (DCI.Move == Const.Null)
    {
        List.Add(_dci, "resign");
        Event.Broadcast("dci message");
        Call ​​warn​​("$gok: search system error => resigning");
        Stop(this script);
    }
    Call ​​log​​("$gok4");
    Call ClearMoveList(1);
    Call AddMoveToList(DCI.Move)(1)(0);
    List.ReplaceItem(MovesIdx, 1, 1);
    Call ApplyMove(1);
    Call AddBoardToHistory(1);
    List.ReplaceItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState), CastlingState[1]);
    Call RevertMove(1);
    Call GetMoveNotation(DCI.Move);
    If (Ret.GetMoveNotation.Notation == "O-O")
    {
        If (Glob.IsPlayerBlack == 0)
        {
            List.Add(_dci, "me8g8");
        }
        Else
        {
            List.Add(_dci, "me1g1");
        }
    }
    Else
    {
        If (Ret.GetMoveNotation.Notation == "O-O-O")
        {
            If (Glob.IsPlayerBlack == 0)
            {
                List.Add(_dci, "me8c8");
            }
            Else
            {
                List.Add(_dci, "me1c1");
            }
        }
        Else
        {
            DCI.PromotionCode = Operator.Round(((Ret.GetMoveNotation.VirtualMove * 10) % 10));
            DCI.PromotionLetter = "";
            If (DCI.PromotionCode == 1)
            {
                DCI.PromotionLetter = "q";
            }
            If (DCI.PromotionCode == 2)
            {
                DCI.PromotionLetter = "r";
            }
            If (DCI.PromotionCode == 3)
            {
                DCI.PromotionLetter = "b";
            }
            If (DCI.PromotionCode == 4)
            {
                DCI.PromotionLetter = "n";
            }
            List.Add(_dci, Operator.Join(Operator.Join("m", Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join((9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove / 100))]), Operator.Join(Operator.LetterOf("abcdefgh", IdxToFile[floor((Ret.GetMoveNotation.VirtualMove % 100))]), (9 - IdxToRank[floor((Ret.GetMoveNotation.VirtualMove % 100))]))))), DCI.PromotionLetter));
        }
    }
    Call ​​log​​("$gok5");
    If (((Glob.ClockTimeInc > 0) Or (Glob.InitialClockTime > 0)) And (Glob.CustomMaxDepth == 0))
    {
        _dci clock = (Operator.Round(((Glob.CurrentClockTime + Glob.ClockTimeInc) * 10)) / 10);
    }
    Else
    {
        _dci clock = "";
    }
    _dci pv = Glob.PV;
    If (Glob.PV == "book")
    {
        _dci search depth = "";
    }
    Else
    {
        _dci search depth = (Glob.IdxDeepening - Glob.IsSearchTimeout);
    }
    If (Not ((Glob.BestMoveEval == Const.Null)))
    {
        DCI.WhiteEval = (Glob.BestMoveEval * _dci turn);
        If (abs(Glob.BestMoveEval) > Const.AbsMinCheckmateEval)
        {
            _dci evaluation = Operator.Join("M", ceiling((((100000 - abs(Glob.BestMoveEval)) - List.Length(BoardHistoryFiftyMoves)) / 2)));
            If (DCI.WhiteEval < 0)
            {
                _dci evaluation = Operator.Join("-", _dci evaluation);
            }
        }
        Else
        {
            _dci evaluation = (DCI.WhiteEval / 100);
        }
    }
    Event.BroadcastAndWait("gui refresh stats");
    Event.Broadcast("dci message");
    Call ​​log​​("$gok6");
}

WhenBroadcastReceived($gok_classic draw?)
{
    Glob.IsDCI = 1;
    Call $gok_prepare;
    Call AddBoardToHistory(0);
    Glob.BestMoveEval = 0;
    DCI.SavedClockTime = Glob.CurrentClockTime;
    DCI.SavedClockMoveCount = Glob.ClockMoveCount;
    DCI.SavedPrevMoveEval = Glob.PrevMoveEval;
    DCI.SavedAvgCompletedDepth = Glob.AvgCompletedDepth;
    Call GetBestMoveDeepening.Prepare;
    Glob.PrevProgressUpdate = (Sensing.DaysSince2000() * 86400);
    Repeat Until (Glob.IsDeepeningDone == 1)
    {
        Call GetBestMoveDCI.Slice;
    }
    List.DeleteItem(BoardHistory, List.Length(BoardHistory));
    List.DeleteItem(BoardHistoryHash, List.Length(BoardHistoryHash));
    List.DeleteItem(BoardHistoryMetaState, List.Length(BoardHistoryMetaState));
    List.DeleteItem(BoardHistoryWasEngineMove, List.Length(BoardHistoryWasEngineMove));
    Glob.CurrentClockTime = DCI.SavedClockTime;
    Glob.ClockMoveCount = DCI.SavedClockMoveCount;
    Glob.PrevMoveEval = DCI.SavedPrevMoveEval;
    Glob.AvgCompletedDepth = DCI.SavedAvgCompletedDepth;
    If (Glob.BestMoveEval == Const.Null)
    {
        List.Add(_dci, "decline");
    }
    Else
    {
        If (Glob.BestMoveEval < 0)
        {
            List.Add(_dci, "accept");
        }
        Else
        {
            List.Add(_dci, "decline");
        }
    }
    Event.Broadcast("dci message");
}

WhenBroadcastReceived($gok_classic stop)
{
    Glob.IsDCI = 1;
    Glob.IsSearchTimeout = 1;
}

WhenBroadcastReceived(advisor)
{
    If (Glob.IsExecutionRunning == 0)
    {
        If (Glob.IsAdvisorEnabled == 1)
        {
            Glob.IsAdvisorEnabled = 0;
            Call DrawBoardAndWait;
        }
        Else
        {
            Glob.IsAdvisorEnabled = 1;
            If (Not ((Stg_FromSquareIdx == -1)))
            {
                Event.BroadcastAndWait("fromsquareselected");
            }
        }
    }
}

WhenBroadcastReceived(dci new game)
{
    GoK_IsGameSuspended = 0;
    List.DeleteAll(BoardHistory);
    List.DeleteAll(BoardHistoryFiftyMoves);
    List.DeleteAll(BoardHistoryHash);
    List.DeleteAll(BoardHistoryMetaState);
    List.DeleteAll(BoardHistoryWasEngineMove);
    List.DeleteAll(GameMovesAN);
    List.DeleteAll(GameMoves);
    Glob.IsPlayerBlack = Const.Null;
    Glob.CurrentClockTime = Const.Null;
    Glob.ClockMoveCount = 0;
    Glob.IsTimeModelLogged = 0;
    Glob.PrevMoveEval = Const.Null;
    Glob.AvgCompletedDepth = Const.Null;
}

WhenBroadcastReceived(dci register)
{
    List.Add(_dci engines, "gok_classic");
}

WhenBroadcastReceived(export)
{
    If (Glob.IsExecutionRunning == 0)
    {
        Call ExportBoardFEN(0);
        Exp.FENLichess = Ret.ExportBoardFEN.FENLichess;
        Exp.FEN = Ret.ExportBoardFEN.FEN;
        List.DeleteItem(ExportData, all);
        List.Add(ExportData, "DATA EXPORT");
        List.Add(ExportData, "Select data row by triple-clicking. You can then copy to");
        List.Add(ExportData, "clipboard by right-click / Copy or by pressing Ctrl-C.");
        List.Add(ExportData, "");
        List.Add(ExportData, "PGN (Game Protocol):");
        Call ExportMovesPGN;
        List.Add(ExportData, Ret.ExportMovesPGN.PGN);
        List.Add(ExportData, "");
        List.Add(ExportData, "FEN (Current Board):");
        List.Add(ExportData, Exp.FEN);
        List.Add(ExportData, "");
        List.Add(ExportData, "Board Analysis Link (lichess.org)");
        List.Add(ExportData, Exp.FENLichess);
        List.Show(ExportData);
        If (1 == 0)
        {
            Call SayAsync("You can copy FEN data, lichess.org URL or PGN data to your clipboard via Ctrl-C. Select data by triple-click.")(5);
        }
    }
}

WhenBroadcastReceived(fromsquareselected)
{
    If ((Glob.IsAdvisorEnabled == 1) And (Not ((Stg_FromSquareIdx == -1))))
    {
        Stg_BestMoveFromIdx = Stg_FromSquareIdx;
        List.DeleteAll(Selection_UserMoveTargets);
        Call GenerateMovesPublic(2);
        List.ReplaceItem(MovesIdx, 2, 1);
        Repeat (MovesCount[2])
        {
            Call GetCurrentMove(2);
            FSS.Move = Ret.GetCurrentMove.Move;
            If (floor((FSS.Move / 100)) == GoK_ScreenIdx[Stg_FromSquareIdx])
            {
                Call ApplyMove(2);
                Call CalcBoardAttackedByMove(3);
                Call RevertMove(2);
                If (Glob.IsOppSideChecked == 0)
                {
                    List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[floor((FSS.Move % 100))]);
                }
            }
            Else
            {
                If (Board[GoK_ScreenIdx[Stg_FromSquareIdx]] == GoK_OppKing)
                {
                    If (FSS.Move == GoK_OppKingsideCastling)
                    {
                        List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[63]);
                    }
                    Else
                    {
                        If (FSS.Move == GoK_OppQueensideCastling)
                        {
                            List.Add(Selection_UserMoveTargets, GoK_ScreenIdx[59]);
                        }
                    }
                }
            }
            List.ReplaceItem(MovesIdx, 2, (MovesIdx[2] + 1));
        }
        Call DrawBoardAndWait;
        Event.BroadcastAndWait("StampUserMoveTargets");
    }
}

WhenBroadcastReceived(import)
{
    If (Glob.IsExecutionRunning == 0)
    {
        Sensing.Ask("Board data import. Please paste FEN data from your clipboard into the text field by pressing Ctrl-V.");
        If (Variable.Length(Sensing.Answer()) > 0)
        {
            Call ImportBoard(Sensing.Answer());
        }
    }
}

WhenBroadcastReceived(levelchanged)
{
    Glob.Level = GoK_Level;
    Call DrawBoardAndWait;
}

WhenBroadcastReceived(sayasyncmsg)
{
    Looks.Say(Glob.SayAsyncText, Glob.SayAsyncDuration);
}

WhenBroadcastReceived(showmoves)
{
    Call ExportMovesPGN;
    List.DeleteItem(ExportMoves, all);
    List.Add(ExportMoves, Ret.ExportMovesPGN.PGN);
    List.Show(ExportMoves);
    Call SayAsync("You can copy PGN data to your clipboard via Ctrl-C")(5);
}

WhenBroadcastReceived(squareclicked)
{
    If ((Glob.IsExecutionRunning == 0) And (GoK_IsGameSuspended == 0))
    {
        Call EnterExecution;
        If (Board[GoK_ScreenIdx[Stg_SquareClickedIdx]] < 0)
        {
            Glob.MoveFromIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
            Stg_FromSquareIdx = Stg_SquareClickedIdx;
            Event.BroadcastAndWait("fromsquareselected");
        }
        Else
        {
            If ((Not ((Glob.MoveFromIdx == -1))) And (Not ((Stg_FromSquareIdx == -1))))
            {
                Glob.MoveToIdx = GoK_ScreenIdx[Stg_SquareClickedIdx];
                Stg_ToSquareIdx = Stg_SquareClickedIdx;
                Event.BroadcastAndWait("tosquareselected");
                If ((Board[Glob.MoveFromIdx] < 0) And (Not ((Glob.MoveFromIdx == Glob.MoveToIdx))))
                {
                    Glob.UserMove = "";
                    If ((Board[Glob.MoveFromIdx] == GoK_OppKing) And (Glob.MoveFromIdx == 61))
                    {
                        If ((Glob.MoveToIdx == 59) And (Board[57] == GoK_OppRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_OppQueensideCastling)
                            {
                                Glob.UserMove = GoK_OppQueensideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(61, 59);
                            }
                        }
                        If ((Glob.MoveToIdx == 63) And (Board[64] == GoK_OppRook))
                        {
                            Call GenerateMovesPublic(2);
                            If List.ContainsItem(Moves2, GoK_OppKingsideCastling)
                            {
                                Glob.UserMove = GoK_OppKingsideCastling;
                            }
                            Else
                            {
                                Glob.UserMove = Operator.Join(61, 63);
                            }
                        }
                    }
                    If (Glob.UserMove == "")
                    {
                        Glob.UserMove = ((Glob.MoveFromIdx * 100) + Glob.MoveToIdx);
                        If ((Board[Glob.MoveFromIdx] == GoK_OppPawn) And (Glob.MoveToIdx < 9))
                        {
                            Glob.UserMove = (Glob.UserMove + 0.1);
                        }
                    }
                }
                Call ExecuteUserMove(Glob.UserMove);
            }
        }
        Call ExitExecution;
    }
}

WhenBroadcastReceived(stageclicked)
{
    List.Hide(ExportData);
    List.Hide(ExportMoves);
    List.Hide(Logfile);
    List.Hide(Profile_Data);
    If (Glob.IsExecutionRunning == 0)
    {
        Looks.Say("");
    }
}

WhenBroadcastReceived(startgame)
{
    Motion.GoToXY(240, 80);
    Glob.ExecutionPly = 0;
    Glob.IsExecutionRunning = 0;
    Glob.IsPlayerBlack = GoK_IsPlayerBlack;
    Call EnterExecution;
    Call InitBoard;
    Call DrawBoardAndWait;
    Looks.Say("Initializing engine, please wait...");
    Control.Wait(0.1);
    Call InitBoardPhase2;
    Call ExitExecution;
    Call ExecuteInit;
    Looks.Say("");
    Looks.Show();
}

WhenBroadcastReceived(triggerrestart)
{
    Call OnRestart;
}

WhenBroadcastReceived(undo)
{
    If (Glob.IsExecutionRunning == 0)
    {
        Call UndoMove;
        Call OnEvaluationChanged(0);
        Looks.Say("");
    }
}


//----- Custom blocks -------------------------------------------------------------------------------------------------

Define $gok_prepare (warp=true)
{
    Glob.Level = 5;
    GoK_Level = 5;
    $gok_prepare.TargetIsPlayerBlack = 0;
    If Operator.Contains(_dci fen, " w")
    {
        $gok_prepare.TargetIsPlayerBlack = 1;
    }
    If (Not (($gok_prepare.TargetIsPlayerBlack == Glob.IsPlayerBlack)))
    {
        Glob.IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        GoK_IsPlayerBlack = $gok_prepare.TargetIsPlayerBlack;
        Glob.ExecutionPly = 0;
        Glob.IsExecutionRunning = 0;
        Glob.Level = 5;
        GoK_Level = 5;
        $gok_prepare.SavedClockTime = Glob.CurrentClockTime;
        $gok_prepare.SavedClockMoveCount = Glob.ClockMoveCount;
        DCI.SavedTimeModelLogged = Glob.IsTimeModelLogged;
        Call InitBoard;
        Glob.CurrentClockTime = $gok_prepare.SavedClockTime;
        Glob.ClockMoveCount = $gok_prepare.SavedClockMoveCount;
        Glob.IsTimeModelLogged = DCI.SavedTimeModelLogged;
        Call InitBoardPhase2;
        Call ​​warn​​("$gok_reinit");
    }
    Call ImportFEN(_dci fen);
    Call CalcBoardStats;
    If (_dci think time == "Infinity")
    {
        Glob.CustomThinkTime = 100000;
        Glob.CustomMaxDepth = _dci max depth;
    }
    Else
    {
        If (_dci think time > 0)
        {
            Glob.CustomThinkTime = _dci think time;
        }
        Else
        {
            Glob.CustomThinkTime = 1;
        }
        Glob.CustomMaxDepth = 0;
    }
    Glob.InitialClockTime = 0;
    Glob.ClockTimeInc = 0;
    Glob.ClockStageMoves = 0;
    Glob.ClockStageTime = 0;
    If ((Glob.CustomMaxDepth == 0) And (Not ((_dci clock time == ""))))
    {
        DCI.ClockSlashIdx = 0;
        DCI.ClockPlusIdx = 0;
        DCI.ClockCharIdx = 1;
        Repeat (Variable.Length(_dci clock time))
        {
            If (Operator.LetterOf(_dci clock time, DCI.ClockCharIdx) == "/")
            {
                DCI.ClockSlashIdx = DCI.ClockCharIdx;
            }
            If (Operator.LetterOf(_dci clock time, DCI.ClockCharIdx) == "+")
            {
                DCI.ClockPlusIdx = DCI.ClockCharIdx;
            }
            DCI.ClockCharIdx += 1;
        }
        If (DCI.ClockSlashIdx > 0)
        {
            DCI.ClockPart = "";
            DCI.ClockCharIdx = 1;
            Repeat ((DCI.ClockSlashIdx - 1))
            {
                DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                DCI.ClockCharIdx += 1;
            }
            If (Not ((DCI.ClockPart == "")))
            {
                Glob.InitialClockTime = DCI.ClockPart;
            }
            If (DCI.ClockPlusIdx > DCI.ClockSlashIdx)
            {
                DCI.ClockPart = "";
                DCI.ClockCharIdx = (DCI.ClockSlashIdx + 1);
                Repeat (((DCI.ClockPlusIdx - DCI.ClockSlashIdx) - 1))
                {
                    DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                    DCI.ClockCharIdx += 1;
                }
                If (DCI.ClockPart == "")
                {
                    Glob.ClockStageMoves = 0;
                }
                Else
                {
                    Glob.ClockStageMoves = DCI.ClockPart;
                }
                DCI.ClockPart = "";
                DCI.ClockCharIdx = (DCI.ClockPlusIdx + 1);
                Repeat ((Variable.Length(_dci clock time) - DCI.ClockPlusIdx))
                {
                    DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                    DCI.ClockCharIdx += 1;
                }
                If (DCI.ClockPart == "")
                {
                    Glob.ClockStageTime = 0;
                }
                Else
                {
                    Glob.ClockStageTime = DCI.ClockPart;
                }
            }
            Else
            {
                DCI.ClockPart = "";
                DCI.ClockCharIdx = (DCI.ClockSlashIdx + 1);
                Repeat ((Variable.Length(_dci clock time) - DCI.ClockSlashIdx))
                {
                    DCI.ClockPart = Operator.Join(DCI.ClockPart, Operator.LetterOf(_dci clock time, DCI.ClockCharIdx));
                    DCI.ClockCharIdx += 1;
                }
                If (Not ((DCI.ClockPart == "")))
                {
                    Glob.ClockTimeInc = DCI.ClockPart;
                }
            }
        }
        DCI.ClockValid = 1;
        If (Not ((Glob.InitialClockTime == (Glob.InitialClockTime + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.InitialClockTime < 0)
        {
            DCI.ClockValid = 0;
        }
        If (Not ((Glob.ClockTimeInc == (Glob.ClockTimeInc + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.ClockTimeInc < 0)
        {
            DCI.ClockValid = 0;
        }
        If (Not ((Glob.ClockStageMoves == (Glob.ClockStageMoves + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.ClockStageMoves < 0)
        {
            DCI.ClockValid = 0;
        }
        If (Not ((Glob.ClockStageTime == (Glob.ClockStageTime + 0))))
        {
            DCI.ClockValid = 0;
        }
        If (Glob.ClockStageTime < 0)
        {
            DCI.ClockValid = 0;
        }
        If (DCI.ClockValid == 0)
        {
            Glob.InitialClockTime = 0;
            Glob.ClockTimeInc = 0;
            Glob.ClockStageMoves = 0;
            Glob.ClockStageTime = 0;
            Call Log("DCI clock invalid, no clock set : ")(_dci clock time)("")("")("")("")("")("");
        }
    }
    If (Glob.CurrentClockTime == Const.Null)
    {
        Glob.CurrentClockTime = Glob.InitialClockTime;
        Glob.ClockMoveCount = 0;
    }
    List.DeleteAll(GameMoves);
    If ((Not ((EnPassantTarget[1] == Const.Null))) And (EnPassantTarget[1] > 0))
    {
        If (Board[EnPassantTarget[1]] > 0)
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] - 16) * 100) + EnPassantTarget[1]));
        }
        Else
        {
            List.DeleteAll(GameMoves);
            List.Add(GameMoves, (((EnPassantTarget[1] + 16) * 100) + EnPassantTarget[1]));
        }
    }
}

