    List.Add(MoveLookupOffsetsCross, -1);
    List.Add(MoveLookupOffsetsCross, 1);
    List.Add(MoveLookupOffsetsCross, -1);
    List.Add(MoveLookupOffsetsCross, -1);
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        InitMoveLookup.ToSqIdx = 1;
        Repeat (4)
        {
            InitMoveLookup.File = IdxToFile[InitMoveLookup.FromSqIdx];
            InitMoveLookup.Rank = IdxToRank[InitMoveLookup.FromSqIdx];
            Repeat (8)
            {
                InitMoveLookup.File += MoveLookupOffsetsStraight[InitMoveLookup.ToSqIdx];
                InitMoveLookup.Rank += MoveLookupOffsetsStraight[(InitMoveLookup.ToSqIdx + 1)];
                List.Add(MoveLookupStraight, -1);
                If ((InitMoveLookup.Rank > 0) And (InitMoveLookup.Rank < 9))
                {
                    If ((InitMoveLookup.File > 0) And (InitMoveLookup.File < 9))
                    {
                        InitMoveLookup.TargetIdx = (InitMoveLookup.File + ((InitMoveLookup.Rank - 1) * 8));
                        List.ReplaceItem(MoveLookupStraight, List.Length(MoveLookupStraight), InitMoveLookup.TargetIdx);
                    }
                }
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        InitMoveLookup.ToSqIdx = 1;
        Repeat (4)
        {
            InitMoveLookup.File = IdxToFile[InitMoveLookup.FromSqIdx];
            InitMoveLookup.Rank = IdxToRank[InitMoveLookup.FromSqIdx];
            Repeat (8)
            {
                InitMoveLookup.File += MoveLookupOffsetsCross[InitMoveLookup.ToSqIdx];
                InitMoveLookup.Rank += MoveLookupOffsetsCross[(InitMoveLookup.ToSqIdx + 1)];
                List.Add(MoveLookupCross, -1);
                If ((InitMoveLookup.Rank > 0) And (InitMoveLookup.Rank < 9))
                {
                    If ((InitMoveLookup.File > 0) And (InitMoveLookup.File < 9))
                    {
                        InitMoveLookup.TargetIdx = (InitMoveLookup.File + ((InitMoveLookup.Rank - 1) * 8));
                        List.ReplaceItem(MoveLookupCross, List.Length(MoveLookupCross), InitMoveLookup.TargetIdx);
                    }
                }
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        InitMoveLookup.FromSqIdx += 1;
    }
    List.DeleteItem(MoveLookupRays, all);
    InitMoveLookup.FromSqIdx = 1;
    Repeat (List.Length(MoveLookupStraight))
    {
        List.Add(MoveLookupRays, MoveLookupStraight[InitMoveLookup.FromSqIdx]);
        InitMoveLookup.FromSqIdx += 1;
    }
    InitMoveLookup.FromSqIdx = 1;
    Repeat (List.Length(MoveLookupCross))
    {
        List.Add(MoveLookupRays, MoveLookupCross[InitMoveLookup.FromSqIdx]);
        InitMoveLookup.FromSqIdx += 1;
    }
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        List.InsertItem(MoveLookupIndexOffset, InitMoveLookup.FromSqIdx, ((InitMoveLookup.FromSqIdx - 1) * 8));
        List.InsertItem(MoveLookupLineIndexOffset, InitMoveLookup.FromSqIdx, ((InitMoveLookup.FromSqIdx - 1) * 32));
        InitMoveLookup.FromSqIdx += 1;
    }
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        InitMoveLookup.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(InitMoveLookup.FromSqIdx)(KingMoveOffsets[InitMoveLookup.ToSqIdx])(KingMoveOffsets[(InitMoveLookup.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveLookupKing, Ret.GetTargetIdx.SqIdx);
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveLookupKing) == (InitMoveLookup.FromSqIdx * 8))
        {
            List.Add(MoveLookupKing, -1);
        }
        InitMoveLookup.ToSqIdx = 1;
        Repeat (8)
        {
            Call GetTargetIdx(InitMoveLookup.FromSqIdx)(KnightMoveOffsets[InitMoveLookup.ToSqIdx])(KnightMoveOffsets[(InitMoveLookup.ToSqIdx + 1)]);
            If (Not ((Ret.GetTargetIdx.SqIdx == -1)))
            {
                List.Add(MoveLookupKnight, Ret.GetTargetIdx.SqIdx);
            }
            InitMoveLookup.ToSqIdx += 2;
        }
        Repeat Until (List.Length(MoveLookupKnight) == (InitMoveLookup.FromSqIdx * 8))
        {
            List.Add(MoveLookupKnight, -1);
        }
        InitMoveLookup.FromSqIdx += 1;
    }
    List.DeleteItem(MoveToZeroPadStr, all);
    List.DeleteItem(MovePathDelta, all);
    List.DeleteItem(MovePathStepInc, all);
    InitMoveLookup.FromSqIdx = 0;
    Repeat (10000)
    {
        If (InitMoveLookup.FromSqIdx < 10)
        {
            List.Add(MoveToZeroPadStr, Operator.Join(000, InitMoveLookup.FromSqIdx));
        }
        Else
        {
            If (InitMoveLookup.FromSqIdx < 100)
            {
                List.Add(MoveToZeroPadStr, Operator.Join(00, InitMoveLookup.FromSqIdx));
            }
            Else
            {
                If (InitMoveLookup.FromSqIdx < 1000)
                {
                    List.Add(MoveToZeroPadStr, Operator.Join(0, InitMoveLookup.FromSqIdx));
                }
                Else
                {
                    List.Add(MoveToZeroPadStr, InitMoveLookup.FromSqIdx);
                }
            }
        }
        InitMoveLookup.FromSqIdx += 1;
    }
    Repeat (10000)
    {
        List.Add(MovePathDelta, 0);
        List.Add(MovePathStepInc, 0);
    }
    InitMoveLookup.FromSqIdx = 1;
    Repeat (64)
    {
        InitMoveLookup.ToSqIdx = 1;
        Repeat (64)
        {
            InitMoveLookup.FileDelta = (IdxToFile[InitMoveLookup.ToSqIdx] - IdxToFile[InitMoveLookup.FromSqIdx]);
            InitMoveLookup.RankDelta = (IdxToRank[InitMoveLookup.ToSqIdx] - IdxToRank[InitMoveLookup.FromSqIdx]);
            If ((Not ((InitMoveLookup.FromSqIdx == InitMoveLookup.ToSqIdx))) And (((InitMoveLookup.FileDelta == 0) Or (InitMoveLookup.RankDelta == 0)) Or (abs(InitMoveLookup.FileDelta) == abs(InitMoveLookup.RankDelta))))
            {
                If (abs(InitMoveLookup.FileDelta) > abs(InitMoveLookup.RankDelta))
                {
                    InitMoveLookup.Delta = abs(InitMoveLookup.FileDelta);
                }
                Else
                {
                    InitMoveLookup.Delta = abs(InitMoveLookup.RankDelta);
                }
                List.ReplaceItem(MovePathDelta, ((InitMoveLookup.FromSqIdx * 100) + InitMoveLookup.ToSqIdx), InitMoveLookup.Delta);
                List.ReplaceItem(MovePathStepInc, ((InitMoveLookup.FromSqIdx * 100) + InitMoveLookup.ToSqIdx), ((8 * (InitMoveLookup.RankDelta / InitMoveLookup.Delta)) + (InitMoveLookup.FileDelta / InitMoveLookup.Delta)));
            }
            InitMoveLookup.ToSqIdx += 1;
        }
        InitMoveLookup.FromSqIdx += 1;
    }
}

Define InitMovePosLookup (warp=true)
{
    List.DeleteAll(MovePosLookupMg);
    List.DeleteAll(MovePosLookupEg);
    List.DeleteAll(MoveHashLookup);
    Const.MovePosLookupOppBaseIdx = 100000;
    List.DeleteAll(MovePosLookupLegal);
    Repeat (100000)
    {
        List.Add(MovePosLookupEg, 0);
        List.Add(MovePosLookupMg, 0);
        List.Add(MovePosLookupLegal, 0);
    }
    Repeat (100000)
    {
        List.Add(MovePosLookupEg, 0);
    }
    Repeat (100000)
    {
        List.Add(MovePosLookupMg, 0);
    }
    Repeat (100000)
    {
        List.Add(MovePosLookupLegal, 0);
    }
    Repeat (140000)
    {
        List.Add(MoveHashLookup, 0);
    }
    List.DeleteAll(Pieces);
    List.Add(Pieces, GoK_OwnKing);
    List.Add(Pieces, GoK_OwnQueen);
    List.Add(Pieces, GoK_OwnRook);
    List.Add(Pieces, GoK_OwnBishop);
    List.Add(Pieces, GoK_OwnKnight);
    List.Add(Pieces, GoK_OwnPawn);
    List.Add(Pieces, GoK_OppKing);
    List.Add(Pieces, GoK_OppQueen);
    List.Add(Pieces, GoK_OppRook);
    List.Add(Pieces, GoK_OppBishop);
    List.Add(Pieces, GoK_OppKnight);
    List.Add(Pieces, GoK_OppPawn);
    InitMovePosLookup.PieceListIdx = 1;
    Repeat (List.Length(Pieces))
    {
        InitMovePosLookup.SourcePiece = Pieces[InitMovePosLookup.PieceListIdx];
        InitMovePosLookup.SlidingKind = 0;
        If (abs(InitMovePosLookup.SourcePiece) == GoK_OwnBishop)
        {
            InitMovePosLookup.SlidingKind = 1;
        }
        If (abs(InitMovePosLookup.SourcePiece) == GoK_OwnRook)
        {
            InitMovePosLookup.SlidingKind = 2;
        }
        If (abs(InitMovePosLookup.SourcePiece) == GoK_OwnQueen)
        {
            InitMovePosLookup.SlidingKind = 3;
        }
        InitMovePosLookup.SourceIdx = 0;
        Repeat (65)
        {
            If (InitMovePosLookup.SourceIdx > 0)
            {
                InitMovePosLookup.File = IdxToFile[InitMovePosLookup.SourceIdx];
                InitMovePosLookup.Rank = IdxToRank[InitMovePosLookup.SourceIdx];
            }
            Else
            {
                InitMovePosLookup.File = 0;
                InitMovePosLookup.Rank = 0;
            }
            Call GetPiecePosScoreRaw(InitMovePosLookup.SourcePiece)(InitMovePosLookup.SourceIdx);
            InitMovePosLookup.PosMg = Ret.GetPiecePosScoreRaw.Mg;
            InitMovePosLookup.PosEg = Ret.GetPiecePosScoreRaw.Eg;
            InitMovePosLookup.Mg = InitMovePosLookup.PosMg;
            InitMovePosLookup.Eg = InitMovePosLookup.PosEg;
            Call GetPiecePosHash(InitMovePosLookup.SourcePiece)(InitMovePosLookup.SourceIdx);
            InitMovePosLookup.SavedPiecePosHash = Ret.GetPiecePosHash.Hash;
            InitMovePosLookup.TargetIdx = 0;
            Repeat (65)
            {
                InitMovePosLookup.IsLegalMove = 0;
                If (((Not ((InitMovePosLookup.SourceIdx == 0))) And (Not ((InitMovePosLookup.TargetIdx == 0)))) And (Not ((InitMovePosLookup.SourceIdx == InitMovePosLookup.TargetIdx))))
                {
                    InitMovePosLookup.FileDeltaAbs = abs((IdxToFile[InitMovePosLookup.TargetIdx] - InitMovePosLookup.File));
                    InitMovePosLookup.RankDeltaAbs = abs((IdxToRank[InitMovePosLookup.TargetIdx] - InitMovePosLookup.Rank));
                    If (InitMovePosLookup.SlidingKind == 0)
                    {
                        If (((InitMovePosLookup.FileDeltaAbs < 2) And (InitMovePosLookup.RankDeltaAbs < 3)) Or ((InitMovePosLookup.FileDeltaAbs < 3) And (InitMovePosLookup.RankDeltaAbs < 2)))
                        {
                            If (InitMovePosLookup.SourcePiece == GoK_OwnPawn)
                            {
                                If (((IdxToRank[InitMovePosLookup.TargetIdx] - InitMovePosLookup.Rank) == 1) And (InitMovePosLookup.FileDeltaAbs < 2))
                                {
                                    InitMovePosLookup.IsLegalMove = 1;
                                }
                                Else
                                {
                                    If ((InitMovePosLookup.Rank == 2) And ((InitMovePosLookup.TargetIdx - InitMovePosLookup.SourceIdx) == 16))
                                    {
                                        InitMovePosLookup.IsLegalMove = 1;
                                    }
                                }
                            }
                            Else
                            {
                                If (InitMovePosLookup.SourcePiece == GoK_OppPawn)
                                {
                                    If (((IdxToRank[InitMovePosLookup.TargetIdx] - InitMovePosLookup.Rank) == -1) And (InitMovePosLookup.FileDeltaAbs < 2))
                                    {
                                        InitMovePosLookup.IsLegalMove = 1;
                                    }
                                    Else
                                    {
                                        If ((InitMovePosLookup.Rank == 7) And ((InitMovePosLookup.TargetIdx - InitMovePosLookup.SourceIdx) == -16))
                                        {
                                            InitMovePosLookup.IsLegalMove = 1;
                                        }
                                    }
                                }
                                Else
                                {
                                    If (abs(InitMovePosLookup.SourcePiece) == GoK_OwnKing)
                                    {
                                        If (((InitMovePosLookup.FileDeltaAbs == 1) And (InitMovePosLookup.RankDeltaAbs < 2)) Or ((InitMovePosLookup.RankDeltaAbs == 1) And (InitMovePosLookup.FileDeltaAbs < 2)))
                                        {
                                            InitMovePosLookup.IsLegalMove = 1;
                                        }
                                    }
                                    Else
                                    {
                                        If (abs(InitMovePosLookup.SourcePiece) == GoK_OwnKnight)
                                        {
                                            If (((InitMovePosLookup.FileDeltaAbs == 1) And (InitMovePosLookup.RankDeltaAbs == 2)) Or ((InitMovePosLookup.FileDeltaAbs == 2) And (InitMovePosLookup.RankDeltaAbs == 1)))
                                            {
                                                InitMovePosLookup.IsLegalMove = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Else
                    {
                        If ((InitMovePosLookup.FileDeltaAbs == 0) Or (InitMovePosLookup.RankDeltaAbs == 0))
                        {
                            If (InitMovePosLookup.SlidingKind > 1)
                            {
                                InitMovePosLookup.IsLegalMove = 1;
                            }
                        }
                        Else
                        {
                            If (InitMovePosLookup.FileDeltaAbs == InitMovePosLookup.RankDeltaAbs)
                            {
                                If (Not ((InitMovePosLookup.SlidingKind == 2)))
                                {
                                    InitMovePosLookup.IsLegalMove = 1;
                                }
                            }
                        }
                    }
                }
                If ((InitMovePosLookup.IsLegalMove == 1) Or ((InitMovePosLookup.SourceIdx == 0) Or (InitMovePosLookup.TargetIdx == 0)))
                {
                    Call GetPiecePosScoreRaw(InitMovePosLookup.SourcePiece)(InitMovePosLookup.TargetIdx);
                    InitMovePosLookup.PosMg = Ret.GetPiecePosScoreRaw.Mg;
                    InitMovePosLookup.PosEg = Ret.GetPiecePosScoreRaw.Eg;
                    Call GetPiecePosHash(InitMovePosLookup.SourcePiece)(InitMovePosLookup.TargetIdx);
                    If (InitMovePosLookup.SourcePiece > 0)
                    {
                        InitMovePosLookup.MoveKey = ((PieceIdxLookup[InitMovePosLookup.SourcePiece] * 10000) + ((InitMovePosLookup.SourceIdx * 100) + InitMovePosLookup.TargetIdx));
                        List.ReplaceItem(MovePosLookupMg, InitMovePosLookup.MoveKey, (InitMovePosLookup.PosMg - InitMovePosLookup.Mg));
                        List.ReplaceItem(MovePosLookupEg, InitMovePosLookup.MoveKey, (InitMovePosLookup.PosEg - InitMovePosLookup.Eg));
                        List.ReplaceItem(MoveHashLookup, (InitMovePosLookup.MoveKey + 60000), (Ret.GetPiecePosHash.Hash - InitMovePosLookup.SavedPiecePosHash));
                        List.ReplaceItem(MovePosLookupLegal, InitMovePosLookup.MoveKey, 1);
                    }
                    Else
                    {
                        InitMovePosLookup.MoveKey = ((PieceIdxLookup[(0 - InitMovePosLookup.SourcePiece)] * 10000) + ((InitMovePosLookup.SourceIdx * 100) + InitMovePosLookup.TargetIdx));
                        List.ReplaceItem(MovePosLookupMg, (InitMovePosLookup.MoveKey + 100000), (InitMovePosLookup.PosMg - InitMovePosLookup.Mg));
                        List.ReplaceItem(MovePosLookupEg, (InitMovePosLookup.MoveKey + 100000), (InitMovePosLookup.PosEg - InitMovePosLookup.Eg));
                        List.ReplaceItem(MoveHashLookup, InitMovePosLookup.MoveKey, (Ret.GetPiecePosHash.Hash - InitMovePosLookup.SavedPiecePosHash));
                        List.ReplaceItem(MovePosLookupLegal, (InitMovePosLookup.MoveKey + Const.MovePosLookupOppBaseIdx), 1);
                    }
                }
                InitMovePosLookup.TargetIdx += 1;
            }
            InitMovePosLookup.SourceIdx += 1;
        }
        InitMovePosLookup.PieceListIdx += 1;
    }
}

