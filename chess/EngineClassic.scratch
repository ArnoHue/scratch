Define InitKingCheckSquares (warp=true)
{
    List.DeleteAll(KingCheckSquares);
    List.DeleteAll(KingCheckSquaresCount);
    Repeat (2560)
    {
        List.Add(KingCheckSquares, 0);
    }
    Init.KCS.KingIdx = 1;
    Repeat (64)
    {
        Init.KCS.Count = 0;
        Init.KCS.SqIdx = 1;
        Repeat (64)
        {
            If (Not ((Init.KCS.SqIdx == Init.KCS.KingIdx)))
            {
                If ((MovePosLookupLegal[((PieceIdxLookup[GoK_OwnQueen] * 10000) + ((Init.KCS.SqIdx * 100) + Init.KCS.KingIdx))] == 1) Or (MovePosLookupLegal[((PieceIdxLookup[GoK_OwnKnight] * 10000) + ((Init.KCS.SqIdx * 100) + Init.KCS.KingIdx))] == 1))
                {
                    Init.KCS.Count += 1;
                    List.ReplaceItem(KingCheckSquares, (((Init.KCS.KingIdx - 1) * 40) + Init.KCS.Count), Init.KCS.SqIdx);
                }
            }
            Init.KCS.SqIdx += 1;
        }
        List.Add(KingCheckSquaresCount, Init.KCS.Count);
        Init.KCS.KingIdx += 1;
    }
}

